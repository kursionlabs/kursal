// Two independent mints. Each arm of an `if` mints its own brand, scoped to
// that arm, and consumes its branded value there, so the two arms meet with
// a plain, unbranded u32.

use core::cap::{Brand, fresh};

forall 'k. exposed struct Tag! {
    marker: Brand['k],
}

forall 'k. fn drop_tag(t: Tag!['k]) -> u32 {
    let { marker } = t;
    3
}

forall 'k. fn weigh_tag(t: Tag!['k]) -> u32 {
    let { marker } = t;
    4
}

// Returns base + 13 when flag is nonzero, base + 14 otherwise.
fn two_mints_one_join(flag: u32, base: u32) -> u32 {
    let r = if flag != 0 {
        let exists '1. k1 = fresh();
        drop_tag(Tag!.{ marker: k1 })
    } else {
        let exists '2. k2 = fresh();
        weigh_tag(Tag!.{ marker: k2 })
    };
    base + r + 10
}

// The mints in sequence rather than in exclusive arms: the second is
// opened inside the scope the first opened, so both branded values are
// alive at once under two distinct brands. Returns 7.
fn two_mints_nested() -> u32 {
    let exists '1. a = fresh();
    let ta = Tag!.{ marker: a };
    let exists '2. b = fresh();
    let tb = Tag!.{ marker: b };
    drop_tag(ta) + weigh_tag(tb)
}
