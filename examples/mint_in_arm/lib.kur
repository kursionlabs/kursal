// A brand minted inside an `if` arm. The arm's
// `let exists 'j. k = fresh();` scopes 'j over the rest of that
// arm, so the branded `Tag!` is consumed there and only the resulting u32
// leaves the arm. The other arm mints nothing, and both meet at the same
// `if` result.

use core::cap::{Brand, fresh};

forall 'k. exposed struct Tag! {
    marker: Brand['k],
}

forall 'k. fn drop_tag(t: Tag!['k]) -> u32 {
    let { marker } = t;
    3
}

// Returns base + 3 when flag is nonzero, base + 5 otherwise.
fn mint_in_arm(flag: u32, base: u32) -> u32 {
    let extra = if flag != 0 {
        let exists 'j. k = fresh();
        drop_tag(Tag.{ marker: k })
    } else {
        5
    };
    base + extra
}

// The mint in the other arm, with the join's value computed from the
// branded one rather than returned by the consuming call directly.
// Returns base + 9 when flag is nonzero, base + 13 otherwise (3 + 10).
fn mint_in_else_arm(flag: u32, base: u32) -> u32 {
    let extra = if flag != 0 {
        9
    } else {
        let exists 'j. k = fresh();
        drop_tag(Tag.{ marker: k }) + 10
    };
    base + extra
}
