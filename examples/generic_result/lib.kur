// The standard library's generic `Result`, matching on its value, and `?`,
// which takes apart only `core::option`'s `Option` and `Result`.

use std::option::Result;

fn safe_div(a: u32, b: u32) -> Result[u32, u32] {
    if b == 0 {
        Result::Err.(1)
    } else {
        Result::Ok.(a / b)
    }
}

// Two chained `?`s: if the first division fails, the second never runs.
fn checked_compute(a: u32, b: u32, c: u32) -> Result[u32, u32] {
    let x = safe_div(a, b)?;
    let y = safe_div(x, c)?;
    Result::Ok.(y)
}

fn result_to_code(r: Result[u32, u32]) -> u32 {
    match r {
        Ok(v) => v,
        Err(e) => 999,
    }
}

fn compute_ok() -> u32 {
    result_to_code(checked_compute(100, 5, 2))
}

fn compute_err_first_division() -> u32 {
    result_to_code(checked_compute(100, 0, 2))
}

fn compute_err_second_division() -> u32 {
    result_to_code(checked_compute(100, 5, 0))
}
