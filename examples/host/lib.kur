// The host, safely: this program's arguments, the environment, files and
// directories, other programs run and waited for, a monotonic clock and a
// sleep, and floats read from text and taken apart into their bits. None of
// it is `unsafe`.
//
// Run with the arguments `one two`, it prints them and what each step
// found, one line each.
use std::bytes::buffer::Buffer!;
use std::env::variable;
use std::float::parse_f64;
use std::fs::{FileKind, metadata, mkdir, path_exists, read, read_dir, remove, rename, write};
use std::io::{print, print_buffer};
use std::option::{Option, Result};
use std::process::{Args, Command!, Exit};
use std::slice::{Slice, StaticRead};
use std::time::{Duration, Instant, sleep};

// The arguments after the program's own name, which depends on where it
// was built.
fn show_arguments(args: Args) {
    var out = Buffer!::new().push_static("arguments:");
    var i = 1usize;
    while i < args.len() {
        match args.bytes(i) {
            Option::Some(arg) => {
                out = out.push_byte(b' ').push_static(arg);
            },
            Option::None => (),
        }
        i = i + 1usize;
    }
    print_buffer(1i32, out.push_static(" (").push_usize(args.len()).push_static(" with the name)\n"));
}

fn show_environment() {
    var sr = StaticRead::new();
    match variable(&sr, "EXAMPLE_HOST_GREETING") {
        Option::Some(value) => {
            print_buffer(1i32, Buffer!::new().push_static("greeting: ").push_buffer(value).push_byte(b'\n'));
        },
        Option::None => {
            print(1i32, "greeting: unset\n");
        },
    }
}

// Writes a file in a new directory, reads it back, renames it, lists the
// directory, and removes both.
fn show_files() {
    var sr = StaticRead::new();
    let made = mkdir(&sr, "host.d").is_ok();
    let written = write(&sr, "host.d/a.txt", Buffer!::new().push_static("written and read back\n")).is_ok();
    match read(&sr, "host.d/a.txt") {
        Result::Ok(contents) => {
            print_buffer(1i32, Buffer!::new().push_static("file: ").push_buffer(contents));
        },
        Result::Err(e) => {
            print(1i32, "file: unreadable\n");
        },
    }
    let renamed = rename(&sr, "host.d/a.txt", "host.d/b.txt").is_ok();
    var out = Buffer!::new().push_static("directory:");
    match read_dir(&sr, "host.d") {
        Result::Ok(directory) => {
            var directory = directory;
            var going = true;
            while going {
                match &directory.next() {
                    Result::Ok(next) => match next {
                        Option::Some(entry) => {
                            let { name, is_directory } = entry;
                            out = out.push_byte(b' ').push_buffer(name);
                        },
                        Option::None => {
                            going = false;
                        },
                    },
                    Result::Err(e) => {
                        going = false;
                    },
                }
            }
            let closed = directory.close();
        },
        Result::Err(e) => {
            out = out.push_static(" unreadable");
        },
    }
    let size = match metadata(&sr, "host.d/b.txt") {
        Result::Ok(m) => match m.kind {
            FileKind::File => m.size,
            _ => 0u64,
        },
        Result::Err(e) => 0u64,
    };
    let removed = remove(&sr, "host.d/b.txt").is_ok() && remove(&sr, "host.d").is_ok();
    let gone = !path_exists(&sr, "host.d");
    print_buffer(1i32, out.push_static(", ").push_u64(size).push_static(" bytes, ")
        .push_static(if made && written && renamed && removed && gone { "made and removed\n" } else { "failed\n" }));
}

// Runs `command` and prints how it ended.
fn show_run(command: Command!) {
    var out = Buffer!::new().push_static("run: ");
    match command.run() {
        Result::Ok(exit) => match exit {
            Exit::Code(code) => {
                out = out.push_static("exit ").push_usize((code as usize));
            },
            Exit::Signal(number) => {
                out = out.push_static("signal ").push_usize((number as usize));
            },
        },
        Result::Err(e) => {
            out = out.push_static("error ").push_usize((e.errno as usize));
        },
    }
    print_buffer(1i32, out.push_byte(b'\n'));
}

fn show_clock() {
    let start = Instant::now();
    sleep(Duration::from_millis(2u64));
    let later = Instant::now();
    let slept = start.duration_until(later).as_nanos() >= 2000000u64;
    if slept && start.nanos_until(later) < 60000000000u64 && later.nanos_until(start) == 0u64 {
        print(1i32, "clock: monotonic, slept\n");
    } else {
        print(1i32, "clock: wrong\n");
    }
}

// The bits of the double that `text` spells, and of the nearest float, or
// `none`.
fn show_float(text: Slice[u8, 'static]) {
    var out = Buffer!::new().push_static("float ").push_static(text).push_static(": ");
    var read = StaticRead::new();
    match parse_f64(&read, text) {
        Option::Some(value) => {
            let bits = value.to_bits();
            let single = value.to_f32().to_bits();
            out = out.push_usize((bits as usize)).push_static(" f32 ").push_usize((single as usize));
            if f64::from_bits(bits).to_bits() != bits || f32::from_bits(single).to_f64().to_f32().to_bits() != single {
                out = out.push_static(" (a round trip lost bits)");
            }
        },
        Option::None => {
            out = out.push_static("none");
        },
    }
    print_buffer(1i32, out.push_byte(b'\n'));
}

fn main(args: Args) -> i32 {
    show_arguments(args);
    show_environment();
    show_files();
    var sr = StaticRead::new();
    show_run(Command!::new(&sr, "true"));
    show_run(Command!::new(&sr, "sh").arg(&sr, "-c").arg(&sr, "exit 3"));
    show_run(Command!::new(&sr, "sh").arg(&sr, "-c").arg(&sr, "kill -9 $$"));
    show_run(Command!::new(&sr, "kursal-example-no-such-program"));
    show_run(Command!::new(&sr, "true").arg(&sr, "a\x00b"));
    show_clock();
    show_float("1");
    show_float("-2.5e3");
    show_float("0.1");
    show_float("1e400");
    show_float("4.9e-324");
    show_float(" 1");
    show_float("1x");
    show_float("");
    0
}
