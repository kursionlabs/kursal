// The host, safely: this program's arguments, the environment, a file
// written and read back, other programs run and waited for, a monotonic
// clock, and floats read from text and taken apart into their bits. None
// of it is `unsafe`.
//
// Run with the arguments `one two`, it prints them and what each step
// found, one line each.
use std::bytes::buffer::Buffer;
use std::float::parse_f64;
use std::io::{print, print_buffer};
use std::option::{Option, Result};
use std::slice::{Slice, StaticRead, byte_or_zero};
use std::time::Instant;
use std::io::File;
use libc::fs::environment_variable;
use libc::process::{Exit, arguments, run};

// The arguments after the program's own name, which depends on where it
// was built.
fn show_arguments() {
    match arguments() {
        Result::Ok(line) => {
            let exists 'b. (tag, bytes, restore) = line.open();
            var out = Buffer::new().push_static("arguments:");
            var count = 0usize;
            var i = 0usize;
            while i < bytes.len() {
                let b = byte_or_zero(&tag, bytes, i);
                if b == 0u8 {
                    count = count + 1usize;
                } else if count > 0usize {
                    if byte_or_zero(&tag, bytes, i - 1usize) == 0u8 {
                        out = out.push_byte(b' ');
                    }
                    out = out.push_byte(b);
                }
                i = i + 1usize;
            }
            restore.restore(tag).destroy();
            print_buffer(1i32, out.push_static(" (").push_usize(count).push_static(" with the name)\n"));
        },
        Result::Err(code) => {
            print(1i32, "arguments: unreadable\n");
        },
    }
}

fn show_environment() {
    var name = Buffer::new().push_static("EXAMPLE_HOST_GREETING");
    match environment_variable(&name) {
        Option::Some(value) => {
            print_buffer(1i32, Buffer::new().push_static("greeting: ").push_buffer(value).push_byte(b'\n'));
        },
        Option::None => {
            print(1i32, "greeting: unset\n");
        },
    }
    name.destroy();
}

// Writes a file in the working directory and reads it back.
fn show_file() {
    var path = Buffer::new().push_static("host.txt");
    let written = match File::create(&path) {
        Result::Ok(file) => {
            var file = file;
            let wrote = &file.write_static("written and read back\n");
            let closed = file.close();
            wrote.is_ok() && closed.is_ok()
        },
        Result::Err(code) => false,
    };
    if written {
        match File::open_read(&path) {
            Result::Ok(file) => {
                var file = file;
                match &file.read_to_buffer() {
                    Result::Ok(contents) => {
                        print_buffer(1i32, Buffer::new().push_static("file: ").push_buffer(contents));
                    },
                    Result::Err(code) => {
                        print(1i32, "file: unreadable\n");
                    },
                }
                let closed = file.close();
            },
            Result::Err(code) => {
                print(1i32, "file: cannot open\n");
            },
        }
    } else {
        print(1i32, "file: cannot write\n");
    }
    path.destroy();
}

// Runs `line` (each argument followed by a NUL) and prints how it ended.
fn show_run(line: Buffer!) {
    var line = line;
    var out = Buffer::new().push_static("run: ");
    match run(&line) {
        Result::Ok(exit) => match exit {
            Exit::Code(code) => {
                out = out.push_static("exit ").push_usize((code as usize));
            },
            Exit::Signal(number) => {
                out = out.push_static("signal ").push_usize((number as usize));
            },
        },
        Result::Err(e) => {
            out = out.push_static("error ").push_usize((e.errno as usize));
        },
    }
    print_buffer(1i32, out.push_byte(b'\n'));
    line.destroy();
}

fn show_clock() {
    let start = Instant::now();
    let later = Instant::now();
    if start.nanos_until(later) < 60000000000u64 && later.nanos_until(start) == 0u64 {
        print(1i32, "clock: monotonic\n");
    } else {
        print(1i32, "clock: wrong\n");
    }
}

// The bits of the double that `text` spells, and of the nearest float, or
// `none`.
fn show_float(text: Slice[u8, 'static]) {
    var out = Buffer::new().push_static("float ").push_static(text).push_static(": ");
    var read = StaticRead::new();
    match parse_f64(&read, text) {
        Option::Some(value) => {
            let bits = value.to_bits();
            let single = value.to_f32().to_bits();
            out = out.push_usize((bits as usize)).push_static(" f32 ").push_usize((single as usize));
            if f64::from_bits(bits).to_bits() != bits || f32::from_bits(single).to_f64().to_f32().to_bits() != single {
                out = out.push_static(" (a round trip lost bits)");
            }
        },
        Option::None => {
            out = out.push_static("none");
        },
    }
    print_buffer(1i32, out.push_byte(b'\n'));
}

fn main() -> i32 {
    show_arguments();
    show_environment();
    show_file();
    show_run(Buffer::new().push_static("true").push_byte(0u8));
    show_run(Buffer::new().push_static("sh").push_byte(0u8).push_static("-c").push_byte(0u8).push_static("exit 3").push_byte(0u8));
    show_run(Buffer::new().push_static("kursal-example-no-such-program").push_byte(0u8));
    show_run(Buffer::new().push_static("true"));
    show_clock();
    show_float("1");
    show_float("-2.5e3");
    show_float("0.1");
    show_float("1e400");
    show_float("4.9e-324");
    show_float(" 1");
    show_float("1x");
    show_float("");
    0
}
