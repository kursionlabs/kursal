// A library that keeps its type's representation to itself. `Stock` is a
// bare `struct`, not `exposed`: outside this module no code can write
// `Stock.{ ... }`, read its fields or take it apart, so every `Stock` was
// made by `new` and changed only by `add` and `take`, and its count is
// never more than its capacity. `examples/shop` is a program that uses it.
//
// `Stock` is `Copy`: it holds two numbers and owns nothing. Its methods
// take it in place (`&self`), as `&stock.add(3)`.

use std::option::Result;

struct Stock {
    count: u32,
    capacity: u32,
}

// Why `add` or `take` did nothing.
exposed enum Shortage {
    // `take` asked for more than the count, which it holds
    NotEnough(u32),
    // `add` would pass the capacity, leaving room for this many
    NoRoom(u32),
}

impl Stock {
    // An empty stock that can hold `capacity` items.
    fn new(capacity: u32) -> Stock {
        Stock.{ count: 0u32, capacity }
    }

    fn count(self) -> u32 {
        self.count
    }

    fn capacity(self) -> u32 {
        self.capacity
    }

    // Adds `n` items, unless that would pass the capacity.
    fn add(&self, n: u32) -> Result[(), Shortage] {
        let room = self.capacity - self.count;
        if n > room {
            return Result::Err.(Shortage::NoRoom.(room));
        }
        self = Stock.{ count: self.count + n, capacity: self.capacity };
        Result::Ok.(())
    }

    // Takes `n` items, unless there are fewer.
    fn take(&self, n: u32) -> Result[(), Shortage] {
        if n > self.count {
            return Result::Err.(Shortage::NotEnough.(self.count));
        }
        self = Stock.{ count: self.count - n, capacity: self.capacity };
        Result::Ok.(())
    }
}
