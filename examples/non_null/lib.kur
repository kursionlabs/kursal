// `NonNull[T]`, the builtin pointer that is never null, and the layout it
// gives enums. Its all-zero value is no value of the type, so an enum of two
// variants, one holding a `NonNull` (directly, or in a struct, tuple or array)
// and the other holding nothing, is its payload alone, the empty variant a
// null in it. The compiler decides that from the types: `Option` and `NonNull`
// are not special names, and a user's own enum gets the same layout. A check
// that fails prints its name.
use std::arena::{Domain!, ref_in};
use std::collections::list::List;
use std::io::print;
use std::mem::Ref;
use std::option::Option;
use std::slice::Slice;
use std::mem::{alloca, sizeof};
use std::ptr::NonNull;
use std::process::hash_seed;

fn check(ok: bool, what: Slice[u8, 'static]) {
    if !ok {
        print(what);
        print(": wrong\n");
    }
}

// A user's enum, laid out as `Option[NonNull[u64]]` is.
exposed enum Link {
    End,
    Next(NonNull[u64]),
}

// A struct with a `NonNull`: its niche is at `start`, the first field that
// has one.
exposed struct Run {
    len: usize,
    start: NonNull[u8],
}

// Enums that keep a tag: two variants with data, or more than one without.
exposed enum Either {
    Left(NonNull[u8]),
    Right(u32),
}

exposed enum Three {
    None,
    Empty,
    Some(NonNull[u8]),
}

fn follow(link: Link) -> u64 {
    match link {
        End => 0,
        Next(p) => unsafe *(p as *u64),
    }
}

fn length(run: Option[Run]) -> usize {
    match run {
        None => 0,
        Some(r) => {
            let { len, start } = r;
            len
        },
    }
}

forall T where Copy[T].
fn is_some(o: Option[T]) -> bool {
    match o {
        None => false,
        Some(x) => true,
    }
}

fn main() -> i32 {
    let word = sizeof[*u8]();
    check(sizeof[NonNull[u8]]() == word, "NonNull is a pointer");
    check(sizeof[Option[NonNull[u8]]]() == word, "Option[NonNull[u8]]");
    check(sizeof[Link]() == word, "a user's enum");
    check(sizeof[Option[Run]]() == sizeof[Run](), "a struct with a NonNull");
    check(sizeof[Option[(u32, NonNull[u8])]]() == sizeof[(u32, NonNull[u8])](), "a tuple with a NonNull");
    check(sizeof[Option[[NonNull[u8]; 2]]]() == 2 * word, "an array of NonNull");
    check(sizeof[Option[*u8]]() > word, "a raw pointer has no niche");
    check(sizeof[Option[Option[NonNull[u8]]]]() > word, "an enum has no niche");
    check(sizeof[Either]() > word && sizeof[Three]() > word, "enums that keep a tag");
    check(sizeof[Option[Ref[u64, 'static]]]() == word, "Option[Ref]");

    // `NonNull::new` checks; a `NonNull` is a pointer again with a safe `as`.
    let cell = unsafe alloca[u64]();
    unsafe *cell = 41;
    let null = unsafe (0usize as *u64);
    check(!is_some(NonNull::new(null)), "new of null");
    let p = match NonNull::new(cell) {
        Some(p) => p,
        None => return 1,
    };
    check(p.as_ptr() == cell && (p as *u64) == cell, "the pointer back");
    check(p == unsafe (cell as NonNull[u64]), "NonNull equality");
    check(follow(Link::Next.(p)) == 41 && follow(Link::End) == 0, "matching a user's enum");

    let text = "abc";
    let (bytes, len, _marker) = text.into_parts();
    let start = unsafe NonNull::new_unchecked(bytes);
    check(length(Option::Some.(Run.{ len, start })) == 3 && length(Option::None) == 0, "a struct in an Option");

    // Lists and refs are one word per link.
    var exists 'a. cx = Domain!::new(hash_seed());
    let r = ref_in(&cx, 5u64);
    var o: Option[Ref[u64, 'a]] = Option::None;
    check(!is_some(o), "an empty Option[Ref]");
    o = Option::Some.(r);
    let five = match o {
        Some(r) => r.copy(&cx),
        None => 0,
    };
    check(five == 5, "a full Option[Ref]");
    let empty: List[u32, 'a] = List::empty();
    check(sizeof[List[u32, 'a]]() == word, "a list is a pointer");
    let list = empty.cons(&cx, 2u32).cons(&cx, 1u32);
    check(list.len(&cx) == 2usize, "a list");
    cx.destroy();
    0
}
