// A match case names a variant by its label alone, `Some(x)` or `None`,
// looked up in the sum the scrutinee has; `Option::Some(x)` still works,
// and one match may mix both. A sum with no name has labels too: a
// `foreach` over an `Option` is the sum of what each variant maps to.
use std::io::print;
use std::option::{Option, Result};
use std::slice::Slice;

fn check(ok: bool, what: Slice[u8, 'static]) {
    if !ok {
        print(what);
        print(": wrong\n");
    }
}

enum Shape {
    Dot,
    Line(u32),
    Box(u32, u32),
}

fn area(s: Shape) -> u32 {
    match s {
        Dot => 0,
        Line(n) => n,
        Box(w, h) => w * h,
    }
}

// Grouped labels, a qualified case beside them, and a scrutinee lent in place.
fn width(&s: Shape) -> u32 {
    match &s {
        Dot | Line => 1,
        Shape::Box(w, _) => w,
    }
}

forall T.
fn has(&o: Option[T]) -> bool {
    match &o {
        Some(_) => true,
        None => false,
    }
}

fn code(r: Result[u32, u8]) -> u32 {
    match r {
        Ok(v) => v,
        Err(e) => e as u32,
    }
}

// The foreach maps each variant's payload; its result is a sum with the
// same labels, `Some` holding `(u8,)` and `None` holding `((),)`.
fn doubled(o: Option[u8]) -> u32 {
    let wrapped = foreach x of o { (x,) };
    match wrapped {
        Some(one) => {
            let (v,) = one;
            (v as u32) * 2
        },
        None(_) => 0,
    }
}

fn main() -> i32 {
    var b = Shape::Box(2, 3);
    check(width(&b) == 2, "a lent match");
    check(area(b) == 6 && area(Shape::Line(4)) == 4 && area(Shape::Dot) == 0, "labels of a declared sum");
    var o = Option::Some(7u8);
    var n: Option[u8] = Option::None;
    check(has(&o) && !has(&n), "labels of a generic sum");
    check(code(Result::Ok(5)) == 5 && code(Result::Err(9)) == 9, "labels of a result");
    check(doubled(o) == 14 && doubled(n) == 0, "labels of a sum a foreach made");
    0
}
