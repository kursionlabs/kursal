// Prompts "What's your name?", reads a line from stdin, capitalizes its
// first letter, and greets it with `f"Hello, {&name}!"`. The name is a heap
// `Buffer!`, not a `'static` literal; `{&name}` formats it and hands it
// back, so it is still ours to free.
//
// `Buffer!` is restricted: its bytes are reached through `open`, which
// gives a brand-checked view, and `restore`, which gives the buffer back.

use std::bytes::buffer::Buffer;
use std::slice::byte_or_zero;
use std::ascii::to_upper;
use std::io::{read_line, print, print_bytes};
use std::option::{Option, Result};

// A copy of `name` with its first byte uppercased.
fn capitalize(name: Buffer!) -> Buffer! {
    let exists 'open1. (tag, bytes, restore) = name.open();
    var out = Buffer::new();
    var i = 0usize;
    while i < bytes.len() {
        let b = byte_or_zero(&tag, bytes, i);
        let b = if i == 0 { to_upper(b) } else { b };
        out = out.push_byte(b);
        i = i + 1;
    }
    restore.restore(tag).destroy();
    out
}

fn main() -> i32 {
    print(1, "What's your name?\n");

    // The end of the input is an empty name; a read error stops the program.
    let line = match read_line() {
        Result::Ok(line) => match line {
            Option::Some(line) => line,
            Option::None => Buffer::new(),
        },
        Result::Err(error) => return 1,
    };
    let name = capitalize(line);
    let greeting = f"Hello, {&name}!\n";
    name.destroy();

    let exists 'open1. (gtag, gs, grestore) = greeting.open();
    print_bytes(1, &gtag, gs);
    grestore.restore(gtag).destroy();
    0
}
