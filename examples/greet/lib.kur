// Prompts "What's your name?", reads a line from stdin, capitalizes its
// first letter, and greets it with `f"Hello, {&name}!"`. The name is a heap
// `Buffer!`, not a `'static` literal; `{&name}` formats it and hands it
// back, so it is still ours to free.
//
// The `!` marks a linear type: each `Buffer!` is used exactly once, here by
// `destroy` or `print`, which free it. `Buffer!` is also restricted:
// its bytes are reached through `open`, which gives a brand-checked view,
// and `restore`, which gives the buffer back.

use std::buffer::Buffer!;
use std::fmt::Writer;
use std::slice::byte_or_zero;
use std::ascii::to_upper;
use std::io::{Error, print, stdin};
use std::option::{Option, Result};

// A copy of `name` with its first byte uppercased.
fn capitalize(name: Buffer!) -> Buffer! {
    var exists 'open1. (tag, bytes, restore) = name.open();
    var out = Buffer!::new();
    var i = 0usize;
    while i < bytes.len() {
        let b = byte_or_zero(&tag, bytes, i);
        let b = if i == 0 { to_upper(b) } else { b };
        out = out.write_byte(b);
        i = i + 1;
    }
    restore.restore(tag).destroy();
    out
}

// An I/O error ends the program through `?`; `main` returning it reports it
// on stderr and exits with status 1.
fn main() -> Result[(), Error] {
    print("What's your name?\n")?;

    // `stdin` holds standard input until `finish` gives it back, with what
    // was read ahead past the line. The end of the input is an empty name.
    var input = stdin()?;
    let read = &input.read_line();
    match input.finish() {
        Ok(ahead) => ahead.destroy(),
        Err(e) => (),
    }
    let line = match read? {
        Some(line) => line,
        None => Buffer!::new(),
    };
    var name = capitalize(line);
    let printed = print(f"Hello, {&name}!\n");
    name.destroy();
    printed
}
