// Tuples, spelled `(T1, T2, ...)`: a struct whose fields are named
// `_0`, `_1`, .... `()` is unit, and a single element needs a trailing
// comma (`(T,)`) to be a 1-tuple rather than a parenthesized expression.

fn make_pair(x: u32, y: u32) -> (u32, u32) {
    (x, y)
}

fn swap(p: (u32, u32)) -> (u32, u32) {
    let (a, b) = p;
    (b, a)
}

// `.0` reads like a struct field: it consumes the whole tuple, so taking
// out more than one element needs `let (a, b, ...) = expr;`.
fn sum_pair(p: (u32, u32)) -> u32 {
    p.0 + p.1
}

// Builds the tuple at the call.
fn sum_pair_wrapper(x: u32, y: u32) -> u32 {
    sum_pair((x, y))
}

fn first_of_three(t: (u32, u32, u32)) -> u32 {
    let (a, b, c) = t;
    a
}

// Type arguments are inferred through a tuple's element types. `Copy[U]`
// is required: an unbounded type parameter counts as linear, since a
// caller could instantiate `U` with a linear type, and dropping `b` would
// then leak it.
forall T, U where Copy[U]. fn fst(p: (T, U)) -> T {
    let (a, b) = p;
    a
}

fn unit_returning() -> () {
    ()
}

exposed struct Box! {
    v: u32,
}

// A linear element makes the whole tuple linear, like a linear field in a
// struct: it is passed by value and can only be taken apart once.
fn boxed_pair(a: u32, b: u32) -> (Box!, Box!) {
    (Box!.{ v: a }, Box!.{ v: b })
}

fn sum_boxed_pair(p: (Box!, Box!)) -> u32 {
    let (x, y) = p;
    let { v: a } = x;
    let { v: b } = y;
    a + b
}

fn boxed_pair_round_trip(a: u32, b: u32) -> u32 {
    sum_boxed_pair(boxed_pair(a, b))
}
