// Extern interop: allocate on the C heap, cast the raw *u8 to a *u32, and
// store and load through it. Each unsafe operation is marked on its own.

extern "C" fn malloc(size: usize) -> *u8;

fn make_and_read(v: u32) -> u32 {
    let raw = unsafe malloc(4);
    let p = unsafe (raw as *u32);
    unsafe *p = v;
    unsafe *p
}
