// Extern interop: allocate on the C heap, cast the raw *u8 to a *u32, store
// and load through it, and free it. Each unsafe operation is marked on its
// own. The function owns the block from `malloc` to `free`: it checks for
// null before touching it, and frees it on the one path that allocated it.

use core::option::Option;
use core::ptr::is_null;

extern "C" fn malloc(size: usize) -> *u8;
extern "C" fn free(p: *u8);

// `v`, stored on the heap and read back, or `None` when `malloc` has no
// memory to give.
fn round_trip(v: u32) -> Option[u32] {
    let raw = unsafe malloc(4usize);
    if is_null(raw) {
        return Option::None;
    }
    // `raw` is a live block of 4 bytes, aligned for every type.
    let p = unsafe (raw as *u32);
    unsafe *p = v;
    let read = unsafe *p;
    // Nothing reads `p` again, and `raw` came from `malloc`.
    unsafe free(raw);
    Option::Some.(read)
}
