// Struct construction and field access, and a `while` loop carrying
// mutable locals across iterations.

exposed struct Point {
    x: u32,
    y: u32,
}

fn make_point(a: u32, b: u32) -> Point {
    Point.{ x: a, y: b }
}

fn point_sum(p: Point) -> u32 {
    p.x + p.y
}

fn sum_to_n(n: u32) -> u32 {
    var acc = 0u32;
    var i = n;
    while i != 0 {
        acc = acc + i;
        i = i - 1;
    }
    acc
}

fn max_u32(a: u32, b: u32) -> u32 {
    if a > b { a } else { b }
}
