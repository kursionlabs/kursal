// Constants: module `const`s and the associated `const`s of a type, used to
// print a table of temperatures. A constant's type is written out, and its
// value is computed when the program is compiled, from literals and other
// constants. `u8::MAX` and `i32::BITS` are associated constants of the
// standard library (`core::num`).

use std::io::print_buffer;

// The degrees between two rows of the table.
const STEP: i32 = 20;

exposed struct Celsius {
    degrees: i32,
}

impl Celsius {
    // Where water freezes and boils, at sea level.
    const FREEZING: i32 = 0;
    const BOILING: i32 = 100;

    fn fahrenheit(self) -> i32 {
        self.degrees * 9 / 5 + 32
    }
}

// A module constant computed from the others: the rows from freezing to
// boiling, both included.
const ROWS: i32 = (Celsius::BOILING - Celsius::FREEZING) / STEP + 1;

fn main() {
    print_buffer(f"{ROWS} rows, every {STEP} degrees:\n");
    var degrees = Celsius::FREEZING;
    while degrees <= Celsius::BOILING {
        let fahrenheit = Celsius.{ degrees }.fahrenheit();
        print_buffer(f"{degrees} C = {fahrenheit} F\n");
        degrees = degrees + STEP;
    }
    print_buffer(f"a u8 holds 0 to {u8::MAX}; an i32 has {i32::BITS} bits\n");
}
