// Shared access through std::mem: Owned::new (allocate and initialise) ->
// open -> Region::share (trade the region for its Exclusive! plus a
// shareable Ref) -> two Ref accesses -> resume -> close -> into_value.
// Both accesses use the same Ref (it is Copy), but each threads the one
// live Exclusive!, which is what actually gates the access.

use std::owned::Owned!;

// Doubles a shared u32 in place (`with`), then reads the doubled value back
// (`copy`), through the same Ref and the same Exclusive! lineage.
fn double_via_ref(start: u32) -> u32 {
    let o = Owned!::new(start);
    let exists 'open1. (alloc, reg) = o.open();
    var (tag, r, back) = reg.share();
    let old = r.with(&tag, |v: u32| (v + v, v));
    let doubled = r.copy(&tag);
    let reg = back.resume(tag);
    let last = alloc.close(reg).into_value();
    doubled
}

fn main() -> i32 {
    ((double_via_ref(21) - 42) as i32)
}
