// Enums: `enum Name { Variant(Type), Bare, ... }` is a tagged union, and
// `match` dispatches once on its tag, with one arm per variant (or one
// `|`-joined or wildcard arm for several). Exhaustiveness is checked over
// the declared variants. Patterns are not nested.

exposed enum Shape {
    Circle(f64),
    Square(f64),
    Rect(f64, f64),
}

fn area(s: Shape) -> f64 {
    match s {
        Shape::Circle(r) => r * r * 3.14159,
        Shape::Square(side) => side * side,
        Shape::Rect(w, h) => w * h,
    }
}

fn circle_area(r: f64) -> f64 {
    area(Shape::Circle.(r))
}

fn square_area(side: f64) -> f64 {
    area(Shape::Square.(side))
}

fn rect_area(w: f64, h: f64) -> f64 {
    area(Shape::Rect.(w, h))
}

// A `|`-joined or wildcard arm binds no payload, so it can cover variants
// with different payloads or none.
exposed enum Color {
    Red,
    Green,
    Blue,
    Custom(u32),
}

fn is_primary(c: Color) -> bool {
    match c {
        Color::Red | Color::Green | Color::Blue => true,
        _ => false,
    }
}

fn is_primary_red() -> bool {
    is_primary(Color::Red)
}

fn is_primary_custom() -> bool {
    is_primary(Color::Custom.(5))
}

// A linear payload (Box! here) makes the whole enum linear, as a linear
// field makes a struct linear. It is matched exactly once, and the
// payload is taken apart inside its arm.
exposed struct Box! {
    v: u32,
}

exposed enum MaybeBox! {
    Some(Box!),
    None,
}

fn unwrap_or(m: MaybeBox!, default: u32) -> u32 {
    match m {
        MaybeBox!::Some(b) => {
            let { v } = b;
            v
        },
        MaybeBox!::None => default,
    }
}

fn make_some(v: u32) -> MaybeBox! {
    MaybeBox!::Some.(Box!.{ v })
}

fn make_none() -> MaybeBox! {
    MaybeBox!::None
}

fn unwrap_or_wrapper(v: u32, default: u32) -> u32 {
    unwrap_or(make_some(v), default)
}

fn unwrap_none_wrapper(default: u32) -> u32 {
    unwrap_or(make_none(), default)
}
