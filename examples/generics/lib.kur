// Generic structs and functions, with type arguments inferred at every
// call and construction site.

forall T. exposed struct Box {
    val: T,
}

forall T. fn identity(x: T) -> T {
    x
}

fn unbox_u32() -> u32 {
    let b = Box.{ val: 5u32 };
    b.val
}

fn call_identity(n: u32) -> u32 {
    identity(n)
}

forall A, B. exposed struct Pair {
    first: A,
    second: B,
}

fn swap_pair(a: u32, b: u64) -> Pair[u64, u32] {
    let p = Pair.{ first: a, second: b };
    Pair.{ first: p.second, second: p.first }
}
