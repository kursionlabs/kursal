// `std::option`'s `Option[T]` and `Result[T, E]`, and the `?` operator:
// `f()?` means `match f() { Ok(v) => v, Err(e) => return
// Result::Err(e) }`. One chain over `Result` and one over `Option`, each
// passing a value through several `?`s, with any failure short-circuiting
// the whole chain.

use std::option::{Option, Result};

// --- Result[T, E]: a two-step fallible computation ---

// `1` marks division by zero, the only failure here; a real program would
// likely give the error its own enum.
fn safe_div(a: u32, b: u32) -> Result[u32, u32] {
    if b == 0 {
        Result::Err.(1)
    } else {
        Result::Ok.(a / b)
    }
}

// If the first division fails, the second never runs.
fn checked_compute(a: u32, b: u32, c: u32) -> Result[u32, u32] {
    let x = safe_div(a, b)?;
    let y = safe_div(x, c)?;
    Result::Ok.(y)
}

fn result_to_code(r: Result[u32, u32]) -> u32 {
    match r {
        Ok(v) => v,
        Err(e) => 999,
    }
}

fn compute_ok() -> u32 {
    result_to_code(checked_compute(100, 5, 2))
} // 100/5/2 = 10

fn compute_err_first_division() -> u32 {
    result_to_code(checked_compute(100, 0, 2))
} // 100/0 fails first

fn compute_err_second_division() -> u32 {
    result_to_code(checked_compute(100, 5, 0))
} // 20/0 fails second

// --- Option[T]: both values must be present ---

fn non_negative(n: i32) -> Option[i32] {
    if n < 0 {
        Option::None
    } else {
        Option::Some.(n)
    }
}

// `None` carries no payload, so the early return is just `return Option::None`.
fn sum_if_both_non_negative(a: i32, b: i32) -> Option[i32] {
    let x = non_negative(a)?;
    let y = non_negative(b)?;
    Option::Some.(x + y)
}

fn option_to_code(o: Option[i32]) -> i32 {
    match o {
        Some(v) => v,
        None => -1,
    }
}

fn sum_both_ok() -> i32 {
    option_to_code(sum_if_both_non_negative(3, 4))
} // 7

fn sum_first_negative() -> i32 {
    option_to_code(sum_if_both_non_negative(-3, 4))
} // -1

fn sum_second_negative() -> i32 {
    option_to_code(sum_if_both_non_negative(3, -4))
} // -1

// --- Combinators: the same chains without naming each step ---

// `and_then` passes a value on to the next fallible step, `map` changes a
// value, and `map_err` an error. The closures take their parameter types
// from the `Result` they are called on.
fn chained_compute(a: u32, b: u32, c: u32) -> Result[u32, u32] {
    safe_div(a, b).and_then(|x| safe_div(x, c)).map(|y| y + 1).map_err(|e| e * 100)
}

fn chained_ok() -> u32 {
    result_to_code(chained_compute(100, 5, 2))
} // 100/5/2 + 1 = 11

fn chained_err() -> u32 {
    match chained_compute(100, 0, 2) {
        Ok(v) => v,
        Err(e) => e,
    }
} // the division error 1, scaled by `map_err`: 100

// `ok_or` turns a missing value into an error; `unwrap_or` and `map_or` give
// a fallback instead of matching.
fn halved_or(n: i32, fallback: i32) -> i32 {
    non_negative(n).map(|x| x / 2).unwrap_or(fallback)
}

fn present_count(a: i32, b: i32) -> u32 {
    let first = non_negative(a).map_or(0, |x| 1);
    let second = if non_negative(b).is_some() { 1 } else { 0 };
    first + second
}
