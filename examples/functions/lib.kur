// Function values, indirect calls, and closures. An unsafe function
// value keeps its call contract, so calling it must be marked unsafe.

use core::cap::{Brand, fresh};

fn add_one(x: u32) -> u32 {
    x + 1
}

// `add_one` without call parentheses is a function value of type
// `fn(u32) -> u32`. Calling through it is an ordinary call.
fn call_add_one_indirect(x: u32) -> u32 {
    let fp = add_one;
    fp(x)
}

// A function value quantifies nothing, so a function generic over brands
// is instantiated where it is named: with no type arguments written, its
// brands are inferred from how the value is used, and each must be in
// scope there. `new_tag` has no brand parameter: each call mints its own
// brand. Function values are Copy, so `new_fn` can be called twice.
forall 'k. exposed struct Tag! {
    marker: Brand['k],
}

fn new_tag() -> exists '1. Tag!['1] {
    let exists '1. k = fresh();
    pack '1. Tag!.{ marker: k }
}

forall 'k. fn drop_tag(t: Tag!['k]) -> u32 {
    let { marker } = t;
    0
}

fn make_and_drop_two_tags() -> u32 {
    let new_fn = new_tag;
    let exists 'open1. t1 = new_fn();
    let drop_first = drop_tag;      // 'k is 'open1, inferred from the call
    let u1 = drop_first(t1);
    let exists 'open2. t2 = new_fn();
    let u2 = drop_tag(t2);
    u1 + u2
}

// A capturing closure (`offset` is copied in when the closure is
// created) and a non-capturing one, each created and called locally.
fn make_adder(offset: u32) -> u32 {
    let add = |x: u32| x + offset;
    add(5)
}

fn use_plain_closure() -> u32 {
    let inc = |x: u32| x + 1;
    inc(41)
}

// An extern's address is taken with `unsafe name` (no parentheses), so
// taking a foreign symbol's address is visible in the source. The value
// keeps malloc's unsafe contract: `fp(size)` is unsafe exactly as
// `unsafe malloc(size)` is, otherwise a function value could launder it.
// Here the declaration supplies the marker: the function hands out a raw
// malloc'd pointer, so it is unsafe to call, and its callers mark their
// calls in turn (see `main`).
extern "C" fn malloc(size: usize) -> *u8;

unsafe fn alloc_via_indirect_malloc(size: usize) -> *u8 {
    let fp = unsafe malloc;
    fp(size)
}

// Exits 0 only if every function above produced its expected value.
fn main() -> i32 {
    let heap_ptr = unsafe alloc_via_indirect_malloc(8);
    let null = unsafe (0usize as *u8);
    let ok = call_add_one_indirect(5) == 6 && make_and_drop_two_tags() == 0 && make_adder(10) == 15 && use_plain_closure() == 42 && heap_ptr != null;
    if ok { 0 } else { 1 }
}
