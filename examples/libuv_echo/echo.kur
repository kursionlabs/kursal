use package::tcp::{TcpAction!, TcpServer!};
use std::buffer::Buffer!;
use std::io::{print, eprint};
use std::option::Result;

fn echo(input: Buffer!) -> TcpAction! { TcpAction!::Write.(input) }

fn main() -> i32 {
    var server = match TcpServer!::bind_local(0u16, echo) {
        Ok(server) => server,
        Err(code) => {
            let reported = eprint(f"libuv: cannot listen (error {code})\n");
            return 1i32;
        },
    };
    let port = &server.port();
    let printed = print(f"{port}\n");
    if printed.is_err() {
        server.stop();
        return 1i32;
    }
    match server.run() {
        Ok(unit) => 0i32,
        Err(code) => {
            let reported = eprint(f"libuv: I/O failed (error {code})\n");
            2i32
        },
    }
}
