use package::tcp::{TcpAction!, TcpServer!};
use std::buffer::Buffer!;
use std::io::{print_buffer, eprint_buffer};
use std::option::Result;

fn echo(input: Buffer!) -> TcpAction! { TcpAction!::Write.(input) }

fn main() -> i32 {
    let server = match TcpServer!::bind_local(0u16, echo) {
        Ok(server) => server,
        Err(code) => {
            let reported = eprint_buffer(f"libuv: cannot listen (error {code})\n");
            return 1i32;
        },
    };
    let port = &server.port();
    let printed = print_buffer(Buffer!::new().push_usize(port as usize).push_static("\n"));
    if printed.is_err() {
        server.stop();
        return 1i32;
    }
    match server.run() {
        Ok(unit) => 0i32,
        Err(code) => {
            let reported = eprint_buffer(f"libuv: I/O failed (error {code})\n");
            2i32
        },
    }
}
