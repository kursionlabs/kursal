// A program that depends on the library `examples/stock` (`kur.toml` names
// it under `[dependencies.stock]`) and uses its type through the public
// constructor and methods alone. `Stock`'s fields are the library's own:
// here, `Stock.{ count: 99u32, capacity: 1u32 }` is rejected with "the shape
// of stock::Stock is not exposed here", and so is reading `shelf.count`.

use std::io::print_buffer;
use std::option::Result;
use std::slice::Slice;
use stock::{Shortage, Stock};

// What one delivery or sale did, as a line to print.
fn report(what: Slice[u8, 'static], n: u32, done: Result[(), Shortage], shelf: Stock) {
    let count = shelf.count();
    match done {
        Result::Ok(nothing) => print_buffer(1, f"{what} {n}: {count} in stock\n"),
        Result::Err(shortage) => match shortage {
            Shortage::NotEnough(have) => print_buffer(1, f"cannot {what} {n}: only {have} in stock\n"),
            Shortage::NoRoom(room) => print_buffer(1, f"cannot {what} {n}: room for {room}\n"),
        },
    };
}

fn main() -> i32 {
    var shelf = Stock::new(10u32);
    let capacity = shelf.capacity();
    print_buffer(1, f"a shelf for {capacity}\n");
    let done = &shelf.add(8u32);
    report("deliver", 8u32, done, shelf);
    let done = &shelf.take(3u32);
    report("sell", 3u32, done, shelf);
    let done = &shelf.take(7u32);
    report("sell", 7u32, done, shelf);
    let done = &shelf.add(6u32);
    report("deliver", 6u32, done, shelf);
    0
}
