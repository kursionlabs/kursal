// Sole ownership through std::mem: Owned::new -> open -> a few
// Region::replace calls -> close -> into_value. No Exclusive! and no Ref
// appear: `Owned!` carries no brand because nothing else can name its
// storage, and holding the one linear `Region!` is the proof that nothing
// else is touching the block. The brand exists only between `open` and
// `close`, and `close` takes the whole region back, so reclaiming the
// allocation is a type-level fact rather than a convention.

use std::owned::Owned!;
use std::mem::Region!;

// Bumps the region's u32 by `step` and returns the value it held before.
// `replace` is the primitive (there is no `Region!::with`): the first call
// reads the old value out, leaving a placeholder that the second overwrites
// with the bumped value.
forall 'r.
fn bump(&reg: Region![u32, 'r], step: u32) -> u32 {
    let v = &reg.replace(0);
    let placeholder = &reg.replace(v + step);
    v
}

// Bumps an owned u32 counter by `step` three times and returns the value
// it held right before the last bump.
fn bump_three_times(start: u32, step: u32) -> u32 {
    let o = Owned!::new(start);
    var exists 'open1. (alloc, reg) = o.open();
    let v0 = bump(&reg, step);
    let v1 = bump(&reg, step);
    let v2 = bump(&reg, step);
    let last = alloc.close(reg).into_value();
    v2
}

fn main() -> i32 {
    ((bump_three_times(10, 5) - 20) as i32)
}
