// `for` loops over iterators. `for x in &it { .. }` runs its body once per
// item of `it`; the `&` lends `it` to each step, and after the loop `it`
// holds the exhausted iterator. The loop is a statement: it runs for its
// effects on the `var`s around it, here an output writer and some totals.
use std::iter::range;
use std::io::stdout;
use std::collections::hashmap::HashMap;
use std::option::Result;

// The first square above `limit`. `return` leaves a loop early; there is no
// `break`, and the squares past the answer are never computed.
fn first_square_over(limit: usize) -> usize {
    var squares = range(0, 1000).map(|x| x * x);
    for s in &squares {
        if s > limit {
            return s;
        }
    }
    0
}

fn ignore(key: u32, value: u32) -> () {
    ()
}

// A map's drain is a linear iterator: it holds the map's capability while it
// runs, so after its loop it is still there to finish, which frees the map.
fn weighted_total() -> u32 {
    let exists 'a. (tag, m) = HashMap::new[u32, u32]();
    let exists 'b. (tag, m, old) = m.insert(tag, 2u32, 10u32);
    let exists 'c. (tag, m, old) = m.insert(tag, 3u32, 100u32);
    var entries = m.drain(tag);
    var total = 0u32;
    for entry in &entries {
        total = total + entry.a * entry.b;
    }
    entries.finish(ignore);
    total
}

fn main() -> i32 {
    var out = stdout();
    var evens = range(0, 10).filter(|x| x % 2 == 0);
    for x in &evens {
        out = f"{x} ".write(out);
    }
    out = f"\n".write(out);
    // Nested loops: each row's iterator is made fresh inside the outer loop.
    var rows = range(1, 4);
    for r in &rows {
        var cols = range(1, 4);
        for c in &cols {
            out = f"{r * c}\t".write(out);
        }
        out = f"\n".write(out);
    }
    let first = first_square_over(50);
    out = f"first square over 50: {first}\n".write(out);
    let total = weighted_total();
    out = f"weighted total: {total}\n".write(out);
    match out.finish() {
        Result::Ok(nothing) => 0,
        Result::Err(code) => 1,
    }
}
