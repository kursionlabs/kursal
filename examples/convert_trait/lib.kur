// Multi-param traits. A multi-param trait has no single target type to
// dot-dispatch on (`5u32.convert()` could not say which `To` it means), so
// its methods are called as `Trait[T1, T2]::method(args)`. `Convert` takes
// one argument and `Combine` two, the two shapes of that call form.

forall From, To. trait Convert {
    fn convert(x: From) -> To;
}

instance Convert[u32, u64] {
    fn convert(x: u32) -> u64 {
        (x as u64)
    }
}

forall X, Y. trait Combine {
    fn combine(x: X, y: Y) -> X;
}

instance Combine[u32, u32] {
    fn combine(x: u32, y: u32) -> u32 {
        x + y
    }
}

fn main() -> i32 {
    let widened = Convert[u32, u64]::convert(5);
    let combined = Combine[u32, u32]::combine(3, 4);
    if widened == 5 && combined == 7 { 0 } else { 1 }
}
