// Spawns two OS threads, each taking ownership of its own `Buffer!` and
// summing its bytes, joins both, and prints the sums.
//
// Each closure moves a linear `Buffer!` into its thread: once `spawn` has
// captured `first` or `second`, `main` cannot touch it again (adding
// `let n = &first.len();` after the first `spawn` is rejected: `first` has
// been moved). Neither thread touches the other's buffer, so there is no
// aliasing in either direction. `spawn` itself is safe; `std::thread`'s
// overview explains why.

use std::buffer::Buffer!;
use std::io::print_buffer;
use std::option::Result;
use std::slice::byte_or_zero;
use std::process::trap;
use std::thread;

fn sum_bytes(buf: Buffer!) -> u32 {
    let exists 'b. (tag, bytes, restore) = buf.open();
    var total = 0u32;
    var i = 0usize;
    while i < bytes.len() {
        total = total + (byte_or_zero(&tag, bytes, i) as u32);
        i = i + 1;
    }
    restore.restore(tag).destroy();
    total
}

fn main() {
    let first = Buffer!::new().push_static("hello");
    let second = Buffer!::new().push_static("world!!");

    // A thread that cannot start hands its closure back unrun, with the
    // buffer it captured; this program runs it here, freeing the buffer,
    // and gives up.
    let spawned_first = match thread::spawn(|| -> u32 { sum_bytes(first) }) {
        Result::Err(failed) => {
            let (f, error) = failed;
            let sum = f();
            trap()
        },
        Result::Ok(t) => t,
    };
    let spawned_second = match thread::spawn(|| -> u32 { sum_bytes(second) }) {
        Result::Err(failed) => {
            let (f, error) = failed;
            let sum = f();
            trap()
        },
        Result::Ok(t) => t,
    };

    let first_sum = match spawned_first.join() {
        Result::Err(error) => 0,
        Result::Ok(value) => value,
    };
    let second_sum = match spawned_second.join() {
        Result::Err(error) => 0,
        Result::Ok(value) => value,
    };

    let total = first_sum + second_sum;
    print_buffer(f"first thread, \"hello\": {first_sum}\nsecond thread, \"world!!\": {second_sum}\ntotal: {total}\n");
}
