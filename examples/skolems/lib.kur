// Skolems, spelled `'k`, name a fresh, unforgeable brand and thread it
// through types. `'k` works as a type (bare, or as an argument as in
// `Ref[T, 'k]`) and as a value (`'static`, or a skolem parameter in
// scope). Minting a fresh brand is an explicit step: `core::cap::fresh()`,
// typed `exists 'x. Brand['x]`, opened with `let exists`.
//
// Taking more than one field out of a linear value needs a destructure
// (`let (a, b) = expr;` or `let { f, g } = expr;`): `.0` or `.field`
// consumes the whole value on its first read.

use core::cap::{Brand, fresh};

forall T. exposed struct Box! {
    value: T,
}

forall 'k. exposed struct Tag! {
    marker: Brand['k],
}

// A value stamped with a brand. Whether it is Copy or linear follows `T`
// at each use.
forall T, 'k. exposed struct Ref {
    value: T,
    marker: Brand['k],
}

forall T. fn mint(b: Box![T]) -> exists '1. (Tag!['1], Ref[T, '1]) {
    let { value } = b;
    let exists '1. k = fresh();
    pack '1. (Tag.{ marker: k }, Ref.{ value, marker: k })
}

fn round_trip(val: u32) -> u32 {
    let exists 'open1. (tag, r) = mint(Box.{ value: val });
    let { marker } = tag; // a zero-size Brand, so dropping it costs nothing
    r.value
}

// A function that receives an already minted brand through a skolem
// parameter, inferred at the call site from the argument like a type
// parameter.
forall 'k. fn use_tag(t: Tag!['k]) -> u32 {
    let { marker } = t;
    5
}

fn make_and_use_tag() -> u32 {
    let exists '1. k = fresh();
    use_tag(Tag.{ marker: k })
}

// Handle!/Ref split: Handle! is linear and owns its value outright, and
// can be fanned out into Copy Refs at the same brand.
forall T, 'k. exposed struct Handle! {
    value: T,
    marker: Brand['k],
}

forall T. fn make_handle(b: Box![T]) -> exists '1. Handle![T, '1] {
    let { value } = b;
    let exists '1. k = fresh();
    pack '1. Handle.{ value, marker: k }
}

// Fans ownership out into two Refs at the same brand. Each field is read
// twice, so the value must be Copy.
forall T, 'k where Copy[T]. fn as_two_refs(h: Handle![T, 'k]) -> (Ref[T, 'k], Ref[T, 'k]) {
    let { value, marker } = h;
    (Ref.{ value, marker }, Ref.{ value, marker })
}

fn fan_out_round_trip(val: u32) -> u32 {
    let exists 'open1. h = make_handle(Box.{ value: val });
    let (r1, r2) = as_two_refs(h);
    r1.value + r2.value
}
