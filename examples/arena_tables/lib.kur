// Tables and scopes in one arena, through its `Domain!`: an `ArenaMap` from
// words to counts and an `ArenaSet` of words, both in the order their keys
// were first inserted, and a persistent `List` of scopes whose bindings are
// added for a while and then dropped by going back to an older list.
//
// It counts the words of a sentence, prints them in first-seen order, removes
// one and puts it back (it then comes last), resolves names through nested
// scopes, and checks the rest of the map, set and list operations. A check
// that fails prints its name.
use std::alloc::arena::Domain!;
use std::bytes::buffer::Buffer!;
use std::collections::arena_map::{ArenaMap, ArenaSet};
use std::collections::arena_vec::ArenaVec;
use std::collections::list::List;
use std::hash::{key_eq, key_hash};
use std::io::{print, print_span};
use std::option::Option;
use std::raw::Span;
use std::slice::Slice;

fn check(ok: bool, what: Slice[u8, 'static]) {
    if !ok {
        print(what);
        print(": wrong\n");
    }
}

// Prints `word count` for every word of the map, in its order.
forall 'k.
fn show(&cx: Domain!['k], counts: ArenaMap[Span['k], u32, 'k]) {
    var i = 0usize;
    while i < counts.positions(&cx) {
        match counts.key_at(&cx, i) {
            Option::Some(word) => {
                let line = Buffer!::new().push_bytes(&cx, word).push_byte(b' ').push_u64(counts.at(&cx, word) as u64).push_static("\n").save(&cx);
                let written = print_span(&cx, line);
            },
            Option::None => (),
        }
        i = i + 1usize;
    }
}

// One binding of a scope: a name and the depth it was bound at.
forall 'k.
exposed struct Binding {
    name: Span['k],
    depth: u32,
}

// The depth of the innermost binding of `name`, if any.
forall 'k.
fn lookup(&cx: Domain!['k], scope: List[Binding['k], 'k], name: Span['k]) -> Option[u32] {
    scope.find_map(&cx, |&c, b| if b.name.eq(&c, name) { Option::Some.(b.depth) } else { Option::None })
}

forall 'k.
fn run(&cx: Domain!['k]) {
    let text = Span::from_static(&cx, "to be or not to be");
    let counts: ArenaMap[Span['k], u32, 'k] = ArenaMap::new(&cx);
    let seen: ArenaSet[Span['k], 'k] = ArenaSet::new(&cx);
    let words = text.split(&cx, Span::from_static(&cx, " "));
    var i = 0usize;
    while i < words.len(&cx) {
        let w = words.at(&cx, i);
        let old = counts.insert(&cx, w, counts.get_or(&cx, w, 0u32) + 1u32);
        let fresh = seen.insert(&cx, w);
        i = i + 1usize;
    }
    show(&cx, counts);
    let to = Span::from_static(&cx, "to");
    check(counts.remove(&cx, to).unwrap_or(0u32) == 2u32 && !counts.contains(&cx, to), "remove");
    check(counts.insert(&cx, to, 9u32).is_none() && counts.insert(&cx, to, 7u32).unwrap_or(0u32) == 9u32, "insert");
    show(&cx, counts);
    check(counts.len(&cx) == 4usize && counts.get(&cx, Span::from_static(&cx, "be")).unwrap_or(0u32) == 2u32, "len, get");
    check(counts.get(&cx, Span::from_static(&cx, "maybe")).is_none(), "get missing");
    let keys = counts.keys(&cx);
    check(keys.at(&cx, 0usize).is(&cx, "be") && keys.at(&cx, 3usize).is(&cx, "to"), "keys");
    check(counts.values(&cx).fold(&cx, 0u32, |&c, a, v| a + v) == 11u32, "values");
    let copy = counts.clone(&cx);
    let gone = copy.remove(&cx, Span::from_static(&cx, "or"));
    check(copy.len(&cx) == 3usize && counts.len(&cx) == 4usize && copy.address() != counts.address(), "clone");
    check(seen.len(&cx) == 4usize && seen.contains(&cx, Span::from_static(&cx, "not")) && !seen.insert(&cx, to), "set");
    check(seen.remove(&cx, to) && !seen.remove(&cx, to) && seen.keys(&cx).len(&cx) == 3usize, "set remove");
    let more: ArenaSet[Span['k], 'k] = ArenaSet::new(&cx);
    more.insert_all(&cx, Span::from_static(&cx, "or so it be").split(&cx, Span::from_static(&cx, " ")));
    let both = seen.union(&cx, more);
    check(more.len(&cx) == 4usize && both.len(&cx) == 5usize && both.keys(&cx).at(&cx, 3usize).is(&cx, "so") && seen.len(&cx) == 3usize, "insert_all, union");
    check(key_eq(&cx, to, words.at(&cx, 4usize)) && key_hash(&cx, to) == key_hash(&cx, words.at(&cx, 0usize)), "key_eq, key_hash");
    let pair = ArenaVec::two(&cx, 1u32, 2u32).concat(&cx, ArenaVec::one(&cx, 3u32));
    check(pair.len(&cx) == 3usize && pair.at(&cx, 2usize) == 3u32, "concat");

    // A map with many keys grows its slots and keeps every one.
    let squares: ArenaMap[u32, u32, 'k] = ArenaMap::new(&cx);
    var n = 0u32;
    while n < 200u32 {
        let old = squares.insert(&cx, n, n * n);
        n = n + 1u32;
    }
    check(squares.len(&cx) == 200usize && squares.at(&cx, 199u32) == 39601u32 && squares.key_at(&cx, 17usize).unwrap_or(0u32) == 17u32, "grow");

    // Scopes: an outer one, an inner one built on it, then back to the outer.
    let x = Span::from_static(&cx, "x");
    let y = Span::from_static(&cx, "y");
    let outer: List[Binding['k], 'k] = List::empty().cons(&cx, Binding.{ name: x, depth: 0u32 });
    let inner = outer.cons(&cx, Binding.{ name: y, depth: 1u32 }).cons(&cx, Binding.{ name: x, depth: 1u32 });
    check(lookup(&cx, inner, x).unwrap_or(9u32) == 1u32 && lookup(&cx, inner, y).unwrap_or(9u32) == 1u32, "inner scope");
    check(lookup(&cx, outer, x).unwrap_or(9u32) == 0u32 && lookup(&cx, outer, y).is_none(), "outer scope");
    check(inner.len(&cx) == 3usize && inner.skip(&cx, 2usize).first(&cx).unwrap_or(Binding.{ name: y, depth: 5u32 }).depth == 0u32, "len, skip");
    let depths = inner.map(&cx, |&c, b| b.depth);
    check(depths.fold(&cx, 0u32, |&c, a, d| a + d) == 2u32 && depths.count(&cx, |&c, d| d == 1u32) == 2usize, "map, fold, count");
    check(depths.reverse(&cx, List::empty()).first(&cx).unwrap_or(9u32) == 0u32 && depths.all(&cx, |&c, d| d < 2u32), "reverse, all");
    let ones = depths.filter(&cx, |&c, d| d == 1u32);
    check(ones.len(&cx) == 2usize && ones.append(&cx, depths).len(&cx) == 5usize && ones.eq_with(&cx, depths.take_ones(&cx), |&c, a, b| a == b), "filter, append, eq_with");
}

forall 'k.
impl List[u32, 'k] {
    // The leading ones of the list, as a list of their own.
    fn take_ones(self, &cx: Domain!['k]) -> List[u32, 'k] {
        match self.first(&cx) {
            Option::Some(d) => if d == 1u32 { self.tail(&cx).take_ones(&cx).cons(&cx, d) } else { List::empty() },
            Option::None => List::empty(),
        }
    }
}

fn main() {
    let exists 'k. cx = Domain!::new();
    var cx = cx;
    run(&cx);
    cx.destroy();
}
