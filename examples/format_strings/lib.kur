// Format strings: `f"...{expr}..."` threads one `Buffer!` through a
// call per part. A `Str['static]`, such as `callee` below, is copied in as
// the literal text around it is; any other `{expr}` is formatted by its
// type's `Format` instance: an integer is written in decimal, a branded
// `Str['k]` is read through the context lent by `.write(&cx, out)`, and
// any other type needs a `Format` instance of its own.
//
// Bytes of a domain are read through its capability. `f"...".write(&cx,
// out)` lends the f-string the context `cx`, through which every `{text}`
// reads, writes into `out`, and hands `out` back with `cx` restored.

use std::arena::Domain!;
use std::slice::bytes_eq;
use std::buffer::Buffer!;
use std::process::hash_seed;
use std::str::{Str, StaticRead};

fn birthday_greeting(age: u32) -> Buffer! {
    f"Happy birthday! You are {age} years old."
}

fn birthday_greeting_matches_expected() -> bool {
    let greeting = birthday_greeting(30);
    var exists 'open1. (tag, s, restore) = greeting.open();
    var sr = StaticRead::new();
    let ok = bytes_eq(&tag, s, &sr, "Happy birthday! You are 30 years old.");
    restore.restore(tag).destroy();
    ok
}

// A compiler-diagnostic-shaped message, mixing a name (a string piece)
// with two counts (integer pieces) in one template.
fn call_arity_error(callee: Str['static], expected: u32, got: u32) -> Buffer! {
    f"call to '{callee}' expects {expected} argument(s), got {got}"
}

fn call_arity_error_matches_expected() -> bool {
    let msg = call_arity_error("scale_twice", 2, 1);
    var exists 'open1. (tag, s, restore) = msg.open();
    var sr = StaticRead::new();
    let ok = bytes_eq(&tag, s, &sr, "call to 'scale_twice' expects 2 argument(s), got 1");
    restore.restore(tag).destroy();
    ok
}

// Text of the domain, read through the context lent to the f-string.
forall 'k.
fn tally(&cx: Domain!['k], fruit: Str['k], count: u32) -> Buffer! {
    f"{count} {fruit}, counted".write(&cx, Buffer!::new())
}

fn tally_matches_expected() -> bool {
    var exists 'k. cx = Domain!::new(hash_seed());
    let fruit = Str::from_static(&cx, "apples");
    let msg = tally(&cx, fruit, 3);
    cx.destroy();
    var exists 'open1. (tag, s, restore) = msg.open();
    var sr = StaticRead::new();
    let ok = bytes_eq(&tag, s, &sr, "3 apples, counted");
    restore.restore(tag).destroy();
    ok
}

fn main() -> i32 {
    if birthday_greeting_matches_expected() && call_arity_error_matches_expected() && tally_matches_expected() {
        0
    } else {
        1
    }
}
