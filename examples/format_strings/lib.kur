// Format strings: `f"...{expr}..."` threads one `Buffer!` through a
// `Format` call per part. Each `{expr}` is formatted by its type's
// `Format` instance: a string literal is copied in, an integer is written
// in decimal, and any other type needs a `Format` instance of its own.
// `birthday_greeting` is the message `strings` builds from five separate
// builder calls, as one `f"..."` expression.

use std::slice::{Slice, StaticRead, bytes_eq};
use std::bytes::buffer::Buffer;

fn birthday_greeting(age: u32) -> Buffer! {
    f"Happy birthday! You are {age} years old."
}

fn birthday_greeting_matches_expected() -> bool {
    let greeting = birthday_greeting(30);
    let exists 'open1. (tag, s, restore) = greeting.open();
    var sr = StaticRead::get();
    let ok = bytes_eq(&tag, s, &sr, "Happy birthday! You are 30 years old.");
    restore.restore(tag).destroy();
    ok
}

// A compiler-diagnostic-shaped message, mixing a name (a string piece)
// with two counts (integer pieces) in one template.
fn call_arity_error(callee: Slice[u8, 'static], expected: u32, got: u32) -> Buffer! {
    f"call to '{callee}' expects {expected} argument(s), got {got}"
}

fn call_arity_error_matches_expected() -> bool {
    let msg = call_arity_error("scale_twice", 2, 1);
    let exists 'open1. (tag, s, restore) = msg.open();
    var sr = StaticRead::get();
    let ok = bytes_eq(&tag, s, &sr, "call to 'scale_twice' expects 2 argument(s), got 1");
    restore.restore(tag).destroy();
    ok
}

fn main() -> i32 {
    if birthday_greeting_matches_expected() && call_arity_error_matches_expected() {
        0
    } else {
        1
    }
}
