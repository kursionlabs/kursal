// Zero-size types: `()`, brands, capabilities such as `Exclusive!`, structs
// and tuples of nothing else, enums aside (a tag is a byte or more), and arrays
// of length 0 or of zero-size elements. They have no bytes: `sizeof` of one
// is 0, a struct holding one is no bigger for it, and passing, returning,
// storing, matching and keeping them in the arena costs nothing. Reading or
// writing one through a pointer reads and writes nothing, so every container
// holds them: a vector of units counts, and a map to `()` is a set. A check
// that fails prints its name.
use std::arena::Domain!;
use std::cap::{Brand, Exclusive!};
use std::collections::arena_vec::ArenaVec;
use std::collections::hashmap::OwnedMap!;
use std::collections::vec::OwnedVec!;
use std::io::print;
use std::mem::{Ref, alloca};
use std::owned::Owned!;
use std::slice::Slice;
use std::mem::sizeof;

fn check(ok: bool, what: Slice[u8, 'static]) {
    if !ok {
        print(what);
        print(": wrong\n");
    }
}

exposed struct Marker {}

// A value with its domain's capability and zero-size company: as big as its
// `value`.
forall 'k.
exposed struct Tagged! {
    tag: Exclusive!['k],
    unit: (),
    nothing: [u64; 0],
    value: u64,
    marker: Marker,
}

exposed enum Shape {
    Empty,
    Mark(Marker),
    Pair(Marker, ()),
    Value(u64),
}

fn mark() -> Marker {
    Marker.{}
}

// Takes and returns nothing that has bytes.
fn ignore(m: Marker, u: ()) -> () {
    u
}

forall T.
fn same(x: T) -> T {
    x
}

fn score(s: Shape) -> u64 {
    match s {
        Shape::Empty => 1,
        Shape::Mark(m) => 2,
        Shape::Pair(m, u) => 3,
        Shape::Value(v) => v,
    }
}

forall T.
exposed struct Wrapped {
    v: T,
}

forall T.
fn wrap(x: T) -> Wrapped[T] {
    Wrapped.{ v: x }
}

exposed struct Mixed {
    a: Marker,
    b: u32,
    c: (),
}

// A zero-size place beside one with bytes.
fn bump(&m: Marker, &n: u64) {
    m = mark();
    n = n + 1;
}

// A value moved into its own heap block and back out.
forall T.
fn boxed(x: T) -> T {
    Owned!::new(x).into_value()
}

// A brand's witness beside a unit: zero-size, kept behind a pointer.
forall 'k.
exposed struct Witness {
    brand: Brand['k],
    unit: (),
}

forall 'k.
fn take(t: Tagged!['k]) -> u64 {
    let { tag, unit, nothing, value, marker } = t;
    let done = tag.retire();
    value
}

fn main() -> i32 {
    check(sizeof[()]() == 0 && sizeof[Marker]() == 0 && sizeof[[u64; 0]]() == 0
        && sizeof[[Marker; 4]]() == 0 && sizeof[(Marker, ())]() == 0, "zero sizes");
    check(sizeof[(u64, Marker, ())]() == sizeof[u64](), "a tuple's size");

    let exists 'k. (brand, tag) = Exclusive!::fresh();
    check(sizeof[Exclusive!['k]]() == 0 && sizeof[Tagged!['k]]() == sizeof[u64](), "a capability's size");
    let tagged = Tagged!.{ tag, unit: (), nothing: [], value: 40, marker: same(mark()) };
    check(take(tagged) == 40, "a struct with zero-size fields");

    var m = mark();
    var n = 1u64;
    bump(&m, &n);
    check(n == 2, "a zero-size place parameter");

    let f = ignore;
    let unit = f(same(m), same(()));
    let shapes = score(Shape::Empty) + score(Shape::Mark.(m)) + score(Shape::Pair.(m, ())) + score(Shape::Value.(10));
    check(shapes == 16, "an enum with zero-size payloads");

    let mixed = Mixed.{ a: mark(), b: 5, c: () };
    let wrapped = foreach f of mixed { (wrap(f), m) };
    let { a: wa, b: wb, c: wc } = wrapped;
    let (inner, _marker) = wb;
    check(inner.v == 5, "a foreach over zero-size components");

    let empty = "";
    check(empty.len() == 0, "an empty string");

    let exists 'a. cx = Domain!::new();
    let pairs: ArenaVec[(Marker, u32), 'a] = ArenaVec::new(&cx);
    var i = 0u32;
    while i < 100 {
        pairs.push(&cx, (mark(), i));
        i = i + 1;
    }
    let held = Ref::new(&cx, (mark(), 7u32));
    let (_m, seven) = held.copy(&cx);
    let (_n, last) = pairs.at(&cx, 99usize);
    check(seven == 7 && last == 99 && pairs.len(&cx) == 100usize, "arena values with zero-size parts");
    let markers: ArenaVec[Marker, 'a] = ArenaVec::filled(&cx, 1000usize, mark());
    let unit = Ref::new(&cx, ());
    let again = unit.copy(&cx);
    check(markers.len(&cx) == 1000usize, "arena values of zero-size types");
    cx.destroy();

    var units = OwnedVec!::new[()]();
    var k = 0u32;
    while k < 1000 {
        units = units.push(boxed(()));
        k = k + 1;
    }
    let popped = &units.pop();
    let counted = &units.len();
    units.free();
    check(popped.is_some() && counted == 999usize, "a vector of units");

    var set = OwnedMap!::new[u32, ()]();
    var s = 0u32;
    while s < 100 {
        let old = &set.insert(s % 10, ());
        s = s + 1;
    }
    var key = 7u32;
    let present = &set.contains(&key);
    let removed = &set.remove(&key);
    let size = &set.len();
    set.free();
    check(present && removed.is_some() && size == 9usize, "a set");

    let exists 'w. (witness, cap) = Exclusive!::fresh();
    let slot = unsafe alloca[Witness['w]]();
    unsafe *slot = Witness.{ brand: witness, unit: () };
    let { brand: read, unit: nothing } = unsafe *slot;
    check(unsafe (slot as usize) != 0usize, "a pointer to a zero-size value");
    cap.retire();
    0
}
