// A call bounded by a trait is resolved statically for each instantiation;
// no vtable is needed.

forall Self. trait Scale {
    fn scale(self: Self, factor: u32) -> Self;
}

// Two different structs with the same shape (each wraps one u32): instance
// matching is by declared name, not by layout.
exposed struct Cube {
    side: u32,
}

exposed struct Sphere {
    radius: u32,
}

instance Scale[Cube] {
    fn scale(self: Cube, factor: u32) -> Cube {
        Cube.{ side: self.side * factor }
    }
}

instance Scale[Sphere] {
    fn scale(self: Sphere, factor: u32) -> Sphere {
        Sphere.{ radius: self.radius * factor }
    }
}

// Checked once with `T` abstract; works for any `T` with a `Scale` instance.
forall T where Scale[T]. fn scale_twice(x: T, factor: u32) -> T {
    x.scale(factor).scale(factor)
}

fn cube_side_after_double_scale(start: u32, factor: u32) -> u32 {
    scale_twice(Cube.{ side: start }, factor).side
}

fn sphere_radius_after_double_scale(start: u32, factor: u32) -> u32 {
    scale_twice(Sphere.{ radius: start }, factor).radius
}

// `x` is used as a receiver twice, which only `Copy` allows; each use calls
// a `Scale` method. Both scale the same `x`, so the results must agree.
forall T where Copy[T], Scale[T]. fn scale_from_both_sides(x: T, factor: u32) -> (T, T) {
    (x.scale(factor), x.scale(factor))
}

fn cube_scale_agrees(start: u32, factor: u32) -> bool {
    let (a, b) = scale_from_both_sides(Cube.{ side: start }, factor);
    a.side == b.side
}

fn main() -> i32 {
    if cube_side_after_double_scale(2, 3) != 18 {
        return 1;
    }
    if sphere_radius_after_double_scale(2, 3) != 18 {
        return 1;
    }
    if cube_scale_agrees(2, 3) { 0 } else { 1 }
}
