// Fixed-size arrays, spelled `[T; N]`.
//
// A literal is either every element (`[e0, e1, e2]`) or a shorter prefix
// followed by a bare `..` that repeats its last element out to the target
// length (`[e0, e1, ..]`). The length always comes from context (a `let`,
// return or parameter type), never from the literal. Like Rust's
// `[value; N]`, the repeated element must be Copy, since there is only one
// runtime value to go around; a short list without `..` is an error.
//
// There is no array indexing: an array is built, passed, returned and
// stored in a field, and taken apart whole by a pattern that names every
// element, `let [a, b, c] = xs;` (`core::array::Array!` is the indexable
// kind).

fn triple(a: u32, b: u32, c: u32) -> [u32; 3] {
    [a, b, c]
}

// A short prefix, then `..` repeats the last given element.
fn fill(a: u32, b: u32) -> [u32; 5] {
    [a, b, ..]
}

// A single given element repeats across the whole array.
fn all_same(v: u32) -> [u32; 4] {
    [v, ..]
}

// The length can come from a `let` annotation as well as a return type.
fn fill_via_let(a: u32) -> [u32; 3] {
    let buf: [u32; 3] = [a, ..];
    buf
}

// An array round-trips through a function boundary intact.
fn identity(arr: [u32; 3]) -> [u32; 3] {
    arr
}

exposed struct Point {
    x: u32,
    y: u32,
}

// Any Copy element type works, including a struct whose fields are all Copy.
fn two_points(x1: u32, y1: u32, x2: u32, y2: u32) -> [Point; 2] {
    [Point.{ x: x1, y: y1 }, Point.{ x: x2, y: y2 }]
}

fn same_point_twice(x: u32, y: u32) -> [Point; 2] {
    [Point.{ x, y }, ..]
}
