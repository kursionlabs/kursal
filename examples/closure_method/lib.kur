// `closure(...) -> ...` as a parameter type: an `impl` method taking a
// callback, called with `.method()` syntax and a capturing closure literal.
// This is the shape of std's `Ref::with` in miniature, over a plain struct
// holding one value. The closure's capture environment is a hidden type
// parameter of `with`, and `Ret` is a method-level type parameter
// independent of the impl.

exposed struct Cell {
    value: u32,
}

impl Cell {
    forall Ret. fn with(&self, f: closure(u32) -> (u32, Ret)) -> Ret {
        let (value, ret) = f(self.value);
        self = Cell.{ value };
        ret
    }
}

// Replaces the value with `x + offset`, with `offset` captured by value,
// and returns the cell and the old value.
fn use_it(c: Cell, offset: u32) -> (Cell, u32) {
    var c = c;
    let old = &c.with(|x: u32| (x + offset, x));
    (c, old)
}
