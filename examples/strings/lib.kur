// Strings: text is a `Str['k]`, a view of bytes in domain `'k`, and a
// `"..."` literal is a `Str['static]`. `Str['k]` is another name for
// `Slice[u8, 'k]`, the same type, so the two mix freely. Literal bytes are
// read through `StaticRead`, the permanent read capability for `'static`,
// and `bytes_eq` compares the contents of any two readable views. A
// `Buffer!` builds new text from literal and computed pieces. `len` and the
// range-checked `sub` need no capability: they only compute addresses and
// lengths.

use std::slice::{Slice, Str, StaticRead, byte_or_zero, bytes_eq, bytes_eq_within};
use std::option::Option;
use std::buffer::Buffer!;

fn greeting_length() -> usize {
    "Hello, world!".len()
}

fn first_letter() -> u32 {
    var sr = StaticRead::new();
    (byte_or_zero(&sr, "Kur", 0) as u32)
}

fn same_content_different_literals_are_equal() -> bool {
    var sr = StaticRead::new();
    bytes_eq_within(&sr, "identical", "identical")
}

fn different_content_is_not_equal() -> bool {
    var sr = StaticRead::new();
    bytes_eq_within(&sr, "hello", "world")
}

// The pieces pushed one after another into a new `Buffer!`; open it to
// read its contents.
fn greet(name: Str['static]) -> Buffer! {
    Buffer!::new().push_static("Hello, ").push_static(name)
}

fn greet_matches_expected() -> bool {
    let greeting = greet("Kur");
    var exists 'open1. (tag, s, restore) = greeting.open();
    var sr = StaticRead::new();
    let ok = bytes_eq(&tag, s, &sr, "Hello, Kur");
    restore.restore(tag).destroy();
    ok
}

// A `Str` is a `Slice[u8, _]`: either name passes where the other is written.
fn second_word(sentence: Slice[u8, 'static]) -> Option[Str['static]] {
    // `sub(start, len)` is range-checked; "the quick fox"[4..9] is in range.
    sentence.sub(4, 5)
}

fn word_from_sentence() -> bool {
    match second_word("the quick fox") {
        Some(word) => {
            var sr = StaticRead::new();
            bytes_eq_within(&sr, word, "quick")
        },
        None => false,
    }
}

// The message `format_strings` builds with one `f"..."`, built here by hand.
// The age's digits come from a separately branded buffer, not a literal,
// read through that buffer's own capability.
fn birthday_greeting(age: u32) -> Buffer! {
    let age_buf = Buffer!::new().push_u64(age as u64);
    var exists 'open1. (atag, aslice, arestore) = age_buf.open();
    let text = Buffer!::new().push_static("Happy birthday! You are ").push_bytes(&atag, aslice).push_static(" years old.");
    arestore.restore(atag).destroy();
    text
}

fn birthday_greeting_matches_expected() -> bool {
    let greeting = birthday_greeting(30);
    var exists 'open1. (tag, s, restore) = greeting.open();
    var sr = StaticRead::new();
    let ok = bytes_eq(&tag, s, &sr, "Happy birthday! You are 30 years old.");
    restore.restore(tag).destroy();
    ok
}
