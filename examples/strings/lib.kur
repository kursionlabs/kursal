// Strings: text is a `Str['k]`, a read-only view of bytes in domain `'k`,
// and a `"..."` literal is a `Str['static]`. Nothing writes through a `Str`;
// writable bytes, such as an open `Buffer!`'s, are a `Slice[u8, 'k]`, which
// `as_str` views as text of the same domain. Literal bytes are read through
// `StaticRead`, the permanent read capability for `'static`, and `bytes_eq`
// compares the contents of any two readable views. A `Buffer!` builds new
// text: `put` prints a literal or a number into it (any writer has `put`,
// found through `Writer`), and an f-string written with `.write(&cx, out)`
// reads a `Str['k]` through the capability `cx` lends it. `len` and the
// range-checked `sub` need no capability: they only compute addresses and
// lengths.

use std::slice::{byte_or_zero, bytes_eq_within};
use std::str::{Str, StaticRead};
use std::option::Option;
use std::buffer::Buffer!;
use std::fmt::Writer;

fn greeting_length() -> usize {
    "Hello, world!".len()
}

fn first_letter() -> u32 {
    var sr = StaticRead::new();
    (byte_or_zero(&sr, "Kur", 0) as u32)
}

fn same_content_different_literals_are_equal() -> bool {
    var sr = StaticRead::new();
    bytes_eq_within(&sr, "identical", "identical")
}

fn different_content_is_not_equal() -> bool {
    var sr = StaticRead::new();
    bytes_eq_within(&sr, "hello", "world")
}

// The pieces put one after another into a new `Buffer!`; open it to read
// its contents.
fn greet(name: Str['static]) -> Buffer! {
    Buffer!::new().put("Hello, ").put(name)
}

fn greet_matches_expected() -> bool {
    let greeting = greet("Kur");
    var exists 'open1. (tag, bytes, restore) = greeting.open();
    let ok = bytes.as_str().is(&tag, "Hello, Kur");
    restore.restore(tag).destroy();
    ok
}

// A literal is text like any other: its methods are `Str`'s.
fn second_word(sentence: Str['static]) -> Option[Str['static]] {
    // `sub(start, len)` is range-checked; "the quick fox"[4..9] is in range.
    sentence.sub(4, 5)
}

fn word_from_sentence() -> bool {
    match second_word("the quick fox") {
        Some(word) => {
            var sr = StaticRead::new();
            bytes_eq_within(&sr, word, "quick")
        },
        None => false,
    }
}

// The age's digits are put into a buffer of their own and read back as
// branded text, a `Str['open1]`: `{digits}` reads them through the capability
// `atag`, which `.write(&atag, out)` lends the f-string and puts back after.
fn birthday_greeting(age: u32) -> Buffer! {
    var exists 'open1. (atag, bytes, arestore) = Buffer!::new().put(age).open();
    let digits = bytes.as_str();
    let text = f"Happy birthday! You are {digits} years old.".write(&atag, Buffer!::new());
    arestore.restore(atag).destroy();
    text
}

fn birthday_greeting_matches_expected() -> bool {
    let greeting = birthday_greeting(30);
    var exists 'open1. (tag, bytes, restore) = greeting.open();
    let ok = bytes.as_str().is(&tag, "Happy birthday! You are 30 years old.");
    restore.restore(tag).destroy();
    ok
}
