// Storing a linear value through a raw pointer (`unsafe *p = expr;`)
// consumes the names moved inside `expr`, as a call's arguments or a
// literal's fields are consumed. Here one pointer is stored through
// repeatedly, each store built from what the previous `unsafe *p` read gave
// back and wrapping a linear struct returned by a method whose body
// contains a `match`. None of the consumed values is still live at the
// branch that follows.

use std::cap::Exclusive!;
use std::alloc::arena::Arena!;
use std::alloc::heap::HeapAllocator;
use std::cap::Brand;
use std::mem::sizeof;

exposed enum Size {
    Big,
    Small,
}

forall 'k. exposed struct Inner! {
    n: usize,
    marker: Brand['k],
}

forall 'k. impl Inner!['k] {
    fn bump(self, tag: Exclusive!['k]) -> (Exclusive!['k], Inner!['k], usize) {
        let { n: n, marker: m } = self;
        let size = if n > 100usize {
            Size::Big
        } else {
            Size::Small
        };
        let step: usize = match size {
            Size::Big => 1usize,
            Size::Small => 2usize,
        };
        (tag, Inner!.{ n: n + step, marker: m }, n)
    }
}

forall 'k. exposed struct Outer! {
    inner: Inner!['k],
}

forall 'k. fn go(tag: Exclusive!['k], arena: Arena!['k]) -> (Exclusive!['k], Arena!['k], usize) {
    let u = HeapAllocator::alloc(sizeof[Outer!['k]]());
    let raw = u.into_raw();
    let p = unsafe (raw as *Outer!['k]);
    let m0 = &arena.marker();
    let init: Outer!['k] = Outer!.{ inner: Inner!.{ n: 0usize, marker: m0 } };
    unsafe *p = init;

    let boxed1 = unsafe *p;
    let { inner: inner1 } = boxed1;
    let (tag, inner2, r1) = inner1.bump(tag);
    unsafe *p = Outer!.{ inner: inner2 };

    let boxed2 = unsafe *p;
    let { inner: inner3 } = boxed2;
    let (tag, inner4, r2) = inner3.bump(tag);
    unsafe *p = Outer!.{ inner: inner4 };

    let sum: usize = if r2 > 0usize { r1 + r2 } else { r1 };
    (tag, arena, sum)
}

fn main() -> i32 {
    let exists 'open1. (tag, arena) = Arena!::new();
    let (tag, arena, sum) = go(tag, arena);
    arena.destroy(tag);
    (sum as i32)
}
