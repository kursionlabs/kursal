// A tiny key-value store kept in a file:
//
//   kvstore FILE set KEY VALUE    stores VALUE under KEY
//   kvstore FILE get KEY          prints KEY's value
//   kvstore FILE del KEY          removes KEY
//   kvstore FILE list             prints every entry, sorted by key
//
// The file holds one `KEY<TAB>VALUE` line per entry and is rewritten,
// sorted, after every change. A missing file is an empty store. Exits 1
// when a key is not found, 2 on bad usage and 3 when the file cannot be
// written.
//
// One domain: the file's text is opened once and every key and value is a
// `Copy` slice of it. `set` appends its line to the text before opening it,
// and a later line for a key wins over an earlier one, so the new entry
// needs no separate storage either.
use std::io::{File!, print, stdout, eprint};
use std::process::Args;
use std::buffer::Buffer!;
use std::fmt::Writer;
use std::cap::Exclusive!;
use std::slice::{bytes_eq, bytes_eq_within, bytes_cmp_within, find_byte};
use std::str::{Str, StaticRead};
use std::ascii::line_at;
use std::collections::vec::OwnedVec!;
use std::cmp::Order;
use std::option::{Option, Result};

forall 't.
tuple Entry(Str['t], Str['t]);

// The text before and after a line's first tab, if it has one.
forall 't.
fn split_at_tab(&tag: Exclusive!['t], line: Str['t]) -> Option[Entry['t]] {
    let at = find_byte(&tag, line, b'\t', 0)?;
    let key = line.sub(0, at)?;
    let value = line.sub(at + 1, line.len() - at - 1)?;
    Option::Some.(Entry.(key, value))
}

// Every `KEY<TAB>VALUE` line of `text`, in file order. Lines without a tab
// are skipped.
forall 't.
fn entries(&tag: Exclusive!['t], text: Str['t]) -> OwnedVec![Entry['t]] {
    var found = OwnedVec!::new[Entry['t]]();
    var start = 0usize;
    var reading = true;
    while reading {
        let unit = match line_at(&tag, text, start) {
            None => {
                reading = false;
            },
            Some(next) => {
                let (line, after) = next;
                start = after;
                let unit = match split_at_tab(&tag, line) {
                    Some(entry) => {
                        &found.push(entry);
                    },
                    None => (),
                };
            },
        };
    }
    found
}

// The order of two entries: by key, read under the capability.
forall 't.
fn key_order(&tag: Exclusive!['t], a: Entry['t], b: Entry['t]) -> Order {
    bytes_cmp_within(&tag, a.0, b.0)
}

// The store's entries in key order, one per key: the sort is stable, so
// the last entry of each run of equal keys is the one written last.
forall 't.
fn latest(&tag: Exclusive!['t], text: Str['t]) -> OwnedVec![Entry['t]] {
    var sorted = entries(&tag, text);
    &sorted.sort_by(&tag, |&tag, a, b| key_order(&tag, a, b));
    var kept = OwnedVec!::new[Entry['t]]();
    let n = &sorted.len();
    var i = 0usize;
    while i < n {
        let entry = &sorted.get(i).unwrap_or(Entry.(text, text));
        let superseded = if i + 1usize < n {
            bytes_eq_within(&tag, entry.0, &sorted.get(i + 1usize).unwrap_or(entry).0)
        } else {
            false
        };
        if !superseded {
            &kept.push(entry);
        }
        i = i + 1usize;
    }
    sorted.destroy();
    kept
}

// `entries` as file text, leaving out the entry for `skip` if any.
forall 't.
fn render(&tag: Exclusive!['t], entries: OwnedVec![Entry['t]], skip: Option[Str['static]]) -> Buffer! {
    var entries = entries;
    var sr = StaticRead::new();
    var out = Buffer!::new();
    let n = &entries.len();
    var i = 0usize;
    while i < n {
        let entry = match &entries.get(i) {
            Some(e) => e,
            None => {
                entries.destroy();
                return out;
            },
        };
        let skipped = match skip {
            Some(key) => bytes_eq(&tag, entry.0, &sr, key),
            None => false,
        };
        if !skipped {
            out = out.write(&tag, entry.0).write_byte(b'\t').write(&tag, entry.1).write_byte(b'\n');
        }
        i = i + 1usize;
    }
    entries.destroy();
    out
}

// The file's text, or nothing for a missing file.
fn load(path: Str['static]) -> Buffer! {
    var read = StaticRead::new();
    match File!::open_read(&read, path) {
        Err(code) => Buffer!::new(),
        Ok(file) => match file.input().read_to_end() {
            Err(code) => Buffer!::new(),
            Ok(text) => text,
        },
    }
}

fn save(path: Str['static], text: Buffer!) -> i32 {
    var read = StaticRead::new();
    match File!::create(&read, path) {
        Err(code) => {
            text.destroy();
            3
        },
        Ok(file) => match file.output().put(text).finish() {
            Ok(nothing) => 0,
            Err(code) => 3,
        },
    }
}

// Rewrites the store from `text`, leaving out `skip`; exits 1 when `skip`
// is given but was not stored.
fn rewrite(path: Str['static], text: Buffer!, skip: Option[Str['static]]) -> i32 {
    var exists 't. (tag, bytes, text) = text.open();
    var sr = StaticRead::new();
    var kept = latest(&tag, bytes.as_str());
    let n = &kept.len();
    var found = false;
    var i = 0usize;
    while i < n {
        let entry = &kept.get(i).unwrap_or(Entry.(bytes.as_str(), bytes.as_str()));
        let unit = match skip {
            Some(key) => {
                found = found || bytes_eq(&tag, entry.0, &sr, key);
            },
            None => (),
        };
        i = i + 1usize;
    }
    let out = render(&tag, kept, skip);
    text.restore(tag).destroy();
    let saved = save(path, out);
    let missing = match skip {
        Some(_) => !found,
        None => false,
    };
    if missing { 1 } else { saved }
}

fn list(path: Str['static]) -> i32 {
    var exists 't. (tag, bytes, text) = load(path).open();
    let out = render(&tag, latest(&tag, bytes.as_str()), Option::None);
    text.restore(tag).destroy();
    print(out);
    0
}

// Prints `key`'s value, or exits 1 when it is absent.
fn get(path: Str['static], key: Str['static]) -> i32 {
    var exists 't. (tag, bytes, text) = load(path).open();
    var sr = StaticRead::new();
    var all = entries(&tag, bytes.as_str());
    let n = &all.len();
    var value = Option::None;
    var i = 0usize;
    while i < n {
        let entry = &all.get(i).unwrap_or(Entry.(bytes.as_str(), bytes.as_str()));
        if bytes_eq(&tag, entry.0, &sr, key) {
            value = Option::Some.(entry.1);
        }
        i = i + 1usize;
    }
    all.destroy();
    let status = match value {
        Some(v) => {
            stdout().write(&tag, v).finish();
            print("\n");
            0
        },
        None => 1,
    };
    text.restore(tag).destroy();
    status
}

fn arg(args: Args, i: usize) -> Str['static] {
    match args.bytes(i) {
        Some(b) => b,
        None => "",
    }
}

fn is(a: Str['static], b: Str['static]) -> bool {
    var sr = StaticRead::new();
    bytes_eq_within(&sr, a, b)
}

fn usage() -> i32 {
    eprint("usage: kvstore FILE (set KEY VALUE | get KEY | del KEY | list)\n");
    2
}

fn main(args: Args) -> i32 {
    let path = match args.bytes(1) {
        Some(p) => p,
        None => {
            return usage();
        },
    };
    let command = arg(args, 2);
    let n = args.len();
    if is(command, "list") && n == 3 {
        return list(path);
    }
    if is(command, "get") && n == 4 {
        return get(path, arg(args, 3));
    }
    if is(command, "del") && n == 4 {
        return rewrite(path, load(path), Option::Some.(arg(args, 3)));
    }
    if is(command, "set") && n == 5 {
        let line = load(path).put(arg(args, 3)).write_byte(b'\t').put(arg(args, 4)).write_byte(b'\n');
        return rewrite(path, line, Option::None);
    }
    usage()
}
