// A custom type's `{expr}` interpolation is backed by an ordinary trait,
// `Format[T, W]` (std::text::fmt). Every part of an f-string threads one
// writer straight through, so a type's `format` can use
// `f"...".write(out)` to build its piece directly into the caller's
// writer (see `Point` and `Color`). `announce` is generic over any
// formattable `T`, resolved statically per instantiation, and here it
// writes straight to stdout.

use std::slice::Slice;
use std::text::fmt::{Writable, Format};
use std::io::{Error, stdout};
use std::option::Result;

exposed struct Point {
    x: u32,
    y: u32,
}

exposed struct Color {
    r: u8,
    g: u8,
    b: u8,
}

// Written once, generically over the writer, so a `Point` formats into
// any `Writable` destination.
forall W where Writable[W].
instance Format[Point, W] {
    fn format(p: Point, out: W) -> (Point, W) {
        let { x, y } = p;
        (p, f"({x}, {y})".write(out))
    }
}

forall W where Writable[W].
instance Format[Color, W] {
    fn format(c: Color, out: W) -> (Color, W) {
        let { r, g, b } = c;
        (c, f"rgb({r}, {g}, {b})".write(out))
    }
}

// `T` is still abstract when this body is checked, so `{x}` dispatches
// through the `Format[T, W]` bound. `Copy[T]` lets the formatted value be
// dropped; a linear `T` would need `{&x}`.
forall T, W where Format[T, W], Writable[W], Copy[T].
fn announce(label: Slice[u8, 'static], x: T, out: W) -> W {
    f"{label}: {x}\n".write(out)
}

fn main() -> Result[(), Error] {
    let out = announce("point", Point.{ x: 3, y: 4 }, stdout());
    let out = announce("color", Color.{ r: 255, g: 128, b: 0 }, out);
    out.finish()
}
