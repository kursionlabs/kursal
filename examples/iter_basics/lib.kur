// `Iterator`, `Range` and `fold` (std::iter) end to end: sums 0..10
// (0+1+...+9 == 45) with `range` and a closure accumulator. `fold`'s `f`
// is `closure[Env](Acc, Item) -> Acc`; a closure that captures nothing is
// an ordinary value of that type (`iter_combinators` has one that does).
// The closure's parameter types come from `fold`'s bound
// `Iterator[Self -> Item]`: a `Range` yields `usize`.

use std::iter::{range, fold};

fn main() -> i32 {
    let (_, total) = fold(range(0, 10), 0usize, |acc, x| acc + x);
    if total == 45 { 0 } else { 1 }
}
