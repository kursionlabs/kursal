// `tuple Name(T, T);` is a sibling of `struct` and `enum` that names a
// fixed-arity tuple shape: the same modifiers (`forall`, `exposed`, `!` for
// linear), with positional element types instead of named fields. It has
// the same representation as an anonymous `(T1, T2)`; what it adds is a
// name. A bare tuple cannot be an `instance` target, but a declared one can.

forall T.
tuple Pair(T, T);

// Construction uses a dot (`Pair.(1, 2)`), and `.0`/`.1` read the
// elements back, as on an anonymous tuple.
fn sum_pair(p: Pair[u32]) -> u32 {
    p.0 + p.1
}

// Elements of different types.
forall A, B.
tuple Labeled(A, B);

// A trait implemented for one instantiation of `Labeled`, which a bare
// `(i32, bool)` could never be the target of.
forall Self.
trait First {
    fn first(self: Self) -> i32;
}

instance First[Labeled[i32, bool]] {
    fn first(self: Labeled[i32, bool]) -> i32 {
        self.0
    }
}

// Two tuple declarations with identical element types are still different
// types, like two structs with identical fields: `Pair[u32]` and
// `Labeled[u32, u32]` share the `(u32, u32)` shape but are not
// interchangeable with each other or with a bare `(u32, u32)`.
fn widen_pair_to_labeled(p: Pair[u32]) -> Labeled[u32, u32] {
    Labeled.(p.0, p.1)
}

fn main() -> i32 {
    let total = sum_pair(Pair.(7, 8));
    let first = First[Labeled[i32, bool]]::first(Labeled.(42i32, true));
    let widened = widen_pair_to_labeled(Pair.(3, 4));
    if total == 15 && first == 42 && widened.0 + widened.1 == 7 {
        0
    } else {
        1
    }
}
