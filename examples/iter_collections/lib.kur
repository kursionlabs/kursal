// Iterating collections and collecting into them.
//
// A branded collection is read under its domain's capability, so its
// iterator holds that capability while it runs, and `finish` hands it back.
// An `OwnedVec!` carries its own capability, and every iterator can be
// collected into one with `collect_vec`, or into a `Buffer!` of bytes with
// `collect_bytes`. Consumers like `count` and `find` return the iterator
// with their answer; a `Copy` iterator is dropped with `_`.
use std::iter::{Iterator, range};
use std::collections::list::List;
use std::collections::vec::OwnedVec;
use std::alloc::arena::Arena;
use std::option::Result;
use std::io::stdout;

fn main() -> i32 {
    var out = stdout();

    // A list in an arena: its iterator borrows the arena's capability.
    let exists 'a. (tag, arena) = Arena::new();
    let primes = List::Empty.cons(&tag, &arena, 7u32).cons(&tag, &arena, 5u32).cons(&tag, &arena, 3u32).cons(&tag, &arena, 2u32);
    var it = primes.iter(tag);
    var product = 1u32;
    for p in &it {
        product = product * p;
    }
    let tag = it.finish();
    out = f"product of the primes: {product}\n".write(out);
    let (it, n) = primes.iter(tag).count();
    let tag = it.finish();
    arena.destroy(tag);
    out = f"{n} primes\n".write(out);

    // Collected into a vector, then iterated again: indexes from
    // `enumerate`, pairs from `zip`, and the vector handed back by `finish`.
    let (_, cubes) = range(1, 6).map(|x| x * x * x).collect_vec();
    var it = cubes.iter().enumerate();
    for p in &it {
        out = f"{p.a}: {p.b}\n".write(out);
    }
    let { inner, index: _index } = it;
    let cubes = inner.finish();
    let (it, big) = cubes.iter().zip(range(0, 10)).find(|p| p.a > 20);
    let { a: inner, b: _counter } = it;
    let cubes = inner.finish();
    let first_big = big.map(|p| p.a).unwrap_or(0);
    out = f"first cube over 20: {first_big}\n".write(out);
    cubes.free();

    // Adapters chain before anything runs: the letters up to 'e', then 'x'.
    let (_, word) = range(97, 123).take_while(|c| c < 102).chain(range(120, 121)).map(|c| (c as u8)).collect_bytes();
    var word = word;
    out = f"{&word}\n".write(out);
    word.destroy();
    let (_, has_49) = range(0, 9).any(|x| x * x == 49);
    out = f"a square is 49: {has_49}\n".write(out);

    match out.finish() {
        Result::Ok(nothing) => 0,
        Result::Err(code) => 1,
    }
}
