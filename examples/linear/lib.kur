// Linear types (`struct Handle! { ... }`) and the control flow that works
// with them: a `while` loop that consumes and replaces the linear value on
// every iteration, so the back edge always carries a fresh one, and an
// `if`/`else` whose arms each consume it. The `bad` examples show the
// shapes that are rejected.

exposed struct Handle! {
    id: u64,
}

fn make_handle(id: u64) -> Handle! {
    Handle.{ id }
}

fn consume_handle(h: Handle!) -> u64 {
    let { id } = h;
    id
}

fn round_trip(id: u64) -> u64 {
    consume_handle(make_handle(id))
}

fn loop_replacing_each_iteration(n: u64) -> u64 {
    var h = make_handle(0);
    var i = 0u64;
    while i < n {
        let old = consume_handle(h);
        h = make_handle(old + 1);
        i = i + 1;
    }
    consume_handle(h)
}

fn both_branches_consume(id: u64, take_first: bool) -> u64 {
    let h = make_handle(id);
    if take_first {
        consume_handle(h)
    } else {
        consume_handle(h)
    }
}

// A linear wrapper around a generic pointer, unrelated to the non-linear
// `Box[T]` in `generics`.
forall T. exposed struct Box! {
    ptr: *T,
}

fn wrap_box(p: *u32) -> Box![u32] {
    Box.{ ptr: p }
}

fn unwrap_box(b: Box![u32]) -> *u32 {
    let { ptr } = b;
    ptr
}
