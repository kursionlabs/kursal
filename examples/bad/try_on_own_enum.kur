// Rejected: `?` takes apart only `core::option`'s `Option` and `Result`.
// An enum of one's own with the same variants is another type: "? needs
// the operand and the function result to be the same Option or Result of
// core::option".
enum Maybe {
    Some(u32),
    None,
}

fn half(n: u32) -> Maybe {
    if n % 2 == 0 { Maybe::Some.(n / 2) } else { Maybe::None }
}

fn quarter(n: u32) -> Maybe {
    let h = half(n)?;
    half(h)
}

fn main() -> i32 {
    match quarter(8) {
        Some(q) => 0,
        None => 1,
    }
}
