// Rejected: consumes the linear `Handle!` inside a `while` body without
// giving `h` a fresh value before the iteration ends. The loop may run
// again, and the back edge would then carry an already-consumed handle:
// "linear value 'h' remains live on some paths to while". Compare
// `loop_replacing_each_iteration` in the `linear` example, which reassigns
// `h` before the loop repeats.

struct Handle! {
    id: u64,
}

fn make_handle(id: u64) -> Handle! {
    Handle!.{ id: id }
}

fn consume_handle(h: Handle!) -> u64 {
    let { id } = h;
    id
}

fn loop_leak(id: u64) -> u64 {
    let h = make_handle(id);
    var i = 0u64;
    while i < 3u64 {
        let x = consume_handle(h);
        i = i + 1u64;
    }
    0u64
}
