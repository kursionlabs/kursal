// Rejected: a pointer to a sum is opaque. It is copied, passed and read
// whole (`unsafe *p`, then a match), but no foreach traverses it, as its
// components would be those of the variant held there: "a foreach source
// cannot be a pointer to a sum". Through a pointer to a struct, a tuple or
// an array a foreach computes the components' addresses.
use std::option::Option;

fn widths(p: *Option[u8]) -> i32 {
    let parts = foreach x of p { 0u8 };
    0
}

fn main() -> i32 {
    0
}
