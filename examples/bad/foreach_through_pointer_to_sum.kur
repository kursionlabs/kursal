// exist yet: "a foreach cannot traverse a sum through a pointer yet". The
// type `foreach *F of *Option[u8] => F` itself is fine: the sum of the
// payload types.
use std::option::Option;

fn widths(p: *Option[u8]) -> i32 {
    let parts = foreach x of p { 0u8 };
    0
}

fn main() -> i32 {
    0
}
