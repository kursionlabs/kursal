// Rejected: a foreach through a pointer to a sum has to read which variant
// the value holds through that pointer, and a raw pointer may not point at
// a valid value (`null` is safe to make): "a foreach through a pointer to a
// sum reads its variant there and requires unsafe authorization". Through a
// pointer to a struct it only computes field addresses, and needs no
// `unsafe`.
use std::option::Option;

fn widths(p: *Option[u8]) -> i32 {
    let parts = foreach x of p { 0u8 };
    0
}

fn main() -> i32 {
