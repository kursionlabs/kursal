// Rejected: no foreach traverses a pointer to a sum, as its components
// would be those of the variant held there, which only a read finds: "a
// foreach source cannot be a pointer to a sum". The type is fine:
// `foreach *F of *Option[u8] => F` has a row for each payload, `enum {
// None(()), Some(u8) }`, but no traversal makes a value of it. A pointer to
// a sum is copied, passed and read whole (`unsafe *p`, then a match);
// through a pointer to a struct, a tuple or an array a foreach computes the
// components' addresses.
use std::option::Option;

fn widths(p: *Option[u8]) -> i32 {
    let parts = foreach x of p { 0u8 };
    0
}

fn main() -> i32 {
    0
}
