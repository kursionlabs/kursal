// Rejected: the writer comes back while a reader is still running. One leaf
// of a split is in a thread, and the other is handed to `resume` as if it
// were the root. A leaf's lineage is minted fresh by `split`, so it never
// unifies with the root's: "brand mismatch: Shared!['r, 'b] and
// Shared!['r, 'q]".

use std::cap::{Exclusive!, Shared!};
use std::option::Result;
use std::process::trap;
use std::thread;
use std::thread::Thread!;

forall 'r, 'a.
fn reader(leaf: Shared!['r, 'a]) -> Thread![Shared!['r, 'a]] {
    match thread::spawn(|| -> Shared!['r, 'a] { leaf }) {
        Ok(t) => t,
        Err(failed) => trap(),
    }
}

forall 'r.
fn early(tag: Exclusive!['r]) -> Exclusive!['r] {
    let exists 'q. (root, resume) = tag.share();
    let exists 'a, 'b. (left, right, receipt) = root.split();
    let running = reader(left);
    let writer = resume.resume(right);
    let left = running.join();
    writer
}

fn main() {}
