// Rejected: a name reached through a module that only imports it. `std::fs`
// has `use std::io::File!;` for its own code, and a `use` is private to the
// module that writes it; only an `export` makes a name a member of the
// module for other code. `File!` is `std::io::File!`: "unknown or private
// member File! of fs".

use std::fs::File!;
use std::option::Result;
use std::slice::{Slice, StaticRead};

fn opens(path: Slice[u8, 'static]) -> bool {
    var sr = StaticRead::new();
    match File!::open_read(&sr, path) {
        Result::Ok(file) => file.close().is_ok(),
        Result::Err(e) => false,
    }
}
