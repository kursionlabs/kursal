// Rejected: text is read-only. A literal is a `Str['static]`, whose bytes
// the C backend keeps in read-only memory, and a `Str` hands out no `Ref`,
// nor any other way to write its bytes: "Str['static] has no method
// get_ref". Writable bytes are a `Slice[u8, 'k]`, such as an open
// `Buffer!`'s.

fn main() -> i32 {
    let text = "hello";
    match text.get_ref(0usize) {
        Some(first) => 1,
        None => 0,
    }
}
