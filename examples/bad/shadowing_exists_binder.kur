// Rejected: an exists type whose binder is spelled as a brand in scope.
// In `wrap`, 'k is the caller's brand, so `exists 'k. Brand['k]` would
// hide a different brand under the same name, and `Brand['k]` inside it
// would not mean what it means a word earlier. A package's binder is
// named apart from every brand in scope: `exists 'p. Brand['p]`.

use std::cap::Brand;

forall 'k. fn wrap(w: Brand['k]) -> exists 'k. Brand['k] {
    pack 'k. w
}

fn main() -> u32 {
    0u32
}
