// Rejected: consumes the same linear `Handle!` twice. The first call to
// `consume_handle` moves `h`, so the second use fails with "value 'h' has
// been moved".

struct Handle! {
    id: u64,
}

fn make_handle(id: u64) -> Handle! {
    Handle!.{ id: id }
}

fn consume_handle(h: Handle!) -> u64 {
    let { id } = h;
    id
}

fn double_use(id: u64) -> u64 {
    let h = make_handle(id);
    let a = consume_handle(h);
    let b = consume_handle(h);
    a
}
