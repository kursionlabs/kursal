// Rejected: a bare label names a variant of the scrutinee's sum, and
// `Option` has `Some` and `None`, not `Nothing`: "Option[u8] has no variant
// Nothing". A misspelled label is never read as a name to bind.
use std::option::Option;

fn get(o: Option[u8]) -> u8 {
    match o {
        Some(x) => x,
        Nothing => 0,
    }
}

fn main() -> i32 {
    0
}
