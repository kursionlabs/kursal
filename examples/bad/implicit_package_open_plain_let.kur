// Rejected: binds the result of a call whose return type is directly
// existential to a plain name. `let t = new_tag();` binds `t` to the
// unopened package, not to a `Tag!`, so destructuring it fails: "a struct
// pattern needs a struct, not (exists ...)". The package and its opened
// payload are different types with different brands in scope, and the
// compiler never picks between them silently. To use the payload, open
// the package: `let exists 'a. t = new_tag();`.

use std::cap::{Brand, fresh};

forall 'k.
struct Tag! {
    marker: Brand['k],
}

fn new_tag() -> exists '1. Tag!['1] {
    let exists '1. k: Brand['1] = fresh();
    pack '1. Tag.{ marker: k }
}

fn main() -> u32 {
    let t = new_tag();
    let { marker: m } = t;
    0u32
}
