// Rejected: no safe function closes a bare descriptor. A `File!` owns its
// descriptor, and closing whatever the process holds at number 3 would
// break that ownership for a `File!` elsewhere. `std::io` has no
// `close_fd`: only `File::close` closes, and a `File!` comes only from
// opening a file or from the unsafe `File::adopt`.

use std::io::close_fd;

fn close_three() {
    close_fd(3i32);
}
