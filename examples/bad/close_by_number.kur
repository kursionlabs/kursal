// Rejected: no safe function closes a bare descriptor. A `File!` owns its
// descriptor, and closing whatever the process holds at number 3 would
// break that ownership for a `File!` elsewhere. `std::io` has no safe
// function that takes a descriptor number to read or close; a `File!` comes
// only from opening a file or from `File::adopt`, an `unsafe fn` whose
// caller vouches that the descriptor has no other owner: "calling an unsafe
// function requires unsafe authorization".

use std::io::File;

fn close_three() {
    let closed = File::adopt(3i32).close();
}
