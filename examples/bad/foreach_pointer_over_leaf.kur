// Rejected: `*F` matches only pointer components, and the `u32` of
// `(*u8, u32)` is none, so `foreach *F of (*u8, u32) => F` is not a type:
// "foreach *F needs a source written with pointer components". The type is
// rejected where it is written, before the body is checked: `note` is never
// consumed here either, but the error is about the type the parameter is
// written with, not about what the body does with it.

struct Note! {
    text: u32,
}

fn split(parts: foreach *F of (*u8, u32) => F, note: Note!) -> u32 {
    0u32
}

fn main() -> i32 {
    0
}
