// Rejected: everything stored in an arena is `Copy`. An arena frees its
// chunks without reading them, so a linear value stored there would never
// reach its consumer; `Arena!::alloc` requires `Copy[T]`, and a `Buffer!`
// is not: "type argument must satisfy Copy".

use std::arena::Arena!;
use std::buffer::Buffer!;

fn lose_a_buffer() {
    var exists 'k. (tag, arena) = Arena!::new(std::process::hash_seed());
    let r = &arena.alloc(&tag, Buffer!::new());
    arena.destroy(tag);
}
