// Rejected: `f"...".write(&cx, out)` moves the capability out of `cx` for
// as long as the f-string is written, and every `{span}` reads through it
// there, so no part of the f-string can use `cx` itself: "cx is lent to this
// f-string; it cannot be used inside it". A value that needs `cx` is
// computed before the f-string.

use std::arena::Domain!;
use std::buffer::Buffer!;
use std::process::hash_seed;
use std::raw::Span;

forall 'k.
fn label(&cx: Domain!['k], name: Span['k]) -> Buffer! {
    f"{name} ({Span::from_static(&cx, "unnamed")})".write(&cx, Buffer!::new())
}

fn main() -> i32 {
    var exists 'k. cx = Domain!::new(hash_seed());
    let name = Span::from_static(&cx, "x");
    let text = label(&cx, name);
    text.destroy();
    cx.destroy();
    0
}
