// Rejected: `Allocation!::adopt` is an `unsafe fn`. Its region reads and
// writes the block as a `T`, so the caller vouches that the block holds an
// initialized `T` in at least `sizeof[T]()` bytes; here it holds one
// uninitialized byte, and `replace` would read eight. A call without an
// `unsafe` marker is an error: "calling an unsafe function requires unsafe
// authorization". `Allocation!::adopt_value` is the checked form.

use std::heap::HeapAllocator;
use std::owned::Allocation!;

fn read_past_the_block() -> u64 {
    var exists 'r. (record, region) = Allocation!::adopt[u64](HeapAllocator::alloc(1usize));
    let old = &region.replace(0u64);
    HeapAllocator::drop(record.release(region));
    old
}
