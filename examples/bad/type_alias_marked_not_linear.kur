// Rejected: an alias's name ends with `!` exactly when the type it stands
// for is linear. A struct may carry a `!` to make itself linear, but an
// alias has no representation of its own to make anything: `Count!` would
// read as linear while it is a `u32`, "type alias Count! stands for a type
// that is not linear; name it Count".

type Count! = u32;

fn main() -> i32 {
    0
}
