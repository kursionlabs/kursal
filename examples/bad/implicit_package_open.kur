// Rejected: destructures the result of a call whose return type is
// directly existential. `new_pair()` returns an unopened package
// `exists '1. (Tag!['1], u32)`, and the tuple pattern `(tag, n)` does not
// match an `(exists ...)` type: a package is never opened implicitly. The
// fix is to open it explicitly: `let exists 'a. (tag, n) = new_pair();`.
//
// Everything else here is well-formed: the mint, the packed return, the
// tuple and the struct destructure.

use std::cap::{Brand, fresh};

forall 'k.
struct Tag! {
    marker: Brand['k],
}

fn new_pair() -> exists '1. (Tag!['1], u32) {
    let exists '1. k: Brand['1] = fresh();
    pack '1. (Tag.{ marker: k }, 7u32)
}

fn main() -> u32 {
    let (tag, n) = new_pair();
    let { marker: m } = tag;
    n
}
