// Rejected: a vector is freed while a thread still reads it. Its
// `Exclusive!` was traded for the shared root that went into the thread,
// and only that `Exclusive!` frees it: "value 'tag' has been moved or is
// only partially available".

use std::collections::vec::Vec!;
use std::cap::{Exclusive!, Shared!, SharedResume!};
use std::slice::{Slice, byte_or_zero};
use std::option::Result;
use std::process::trap;
use std::thread;
use std::thread::Thread!;

forall 'r, 'a.
fn reader(leaf: Shared!['r, 'a], bytes: Slice[u8, 'r]) -> Thread![(Shared!['r, 'a], u8)] {
    match thread::spawn(|| -> (Shared!['r, 'a], u8) {
        var leaf = leaf;
        let first = byte_or_zero(&leaf, bytes, 0usize);
        (leaf, first)
    }) {
        Ok(t) => t,
        Err(failed) => trap(),
    }
}

forall 'r.
fn start(tag: Exclusive!['r], v: Vec![u8, 'r]) -> exists 'q. (Thread![(Shared!['r, 'q], u8)], SharedResume!['r, 'q]) {
    var tag = tag;
    var v = v;
    let bytes = &v.as_slice(&tag);
    let exists 'q. (root, resume) = tag.share();
    let running = reader(root, bytes);
    v.destroy(tag);
    pack 'q. (running, resume)
}

fn main() {}
