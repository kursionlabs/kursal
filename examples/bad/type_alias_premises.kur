// Rejected: a type alias stands for its body wherever it is written, and
// nothing checks a premise there, so its `forall` lists parameters only:
// "type alias Twice takes no premises or determined parameters". The
// declarations that use `Twice[T]` state what they need of `T` themselves.

forall T where Copy[T].
type Twice = (T, T);

fn main() -> i32 {
    0
}
