// Rejected: opens a second package under a brand name already in scope.
// The two `fresh()` packages hide different brands; were the second
// opening to rebind 'a, `Brand['a]` would name one brand before it and
// another after, and an error about them could not say which. Each
// opening names a brand of its own: `let exists 'b. second = fresh();`.

use std::cap::{Brand, fresh};

forall 'k. fn same(a: Brand['k], b: Brand['k]) -> u32 {
    0u32
}

fn main() -> u32 {
    let exists 'a. first = fresh();
    let exists 'a. second = fresh();
    same(first, second)
}
