// Rejected: `_` stands for a type argument in an annotation. Inference fills
// in a `_` only in an expression (`Option[_]::None`); an annotation states a
// type in full: "_ stands for a type argument only in an expression, where
// inference fills it in". Write `let x: Option[u32] = ...`.

use std::option::Option;

fn main() -> u32 {
    let x: Option[_] = Option::Some.(1u32);
    match x {
        Some(n) => n,
        None => 0u32,
    }
}
