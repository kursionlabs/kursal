// Rejected: a linear type's name ends with `!`, and an alias of one is a
// name of it, so its name ends with `!` too: "type alias Handles stands for
// a linear type; name it Handles!". Without its `!`, a reader of
// `fn keep(h: Handles)` could not tell that `h` must be used exactly once.

struct Handle! {
    fd: i32,
}

type Handles = (Handle!, Handle!);

fn keep(h: Handles) -> Handles {
    h
}

fn main() -> i32 {
    0
}
