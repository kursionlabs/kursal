// Rejected: the declared return type promises the caller's brand 'k, but
// the returned value carries a brand '2 minted locally. A brand is part of
// its type, so `Ref[u32, 'k]` and `Ref[u32, '2]` are unrelated types and
// this is a brand mismatch. Nothing coerces one brand into another.

use std::cap::{Brand, fresh};

forall T, 'k.
struct Ref {
    ptr: *T,
    marker: Brand['k],
}

forall 'k.
fn wrong_brand(p: *u32) -> Ref[u32, 'k] {
    let exists '2. k2: Brand['2] = fresh();
    let r = Ref.{ ptr: p, marker: k2 };
    r
}
