// Rejected: a type alias stands for its body, so a parameter its body never
// mentions would make `Tagged[u32, u8]` and `Tagged[u32, bool]` one type
// under two names. Every parameter of an alias is used in its body: "type
// alias Tagged does not use its parameter Tag".

forall T, Tag.
type Tagged = (T, T);

fn first(p: Tagged[u32, u8]) -> u32 {
    p.0
}

fn main() -> i32 {
    first((1u32, 2u32)) as i32
}
