// Rejected: a capability moved into a thread is used by the thread that
// spawned it. The closure captures `tag` by moving it in, so it is no
// longer this function's: "value 'tag' has been moved and cannot be lent".

use std::cap::Exclusive!;
use std::option::Result;
use std::slice::{Slice, byte_or_zero};
use std::process::trap;
use std::thread;

forall 'r.
fn race(tag: Exclusive!['r], bytes: Slice[u8, 'r]) -> Exclusive!['r] {
    var tag = tag;
    let running = match thread::spawn(|| -> Exclusive!['r] { tag }) {
        Ok(t) => t,
        Err(failed) => trap(),
    };
    let first = byte_or_zero(&tag, bytes, 0usize);
    match running.join() { Ok(tag) => tag, Err(e) => trap() }
}

fn main() {}
