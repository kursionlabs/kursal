// Rejected: no safe function writes to a bare descriptor number. A `File!`
// owns its descriptor, and writing to whatever the process holds at number
// 3 would go around that `File!`, or reach a file opened after it closed
// and the number was reused. Safe output goes through an `Output!`: of
// standard output or error (`print`, `eprint`, `stdout()`, `stderr()`), or
// of a `File!` it owns (`File!::output`). The functions that take a number,
// such as `write_all`, are `unsafe fn`s whose caller vouches that it may
// write the descriptor: "calling an unsafe function needs unsafe".

use std::io::write_all;

fn write_three(bytes: *u8, len: usize) {
    let written = write_all(3i32, bytes, len);
}
