// Rejected: no safe function writes to a bare descriptor number. A `File!`
// owns its descriptor, and writing to whatever the process holds at number
// 3 would go around that `File!`, or reach a file opened after it closed
// and the number was reused. Safe output goes to standard output or error
// (`print`, `eprint`, `stdout()`, `stderr()`) or through a `File!`. The
// functions that take a number, such as `write_static_to`, are `unsafe fn`s
// whose caller vouches that it may write the descriptor: "calling an unsafe
// function requires unsafe authorization".

use std::io::write_static_to;

fn write_three() {
    let written = write_static_to(3i32, "not mine to write");
}
