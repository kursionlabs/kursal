// Rejected: an extern names a calling convention other than C's. An extern
// function is called with the C calling convention, the only one the
// compiler emits, so `"system"`, `"stdcall"` or any other string would promise
// a convention the call does not follow: "the only extern ABI is \"C\"".
// Write `extern "C" fn abs(x: i32) -> i32;`.

extern "system" fn abs(x: i32) -> i32;

fn main() -> u32 {
    let n = unsafe abs(-3i32);
    n as u32
}
