// Rejected: a type alias is replaced by its body wherever it is written, so
// one that refers to itself, here through another alias, would never finish
// expanding, even behind a pointer, which a struct needs to hold itself: "type
// alias List refers to itself through Next". A recursive type is a struct
// or an enum, which has a name of its own.

type List = (u32, Next);
type Next = *List;

fn main() -> i32 {
    0
}
