// Rejected: a `match` that forgets a variant. Every `match` on an enum must
// cover each of its variants, with an arm of its own or a `_` arm, so adding
// a variant to an enum finds every `match` that has to handle it: "a match
// must cover every enum variant; it misses Amber".

exposed enum Light {
    Red,
    Amber,
    Green,
}

// The seconds to wait at `light`.
fn wait(light: Light) -> u32 {
    match light {
        Red => 30u32,
        Green => 0u32,
    }
}
