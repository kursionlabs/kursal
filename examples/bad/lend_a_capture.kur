// Rejected: a closure holds its own value of each name it captures, a copy
// or the value moved in, so changing it would change only the closure's.
// A closure neither assigns nor lends what it captures, a `var` included:
// "a is captured, and a body cannot lend what it captures; lend it outside,
// or give a closure a place parameter for it".

exposed struct Counter {
    n: u32,
}

impl Counter {
    fn tick(&self) -> u32 {
        self.n = self.n + 1;
        self.n
    }
}

fn main() -> i32 {
    var a = Counter.{ n: 0 };
    let next = || &a.tick();
    (next() as i32)
}
