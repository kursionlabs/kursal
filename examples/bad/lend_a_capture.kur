// Rejected: a closure holds a copy of each value it captures, so changing
// one would change only the copy. A closure neither assigns nor lends what
// it captures, a `var` included: "a is captured as a copy, which cannot be
// lent". Lend it outside, or pass it to the closure as a place parameter.

exposed struct Counter {
    n: u32,
}

impl Counter {
    fn tick(&self) -> u32 {
        self.n = self.n + 1;
        self.n
    }
}

fn main() -> i32 {
    var a = Counter.{ n: 0 };
    let next = || &a.tick();
    (next() as i32)
}
