// Rejected: a thread is spawned and never joined. A `Thread!` is linear and
// has no `detach`, so whatever the thread returns reaches a `join`: "linear
// value 'running' is not consumed before return".

use std::option::Result;
use std::process::trap;
use std::thread;

fn main() {
    let running = match thread::spawn(|| -> u32 { 1u32 }) {
        Ok(t) => t,
        Err(failed) => trap(),
    };
}
