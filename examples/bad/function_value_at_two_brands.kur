// Rejected: a function value quantifies nothing. Naming drop_tag as a
// value instantiates its brand 'k once, where it is named; the first call
// infers 'k = 'a, so the value's type is fn(Tag!['a]) -> u32 and the
// second call, at 'b, does not fit it. Name the function at each call, or
// take one value per brand, each once its brand is in scope.

use std::cap::{Brand, fresh};

forall 'k. exposed struct Tag! {
    marker: Brand['k],
}

forall 'k. fn drop_tag(t: Tag!['k]) -> u32 {
    let { marker } = t;
    0
}

fn drop_two() -> u32 {
    let exists 'a. ka = fresh();
    let exists 'b. kb = fresh();
    let drop_fn = drop_tag;
    drop_fn(Tag!.{ marker: ka }) + drop_fn(Tag!.{ marker: kb })
}
