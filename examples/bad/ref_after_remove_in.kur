// Rejected: `HashMap::remove_in` frees the entry it removes, so it hands
// the map back under a fresh brand, as `remove` does. A `Ref` that
// `get_in` returned before the removal names the old brand, and the only
// capability left is the new one, so reading through the stale `Ref` is a
// type mismatch rather than a read of freed memory.

use std::collections::hashmap::{HashMap, Found};

fn stale_read() -> u32 {
    let exists 'm. (tag, map) = HashMap::new[u32, u32]();
    var cx = ();
    let exists 'a. (tag, map, old) = map.insert_in(tag, &cx, 1u32, 10u32);
    let found = &map.get_in(&tag, &cx, 1u32);
    let exists 'b. (tag, map, removed) = map.remove_in(tag, &cx, 1u32);
    let value = match found {
        Found::Item(r) => r.copy(&tag),
        Found::Missing => 0u32,
    };
    map.destroy(tag, drop_entry);
    value
}

fn drop_entry(key: u32, value: u32) {}
