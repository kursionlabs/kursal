// Rejected: `Allocation!::release` gives up the `T` in the block, so it is
// safe only for a `Copy` `T`. Releasing an opened `Owned![Buffer!]` would
// free the cell and lose the buffer inside it, a linear value nothing
// consumed. The buffer comes back through `close` and `into_value`;
// `release_storage`, for storage whose contents the caller tracks itself,
// is an `unsafe fn`.

use std::alloc::heap::HeapAllocator;
use std::alloc::owned::Owned!;
use std::bytes::buffer::Buffer!;

fn lose_the_buffer() {
    let exists 'r. (record, region) = Owned!::new(Buffer!::new()).open();
    HeapAllocator::drop(record.release(region));
}
