// Rejected: a thread's closure captures a reader whose lineage brand this
// block opened. The closure is lowered to a function of its own, which can
// name only the brands its enclosing function takes as parameters, so a
// capability over a brand opened here goes to a thread through a function
// generic over that brand: "a closure or foreach body cannot mention the
// block-local brand 'q".

use std::cap::{Exclusive!, Shared!};
use std::option::Result;
use std::process::trap;
use std::thread;

forall 'r.
fn send(tag: Exclusive!['r]) -> Exclusive!['r] {
    let exists 'q. (root, resume) = tag.share();
    let running = match thread::spawn(|| -> Shared!['r, 'q] { root }) {
        Ok(t) => t,
        Err(failed) => trap(),
    };
    let root = running.join();
    resume.resume(root)
}

fn main() {}
