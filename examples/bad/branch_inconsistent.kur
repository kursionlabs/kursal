// Rejected: consumes the linear `Handle!` on only one path. When `cond`
// is false the `if` (which has no `else`) never touches `h`, so the
// handle is still live where the paths join: "linear value 'h' remains
// live on some paths to the end of the `if` at 22:5". Every path must
// consume a linear value exactly once.

struct Handle! {
    id: u64,
}

fn make_handle(id: u64) -> Handle! {
    Handle!.{ id: id }
}

fn consume_handle(h: Handle!) -> u64 {
    let { id } = h;
    id
}

fn conditionally_leaks(id: u64, cond: bool) -> u64 {
    let h = make_handle(id);
    if cond {
        let x = consume_handle(h);
    }
    0u64
}
