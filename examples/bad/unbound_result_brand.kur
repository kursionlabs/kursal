// Rejected: `make_tag`'s return type names the brand '1, which is not one
// of the function's `forall` parameters (it has none), not 'static, and
// not bound by an `exists`: "brand '1 is not in scope". A result brand
// must be declared. The fix is to return a package, `-> exists '1. Tag!['1]`,
// and seal the value with `pack '1. ...`.

use std::cap::{Brand, fresh};

forall 'k.
struct Tag! {
    marker: Brand['k],
}

fn make_tag() -> Tag!['1] {
    let exists '1. k: Brand['1] = fresh();
    Tag.{ marker: k }
}
