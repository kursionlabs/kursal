// Rejected: a list is persistent, so nothing may link cells onto one that
// has been handed out. `ListBuilder!::finish` hands the list out and
// consumes the builder, which is linear, so no copy of it is left to push
// onto the finished list (or to finish it again with the list itself as
// the tail, which would make it cyclic): "value 'builder' has been moved".

use std::alloc::arena::Domain!;
use std::collections::list::{List, ListBuilder!};

forall 'k.
fn push_after_finish(&cx: Domain!['k]) -> List[u32, 'k] {
    var builder: ListBuilder![u32, 'k] = ListBuilder!::new();
    &builder.push(&cx, 1u32);
    let list = builder.finish(&cx, List::empty());
    &builder.push(&cx, 2u32);
    list
}
