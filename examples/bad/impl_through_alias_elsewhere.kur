// Rejected: an impl written through a type alias is an impl of the type the
// alias stands for. `Bytes['k]` is `Slice[u8, 'k]`, whose package is `core`,
// and only the package that declares a type adds methods to it, so none can
// clash with the type's own: "an inherent impl of Slice belongs in the
// package that declares it". Another package writes a function, or a trait
// and its instance.

use std::slice::Slice;

forall 'k.
type Bytes = Slice[u8, 'k];

forall 'k.
impl Bytes['k] {
    fn twice(self) -> usize {
        self.len() + self.len()
    }
}

fn main() -> i32 {
    0
}
