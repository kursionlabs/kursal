// Rejected: a read through a raw pointer in an `unsafe fn` has no `unsafe`.
// `unsafe fn` says only that a caller takes on an obligation; its body is no
// unsafe context, so each unsafe operation in it is marked where it is
// written, as anywhere else: `let v = unsafe *p;`. "reading through a raw
// pointer needs unsafe".

use std::mem::alloca;

// Caller: `p` points at a live, initialized u32.
unsafe fn double_at(p: *u32) {
    let v = *p;
    unsafe *p = v * 2u32;
}

fn main() -> u32 {
    let p = unsafe alloca[u32]();
    unsafe *p = 21u32;
    unsafe double_at(p);
    unsafe *p
}
