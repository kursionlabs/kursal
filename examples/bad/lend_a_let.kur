// Rejected: a `let` binding never changes after it is bound, and lending a
// place lets the callee change it, so only a `var` is lent. `&a.tick()`
// lends `a`: "a is not a var; a lent place must be a var". Binding it with
// `var a = ...` makes it one.

exposed struct Counter {
    n: u32,
}

impl Counter {
    fn tick(&self) -> u32 {
        self.n = self.n + 1;
        self.n
    }
}

fn main() -> i32 {
    let a = Counter.{ n: 0 };
    let t = &a.tick();
    (t as i32)
}
