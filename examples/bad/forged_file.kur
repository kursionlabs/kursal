// Rejected: a `File!` built from a number. `File!` is a bare `struct`, so
// its fields are its module's own: no code outside `std::io` can build one,
// and every `File!` owns a descriptor `open_read` or `create` opened. Were
// this allowed, `close` would close whatever the process holds at 3: "the
// shape of std::io::File! is not exposed here".

use std::io::File!;

fn close_descriptor_three() -> bool {
    let file = File!.{ fd: 3i32 };
    file.close().is_ok()
}
