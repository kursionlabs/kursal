// Rejected: assigns a call whose return type is directly existential
// (`exists '1. Tag!['1]`) to an existing variable. The package is never
// opened implicitly, so `t = new_tag();` is a type mismatch between `t`'s
// type and the unopened `(exists ...)` package. Opening a package
// introduces brands scoped over the rest of the block, so it is a binding
// form: open it into a new name with `let exists 'b. next = new_tag();`.

use std::cap::{Brand, fresh};

forall 'k.
struct Tag! {
    marker: Brand['k],
}

fn new_tag() -> exists '1. Tag!['1] {
    let exists '1. k: Brand['1] = fresh();
    pack '1. Tag.{ marker: k }
}

fn main() -> u32 {
    let exists 'a. initial = new_tag();
    var t = initial;
    let { marker: m } = t;
    t = new_tag();
    let { marker: m2 } = t;
    0u32
}
