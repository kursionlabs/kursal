// Rejected: a type that holds itself by value has no finite layout, and a
// `foreach` can hide the cycle in the pointee of its source. The rows of
// `*F` over `*(foreach G of X => Wrap![X])` are the components of the
// pointee, so `F` is bound to `Wrap![X]` itself, held by value in `f`: "type
// Wrap!: infinite by-value layout". The walk of a declaration covers the
// pointee of a `foreach`'s pointer source, the origin of its rows, and
// rejects `Wrap!` where it is declared, before any use asks its size.

forall X.
struct Wrap! {
    f: foreach *F of *(foreach G of X => Wrap![X]) => F,
}

fn size(p: *Wrap![(u8,)]) -> u32 {
    0
}

fn main() -> i32 {
    0
}
