// Rejected: a type must have a finite size. `*F of *Tree` binds F to each
// field type of `Tree` itself, not to a pointer to it, so the field `kids`
// holds a struct whose field holds that struct again, without end: "type
// Tree: infinite by-value layout". `foreach F of *Tree => F` (pointers to
// the fields) is finite.

struct Tree {
    kids: foreach *F of *Tree => F,
}
