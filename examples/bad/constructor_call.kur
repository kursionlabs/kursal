// Rejected: a variant with a payload is built with `.(`, as in
// `Option::Some.(n)`, and never called like a function. A call
// `Option::Some(n)` is "`Option::Some` is a constructor; write
// `Option::Some.(...)`". A match case still names it `Some(x)`.
use std::option::Option;

fn wrap(n: u8) -> Option[u8] {
    Option::Some(n)
}

fn main() -> i32 {
    match wrap(1) {
        Some(x) => 0,
        None => 1,
    }
}
