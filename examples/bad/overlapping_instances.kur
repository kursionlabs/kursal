// Rejected: two instances of one trait that both apply to `u32`. A call
// bounded by a trait picks its instance from the types alone, so no two
// instances of a trait may overlap; the generic instance already covers
// `u32`, and there is no rule to prefer the specific one: "overlapping
// instances of overlapping_instances::Describe: (u32) and (T)".

forall Self. trait Describe {
    fn code(self: Self) -> u32;
}

forall T.
instance Describe[T] {
    fn code(self: T) -> u32 {
        0u32
    }
}

instance Describe[u32] {
    fn code(self: u32) -> u32 {
        self
    }
}
