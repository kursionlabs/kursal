// Rejected: constructs a linear `Handle!` and never consumes it. A linear
// value must be used exactly once, so returning while `h` is still live is
// an error: "linear value 'h' is not consumed before return".

struct Handle! {
    id: u64,
}

fn make_handle(id: u64) -> Handle! {
    Handle.{ id: id }
}

fn leaks_a_handle(id: u64) -> u32 {
    let h = make_handle(id);
    5u32
}
