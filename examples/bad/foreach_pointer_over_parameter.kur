// Rejected: `*F` matches only pointer components, and a type must have an
// expansion whatever its type arguments are. `T` may be `bool`, whose one
// component is no pointer, so where a type parameter decides the shape of
// the source only an explicit pointer will do: "foreach *F needs a source
// written as a pointer *P, as a type parameter decides its shape". Over
// `*T` every component is a pointer, and `foreach *F of *T => F` is fine.

forall T.
fn fields(x: foreach *F of T => F) -> foreach *F of T => F {
    x
}

fn main() -> i32 {
    0
}
