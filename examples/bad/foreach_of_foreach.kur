// Rejected: a `foreach` over a value of a `foreach` type maps its
// components, over the same source, and that source is never a `foreach`
// type itself: "a foreach source cannot be a foreach type". The type of
// `v` is formed, as a `foreach` type may stand in every type position, and
// `v` is passed and returned whole; but its components are those of an
// expansion over an expansion, and a map takes them only over a source
// that is none. Map `inner` before making the outer layer instead.

exposed struct Pair {
    a: u32,
    b: u32,
}

fn mapped(v: foreach F of (foreach G of Pair => (G, u8)) => (F, u16)) -> u32 {
    let m = foreach x of v { 0u8 };
    0
}

fn main() -> i32 {
    0
}
