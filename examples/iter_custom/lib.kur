// Your own iterator, and your own methods for every iterator.
//
// An iterator is a type with an `Iterator[Self -> Item]` instance: `next`
// takes it in-out and gives the next item, or `None` once it is done. The
// arrow says the iterator's type determines its item type, so `Fib` has one
// instance, `it.next()` is a method call, and a closure given to any of
// `Fib`'s methods knows its parameter is a `u64`. With the instance, `Fib`
// has every method `std::iter` gives an iterator and works in a `for` loop.
use std::iter::{Iterator, range};
use std::option::{Option, Result};
use std::io::stdout;

// The Fibonacci numbers below `limit`.
struct Fib {
    a: u64,
    b: u64,
    limit: u64,
}

fn fib(limit: u64) -> Fib {
    Fib.{ a: 0u64, b: 1u64, limit }
}

instance Iterator[Fib -> u64] {
    fn next(&it: Fib) -> Option[u64] {
        if it.a >= it.limit {
            Option::None
        } else {
            let a = it.a;
            it = Fib.{ a: it.b, b: a + it.b, limit: it.limit };
            Option::Some.(a)
        }
    }
}

// An extension impl: an `impl` whose target is one of its own type
// parameters gives its methods to every type meeting its bounds, here every
// iterator of `u64`. The library's own `map`, `filter` and `fold` are
// methods the same way.
forall I where Iterator[I -> u64].
impl I {
    fn sum(self) -> (I, u64) {
        self.fold(0u64, |acc, x| acc + x)
    }
}

// Generic code sees only the bound: `next` and the methods come through it.
forall I, T where Iterator[I -> T], Copy[T].
fn second(it: I) -> (I, Option[T]) {
    var it = it;
    let first = &it.next();
    let second = &it.next();
    (it, second)
}

fn main() -> i32 {
    var out = stdout();
    var small = fib(100u64);
    for n in &small {
        out = f"{n} ".write(out);
    }
    out = f"\n".write(out);
    let (_, even) = fib(4000000u64).filter(|n| n % 2u64 == 0u64).sum();
    out = f"the even Fibonacci numbers below 4000000 sum to {even}\n".write(out);
    let (_, after) = second(fib(100u64).skip(5));
    let seventh = after.unwrap_or(0u64);
    out = f"the seventh Fibonacci number is {seventh}\n".write(out);
    let (_, square) = second(range(3, 10).map(|x| x * x));
    let square = square.unwrap_or(0);
    out = f"the second square from 3 is {square}\n".write(out);
    match out.finish() {
        Result::Ok(nothing) => 0,
        Result::Err(code) => 1,
    }
}
