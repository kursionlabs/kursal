// Read a name from stdin, format a greeting into a Buffer!, and print it.

use std::io::{read_line, print_bytes};
use std::buffer::Buffer!;
use std::option::{Option, Result};

fn main() -> i32 {
    // The end of the input is an empty name; a read error stops the program.
    let name = match read_line() {
        Result::Ok(line) => match line {
            Option::Some(line) => line,
            Option::None => Buffer!::new(),
        },
        Result::Err(error) => return 1,
    };
    let greeting = f"Hello, {&name}!\n";
    name.destroy();

    let exists 'open1. (tag, bytes, restore) = greeting.open();
    print_bytes(&tag, bytes);
    restore.restore(tag).destroy();
    0
}
