// A read tree: freeze exclusive write authority, split simultaneous
// read authority, join the children, then resume writing.

use std::owned::Owned!;

exposed struct Pair {
    x: u32,
    y: u32,
}

// Freezes the shared Exclusive! into the root of a read tree, splits the
// root in two, and reads the Pair through each leaf while both are live,
// then joins the leaves back into the root and resumes the Exclusive! to
// close everything. (`mem_split_fields` projects one Ref per field.)
fn sum_via_split_view(x0: u32, y0: u32) -> u32 {
    let o = Owned!::new(Pair.{ x: x0, y: y0 });
    let exists 'open1. (alloc, reg) = o.open();
    let (tag, r, back) = reg.share();
    let exists 'open3. (rd, rr) = tag.share();
    let exists 'open4, 'open5. (rx, ry, j) = rd.split();
    let px = r.read(&rx);
    let py = r.read(&ry);
    let tag = rr.resume(j.join(rx, ry));
    let reg = back.resume(tag);
    let pair = alloc.close(reg).into_value();
    px.x + py.y
}

fn main() -> i32 {
    ((sum_via_split_view(10, 20) - 30) as i32)
}
