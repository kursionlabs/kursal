// Word frequencies: reads text on stdin and prints each distinct word with
// the number of times it occurs, most frequent first, then by word.
//
// One domain: the input is opened once, every word is a `Copy` slice of it,
// and the one capability for that domain is passed to whatever reads bytes,
// including the map that counts them. No word is copied, owned or freed.
use std::io::{Error, stdin, stdout};
use std::cursor::Cursor;
use std::cap::Exclusive!;
use std::slice::bytes_cmp_within;
use std::str::Str;
use std::fmt::Writer;
use std::collections::hashmap::{OwnedMap!, forget_entry};
use std::collections::vec::OwnedVec!;
use std::cmp::Order;
use std::option::{Option, Result};
use std::ascii::is_alpha;
use std::process::hash_seed;

fn not_letter(b: u8) -> bool {
    !is_alpha(b)
}

// How often each word of `text` occurs, keyed by the word itself.
forall 't.
fn count_words(&tag: Exclusive!['t], text: Str['t]) -> OwnedMap![Str['t], u32] {
    var counts = OwnedMap!::new[Str['t], u32](hash_seed());
    var cur = Cursor::new(text).skip_while(&tag, not_letter);
    while !cur.at_end() {
        let (c, word) = cur.take_matching(&tag, is_alpha);
        let found = &counts.with_in(&tag, word, |n: u32| (n + 1, ()));
        let unit = match found {
            Some(nothing) => (),
            None => {
                let old = &counts.insert_in(&tag, word, 1);
            },
        };
        cur = c.skip_while(&tag, not_letter);
    }
    counts
}

// Every entry of `counts` as a (count, word) pair. Draining the map is an
// iterator of its entries, each a `Pair { a: word, b: count }`.
forall 't.
fn pairs(counts: OwnedMap![Str['t], u32]) -> OwnedVec![(u32, Str['t])] {
    var exists 'd. entries = counts.drain();
    var pairs = OwnedVec!::new[(u32, Str['t])]();
    for entry in &entries {
        &pairs.push((entry.b, entry.a));
    }
    entries.finish(forget_entry[Str['t], u32]);
    pairs
}

// The entries in printing order: more frequent first, then by word.
forall 't.
fn by_frequency(&tag: Exclusive!['t], entries: OwnedVec![(u32, Str['t])]) -> OwnedVec![(u32, Str['t])] {
    var entries = entries;
    &entries.sort_by(&tag, |&tag, a, b| entry_order(&tag, a, b));
    entries
}

// The printing order: more frequent first, then by word.
forall 't.
fn entry_order(&tag: Exclusive!['t], a: (u32, Str['t]), b: (u32, Str['t])) -> Order {
    let (na, wa) = a;
    let (nb, wb) = b;
    if na != nb {
        if na > nb { Order::Less } else { Order::Greater }
    } else {
        bytes_cmp_within(&tag, wa, wb)
    }
}

fn main() -> Result[(), Error] {
    // A read error is not the end of the input: it stops the program.
    let text = stdin()?.read_to_end()?;
    var exists 't. (tag, bytes, text) = text.open();
    let counts = by_frequency(&tag, pairs(count_words(&tag, bytes.as_str())));
    var out = stdout();
    var entries = counts.iter();
    for entry in &entries {
        let (count, word) = entry;
        out = out.write(&tag, word);
        out = f" {count}\n".write(out);
    }
    entries.finish().destroy();
    text.restore(tag).destroy();
    out.finish()
}
