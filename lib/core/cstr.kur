// core::cstr -- helpers for a NUL-terminated C string pointer (an argv
// entry, a path, ...): distinct from `core::raw::Span['k]`, which always
// knows its own length up front and is never NUL-terminated by
// convention.
//
// Capability-free (no `Exclusive!`/`Brand` threading): both functions
// below only read already-resolved bytes transiently and never construct
// or consume a linear resource.

use package as core;

use core::raw::elem_ptr;
use core::raw::raw_byte_at;
use core::slice::Slice;

// A borrowed, process-lifetime NUL-terminated string. Construction is
// restricted because even measuring an arbitrary pointer would be unsafe.
struct CStr {
    ptr: *u8,
}

impl CStr {
    // `ptr` must address a live NUL-terminated byte run. In particular,
    // `argv` entries satisfy this for the duration of the process.
    unsafe fn from_raw(ptr: *u8) -> CStr {
        CStr.{ ptr }
    }

    // The raw pointer, for C interfaces. It grants no safe dereference
    // authority.
    fn as_ptr(self) -> *u8 {
        let { ptr } = self;
        ptr
    }

    fn eq_lit(self, lit: Slice[u8, 'static]) -> bool {
        let { ptr } = self;
        unsafe cstr_eq_lit(ptr, lit)
    }
}

// Length of a NUL-terminated C string. The scan is unbounded: no length
// is known ahead of it, so it walks until the NUL. `s` must address a live
// NUL-terminated byte run.
unsafe fn cstr_len(s: *u8) -> usize {
    var n = 0usize;
    var looping = true;
    while looping {
        let b = unsafe *(unsafe elem_ptr(s, n));
        if b == 0u8 {
            looping = false;
        } else {
            n = n + 1usize;
        }
    }
    n
}

// Is NUL-terminated `raw` equal to the string literal `lit`? Measures
// `raw` with `cstr_len` first, then compares byte by byte, reading the
// literal's own pointer and length directly. `raw` must address a live
// NUL-terminated byte run.
unsafe fn cstr_eq_lit(raw: *u8, lit: Slice[u8, 'static]) -> bool {
    let (lp, ln, lm) = lit.into_parts();
    let raw_len = unsafe cstr_len(raw);
    let result = if raw_len == ln {
        var mismatches = 0usize;
        var i = 0usize;
        while i < raw_len {
            let a = unsafe raw_byte_at(raw, raw_len, i);
            let b = unsafe raw_byte_at(lp, ln, i);
            let d = if a == b { 0usize } else { 1usize };
            mismatches = mismatches + d;
            i = i + 1usize;
        }
        mismatches == 0usize
    } else {
        false
    };
    result
}
