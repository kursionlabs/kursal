// The limits of each integer type, read as `u32::MAX`, `i8::MIN` and
// `u64::BITS`. `isize` and `usize` are 64 bits wide on every target.
//
// The floating-point types convert to and from their IEEE 754 bits
// (`x.to_bits()`, `f64::from_bits(b)`) and to each other: `f64::to_f32`
// rounds to the nearest `f32`, ties to even, past the largest to an
// infinity; `f32::to_f64` is exact. Every bit pattern is some float, and
// every float some bit pattern, so none of them needs `unsafe`.

impl i8 {
    const MIN: i8 = -128;
    const MAX: i8 = 127;
    const BITS: u32 = 8;
}

impl i16 {
    const MIN: i16 = -32768;
    const MAX: i16 = 32767;
    const BITS: u32 = 16;
}

impl i32 {
    const MIN: i32 = -2147483648;
    const MAX: i32 = 2147483647;
    const BITS: u32 = 32;
}

impl i64 {
    const MIN: i64 = -9223372036854775808;
    const MAX: i64 = 9223372036854775807;
    const BITS: u32 = 64;
}

impl isize {
    const MIN: isize = -9223372036854775808;
    const MAX: isize = 9223372036854775807;
    const BITS: u32 = 64;
}

impl u8 {
    const MIN: u8 = 0;
    const MAX: u8 = 0xff;
    const BITS: u32 = 8;
}

impl u16 {
    const MIN: u16 = 0;
    const MAX: u16 = 0xffff;
    const BITS: u32 = 16;
}

impl u32 {
    const MIN: u32 = 0;
    const MAX: u32 = 0xffff_ffff;
    const BITS: u32 = 32;
}

impl u64 {
    const MIN: u64 = 0;
    const MAX: u64 = 0xffff_ffff_ffff_ffff;
    const BITS: u32 = 64;
}

impl usize {
    const MIN: usize = 0;
    const MAX: usize = 0xffff_ffff_ffff_ffff;
    const BITS: u32 = 64;
}

impl f64 {
    const BITS: u32 = 64;

    fn to_bits(self) -> u64 {
        // A cast between a float and an integer of its width keeps the bits.
        unsafe (self as u64)
    }

    fn from_bits(bits: u64) -> f64 {
        unsafe (bits as f64)
    }

    fn to_f32(self) -> f32 {
        unsafe (self as f32)
    }
}

impl f32 {
    const BITS: u32 = 32;

    fn to_bits(self) -> u32 {
        unsafe (self as u32)
    }

    fn from_bits(bits: u32) -> f32 {
        unsafe (bits as f32)
    }

    fn to_f64(self) -> f64 {
        unsafe (self as f64)
    }
}
