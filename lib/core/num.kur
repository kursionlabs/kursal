//! Integer limits and numeric helpers.
// The limits of each integer type, read as `u32::MAX`, `i8::MIN` and
// `u64::BITS`. `isize` and `usize` are pointer-sized, 32 or 64 bits wide:
// their limits and widths are computed from `!0usize`, constant arithmetic
// that the C compiler folds at the target's width.
//
// The floating-point types convert to and from their IEEE 754 bits
// (`x.to_bits()`, `f64::from_bits(b)`) and to each other: `f64::to_f32`
// rounds to the nearest `f32`, ties to even, past the largest to an
// infinity; `f32::to_f64` is exact. Every bit pattern is some float, and
// every float some bit pattern, so none of them needs `unsafe`.

impl i8 {
    /// The smallest `i8`.
    const MIN: i8 = -128;
    /// The largest `i8`.
    const MAX: i8 = 127;
    /// The width of `i8` in bits.
    const BITS: u32 = 8;
}

impl i16 {
    /// The smallest `i16`.
    const MIN: i16 = -32768;
    /// The largest `i16`.
    const MAX: i16 = 32767;
    /// The width of `i16` in bits.
    const BITS: u32 = 16;
}

impl i32 {
    /// The smallest `i32`.
    const MIN: i32 = -2147483648;
    /// The largest `i32`.
    const MAX: i32 = 2147483647;
    /// The width of `i32` in bits.
    const BITS: u32 = 32;
}

impl i64 {
    /// The smallest `i64`.
    const MIN: i64 = -9223372036854775808;
    /// The largest `i64`.
    const MAX: i64 = 9223372036854775807;
    /// The width of `i64` in bits.
    const BITS: u32 = 64;
}

impl isize {
    /// The smallest `isize`.
    const MIN: isize = -isize::MAX - 1;
    /// The largest `isize`.
    const MAX: isize = (usize::MAX >> 1usize) as isize;
    /// The width of `isize` in bits.
    const BITS: u32 = usize::BITS;
}

impl u8 {
    /// The smallest `u8`.
    const MIN: u8 = 0;
    /// The largest `u8`.
    const MAX: u8 = 0xff;
    /// The width of `u8` in bits.
    const BITS: u32 = 8;
}

impl u16 {
    /// The smallest `u16`.
    const MIN: u16 = 0;
    /// The largest `u16`.
    const MAX: u16 = 0xffff;
    /// The width of `u16` in bits.
    const BITS: u32 = 16;
}

impl u32 {
    /// The smallest `u32`.
    const MIN: u32 = 0;
    /// The largest `u32`.
    const MAX: u32 = 0xffff_ffff;
    /// The width of `u32` in bits.
    const BITS: u32 = 32;
}

impl u64 {
    /// The smallest `u64`.
    const MIN: u64 = 0;
    /// The largest `u64`.
    const MAX: u64 = 0xffff_ffff_ffff_ffff;
    /// The width of `u64` in bits.
    const BITS: u32 = 64;
}

impl usize {
    /// The smallest `usize`.
    const MIN: usize = 0;
    /// The largest `usize`.
    const MAX: usize = !0usize;
    /// The width of `usize` in bits, the target's pointer width.
    /// 64 when the bits above the low 32 are set, else 32.
    const BITS: u32 = 32 + 32 * (((usize::MAX >> 31usize >> 1usize) & 1usize) as u32);
}

impl f64 {
    /// The width of `f64` in bits.
    const BITS: u32 = 64;

    /// The IEEE 754 bits of `self`, as a `u64`.
    fn to_bits(self) -> u64 {
        // A cast between a float and an integer of its width keeps the bits.
        unsafe (self as u64)
    }

    /// The `f64` whose IEEE 754 bits are `bits`.
    fn from_bits(bits: u64) -> f64 {
        unsafe (bits as f64)
    }

    /// `self` rounded to the nearest `f32`, ties to even, and past the largest to an infinity.
    fn to_f32(self) -> f32 {
        unsafe (self as f32)
    }
}

impl f32 {
    /// The width of `f32` in bits.
    const BITS: u32 = 32;

    /// The IEEE 754 bits of `self`, as a `u32`.
    fn to_bits(self) -> u32 {
        unsafe (self as u32)
    }

    /// The `f32` whose IEEE 754 bits are `bits`.
    fn from_bits(bits: u32) -> f32 {
        unsafe (bits as f32)
    }

    /// `self` as an `f64`, exactly.
    fn to_f64(self) -> f64 {
        unsafe (self as f64)
    }
}
