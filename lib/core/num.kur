// The limits of each integer type, read as `u32::MAX`, `i8::MIN` and
// `u64::BITS`. `isize` and `usize` are 64 bits wide on every target.

impl i8 {
    const MIN: i8 = -128;
    const MAX: i8 = 127;
    const BITS: u32 = 8;
}

impl i16 {
    const MIN: i16 = -32768;
    const MAX: i16 = 32767;
    const BITS: u32 = 16;
}

impl i32 {
    const MIN: i32 = -2147483648;
    const MAX: i32 = 2147483647;
    const BITS: u32 = 32;
}

impl i64 {
    const MIN: i64 = -9223372036854775808;
    const MAX: i64 = 9223372036854775807;
    const BITS: u32 = 64;
}

impl isize {
    const MIN: isize = -9223372036854775808;
    const MAX: isize = 9223372036854775807;
    const BITS: u32 = 64;
}

impl u8 {
    const MIN: u8 = 0;
    const MAX: u8 = 0xff;
    const BITS: u32 = 8;
}

impl u16 {
    const MIN: u16 = 0;
    const MAX: u16 = 0xffff;
    const BITS: u32 = 16;
}

impl u32 {
    const MIN: u32 = 0;
    const MAX: u32 = 0xffff_ffff;
    const BITS: u32 = 32;
}

impl u64 {
    const MIN: u64 = 0;
    const MAX: u64 = 0xffff_ffff_ffff_ffff;
    const BITS: u32 = 64;
}

impl usize {
    const MIN: usize = 0;
    const MAX: usize = 0xffff_ffff_ffff_ffff;
    const BITS: u32 = 64;
}
