//! Atomic operations and memory ordering.
/// C11 memory orderings for atomic operations on raw pointers and fences.
/// Supply a literal variant: the compiler selects the operation from it.
exposed enum Ordering {
    Relaxed,
    Acquire,
    Release,
    AcqRel,
    SeqCst,
}

// `unsafe fence(ordering)`: a memory fence, C11's `atomic_thread_fence`.
export builtin::fence;
