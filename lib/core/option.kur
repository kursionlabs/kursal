// Optional and fallible results. Payload multiplicity is structural:
// `Option[T]` and `Result[T, E]` are linear when their payload is linear.

use package as core;

forall T.
exposed enum Option {
    Some(T),
    None,
}

forall T, E.
exposed enum Result {
    Ok(T),
    Err(E),
}

forall T where Copy[T].
impl Option[T] {
    // The value, or `fallback` when there is none. `Copy` only: a linear
    // fallback would be dropped when there is a value.
    fn unwrap_or(self, fallback: T) -> T {
        match self {
            Option::Some(v) => v,
            Option::None => fallback,
        }
    }

    // A linear payload is asked with `match &x` instead.
    fn is_some(self) -> bool {
        match self {
            Option::Some(_v) => true,
            Option::None => false,
        }
    }

    fn is_none(self) -> bool {
        match self {
            Option::Some(_v) => false,
            Option::None => true,
        }
    }
}

forall T.
impl Option[T] {
    // `f` of the value, if there is one. `Copy[Env]`: with no value, `f` is
    // dropped uncalled.
    forall U, Env where Copy[Env].
    fn map(self, f: closure[Env](T) -> U) -> Option[U] {
        match self {
            Option::Some(v) => Option::Some.(f(v)),
            Option::None => Option::None,
        }
    }

    // `f` of the value, which may itself be absent.
    forall U, Env where Copy[Env].
    fn and_then(self, f: closure[Env](T) -> Option[U]) -> Option[U] {
        match self {
            Option::Some(v) => f(v),
            Option::None => Option::None,
        }
    }

    // The value, or `f()` when there is none.
    forall Env where Copy[Env].
    fn unwrap_or_else(self, f: closure[Env]() -> T) -> T {
        match self {
            Option::Some(v) => v,
            Option::None => f(),
        }
    }

    // `f` of the value, or `fallback` when there is none. `Copy[U]`: one of
    // `fallback` and `f`'s result is dropped.
    forall U, Env where Copy[U], Copy[Env].
    fn map_or(self, fallback: U, f: closure[Env](T) -> U) -> U {
        match self {
            Option::Some(v) => f(v),
            Option::None => fallback,
        }
    }

    // `Ok` of the value, or `Err(error)` when there is none. `Copy[E]`: with
    // a value, `error` is dropped.
    forall E where Copy[E].
    fn ok_or(self, error: E) -> Result[T, E] {
        match self {
            Option::Some(v) => Result::Ok.(v),
            Option::None => Result::Err.(error),
        }
    }
}

forall T, E.
impl Result[T, E] {
    // `f` of the value, keeping an error as it is.
    forall U, Env where Copy[Env].
    fn map(self, f: closure[Env](T) -> U) -> Result[U, E] {
        match self {
            Result::Ok(v) => Result::Ok.(f(v)),
            Result::Err(e) => Result::Err.(e),
        }
    }

    // `f` of the error, keeping a value as it is.
    forall F, Env where Copy[Env].
    fn map_err(self, f: closure[Env](E) -> F) -> Result[T, F] {
        match self {
            Result::Ok(v) => Result::Ok.(v),
            Result::Err(e) => Result::Err.(f(e)),
        }
    }

    // `f` of the value, which may itself fail.
    forall U, Env where Copy[Env].
    fn and_then(self, f: closure[Env](T) -> Result[U, E]) -> Result[U, E] {
        match self {
            Result::Ok(v) => f(v),
            Result::Err(e) => Result::Err.(e),
        }
    }
}

forall T, E where Copy[T], Copy[E].
impl Result[T, E] {
    // A linear value or error is asked with `match &r` instead.
    fn is_ok(self) -> bool {
        match self {
            Result::Ok(_v) => true,
            Result::Err(_e) => false,
        }
    }

    fn is_err(self) -> bool {
        match self {
            Result::Ok(_v) => false,
            Result::Err(_e) => true,
        }
    }
}

forall T, E where Copy[E].
impl Result[T, E] {
    // The value as an `Option`. `Copy[E]`: an error is dropped.
    fn ok(self) -> Option[T] {
        match self {
            Result::Ok(v) => Option::Some.(v),
            Result::Err(_e) => Option::None,
        }
    }
}
