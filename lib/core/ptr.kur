// Pointers that are never null.

use package as core;

use core::option::Option;

// A pointer that is never null. Restricted: only `new`, which checks, and
// the unsafe `new_unchecked` make one.
//
// Because a `NonNull` is never null, an enum of one empty variant and one
// variant holding a `NonNull` (alone, or as the only non-zero-size field of
// a struct or tuple, like `core::mem::Ref`) is represented as that pointer
// itself, a null pointer standing for the empty variant: so
// `Option[NonNull[T]]`, `Option[Ref[T, 'k]]` and `List[T]` are one word.
// This is the one declaration the compiler trusts for that layout; the
// layout of values is otherwise unspecified outside the unsafe boundary.
forall T.
struct NonNull {
    ptr: *T,
}

forall T.
impl NonNull[T] {
    // `p` as a `NonNull`, when it is not null.
    fn new(p: *T) -> Option[NonNull[T]] {
        let null = unsafe (0usize as *T);
        if p == null {
            Option::None
        } else {
            Option::Some.(NonNull.{ ptr: p })
        }
    }

    // `p` as a `NonNull`. Unsafe: the caller vouches that `p` is not null;
    // a null one would read as the empty variant of an enum holding it.
    unsafe fn new_unchecked(p: *T) -> NonNull[T] {
        NonNull.{ ptr: p }
    }

    // The pointer.
    fn as_ptr(self) -> *T {
        let { ptr } = self;
        ptr
    }
}
