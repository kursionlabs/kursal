//! Byte spans and raw byte operations.
// core::raw -- `Span['k]`, a byte range of a domain read through its
// capability, and the raw reads under it: bounds-checked indexing over a
// flat buffer given as a plain `*T` plus a length (`raw_get`,
// `raw_byte_at`). Those are not capability-gated accessors like
// `Slice::get_ref`: a caller that has flattened a structure to `*T` + `len`
// can peek into it without threading a live `Exclusive!` through every
// read. The caller still vouches (hence `unsafe fn`) that `len` really
// bounds the buffer.
//
// `T: Copy` is required: reading a value out of raw memory by index, with
// no tracking of whether that slot's value has already been read, is only
// sound for values that can be freely duplicated. A linear `T` read this
// way could be duplicated through two reads with nothing to catch it.

use package as core;

use core::option::Option;
use core::slice::{Slice, ReadBytes, StaticRead, byte_or_zero, bytes_cmp_within, bytes_eq, bytes_eq_within, find_byte, find_bytes, hash_bytes, rfind_byte};
use core::cap::{Access, Brand, Exclusive!, Shared!, Stamp};
use core::mem::sizeof;
use core::ptr::offset;
use core::ascii::{space_prefix, space_suffix};
use core::cmp::Order;
use core::hash::{HashIn, HashState};
use core::process::trap;

/// Element `i` of the `len` values at `base`, bounds-checked: `None` past
/// `len`, `Some(value)` otherwise.
forall T where Copy[T], Sized[T].
unsafe fn raw_get(base: *T, len: usize, i: usize) -> Option[T] {
    if i < len {
        Option::Some.(unsafe *(unsafe offset(base, i)))
    } else {
        Option::None
    }
}

/// Byte `i` of the `len` bytes at `base`, bounds-checked: out of range
/// reads come back as `0u8` (NUL)
/// rather than an `Option[u8]`, for scanners whose character-class tests
/// already treat `0u8` as matching nothing.
unsafe fn raw_byte_at(base: *u8, len: usize, i: usize) -> u8 {
    if i < len {
        unsafe *(unsafe offset(base, i))
    } else {
        0u8
    }
}

/// A byte range into some live text buffer, as `{ptr, len}`.
///
/// Branded and restricted: a span names bytes in domain 'k, and only this
/// module can build one or see its pointer. Reading the bytes needs a
/// capability that may read the domain (`core::slice::ReadBytes`): the
/// `Exclusive!['k]` itself, a node of its shared-read tree, or a context that
/// lends one (an arena's `alloc::arena::Domain!`, a program's own context),
/// so a span cannot be read once its arena's `Exclusive!['k]` is gone.
/// Planting one in a domain needs the `Exclusive!` itself, lent by a context
/// (`core::cap::Access`). `marker: Brand['k]` costs
/// nothing at runtime (`Brand` is Copy and zero-size) and does not make
/// `Span` linear. Literals enter a domain through `Span::from_static`;
/// spans over memory the caller just filled use `unsafe Span::from_raw_parts`.
/// Both take the domain's capability, so a span is
/// planted only in a domain its maker holds. `from_raw_parts_branded` takes
/// a brand instead, for a module whose own object holds it (an arena), and
/// is `unsafe` for that reason: a brand is `Copy` and proves nothing.
///
/// The methods that read take the capability by place, `&cx`. Generic code
/// over any readable byte view goes through `ReadBytes` too (`core::slice`'s
/// `byte_or_zero`, `find_bytes`, `bytes_eq_within`, ...); spans have its
/// instances for `Exclusive!` and `Shared!`.
forall 'k.
struct Span {
    ptr: *u8,
    len: usize,
    marker: Brand['k],
}

forall 'k.
impl Span['k] {
    /// A span over the `len` bytes at `ptr`, in domain `'k`.
    ///
    /// The checked way to build a span. `unsafe`: the caller vouches that
    /// `ptr[0 .. len)` is initialized and stays readable for as long as the
    /// domain 'k's capability exists.
    forall C, R where Access[C -> 'k, R].
    unsafe fn from_raw_parts(&cx: C, ptr: *u8, len: usize) -> Span['k] {
        let (tag, rest) = Access[C -> 'k, R]::open(cx);
        let stamp = &tag.stamp();
        let { marker } = stamp;
        cx = Access[C -> 'k, R]::close(tag, rest);
        Span.{ ptr, len, marker }
    }

    /// A span over the `len` bytes at `ptr`, branded with `marker`.
    ///
    /// The same, for a module whose own object already carries the domain's
    /// brand (an arena's `marker`, set once from `Exclusive!::fresh`).
    /// `unsafe` as above, and `marker` must be a witness that object really
    /// holds: a span planted in someone else's domain reads their bytes.
    unsafe fn from_raw_parts_branded(ptr: *u8, len: usize, marker: Brand['k]) -> Span['k] {
        Span.{ ptr, len, marker }
    }

    /// The bytes a slice views, as a span of the same domain. Safe: a
    /// `Slice`'s construction already vouched that its bytes are live and
    /// readable under its brand, which is all a span asks.
    fn from_slice(bytes: Slice[u8, 'k]) -> Span['k] {
        let (ptr, len, marker) = bytes.into_parts();
        Span.{ ptr, len, marker }
    }

    /// The pointer and length back; rebuilding a span from them needs
    /// `from_raw_parts` again. The brand stays inside: a span may be made
    /// from the capability alone, so it must not hand out a witness.
    fn into_parts(self) -> (*u8, usize) {
        let { ptr, len, marker } = self;
        (ptr, len)
    }

    /// No bytes at all; nothing to read.
    forall C, R where Access[C -> 'k, R].
    fn empty(&cx: C) -> Span['k] {
        Span::from_static(&cx, "")
    }

    /// A literal viewed as a span of domain 'k. Static bytes outlive every
    /// domain, so reading them under 'k's capability is always valid.
    forall C, R where Access[C -> 'k, R].
    fn from_static(&cx: C, text: Slice[u8, 'static]) -> Span['k] {
        let (ptr, len, m) = text.into_parts();
        let (tag, rest) = Access[C -> 'k, R]::open(cx);
        let stamp = &tag.stamp();
        let { marker } = stamp;
        cx = Access[C -> 'k, R]::close(tag, rest);
        Span.{ ptr, len, marker }
    }

    /// The number of bytes.
    fn len(self) -> usize {
        let { ptr, len, marker } = self;
        len
    }

    /// Whether the span has no bytes.
    fn is_empty(self) -> bool {
        self.len() == 0usize
    }

    /// Where the span starts, as a number. Like `Ref::address`, it hands out
    /// nothing to read through; it lets a span be matched against a known
    /// buffer (a diagnostic finding the line a name came from).
    fn address(self) -> usize {
        let { ptr, len, marker } = self;
        unsafe (ptr as usize)
    }

    /// The first `count` bytes, or the whole span if it is shorter.
    fn take(self, count: usize) -> Span['k] {
        let { len, ..rest } = self;
        if count < len {
            Span.{ len: count, ..rest }
        } else {
            Span.{ len, ..rest }
        }
    }

    /// Everything after the first `count` bytes, or an empty span at the end.
    fn skip(self, count: usize) -> Span['k] {
        let { ptr, len, ..rest } = self;
        let n = if count < len { count } else { len };
        Span.{ ptr: unsafe offset(ptr, n), len: len - n, ..rest }
    }

    /// Bytes `start` to `end`, each clamped to the span (an empty span when
    /// `start` is past `end`).
    fn slice(self, start: usize, end: usize) -> Span['k] {
        let end = if end > self.len() { self.len() } else { end };
        let start = if start > end { end } else { start };
        self.skip(start).take(end - start)
    }

    // The methods below read the bytes, through any capability that may read
    // them (`ReadBytes`): the domain's `Exclusive!`, a node of its shared-read
    // tree, or a context that lends one (`alloc::arena::Domain!`). They read
    // through the trait, never the span's pointer, so an instance can only
    // hand back wrong bytes, not read memory it has no capability for.
    // `Slice[u8, 'k]` has the same methods, in `core::slice`.

    /// Without the ASCII whitespace at its start (`core::ascii::is_space`).
    forall C where ReadBytes[C, Span['k]].
    fn trim_start(self, &cx: C) -> Span['k] {
        self.skip(space_prefix(&cx, self))
    }

    /// Without the ASCII whitespace at its end.
    forall C where ReadBytes[C, Span['k]].
    fn trim_end(self, &cx: C) -> Span['k] {
        self.take(self.len() - space_suffix(&cx, self))
    }

    /// Without the ASCII whitespace at either end.
    forall C where ReadBytes[C, Span['k]].
    fn trim(self, &cx: C) -> Span['k] {
        self.trim_start(&cx).trim_end(&cx)
    }

    /// `count` bytes starting `start` in, or `None` past the end. Checked by
    /// subtraction so a huge `count` cannot wrap into range.
    fn sub(self, start: usize, count: usize) -> Option[Span['k]] {
        let { ptr, len, ..rest } = self;
        if start > len {
            Option::None
        } else {
            let remaining = len - start;
            if count > remaining {
                Option::None
            } else {
                Option::Some.(Span.{ ptr: unsafe offset(ptr, start), len: count, ..rest })
            }
        }
    }

    /// Byte `i`, or `None` past the end.
    forall C where ReadBytes[C, Span['k]].
    fn get(self, &cx: C, i: usize) -> Option[u8] {
        ReadBytes[C, Span['k]]::get(&cx, self, i)
    }

    /// Byte `i`; stops the program (`core::process::trap`) past the end.
    /// `get` is the form for an index that may miss.
    forall C where ReadBytes[C, Span['k]].
    fn at(self, &cx: C, i: usize) -> u8 {
        match self.get(&cx, i) {
            Option::Some(b) => b,
            Option::None => trap(),
        }
    }

    /// Byte `i`, or `0u8` past the end: a sentinel for scanners whose
    /// character-class tests already treat `0u8` as matching nothing
    /// (`core::slice::byte_or_zero`).
    forall C where ReadBytes[C, Span['k]].
    fn byte_or_zero(self, &cx: C, i: usize) -> u8 {
        byte_or_zero(&cx, self, i)
    }

    /// Byte equality with another span of the domain.
    forall C where ReadBytes[C, Span['k]].
    fn eq(self, &cx: C, other: Span['k]) -> bool {
        // Spans of one buffer often share their bytes; skip the byte walk.
        (self.address() == other.address() && self.len() == other.len()) || bytes_eq_within(&cx, self, other)
    }

    /// Byte equality with a literal.
    forall C where ReadBytes[C, Span['k]].
    fn is(self, &cx: C, literal: Slice[u8, 'static]) -> bool {
        var sr = StaticRead::new();
        bytes_eq(&cx, self, &sr, literal)
    }

    /// Byte order, as unsigned values, a shorter prefix first
    /// (`core::slice::bytes_cmp`).
    forall C where ReadBytes[C, Span['k]].
    fn cmp(self, &cx: C, other: Span['k]) -> Order {
        bytes_cmp_within(&cx, self, other)
    }

    /// Whether the span's bytes start with `prefix`'s.
    forall C where ReadBytes[C, Span['k]].
    fn starts_with(self, &cx: C, prefix: Span['k]) -> bool {
        prefix.len() <= self.len() && self.take(prefix.len()).eq(&cx, prefix)
    }

    /// Whether the span's bytes end with `suffix`'s.
    forall C where ReadBytes[C, Span['k]].
    fn ends_with(self, &cx: C, suffix: Span['k]) -> bool {
        suffix.len() <= self.len() && self.skip(self.len() - suffix.len()).eq(&cx, suffix)
    }

    /// The first index at or after `start` where `needle`'s bytes appear
    /// (`core::slice::find_bytes`).
    forall C where ReadBytes[C, Span['k]].
    fn find(self, &cx: C, needle: Span['k], start: usize) -> Option[usize] {
        find_bytes(&cx, self, needle, start)
    }

    /// Whether `needle`'s bytes appear in the span.
    forall C where ReadBytes[C, Span['k]].
    fn contains(self, &cx: C, needle: Span['k]) -> bool {
        self.find(&cx, needle, 0usize).is_some()
    }

    /// The first index at or after `start` holding `byte`
    /// (`core::slice::find_byte`).
    forall C where ReadBytes[C, Span['k]].
    fn find_byte(self, &cx: C, byte: u8, start: usize) -> Option[usize] {
        find_byte(&cx, self, byte, start)
    }

    /// The last index holding `byte` (`core::slice::rfind_byte`).
    forall C where ReadBytes[C, Span['k]].
    fn rfind_byte(self, &cx: C, byte: u8) -> Option[usize] {
        rfind_byte(&cx, self, byte)
    }
}

/// Byte `index` of `s`, or `None` past its end, read with no capability.
///
/// The shared body of the `ReadBytes` instances. `unsafe`: reads `s` with no
/// capability of its own; every caller has just been handed one for 'k.
forall 'k.
unsafe fn span_byte_at(s: Span['k], index: usize) -> Option[u8] {
    let { ptr, len, marker } = s;
    if index < len {
        Option::Some.(unsafe raw_byte_at(ptr, len, index))
    } else {
        Option::None
    }
}

/// A span is read through its domain's `Exclusive!`.
forall 'r.
instance ReadBytes[Exclusive!['r], Span['r]] {
    fn get(&cx: Exclusive!['r], bytes: Span['r], index: usize) -> Option[u8] {
        unsafe span_byte_at(bytes, index)
    }
    fn len(&cx: Exclusive!['r], bytes: Span['r]) -> usize {
        bytes.len()
    }
}

/// A span is read through any node of its domain's shared-read tree.
forall 'r, 'q.
instance ReadBytes[Shared!['r, 'q], Span['r]] {
    fn get(&cx: Shared!['r, 'q], bytes: Span['r], index: usize) -> Option[u8] {
        unsafe span_byte_at(bytes, index)
    }
    fn len(&cx: Shared!['r, 'q], bytes: Span['r]) -> usize {
        bytes.len()
    }
}

// A span as a map key read through its domain's capability, as
// `core::slice` makes a byte slice one, and hashed as one: the same bytes
// hash the same in either.
/// Spans hash and compare by their bytes, read through the capability `C`.
forall C, 't where ReadBytes[C, Span['t]].
instance HashIn[Span['t], C] {
    fn hash_in(&cx: C, key: Span['t], state: HashState) -> HashState {
        hash_bytes(&cx, key, state)
    }

    // Spans of one buffer often share their bytes; equal addresses and
    // lengths skip the byte walk.
    fn eq_in(&cx: C, a: Span['t], b: Span['t]) -> bool {
        (a.address() == b.address() && a.len() == b.len()) || bytes_eq_within(&cx, a, b)
    }
}
