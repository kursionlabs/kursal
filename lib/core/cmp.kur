// core::cmp -- ordering. `Ord[A, B]` compares an `A` with a `B` and hands
// both back, like `Eq`, so linear values can be compared.
use package as core;

exposed enum Order {
    Less,
    Equal,
    Greater,
}

forall A, B.
trait Ord {
    fn cmp(a: A, b: B) -> (A, B, Order);
}

// The integers compare by value; `false` comes before `true`.

instance Ord[u8, u8] {
    fn cmp(a: u8, b: u8) -> (u8, u8, Order) {
        let order = if a < b {
            Order::Less
        } else {
            if a == b {
                Order::Equal
            } else {
                Order::Greater
            }
        };
        (a, b, order)
    }
}

instance Ord[u16, u16] {
    fn cmp(a: u16, b: u16) -> (u16, u16, Order) {
        let order = if a < b {
            Order::Less
        } else {
            if a == b {
                Order::Equal
            } else {
                Order::Greater
            }
        };
        (a, b, order)
    }
}

instance Ord[u32, u32] {
    fn cmp(a: u32, b: u32) -> (u32, u32, Order) {
        let order = if a < b {
            Order::Less
        } else {
            if a == b {
                Order::Equal
            } else {
                Order::Greater
            }
        };
        (a, b, order)
    }
}

instance Ord[u64, u64] {
    fn cmp(a: u64, b: u64) -> (u64, u64, Order) {
        let order = if a < b {
            Order::Less
        } else {
            if a == b {
                Order::Equal
            } else {
                Order::Greater
            }
        };
