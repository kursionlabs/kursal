        let order = if a < b {
            Order::Less
        } else {
            if a == b {
                Order::Equal
            } else {
                Order::Greater
            }
        };
        (a, b, order)
    }
}

instance Ord[i8, i8] {
    fn cmp(a: i8, b: i8) -> (i8, i8, Order) {
        let order = if a < b {
            Order::Less
        } else {
            if a == b {
                Order::Equal
            } else {
                Order::Greater
            }
        };
        (a, b, order)
    }
}

instance Ord[i16, i16] {
    fn cmp(a: i16, b: i16) -> (i16, i16, Order) {
        let order = if a < b {
            Order::Less
        } else {
            if a == b {
                Order::Equal
            } else {
                Order::Greater
            }
        };
        (a, b, order)
    }
}

instance Ord[i32, i32] {
    fn cmp(a: i32, b: i32) -> (i32, i32, Order) {
        let order = if a < b {
            Order::Less
        } else {
            if a == b {
                Order::Equal
            } else {
                Order::Greater
            }
        };
        (a, b, order)
    }
}

instance Ord[i64, i64] {
    fn cmp(a: i64, b: i64) -> (i64, i64, Order) {
        let order = if a < b {
            Order::Less
        } else {
            if a == b {
                Order::Equal
            } else {
                Order::Greater
            }
        };
        (a, b, order)
    }
}

instance Ord[isize, isize] {
    fn cmp(a: isize, b: isize) -> (isize, isize, Order) {
        let order = if a < b {
            Order::Less
        } else {
            if a == b {
                Order::Equal
            } else {
                Order::Greater
            }
        };
        (a, b, order)
    }
}

instance Ord[bool, bool] {
    fn cmp(a: bool, b: bool) -> (bool, bool, Order) {
        let order = if a == b {
            Order::Equal
        } else {
            if b { Order::Less } else { Order::Greater }
        };
        (a, b, order)
    }
}
