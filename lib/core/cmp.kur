//! Ordering and comparison traits.
// core::cmp -- ordering. `Ord[A, B]` compares an `A` with a `B` and hands
// both back, like `Eq`, so linear values can be compared.
use package as core;

/// The result of a comparison: less, equal or greater.
exposed enum Order {
    Less,
    Equal,
    Greater,
}

impl Order {
    /// Whether the order is `Less`.
    fn is_lt(self) -> bool {
        match self {
            Order::Less => true,
            _ => false,
        }
    }

    /// Whether the order is `Equal`.
    fn is_eq(self) -> bool {
        match self {
            Order::Equal => true,
            _ => false,
        }
    }

    /// Whether the order is `Greater`.
    fn is_gt(self) -> bool {
        match self {
            Order::Greater => true,
            _ => false,
        }
    }

    /// The opposite order: `a.cmp(b).reverse()` is `b.cmp(a)`.
    fn reverse(self) -> Order {
        match self {
            Order::Less => Order::Greater,
            Order::Equal => Order::Equal,
            Order::Greater => Order::Less,
        }
    }
}

/// Ordering of an `A` against a `B`, handing both back so linear values can
/// be compared.
forall A, B.
trait Ord {
    /// How `a` orders against `b`, with both handed back.
    fn cmp(a: A, b: B) -> (A, B, Order);
}

/// The smaller of `a` and `b`; `a` when they are equal. `Copy[T]`: the
/// other one is dropped.
forall T where Ord[T, T], Copy[T].
fn min(a: T, b: T) -> T {
    let (a, b, order) = Ord[T, T]::cmp(a, b);
    match order {
        Order::Greater => b,
        _ => a,
    }
}

/// The larger of `a` and `b`; `b` when they are equal.
forall T where Ord[T, T], Copy[T].
fn max(a: T, b: T) -> T {
    let (a, b, order) = Ord[T, T]::cmp(a, b);
    match order {
        Order::Greater => a,
        _ => b,
    }
}

// The integers compare by value; `false` comes before `true`.

instance Ord[u8, u8] {
    fn cmp(a: u8, b: u8) -> (u8, u8, Order) {
        let order = if a < b {
            Order::Less
        } else {
            if a == b {
                Order::Equal
            } else {
                Order::Greater
            }
        };
        (a, b, order)
    }
}

instance Ord[u16, u16] {
    fn cmp(a: u16, b: u16) -> (u16, u16, Order) {
        let order = if a < b {
            Order::Less
        } else {
            if a == b {
                Order::Equal
            } else {
                Order::Greater
            }
        };
        (a, b, order)
    }
}

instance Ord[u32, u32] {
    fn cmp(a: u32, b: u32) -> (u32, u32, Order) {
        let order = if a < b {
            Order::Less
        } else {
            if a == b {
                Order::Equal
            } else {
                Order::Greater
            }
        };
        (a, b, order)
    }
}

instance Ord[u64, u64] {
    fn cmp(a: u64, b: u64) -> (u64, u64, Order) {
        let order = if a < b {
            Order::Less
        } else {
            if a == b {
                Order::Equal
            } else {
                Order::Greater
            }
        };
        (a, b, order)
    }
}

instance Ord[usize, usize] {
    fn cmp(a: usize, b: usize) -> (usize, usize, Order) {
        let order = if a < b {
            Order::Less
        } else {
            if a == b {
                Order::Equal
            } else {
                Order::Greater
            }
        };
        (a, b, order)
    }
}

instance Ord[i8, i8] {
    fn cmp(a: i8, b: i8) -> (i8, i8, Order) {
        let order = if a < b {
            Order::Less
        } else {
            if a == b {
                Order::Equal
            } else {
                Order::Greater
            }
        };
        (a, b, order)
    }
}

instance Ord[i16, i16] {
    fn cmp(a: i16, b: i16) -> (i16, i16, Order) {
        let order = if a < b {
            Order::Less
        } else {
            if a == b {
                Order::Equal
            } else {
                Order::Greater
            }
        };
        (a, b, order)
    }
}

instance Ord[i32, i32] {
    fn cmp(a: i32, b: i32) -> (i32, i32, Order) {
        let order = if a < b {
            Order::Less
        } else {
            if a == b {
                Order::Equal
            } else {
                Order::Greater
            }
        };
        (a, b, order)
    }
}

instance Ord[i64, i64] {
    fn cmp(a: i64, b: i64) -> (i64, i64, Order) {
        let order = if a < b {
            Order::Less
        } else {
            if a == b {
                Order::Equal
            } else {
                Order::Greater
            }
        };
        (a, b, order)
    }
}

instance Ord[isize, isize] {
    fn cmp(a: isize, b: isize) -> (isize, isize, Order) {
        let order = if a < b {
            Order::Less
        } else {
            if a == b {
                Order::Equal
            } else {
                Order::Greater
            }
        };
        (a, b, order)
    }
}

instance Ord[bool, bool] {
    fn cmp(a: bool, b: bool) -> (bool, bool, Order) {
        let order = if a == b {
            Order::Equal
        } else {
            if b { Order::Less } else { Order::Greater }
        };
        (a, b, order)
    }
}
