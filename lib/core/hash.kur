// core::hash -- hashing and equality traits for keyed collections such as
// `alloc::collections::hashmap::HashMap!` (`Hash`, `Eq`) and
// `alloc::collections::arena_map::ArenaMap` (`HashIn`).
//
// `Hash::hash` threads both the value and a running `HashState` through:
// it takes `self` by value and hands it back (`-> (Self, HashState)`), so a
// linear key can be hashed without being consumed. A composite key feeds
// each of its fields through the same state in turn
// (`state = field.hash(state)`) rather than combining per-field hashes by
// hand.
//
// `Eq` is `Eq[A, B]`: the two sides may be different types. This lets
// values that differ only in brand be compared, as
// `core::borrow::Borrowed!`'s instance does for two lineage brands `'q1` and
// `'q2`. Both sides are handed back (`-> (A, B, bool)`). It is called by its
// full name: `Eq[K, K]::eq(a, b)`.
//
// There are no derived instances: the primitives and tuples of them have
// instances here, and every other key type writes its own.

use package as core;

use core::raw::raw_byte_at;

// A djb2-style multiply-add running hash. `u64` arithmetic wraps modulo
// 2^64. Hash quality affects only performance, never correctness. Every
// field is `u64`, so `HashState` is `Copy` and threads through repeated
// `write_*` calls by value.
exposed struct HashState {
    acc: u64,
}

impl HashState {
    fn new() -> HashState {
        HashState.{ acc: 5381u64 }
    }
    fn write_u8(self, b: u8) -> HashState {
        HashState.{ acc: (self.acc * 33u64) + (b as u64) }
    }
    fn write_u64(self, v: u64) -> HashState {
        HashState.{ acc: (self.acc * 1000003u64) + v }
    }
    // Mixes in every byte of `ptr[0..len)` in order. A plain loop, since
    // this is the hot path of every keyed collection. `unsafe`:
    // `ptr[0..len)` must be readable for the whole call.
    unsafe fn write_bytes(self, ptr: *u8, len: usize) -> HashState {
        var s = self;
        var i = 0usize;
        while i < len {
            s = s.write_u8(unsafe raw_byte_at(ptr, len, i));
            i = i + 1usize;
        }
        s
    }
    fn finish(self) -> u64 {
        self.acc
    }
}

forall Self.
trait Hash {
    fn hash(self: Self, state: HashState) -> (Self, HashState);
}

forall A, B.
trait Eq {
    fn eq(a: A, b: B) -> (A, B, bool);
}

// Hashing and equality for a `Copy` key that points into a domain, read
// through that domain's capability `C`: a `Slice[u8, 't]` read with an
// `Exclusive!['t]`, say. The key is a view rather than an owner, so it is
// not handed back; the capability is lent by place, as `ReadBytes` lends
// it. `core::slice` and `core::raw` have the byte-view instances; the
// primitive and tuple ones are at the end of this module.
forall K, C.
trait HashIn {
    fn hash_in(&cx: C, key: K, state: HashState) -> HashState;
    fn eq_in(&cx: C, a: K, b: K) -> bool;
}

// A key's hash under `HashIn`, from a fresh state and mixed, so that keys
// differing in a few low bits spread over all of them.
forall K, C where HashIn[K, C].
fn key_hash(&cx: C, key: K) -> u64 {
    mix(HashIn[K, C]::hash_in(&cx, key, HashState::new()).finish())
}

// Whether two keys are equal under `HashIn`.
forall K, C where HashIn[K, C].
fn key_eq(&cx: C, a: K, b: K) -> bool {
    HashIn[K, C]::eq_in(&cx, a, b)
}

// The bits of `x` spread over the whole word (a 64-bit finalizer).
fn mix(x: u64) -> u64 {
    let x = (x ^ (x >> 33u64)) * 18397679294719823053u64;
    let x = (x ^ (x >> 33u64)) * 14181476777654086739u64;
    x ^ (x >> 33u64)
}

// One hash of a hash `h` so far and the hash `x` of the next part: how a
// key hashed by its parts, in order, builds its own.
fn combine(h: u64, x: u64) -> u64 {
    mix(h * 31u64 + x)
}

// The primitive instances. Every integer hashes as its 64-bit value (a
// signed one by its two's-complement bits), so equal values hash equally
// whatever their width.
instance Hash[u8] {
    fn hash(self: u8, state: HashState) -> (u8, HashState) {
        (self, state.write_u64((self as u64)))
    }
}

instance Eq[u8, u8] {
    fn eq(a: u8, b: u8) -> (u8, u8, bool) {
        (a, b, a == b)
    }
}

instance Hash[u16] {
    fn hash(self: u16, state: HashState) -> (u16, HashState) {
        (self, state.write_u64((self as u64)))
    }
}

instance Eq[u16, u16] {
    fn eq(a: u16, b: u16) -> (u16, u16, bool) {
        (a, b, a == b)
    }
}

instance Hash[u32] {
    fn hash(self: u32, state: HashState) -> (u32, HashState) {
        (self, state.write_u64((self as u64)))
    }
}

instance Eq[u32, u32] {
    fn eq(a: u32, b: u32) -> (u32, u32, bool) {
        (a, b, a == b)
    }
}

instance Hash[u64] {
    fn hash(self: u64, state: HashState) -> (u64, HashState) {
        (self, state.write_u64(self))
    }
}

instance Eq[u64, u64] {
    fn eq(a: u64, b: u64) -> (u64, u64, bool) {
        (a, b, a == b)
    }
}

instance Hash[usize] {
    fn hash(self: usize, state: HashState) -> (usize, HashState) {
        (self, state.write_u64((self as u64)))
    }
}

instance Eq[usize, usize] {
    fn eq(a: usize, b: usize) -> (usize, usize, bool) {
        (a, b, a == b)
    }
}

instance Hash[i8] {
    fn hash(self: i8, state: HashState) -> (i8, HashState) {
        (self, state.write_u64((self as u64)))
    }
}

instance Eq[i8, i8] {
    fn eq(a: i8, b: i8) -> (i8, i8, bool) {
        (a, b, a == b)
    }
}

instance Hash[i16] {
    fn hash(self: i16, state: HashState) -> (i16, HashState) {
        (self, state.write_u64((self as u64)))
    }
}

instance Eq[i16, i16] {
    fn eq(a: i16, b: i16) -> (i16, i16, bool) {
        (a, b, a == b)
    }
}

instance Hash[i32] {
    fn hash(self: i32, state: HashState) -> (i32, HashState) {
        (self, state.write_u64((self as u64)))
    }
}

instance Eq[i32, i32] {
    fn eq(a: i32, b: i32) -> (i32, i32, bool) {
        (a, b, a == b)
    }
}

instance Hash[i64] {
    fn hash(self: i64, state: HashState) -> (i64, HashState) {
        (self, state.write_u64((self as u64)))
    }
}

instance Eq[i64, i64] {
    fn eq(a: i64, b: i64) -> (i64, i64, bool) {
        (a, b, a == b)
    }
}

instance Hash[isize] {
    fn hash(self: isize, state: HashState) -> (isize, HashState) {
        (self, state.write_u64((self as u64)))
    }
}

instance Eq[isize, isize] {
    fn eq(a: isize, b: isize) -> (isize, isize, bool) {
        (a, b, a == b)
    }
}

instance Hash[bool] {
    fn hash(self: bool, state: HashState) -> (bool, HashState) {
        let byte = if self { 1u8 } else { 0u8 };
        (self, state.write_u8(byte))
    }
}

instance Eq[bool, bool] {
    fn eq(a: bool, b: bool) -> (bool, bool, bool) {
        (a, b, a == b)
    }
}

// Tuples hash their parts in order through one state and compare part by
// part, handing every part back, so linear parts work too.
forall A, B where Hash[A], Hash[B].
instance Hash[(A, B)] {
    fn hash(self: (A, B), state: HashState) -> ((A, B), HashState) {
        let (a, b) = self;
        let (a, state) = Hash[A]::hash(a, state);
        let (b, state) = Hash[B]::hash(b, state);
        ((a, b), state)
    }
}

forall A, B, D where Hash[A], Hash[B], Hash[D].
instance Hash[(A, B, D)] {
    fn hash(self: (A, B, D), state: HashState) -> ((A, B, D), HashState) {
        let (a, b, d) = self;
        let (a, state) = Hash[A]::hash(a, state);
        let (b, state) = Hash[B]::hash(b, state);
        let (d, state) = Hash[D]::hash(d, state);
        ((a, b, d), state)
    }
}

forall A1, B1, A2, B2 where Eq[A1, A2], Eq[B1, B2].
instance Eq[(A1, B1), (A2, B2)] {
    fn eq(x: (A1, B1), y: (A2, B2)) -> ((A1, B1), (A2, B2), bool) {
        let (a1, b1) = x;
        let (a2, b2) = y;
        let (a1, a2, first) = Eq[A1, A2]::eq(a1, a2);
        let (b1, b2, second) = Eq[B1, B2]::eq(b1, b2);
        ((a1, b1), (a2, b2), first && second)
    }
}

forall A1, B1, D1, A2, B2, D2 where Eq[A1, A2], Eq[B1, B2], Eq[D1, D2].
instance Eq[(A1, B1, D1), (A2, B2, D2)] {
    fn eq(x: (A1, B1, D1), y: (A2, B2, D2)) -> ((A1, B1, D1), (A2, B2, D2), bool) {
        let (a1, b1, d1) = x;
        let (a2, b2, d2) = y;
        let (a1, a2, first) = Eq[A1, A2]::eq(a1, a2);
        let (b1, b2, second) = Eq[B1, B2]::eq(b1, b2);
        let (d1, d2, third) = Eq[D1, D2]::eq(d1, d2);
        ((a1, b1, d1), (a2, b2, d2), first && second && third)
    }
}

// The primitive and tuple keys of a domain-keyed map, under any capability:
// their bytes are their own, so `cx` only passes through, and they hash as
// `Hash` hashes them. A tuple key hashes and compares its parts in order,
// each under the same capability (`(Span['k], u32)` read with an
// `Exclusive!['k]`).
forall C.
instance HashIn[u8, C] {
    fn hash_in(&cx: C, key: u8, state: HashState) -> HashState {
        state.write_u64((key as u64))
    }

    fn eq_in(&cx: C, a: u8, b: u8) -> bool {
        a == b
    }
}
forall C.
instance HashIn[u16, C] {
    fn hash_in(&cx: C, key: u16, state: HashState) -> HashState {
        state.write_u64((key as u64))
    }

    fn eq_in(&cx: C, a: u16, b: u16) -> bool {
        a == b
    }
}
forall C.
instance HashIn[u32, C] {
    fn hash_in(&cx: C, key: u32, state: HashState) -> HashState {
        state.write_u64((key as u64))
    }

    fn eq_in(&cx: C, a: u32, b: u32) -> bool {
        a == b
    }
}
forall C.
instance HashIn[u64, C] {
    fn hash_in(&cx: C, key: u64, state: HashState) -> HashState {
        state.write_u64(key)
    }

    fn eq_in(&cx: C, a: u64, b: u64) -> bool {
        a == b
    }
}
forall C.
instance HashIn[usize, C] {
    fn hash_in(&cx: C, key: usize, state: HashState) -> HashState {
        state.write_u64((key as u64))
    }

    fn eq_in(&cx: C, a: usize, b: usize) -> bool {
        a == b
    }
}
forall C.
instance HashIn[i8, C] {
    fn hash_in(&cx: C, key: i8, state: HashState) -> HashState {
        state.write_u64((key as u64))
    }

    fn eq_in(&cx: C, a: i8, b: i8) -> bool {
        a == b
    }
}
forall C.
instance HashIn[i16, C] {
    fn hash_in(&cx: C, key: i16, state: HashState) -> HashState {
        state.write_u64((key as u64))
    }

    fn eq_in(&cx: C, a: i16, b: i16) -> bool {
        a == b
    }
}
forall C.
instance HashIn[i32, C] {
    fn hash_in(&cx: C, key: i32, state: HashState) -> HashState {
        state.write_u64((key as u64))
    }

    fn eq_in(&cx: C, a: i32, b: i32) -> bool {
        a == b
    }
}
forall C.
instance HashIn[i64, C] {
    fn hash_in(&cx: C, key: i64, state: HashState) -> HashState {
        state.write_u64((key as u64))
    }

    fn eq_in(&cx: C, a: i64, b: i64) -> bool {
        a == b
    }
}
forall C.
instance HashIn[isize, C] {
    fn hash_in(&cx: C, key: isize, state: HashState) -> HashState {
        state.write_u64((key as u64))
    }

    fn eq_in(&cx: C, a: isize, b: isize) -> bool {
        a == b
    }
}
forall C.
instance HashIn[bool, C] {
    fn hash_in(&cx: C, key: bool, state: HashState) -> HashState {
        state.write_u8(if key { 1u8 } else { 0u8 })
    }

    fn eq_in(&cx: C, a: bool, b: bool) -> bool {
        a == b
    }
}
forall A, B, C where HashIn[A, C], HashIn[B, C], Copy[A], Copy[B].
instance HashIn[(A, B), C] {
    fn hash_in(&cx: C, key: (A, B), state: HashState) -> HashState {
        let (a, b) = key;
        let state = HashIn[A, C]::hash_in(&cx, a, state);
        HashIn[B, C]::hash_in(&cx, b, state)
    }

    fn eq_in(&cx: C, x: (A, B), y: (A, B)) -> bool {
        let (a, b) = x;
        let (c, d) = y;
        HashIn[A, C]::eq_in(&cx, a, c) && HashIn[B, C]::eq_in(&cx, b, d)
    }
}

forall A, B, D, C where HashIn[A, C], HashIn[B, C], HashIn[D, C], Copy[A], Copy[B], Copy[D].
instance HashIn[(A, B, D), C] {
    fn hash_in(&cx: C, key: (A, B, D), state: HashState) -> HashState {
        let (a, b, d) = key;
        let state = HashIn[A, C]::hash_in(&cx, a, state);
        let state = HashIn[B, C]::hash_in(&cx, b, state);
        HashIn[D, C]::hash_in(&cx, d, state)
    }

    fn eq_in(&cx: C, x: (A, B, D), y: (A, B, D)) -> bool {
        let (a, b, d) = x;
        let (e, f, g) = y;
        HashIn[A, C]::eq_in(&cx, a, e) && HashIn[B, C]::eq_in(&cx, b, f) && HashIn[D, C]::eq_in(&cx, d, g)
    }
}
