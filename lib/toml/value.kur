//! TOML values and parse errors.
// toml::value -- what a TOML document holds, and where a parse failed.
//
// Every value is a `Copy` view into the caller's arena, branded `'k`:
// strings are spans (of the source itself when they hold no escape), arrays
// are `ArenaVec`s and tables are `ArenaMap`s from key to value, in the order
// the keys were first defined, as `toml::parser::parse` builds them.

use std::collections::arena_map::ArenaMap;
use std::collections::arena_vec::ArenaVec;
use std::option::Option;
use std::raw::Span;
use std::slice::{ReadBytes, Slice, byte_or_zero};

forall 'k.
exposed enum TomlValue {
    String(Span['k]),
    Integer(i64),
    Float(f64),
    Boolean(bool),
    Datetime(TomlDatetime['k]),
    Array(ArenaVec[TomlValue['k], 'k]),
    Table(ArenaMap[Span['k], TomlValue['k], 'k]),
}

/// The four date and time forms of TOML 1.0.
exposed enum DatetimeKind {
    // `1979-05-27T07:32:00Z`, `1979-05-27 07:32:00-07:00`
    OffsetDatetime,
    // `1979-05-27T07:32:00`
    LocalDatetime,
    // `1979-05-27`
    LocalDate,
    // `07:32:00.999`
    LocalTime,
}

/// A date or time, kept as its validated text: the parser checks every field
/// against its range, and the day against its month and year, and keeps the
/// spelling (`T`, `t` or a space between date and time, every digit of the
/// fraction).
forall 'k.
exposed struct TomlDatetime {
    kind: DatetimeKind,
    text: Span['k],
}

/// Where and why a document is not TOML: `offset` is the byte where the
/// parser stopped, `src.len()` at the end of the input.
exposed struct TomlError {
    offset: usize,
    message: Slice[u8, 'static],
}

forall 'k.
impl TomlValue['k] {
    fn as_string(self) -> Option[Span['k]] {
        match self {
            String(s) => Option::Some.(s),
            _ => Option::None,
        }
    }

    fn as_integer(self) -> Option[i64] {
        match self {
            Integer(n) => Option::Some.(n),
            _ => Option::None,
        }
    }

    fn as_float(self) -> Option[f64] {
        match self {
            Float(x) => Option::Some.(x),
            _ => Option::None,
        }
    }

    fn as_bool(self) -> Option[bool] {
        match self {
            Boolean(b) => Option::Some.(b),
            _ => Option::None,
        }
    }

    fn as_datetime(self) -> Option[TomlDatetime['k]] {
        match self {
            Datetime(d) => Option::Some.(d),
            _ => Option::None,
        }
    }

    fn as_array(self) -> Option[ArenaVec[TomlValue['k], 'k]] {
        match self {
            Array(a) => Option::Some.(a),
            _ => Option::None,
        }
    }

    fn as_table(self) -> Option[ArenaMap[Span['k], TomlValue['k], 'k]] {
        match self {
            Table(t) => Option::Some.(t),
            _ => Option::None,
        }
    }

    /// The name TOML gives the value's type.
    fn type_name(self) -> Slice[u8, 'static] {
        match self {
            String(s) => "string",
            Integer(n) => "integer",
            Float(x) => "float",
            Boolean(b) => "boolean",
            Datetime(d) => "datetime",
            Array(a) => "array",
            Table(t) => "table",
        }
    }
}

/// The line and column of byte `offset` of `src`, both from 1: the line is
/// one more than the newlines before `offset`, the column one more than the
/// bytes between the last of them and `offset`. An offset past the end
/// counts as the end.
forall C, S where ReadBytes[C, S], Copy[S].
fn line_column(&cx: C, src: S, offset: usize) -> (usize, usize) {
    let n = ReadBytes[C, S]::len(&cx, src);
    let end = if offset < n { offset } else { n };
    var line = 1usize;
    var start = 0usize;
    var i = 0usize;
    while i < end {
        if byte_or_zero(&cx, src, i) == b'\n' {
            line = line + 1usize;
            start = i + 1usize;
        }
        i = i + 1usize;
    }
    (line, end - start + 1usize)
}
