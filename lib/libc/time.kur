//! The monotonic clock and sleeping, the C half of `std::time`.
// time.c.

// CLOCK_MONOTONIC, in nanoseconds; the process aborts where it has none.
extern "C" fn kur_libc_time_monotonic() -> u64;
// Sleeps for `nanoseconds`, sleeping on after a signal.
extern "C" fn kur_libc_time_sleep(nanoseconds: u64) -> ();
