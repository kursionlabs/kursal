//! Floating-point numbers from text, the C half of `std::float`.

/// The C library's `strtod`: the double the text at `text` starts with, in
/// the process's locale (the C locale unless foreign code called
/// `setlocale`), with `*end` set past what it read.
extern "C" fn strtod(text: *u8, end: *(*u8)) -> f64;
