//! Formatting adapters for owning byte buffers.
// alloc::fmt -- writers and formatting. Re-exports `core::fmt`'s
// allocator-free protocol and adds what needs `Buffer!`: its `Writable` and
// `Format` instances, and `FixedWriter!`. `f"..."`
// expands through the `Writable` and `Format` names exported here.

use package as alloc;

use core::fmt::{Writable, write_bytes, write_u64, write_i64, write_f64, write_f32, Format, ReadingWriter!, CountingWriter};
export Writable;
export write_bytes;
export write_u64;
export write_i64;
export write_f64;
export write_f32;
export Format;
export ReadingWriter!;
export CountingWriter;
use core::slice::{Slice, StaticRead};
use core::raw::raw_byte_at;
use core::option::Result;
use alloc::buffer::Buffer!;

/// A buffer as a writer: every write appends.
///
/// Infallible: `Buffer!` aborts on out-of-memory.
instance Writable[Buffer!] {
    fn write_byte(self: Buffer!, byte: u8) -> Buffer! {
        self.push_byte(byte)
    }
    fn write_static(self: Buffer!, bytes: Slice[u8, 'static]) -> Buffer! {
        self.push_static(bytes)
    }
    /// Caller: as for `Writable::write_raw`, `ptr[0..len)` is readable for the
    /// whole call.
    unsafe fn write_raw(self: Buffer!, ptr: *u8, len: usize) -> Buffer! {
        unsafe self.push_n(ptr, len)
    }
}

/// Formats an owned buffer as its contents. The buffer is handed back, not
/// freed: an f-string formats a linear value only through `{&name}`.
forall W where Writable[W].
instance Format[Buffer!, W] {
    fn format(value: Buffer!, out: W) -> (Buffer!, W) {
        let exists 'b. (tag, bytes, restore) = value.open();
        // `unsafe`: the open buffer's bytes stay readable until `restore`.
        let (ptr, len, marker) = bytes.into_parts();
        let o = unsafe Writable[W]::write_raw(out, ptr, len);
        (restore.restore(tag), o)
    }
}

/// The sticky error a `FixedWriter!` reports once it has run out of room.
exposed struct Full {}

/// A byte buffer that never grows past `cap`. The first write that does not
/// fit marks it full; that write and every later one is dropped, so the
/// contents are always a prefix of what was written.
struct FixedWriter! {
    buf: Buffer!,
    cap: usize,
    full: bool,
}

impl FixedWriter! {
    /// An empty writer that holds at most `cap` bytes.
    fn new(cap: usize) -> FixedWriter! {
        FixedWriter!.{ buf: Buffer!::with_capacity(cap), cap, full: false }
    }

    /// The bytes written, and `Full` if any write was dropped.
    fn finish(self) -> (Buffer!, Result[(), Full]) {
        let { buf, cap, full } = self;
        let status = if full {
            Result[(), Full]::Err.(Full.{})
        } else {
            Result[(), Full]::Ok.(())
        };
        (buf, status)
    }
}

/// A fixed writer as a writer: bytes past its capacity are dropped.
instance Writable[FixedWriter!] {
    fn write_byte(self: FixedWriter!, byte: u8) -> FixedWriter! {
        var { buf, cap, full } = self;
        let n = &buf.len();
        if full || n >= cap {
            FixedWriter!.{ buf, cap, full: true }
        } else {
            FixedWriter!.{ buf: buf.push_byte(byte), cap, full }
        }
    }
    fn write_static(self: FixedWriter!, bytes: Slice[u8, 'static]) -> FixedWriter! {
        var sr = StaticRead::new();
        write_bytes(self, &sr, bytes)
    }
    /// Caller: as for `Writable::write_raw`, `ptr[0..len)` is readable for the
    /// whole call.
    unsafe fn write_raw(self: FixedWriter!, ptr: *u8, len: usize) -> FixedWriter! {
        var w = self;
        var i = 0usize;
        while i < len {
            w = w.write_byte(unsafe raw_byte_at(ptr, len, i));
            i = i + 1usize;
        }
        w
    }
}
