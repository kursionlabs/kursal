// A separate-chaining hash table whose entries live in the caller's
// `Arena!['k]`, unlike `alloc::collections::hashmap::HashMap!`, whose
// entries are individually heap-allocated. Suited to a registry built
// alongside other arena data, populated and then only queried: entries
// need no per-entry free, and destroying the arena reclaims them all.
//
// No `remove`: arena memory is never freed individually, so a removal
// could reclaim nothing. `insert` keeps the arena's brand: values never
// move and are never freed while the arena lives, so a `Ref[V,'k]` from
// `get_ref` stays valid across later inserts and resizes.
//
// The bucket array is a heap block, not arena memory: each resize
// allocates a bigger array, rehashes every entry into it, and frees the
// old one (see `resize` for why that is sound). Every `Entry` node and
// every stored key and value lives in the arena. `freeze` moves the
// final array into the arena.
//
// Search keys never touch the arena: `insert` and `get_ref` take
// `key: K` by value and stage it in `unsafe alloca[K]()`, valid for the
// enclosing call and reclaimed on return. A permanent arena copy is made
// only on `insert`'s new-key path. Comparisons go through `*K`: a generic
// `K` is not provably Copy, so a key compared against several entries is
// read out of its slot and written back at each step rather than
// consumed.
//
// `destroy` frees only the bucket array; the entries are reclaimed with
// the arena. Using the map after its arena is destroyed is not caught
// here: entry, key and value pointers are unbranded raw pointers once
// taken out of the `Ref` the arena returned.

use package as alloc;

use alloc::heap::Uninit;
use alloc::heap::HeapAllocator;
use alloc::heap::checked_mul;
use core::hash::Hash;
use core::hash::Eq;
use core::hash::HashState;
use core::cap::Exclusive;
use core::mem::Ref;
use alloc::arena::{Arena, copy_bytes};

forall T.
exposed enum Found {
    Item(T),
    Missing,
}

// `Entry` is `exposed` so another module can build and destructure
// entries directly, e.g. a cache that hashes and compares keys itself
// over the parts from `ArenaMap::into_parts`. It stores only pointers,
// so it is Copy whatever `K` and `V` are.
forall K, V.
exposed struct Entry {
    key: *K,
    val: *V,
    next: *Entry[K, V],
}

// `ArenaMap!` is not `exposed`: no other module can build or destructure
// it, so none can write `ArenaMap { buckets: <forged address>, .. }` and
// have `destroy` free that address without `unsafe`. Callers that need
// the raw parts, such as caches that hash and compare keys themselves,
// use `into_parts` (safe) and `adopt_parts` (`unsafe fn`).
forall K, V, 'k.
struct ArenaMap! {
    buckets: *(*Entry[K, V]),
    bucket_count: usize,
    len: usize,
    marker: Brand['k],
}

forall K, V.
unsafe fn null_entry() -> *Entry[K, V] {
    unsafe (0usize as *Entry[K, V])
}

forall K, V.
unsafe fn is_null_entry(p: *Entry[K, V]) -> bool {
    let a = unsafe (p as usize);
    a == 0usize
}

// Address of the i-th bucket slot: integer arithmetic on the base
// address, for a slot type that is itself a pointer (the same helper as
// in `alloc::collections::hashmap`).
forall K, V.
unsafe fn slot_ptr(base: *(*Entry[K, V]), i: usize) -> *(*Entry[K, V]) {
    let addr = unsafe (base as usize);
    let off = i * sizeof[*Entry[K, V]]();
    let addr2 = addr + off;
    unsafe (addr2 as *(*Entry[K, V]))
}

forall K, V.
unsafe fn alloc_buckets(n: usize) -> *(*Entry[K, V]) {
    let bytes = checked_mul(n, sizeof[*Entry[K, V]]());
    let u = HeapAllocator::alloc(bytes);
    let raw = u.into_raw();
    let base = unsafe (raw as *(*Entry[K, V]));
    var i = 0usize;
    while i < n {
        let s = unsafe slot_ptr[K, V](base, i);
        unsafe *s = unsafe null_entry[K, V]();
        i = i + 1usize;
    }
    base
}

// Bump-allocates one T in the arena, writes `val` there, and returns the
// raw pointer. Never freed individually; reclaimed with the arena. The
// `Ref[T,'k]` from `Arena::alloc` is flattened to its pointer so later
// reads need not thread the `Exclusive!` (see the header for the cost).
forall T, 'k.
unsafe fn arena_alloc_one(&tag: Exclusive!['k], &arena: Arena!['k], val: T) -> *T {
    let r = &arena.alloc(&tag, val);
    let (p, m) = r.into_parts();
    p
}

// Walks a chain comparing keys with `Eq`, returning the pointer to the
// matching entry's arena-allocated value (or `Missing`); `get_ref` wraps
// it as a `Ref[V,'k]`. A plain loop, not recursion: nothing here
// allocates or moves a value out of storage across iterations (`Entry`
// and `*K` are Copy; each key read out is written back).
forall K, V where Eq[K, K].
unsafe fn get_chain(head: *Entry[K, V], key_ptr: *K) -> Found[*V] {
    var cur = head;
    var found: Found[*V] = Found::Missing;
    while unsafe (cur as usize) != 0usize {
        let e = unsafe *cur;
        let { key: k, val: vp, next: nx } = e;
        let k_val = unsafe *k;
        let key_val = unsafe *key_ptr;
        let (k_val2, key_val2, is_match) = Eq[K, K]::eq(k_val, key_val);
        unsafe *k = k_val2;
        unsafe *key_ptr = key_val2;
        cur = if is_match {
            found = Found::Item.(vp);
            unsafe null_entry[K, V]()
        } else {
            nx
        };
    }
    found
}

// Inserts or updates in one bucket's chain, recursively, for the same
// reason as `alloc::collections::hashmap`'s `insert_chain`: which node
// consumes `val`, and whether a permanent key copy is arena-allocated at
// all, depends on a runtime comparison the checker cannot resolve across
// a loop's back edge. `key_slot` is the caller's `alloca` slot; the owned
// key is moved out of it into the arena only on the new-key path, and
// otherwise only compared through it.
forall K, V, 'k where Eq[K, K].
unsafe fn insert_chain(
    head: *Entry[K, V],
    tag: Exclusive!['k],
    arena: Arena!['k],
    key_slot: *K,
    val: V,
) -> (Exclusive!['k], Arena!['k], *Entry[K, V], Found[V], bool) {
    let is_null = unsafe is_null_entry[K, V](head);
    let result: (Exclusive!['k], Arena!['k], *Entry[K, V], Found[V], bool) = if is_null {
        let k2 = unsafe *key_slot;
        let key_ptr = unsafe arena_alloc_one[K, 'k](&tag, &arena, k2);
        let vp = unsafe arena_alloc_one[V, 'k](&tag, &arena, val);
        let entry_val = Entry.{ key: key_ptr, val: vp, next: head };
        let new_entry = unsafe arena_alloc_one[Entry[K, V], 'k](&tag, &arena, entry_val);
        (tag, arena, new_entry, Found::Missing, true)
    } else {
        let e = unsafe *head;
        let { key: k, val: vp, next: nx } = e;
        let k_val = unsafe *k;
        let key_val = unsafe *key_slot;
        let (k_val2, key_val2, is_match) = Eq[K, K]::eq(k_val, key_val);
        unsafe *k = k_val2;
        unsafe *key_slot = key_val2;
        let result2: (Exclusive!['k], Arena!['k], *Entry[K, V], Found[V], bool) = if is_match {
            let old_v = unsafe *vp;
            unsafe *vp = val;
            (tag, arena, head, Found::Item.(old_v), false)
        } else {
            let (tag, arena, new_next, found, is_new) = unsafe insert_chain[K, V, 'k](nx, tag, arena, key_slot, val);
            let updated = Entry.{ key: k, val: vp, next: new_next };
            unsafe *head = updated;
            (tag, arena, head, found, is_new)
        };
        result2
    };
    result
}

// Relinks one old bucket's chain into the new, larger bucket array. Node
// addresses are untouched; only each node's `next` changes, so a
// `Ref[V,'k]` into a node's arena-allocated value stays valid across the
// resize. Nothing is allocated here.
forall K, V where Hash[K].
unsafe fn rehash_bucket(head: *Entry[K, V], new_base: *(*Entry[K, V]), new_bc: usize) -> () {
    var cur = head;
    while unsafe (cur as usize) != 0usize {
        let e = unsafe *cur;
        let { key: k, val: vp, next: nx } = e;
        let key_val = unsafe *k;
        let (key_val2, state) = key_val.hash(HashState::new());
        unsafe *k = key_val2;
        let h = state.finish();
        let idx = (h as usize) % new_bc;
        let slot = unsafe slot_ptr[K, V](new_base, idx);
        let old_head = unsafe *slot;
        let updated = Entry.{ key: k, val: vp, next: old_head };
        unsafe *cur = updated;
        unsafe *slot = cur;
        cur = nx;
    }
}

// Doubles the bucket count, rehashes every entry into a new array, then
// frees the old array. Sound because nothing freed here is anything a
// `Ref[V,'k]` points into: `rehash_bucket` reuses every `Entry` at its
// address (only `next` changes), and every entry, key and value lives in
// the arena, never in this array. The old array holds only head pointers
// into those chains, and no `Ref` this module hands out points into it.
// Nothing can still be traversing the old array: `ArenaMap!` is linear
// and threaded through every operation, so no caller holds a stale copy
// from before the resize.
forall K, V where Hash[K].
unsafe fn resize(base: *(*Entry[K, V]), old_bc: usize) -> (*(*Entry[K, V]), usize) {
    let new_bc = checked_mul(old_bc, 2usize);
    let new_base = unsafe alloc_buckets[K, V](new_bc);
    var i = 0usize;
    while i < old_bc {
        let s = unsafe slot_ptr[K, V](base, i);
        let head = unsafe *s;
        let u = unsafe rehash_bucket[K, V](head, new_base, new_bc);
        i = i + 1usize;
    }
    let old_raw = unsafe (base as *u8);
    let u2 = HeapAllocator::drop(unsafe HeapAllocator::adopt_raw(old_raw));
    (new_base, new_bc)
}

// ------------------------------------------------- context-parameterized --
// For a `K` whose hashing and equality need a live capability that a
// `Hash[K]`/`Eq[K, K]` bound cannot state, e.g. a key containing `Ref`s
// that must be read through the domain's `Exclusive!['k]`. The same
// `get_chain`/`insert_chain`/`rehash_bucket`/`resize` shape, generic over
// `K`/`V`, with `hash_fn`/`eq_fn` function values in place of `.hash()`/
// `.eq()`, each threading the `Exclusive!['k]` in and back out.
//
// The helpers take `key_ptr: *K`, not `key: K`: a generic `K` is not
// provably Copy, so a search key read once per chain node is staged in
// `unsafe alloca[K]()` (in `get_ref_with`, `insert_with` and
// `get_copy_with`) and read through a raw pointer at each level, rather
// than passed as a value a recursive call could consume only once.
//
// They are `unsafe fn` because they take raw `*Entry[K,V]` and
// `*(*Entry[K,V])` pointers: `head`, `base` and `new_base` must be live
// allocations of the shape `alloc_buckets`/`resize_with` produce.
forall K, V, 'k.
unsafe fn get_chain_with(
    tag: Exclusive!['k],
    head: *Entry[K, V],
    key_ptr: *K,
    eq_fn: fn(Exclusive!['k], K, K) -> (Exclusive!['k], bool),
) -> (Exclusive!['k], Found[*V]) {
    let is_null = unsafe is_null_entry[K, V](head);
    if is_null {
        (tag, Found::Missing)
    } else {
        let e = unsafe *head;
        let { key: k, val: vp, next: nx } = e;
        let kv = unsafe *k;
        let key_val = unsafe *key_ptr;
        let (tag, is_match) = eq_fn(tag, kv, key_val);
        if is_match {
            (tag, Found::Item.(vp))
        } else {
            unsafe get_chain_with(tag, nx, key_ptr, eq_fn)
        }
    }
}

forall K, V, 'k.
unsafe fn insert_chain_with(
    head: *Entry[K, V],
    tag: Exclusive!['k],
    arena: Arena!['k],
    key_slot: *K,
    val: V,
    eq_fn: fn(Exclusive!['k], K, K) -> (Exclusive!['k], bool),
) -> (Exclusive!['k], Arena!['k], *Entry[K, V], Found[V], bool) {
    let is_null = unsafe is_null_entry[K, V](head);
    if is_null {
        let k2 = unsafe *key_slot;
        let key_ptr = unsafe arena_alloc_one[K, 'k](&tag, &arena, k2);
        let vp = unsafe arena_alloc_one[V, 'k](&tag, &arena, val);
        let entry_val = Entry.{ key: key_ptr, val: vp, next: head };
        let new_entry = unsafe arena_alloc_one[Entry[K, V], 'k](&tag, &arena, entry_val);
        (tag, arena, new_entry, Found::Missing, true)
    } else {
        let e = unsafe *head;
        let { key: k, val: vp, next: nx } = e;
        let kv = unsafe *k;
        let key_val = unsafe *key_slot;
        let (tag, is_match) = eq_fn(tag, kv, key_val);
        if is_match {
            let old_v = unsafe *vp;
            unsafe *vp = val;
            (tag, arena, head, Found::Item.(old_v), false)
        } else {
            let (tag, arena, new_next, found, is_new) = unsafe insert_chain_with(nx, tag, arena, key_slot, val, eq_fn);
            let updated = Entry.{ key: k, val: vp, next: new_next };
            unsafe *head = updated;
            (tag, arena, head, found, is_new)
        }
    }
}

forall K, V, 'k.
unsafe fn rehash_bucket_with(
    tag: Exclusive!['k],
    head: *Entry[K, V],
    new_base: *(*Entry[K, V]),
    new_bc: usize,
    hash_fn: fn(Exclusive!['k], K) -> (Exclusive!['k], u64),
) -> Exclusive!['k] {
    let is_null = unsafe is_null_entry[K, V](head);
    if is_null {
        tag
    } else {
        let e = unsafe *head;
        let { key: k, val: vp, next: nx } = e;
        let kv = unsafe *k;
        let (tag, h) = hash_fn(tag, kv);
        let idx = (h as usize) % new_bc;
        let slot = unsafe slot_ptr[K, V](new_base, idx);
        let old_head = unsafe *slot;
        let updated = Entry.{ key: k, val: vp, next: old_head };
        unsafe *head = updated;
        unsafe *slot = head;
        unsafe rehash_bucket_with(tag, nx, new_base, new_bc, hash_fn)
    }
}

forall K, V, 'k.
unsafe fn resize_go_with(
    tag: Exclusive!['k],
    base: *(*Entry[K, V]),
    new_base: *(*Entry[K, V]),
    new_bc: usize,
    i: usize,
    old_bc: usize,
    hash_fn: fn(Exclusive!['k], K) -> (Exclusive!['k], u64),
) -> Exclusive!['k] {
    if i >= old_bc {
        tag
    } else {
        let s = unsafe slot_ptr[K, V](base, i);
        let head = unsafe *s;
        let tag = unsafe rehash_bucket_with(tag, head, new_base, new_bc, hash_fn);
        unsafe resize_go_with(tag, base, new_base, new_bc, i + 1usize, old_bc, hash_fn)
    }
}

forall K, V, 'k.
unsafe fn resize_with(
    tag: Exclusive!['k],
    base: *(*Entry[K, V]),
    old_bc: usize,
    hash_fn: fn(Exclusive!['k], K) -> (Exclusive!['k], u64),
) -> (Exclusive!['k], *(*Entry[K, V]), usize) {
    let new_bc = checked_mul(old_bc, 2usize);
    let new_base = unsafe alloc_buckets[K, V](new_bc);
    let tag = unsafe resize_go_with(tag, base, new_base, new_bc, 0usize, old_bc, hash_fn);
    let old_raw = unsafe (base as *u8);
    let u2 = HeapAllocator::drop(unsafe HeapAllocator::adopt_raw(old_raw));
    (tag, new_base, new_bc)
}

forall K, V.
impl ArenaMap[K, V] {
    forall 'k.
    fn new(&tag: Exclusive!['k], &arena: Arena!['k]) -> ArenaMap![K, V, 'k] {
        let initial_buckets = 8usize;
        let base = unsafe alloc_buckets[K, V](initial_buckets);
        let marker = &arena.marker();
        ArenaMap.{ buckets: base, bucket_count: initial_buckets, len: 0usize, marker }
    }

    // Rebuilds a map from raw parts. Caller obligation: `buckets` is a live
    // allocation of exactly `bucket_count` slots of `*Entry[K,V]`, each a
    // chain head or the null sentinel (`null_entry`): either fresh from this
    // module's `alloc_buckets`/`resize`, or the untouched result of exactly
    // one earlier `into_parts` call on a genuine `ArenaMap!` with the same
    // `marker`, consumed here once. `len` is the accurate count of entries
    // reachable from `buckets`, and `marker` is the brand the parts were
    // paired with. Not detected here: mixing parts from two maps (even two
    // genuine ones), or passing the same parts to two `adopt_parts` calls.
    // The tuple `into_parts` returns is `Copy`, so either would yield two
    // `ArenaMap!` values that both believe they own one bucket array.
    forall 'k.
    unsafe fn adopt_parts(buckets: *(*Entry[K, V]), bucket_count: usize, len: usize, marker: Brand['k]) -> ArenaMap![K, V, 'k] {
        ArenaMap.{ buckets: buckets, bucket_count: bucket_count, len: len, marker: marker }
    }
}

forall K, V, 'k.
impl ArenaMap[K, V, 'k] {
    // `ArenaMap!` is linear, so even a read-only query hands `self` back. No
    // `Exclusive!['k]` is needed to answer it.
    fn len(&self) -> usize {
        let { buckets: b, bucket_count: bc, len: n, marker: m } = self;
        self = ArenaMap.{ buckets: b, bucket_count: bc, len: n, marker: m };
        n
    }

    // Consumes the map and hands back its raw parts. Safe: it grants no
    // dereference, ownership or reconstruction authority by itself, since
    // `ArenaMap!` is not `exposed` and only `adopt_parts` (`unsafe fn`) can
    // rebuild one. For callers that hash and compare keys themselves and so
    // cannot use `get_ref`/`insert`/`get_copy`.
    fn into_parts(self) -> (*(*Entry[K, V]), usize, usize, Brand['k]) {
        let { buckets: b, bucket_count: bc, len: n, marker: m } = self;
        (b, bc, n, m)
    }

    // Frees the bucket array, the only part of the map not in the arena.
    // Entries, keys and values are reclaimed when the arena is destroyed.
    fn destroy(self) -> () {
        let { buckets: base, bucket_count: bc, len: n, marker: m } = self;
        let raw = unsafe (base as *u8);
        HeapAllocator::drop(unsafe HeapAllocator::adopt_raw(raw))
    }
}

// `get_ref`/`insert` need `K` to hash and compare itself, so they get
// their own impl block, as `get_copy` gets one for `Copy[V]`: a `where`
// clause binds the whole `impl`, not one method.
forall K, V, 'k where Hash[K], Eq[K, K].
impl ArenaMap[K, V, 'k] {
    // Read-only: `tag` is presented, never consumed. The returned
    // `Ref[V,'k]`, if any, shares the arena's brand. The search key never
    // touches the arena; `unsafe alloca[K]()` stages it for this call only.
    fn get_ref(&self, &tag: Exclusive!['k], key: K) -> Found[Ref[V, 'k]] {
        let { buckets: base, bucket_count: bc, len: n, marker: m } = self;
        let key_slot = unsafe alloca[K]();
        unsafe *key_slot = key;
        let key_val = unsafe *key_slot;
        let (key_val2, state) = key_val.hash(HashState::new());
        unsafe *key_slot = key_val2;
        let h = state.finish();
        let idx = (h as usize) % bc;
        let s = unsafe slot_ptr[K, V](base, idx);
        let head = unsafe *s;
        let found_vp = unsafe get_chain[K, V](head, key_slot);
        let found_ref: Found[Ref[V, 'k]] = match found_vp {
            // `vp` is a value slot inside this map's own bucket chains,
            // which live in the domain `m` names.
            Found::Item(vp) => Found::Item.(unsafe Ref::from_raw(vp, m)),
            Found::Missing => Found::Missing,
        };
        self = ArenaMap.{ buckets: base, bucket_count: bc, len: n, marker: m };
        found_ref
    }

    // Keeps the arena's brand (there is no `remove` to invalidate it).
    // Returns the previous value (`Found::Item`) if `key` already had one,
    // so a linear `V` is never silently discarded.
    fn insert(&self, &tag: Exclusive!['k], &arena: Arena!['k], key: K, val: V) -> Found[V] {
        let { buckets: base, bucket_count: bc, len: n, marker: m } = self;
        let key_slot = unsafe alloca[K]();
        unsafe *key_slot = key;
        let key_val = unsafe *key_slot;
        let (key_val2, state) = key_val.hash(HashState::new());
        unsafe *key_slot = key_val2;
        let h = state.finish();
        let idx = (h as usize) % bc;
        let s = unsafe slot_ptr[K, V](base, idx);
        let head = unsafe *s;
        let (tag_back, arena_back, new_head, found, is_new) = unsafe insert_chain[K, V, 'k](head, tag, arena, key_slot, val);
        arena = arena_back;
        tag = tag_back;
        unsafe *s = new_head;
        let new_len = if is_new { n + 1usize } else { n };
        let threshold = bc * 3usize / 4usize;
        let should_resize = if is_new { new_len > threshold } else { false };
        let final_state = if should_resize {
            let (new_base, new_bc) = unsafe resize[K, V](base, bc);
            ArenaMap.{ buckets: new_base, bucket_count: new_bc, len: new_len, marker: m }
        } else {
            ArenaMap.{ buckets: base, bucket_count: bc, len: new_len, marker: m }
        };
        self = final_state;
        found
    }
}

forall K, V, 'k where Hash[K], Eq[K, K], Copy[V].
impl ArenaMap[K, V, 'k] {
    // Like `get_ref`, but hands the found value back by copy (`Found[V]`)
    // rather than as a `Ref[V,'k]`; bounded `V: Copy` so that copy is sound.
    // Same lookup: hash, bucket, chain walk.
    fn get_copy(&self, &tag: Exclusive!['k], key: K) -> Found[V] {
        let { buckets: base, bucket_count: bc, len: n, marker: m } = self;
        let key_slot = unsafe alloca[K]();
        unsafe *key_slot = key;
        let key_val = unsafe *key_slot;
        let (key_val2, state) = key_val.hash(HashState::new());
        unsafe *key_slot = key_val2;
        let h = state.finish();
        let idx = (h as usize) % bc;
        let s = unsafe slot_ptr[K, V](base, idx);
        let head = unsafe *s;
        let found_vp = unsafe get_chain[K, V](head, key_slot);
        let found: Found[V] = match found_vp {
            Found::Item(vp) => Found::Item.(unsafe *vp),
            Found::Missing => Found::Missing,
        };
        self = ArenaMap.{ buckets: base, bucket_count: bc, len: n, marker: m };
        found
    }
}

// The context-parameterized public API: `get_ref`/`insert`/`get_copy`
// with `hash_fn`/`eq_fn` in place of `.hash()`/`.eq()`; see the section
// comment above `get_chain_with`.
forall K, V, 'k.
impl ArenaMap[K, V, 'k] {
    fn get_ref_with(
        &self,
        &tag: Exclusive!['k],
        key: K,
        hash_fn: fn(Exclusive!['k], K) -> (Exclusive!['k], u64),
        eq_fn: fn(Exclusive!['k], K, K) -> (Exclusive!['k], bool),
    ) -> Found[Ref[V, 'k]] {
        let { buckets: base, bucket_count: bc, len: n, marker: m } = self;
        let key_slot = unsafe alloca[K]();
        unsafe *key_slot = key;
        let key_val = unsafe *key_slot;
        let (tag_back, h) = hash_fn(tag, key_val);
        tag = tag_back;
        let idx = (h as usize) % bc;
        let s = unsafe slot_ptr[K, V](base, idx);
        let head = unsafe *s;
        let (tag_back, found_vp) = unsafe get_chain_with(tag, head, key_slot, eq_fn);
        tag = tag_back;
        let found_ref: Found[Ref[V, 'k]] = match found_vp {
            // `vp` is a value slot inside this map's own bucket chains,
            // which live in the domain `m` names.
            Found::Item(vp) => Found::Item.(unsafe Ref::from_raw(vp, m)),
            Found::Missing => Found::Missing,
        };
        self = ArenaMap.{ buckets: base, bucket_count: bc, len: n, marker: m };
        found_ref
    }

    // Keeps the arena's brand, as `insert` does.
    fn insert_with(
        &self,
        &tag: Exclusive!['k],
        &arena: Arena!['k],
        key: K,
        val: V,
        hash_fn: fn(Exclusive!['k], K) -> (Exclusive!['k], u64),
        eq_fn: fn(Exclusive!['k], K, K) -> (Exclusive!['k], bool),
    ) -> Found[V] {
        let { buckets: base, bucket_count: bc, len: n, marker: m } = self;
        let key_slot = unsafe alloca[K]();
        unsafe *key_slot = key;
        let key_val = unsafe *key_slot;
        let (tag_back, h) = hash_fn(tag, key_val);
        tag = tag_back;
        let idx = (h as usize) % bc;
        let s = unsafe slot_ptr[K, V](base, idx);
        let head = unsafe *s;
        let (tag_back, arena_back, new_head, found, is_new) = unsafe insert_chain_with(head, tag, arena, key_slot, val, eq_fn);
        arena = arena_back;
        tag = tag_back;
        unsafe *s = new_head;
        let new_len = if is_new { n + 1usize } else { n };
        let threshold = bc * 3usize / 4usize;
        let should_resize = if is_new { new_len > threshold } else { false };
        let final_state = if should_resize {
            let (tag_back, new_base, new_bc) = unsafe resize_with(tag, base, bc, hash_fn);
            tag = tag_back;
            ArenaMap.{ buckets: new_base, bucket_count: new_bc, len: new_len, marker: m }
        } else {
            ArenaMap.{ buckets: base, bucket_count: bc, len: new_len, marker: m }
        };
        self = final_state;
        found
    }
}

// `get_copy_with` needs `Copy[V]` for the same reason as `get_copy`: it
// reads the found value out by copy (`unsafe *vp`) rather than handing
// back a `Ref`.
forall K, V, 'k where Copy[V].
impl ArenaMap[K, V, 'k] {
    fn get_copy_with(
        &self,
        &tag: Exclusive!['k],
        key: K,
        hash_fn: fn(Exclusive!['k], K) -> (Exclusive!['k], u64),
        eq_fn: fn(Exclusive!['k], K, K) -> (Exclusive!['k], bool),
    ) -> Found[V] {
        let { buckets: base, bucket_count: bc, len: n, marker: m } = self;
        let key_slot = unsafe alloca[K]();
        unsafe *key_slot = key;
        let key_val = unsafe *key_slot;
        let (tag_back, h) = hash_fn(tag, key_val);
        tag = tag_back;
        let idx = (h as usize) % bc;
        let s = unsafe slot_ptr[K, V](base, idx);
        let head = unsafe *s;
        let (tag_back, found_vp) = unsafe get_chain_with(tag, head, key_slot, eq_fn);
        tag = tag_back;
        let found: Found[V] = match found_vp {
            Found::Item(vp) => Found::Item.(unsafe *vp),
            Found::Missing => Found::Missing,
        };
        self = ArenaMap.{ buckets: base, bucket_count: bc, len: n, marker: m };
        found
    }

    // The value under `key`, or `default` when there is none.
    fn get_or_with(
        &self,
        &tag: Exclusive!['k],
        key: K,
        default: V,
        hash_fn: fn(Exclusive!['k], K) -> (Exclusive!['k], u64),
        eq_fn: fn(Exclusive!['k], K, K) -> (Exclusive!['k], bool),
    ) -> V {
        let found = &self.get_copy_with(&tag, key, hash_fn, eq_fn);
        match found {
            Found::Item(value) => value,
            Found::Missing => default,
        }
    }

    // Whether there is a value under `key`.
    fn has_with(
        &self,
        &tag: Exclusive!['k],
        key: K,
        hash_fn: fn(Exclusive!['k], K) -> (Exclusive!['k], u64),
        eq_fn: fn(Exclusive!['k], K, K) -> (Exclusive!['k], bool),
    ) -> bool {
        let found = &self.get_copy_with(&tag, key, hash_fn, eq_fn);
        match found {
            Found::Item(_) => true,
            Found::Missing => false,
        }
    }
}

// A read-only snapshot of a finished map. `freeze` consumes the linear
// `ArenaMap!`, so nothing can insert into (or resize) the bucket array
// afterwards, and the snapshot is Copy: it can live inside other Copy
// structures, such as an index over an immutable declaration list. Not
// `exposed`, for the same reason as `ArenaMap!`: its parts cannot be
// forged outside this module. Freezing moves the bucket array into the
// arena, so a snapshot lives exactly as long as the arena holding its
// entries and is reclaimed with it. Reads present the arena's
// `Exclusive!['k]` tag exactly as `Ref::copy` does.
forall K, V, 'k.
struct FrozenMap {
    buckets: *(*Entry[K, V]),
    bucket_count: usize,
    len: usize,
    marker: Brand['k],
}

forall K, V, 'k.
impl ArenaMap[K, V, 'k] {
    fn freeze(self, &arena: Arena!['k]) -> FrozenMap[K, V, 'k] {
        let { buckets: b, bucket_count: bc, len: n, marker: m } = self;
        let slot = sizeof[*Entry[K, V]]();
        let bytes = checked_mul(bc, slot);
        // Bump allocation is byte-granular: over-allocate one slot and round
        // the start up so the pointer array is aligned.
        let raw = unsafe &arena.alloc_bytes(bytes + slot);
        let addr = unsafe (raw as usize);
        let aligned = addr + ((slot - (addr % slot)) % slot);
        let dest = unsafe (aligned as *u8);
        let u = unsafe copy_bytes(dest, unsafe (b as *u8), bytes);
        let old_raw = unsafe (b as *u8);
        let u2 = HeapAllocator::drop(unsafe HeapAllocator::adopt_raw(old_raw));
        FrozenMap.{ buckets: unsafe (dest as *(*Entry[K, V])), bucket_count: bc, len: n, marker: m }
    }
}

forall K, V, 'k where Hash[K], Eq[K, K], Copy[V].
impl FrozenMap[K, V, 'k] {
    fn get_copy(self, &tag: Exclusive!['k], key: K) -> Found[V] {
        let { buckets: base, bucket_count: bc, len: n, marker: m } = self;
        let key_slot = unsafe alloca[K]();
        unsafe *key_slot = key;
        let key_val = unsafe *key_slot;
        let (key_val2, state) = key_val.hash(HashState::new());
        unsafe *key_slot = key_val2;
        let h = state.finish();
        let idx = (h as usize) % bc;
        let s = unsafe slot_ptr[K, V](base, idx);
        let head = unsafe *s;
        let found_vp = unsafe get_chain[K, V](head, key_slot);
        let found: Found[V] = match found_vp {
            Found::Item(vp) => Found::Item.(unsafe *vp),
            Found::Missing => Found::Missing,
        };
        found
    }
}

// `get_copy` for keys whose hash and equality read through the arena's
// capability (e.g. `core::raw::Span`), mirroring `ArenaMap::get_copy_with`.
// The snapshot must have been built with the same `hash_fn`.
forall K, V, 'k where Copy[V].
impl FrozenMap[K, V, 'k] {
    fn get_copy_with(
        self,
        &tag: Exclusive!['k],
        key: K,
        hash_fn: fn(Exclusive!['k], K) -> (Exclusive!['k], u64),
        eq_fn: fn(Exclusive!['k], K, K) -> (Exclusive!['k], bool),
    ) -> Found[V] {
        let { buckets: base, bucket_count: bc, len: n, marker: m } = self;
        let key_slot = unsafe alloca[K]();
        unsafe *key_slot = key;
        let key_val = unsafe *key_slot;
        let (tag_back, h) = hash_fn(tag, key_val);
        tag = tag_back;
        let idx = (h as usize) % bc;
        let s = unsafe slot_ptr[K, V](base, idx);
        let head = unsafe *s;
        let (tag_back, found_vp) = unsafe get_chain_with(tag, head, key_slot, eq_fn);
        tag = tag_back;
        let found: Found[V] = match found_vp {
            Found::Item(vp) => Found::Item.(unsafe *vp),
            Found::Missing => Found::Missing,
        };
        found
    }
    // The value under `key`, or `default` when there is none.
    fn get_or_with(
        self,
        &tag: Exclusive!['k],
        key: K,
        default: V,
        hash_fn: fn(Exclusive!['k], K) -> (Exclusive!['k], u64),
        eq_fn: fn(Exclusive!['k], K, K) -> (Exclusive!['k], bool),
    ) -> V {
        match self.get_copy_with(&tag, key, hash_fn, eq_fn) {
            Found::Item(value) => value,
            Found::Missing => default,
        }
    }

    // Whether there is a value under `key`.
    fn has_with(
        self,
        &tag: Exclusive!['k],
        key: K,
        hash_fn: fn(Exclusive!['k], K) -> (Exclusive!['k], u64),
        eq_fn: fn(Exclusive!['k], K, K) -> (Exclusive!['k], bool),
    ) -> bool {
        match self.get_copy_with(&tag, key, hash_fn, eq_fn) {
            Found::Item(_) => true,
            Found::Missing => false,
        }
    }
}
