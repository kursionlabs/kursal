//! Time: `Instant`, a reading of a monotonic clock; `Duration`, a span of
//! time; and `sleep`. `Duration`'s arithmetic saturates at the largest
//! `Duration`.
use package as std;

extern "C" fn kur_libc_time_monotonic() -> u64;
extern "C" fn kur_libc_time_sleep(nanoseconds: u64) -> ();

/// A span of time, in nanoseconds: up to some 584 years.
exposed struct Duration {
    nanoseconds: u64,
}

impl Duration {
    /// A duration of `nanoseconds` nanoseconds.
    fn from_nanos(nanoseconds: u64) -> Duration {
        Duration.{ nanoseconds }
    }

    // The arithmetic below saturates at the largest `Duration`.
    /// A duration of `milliseconds` milliseconds.
    fn from_millis(milliseconds: u64) -> Duration {
        Duration.{ nanoseconds: saturating_mul(milliseconds, 1000000u64) }
    }

    /// A duration of `seconds` seconds.
    fn from_secs(seconds: u64) -> Duration {
        Duration.{ nanoseconds: saturating_mul(seconds, 1000000000u64) }
    }

    /// The whole nanoseconds.
    fn as_nanos(self) -> u64 {
        self.nanoseconds
    }

    /// The whole milliseconds.
    fn as_millis(self) -> u64 {
        self.nanoseconds / 1000000u64
    }

    /// The whole seconds.
    fn as_secs(self) -> u64 {
        self.nanoseconds / 1000000000u64
    }
}

fn saturating_mul(a: u64, b: u64) -> u64 {
    if a != 0u64 && b > 18446744073709551615u64 / a { 18446744073709551615u64 } else { a * b }
}

/// Suspends the calling thread for at least `duration`, sleeping on for what
/// is left when a signal interrupts it.
fn sleep(duration: Duration) {
    unsafe kur_libc_time_sleep(duration.nanoseconds);
}

/// A reading of `CLOCK_MONOTONIC`: it never goes back, and its start is
/// arbitrary, so only the difference between two readings means anything.
struct Instant {
    nanoseconds: u64,
}

impl Instant {
    /// The current reading of the monotonic clock, from `libc/fs.c`, which
    /// names the host's `CLOCK_MONOTONIC`.
    fn now() -> Instant {
        Instant.{ nanoseconds: unsafe kur_libc_time_monotonic() }
    }

    /// The nanoseconds from `self` to `later`; zero if `later` is earlier.
    fn nanos_until(self, later: Instant) -> u64 {
        let { nanoseconds: start } = self;
        let { nanoseconds: end } = later;
        if end < start { 0u64 } else { end - start }
    }

    /// The whole milliseconds from `self` to `later`; zero if `later` is
    /// earlier.
    fn millis_until(self, later: Instant) -> u64 {
        self.nanos_until(later) / 1000000u64
    }

    /// The time from `self` to `later`; zero if `later` is earlier.
    fn duration_until(self, later: Instant) -> Duration {
        Duration.{ nanoseconds: self.nanos_until(later) }
    }
}
