// Time: `Instant`, a reading of a monotonic clock.
use package as std;

use core::mem::alloca;

extern "C" fn clock_gettime(clock: i32, spec: *isize) -> i32;

// C's `struct timespec` as the program's C sees it on Linux: `time_t` and
// `long` are pointer-sized there, since the generated C does not ask for
// 64-bit time on a 32-bit target (only `libc/fs.c` does, for its own calls).
struct Timespec {
    seconds: isize,
    nanoseconds: isize,
}

// A reading of `CLOCK_MONOTONIC`: it never goes back, and its start is
// arbitrary, so only the difference between two readings means anything.
struct Instant {
    nanoseconds: u64,
}

impl Instant {
    fn now() -> Instant {
        let spec = unsafe alloca[Timespec]();
        unsafe *spec = Timespec.{ seconds: 0isize, nanoseconds: 0isize };
        // CLOCK_MONOTONIC on Linux; it cannot fail with a valid `spec`.
        let status = unsafe clock_gettime(1i32, unsafe (spec as *isize));
        let { seconds, nanoseconds } = unsafe *spec;
        Instant.{ nanoseconds: (seconds as u64) * 1000000000u64 + (nanoseconds as u64) }
    }

    // The nanoseconds from `self` to `later`; zero if `later` is earlier.
    fn nanos_until(self, later: Instant) -> u64 {
        let { nanoseconds: start } = self;
        let { nanoseconds: end } = later;
        if end < start { 0u64 } else { end - start }
    }

    // The whole milliseconds from `self` to `later`; zero if `later` is
    // earlier.
    fn millis_until(self, later: Instant) -> u64 {
        self.nanos_until(later) / 1000000u64
    }
}
