// Time: `Instant`, wall time on a monotonic clock, and `CpuInstant`, the
// process's CPU time.
//
// `CpuInstant` reads C `clock()`. Ticks are taken to be microseconds, as
// they are on Linux. An elapsed time is `None` when `clock()` failed at the
// start (a negative reading) or `later` precedes `self`.
use package as std;

use core::mem::alloca;
use core::option::Option;

extern "C" fn clock() -> isize;
extern "C" fn clock_gettime(clock: i32, spec: *i64) -> i32;

// C's `struct timespec` on a 64-bit target.
struct Timespec {
    seconds: i64,
    nanoseconds: i64,
}

// A reading of `CLOCK_MONOTONIC`: it never goes back, and its start is
// arbitrary, so only the difference between two readings means anything.
struct Instant {
    nanoseconds: u64,
}

impl Instant {
    fn now() -> Instant {
        let spec = unsafe alloca[Timespec]();
        unsafe *spec = Timespec.{ seconds: 0i64, nanoseconds: 0i64 };
        // CLOCK_MONOTONIC on Linux; it cannot fail with a valid `spec`.
        let status = unsafe clock_gettime(1i32, unsafe (spec as *i64));
        let { seconds, nanoseconds } = unsafe *spec;
        Instant.{ nanoseconds: (seconds as u64) * 1000000000u64 + (nanoseconds as u64) }
    }

    // The nanoseconds from `self` to `later`; zero if `later` is earlier.
    fn nanos_until(self, later: Instant) -> u64 {
        let { nanoseconds: start } = self;
        let { nanoseconds: end } = later;
        if end < start { 0u64 } else { end - start }
    }

    // The whole milliseconds from `self` to `later`; zero if `later` is
    // earlier.
    fn millis_until(self, later: Instant) -> u64 {
        self.nanos_until(later) / 1000000u64
    }
}

struct CpuInstant {
    ticks: isize,
}

impl CpuInstant {
    fn now() -> CpuInstant {
        CpuInstant.{ ticks: unsafe clock() }
    }

    fn elapsed_ms(self, later: CpuInstant) -> Option[usize] {
        let { ticks: start } = self;
        let { ticks: end } = later;
        if start < 0isize || end < start {
            Option::None
        } else {
            Option::Some.(((end - start) as usize) / 1000usize)
        }
    }

    fn elapsed_us(self, later: CpuInstant) -> Option[usize] {
        let { ticks: start } = self;
        let { ticks: end } = later;
        if start < 0isize || end < start {
            Option::None
        } else {
            Option::Some.(((end - start) as usize))
        }
    }
}
