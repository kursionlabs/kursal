// Process CPU time, not wall time, read from C `clock()`. Ticks are taken
// to be microseconds, as they are on Linux. An elapsed time is `None` when
// `clock()` failed at the start (a negative reading) or `later` precedes
// `self`.
use package as std;

use core::option::Option;

extern "C" fn clock() -> isize;

struct CpuInstant {
    ticks: isize,
}

impl CpuInstant {
    fn now() -> CpuInstant {
        CpuInstant.{ ticks: unsafe clock() }
    }

    fn elapsed_ms(self, later: CpuInstant) -> Option[usize] {
        let { ticks: start } = self;
        let { ticks: end } = later;
        if start < 0isize || end < start {
            Option::None
        } else {
            Option::Some.(((end - start) as usize) / 1000usize)
        }
    }

    fn elapsed_us(self, later: CpuInstant) -> Option[usize] {
        let { ticks: start } = self;
        let { ticks: end } = later;
        if start < 0isize || end < start {
            Option::None
        } else {
            Option::Some.(((end - start) as usize))
        }
    }
}
