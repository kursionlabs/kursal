//! The process: its arguments, the processors it can run on, other programs
//! run and waited for, and the ways to end it early. Those are `exit`, through the C library, and `trap`,
//! core's builtin (`core::process::trap`), which stops it at once.
use package as std;

export core::process::trap;

use alloc::buffer::Buffer!;
use alloc::heap::exit as c_exit;
use core::cstr::CStr;
use core::option::{Option, Result};
use core::raw::raw_get;
use core::slice::{ReadBytes, Slice};
use std::io::{Error, c_string};

extern "C" fn kur_libc_process_spawn(line: *u8, len: usize, count: usize) -> i64;
extern "C" fn kur_libc_process_wait(pid: i64, block: u8) -> i64;
extern "C" fn kur_libc_process_cpus() -> usize;

/// The arguments the process was started with, the program's name first, as
/// C's `main` received them. A program's entry function may take one,
/// `fn main(args: Args) -> i32`: the C `main` the compiler writes for it
/// fills it from `argc` and `argv`, whose strings live as long as the
/// process. Nothing else makes one, so every `Args` holds `count` readable
/// entries, each a live NUL-terminated string.
struct Args {
    argv: *(*u8),
    count: usize,
}

impl Args {
    /// The number of arguments, the program's name included.
    fn len(self) -> usize {
        let { argv, count } = self;
        count
    }

    /// Argument `index` as a C string, or `None` past the last one.
    fn get(self, index: usize) -> Option[CStr] {
        let { argv, count } = self;
        // `argv` has `count` entries.
        let raw = unsafe raw_get(argv, count, index);
        match raw {
            Option::None => Option::None,
            // A live NUL-terminated string for the rest of the process.
            Option::Some(ptr) => Option::Some.(unsafe CStr::from_raw(ptr)),
        }
    }

    /// The bytes of argument `index`, without its NUL. `argv` strings live
    /// as long as the process does, so the view is `'static`.
    fn bytes(self, index: usize) -> Option[Slice[u8, 'static]] {
        match self.get(index) {
            Option::None => Option::None,
            Option::Some(arg) => Option::Some.(arg.bytes()),
        }
    }
}

/// How a child process ended: `exit` with a status, or a signal.
exposed enum Exit {
    Code(i32),
    Signal(i32),
}

/// A program to run and its arguments, each any byte view, copied in as it
/// is added: a command line that outlives what it was built from.
struct Command! {
    // each argument followed by a NUL, the program first
    line: Buffer!,
    count: usize,
}

impl Command! {
    /// A command running `program`, found on the `PATH` as `posix_spawnp`
    /// finds it, with no arguments yet.
    forall C, S where ReadBytes[C, S], Copy[S].
    fn new(&cx: C, program: S) -> Command! {
        Command!.{ line: c_string(&cx, program), count: 1usize }
    }

    /// The command with `argument` added after its other arguments.
    forall C, S where ReadBytes[C, S], Copy[S].
    fn arg(self, &cx: C, argument: S) -> Command! {
        let { line, count } = self;
        Command!.{ line: line.push_bytes(&cx, argument).push_byte(0u8), count: count + 1usize }
    }

    /// Runs the program with this process's environment and waits for it:
    /// `spawn`, then `Child!::wait`, with their errors.
    fn run(self) -> Result[Exit, Error] {
        match self.spawn() {
            Result::Ok(child) => child.wait(),
            Result::Err(e) => Result::Err.(e),
        }
    }

    /// Starts the program with this process's environment and hands back
    /// the running child, which must be waited for. The error is what
    /// `posix_spawnp` reports, among them the errno of the `exec` that
    /// failed (ENOENT for a program not found); EINVAL when the program or an
    /// argument holds a NUL.
    fn spawn(self) -> Result[Child!, Error] {
        let { line, count } = self;
        var line = line;
        let p = unsafe &line.as_ptr();
        let n = &line.len();
        // `p` holds `count` NUL-terminated arguments in `n` bytes.
        let pid = unsafe kur_libc_process_spawn(p, n, count);
        line.destroy();
        if pid < 0i64 {
            Result::Err.(Error.{ errno: (0i64 - pid) as i32 })
        } else {
            Result::Ok.(Child!.{ pid })
        }
    }

    /// Frees a command that is not run.
    fn destroy(self) {
        let { line, count } = self;
        line.destroy();
    }
}

/// A program `Command!::spawn` started, running until it is waited for.
/// Waiting reaps it, so a child is waited for once; one left unwaited would
/// stay a zombie until this process ends.
struct Child! {
    pid: i64,
}

/// What `Child!::try_wait` found: the child still running, or how it ended.
exposed enum Polled! {
    Running(Child!),
    Ended(Exit),
}

impl Child! {
    /// Waits for the child to end, again when a signal interrupts the wait.
    /// The error is what `waitpid` reports.
    fn wait(self) -> Result[Exit, Error] {
        let { pid } = self;
        exit_of(unsafe kur_libc_process_wait(pid, 1u8))
    }

    /// Whether the child has ended, without waiting: the child back while
    /// it runs, else how it ended. The error is what `waitpid` reports.
    fn try_wait(self) -> Result[Polled!, Error] {
        let { pid } = self;
        let result = unsafe kur_libc_process_wait(pid, 0u8);
        if result == 512i64 {
            return Result::Ok.(Polled!::Running.(Child!.{ pid }));
        }
        match exit_of(result) {
            Result::Ok(exit) => Result::Ok.(Polled!::Ended.(exit)),
            Result::Err(e) => Result::Err.(e),
        }
    }
}

// How a child ended, from what `kur_libc_process_wait` returns for one that has.
fn exit_of(result: i64) -> Result[Exit, Error] {
    if result < 0i64 {
        Result::Err.(Error.{ errno: (0i64 - result) as i32 })
    } else if result < 256i64 {
        Result::Ok.(Exit::Code.(result as i32))
    } else {
        Result::Ok.(Exit::Signal.((result - 256i64) as i32))
    }
}

/// The number of processors the process may run on, at least 1: how many
/// of its threads can run at once without waiting for one another. That is
/// the processors of its CPU affinity mask (`taskset`, `sched_setaffinity`)
/// where the C library reports the mask, else the processors online.
fn available_parallelism() -> usize {
    unsafe kur_libc_process_cpus()
}

/// Ends the process with `status` after C's `exit` runs its handlers and
/// flushes C's own streams. Like `trap`, it breaks no invariant: nothing
/// after it runs. Linear values still live are not consumed, so whatever
/// they own is left for the operating system to reclaim.
fn exit(status: i32) -> ! {
    unsafe c_exit(status)
}
