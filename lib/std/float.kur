//! Parse floating-point numbers from readable byte views.
use package as std;

use alloc::buffer::Buffer!;
use core::ascii::is_space;
use core::mem::alloca;
use core::option::Option;
use core::ptr::offset;
use core::slice::{ReadBytes, byte_or_zero};

extern "C" fn strtod(text: *u8, end: *(*u8)) -> f64;

/// Parse the entire byte view as a C-locale `f64`. Returns `None` for an empty
/// view, leading space, or any trailing byte past the number.
forall C, S where ReadBytes[C, S], Copy[S].
fn parse_f64(&cx: C, bytes: S) -> Option[f64] {
    let n = ReadBytes[C, S]::len(&cx, bytes);
    if n == 0usize || is_space(byte_or_zero(&cx, bytes, 0usize)) {
        return Option::None;
    }
    var digits = Buffer!::new().push_bytes(&cx, bytes).push_byte(0u8);
    let start = unsafe &digits.as_ptr();
    let end = unsafe alloca[*u8]();
    unsafe *end = start;
    let value = unsafe strtod(start, end);
    let whole = unsafe (unsafe *end as usize) == unsafe (unsafe offset(start, n) as usize);
    digits.destroy();
    if whole {
        Option::Some.(value)
    } else {
        Option::None
    }
}
