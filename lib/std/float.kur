//! Floating-point numbers from text. They are read through C's `strtod`,
//! which rounds a decimal to the nearest double correctly (ties to even) and to an infinity
//! past the largest one. The view is read through whatever capability
//! permits it (`Exclusive!`, `Shared!`, `StaticRead`).
use package as std;

use alloc::buffer::Buffer!;
use core::ascii::is_space;
use core::mem::alloca;
use core::option::Option;
use core::ptr::offset;
use core::slice::{ReadBytes, byte_or_zero};

extern "C" fn strtod(text: *u8, end: *(*u8)) -> f64;

/// The double that all of `bytes` spells, as `strtod` reads it in the C
/// locale: a decimal such as `-2.5e3` or `.5`, a hexadecimal float such as
/// `0x1p-3`, `inf` or `nan`. Nothing for an empty view, a leading space, or
/// any byte past the number (a NUL among them).
forall C, S where ReadBytes[C, S], Copy[S].
fn parse_f64(&cx: C, bytes: S) -> Option[f64] {
    let n = ReadBytes[C, S]::len(&cx, bytes);
    if n == 0usize || is_space(byte_or_zero(&cx, bytes, 0usize)) {
        return Option::None;
    }
    var digits = Buffer!::new().push_bytes(&cx, bytes).push_byte(0u8);
    let start = unsafe &digits.as_ptr();
    let end = unsafe alloca[*u8]();
    unsafe *end = start;
    let value = unsafe strtod(start, end);
    let whole = unsafe (unsafe *end as usize) == unsafe (unsafe offset(start, n) as usize);
    digits.destroy();
    if whole {
        Option::Some.(value)
    } else {
        Option::None
    }
}
