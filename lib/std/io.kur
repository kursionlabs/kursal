// Process I/O over the POSIX `read`/`write`/`open`/`close`/`fstat` calls:
// byte output to raw descriptors, whole-file and stdin reads into an owned
// `Buffer!`, the owning descriptor type `File!`, and buffered `Output!`;
// and `Error`, the error of every operating-system call of the library.
// Paths are any byte view (`c_string`); `std::fs` works with them whole.

use package as std;

use alloc::buffer::Buffer!;
use core::raw::Span;
use core::ptr::offset;
use core::slice::{Slice, ReadBytes};
use core::fmt::Writable;
use core::option::{Option, Result};
use core::cap::{Access, Exclusive!};

// `libc/fs.c`, which every program links, wraps the system calls: each
// retries a call a signal interrupted (EINTR), opens descriptors
// close-on-exec, and reports a failure as a negative errno, so no variadic
// C function is called through a fixed prototype and no `errno` is read
// from here.
extern "C" fn kur_libc_fs_read(fd: i32, buf: *u8, count: usize) -> isize;
extern "C" fn kur_libc_fs_write(fd: i32, buf: *u8, count: usize) -> isize;
extern "C" fn kur_libc_fs_open_read(path: *u8, len: usize) -> i32;
extern "C" fn kur_libc_fs_create(path: *u8, len: usize) -> i32;
extern "C" fn kur_libc_fs_close(fd: i32) -> i32;
extern "C" fn kur_libc_fs_regular_size(fd: i32) -> isize;

// A path, name or argument for C: the bytes of a view, read through the
// capability that permits it, followed by a NUL, in a buffer the caller
// frees once the call is made. The functions of `fs.c` that take one also
// take its length, and fail with EINVAL when the bytes hold a NUL of their
// own, which C would read as the end.
forall C, S where ReadBytes[C, S], Copy[S].
fn c_string(&cx: C, bytes: S) -> Buffer! {
    Buffer!::new().push_bytes(&cx, bytes).push_byte(0u8)
}

// An I/O error: the `errno` of the system call that failed, or EIO (5)
// for a failure the system did not report itself (a `write` that made no
// progress). Every fallible function here reports one.
exposed struct Error {
    errno: i32,
}

impl Error {
    // The error a negative return of an `fs.c` call stands for.
    fn of_return(n: isize) -> Error {
        Error.{ errno: 0i32 - (n as i32) }
    }

    fn io() -> Error {
        Error.{ errno: 5i32 }
    }
}

// -------------------------------------------------------------- output --
// `write_all` retries partial writes (`write(2)` may write fewer bytes
// than requested, even to a regular file) until every byte is written. It
// fails with the call's errno on a negative return, and with EIO on zero
// progress (`write` returning 0, which POSIX permits and which would
// otherwise loop forever). Every output function returns the result; a
// caller that prints to its own stdout or stderr and has no recovery
// discards it, while a program whose output is its product checks it.

unsafe fn write_all(fd: i32, ptr: *u8, len: usize) -> Result[(), Error] {
    var done = 0usize;
    while done < len {
        let n = unsafe kur_libc_fs_write(fd, unsafe offset(ptr, done), len - done);
        if n < 0isize {
            return Result::Err.(Error::of_return(n));
        }
        if n == 0isize {
            return Result::Err.(Error::io());
        }
        done = done + (n as usize);
    }
    Result::Ok.(())
}

// Writes a span's bytes, reading them under the domain's capability, which
// `cx` lends.
forall 'k, C, R where Access[C -> 'k, R].
fn write_span(fd: i32, &cx: C, sp: Span['k]) -> Result[(), Error] {
    let (tag, rest) = Access[C -> 'k, R]::open(cx);
    let (p, n) = sp.into_parts();
    let result = unsafe write_all(fd, p, n);
    cx = Access[C -> 'k, R]::close(tag, rest);
    result
}

// Prints any byte view, read through the capability that permits it
// (`Exclusive!`, `Shared!`, `StaticRead`).
forall C, S where ReadBytes[C, S], Copy[S].
fn print_bytes(fd: i32, &cx: C, bytes: S) -> Result[(), Error] {
    let buffer = Buffer!::new().push_bytes(&cx, bytes);
    print_buffer(fd, buffer)
}

fn print(fd: i32, s: Slice[u8, 'static]) -> Result[(), Error] {
    let (p, n, m) = s.into_parts();
    unsafe write_all(fd, p, n)
}

// Writes `buf`'s bytes, then frees it. Reads them through `as_ptr`/`len`;
// printing needs no brand.
fn print_buffer(fd: i32, buf: Buffer!) -> Result[(), Error] {
    let p = unsafe &buf.as_ptr();
    let n = &buf.len();
    let result = unsafe write_all(fd, p, n);
    buf.destroy();
    result
}

// ---------------------------------------------------------------- files --

// Fills `buf[0..size)` from `fd`, retrying short reads (`read(2)` may
// return fewer bytes than requested, even for a regular file). Returns the
// total filled: `size`, or less when the input ends first (a read returns
// 0, e.g. because the file shrank), so `buf[0..n)` holds the bytes read.
// A failed read is the error, never a short count, even when some bytes
// were filled before it. Caller: `buf[0..size)` is writable, and `fd` is a
// descriptor the caller may read (stdin, or one a `File!` it holds owns).
unsafe fn read_exact(fd: i32, buf: *u8, size: usize) -> Result[usize, Error] {
    var done = 0usize;
    while done < size {
        let n = unsafe kur_libc_fs_read(fd, unsafe offset(buf, done), size - done);
        if n < 0isize {
            return Result::Err.(Error::of_return(n));
        }
        if n == 0isize {
            return Result::Ok.(done);
        }
        done = done + (n as usize);
    }
    Result::Ok.(done)
}

// Reads `fd` to EOF, 4096 bytes at a time, appending to `b` and returning
// it. A read error frees what was read and is returned: it never looks like
// the end of the input. Caller: `fd` is a descriptor the caller may read,
// as for `read_exact`.
unsafe fn read_to_end_from(fd: i32, b: Buffer!) -> Result[Buffer!, Error] {
    let chunk = 4096usize;
    var b = b;
    while true {
        let w = b.writer(chunk);
        let (dest, avail) = unsafe &w.writable_tail();
        let n = unsafe kur_libc_fs_read(fd, dest, chunk);
        if n == 0isize {
            return Result::Ok.(w.finish());
        }
        if n < 0isize {
            w.finish().destroy();
            return Result::Err.(Error::of_return(n));
        }
        // `commit_external` obligation: `dest` is `w.writable_tail()`'s
        // pointer after `b.writer(chunk)`, and a successful read returning
        // `n` wrote exactly `dest[0..n)`, with `n <= chunk`. `n <= 0` has
        // been ruled out, so the cast cannot turn an error into a length.
        b = unsafe w.commit_external(n as usize);
    }
    Result::Ok.(b)
}

fn read_all_stdin() -> Result[Buffer!, Error] {
    // Standard input is the process's own, readable by any of its code.
    unsafe read_to_end_from(0i32, Buffer!::new())
}

// One line of stdin, without its newline: reads through the next newline
// or to the end of input, one byte at a time so nothing past the line is
// consumed. `None` at the end of input, when no byte is left to read; an
// empty line is `Some` of an empty buffer, and a last line with no newline
// is still a line.
fn read_line() -> Result[Option[Buffer!], Error] {
    var b = Buffer!::new();
    var any = false;
    while true {
        let w = b.writer(1usize);
        let (dest, avail) = unsafe &w.writable_tail();
        let n = unsafe kur_libc_fs_read(0i32, dest, 1usize);
        if n < 0isize {
            w.finish().destroy();
            return Result::Err.(Error::of_return(n));
        }
        if n == 0isize {
            let line = w.finish();
            if any {
                return Result::Ok.(Option::Some.(line));
            }
            line.destroy();
            return Result::Ok.(Option::None);
        }
        if unsafe *dest == b'\n' {
            return Result::Ok.(Option::Some.(w.finish()));
        }
        // `read` returned 1, so it wrote `dest[0]`, inside the one-byte
        // tail `writer(1)` reserved.
        b = unsafe w.commit_external(1usize);
        any = true;
    }
    Result::Ok.(Option::Some.(b))
}

// ----------------------------------------------------------- File! --
// An owner of exactly one open descriptor, with one terminal operation,
// `close`. `File!` is restricted so that a safe constructor never accepts
// an arbitrary integer and later reads, writes or closes it: without that,
// safe code could build `File! { fd: 3 }` over a descriptor it never opened
// and close whatever the process holds at that number. A `File!` comes
// only from `open_read` and `create`, which open a fresh descriptor, or
// from `unsafe adopt`. No safe function here takes a bare descriptor to
// read or close.
//
// Standard input, output and error stay bare `i32`s (0/1/2), never
// `File!`: they are borrowed process handles this program did not open
// and must not close. The output functions above take a bare `fd` for the
// same reason.
struct File! {
    fd: i32,
}

impl File! {
    // Opens the file at `path`, any byte view read through `cx`,
    // read-only. Safe: the descriptor it wraps is always one this call
    // opened. Fails with the errno of `open(2)`, or EINVAL for a path
    // holding a NUL.
    forall C, S where ReadBytes[C, S], Copy[S].
    fn open_read(&cx: C, path: S) -> Result[File!, Error] {
        var text = c_string(&cx, path);
        let p = unsafe &text.as_ptr();
        // `p` holds the path's `len` bytes and a NUL.
        let fd = unsafe kur_libc_fs_open_read(p, ReadBytes[C, S]::len(&cx, path));
        text.destroy();
        if fd < 0i32 {
            Result::Err.(Error.{ errno: 0i32 - fd })
        } else {
            Result::Ok.(File!.{ fd })
        }
    }

    // Creates the file at `path`, or empties it, and opens it for writing;
    // a new file gets mode 0644 less the umask. Fails as `open_read` does.
    forall C, S where ReadBytes[C, S], Copy[S].
    fn create(&cx: C, path: S) -> Result[File!, Error] {
        var text = c_string(&cx, path);
        let p = unsafe &text.as_ptr();
        let fd = unsafe kur_libc_fs_create(p, ReadBytes[C, S]::len(&cx, path));
        text.destroy();
        if fd < 0i32 {
            Result::Err.(Error.{ errno: 0i32 - fd })
        } else {
            Result::Ok.(File!.{ fd })
        }
    }

    // Wraps an already-open descriptor obtained elsewhere as an owning
    // `File!`. Caller: `fd` is live and open with no other owner, and this
    // `File!`'s `close` is the program's only remaining use of it -- the
    // `HeapAllocator::adopt_raw` obligation, for descriptors.
    unsafe fn adopt(fd: i32) -> File! {
        File!.{ fd }
    }

    // The terminal operation: the checker requires every `File!` to reach
    // `close`. The `File!` is consumed even when `close(2)` fails, which is
    // reported with its errno.
    fn close(self) -> Result[(), Error] {
        let { fd } = self;
        let status = unsafe kur_libc_fs_close(fd);
        if status != 0i32 {
            Result::Err.(Error.{ errno: status })
        } else {
            Result::Ok.(())
        }
    }

    // The byte size of a regular file, from `fstat(2)`. Anything else is an
    // error: EISDIR for a directory, EINVAL for a pipe, device or socket,
    // whose size says nothing about what a read will return.
    fn file_size(&self) -> Result[usize, Error] {
        let { fd } = self;
        let size = unsafe kur_libc_fs_regular_size(fd);
        self = File!.{ fd };
        if size < 0isize {
            Result::Err.(Error::of_return(size))
        } else {
            Result::Ok.(size as usize)
        }
    }

    // Fills `buf[0..size)` from the descriptor's offset, as the free
    // `read_exact`: how many bytes it filled, fewer only at the end of the
    // file, or the error of a failed read. Caller: `buf[0..size)` is
    // writable for the duration of the call.
    unsafe fn read_exact(&self, buf: *u8, size: usize) -> Result[usize, Error] {
        let { fd } = self;
        let got = unsafe read_exact(fd, buf, size);
        self = File!.{ fd };
        got
    }

    forall 'k.
    fn write_all(&self, tag: Exclusive!['k], bytes: Slice[u8, 'k]) -> (Exclusive!['k], Result[(), Error]) {
        let { fd } = self;
        let (ptr, len, marker) = bytes.into_parts();
        let result = unsafe write_all(fd, ptr, len);
        self = File!.{ fd };
        (tag, result)
    }

    // Writes all of a span's bytes, read under its domain's capability,
    // which `cx` lends.
    forall 'k, C, R where Access[C -> 'k, R].
    fn write_span(&self, &cx: C, bytes: Span['k]) -> Result[(), Error] {
        let (tag, rest) = Access[C -> 'k, R]::open(cx);
        let { fd } = self;
        let (ptr, len) = bytes.into_parts();
        let result = unsafe write_all(fd, ptr, len);
        self = File!.{ fd };
        cx = Access[C -> 'k, R]::close(tag, rest);
        result
    }

    fn write_static(&self, bytes: Slice[u8, 'static]) -> Result[(), Error] {
        let { fd } = self;
        let (ptr, len, marker) = bytes.into_parts();
        let result = unsafe write_all(fd, ptr, len);
        self = File!.{ fd };
        result
    }

    // Writes all of `buf`, then frees it.
    fn write_buffer(&self, buf: Buffer!) -> Result[(), Error] {
        let exists 'b. (tag, bytes, restore) = buf.open();
        let (tag, result) = &self.write_all(tag, bytes);
        restore.restore(tag).destroy();
        result
    }

    // Writes `ptr[0..len)`, for producers that hold a raw pointer and
    // length. Caller: the entire range is readable.
    unsafe fn write_all_raw(&self, ptr: *u8, len: usize) -> Result[(), Error] {
        let { fd } = self;
        let result = unsafe write_all(fd, ptr, len);
        self = File!.{ fd };
        result
    }

    // Reads from the descriptor's offset to EOF into a fresh `Buffer!`,
    // for files whose size is not known ahead, such as pipes and `/proc`.
    // A read error is returned, not taken for the end. Does not close
    // `self`.
    fn read_to_end(&self) -> Result[Buffer!, Error] {
        let { fd } = self;
        // `fd` is the descriptor this `File!` owns.
        let b = unsafe read_to_end_from(fd, Buffer!::new());
        self = File!.{ fd };
        b
    }

    // Reads a regular file from the descriptor's offset to EOF into a
    // fresh `Buffer!`, sized up front by `file_size`. Reading goes on to EOF
    // whatever the size said, so a file that grows or shrinks meanwhile is
    // read as it is. Fails as `file_size` does, so a directory is EISDIR.
    // Does not close `self`.
    fn read_to_buffer(&self) -> Result[Buffer!, Error] {
        match &self.file_size() {
            Result::Err(code) => Result::Err.(code),
            Result::Ok(size) => {
                let { fd } = self;
                // `fd` is the descriptor this `File!` owns.
                let b = unsafe read_to_end_from(fd, Buffer!::new_with_cap(size));
                self = File!.{ fd };
                b
            },
        }
    }
}

// ---------------------------------------------------------------------
// Buffered output: a writer for f-strings and the `core::fmt` protocol.
//
//     let done = f"{name}: {count}\n".write(stdout()).finish();
//
// Output collects bytes and writes them once 4 KiB have gathered, on
// `flush`, or on `finish`. Its error is sticky: once a write fails, the
// rest is dropped, and `finish` reports the first failure (`error` holds
// its errno, 0 until then).
struct Output! {
    fd: i32,
    buf: Buffer!,
    error: i32,
}

fn stdout() -> Output! {
    Output!.{ fd: 1i32, buf: Buffer!::new(), error: 0i32 }
}

fn stderr() -> Output! {
    Output!.{ fd: 2i32, buf: Buffer!::new(), error: 0i32 }
}

impl Output! {
    // Writes what has gathered so far.
    fn flush(self) -> Output! {
        let { fd, buf, error } = self;
        let n = &buf.len();
        if n == 0usize || error != 0i32 {
            let unit = buf.destroy();
            return Output!.{ fd, buf: Buffer!::new(), error };
        }
        let p = unsafe &buf.as_ptr();
        // `p` addresses the `n` bytes `buf` holds, and `buf` outlives the write.
        let written = unsafe write_all(fd, p, n);
        let unit = buf.destroy();
        let error = match written {
            Result::Ok(nothing) => 0i32,
            Result::Err(e) => e.errno,
        };
        Output!.{ fd, buf: Buffer!::new(), error }
    }

    // Writes what is left and reports the first failure, if any.
    fn finish(self) -> Result[(), Error] {
        let { fd, buf, error } = self.flush();
        let unit = buf.destroy();
        if error == 0i32 {
            Result::Ok.(())
        } else {
            Result::Err.(Error.{ errno: error })
        }
    }

    fn gathered(self) -> Output! {
        let { fd, buf, error } = self;
        let n = &buf.len();
        let out = Output!.{ fd, buf, error };
        if n >= 4096usize { out.flush() } else { out }
    }
}

instance Writable[Output!] {
    fn write_byte(self: Output!, byte: u8) -> Output! {
        let { fd, buf, error } = self;
        Output!.{ fd, buf: buf.push_byte(byte), error }.gathered()
    }
    fn write_static(self: Output!, bytes: Slice[u8, 'static]) -> Output! {
        let { fd, buf, error } = self;
        Output!.{ fd, buf: buf.push_static(bytes), error }.gathered()
    }
    unsafe fn write_raw(self: Output!, ptr: *u8, len: usize) -> Output! {
        let { fd, buf, error } = self;
        Output!.{ fd, buf: unsafe buf.push_n(ptr, len), error }.gathered()
    }
}
