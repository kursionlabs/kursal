//! Input and output through the standard streams and files.
//!
//! Process I/O over the POSIX `read`/`write`/`open`/`close`/`fstat` calls:
//! byte output to standard output (`print`) and standard error (`eprint`),
//! whole-file and stdin reads into an owned `Buffer!`, the owning
//! descriptor type `File!`, buffered `Output!`, and `Input!`, the buffered
//! reader of standard input;
//! and `Error`, the error of every operating-system call of the library.
//! Paths are any byte view (`c_string`); `std::fs` works with them whole.

use package as std;

use alloc::buffer::Buffer!;
use core::raw::Span;
use core::ptr::offset;
use core::slice::{Slice, ReadBytes};
use core::fmt::{Format, Writable, write_i64};
use core::option::{Option, Result};
use core::cap::{Access, Exclusive!};
// The system calls: a read or write a signal interrupts is made again,
// descriptors are opened close-on-exec, and a failure is an errno.
use libc::io::{kur_libc_fs_read, kur_libc_fs_write, kur_libc_fs_open_read, kur_libc_fs_create, kur_libc_fs_close,
    kur_libc_fs_regular_size, kur_libc_fs_size_hint, kur_libc_stdin_claim, kur_libc_stdin_release, kur_libc_error_kind,
    kur_libc_error_message};

/// A path, name or argument for C: the bytes of a view, read through the
/// capability that permits it, followed by a NUL, in a buffer the caller
/// frees once the call is made. The C functions (`libc`) that take one also
/// take its length, and fail with EINVAL when the bytes hold a NUL of their
/// own, which C would read as the end.
forall C, S where ReadBytes[C, S], Copy[S].
fn c_string(&cx: C, bytes: S) -> Buffer! {
    Buffer!::new().push_bytes(&cx, bytes).push_byte(0u8)
}

/// An I/O error: the `errno` of the system call that failed, or EIO (5)
/// for a failure the system did not report itself (a `write` that made no
/// progress). Every fallible function here reports one. It describes itself
/// (`message`), says what kind of failure it is (`kind`), and formats as
/// its description and its number, `No such file or directory (error 2)`,
/// so `f"cannot read {path}: {e}\n"` reports it.
exposed struct Error {
    errno: i32,
}

/// What kind of failure an `Error` is, for code that handles some kinds:
/// the errnos a portable program tells apart, whatever their numbers on
/// the host. `Other` is every other errno; `errno` still tells them apart.
exposed enum ErrorKind {
    // ENOENT: no such file or directory.
    NotFound,
    // EACCES or EPERM.
    PermissionDenied,
    // EEXIST.
    AlreadyExists,
    // EISDIR: a directory where a file was wanted.
    IsADirectory,
    // ENOTDIR: a file where a directory was wanted, in a path.
    NotADirectory,
    // ENOTEMPTY: removing a directory that holds something.
    DirectoryNotEmpty,
    // EINVAL: an argument the call does not take, such as a path holding a NUL.
    InvalidInput,
    // EPIPE: writing to a pipe nothing reads any more.
    BrokenPipe,
    // EINTR: a signal interrupted the call.
    Interrupted,
    // EAGAIN or EWOULDBLOCK: the call would have had to wait.
    WouldBlock,
    // ETIMEDOUT.
    TimedOut,
    // EBUSY: in use, such as standard input held by an `Input!`.
    Busy,
    // ENOSPC: no space left on the device.
    StorageFull,
    // ENOMEM.
    OutOfMemory,
    // ENOSYS or ENOTSUP: the host does not do it.
    Unsupported,
    // Any other errno.
    Other,
}

impl Error {
    /// The error a negative return of a C function (`libc`) stands for.
    fn of_return(n: isize) -> Error {
        Error.{ errno: 0i32 - (n as i32) }
    }

    /// EIO, for a failure the system did not report itself.
    fn io() -> Error {
        Error.{ errno: 5i32 }
    }

    /// The kind of failure, from the errno: the C runtime sorts the host's
    /// numbers into the kinds.
    fn kind(self) -> ErrorKind {
        let k = unsafe kur_libc_error_kind(self.errno);
        if k == 1i32 {
            ErrorKind::NotFound
        } else if k == 2i32 {
            ErrorKind::PermissionDenied
        } else if k == 3i32 {
            ErrorKind::AlreadyExists
        } else if k == 4i32 {
            ErrorKind::IsADirectory
        } else if k == 5i32 {
            ErrorKind::NotADirectory
        } else if k == 6i32 {
            ErrorKind::DirectoryNotEmpty
        } else if k == 7i32 {
            ErrorKind::InvalidInput
        } else if k == 8i32 {
            ErrorKind::BrokenPipe
        } else if k == 9i32 {
            ErrorKind::Interrupted
        } else if k == 10i32 {
            ErrorKind::WouldBlock
        } else if k == 11i32 {
            ErrorKind::TimedOut
        } else if k == 12i32 {
            ErrorKind::Busy
        } else if k == 13i32 {
            ErrorKind::StorageFull
        } else if k == 14i32 {
            ErrorKind::OutOfMemory
        } else if k == 15i32 {
            ErrorKind::Unsupported
        } else {
            ErrorKind::Other
        }
    }

    /// The C library's description of the errno, as `strerror` gives it
    /// (`No such file or directory`), read thread-safely (`strerror_r`).
    fn message(self) -> Buffer! {
        var text = Buffer!::new_with_cap(128usize);
        let room = &text.remaining_capacity();
        let dest = unsafe &text.tail_ptr();
        // `dest[0..room)` is the room `text` has; the call writes at most
        // `room` bytes there and says how many.
        let n = unsafe kur_libc_error_message(self.errno, dest, room);
        unsafe text.commit(n)
    }
}

/// An error formats as its description and its errno:
/// `No such file or directory (error 2)`.
forall W where Writable[W].
instance Format[Error, W] {
    fn format(value: Error, out: W) -> (Error, W) {
        let text = value.message();
        let p = unsafe &text.as_ptr();
        let n = &text.len();
        // `p` addresses the `n` bytes `text` holds until it is freed below.
        let out = unsafe Writable[W]::write_raw(out, p, n);
        text.destroy();
        let out = write_i64(Writable[W]::write_static(out, " (error "), value.errno as i64);
        (value, Writable[W]::write_static(out, ")"))
    }
}

// -------------------------------------------------------------- output --
// Output goes to standard output (`print`), standard error (`eprint`), a
// `File!` (its `write_*` methods) or a buffered `Output!` over one of the
// two streams. No safe function takes a descriptor number: a number could
// name a descriptor a `File!` owns, or one closed and reused, and writing
// to it would go around the `File!` that owns it.
//
// `write_all` retries partial writes (`write(2)` may write fewer bytes
// than requested, even to a regular file) until every byte is written. It
// fails with the call's errno on a negative return, and with EIO on zero
// progress (`write` returning 0, which POSIX permits and which would
// otherwise loop forever). Every output function returns the result; a
// caller that prints to its own stdout or stderr and has no recovery
// discards it, while a program whose output is its product checks it.
// Writing to a closed pipe is such a failure (EPIPE), not the end of the
// process: the C `main` the compiler writes for an executable ignores
// SIGPIPE.

/// Writes `ptr[0..len)` to `fd`, retrying partial writes. Caller:
/// `ptr[0..len)` is readable, and `fd` is a descriptor the caller may write:
/// standard output or error, or one a `File!` it holds owns.
unsafe fn write_all(fd: i32, ptr: *u8, len: usize) -> Result[(), Error] {
    var done = 0usize;
    while done < len {
        let n = unsafe kur_libc_fs_write(fd, unsafe offset(ptr, done), len - done);
        if n < 0isize {
            return Result::Err.(Error::of_return(n));
        }
        if n == 0isize {
            return Result::Err.(Error::io());
        }
        done = done + (n as usize);
    }
    Result::Ok.(())
}

/// Writes a static byte slice to `fd`. Caller: `fd` is a descriptor the
/// caller may write, as for `write_all`.
unsafe fn write_static_to(fd: i32, s: Slice[u8, 'static]) -> Result[(), Error] {
    let (p, n, m) = s.into_parts();
    unsafe write_all(fd, p, n)
}

/// Writes a span's bytes to `fd`, reading them under the domain's
/// capability, which `cx` lends. Caller: `fd` is a descriptor the caller
/// may write, as for `write_all`.
forall 'k, C, R where Access[C -> 'k, R].
unsafe fn write_span_to(fd: i32, &cx: C, sp: Span['k]) -> Result[(), Error] {
    let (tag, rest) = Access[C -> 'k, R]::open(cx);
    let (p, n) = sp.into_parts();
    let result = unsafe write_all(fd, p, n);
    cx = Access[C -> 'k, R]::close(tag, rest);
    result
}

/// Writes `buf`'s bytes to `fd`, then frees it. Reads them through
/// `as_ptr`/`len`; writing needs no brand. Caller: `fd` is a descriptor the
/// caller may write, as for `write_all`.
unsafe fn write_buffer_to(fd: i32, buf: Buffer!) -> Result[(), Error] {
    let p = unsafe &buf.as_ptr();
    let n = &buf.len();
    let result = unsafe write_all(fd, p, n);
    buf.destroy();
    result
}

// `print` writes to standard output (descriptor 1), `eprint` to standard
// error (descriptor 2): the process's own streams, which any of its code
// may write.

/// Writes a static byte slice to standard output. Returns an I/O error on failure.
fn print(s: Slice[u8, 'static]) -> Result[(), Error] {
    unsafe write_static_to(1i32, s)
}

/// Writes any byte view to standard output, read through the capability
/// that permits it (`Exclusive!`, `Shared!`, `StaticRead`).
forall C, S where ReadBytes[C, S], Copy[S].
fn print_bytes(&cx: C, bytes: S) -> Result[(), Error] {
    unsafe write_buffer_to(1i32, Buffer!::new().push_bytes(&cx, bytes))
}

/// Writes a span's bytes to standard output where they lie, reading them
/// under the domain's capability, which `cx` lends.
forall 'k, C, R where Access[C -> 'k, R].
fn print_span(&cx: C, sp: Span['k]) -> Result[(), Error] {
    unsafe write_span_to(1i32, &cx, sp)
}

/// Writes `buf`'s bytes to standard output, then frees it.
fn print_buffer(buf: Buffer!) -> Result[(), Error] {
    unsafe write_buffer_to(1i32, buf)
}

/// Writes a static byte slice to standard error.
fn eprint(s: Slice[u8, 'static]) -> Result[(), Error] {
    unsafe write_static_to(2i32, s)
}

/// Writes any byte view to standard error.
forall C, S where ReadBytes[C, S], Copy[S].
fn eprint_bytes(&cx: C, bytes: S) -> Result[(), Error] {
    unsafe write_buffer_to(2i32, Buffer!::new().push_bytes(&cx, bytes))
}

/// Writes a span's bytes to standard error where they lie.
forall 'k, C, R where Access[C -> 'k, R].
fn eprint_span(&cx: C, sp: Span['k]) -> Result[(), Error] {
    unsafe write_span_to(2i32, &cx, sp)
}

/// Writes `buf`'s bytes to standard error, then frees it.
fn eprint_buffer(buf: Buffer!) -> Result[(), Error] {
    unsafe write_buffer_to(2i32, buf)
}

// ---------------------------------------------------------------- files --

/// Reads at most `max` bytes from `fd`, with one `read(2)`, appending them
/// to `buf`: how many, which is 0 at the end of the input (and for a `max`
/// of 0, which reads nothing). Fewer than `max` is no sign of the end: a
/// pipe gives what it has. The error of a failed read, with `buf` as it
/// was. Caller: `fd` is a descriptor the caller may read: stdin, or one a
/// `File!` it holds owns.
unsafe fn read_into(fd: i32, &buf: Buffer!, max: usize) -> Result[usize, Error] {
    if max == 0usize {
        return Result::Ok.(0usize);
    }
    buf = buf.reserve(max);
    let dest = unsafe &buf.tail_ptr();
    let n = unsafe kur_libc_fs_read(fd, dest, max);
    if n < 0isize {
        return Result::Err.(Error::of_return(n));
    }
    // A successful read returning `n` wrote exactly `dest[0..n)`, with
    // `n <= max`, inside the room `reserve` made. `n < 0` has been ruled
    // out, so the cast cannot turn an error into a length.
    buf = unsafe buf.commit(n as usize);
    Result::Ok.(n as usize)
}

/// Reads `fd` to EOF, appending to `b` and returning it. Each read fills
/// the room `b` has, and a full `b` grows first, by at least 4096 bytes and
/// at least doubling, so a `b` made with room for all the input and one
/// byte more reads it without growing. A read error frees what was read and
/// is returned: it never looks like the end of the input. Caller: `fd` is a
/// descriptor the caller may read, as for `read_into`.
unsafe fn read_to_end_from(fd: i32, b: Buffer!) -> Result[Buffer!, Error] {
    var b = b;
    while true {
        let room = &b.remaining_capacity();
        match unsafe read_into(fd, &b, if room == 0usize { 4096usize } else { room }) {
            Ok(n) => if n == 0usize {
                return Result::Ok.(b);
            },
            Err(e) => {
                b.destroy();
                return Result::Err.(e);
            },
        }
    }
    Result::Ok.(b)
}

// ------------------------------------------------------- standard input --
// Standard input is read through an `Input!`, which reads ahead into a
// buffer and returns lines from it, or through `read_all_stdin` and
// `read_line`. Bytes an `Input!` has read ahead are its own: another reader
// of standard input would skip them. So one reader at a time holds
// standard input, by a flag io.c keeps (`kur_libc_stdin_claim`): `stdin`
// fails with EBUSY while an `Input!` holds it, and so do `read_all_stdin`
// and `read_line`, which hold it for the length of the call. `finish`
// gives it back, with the bytes read ahead and not yet returned. Code that
// reads standard input without these (a C library, a child process
// `std::process` starts) does not see the bytes an `Input!` has read ahead.

/// The buffered reader of standard input: lines (`read_line`) and the rest
/// (`read_to_end`), read 64 KiB at a time. The one reader of standard input
/// while it lives (see `stdin`). Call `finish` to give it back.
struct Input! {
    // what standard input gave and has not been returned yet: `buf[start..)`
    buf: Buffer!,
    start: usize,
}

/// Standard input, held by the `Input!` returned until its `finish`, or
/// EBUSY while another `Input!` holds it.
fn stdin() -> Result[Input!, Error] {
    let claimed = unsafe kur_libc_stdin_claim();
    if claimed != 0i32 {
        Result::Err.(Error.{ errno: claimed })
    } else {
        Result::Ok.(Input!.{ buf: Buffer!::new_with_cap(65536usize), start: 0usize })
    }
}

impl Input! {
    /// The next line, without its newline, as the free `read_line` reads
    /// it: `None` at the end of input, when no byte is left to read; an
    /// empty line is `Some` of an empty buffer, and a last line with no
    /// newline is still a line. A read error is returned, and the bytes of
    /// the line read before it are lost with it.
    fn read_line(&self) -> Result[Option[Buffer!], Error] {
        let { buf, start } = self;
        var buf = buf;
        var start = start;
        var line = Buffer!::new();
        while true {
            let n = &buf.len();
            let p = unsafe &buf.as_ptr();
            // `p[0..n)` are the bytes `buf` holds, unchanged until `buf`
            // is pushed to or freed.
            var end = start;
            while end < n && unsafe *(unsafe offset(p, end)) != b'\n' {
                end = end + 1usize;
            }
            line = unsafe line.push_n(unsafe offset(p, start), end - start);
            if end < n {
                self = Input!.{ buf, start: end + 1usize };
                return Result::Ok.(Option::Some.(line));
            }
            // Every byte read ahead is in `line`: read more into the room.
            start = 0usize;
            buf = buf.clear();
            let room = &buf.remaining_capacity();
            // Standard input is the process's own, and this `Input!` holds it.
            match unsafe read_into(0i32, &buf, room) {
                Err(e) => {
                    self = Input!.{ buf, start };
                    line.destroy();
                    return Result::Err.(e);
                },
                Ok(got) => if got == 0usize {
                    self = Input!.{ buf, start };
                    if &line.len() > 0usize {
                        return Result::Ok.(Option::Some.(line));
                    }
                    line.destroy();
                    return Result::Ok.(Option::None);
                },
            }
        }
        self = Input!.{ buf, start };
        Result::Ok.(Option::Some.(line))
    }

    /// The rest of standard input, read to its end, the bytes read ahead
    /// first. A read error is returned, and what was read is lost with it.
    fn read_to_end(&self) -> Result[Buffer!, Error] {
        let { buf, start } = self;
        let rest = rest_of(buf, start);
        // Standard input is the process's own, and this `Input!` holds it.
        let all = unsafe read_to_end_from(0i32, rest);
        self = Input!.{ buf: Buffer!::new_with_cap(65536usize), start: 0usize };
        all
    }

    /// Gives standard input back, for the next `stdin`, `read_line` or
    /// `read_all_stdin`: the bytes read ahead and not returned yet, which
    /// the next reader of standard input does not see.
    fn finish(self) -> Buffer! {
        let { buf, start } = self;
        unsafe kur_libc_stdin_release();
        rest_of(buf, start)
    }
}

/// `buf[start..)` in a buffer of its own; `buf` is freed.
fn rest_of(buf: Buffer!, start: usize) -> Buffer! {
    let n = &buf.len();
    let p = unsafe &buf.as_ptr();
    // `p[start..n)` are bytes `buf` holds, and `buf` is freed after the copy.
    let rest = unsafe Buffer!::new_with_cap(n - start).push_n(unsafe offset(p, start), n - start);
    buf.destroy();
    rest
}

/// All of standard input, read to its end: what `Input!::read_to_end`
/// reads from a new `Input!`. Fails with EBUSY while an `Input!` holds
/// standard input.
fn read_all_stdin() -> Result[Buffer!, Error] {
    match stdin() {
        Err(e) => Result::Err.(e),
        Ok(input) => {
            var input = input;
            let all = &input.read_to_end();
            input.finish().destroy();
            all
        },
    }
}

/// One line of stdin, without its newline: reads through the next newline
/// or to the end of input. `None` at the end of input, when no byte is left
/// to read; an empty line is `Some` of an empty buffer, and a last line
/// with no newline is still a line.
///
/// It reads one byte at a time, a system call for each, so that nothing
/// past the line is consumed: what follows is left for whatever reads
/// standard input next, such as a program `std::process` starts. To read
/// many lines, read them through an `Input!` (`stdin`), which reads ahead.
/// Fails with EBUSY while an `Input!` holds standard input, since the line
/// would skip the bytes it has read ahead.
fn read_line() -> Result[Option[Buffer!], Error] {
    let claimed = unsafe kur_libc_stdin_claim();
    if claimed != 0i32 {
        return Result::Err.(Error.{ errno: claimed });
    }
    let line = read_line_unbuffered();
    unsafe kur_libc_stdin_release();
    line
}

/// `read_line`, holding standard input.
fn read_line_unbuffered() -> Result[Option[Buffer!], Error] {
    var b = Buffer!::new();
    var any = false;
    while true {
        b = b.reserve(1usize);
        let dest = unsafe &b.tail_ptr();
        let n = unsafe kur_libc_fs_read(0i32, dest, 1usize);
        if n < 0isize {
            b.destroy();
            return Result::Err.(Error::of_return(n));
        }
        if n == 0isize {
            if any {
                return Result::Ok.(Option::Some.(b));
            }
            b.destroy();
            return Result::Ok.(Option::None);
        }
        if unsafe *dest == b'\n' {
            return Result::Ok.(Option::Some.(b));
        }
        // `read` returned 1, so it wrote `dest[0]`, inside the byte
        // `reserve` made room for.
        b = unsafe b.commit(1usize);
        any = true;
    }
    Result::Ok.(Option::Some.(b))
}

// ----------------------------------------------------------- File! --
// An owner of exactly one open descriptor, with one terminal operation,
// `close`. `File!` is restricted so that a safe constructor never accepts
// an arbitrary integer and later reads, writes or closes it: without that,
// safe code could build `File! { fd: 3 }` over a descriptor it never opened
// and close whatever the process holds at that number. A `File!` comes
// only from `open_read` and `create`, which open a fresh descriptor, or
// from `unsafe adopt`. No safe function here takes a bare descriptor to
// read or close.
//
// Standard input, output and error stay bare `i32`s (0/1/2), never
// `File!`: they are borrowed process handles this program did not open
// and must not close. Only this module names them, in `print`, `eprint`,
// `Input!`, `read_line` and `Output!`. A `File!` never gets one of
// their numbers: the C `main` the compiler writes for an executable opens
// /dev/null on each of the three the process started without, before the
// program runs.
/// Owns one open file descriptor. Call `close` to consume it.
struct File! {
    fd: i32,
}

impl File! {
    /// Opens the file at `path`, any byte view read through `cx`,
    /// read-only. Safe: the descriptor it wraps is always one this call
    /// opened. Fails with the errno of `open(2)`, or EINVAL for a path
    /// holding a NUL.
    forall C, S where ReadBytes[C, S], Copy[S].
    fn open_read(&cx: C, path: S) -> Result[File!, Error] {
        var text = c_string(&cx, path);
        let p = unsafe &text.as_ptr();
        // `p` holds the path's `len` bytes and a NUL.
        let fd = unsafe kur_libc_fs_open_read(p, ReadBytes[C, S]::len(&cx, path));
        text.destroy();
        if fd < 0i32 {
            Result::Err.(Error.{ errno: 0i32 - fd })
        } else {
            Result::Ok.(File!.{ fd })
        }
    }

    /// Creates the file at `path`, or empties it, and opens it for writing;
    /// a new file gets mode 0644 less the umask. Fails as `open_read` does.
    forall C, S where ReadBytes[C, S], Copy[S].
    fn create(&cx: C, path: S) -> Result[File!, Error] {
        var text = c_string(&cx, path);
        let p = unsafe &text.as_ptr();
        let fd = unsafe kur_libc_fs_create(p, ReadBytes[C, S]::len(&cx, path));
        text.destroy();
        if fd < 0i32 {
            Result::Err.(Error.{ errno: 0i32 - fd })
        } else {
            Result::Ok.(File!.{ fd })
        }
    }

    /// Wraps an already-open descriptor obtained elsewhere as an owning
    /// `File!`. Caller: `fd` is live and open with no other owner, and this
    /// `File!`'s `close` is the program's only remaining use of it -- the
    /// `HeapAllocator::adopt_raw` obligation, for descriptors.
    unsafe fn adopt(fd: i32) -> File! {
        File!.{ fd }
    }

    /// Closes the descriptor.
    ///
    /// The terminal operation: the checker requires every `File!` to reach
    /// `close`. The `File!` is consumed even when `close(2)` fails, which is
    /// reported with its errno.
    fn close(self) -> Result[(), Error] {
        let { fd } = self;
        let status = unsafe kur_libc_fs_close(fd);
        if status != 0i32 {
            Result::Err.(Error.{ errno: status })
        } else {
            Result::Ok.(())
        }
    }

    /// The byte size of a regular file, from `fstat(2)`. Anything else is an
    /// error: EISDIR for a directory, EINVAL for a pipe, device or socket,
    /// whose size says nothing about what a read will return.
    fn file_size(&self) -> Result[usize, Error] {
        let { fd } = self;
        let size = unsafe kur_libc_fs_regular_size(fd);
        self = File!.{ fd };
        if size < 0isize {
            Result::Err.(Error::of_return(size))
        } else {
            Result::Ok.(size as usize)
        }
    }

    /// Reads at most `max` bytes from the descriptor's offset, with one
    /// `read(2)`, appending them to `buf`: how many, which is 0 at the end of
    /// the file. Fewer than `max` is no sign of the end (a pipe gives what it
    /// has); read in chunks until it returns 0. A failed read is the error,
    /// with `buf` as it was.
    fn read(&self, &buf: Buffer!, max: usize) -> Result[usize, Error] {
        let { fd } = self;
        // `fd` is the descriptor this `File!` owns.
        let got = unsafe read_into(fd, &buf, max);
        self = File!.{ fd };
        got
    }

    /// Reads `size` bytes from the descriptor's offset, appending them to
    /// `buf`, again after each short read: how many, which is fewer only at
    /// the end of the file. A failed read is the error, even when some bytes
    /// were appended before it; they stay in `buf`.
    fn read_exact(&self, &buf: Buffer!, size: usize) -> Result[usize, Error] {
        var done = 0usize;
        while done < size {
            match &self.read(&buf, size - done) {
                Ok(n) => if n == 0usize {
                    return Result::Ok.(done);
                } else {
                    done = done + n;
                },
                Err(e) => return Result::Err.(e),
            }
        }
        Result::Ok.(done)
    }

    /// The descriptor's number, for a C interface or another process (a
    /// `std::process::Stdio!::File` hands a child a copy). No safe function
    /// takes a number to read, write or close, so it grants nothing.
    fn descriptor(&self) -> i32 {
        let { fd } = self;
        self = File!.{ fd };
        fd
    }

    /// Writes all of `bytes`, read under `tag`, which comes back with the result.
    forall 'k.
    fn write_all(&self, tag: Exclusive!['k], bytes: Slice[u8, 'k]) -> (Exclusive!['k], Result[(), Error]) {
        let { fd } = self;
        let (ptr, len, marker) = bytes.into_parts();
        let result = unsafe write_all(fd, ptr, len);
        self = File!.{ fd };
        (tag, result)
    }

    /// Writes all of a span's bytes, read under its domain's capability,
    /// which `cx` lends.
    forall 'k, C, R where Access[C -> 'k, R].
    fn write_span(&self, &cx: C, bytes: Span['k]) -> Result[(), Error] {
        let (tag, rest) = Access[C -> 'k, R]::open(cx);
        let { fd } = self;
        let (ptr, len) = bytes.into_parts();
        let result = unsafe write_all(fd, ptr, len);
        self = File!.{ fd };
        cx = Access[C -> 'k, R]::close(tag, rest);
        result
    }

    /// Writes all of a static byte slice.
    fn write_static(&self, bytes: Slice[u8, 'static]) -> Result[(), Error] {
        let { fd } = self;
        let (ptr, len, marker) = bytes.into_parts();
        let result = unsafe write_all(fd, ptr, len);
        self = File!.{ fd };
        result
    }

    /// Writes all of `buf`, then frees it.
    fn write_buffer(&self, buf: Buffer!) -> Result[(), Error] {
        let exists 'b. (tag, bytes, restore) = buf.open();
        let (tag, result) = &self.write_all(tag, bytes);
        restore.restore(tag).destroy();
        result
    }

    /// Writes `ptr[0..len)`, for producers that hold a raw pointer and
    /// length. Caller: the entire range is readable.
    unsafe fn write_all_raw(&self, ptr: *u8, len: usize) -> Result[(), Error] {
        let { fd } = self;
        let result = unsafe write_all(fd, ptr, len);
        self = File!.{ fd };
        result
    }

    /// Reads from the descriptor's offset to EOF into a fresh `Buffer!`,
    /// which grows as it fills (`read_to_buffer` sizes it up front for a
    /// regular file). A read error is returned, not taken for the end. Does
    /// not close `self`.
    fn read_to_end(&self) -> Result[Buffer!, Error] {
        let { fd } = self;
        // `fd` is the descriptor this `File!` owns.
        let b = unsafe read_to_end_from(fd, Buffer!::new());
        self = File!.{ fd };
        b
    }

    /// Reads from the descriptor's offset to EOF into a fresh `Buffer!`, as
    /// `read_to_end` does, but sized up front for a regular file: by its
    /// size, so it is read without growing the buffer. Reading goes on to EOF
    /// whatever the size said, so a file that grows or shrinks meanwhile is
    /// read as it is; a pipe, a device or a socket, whose size says nothing,
    /// is read until it ends. A directory is EISDIR. Does not close `self`.
    fn read_to_buffer(&self) -> Result[Buffer!, Error] {
        let { fd } = self;
        let hint = unsafe kur_libc_fs_size_hint(fd);
        // `fd` is the descriptor this `File!` owns. The room past the size
        // is for the read that finds the end, or a pipe's first reads.
        let b = if hint < 0isize {
            Result::Err.(Error::of_return(hint))
        } else {
            unsafe read_to_end_from(fd, Buffer!::new_with_cap((hint as usize) + 4096usize))
        };
        self = File!.{ fd };
        b
    }
}

// ---------------------------------------------------------------------
// Buffered output: a writer for f-strings and the `core::fmt` protocol.
//
//     let done = f"{name}: {count}\n".write(stdout()).finish();
//
// Output collects bytes and writes them once 4 KiB have gathered, on
// `flush`, or on `finish`. Its error is sticky: once a write fails, the
// rest is dropped, and `finish` reports the first failure (`error` holds
// its errno, 0 until then).
/// Buffered output handle. Call `finish` to flush and consume it.
struct Output! {
    fd: i32,
    buf: Buffer!,
    error: i32,
}

/// A buffered writer for standard output.
fn stdout() -> Output! {
    Output!.{ fd: 1i32, buf: Buffer!::new(), error: 0i32 }
}

/// A buffered writer for standard error.
fn stderr() -> Output! {
    Output!.{ fd: 2i32, buf: Buffer!::new(), error: 0i32 }
}

impl Output! {
    /// Writes what has gathered so far.
    fn flush(self) -> Output! {
        let { fd, buf, error } = self;
        let n = &buf.len();
        if n == 0usize || error != 0i32 {
            let unit = buf.destroy();
            return Output!.{ fd, buf: Buffer!::new(), error };
        }
        let p = unsafe &buf.as_ptr();
        // `p` addresses the `n` bytes `buf` holds, and `buf` outlives the
        // write; `fd` is standard output or error, the only descriptors
        // `stdout` and `stderr` make an `Output!` over.
        let written = unsafe write_all(fd, p, n);
        let unit = buf.destroy();
        let error = match written {
            Ok(nothing) => 0i32,
            Err(e) => e.errno,
        };
        Output!.{ fd, buf: Buffer!::new(), error }
    }

    /// Writes what is left and reports the first failure, if any.
    fn finish(self) -> Result[(), Error] {
        let { fd, buf, error } = self.flush();
        let unit = buf.destroy();
        if error == 0i32 {
            Result::Ok.(())
        } else {
            Result::Err.(Error.{ errno: error })
        }
    }

    /// Writes what has gathered once it reaches 4 KiB.
    fn gathered(self) -> Output! {
        let { fd, buf, error } = self;
        let n = &buf.len();
        let out = Output!.{ fd, buf, error };
        if n >= 4096usize { out.flush() } else { out }
    }
}

/// Output as a writer: bytes gather and are written 4 KiB at a time.
instance Writable[Output!] {
    fn write_byte(self: Output!, byte: u8) -> Output! {
        let { fd, buf, error } = self;
        Output!.{ fd, buf: buf.push_byte(byte), error }.gathered()
    }
    fn write_static(self: Output!, bytes: Slice[u8, 'static]) -> Output! {
        let { fd, buf, error } = self;
        Output!.{ fd, buf: buf.push_static(bytes), error }.gathered()
    }
    unsafe fn write_raw(self: Output!, ptr: *u8, len: usize) -> Output! {
        let { fd, buf, error } = self;
        Output!.{ fd, buf: unsafe buf.push_n(ptr, len), error }.gathered()
    }
}
