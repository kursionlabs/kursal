//! Reads the process environment and copies values into owned buffers.
// Foreign code must not mutate the environment concurrently with a read here.
use package as std;

use alloc::buffer::Buffer!;
use core::cstr::cstr_len;
use core::option::Option;
use core::slice::ReadBytes;
use std::io::c_string;

extern "C" fn kur_libc_fs_getenv(name: *u8, len: usize) -> *u8;
extern "C" fn kur_libc_fs_release(bytes: *u8) -> ();

/// Copy the value of `name` into an owned buffer. Returns `None` when the
/// variable is unset or its name contains NUL or `=`.
forall C, S where ReadBytes[C, S], Copy[S].
fn variable(&cx: C, name: S) -> Option[Buffer!] {
    var text = c_string(&cx, name);
    let p = unsafe &text.as_ptr();
    // `p` holds the name and a NUL; the result is a copy `strdup` made.
    let value = unsafe kur_libc_fs_getenv(p, ReadBytes[C, S]::len(&cx, name));
    text.destroy();
    if unsafe (value as usize) == 0usize {
        Option::None
    } else {
        let len = unsafe cstr_len(value);
        let output = unsafe Buffer!::new().push_n(value, len);
        let unit = unsafe kur_libc_fs_release(value);
        Option::Some.(output)
    }
}
