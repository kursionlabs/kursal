//! The standard library: I/O, files and directories, the environment,
//! processes, threads, time and floats from text over the C library (the
//! `libc` package, which it does not re-export), plus the `core`
//! and `alloc` modules, each at one `std::` path: `std::cmp` is `core::cmp`,
//! `std::buffer` is `alloc::buffer`. `std::fmt` is `alloc::fmt`, which holds
//! all of `core::fmt` and the `Buffer!` writers.
use package::{env, float, fs, io, process, thread, time};
export env;
export float;
export fs;
export io;
export process;
export thread;
export time;
use core::{array, ascii, atomic, borrow, cap, cmp, cstr, cursor, hash, iter, mem, option, parse, ptr, raw, slice, utf8};
export array;
export ascii;
export atomic;
export borrow;
export cap;
export cmp;
export cstr;
export cursor;
export hash;
export iter;
export mem;
export option;
export parse;
export ptr;
export raw;
export slice;
export utf8;
use alloc::{arena, buffer, collections, fmt, heap, owned};
export arena;
export buffer;
export collections;
export fmt;
export heap;
export owned;
