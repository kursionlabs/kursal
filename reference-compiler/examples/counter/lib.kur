exposed struct Counter { value: u32 }

fn bump(&counter: Counter) -> u32 {
    counter.value = counter.value + 1u32;
    counter.value
}

fn main() -> i32 {
    var counter = Counter.{ value: 40u32 };
    let result = if counter.value == 40u32 {
        bump(&counter)
    } else {
        0u32
    };
    ((counter.value + result) as i32)
}
