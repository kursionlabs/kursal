(type counter::Counter (struct (value u32)))

(fun counter::bump u32 (counter::Counter)
  (entry ((&counter counter::Counter))
    (= %v2 (load &counter.value))
    (= %v3 (const u32 1))
    (= %v4 (add %v2 %v3))
    (= %v5 (store &counter.value %v4))
    (= %v6 (load &counter.value))
    (ret %v6))
)

(fun counter::main i32 ()
  (locals (&counter#1 counter::Counter))
  (entry ()
    (= %v2 (const u32 40))
    (= %v3 (construct counter::Counter %v2))
    (= %v4 (store &counter#1 %v3))
    (= %v5 (load &counter#1.value))
    (= %v6 (const u32 40))
    (= %v7 (eq %v5 %v6))
    (jnz %v7 ((b8)) ((b9))))
  (b8 ()
    (= %v10 (call counter::bump &counter#1))
    (jmp join13 %v10))
  (b9 ()
    (= %v11 (const u32 0))
    (jmp join13 %v11))
  (join13 ((%r12 u32))
    (= %v14 (load &counter#1.value))
    (= %v15 (copy %r12))
    (= %v16 (add %v14 %v15))
    (= %v17 (int_cast %v16 i32))
    (ret %v17))
)
