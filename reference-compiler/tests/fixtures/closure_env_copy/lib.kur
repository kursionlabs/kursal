// `closure[Env](...) -> ...` names a closure parameter's hidden capture
// environment. Bounding `Env` with `Copy` lets a capturing closure be
// called more than once; `examples/closure_method`'s `Cell::with` calls
// its closure exactly once and needs no bound.

forall T, Env where Copy[Env]. fn twice(x: T, f: closure[Env](T) -> T) -> T {
    let a = f(x);
    f(a)
}

fn use_it(offset: u32) -> u32 {
    twice(5u32, |v: u32| v + offset)
}
