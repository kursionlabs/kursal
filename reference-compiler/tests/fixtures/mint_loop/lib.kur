// A brand minted before a loop and still live across it. The `while` is
// inside the scope that `let exists 'j. k = fresh();` opens, and
// the linear `Tag!['j]` stays alive through every iteration until it is
// consumed after the loop.

use core::cap::{Brand, fresh};

forall 'k. exposed struct Tag! {
    marker: Brand['k],
}

// Copy (no `!`): a branded witness the loop body can read on every
// iteration without consuming it, so the body names the brand too.
forall 'k. exposed struct Ticket {
    marker: Brand['k],
}

forall 'k. fn tag_weight(t: Tag!['k]) -> u32 {
    let { marker } = t; // a zero-size Brand, so dropping it costs nothing
    7
}

forall 'k. fn ticket_step(t: Ticket['k], acc: u32) -> u32 {
    let { marker } = t;
    acc + 1
}

// Mint, loop, then consume the branded value. Returns n*(n+1)/2 + 7.
fn mint_then_loop(n: u32) -> u32 {
    let exists 'j. k = fresh();
    let tag = Tag!.{ marker: k };
    var acc = 0u32;
    var i = n;
    while i != 0 {
        acc = acc + i;
        i = i - 1;
    }
    acc + tag_weight(tag)
}

// The loop body calls a function generic over the minted brand, so its
// brand argument is the locally minted 'j rather than a function-level
// `forall` parameter. Returns n + 7.
fn mint_then_loop_using_brand(n: u32) -> u32 {
    let exists 'j. k = fresh();
    let tag = Tag!.{ marker: k };
    let ticket = Ticket.{ marker: k };
    var acc = 0u32;
    var i = n;
    while i != 0 {
        acc = ticket_step(ticket, acc);
        i = i - 1;
    }
    acc + tag_weight(tag)
}
