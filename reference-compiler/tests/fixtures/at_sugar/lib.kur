// `&` in-out parameters end to end: declaration-side return widening
// (including a single widened slot collapsing to the bare type), the
// hand-back the compiler writes at the body's exits, a plain call-site
// rebind, a method chain where each `&` rebinds before the next call runs,
// and left-to-right evaluation for a call nested as another's argument.

exposed struct Tag! {
    id: u32,
}

exposed struct Counter {
    n: u32,
}

// One `&` param widening a `u32` return gives `(Tag!, u32)`; the body
// returns only the `u32`, and the compiler hands `tag` back ahead of it.
fn mint(&tag: Tag!) -> u32 {
    1
}

impl Counter {
    fn bump(self, &tag: Tag!) -> Counter {
        Counter.{ n: self.n + 1 }
    }
    fn double(self, &tag: Tag!) -> Counter {
        Counter.{ n: self.n * 2 }
    }
}

fn step1(&tag: Tag!) -> u32 {
    1
}

fn step2(&tag: Tag!, x: u32) -> u32 {
    x + 1
}

fn main() -> i32 {
    // `let x = mint(&t);` is `let (t, x) = mint(t);`
    var t = Tag!.{ id: 0 };
    let x = mint(&t);
    let { id: id1 } = t;
    let ok1 = x == 1 && id1 == 0;

    // A method chain: `t2` is rebound as soon as `bump` returns, so
    // `double` sees the new one.
    var t2 = Tag!.{ id: 0 };
    let c = Counter.{ n: 1 };
    let c2 = c.bump(&t2).double(&t2);
    let { id: id2 } = t2;
    let ok2 = c2.n == 4 && id2 == 0; // (1 + 1) * 2

    // In `step2(&t3, step1(&t3))`, `step1` runs first and sees the original
    // `t3`; `step2` sees the one `step1` handed back.
    var t3 = Tag!.{ id: 0 };
    let y = step2(&t3, step1(&t3));
    let { id: id3 } = t3;
    let ok3 = y == 2 && id3 == 0;

    if ok1 && ok2 && ok3 { 0 } else { 1 }
}
