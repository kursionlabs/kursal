// The compiler's view of the operating system: arguments, files, directories and processes.

use package::base::{Out, Seq, Text, alloc, load_at, store_at, text};
use std::bytes::buffer::Buffer;
use std::io::{close, open, read_file, write_all};
use std::option::{Option, Result};
use std::process::Args;
use std::cstr::cstr_len;
use libc::fs::{canonicalize, environment_variable, open_directory};

extern "C" fn fork() -> i32;
extern "C" fn execvp(file: *u8, argv: *(*u8)) -> i32;
extern "C" fn waitpid(pid: i32, status: *i32, options: i32) -> i32;
extern "C" fn _exit(status: i32) -> !;
extern "C" fn clock_gettime(clock: i32, spec: *i64) -> i32;

// The arguments the program was started with, after its own name.
fn arguments(argc: i32, argv: *(*u8)) -> Seq[Text] {
    let args = unsafe Args::from_main(argc, argv);
    let out: Seq[Text] = Seq::new();
    var i = 1usize;
    while i < args.len() {
        let unit = match args.bytes(i) {
            Option::Some(bytes) => out.push(text(bytes)),
            Option::None => (),
        };
        i = i + 1usize;
    }
    out
}

// `t` followed by a NUL, as C wants a path.
fn c_string(t: Text) -> *u8 {
    Out::new().add(t).byte(0u8).done().ptr
}

// The bytes of a buffer, as text that outlives it.
fn take(b: Buffer!) -> Text {
    let ptr = unsafe &b.as_ptr();
    let len = &b.len();
    let copy = Out::new();
    copy.bytes.push_bytes(ptr, len);
    b.destroy();
    copy.done()
}

fn buffer(t: Text) -> Buffer! {
    unsafe Buffer::new().push_n(t.ptr, t.len)
}

// The contents of the file at `path`, if it can be read.
fn read(path: Text) -> Option[Text] {
    match unsafe read_file(c_string(path)) {
        Result::Ok(b) => Option::Some.(take(b)),
        Result::Err(code) => Option::None,
    }
}

// The absolute path with no symbolic links that `path` names, if it exists.
fn real_path(path: Text) -> Option[Text] {
    var b = buffer(path);
    let result = canonicalize(&b);
    b.destroy();
    match result {
        Result::Ok(r) => Option::Some.(take(r)),
        Result::Err(code) => Option::None,
    }
}

// Whether `path` names an existing file or directory.
fn path_exists(path: Text) -> bool {
    real_path(path).is_some()
}

fn environment(name: Text) -> Option[Text] {
    var b = buffer(name);
    let result = environment_variable(&b);
    b.destroy();
    match result {
        Option::Some(r) => Option::Some.(take(r)),
        Option::None => Option::None,
    }
}

// The entries of a directory, other than `.` and `..`, with whether each is a directory.
fn list_directory(path: Text) -> Seq[(Text, bool)] {
    let out: Seq[(Text, bool)] = Seq::new();
    var b = buffer(path);
    let opened = open_directory(&b);
    b.destroy();
    match opened {
        Result::Ok(stream) => {
            var stream = stream;
            var going = true;
            while going {
                let unit = match &stream.next_entry() {
                    Result::Ok(next) => match next {
                        Option::Some(entry) => {
                            let { name, is_directory } = entry;
                            let n = take(name);
                            if !n.is(".") && !n.is("..") {
                                out.push((n, is_directory));
                            }
                        },
                        Option::None => {
                            going = false;
                        },
                    },
                    Result::Err(code) => {
                        going = false;
                    },
                };
            }
            let closed = stream.close();
        },
        Result::Err(code) => (),
    }
    out
}

// Writes `contents` to the file at `path`, replacing it; whether that succeeded.
fn write(path: Text, contents: Text) -> bool {
    // O_WRONLY | O_CREAT | O_TRUNC, mode 0644
    let fd = unsafe open(c_string(path), 577i32, 420i32);
    if fd < 0i32 {
        return false;
    }
    let written = match unsafe write_all(fd, contents.ptr, contents.len) {
        Result::Ok(_u) => true,
        Result::Err(_code) => false,
    };
    unsafe close(fd) == 0i32 && written
}

// Runs the program `argv[0]`, found on the PATH, with the arguments `argv`, and waits for it;
// whether it exited with status 0.
fn run(argv: Seq[Text]) -> bool {
    let pointers: *(*u8) = alloc(argv.len() + 1usize);
    var i = 0usize;
    while i < argv.len() {
        store_at(pointers, i, c_string(argv.get(i)));
        i = i + 1usize;
    }
    store_at(pointers, argv.len(), unsafe (0usize as *u8));
    let pid = unsafe fork();
    if pid == 0i32 {
        let unit = unsafe execvp(load_at(pointers, 0usize), pointers);
        unsafe _exit(127i32);
    }
    if pid < 0i32 {
        return false;
    }
    let status: *i32 = alloc(1usize);
    store_at(status, 0usize, 1i32);
    if unsafe waitpid(pid, status, 0i32) != pid {
        return false;
    }
    load_at(status, 0usize) == 0i32
}

// Milliseconds on a monotonic clock, from an arbitrary start.
fn now_ms() -> u64 {
    let spec: *i64 = alloc(2usize);
    // CLOCK_MONOTONIC
    let unit = unsafe clock_gettime(1i32, spec);
    (load_at(spec, 0usize) as u64) * 1000u64 + (load_at(spec, 1usize) as u64) / 1000000u64
}
