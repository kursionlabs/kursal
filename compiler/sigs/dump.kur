// A canonical text form of a program's signatures, for comparing `sigs` with the reference: every
// type declaration, trait, signature, instance and constant value, each table in the order its
// entries were made. Types are written as KURS writes them.

use package::support::base::{Cx, Map, Out, Seq, Text, text};
use package::kurs::core::{ModuleId, Type};
use package::kurs::core as C;
use package::syntax::dump;
use package::kurs::serial::{form_text, write_atom, write_forall, write_ptypes, write_type, write_type_decl};
use package::resolve::resolver::Decl;
use package::resolve::dump::{decl_text, module_text};
use package::sigs::signatures::{ConstValue, Sig, Signatures, const_kind, int_text};
use package::types::ops::kind_name;
use std::option::Option;

forall 'k.
fn opt_module(&cx: Cx!['k], m: Option[ModuleId['k]]) -> Text['k] {
    match m {
        Option::Some(home) => module_text(&cx, home),
        Option::None => text(&cx, "_"),
    }
}

forall 'k.
fn sig(&cx: Cx!['k], out: Out['k], s: Sig['k], indent: Text['k]) {
    let unit = out.add(&cx, indent).put(&cx, "sig ").add(&cx, write_atom(&cx, s.name)).put(&cx, if s.is_unsafe { " unsafe\n" } else { " safe\n" });
    let unit = out.add(&cx, indent).put(&cx, "  decl ").add(&cx, match s.decl {
        Option::Some(d) => decl_text(&cx, d),
        Option::None => text(&cx, "_"),
    }).put(&cx, "\n");
    let unit = out.add(&cx, indent).put(&cx, "  module ").add(&cx, opt_module(&cx, s.home)).put(&cx, "\n");
    let unit = out.add(&cx, indent).put(&cx, "  ").add(&cx, write_forall(&cx, s.params, s.premises)).put(&cx, "\n");
    let params: Seq[Text['k], 'k] = Seq::new(&cx);
    var i = 0usize;
    while i < s.pnames.len(&cx) {
        let parts: Seq[Text['k], 'k] = Seq::new(&cx);
        if s.places.has(&cx, i) {
            parts.push(&cx, text(&cx, "&"));
        }
        parts.push(&cx, write_atom(&cx, s.pnames.get(&cx, i)));
        parts.push(&cx, write_type(&cx, s.ptypes.get(&cx, i)));
        params.push(&cx, form_text(&cx, parts));
        i = i + 1usize;
    }
    let unit = out.add(&cx, indent).put(&cx, "  params ").add(&cx, form_text(&cx, params)).put(&cx, "\n");
    let unit = out.add(&cx, indent).put(&cx, "  ret ").add(&cx, write_type(&cx, s.ret)).put(&cx, "\n");
}

forall 'k.
fn const_text(&cx: Cx!['k], value: ConstValue['k]) -> Text['k] {
    let out = Out::new(&cx).add(&cx, const_kind(&cx, value)).put(&cx, " ");
    let ty = match value {
        ConstValue::Int(v, ty) => {
            let name = match ty {
                Type::Prim(n) => n,
                _ => text(&cx, ""),
            };
            let unit = out.add(&cx, int_text(&cx, v, name));
            Option::Some.(ty)
        },
        ConstValue::Bool(b) => {
            let unit = out.put(&cx, if b { "true" } else { "false" });
            Option::Some.(C::bool_type(&cx))
        },
        ConstValue::Float(digits, ty) => {
            let unit = out.add(&cx, digits);
            Option::Some.(ty)
        },
        ConstValue::Str(t, ty) => {
            let unit = dump::str(&cx, out, t);
            ty
        },
    };
    let unit = out.put(&cx, " ");
    let unit = match ty {
        Option::Some(t) => out.add(&cx, write_type(&cx, t)),
        Option::None => out.put(&cx, "_"),
    };
    out.done(&cx)
}

forall 'k.
fn program(&cx: Cx!['k], s: Signatures['k]) -> Text['k] {
    let out = Out::new(&cx);
    let types = s.types.values(&cx);
    var i = 0usize;
    while i < types.len(&cx) {
        let unit = out.put(&cx, "type ").add(&cx, write_type_decl(&cx, types.get(&cx, i))).put(&cx, "\n");
        i = i + 1usize;
    }
    let traits = s.traits.values(&cx);
    i = 0usize;
    while i < traits.len(&cx) {
        let t = traits.get(&cx, i);
        let params: Seq[Text['k], 'k] = Seq::new(&cx);
        let kinds: Seq[Text['k], 'k] = Seq::new(&cx);
        var k = 0usize;
        while k < t.params.len(&cx) {
            params.push(&cx, write_atom(&cx, t.params.get(&cx, k)));
            kinds.push(&cx, kind_name(&cx, t.param_kinds.get(&cx, k)));
            k = k + 1usize;
        }
        let unit = out.put(&cx, "trait ").add(&cx, write_atom(&cx, t.name)).put(&cx, " ").add(&cx, form_text(&cx, params)).put(&cx, " ").add(&cx, form_text(&cx, kinds)).put(&cx, "\n");
        let unit = out.put(&cx, "  module ").add(&cx, opt_module(&cx, t.home)).put(&cx, "\n");
        k = 0usize;
        while k < t.methods.len(&cx) {
            let m = t.methods.get(&cx, k);
            let unit = out.put(&cx, "  method ").add(&cx, write_atom(&cx, m.name)).put(&cx, if m.is_unsafe { " unsafe " } else { " " })
                .add(&cx, write_ptypes(&cx, m.ptypes, m.places)).put(&cx, " ").add(&cx, write_type(&cx, m.ret)).put(&cx, "\n");
            k = k + 1usize;
        }
        i = i + 1usize;
    }
    let sigs = s.sigs.values(&cx);
    i = 0usize;
    while i < sigs.len(&cx) {
        sig(&cx, out, sigs.get(&cx, i), text(&cx, ""));
        i = i + 1usize;
    }
    i = 0usize;
    while i < s.instances.len(&cx) {
        let (inst, _item, _home) = s.instances.get(&cx, i);
        let unit = out.put(&cx, "instance ").add(&cx, write_atom(&cx, inst.trait_name)).put(&cx, " ").add(&cx, module_text(&cx, inst.home));
        let unit = dump::pos(&cx, out, inst.pos).put(&cx, "\n");
        let head: Seq[Text['k], 'k] = Seq::new(&cx);
        var k = 0usize;
        while k < inst.head.len(&cx) {
            head.push(&cx, write_type(&cx, inst.head.get(&cx, k)));
            k = k + 1usize;
        }
        let unit = out.put(&cx, "  ").add(&cx, write_forall(&cx, inst.params, inst.premises)).put(&cx, " ").add(&cx, form_text(&cx, head)).put(&cx, "\n");
        k = 0usize;
        while k < inst.methods.len(&cx) {
            sig(&cx, out, inst.methods.get(&cx, k), text(&cx, "  "));
            k = k + 1usize;
        }
        i = i + 1usize;
    }
    // The consts' declarations, by id.
    let decls: Map[u32, Decl['k], 'k] = Map::new(&cx);
    let scopes = s.r.scopes.values(&cx);
    i = 0usize;
    while i < scopes.len(&cx) {
        let all = scopes.get(&cx, i).decls.values(&cx);
        var k = 0usize;
        while k < all.len(&cx) {
            decls.set(&cx, all.get(&cx, k).id, all.get(&cx, k));
            k = k + 1usize;
        }
        i = i + 1usize;
    }
    let ids = s.consts.keys(&cx);
    i = 0usize;
    while i < ids.len(&cx) {
        let unit = out.put(&cx, "const ").add(&cx, decl_text(&cx, decls.at(&cx, ids.get(&cx, i)))).put(&cx, " ").add(&cx, const_text(&cx, s.consts.at(&cx, ids.get(&cx, i)))).put(&cx, "\n");
        i = i + 1usize;
    }
    out.done(&cx)
}
