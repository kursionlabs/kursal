// A canonical text form of a program's signatures, for comparing `sigs` with the reference: every
// type declaration, trait, signature, instance and constant value, each table in the order its
// entries were made. Types are written as KURS writes them.

use std::collections::arena_vec::ArenaVec;
use std::collections::arena_map::ArenaMap;
use std::raw::Span;
use std::alloc::arena::Domain;
use std::bytes::buffer::Buffer;
use package::kurs::core::{ModuleId, Type};
use package::kurs::core as C;
use package::syntax::dump;
use package::kurs::serial::{form_text, write_atom, write_forall, write_ptypes, write_type, write_type_decl};
use package::resolve::resolver::Decl;
use package::resolve::dump::{decl_text, module_text};
use package::sigs::signatures::{ConstValue, Sig, Signatures, const_kind, int_text};
use package::types::ops::kind_name;
use std::option::Option;

forall 'k.
fn opt_module(&cx: Domain!['k], m: Option[ModuleId['k]]) -> Span['k] {
    match m {
        Option::Some(home) => module_text(&cx, home),
        Option::None => Span::from_static(&cx, "_"),
    }
}

forall 'k.
fn sig(&cx: Domain!['k], &out: Buffer!, s: Sig['k], indent: Span['k]) {
    out = out.push_bytes(&cx, indent).push_static("sig ").push_bytes(&cx, write_atom(&cx, s.name)).push_static(if s.is_unsafe { " unsafe\n" } else { " safe\n" });
    out = out.push_bytes(&cx, indent).push_static("  decl ").push_bytes(&cx, match s.decl {
        Option::Some(d) => decl_text(&cx, d),
        Option::None => Span::from_static(&cx, "_"),
    }).push_static("\n");
    out = out.push_bytes(&cx, indent).push_static("  module ").push_bytes(&cx, opt_module(&cx, s.home)).push_static("\n");
    out = out.push_bytes(&cx, indent).push_static("  ").push_bytes(&cx, write_forall(&cx, s.params, s.premises)).push_static("\n");
    let params: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
    var i = 0usize;
    while i < s.pnames.len(&cx) {
        let parts: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
        if s.places.contains(&cx, i) {
            parts.push(&cx, Span::from_static(&cx, "&"));
        }
        parts.push(&cx, write_atom(&cx, s.pnames.at(&cx, i)));
        parts.push(&cx, write_type(&cx, s.ptypes.at(&cx, i)));
        params.push(&cx, form_text(&cx, parts));
        i = i + 1usize;
    }
    out = out.push_bytes(&cx, indent).push_static("  params ").push_bytes(&cx, form_text(&cx, params)).push_static("\n");
    out = out.push_bytes(&cx, indent).push_static("  ret ").push_bytes(&cx, write_type(&cx, s.ret)).push_static("\n");
}

forall 'k.
fn const_text(&cx: Domain!['k], value: ConstValue['k]) -> Span['k] {
    var out = Buffer::new().push_bytes(&cx, const_kind(&cx, value)).push_static(" ");
    let ty = match value {
        ConstValue::Int(v, ty) => {
            let name = match ty {
                Type::Prim(n) => n,
                _ => Span::from_static(&cx, ""),
            };
            out = out.push_bytes(&cx, int_text(&cx, v, name));
            Option::Some.(ty)
        },
        ConstValue::Bool(b) => {
            out = out.push_static(if b { "true" } else { "false" });
            Option::Some.(C::bool_type(&cx))
        },
        ConstValue::Float(digits, ty) => {
            out = out.push_bytes(&cx, digits);
            Option::Some.(ty)
        },
        ConstValue::Str(t, ty) => {
            out = dump::str(&cx, out, t);
            ty
        },
        ConstValue::Op(name, operands, ty) => {
            out = out.push_static("(").push_bytes(&cx, name);
            var i = 0usize;
            while i < operands.len(&cx) {
                out = out.push_static(" (").push_bytes(&cx, const_text(&cx, operands.at(&cx, i))).push_static(")");
                i = i + 1usize;
            }
            out = out.push_static(")");
            Option::Some.(ty)
        },
    };
    out = out.push_static(" ");
    out = match ty {
        Option::Some(t) => out.push_bytes(&cx, write_type(&cx, t)),
        Option::None => out.push_static("_"),
    };
    out.save(&cx)
}

forall 'k.
fn program(&cx: Domain!['k], s: Signatures['k]) -> Span['k] {
    var out = Buffer::new();
    let types = s.types.values(&cx);
    var i = 0usize;
    while i < types.len(&cx) {
        out = out.push_static("type ").push_bytes(&cx, write_type_decl(&cx, types.at(&cx, i))).push_static("\n");
        i = i + 1usize;
    }
    let traits = s.traits.values(&cx);
    i = 0usize;
    while i < traits.len(&cx) {
        let t = traits.at(&cx, i);
        let params: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
        let kinds: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
        var k = 0usize;
        while k < t.params.len(&cx) {
            params.push(&cx, write_atom(&cx, t.params.at(&cx, k)));
            kinds.push(&cx, kind_name(&cx, t.param_kinds.at(&cx, k)));
            k = k + 1usize;
        }
        out = out.push_static("trait ").push_bytes(&cx, write_atom(&cx, t.name)).push_static(" ").push_bytes(&cx, form_text(&cx, params)).push_static(" ").push_bytes(&cx, form_text(&cx, kinds)).push_static("\n");
        out = out.push_static("  module ").push_bytes(&cx, opt_module(&cx, t.home)).push_static("\n");
        k = 0usize;
        while k < t.methods.len(&cx) {
            let m = t.methods.at(&cx, k);
            out = out.push_static("  method ").push_bytes(&cx, write_atom(&cx, m.name)).push_static(if m.is_unsafe { " unsafe " } else { " " })
                .push_bytes(&cx, write_ptypes(&cx, m.ptypes, m.places)).push_static(" ").push_bytes(&cx, write_type(&cx, m.ret)).push_static("\n");
            k = k + 1usize;
        }
        i = i + 1usize;
    }
    let sigs = s.sigs.values(&cx);
    i = 0usize;
    while i < sigs.len(&cx) {
        sig(&cx, &out, sigs.at(&cx, i), Span::from_static(&cx, ""));
        i = i + 1usize;
    }
    i = 0usize;
    while i < s.instances.len(&cx) {
        let (inst, _item, _home) = s.instances.at(&cx, i);
        out = out.push_static("instance ").push_bytes(&cx, write_atom(&cx, inst.trait_name)).push_static(" ").push_bytes(&cx, module_text(&cx, inst.home));
        out = dump::pos(&cx, out, inst.pos).push_static("\n");
        let head: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
        var k = 0usize;
        while k < inst.head.len(&cx) {
            head.push(&cx, write_type(&cx, inst.head.at(&cx, k)));
            k = k + 1usize;
        }
        out = out.push_static("  ").push_bytes(&cx, write_forall(&cx, inst.params, inst.premises)).push_static(" ").push_bytes(&cx, form_text(&cx, head)).push_static("\n");
        k = 0usize;
        while k < inst.methods.len(&cx) {
            sig(&cx, &out, inst.methods.at(&cx, k), Span::from_static(&cx, "  "));
            k = k + 1usize;
        }
        i = i + 1usize;
    }
    // The consts' declarations, by id.
    let decls: ArenaMap[u32, Decl['k], 'k] = ArenaMap::new(&cx);
    let scopes = s.r.scopes.values(&cx);
    i = 0usize;
    while i < scopes.len(&cx) {
        let all = scopes.at(&cx, i).decls.values(&cx);
        var k = 0usize;
        while k < all.len(&cx) {
            decls.insert(&cx, all.at(&cx, k).id, all.at(&cx, k));
            k = k + 1usize;
        }
        i = i + 1usize;
    }
    let ids = s.consts.keys(&cx);
    i = 0usize;
    while i < ids.len(&cx) {
        out = out.push_static("const ").push_bytes(&cx, decl_text(&cx, decls.at(&cx, ids.at(&cx, i)))).push_static(" ").push_bytes(&cx, const_text(&cx, s.consts.at(&cx, ids.at(&cx, i)))).push_static("\n");
        i = i + 1usize;
    }
    out.save(&cx)
}
