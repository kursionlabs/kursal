// A canonical text form of a program's signatures, for comparing `sigs` with the reference: every
// type declaration, trait, signature, instance and constant value, each table in the order its
// entries were made. Types are written as KURS writes them.

use package::support::base::{Map, Out, Seq, Text, text};
use package::kurs::core::{ModuleId, Type};
use package::kurs::core as C;
use package::syntax::dump;
use package::kurs::serial::{form_text, write_atom, write_forall, write_ptypes, write_type, write_type_decl};
use package::resolve::resolver::Decl;
use package::resolve::dump::{decl_text, module_text};
use package::sigs::signatures::{ConstValue, Sig, Signatures, const_kind, int_text};
use package::types::ops::kind_name;
use std::option::Option;

fn opt_module(m: Option[ModuleId]) -> Text {
    match m {
        Option::Some(home) => module_text(home),
        Option::None => text("_"),
    }
}

fn sig(out: Out, s: Sig, indent: Text) {
    let unit = out.add(indent).put("sig ").add(write_atom(s.name)).put(if s.is_unsafe { " unsafe\n" } else { " safe\n" });
    let unit = out.add(indent).put("  decl ").add(match s.decl {
        Option::Some(d) => decl_text(d),
        Option::None => text("_"),
    }).put("\n");
    let unit = out.add(indent).put("  module ").add(opt_module(s.home)).put("\n");
    let unit = out.add(indent).put("  ").add(write_forall(s.params, s.premises)).put("\n");
    let params: Seq[Text] = Seq::new();
    var i = 0usize;
    while i < s.pnames.len() {
        let parts: Seq[Text] = Seq::new();
        if s.places.has(i) {
            parts.push(text("&"));
        }
        parts.push(write_atom(s.pnames.get(i)));
        parts.push(write_type(s.ptypes.get(i)));
        params.push(form_text(parts));
        i = i + 1usize;
    }
    let unit = out.add(indent).put("  params ").add(form_text(params)).put("\n");
    let unit = out.add(indent).put("  ret ").add(write_type(s.ret)).put("\n");
}

fn const_text(value: ConstValue) -> Text {
    let out = Out::new().add(const_kind(value)).put(" ");
    let ty = match value {
        ConstValue::Int(v, ty) => {
            let name = match ty {
                Type::Prim(n) => n,
                _ => text(""),
            };
            let unit = out.add(int_text(v, name));
            Option::Some.(ty)
        },
        ConstValue::Bool(b) => {
            let unit = out.put(if b { "true" } else { "false" });
            Option::Some.(C::bool_type())
        },
        ConstValue::Float(digits, ty) => {
            let unit = out.add(digits);
            Option::Some.(ty)
        },
        ConstValue::Str(t, ty) => {
            let unit = dump::str(out, t);
            ty
        },
    };
    let unit = out.put(" ");
    let unit = match ty {
        Option::Some(t) => out.add(write_type(t)),
        Option::None => out.put("_"),
    };
    out.done()
}

fn program(s: Signatures) -> Text {
    let out = Out::new();
    let types = s.types.values();
    var i = 0usize;
    while i < types.len() {
        let unit = out.put("type ").add(write_type_decl(types.get(i))).put("\n");
        i = i + 1usize;
    }
    let traits = s.traits.values();
    i = 0usize;
    while i < traits.len() {
        let t = traits.get(i);
        let params: Seq[Text] = Seq::new();
        let kinds: Seq[Text] = Seq::new();
        var k = 0usize;
        while k < t.params.len() {
            params.push(write_atom(t.params.get(k)));
            kinds.push(kind_name(t.param_kinds.get(k)));
            k = k + 1usize;
        }
        let unit = out.put("trait ").add(write_atom(t.name)).put(" ").add(form_text(params)).put(" ").add(form_text(kinds)).put("\n");
        let unit = out.put("  module ").add(opt_module(t.home)).put("\n");
        k = 0usize;
        while k < t.methods.len() {
            let m = t.methods.get(k);
            let unit = out.put("  method ").add(write_atom(m.name)).put(if m.is_unsafe { " unsafe " } else { " " })
                .add(write_ptypes(m.ptypes, m.places)).put(" ").add(write_type(m.ret)).put("\n");
            k = k + 1usize;
        }
        i = i + 1usize;
    }
    let sigs = s.sigs.values();
    i = 0usize;
    while i < sigs.len() {
        sig(out, sigs.get(i), text(""));
        i = i + 1usize;
    }
    i = 0usize;
    while i < s.instances.len() {
        let (inst, _item, _home) = s.instances.get(i);
        let unit = out.put("instance ").add(write_atom(inst.trait_name)).put(" ").add(module_text(inst.home));
        let unit = dump::pos(out, inst.pos).put("\n");
        let head: Seq[Text] = Seq::new();
        var k = 0usize;
        while k < inst.head.len() {
            head.push(write_type(inst.head.get(k)));
            k = k + 1usize;
        }
        let unit = out.put("  ").add(write_forall(inst.params, inst.premises)).put(" ").add(form_text(head)).put("\n");
        k = 0usize;
        while k < inst.methods.len() {
            sig(out, inst.methods.get(k), text("  "));
            k = k + 1usize;
        }
        i = i + 1usize;
    }
    // The consts' declarations, by id.
    let decls: Map[u32, Decl] = Map::new();
    let scopes = s.r.scopes.values();
    i = 0usize;
    while i < scopes.len() {
        let all = scopes.get(i).decls.values();
        var k = 0usize;
        while k < all.len() {
            decls.set(all.get(k).id, all.get(k));
            k = k + 1usize;
        }
        i = i + 1usize;
    }
    let ids = s.consts.keys();
    i = 0usize;
    while i < ids.len() {
        let unit = out.put("const ").add(decl_text(decls.at(ids.get(i)))).put(" ").add(const_text(s.consts.at(ids.get(i)))).put("\n");
        i = i + 1usize;
    }
    out.done()
}
