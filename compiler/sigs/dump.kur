// A canonical text form of a program's signatures, for comparing `sigs` with the reference: every
// type declaration, trait, signature, instance and constant value, each table in the order its
// entries were made. Types are written as KURS writes them.

use std::collections::arena_vec::ArenaVec;
use std::collections::arena_map::ArenaMap;
use std::raw::Span;
use std::arena::Domain!;
use std::buffer::Buffer!;
use std::fmt::Writer;
use package::kurs::core::{ModuleId, Type};
use package::kurs::core as C;
use package::syntax::dump;
use package::kurs::serial::{form_text, write_atom, write_forall, write_ptypes, write_type, write_type_decl};
use package::resolve::resolver::Decl;
use package::resolve::dump::{decl_text, module_text};
use package::sigs::signatures::{ConstValue, Sig, Signatures, const_kind, int_text};
use package::types::ops::kind_name;
use std::option::Option;

forall 'k.
fn opt_module(&cx: Domain!['k], m: Option[ModuleId['k]]) -> Span['k] {
    match m {
        Some(home) => module_text(&cx, home),
        None => Span::from_static(&cx, "_"),
    }
}

forall 'k.
fn sig(&cx: Domain!['k], &out: Buffer!, s: Sig['k], indent: Span['k]) {
    out = out.write(&cx, indent).put("sig ").write(&cx, write_atom(&cx, s.name)).put(if s.is_unsafe { " unsafe\n" } else { " safe\n" });
    out = out.write(&cx, indent).put("  decl ").write(&cx, match s.decl {
        Some(d) => decl_text(&cx, d),
        None => Span::from_static(&cx, "_"),
    }).put("\n");
    out = out.write(&cx, indent).put("  module ").write(&cx, opt_module(&cx, s.home)).put("\n");
    out = out.write(&cx, indent).put("  ").write(&cx, write_forall(&cx, s.params, s.premises)).put("\n");
    let params: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
    var i = 0usize;
    while i < s.pnames.len(&cx) {
        let parts: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
        if s.places.contains(&cx, i) {
            parts.push(&cx, Span::from_static(&cx, "&"));
        }
        parts.push(&cx, write_atom(&cx, s.pnames.at(&cx, i)));
        parts.push(&cx, write_type(&cx, s.ptypes.at(&cx, i)));
        params.push(&cx, form_text(&cx, parts));
        i = i + 1usize;
    }
    out = out.write(&cx, indent).put("  params ").write(&cx, form_text(&cx, params)).put("\n");
    out = out.write(&cx, indent).put("  ret ").write(&cx, write_type(&cx, s.ret)).put("\n");
}

forall 'k.
fn const_text(&cx: Domain!['k], value: ConstValue['k]) -> Span['k] {
    var out = Buffer!::new().write(&cx, const_kind(&cx, value)).put(" ");
    let ty = match value {
        Int(v, ty) => {
            let name = match ty {
                Prim(n) => n,
                _ => Span::from_static(&cx, ""),
            };
            out = out.write(&cx, int_text(&cx, v, name));
            Option::Some.(ty)
        },
        Bool(b) => {
            out = out.put(if b { "true" } else { "false" });
            Option::Some.(C::bool_type(&cx))
        },
        Float(digits, ty) => {
            out = out.write(&cx, digits);
            Option::Some.(ty)
        },
        Str(t, ty) => {
            out = dump::str(&cx, out, t);
            ty
        },
        Op(name, operands, ty) => {
            out = out.put("(").write(&cx, name);
            var i = 0usize;
            while i < operands.len(&cx) {
                out = out.put(" (").write(&cx, const_text(&cx, operands.at(&cx, i))).put(")");
                i = i + 1usize;
            }
            out = out.put(")");
            Option::Some.(ty)
        },
    };
    out = out.put(" ");
    out = match ty {
        Some(t) => out.write(&cx, write_type(&cx, t)),
        None => out.put("_"),
    };
    out.save(&cx)
}

forall 'k.
fn program(&cx: Domain!['k], s: Signatures['k]) -> Span['k] {
    var out = Buffer!::new();
    let types = s.types.values(&cx);
    var i = 0usize;
    while i < types.len(&cx) {
        out = out.put("type ").write(&cx, write_type_decl(&cx, types.at(&cx, i))).put("\n");
        i = i + 1usize;
    }
    let traits = s.traits.values(&cx);
    i = 0usize;
    while i < traits.len(&cx) {
        let t = traits.at(&cx, i);
        let params: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
        let kinds: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
        var k = 0usize;
        while k < t.params.len(&cx) {
            params.push(&cx, write_atom(&cx, t.params.at(&cx, k)));
            kinds.push(&cx, kind_name(&cx, t.param_kinds.at(&cx, k)));
            k = k + 1usize;
        }
        out = out.put("trait ").write(&cx, write_atom(&cx, t.name)).put(" ").write(&cx, form_text(&cx, params)).put(" ").write(&cx, form_text(&cx, kinds)).put("\n");
        out = out.put("  module ").write(&cx, opt_module(&cx, t.home)).put("\n");
        k = 0usize;
        while k < t.methods.len(&cx) {
            let m = t.methods.at(&cx, k);
            out = out.put("  method ").write(&cx, write_atom(&cx, m.name)).put(if m.is_unsafe { " unsafe " } else { " " })
                .write(&cx, write_ptypes(&cx, m.ptypes, m.places)).put(" ").write(&cx, write_type(&cx, m.ret)).put("\n");
            k = k + 1usize;
        }
        i = i + 1usize;
    }
    let sigs = s.sigs.values(&cx);
    i = 0usize;
    while i < sigs.len(&cx) {
        sig(&cx, &out, sigs.at(&cx, i), Span::from_static(&cx, ""));
        i = i + 1usize;
    }
    i = 0usize;
    while i < s.instances.len(&cx) {
        let (inst, _item, _home) = s.instances.at(&cx, i);
        out = out.put("instance ").write(&cx, write_atom(&cx, inst.trait_name)).put(" ").write(&cx, module_text(&cx, inst.home));
        out = dump::pos(&cx, out, inst.pos).put("\n");
        let head: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
        var k = 0usize;
        while k < inst.head.len(&cx) {
            head.push(&cx, write_type(&cx, inst.head.at(&cx, k)));
            k = k + 1usize;
        }
        out = out.put("  ").write(&cx, write_forall(&cx, inst.params, inst.premises)).put(" ").write(&cx, form_text(&cx, head)).put("\n");
        k = 0usize;
        while k < inst.methods.len(&cx) {
            sig(&cx, &out, inst.methods.at(&cx, k), Span::from_static(&cx, "  "));
            k = k + 1usize;
        }
        i = i + 1usize;
    }
    // The consts' declarations, by id.
    let decls: ArenaMap[u32, Decl['k], 'k] = ArenaMap::new(&cx);
    let scopes = s.r.scopes.values(&cx);
    i = 0usize;
    while i < scopes.len(&cx) {
        let all = scopes.at(&cx, i).decls.values(&cx);
        var k = 0usize;
        while k < all.len(&cx) {
            decls.insert(&cx, all.at(&cx, k).id, all.at(&cx, k));
            k = k + 1usize;
        }
        i = i + 1usize;
    }
    let ids = s.consts.keys(&cx);
    i = 0usize;
    while i < ids.len(&cx) {
        out = out.put("const ").write(&cx, decl_text(&cx, decls.at(&cx, ids.at(&cx, i)))).put(" ").write(&cx, const_text(&cx, s.consts.at(&cx, ids.at(&cx, i)))).put("\n");
        i = i + 1usize;
    }
    out.save(&cx)
}
