// Signatures: every resolved declaration in core terms.
//
// Types become core types, with each nominal declaration named by its identity. Functions, methods,
// externs and trait methods get core signatures, with place modes. Consts are folded to values.
//
// Each step returns a `Result` whose error is a `SigError`. Folding a binary operation tries its
// operands in one order and, when that fails, in the other, so an error met while folding is one
// the caller recovers from.
//
// Errors are reported together, in source order, a step at a time: the type aliases, the type
// declarations, the Copy checks of their type arguments, which declarations and aliases are linear,
// the other declarations, and whether each instance conforms to its trait. A step runs only when every step before it
// succeeded, and a declaration reports at most its first error. An error in a constant stops at
// once: it would recur wherever the constant is used.
//
// An integer constant is held in 64 bits: its value in its type's width, sign-extended for a signed
// type, so every value of every integer type has one representation. Folding computes modulo 2^64
// and then reduces to the type's width, which gives the same result as computing exactly and then
// reducing: addition, subtraction, multiplication, negation and the bitwise operations depend only on
// their operands' low bits. Division, remainder, comparison and right shifts depend on whole values,
// and are computed on them (see `binop`).

use package::support::base::{counted, fail};
use std::collections::arena_vec::ArenaVec;
use std::collections::arena_map::{ArenaMap, ArenaSet};
use std::mem::Ref;
use std::raw::Span;
use std::arena::{Domain!, concat, ref_in};
use std::buffer::Buffer!;
use std::fmt::Writer;
use package::kurs::core::{Exposure, ExposureMode, ForeachType, Kind, Member, ModuleId, Param, Premise, Program, Type, TypeDecl};
use package::kurs::core as C;
use package::types::layout::{check_type_expansion, check_written_type};
use package::types::literals::valid_literal;
use package::resolve::resolver::{Decl, NameRef, Named, Package, Resolver, Target, name_pos, named_pos};
use package::syntax::ast as S;
use package::syntax::ast::{Expr, Pos, no_pos};
use package::types::ops::{Fresh, Types, equal, free_names, subst, surface, with_names};
use std::option::{Option, Result};
use std::slice::Slice;

// ------------------------------------------------------------ the library --

// A library item the compiler itself refers to: its home library, its path there, and its path
// through std.
forall 'k.
exposed struct LibraryItem {
    home: Span['k],
    path: ArenaVec[Span['k], 'k],
    std_path: ArenaVec[Span['k], 'k],
}

forall 'k.
fn library_entry(&cx: Domain!['k], home: Slice[u8, 'static], path: Slice[u8, 'static], std_path: Slice[u8, 'static]) -> LibraryItem['k] {
    LibraryItem.{ home: Span::from_static(&cx, home), path: ArenaVec::split(&cx, Span::from_static(&cx, path), Span::from_static(&cx, "::")), std_path: ArenaVec::split(&cx, Span::from_static(&cx, std_path), Span::from_static(&cx, "::")) }
}

// The table `LIBRARY`: the item named `name`.
forall 'k.
fn library_item(&cx: Domain!['k], name: Span['k]) -> LibraryItem['k] {
    if name.is(&cx, "Option") {
        library_entry(&cx, "core", "option::Option", "option::Option")
    } else if name.is(&cx, "Result") {
        library_entry(&cx, "core", "option::Result", "option::Result")
    } else if name.is(&cx, "Slice") {
        library_entry(&cx, "core", "slice::Slice", "slice::Slice")
    } else if name.is(&cx, "Buffer!") {
        library_entry(&cx, "alloc", "buffer::Buffer!", "buffer::Buffer!")
    } else if name.is(&cx, "Iterator") {
        library_entry(&cx, "core", "iter::Iterator", "iter::Iterator")
    } else if name.is(&cx, "Format") {
        library_entry(&cx, "core", "fmt::Format", "fmt::Format")
    } else if name.is(&cx, "Writer") {
        library_entry(&cx, "core", "fmt::Writer", "fmt::Writer")
    } else if name.is(&cx, "Slice::from_raw_parts") {
        library_entry(&cx, "core", "slice::Slice::from_raw_parts", "slice::Slice::from_raw_parts")
    } else if name.is(&cx, "Buffer!::new") {
        library_entry(&cx, "alloc", "buffer::Buffer!::new", "buffer::Buffer!::new")
    } else if name.is(&cx, "ReadingWriter!") {
        library_entry(&cx, "core", "fmt::ReadingWriter!", "fmt::ReadingWriter!")
    } else if name.is(&cx, "ReadingWriter!::new") {
        library_entry(&cx, "core", "fmt::ReadingWriter!::new", "fmt::ReadingWriter!::new")
    } else if name.is(&cx, "ReadingWriter!::finish") {
        library_entry(&cx, "core", "fmt::ReadingWriter!::finish", "fmt::ReadingWriter!::finish")
    } else if name.is(&cx, "Ordering") {
        library_entry(&cx, "core", "atomic::Ordering", "atomic::Ordering")
    } else {
        fail(&cx, Buffer!::new().put("internal error: no library item ").write(&cx, name).save(&cx))
    }
}

// ----------------------------------------------------------------- errors --

// An error of this stage, before its file is known; a `pos` on line 0 is no position. `in_const` is
// set for one met folding a constant.
forall 'k.
exposed struct SigError {
    message: Span['k],
    pos: Pos,
    in_const: bool,
}

forall T, 'k.
fn sig_error(message: Span['k], pos: Pos) -> Result[T, SigError['k]] {
    Result::Err.(SigError.{ message, pos, in_const: false })
}

forall T, 'k.
fn sig_error_static(&cx: Domain!['k], message: Slice[u8, 'static]) -> Result[T, SigError['k]] {
    sig_error(Span::from_static(&cx, message), no_pos())
}

// ------------------------------------------------------------- the results --

// A callable's core signature.
forall 'k.
exposed struct Sig {
    // its core name
    name: Span['k],
    // the Decl, or none for an instance or trait method
    decl: Option[Decl['k]],
    // forall Params, implicit closure environments included
    params: ArenaVec[Param['k], 'k],
    premises: ArenaVec[Premise['k], 'k],
    // parameter names
    pnames: ArenaVec[Span['k], 'k],
    ptypes: ArenaVec[Type['k], 'k],
    // indices of `&` parameters, ascending
    places: ArenaVec[usize, 'k],
    ret: Type['k],
    is_unsafe: bool,
    home: Option[ModuleId['k]],
}

// An instance header before its method bodies have been lowered to core functions.
forall 'k.
exposed struct InstanceSig {
    trait_name: Span['k],
    params: ArenaVec[Param['k], 'k],
    premises: ArenaVec[Premise['k], 'k],
    head: ArenaVec[Type['k], 'k],
    methods: ArenaVec[Sig['k], 'k],
    home: ModuleId['k],
    pos: Pos,
}

// A folded constant. An integer is its value in its type's width, in 64 bits, sign-extended for a
// signed type; its type is an integer `Prim`. A float keeps its digits. A string's type is the one
// wanted where it was folded, if any. An operation the C compiler folds is one on `usize` or `isize`,
// at the target's width; one on floats, or a conversion with a float on either side, in IEEE
// arithmetic; or one on the value of another such operation: its operator is a binary operator's
// instruction (`binop_name`), `int_cast`, `float_cast`, `neg`, `not`, `and` or `or`, and its type the
// result's.
forall 'k.
exposed enum ConstValue {
    Int(u64, Type['k]),
    Bool(bool),
    Float(Span['k], Type['k]),
    Str(Span['k], Option[Type['k]]),
    Op(Span['k], ArenaVec[ConstValue['k], 'k], Type['k]),
}

// `value[2]`: the constant's type.
forall 'k.
fn const_type(&cx: Domain!['k], value: ConstValue['k]) -> Option[Type['k]] {
    match value {
        Int(_v, ty) => Option::Some.(ty),
        Bool(_b) => Option::Some.(C::bool_type(&cx)),
        Float(_t, ty) => Option::Some.(ty),
        Str(_t, ty) => ty,
        Op(_o, _a, ty) => Option::Some.(ty),
    }
}

// `value[0]`: which kind of constant it is.
forall 'k.
fn const_kind(&cx: Domain!['k], value: ConstValue['k]) -> Span['k] {
    match value {
        Int(_v, _t) => Span::from_static(&cx, "int"),
        Bool(_b) => Span::from_static(&cx, "bool"),
        Float(_t, _u) => Span::from_static(&cx, "float"),
        Str(_t, _u) => Span::from_static(&cx, "str"),
        Op(_o, _a, _t) => Span::from_static(&cx, "op"),
    }
}

forall 'k.
fn op_value(&cx: Domain!['k], name: Slice[u8, 'static], operands: ArenaVec[ConstValue['k], 'k], ty: Type['k]) -> ConstValue['k] {
    ConstValue::Op.(Span::from_static(&cx, name), operands, ty)
}

forall 'k.
fn is_op(value: ConstValue['k]) -> bool {
    match value {
        Op(_o, _a, _t) => true,
        _ => false,
    }
}

// Whether `value` is a `bool` constant.
forall 'k.
fn is_boolean(&cx: Domain!['k], value: ConstValue['k]) -> bool {
    match value {
        Bool(_b) => true,
        Op(_o, _a, ty) => C::same(&cx, ty, C::bool_type(&cx)),
        _ => false,
    }
}

// The type of an integer constant, or None for any other constant.
forall 'k.
fn integer_of(&cx: Domain!['k], value: ConstValue['k]) -> Option[Span['k]] {
    match value {
        Int(_v, ty) => integer_type(&cx, Option::Some.(ty)),
        Op(_o, _a, ty) => integer_type(&cx, Option::Some.(ty)),
        _ => Option::None,
    }
}

// The type of a float constant, or none for any other constant.
forall 'k.
fn floating_of(&cx: Domain!['k], value: ConstValue['k]) -> Option[Span['k]] {
    let ty = match value {
        Float(_t, ty) => ty,
        Op(_o, _a, ty) => ty,
        _ => return Option::None,
    };
    match ty {
        Prim(name) => if C::is_float(&cx, name) { Option::Some.(name) } else { Option::None },
        _ => Option::None,
    }
}

// An integer type's name, if `ty` is one.
forall 'k.
fn integer_type(&cx: Domain!['k], ty: Option[Type['k]]) -> Option[Span['k]] {
    match ty {
        Some(t) => match t {
            Prim(name) => if C::is_integer(&cx, name) { Option::Some.(name) } else { Option::None },
            _ => Option::None,
        },
        None => Option::None,
    }
}

forall 'k.
fn is_float_type(&cx: Domain!['k], ty: Option[Type['k]]) -> bool {
    match ty {
        Some(t) => match t {
            Prim(name) => C::is_float(&cx, name),
            _ => false,
        },
        None => false,
    }
}

forall 'k.
fn is_signed(&cx: Domain!['k], name: Span['k]) -> bool {
    name.starts_with(&cx, Span::from_static(&cx, "i"))
}

// A folded integer below zero: a signed value, stored sign-extended, with its top bit set.
forall 'k.
fn is_negative(&cx: Domain!['k], value: u64, ty: Type['k]) -> bool {
    match ty {
        Prim(name) => is_signed(&cx, name) && value >= 9223372036854775808u64,
        _ => false,
    }
}

fn all_bits() -> u64 {
    18446744073709551615u64
}

fn sign_bit() -> u64 {
    9223372036854775808u64
}

// An integer constant's value as Python writes it.
forall 'k.
fn int_text(&cx: Domain!['k], value: u64, name: Span['k]) -> Span['k] {
    if is_signed(&cx, name) && value >= sign_bit() {
        Buffer!::new().put("-").put(0u64 - value).save(&cx)
    } else {
        Buffer!::new().put(value).save(&cx)
    }
}

// ------------------------------------------------------------------ scopes --

// The type names in scope while translating one declaration.
forall 'k.
exposed struct Scope {
    // type parameter -> Copy or Any
    kinds: ArenaMap[Span['k], Kind, 'k],
    brands: ArenaSet[Span['k], 'k],
    // hidden closure environments, when allowed
    implicit: Ref[Option[ArenaVec[Param['k], 'k]], 'k],
}

forall 'k.
fn new_scope(&cx: Domain!['k]) -> Scope['k] {
    Scope.{ kinds: ArenaMap::new(&cx), brands: ArenaSet::new(&cx), implicit: ref_in(&cx, Option::None) }
}

forall 'k.
impl Scope['k] {
    fn extend(self, &cx: Domain!['k], params: ArenaVec[Param['k], 'k]) -> Scope['k] {
        let out = Scope.{ kinds: self.kinds.clone(&cx), brands: self.brands.clone(&cx), implicit: ref_in(&cx, self.implicit.copy(&cx)) };
        var i = 0usize;
        while i < params.len(&cx) {
            let p = params.at(&cx, i);
            let unit = match p.kind {
                Brand => { out.brands.insert(&cx, p.name); },
                _ => { out.kinds.insert(&cx, p.name, p.kind); },
            };
            i = i + 1usize;
        }
        out
    }
}

// ------------------------------------------------------------- the syntax --

// What a signature is made from: a function, a trait method's signature, or an extern.
forall 'k.
exposed struct Header {
    params: ArenaVec[S::Param['k], 'k],
    ret: Option[S::Type['k]],
    quantifier: Option[S::Forall['k]],
    is_unsafe: bool,
    pos: Pos,
}

forall 'k.
fn fn_header(f: S::Fn['k]) -> Header['k] {
    Header.{ params: f.params, ret: f.ret, quantifier: f.quantifier, is_unsafe: f.is_unsafe, pos: f.pos }
}

forall 'k.
fn named_quantifier(node: Named['k]) -> Option[S::Forall['k]] {
    match node {
        Struct(x) => x.quantifier,
        Enum(x) => x.quantifier,
        Tuple(x) => x.quantifier,
        Alias(x) => x.quantifier,
        Fn(x) => x.quantifier,
        Extern(x) => x.quantifier,
        Trait(x) => x.quantifier,
        Const(_x) => Option::None,
    }
}

// A type alias's parameters and the core type it stands for, put in its place wherever it is
// written.
forall 'k.
exposed struct AliasType {
    decl: Decl['k],
    params: ArenaVec[Param['k], 'k],
    body: Type['k],
}

forall 'k.
fn alias_node(&cx: Domain!['k], decl: Decl['k]) -> S::TypeAlias['k] {
    match decl.node {
        Alias(a) => a,
        _ => fail(&cx, Span::from_static(&cx, "internal error: a type alias that declares none")),
    }
}

forall 'k.
fn is_copy_trait(&cx: Domain!['k], path: ArenaVec[Span['k], 'k]) -> bool {
    path.len(&cx) == 1usize && path.at(&cx, 0usize).is(&cx, "Copy")
}

forall 'k.
fn is_skolem(ty: Type['k]) -> bool {
    match ty {
        Skolem(_l) => true,
        _ => false,
    }
}

forall 'k.
fn all_params(&cx: Domain!['k], f: S::Forall['k]) -> ArenaVec[Span['k], 'k] {
    let out = f.params.clone(&cx);
    out.append(&cx, f.determined);
    out
}

// The KURS instruction of a binary operator.
forall 'k.
fn binop_name(&cx: Domain!['k], op: Span['k]) -> Slice[u8, 'static] {
    if op.is(&cx, "+") { "add" } else if op.is(&cx, "-") { "sub" } else if op.is(&cx, "*") { "mul" } else if op.is(&cx, "/") { "div" }
    else if op.is(&cx, "%") { "mod" } else if op.is(&cx, "&") { "bit_and" } else if op.is(&cx, "|") { "bit_or" }
    else if op.is(&cx, "^") { "bit_xor" } else if op.is(&cx, "<<") { "shl" } else if op.is(&cx, ">>") { "shr" }
    else if op.is(&cx, "==") { "eq" } else if op.is(&cx, "!=") { "ne" } else if op.is(&cx, "<") { "lt" } else if op.is(&cx, "<=") { "le" }
    else if op.is(&cx, ">") { "gt" } else { "ge" }
}

forall 'k.
fn is_comparison(&cx: Domain!['k], op: Span['k]) -> bool {
    op.is(&cx, "==") || op.is(&cx, "!=") || op.is(&cx, "<") || op.is(&cx, "<=") || op.is(&cx, ">") || op.is(&cx, ">=")
}

// ------------------------------------------------------------- Signatures --

forall 'k.
exposed struct Signatures {
    r: Resolver['k],
    packages: ArenaVec[Package['k], 'k],
    // package id -> its name in core names
    package_names: ArenaMap[usize, Span['k], 'k],
    types: ArenaMap[Span['k], TypeDecl['k], 'k],
    // decl id -> its signature
    sigs: ArenaMap[u32, Sig['k], 'k],
    traits: ArenaMap[Span['k], C::Trait['k], 'k],
    // (instance with Sig methods, its declaration, its module)
    instances: ArenaVec[(InstanceSig['k], S::InstanceDecl['k], ModuleId['k]), 'k],
    // decl id -> its value
    consts: ArenaMap[u32, ConstValue['k], 'k],
    // the ids of the consts being folded
    folding: ArenaSet[u32, 'k],
    implicit: Ref[u32, 'k],
    // Copy checks of type arguments in type declarations, made once every type is known: the type,
    // the kinds in scope, the declaration and where the argument is written.
    copy_checks: ArenaVec[(Type['k], ArenaMap[Span['k], Kind, 'k], Decl['k], Pos), 'k],
    // The same for the formation of foreach types (`foreach_formation`).
    foreach_checks: ArenaVec[(ForeachType['k], ArenaMap[Span['k], Kind, 'k], Decl['k], Pos), 'k],
    // decl id -> the type alias, in the order they were translated
    aliases: ArenaMap[u32, AliasType['k], 'k],
    // the type declaration or alias being translated
    declaring: Ref[Option[Decl['k]], 'k],
    types_ready: Ref[bool, 'k],
    counter: Fresh['k],
}

forall 'k.
impl Signatures['k] {
    fn new(&cx: Domain!['k], resolver: Resolver['k], counter: Fresh['k]) -> Signatures['k] {
        let packages = resolver.packages;
        let spelled: ArenaSet[Span['k], 'k] = ArenaSet::new(&cx);
        var p = 0usize;
        while p < packages.len(&cx) {
            spelled.insert(&cx, packages.at(&cx, p).name.copy(&cx));
            p = p + 1usize;
        }
        let clash = spelled.len(&cx) != packages.len(&cx);
        let package_names: ArenaMap[usize, Span['k], 'k] = ArenaMap::new(&cx);
        p = 0usize;
        while p < packages.len(&cx) {
            let package = packages.at(&cx, p);
            package_names.insert(&cx, package.id, if clash {
                Buffer!::new().write(&cx, package.name.copy(&cx)).put("#").put(package.id).save(&cx)
            } else {
                package.name.copy(&cx)
            });
            p = p + 1usize;
        }
        let s = Signatures.{
            r: resolver,
            packages,
            package_names,
            types: ArenaMap::new(&cx),
            sigs: ArenaMap::new(&cx),
            traits: ArenaMap::new(&cx),
            instances: ArenaVec::new(&cx),
            consts: ArenaMap::new(&cx),
            folding: ArenaSet::new(&cx),
            implicit: ref_in(&cx, 0u32),
            copy_checks: ArenaVec::new(&cx),
            foreach_checks: ArenaVec::new(&cx),
            aliases: ArenaMap::new(&cx),
            declaring: ref_in(&cx, Option::None),
            types_ready: ref_in(&cx, false),
            counter,
        };
        let order = s.aliases_in_order(&cx);
        let failed: ArenaSet[u32, 'k] = ArenaSet::new(&cx);
        var a = 0usize;
        while a < order.len(&cx) {
            let decl = order.at(&cx, a);
            let named = s.aliases_named(&cx, alias_node(&cx, decl).body);
            var blocked = false;
            var n = 0usize;
            while n < named.len(&cx) {
                blocked = blocked || failed.contains(&cx, named.at(&cx, n).id);
                n = n + 1usize;
            }
            if blocked {
                failed.insert(&cx, decl.id);
            } else {
                resolver.locate(&cx, decl.home, named_pos(decl.node));
                let unit = match s.reported(&cx, s.alias(&cx, decl)) {
                    Some(_t) => (),
                    None => { failed.insert(&cx, decl.id); },
                };
                resolver.unlocate(&cx);
            }
            a = a + 1usize;
        }
        resolver.stop(&cx);
        let scopes = resolver.scopes.values(&cx);
        var i = 0usize;
        while i < scopes.len(&cx) {
            let decls = scopes.at(&cx, i).decls.values(&cx);
            var k = 0usize;
            while k < decls.len(&cx) {
                let decl = decls.at(&cx, k);
                if decl.kind.is(&cx, "struct") || decl.kind.is(&cx, "enum") || decl.kind.is(&cx, "tuple") {
                    resolver.locate(&cx, decl.home, named_pos(decl.node));
                    s.declaring.set(&cx, Option::Some.(decl));
                    let unit = match s.reported(&cx, s.type_decl(&cx, decl)) {
                        Some(type_decl) => { s.types.insert(&cx, s.name(&cx, decl), type_decl); },
                        None => (),
                    };
                    resolver.unlocate(&cx);
                }
                k = k + 1usize;
            }
            i = i + 1usize;
        }
        resolver.stop(&cx);
        let places: ArenaMap[Span['k], (Span['k], Pos), 'k] = ArenaMap::new(&cx);
        i = 0usize;
        while i < scopes.len(&cx) {
            let decls = scopes.at(&cx, i).decls.values(&cx);
            var k = 0usize;
            while k < decls.len(&cx) {
                let decl = decls.at(&cx, k);
                if decl.kind.is(&cx, "struct") || decl.kind.is(&cx, "enum") || decl.kind.is(&cx, "tuple") {
                    places.insert(&cx, s.name(&cx, decl), (resolver.file(&cx, decl.home), name_pos(decl.node)));
                }
                k = k + 1usize;
            }
            i = i + 1usize;
        }
        check_type_expansion(&cx, s.program(&cx), counter, places);
        s.types_ready.set(&cx, true);
        i = 0usize;
        while i < s.copy_checks.len(&cx) {
            let (ty, kinds, declaring, pos) = s.copy_checks.at(&cx, i);
            resolver.locate(&cx, declaring.home, named_pos(declaring.node));
            let unit = s.reported(&cx, s.require_copy(&cx, ty, kinds, pos));
            resolver.unlocate(&cx);
            i = i + 1usize;
        }
        i = 0usize;
        while i < s.foreach_checks.len(&cx) {
            let (formed, kinds, declaring, pos) = s.foreach_checks.at(&cx, i);
            resolver.locate(&cx, declaring.home, named_pos(declaring.node));
            let unit = s.reported(&cx, s.foreach_formation(&cx, formed, kinds, pos));
            resolver.unlocate(&cx);
            i = i + 1usize;
        }
        resolver.stop(&cx);
        s.copy_checks.clear(&cx);
        s.foreach_checks.clear(&cx);
        let types = Types::new(&cx, s.program(&cx), counter);
        i = 0usize;
        while i < scopes.len(&cx) {
            let decls = scopes.at(&cx, i).decls.values(&cx);
            var k = 0usize;
            while k < decls.len(&cx) {
                let decl = decls.at(&cx, k);
                if (decl.kind.is(&cx, "struct") || decl.kind.is(&cx, "enum") || decl.kind.is(&cx, "tuple")) && !decl.name.ends_with(&cx, Span::from_static(&cx, "!")) {
                    resolver.locate(&cx, decl.home, named_pos(decl.node));
                    let unit = s.reported(&cx, s.unmarked(&cx, decl, types));
                    resolver.unlocate(&cx);
                }
                k = k + 1usize;
            }
            i = i + 1usize;
        }
        let translated = s.aliases.values(&cx);
        a = 0usize;
        while a < translated.len(&cx) {
            let alias = translated.at(&cx, a);
            resolver.locate(&cx, alias.decl.home, named_pos(alias.decl.node));
            let unit = s.reported(&cx, s.alias_linearity(&cx, alias, types));
            resolver.unlocate(&cx);
            a = a + 1usize;
        }
        resolver.stop(&cx);
        i = 0usize;
        while i < scopes.len(&cx) {
            let scope = scopes.at(&cx, i);
            let decls = scope.decls.values(&cx);
            var k = 0usize;
            while k < decls.len(&cx) {
                let decl = decls.at(&cx, k);
                resolver.locate(&cx, decl.home, named_pos(decl.node));
                if decl.kind.is(&cx, "trait") {
                    let unit = match s.reported(&cx, s.trait_decl(&cx, decl)) {
                        Some(t) => { s.traits.insert(&cx, s.name(&cx, decl), t); },
                        None => (),
                    };
                } else if decl.kind.is(&cx, "fn") || decl.kind.is(&cx, "method") || decl.kind.is(&cx, "extern") {
                    let unit = match s.reported(&cx, s.decl_signature(&cx, decl)) {
                        Some(sig) => { s.sigs.insert(&cx, decl.id, sig); },
                        None => (),
                    };
                } else if decl.kind.is(&cx, "const") {
                    let unit = s.reported(&cx, s.const_decl(&cx, decl));
                }
                resolver.unlocate(&cx);
                k = k + 1usize;
            }
            var n = 0usize;
            while n < scope.items.len(&cx) {
                let unit = match scope.items.at(&cx, n) {
                    Instance(item) => {
                        resolver.locate(&cx, scope.home, item.pos);
                        let unit = match s.reported(&cx, s.instance_decl(&cx, item, scope.home)) {
                            Some(inst) => { s.instances.push(&cx, inst); },
                            None => (),
                        };
                        resolver.unlocate(&cx);
                    },
                    _ => (),
                };
                n = n + 1usize;
            }
            i = i + 1usize;
        }
        i = 0usize;
        while i < s.instances.len(&cx) {
            let (inst, item, home) = s.instances.at(&cx, i);
            resolver.locate(&cx, home, item.pos);
            let unit = s.reported(&cx, s.conforms(&cx, inst, item));
            resolver.unlocate(&cx);
            i = i + 1usize;
        }
        resolver.stop(&cx);
        s
    }

    // The type declarations so far, as a program.
    fn program(self, &cx: Domain!['k]) -> Program['k] {
        Program.{ types: self.types, funs: ArenaMap::new(&cx), externs: ArenaMap::new(&cx), datas: ArenaMap::new(&cx), traits: ArenaMap::new(&cx), instances: ArenaMap::new(&cx) }
    }

    // ---- errors
    // The value of a step that may fail, stopping if it did.
    forall T.
    fn got(self, &cx: Domain!['k], result: Result[T, SigError['k]]) -> T {
        match result {
            Ok(value) => value,
            Err(e) => self.r.fail(&cx, e.message, e.pos),
        }
    }

    // The value of a step that may fail; if it did, its error is reported, and one in a constant
    // stops with the errors reported.
    forall T.
    fn reported(self, &cx: Domain!['k], result: Result[T, SigError['k]]) -> Option[T] {
        match result {
            Ok(value) => Option::Some.(value),
            Err(e) => {
                self.r.report(&cx, e.message, e.pos);
                if e.in_const {
                    self.r.stop(&cx);
                }
                Option::None
            },
        }
    }

    // ---- naming
    fn name(self, &cx: Domain!['k], decl: Decl['k]) -> Span['k] {
        let parts = ArenaVec::one(&cx, self.package_names.at(&cx, decl.home.package));
        parts.append(&cx, decl.home.path);
        parts.push(&cx, decl.name);
        var out = Buffer!::new();
        var i = 0usize;
        while i < parts.len(&cx) {
            if i > 0usize {
                out = out.put("::");
            }
            out = out.write(&cx, parts.at(&cx, i));
            i = i + 1usize;
        }
        out.save(&cx)
    }

    // Resolve a compiler-known library item in the requesting module's package.
    fn library(self, &cx: Domain!['k], home: ModuleId['k], name: Span['k]) -> Decl['k] {
        let item = library_item(&cx, name);
        match self.r.library(&cx, home, item.home, item.path, item.std_path) {
            Decl(d) => d,
            _ => fail(&cx, f"internal error: library item {name} is not a declaration".write(&cx, Buffer!::new()).save(&cx)),
        }
    }

    // ---- headers
    // Core Params and premises of a `forall` header, and the scope it opens.
    fn quantifier(self, &cx: Domain!['k], header: Option[S::Forall['k]], scope: Scope['k])
        -> Result[(ArenaVec[Param['k], 'k], ArenaVec[Premise['k], 'k], Scope['k]), SigError['k]] {
        let f = match header {
            Some(f) => f,
            None => return Result::Ok.((ArenaVec::new(&cx), ArenaVec::new(&cx), scope)),
        };
        let copy = self.copy_names(&cx, header)?;
        let names = all_params(&cx, f);
        let params: ArenaVec[Param['k], 'k] = ArenaVec::new(&cx);
        var i = 0usize;
        while i < names.len(&cx) {
            let p = names.at(&cx, i);
            params.push(&cx, if p.starts_with(&cx, Span::from_static(&cx, "'")) {
                Param.{ name: p.skip(1usize), kind: Kind::Brand }
            } else {
                Param.{ name: p, kind: if copy.contains(&cx, p) { Kind::Copy } else { Kind::Any } }
            });
            i = i + 1usize;
        }
        let inner = scope.extend(&cx, params);
        let copied = copy.keys(&cx);
        i = 0usize;
        while i < copied.len(&cx) {
            let name = copied.at(&cx, i);
            if !inner.kinds.contains(&cx, name) {
                return sig_error(Buffer!::new().put("Copy requires an in-scope type parameter, not ").write(&cx, name).save(&cx), no_pos());
            }
            inner.kinds.insert(&cx, name, Kind::Copy);
            i = i + 1usize;
        }
        let premises: ArenaVec[Premise['k], 'k] = ArenaVec::new(&cx);
        i = 0usize;
        while i < f.premises.len(&cx) {
            let premise = f.premises.at(&cx, i);
            if !is_copy_trait(&cx, premise.trait_path) {
                premises.push(&cx, self.premise(&cx, premise.args, inner, premise.pos)?);
            }
            i = i + 1usize;
        }
        Result::Ok.((params, premises, inner))
    }

    fn copy_names(self, &cx: Domain!['k], header: Option[S::Forall['k]]) -> Result[ArenaSet[Span['k], 'k], SigError['k]] {
        let names: ArenaSet[Span['k], 'k] = ArenaSet::new(&cx);
        let premises = match header {
            Some(f) => f.premises,
            None => ArenaVec::new(&cx),
        };
        var i = 0usize;
        while i < premises.len(&cx) {
            let premise = premises.at(&cx, i);
            if is_copy_trait(&cx, premise.trait_path) {
                let args = premise.args.args;
                if args.len(&cx) != 1usize {
                    return sig_error_static(&cx, "Copy requires one type parameter");
                }
                let arg = match args.at(&cx, 0usize) {
                    Name(n) => n,
                    _ => return sig_error_static(&cx, "Copy requires one type parameter"),
                };
                let param = match self.r.refs.get(&cx, arg.id) {
                    Some(r) => match r {
                        Param(name) => Option::Some.(name),
                        _ => Option::None,
                    },
                    None => Option::None,
                };
                if !arg.args.is_empty(&cx) || arg.path.len(&cx) != 1usize || param.is_none() {
                    return sig_error_static(&cx, "Copy requires one bare, in-scope type parameter");
                }
                let unit = match param {
                    Some(name) => { names.insert(&cx, name); },
                    None => (),
                };
            }
            i = i + 1usize;
        }
        Result::Ok.(names)
    }

    // The premise whose trait's path, written at `pos`, has the arguments `args`.
    fn premise(self, &cx: Domain!['k], args: S::TypeArgs['k], scope: Scope['k], pos: Pos) -> Result[Premise['k], SigError['k]] {
        let r = match self.r.refs.get(&cx, args.id) {
            Some(r) => r,
            None => fail(&cx, Span::from_static(&cx, "internal error: an unresolved premise")),
        };
        let builtin = match r {
            Builtin(name) => if name.is(&cx, "Exposed") || name.is(&cx, "Sized") { Option::Some.(name) } else { Option::None },
            _ => Option::None,
        };
        let unit = match builtin {
            Some(name) => if args.args.len(&cx) != 1usize {
                return sig_error(Buffer!::new().write(&cx, name).put(" takes 1 type argument, got ").put(args.args.len(&cx)).save(&cx), pos);
            },
            None => (),
        };
        let actual = self.type_list(&cx, args.args, scope)?;
        match builtin {
            Some(name) => { return Result::Ok.(Premise.{ trait_name: name, args: actual }); },
            None => (),
        };
        let decl = match r {
            Decl(d) => d,
            _ => fail(&cx, Span::from_static(&cx, "internal error: a premise that names no trait")),
        };
        let unit = self.check_arguments(&cx, decl, actual, scope, pos)?;
        Result::Ok.(Premise.{ trait_name: self.name(&cx, decl), args: actual })
    }

    // The type arguments `args` of `decl`, written at `pos`.
    fn check_arguments(self, &cx: Domain!['k], decl: Decl['k], args: ArenaVec[Type['k], 'k], scope: Scope['k], pos: Pos) -> Result[bool, SigError['k]] {
        let header = named_quantifier(decl.node);
        let params = match header {
            Some(f) => all_params(&cx, f),
            None => if decl.kind.is(&cx, "trait") { ArenaVec::one(&cx, Span::from_static(&cx, "Self")) } else { ArenaVec::new(&cx) },
        };
        if args.len(&cx) != params.len(&cx) {
            return sig_error(Buffer!::new().write(&cx, decl.name).put(" takes ").write(&cx, counted(&cx, params.len(&cx), "type argument")).put(", got ").put(args.len(&cx)).save(&cx), pos);
        }
        let copied = match self.copy_names(&cx, header) {
            Ok(c) => c,
            Err(e) => return Result::Err.(e),
        };
        var i = 0usize;
        while i < params.len(&cx) {
            let param = params.at(&cx, i);
            let arg = args.at(&cx, i);
            if param.starts_with(&cx, Span::from_static(&cx, "'")) != is_skolem(arg) {
                return sig_error(f"argument for {param} of {decl.name} has the wrong kind (brand versus type)".write(&cx, Buffer!::new()).save(&cx), pos);
            }
            if copied.contains(&cx, param) {
                let unit = self.require_copy(&cx, arg, scope.kinds, pos)?;
            }
            i = i + 1usize;
        }
        Result::Ok.(true)
    }

    fn require_copy(self, &cx: Domain!['k], ty: Type['k], kinds: ArenaMap[Span['k], Kind, 'k], pos: Pos) -> Result[bool, SigError['k]] {
        if !self.types_ready.copy(&cx) {
            match self.declaring.copy(&cx) {
                Some(d) => self.copy_checks.push(&cx, (ty, kinds.clone(&cx), d, pos)),
                None => fail(&cx, Span::from_static(&cx, "internal error: a Copy check outside a type declaration")),
            }
        } else if !Types::new(&cx, self.program(&cx), self.counter).is_copy(&cx, ty, kinds) {
            return sig_error(Span::from_static(&cx, "type argument must satisfy Copy"), pos);
        }
        Result::Ok.(true)
    }

    // The foreach type `ty`, written at `pos`, has an expansion at every instantiation, as type
    // formation requires: a `*F` pattern's source whose shape is decided is written with pointer
    // components, and the walk of `ty` asks for an explicit pointer where a type parameter decides it.
    // Inside a type declaration it waits until every type is known.
    fn foreach_formation(self, &cx: Domain!['k], ty: ForeachType['k], kinds: ArenaMap[Span['k], Kind, 'k], pos: Pos) -> Result[bool, SigError['k]] {
        if !self.types_ready.copy(&cx) {
            match self.declaring.copy(&cx) {
                Some(d) => self.foreach_checks.push(&cx, (ty, kinds.clone(&cx), d, pos)),
                None => fail(&cx, Span::from_static(&cx, "internal error: a foreach formation check outside a type declaration")),
            }
            return Result::Ok.(true);
        }
        let types = Types::new(&cx, self.program(&cx), self.counter);
        if ty.indirect && types.rows_fixed(&cx, ty.source.copy(&cx), true, kinds) && !types.pattern_available(&cx, ty) {
            return sig_error(f"foreach *{ty.binder} needs a source written with pointer components".write(&cx, Buffer!::new()).save(&cx), pos);
        }
        match check_written_type(&cx, self.program(&cx), self.counter, Type::Foreach.(ty), with_names(&cx, ArenaSet::new(&cx), kinds.keys(&cx))) {
            Ok(_u) => Result::Ok.(true),
            Err(message) => sig_error(message, pos),
        }
    }

    // ---- types
    // The types written in `exprs`, in order.
    fn type_list(self, &cx: Domain!['k], exprs: ArenaVec[S::Type['k], 'k], scope: Scope['k]) -> Result[ArenaVec[Type['k], 'k], SigError['k]] {
        let out: ArenaVec[Type['k], 'k] = ArenaVec::new(&cx);
        var i = 0usize;
        while i < exprs.len(&cx) {
            out.push(&cx, self.ty(&cx, exprs.at(&cx, i), scope)?);
            i = i + 1usize;
        }
        Result::Ok.(out)
    }

    fn slot_types(self, &cx: Domain!['k], slots: ArenaVec[S::Slot['k], 'k], scope: Scope['k]) -> Result[ArenaVec[Type['k], 'k], SigError['k]] {
        let out: ArenaVec[Type['k], 'k] = ArenaVec::new(&cx);
        var i = 0usize;
        while i < slots.len(&cx) {
            out.push(&cx, self.ty(&cx, slots.at(&cx, i).ty, scope)?);
            i = i + 1usize;
        }
        Result::Ok.(out)
    }

    fn ty(self, &cx: Domain!['k], type_expr: S::Type['k], scope: Scope['k]) -> Result[Type['k], SigError['k]] {
        match type_expr {
            Name(n) => {
                let args = self.type_list(&cx, n.args, scope)?;
                let not_a_type = Buffer!::new().put("not a type name: ").write(&cx, n.path.join(&cx, "::")).save(&cx);
                let r = match self.r.refs.get(&cx, n.id) {
                    Some(r) => r,
                    None => return sig_error(not_a_type, n.pos),
                };
                match r {
                    Param(name) => if !args.is_empty(&cx) {
                        sig_error(f"type parameter {name} takes no type arguments".write(&cx, Buffer!::new()).save(&cx), n.pos)
                    } else {
                        Result::Ok.(C::named(name, ArenaVec::new(&cx)))
                    },
                    Prim(name) => if !args.is_empty(&cx) {
                        sig_error(f"primitive {name} takes no type arguments".write(&cx, Buffer!::new()).save(&cx), n.pos)
                    } else {
                        Result::Ok.(Type::Prim.(name))
                    },
                    Builtin(name) => if name.is(&cx, "Brand") {
                        if args.len(&cx) != 1usize || !is_skolem(args.at(&cx, 0usize)) {
                            sig_error(Span::from_static(&cx, "Brand requires exactly one brand argument"), n.pos)
                        } else {
                            Result::Ok.(Type::Brand.(ref_in(&cx, args.at(&cx, 0usize))))
                        }
                    } else if name.is(&cx, "NonNull") {
                        if args.len(&cx) != 1usize || is_skolem(args.at(&cx, 0usize)) {
                            sig_error(Span::from_static(&cx, "NonNull requires exactly one type argument"), n.pos)
                        } else {
                            Result::Ok.(C::non_null(&cx, args.at(&cx, 0usize)))
                        }
                    } else if name.is(&cx, "Never") {
                        if !args.is_empty(&cx) {
                            sig_error(Span::from_static(&cx, "Never takes no type arguments"), n.pos)
                        } else {
                            Result::Ok.(Type::Never)
                        }
                    } else {
                        sig_error(not_a_type, n.pos)
                    },
                    Decl(decl) => {
                        let unit = self.check_arguments(&cx, decl, args, scope, n.pos)?;
                        if decl.kind.is(&cx, "alias") {
                            let alias = self.alias(&cx, decl)?;
                            let sub: ArenaMap[Span['k], Type['k], 'k] = ArenaMap::new(&cx);
                            var i = 0usize;
                            while i < alias.params.len(&cx) {
                                sub.insert(&cx, alias.params.at(&cx, i).name, args.at(&cx, i));
                                i = i + 1usize;
                            }
                            return Result::Ok.(subst(&cx, alias.body, sub, self.counter));
                        }
                        Result::Ok.(C::named(self.name(&cx, decl), args))
                    },
                    _ => sig_error(not_a_type, n.pos),
                }
            },
            Brand(quoted) => {
                let label = quoted.skip(1usize);
                if !scope.brands.contains(&cx, label) && !label.is(&cx, "static") {
                    return sig_error(f"brand '{label} is not in scope".write(&cx, Buffer!::new()).save(&cx), no_pos());
                }
                Result::Ok.(Type::Skolem.(label))
            },
            Ptr(inner) => Result::Ok.(C::ptr(&cx, self.ty(&cx, inner.copy(&cx), scope)?)),
            Never => Result::Ok.(Type::Never),
            Tuple(elems) => Result::Ok.(Type::Tuple.(self.type_list(&cx, elems, scope)?)),
            Array(elem, length) => {
                let elem_type = self.ty(&cx, elem.copy(&cx), scope)?;
                let count = self.array_length(&cx, length.copy(&cx))?;
                Result::Ok.(Type::Array.(ref_in(&cx, elem_type), count))
            },
            Fn(f) => {
                let params = self.slot_types(&cx, f.params, scope)?;
                let ret = self.ty(&cx, f.ret.copy(&cx), scope)?;
                Result::Ok.(C::fn_type(&cx, params, ret, f.is_unsafe, places_of(&cx, f.params, 0usize)))
            },
            Closure(c) => {
                let environment = match c.env {
                    Some(env) => self.ty(&cx, env.copy(&cx), scope)?,
                    None => match scope.implicit.copy(&cx) {
                        Some(implicit) => {
                            self.implicit.set(&cx, self.implicit.copy(&cx) + 1u32);
                            let name = Buffer!::new().put("Env#").put(self.implicit.copy(&cx)).save(&cx);
                            implicit.push(&cx, Param.{ name, kind: Kind::Any });
                            C::named(name, ArenaVec::new(&cx))
                        },
                        None => return sig_error_static(&cx, "a closure type needs [Env] outside a parameter list"),
                    },
                };
                let params = ArenaVec::one(&cx, environment);
                params.append(&cx, self.slot_types(&cx, c.params, scope)?);
                let ret = self.ty(&cx, c.ret.copy(&cx), scope)?;
                let code = C::fn_type(&cx, params, ret, false, places_of(&cx, c.params, 1usize));
                Result::Ok.(Type::Struct.(ArenaVec::two(&cx, Member.{ name: Span::from_static(&cx, "env"), ty: environment }, Member.{ name: Span::from_static(&cx, "code"), ty: code })))
            },
            Exists(brands, at, body) => {
                let labels: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
                let binders: ArenaVec[Param['k], 'k] = ArenaVec::new(&cx);
                var i = 0usize;
                while i < brands.len(&cx) {
                    let label = brands.at(&cx, i).skip(1usize);
                    if labels.contains(&cx, label) {
                        return sig_error(Span::from_static(&cx, "an exists type repeats a binder"), at.at(&cx, i));
                    }
                    if scope.brands.contains(&cx, label) || label.is(&cx, "static") {
                        return sig_error(f"exists binder '{label} shadows a brand in scope".write(&cx, Buffer!::new()).save(&cx), at.at(&cx, i));
                    }
                    labels.push(&cx, label);
                    binders.push(&cx, Param.{ name: label, kind: Kind::Brand });
                    i = i + 1usize;
                }
                let inner = self.ty(&cx, body.copy(&cx), scope.extend(&cx, binders))?;
                Result::Ok.(Type::Exists.(labels, ref_in(&cx, inner)))
            },
            Foreach(f) => {
                let source = self.ty(&cx, f.source.copy(&cx), scope)?;
                let bound = ArenaVec::one(&cx, Param.{ name: f.binder, kind: Kind::Any });
                let body = self.ty(&cx, f.body.copy(&cx), scope.extend(&cx, bound))?;
                let formed = ForeachType.{ binder: f.binder, indirect: f.indirect, source: ref_in(&cx, source), body: ref_in(&cx, body) };
                let unit = self.foreach_formation(&cx, formed, scope.kinds, f.pos)?;
                Result::Ok.(Type::Foreach.(formed))
            },
            Ignored(at) => sig_error(Span::from_static(&cx, "_ stands for a type argument only in an expression, where inference fills it in"), at),
        }
    }

    // An array length is folded as a usize, but a literal with another integer suffix keeps its
    // own type: the length is the value's 64 bits, so a negative length of a signed type is its
    // two's complement. A type's array length is the compiler's to know, and arithmetic on `usize` and
    // `isize` is the C compiler's to fold.
    fn array_length(self, &cx: Domain!['k], expr: Expr['k]) -> Result[u64, SigError['k]] {
        match self.fold(&cx, expr, Option::Some.(C::usize_type(&cx)), Option::None, true)? {
            Int(value, ty) => if is_negative(&cx, value, ty) {
                sig_error_static(&cx, "negative array length")
            } else if value == 0u64 {
                sig_error(Span::from_static(&cx, "an array has at least one element"), S::expr_pos(expr))
            } else {
                Result::Ok.(value)
            },
            Op(_o, _a, _t) => sig_error_static(&cx, "an array length cannot use arithmetic on usize or isize"),
            _ => sig_error_static(&cx, "an array length is an integer constant"),
        }
    }

    // ---- type aliases
    // Every type alias, each after the aliases its body names. An alias that refers to itself,
    // directly or through others, is reported, and left out with every alias that names it.
    fn aliases_in_order(self, &cx: Domain!['k]) -> ArenaVec[Decl['k], 'k] {
        let order: ArenaVec[Decl['k], 'k] = ArenaVec::new(&cx);
        let done: ArenaMap[u32, bool, 'k] = ArenaMap::new(&cx);
        let stack: ArenaVec[Decl['k], 'k] = ArenaVec::new(&cx);
        let scopes = self.r.scopes.values(&cx);
        var i = 0usize;
        while i < scopes.len(&cx) {
            let decls = scopes.at(&cx, i).decls.values(&cx);
            var k = 0usize;
            while k < decls.len(&cx) {
                if decls.at(&cx, k).kind.is(&cx, "alias") {
                    let fine = self.visit_alias(&cx, decls.at(&cx, k), order, done, stack);
                }
                k = k + 1usize;
            }
            i = i + 1usize;
        }
        order
    }

    // Whether `decl` and every alias it names stand for a type, with no cycle; `stack` holds the
    // aliases whose visit is under way.
    fn visit_alias(self, &cx: Domain!['k], decl: Decl['k], order: ArenaVec[Decl['k], 'k], done: ArenaMap[u32, bool, 'k], stack: ArenaVec[Decl['k], 'k]) -> bool {
        match done.get(&cx, decl.id) {
            Some(fine) => return fine,
            None => (),
        }
        let node = alias_node(&cx, decl);
        var at = 0usize;
        while at < stack.len(&cx) {
            if stack.at(&cx, at).id == decl.id {
                var message = Buffer!::new().put("type alias ").write(&cx, decl.name).put(" refers to itself");
                var k = at + 1usize;
                while k < stack.len(&cx) {
                    message = message.put(if k == at + 1usize { " through " } else { ", " }).write(&cx, stack.at(&cx, k).name);
                    k = k + 1usize;
                }
                self.r.locate(&cx, decl.home, node.pos);
                self.r.report(&cx, message.save(&cx), node.pos);
                self.r.unlocate(&cx);
                return false;
            }
            at = at + 1usize;
        }
        stack.push(&cx, decl);
        let named = self.aliases_named(&cx, node.body);
        var fine = true;
        var i = 0usize;
        while i < named.len(&cx) {
            fine = self.visit_alias(&cx, named.at(&cx, i), order, done, stack) && fine;
            i = i + 1usize;
        }
        let top = stack.pop(&cx);
        done.insert(&cx, decl.id, fine);
        if fine {
            order.push(&cx, decl);
        }
        fine
    }

    // The type aliases that `ty` names, in the order they are written.
    fn aliases_named(self, &cx: Domain!['k], ty: S::Type['k]) -> ArenaVec[Decl['k], 'k] {
        let out: ArenaVec[Decl['k], 'k] = ArenaVec::new(&cx);
        self.add_aliases_named(&cx, ty, out);
        out
    }

    fn add_aliases_named(self, &cx: Domain!['k], ty: S::Type['k], out: ArenaVec[Decl['k], 'k]) {
        match ty {
            Name(n) => {
                let unit = match self.r.refs.get(&cx, n.id) {
                    Some(r) => match r {
                        Decl(d) => if d.kind.is(&cx, "alias") {
                            out.push(&cx, d);
                        },
                        _ => (),
                    },
                    None => (),
                };
                self.add_all_aliases_named(&cx, n.args, out);
            },
            Ptr(inner) => self.add_aliases_named(&cx, inner.copy(&cx), out),
            Tuple(elems) => self.add_all_aliases_named(&cx, elems, out),
            Array(elem, _length) => self.add_aliases_named(&cx, elem.copy(&cx), out),
            Fn(f) => {
                self.add_slot_aliases_named(&cx, f.params, out);
                self.add_aliases_named(&cx, f.ret.copy(&cx), out);
            },
            Closure(c) => {
                self.add_slot_aliases_named(&cx, c.params, out);
                self.add_aliases_named(&cx, c.ret.copy(&cx), out);
                let unit = match c.env {
                    Some(env) => self.add_aliases_named(&cx, env.copy(&cx), out),
                    None => (),
                };
            },
            Exists(_brands, _at, body) => self.add_aliases_named(&cx, body.copy(&cx), out),
            Foreach(f) => {
                self.add_aliases_named(&cx, f.source.copy(&cx), out);
                self.add_aliases_named(&cx, f.body.copy(&cx), out);
            },
            _ => (),
        }
    }

    fn add_all_aliases_named(self, &cx: Domain!['k], types: ArenaVec[S::Type['k], 'k], out: ArenaVec[Decl['k], 'k]) {
        var i = 0usize;
        while i < types.len(&cx) {
            self.add_aliases_named(&cx, types.at(&cx, i), out);
            i = i + 1usize;
        }
    }

    fn add_slot_aliases_named(self, &cx: Domain!['k], slots: ArenaVec[S::Slot['k], 'k], out: ArenaVec[Decl['k], 'k]) {
        var i = 0usize;
        while i < slots.len(&cx) {
            self.add_aliases_named(&cx, slots.at(&cx, i).ty, out);
            i = i + 1usize;
        }
    }

    // The parameters of the type alias `decl` and the core type it stands for. Its forall lists only
    // parameters, and its body uses each of them.
    fn alias(self, &cx: Domain!['k], decl: Decl['k]) -> Result[AliasType['k], SigError['k]] {
        match self.aliases.get(&cx, decl.id) {
            Some(a) => return Result::Ok.(a),
            None => (),
        }
        let node = alias_node(&cx, decl);
        if node.exposure.is_some() {
            return sig_error(Span::from_static(&cx, "a type alias is never exposed: it has no representation of its own"), node.pos);
        }
        let unit = match node.quantifier {
            Some(f) => if !f.premises.is_empty(&cx) || !f.determined.is_empty(&cx) {
                return sig_error(f"type alias {decl.name} takes no premises or determined parameters".write(&cx, Buffer!::new()).save(&cx), node.pos);
            },
            None => (),
        };
        let declaring = self.declaring.copy(&cx);
        self.declaring.set(&cx, Option::Some.(decl));
        let translated = self.alias_body(&cx, node);
        self.declaring.set(&cx, declaring);
        let (params, body) = translated?;
        let used = free_names(&cx, body);
        var i = 0usize;
        while i < params.len(&cx) {
            let p = params.at(&cx, i);
            if !used.contains(&cx, p.name) {
                let spelled = match p.kind {
                    Brand => Buffer!::new().put("'").write(&cx, p.name).save(&cx),
                    _ => p.name,
                };
                return sig_error(f"type alias {decl.name} does not use its parameter {spelled}".write(&cx, Buffer!::new()).save(&cx), node.pos);
            }
            i = i + 1usize;
        }
        let alias = AliasType.{ decl, params, body };
        self.aliases.insert(&cx, decl.id, alias);
        Result::Ok.(alias)
    }

    fn alias_body(self, &cx: Domain!['k], node: S::TypeAlias['k]) -> Result[(ArenaVec[Param['k], 'k], Type['k]), SigError['k]] {
        let (params, _premises, scope) = self.quantifier(&cx, node.quantifier, new_scope(&cx))?;
        Result::Ok.((params, self.ty(&cx, node.body, scope)?))
    }

    // A type alias's name ends with `!` exactly when the type it stands for is linear whatever its
    // type arguments are.
    fn alias_linearity(self, &cx: Domain!['k], alias: AliasType['k], types: Types['k]) -> Result[bool, SigError['k]] {
        let kinds: ArenaMap[Span['k], Kind, 'k] = ArenaMap::new(&cx);
        var i = 0usize;
        while i < alias.params.len(&cx) {
            let p = alias.params.at(&cx, i);
            let unit = match p.kind {
                Brand => (),
                _ => { kinds.insert(&cx, p.name, Kind::Copy); },
            };
            i = i + 1usize;
        }
        let name = alias.decl.name;
        let marked = name.ends_with(&cx, Span::from_static(&cx, "!"));
        let linear = !types.is_copy(&cx, alias.body, kinds);
        let at = alias_node(&cx, alias.decl).name_pos;
        if linear && !marked {
            return sig_error(f"type alias {name} stands for a linear type; name it {name}!".write(&cx, Buffer!::new()).save(&cx), at);
        }
        if !linear && marked {
            return sig_error(Buffer!::new().put("type alias ").write(&cx, name).put(" stands for a type that is not linear; name it ").write(&cx, name.take(name.len() - 1usize)).save(&cx), at);
        }
        Result::Ok.(true)
    }

    // ---- declarations
    fn type_decl(self, &cx: Domain!['k], decl: Decl['k]) -> Result[TypeDecl['k], SigError['k]] {
        let (params, premises, scope) = self.quantifier(&cx, named_quantifier(decl.node), new_scope(&cx))?;
        var p = 0usize;
        while p < premises.len(&cx) {
            if premises.at(&cx, p).trait_name.is(&cx, "Sized") {
                return sig_error(Span::from_static(&cx, "Sized is a premise of functions and instances, not of a type declaration"), named_pos(decl.node));
            }
            p = p + 1usize;
        }
        let (body, written) = match decl.node {
            Struct(node) => {
                let fields: ArenaVec[Member['k], 'k] = ArenaVec::new(&cx);
                var i = 0usize;
                while i < node.fields.len(&cx) {
                    let field = node.fields.at(&cx, i);
                    fields.push(&cx, Member.{ name: field.name, ty: self.ty(&cx, field.ty, scope)? });
                    i = i + 1usize;
                }
                (Type::Struct.(fields), node.exposure)
            },
            Tuple(node) => (Type::Tuple.(self.type_list(&cx, node.elems, scope)?), node.exposure),
            Enum(node) => {
                if node.variants.is_empty(&cx) {
                    return sig_error(f"enum {node.name} has no variant; an enum has at least one".write(&cx, Buffer!::new()).save(&cx), node.pos);
                }
                let variants: ArenaVec[Member['k], 'k] = ArenaVec::new(&cx);
                var i = 0usize;
                while i < node.variants.len(&cx) {
                    let variant = node.variants.at(&cx, i);
                    variants.push(&cx, Member.{ name: variant.name, ty: self.payload(&cx, variant.payload, scope)? });
                    i = i + 1usize;
                }
                (Type::Enum.(variants), node.exposure)
            },
            _ => fail(&cx, Span::from_static(&cx, "internal error: a type declaration that declares no type")),
        };
        var exposure = Option::Some.(Exposure.{ mode: ExposureMode::Owner, home: decl.home });
        let unit = match written {
            Some(e) => {
                exposure = match e.scope {
                    Some(path) => Option::Some.(Exposure.{ mode: ExposureMode::Within, home: self.scope_module(&cx, decl, path)? }),
                    None => Option::None,
                };
            },
            None => (),
        };
        Result::Ok.(TypeDecl.{ name: self.name(&cx, decl), params, premises, body, home: Option::Some.(decl.home), exposure })
    }

    // A declaration whose name has no `!` is not linear for every instantiation: it is Copy when its
    // type arguments are.
    fn unmarked(self, &cx: Domain!['k], decl: Decl['k], types: Types['k]) -> Result[bool, SigError['k]] {
        let td = self.types.at(&cx, self.name(&cx, decl));
        let args: ArenaVec[Type['k], 'k] = ArenaVec::new(&cx);
        let kinds: ArenaMap[Span['k], Kind, 'k] = ArenaMap::new(&cx);
        var generic = false;
        var i = 0usize;
        while i < td.params.len(&cx) {
            let p = td.params.at(&cx, i);
            if C::same_kind(p.kind, Kind::Brand) {
                args.push(&cx, Type::Skolem.(p.name));
            } else {
                args.push(&cx, C::named(p.name, ArenaVec::new(&cx)));
                kinds.insert(&cx, p.name, Kind::Copy);
                generic = true;
            }
            i = i + 1usize;
        }
        if types.is_copy(&cx, C::named(td.name, args), kinds) {
            return Result::Ok.(true);
        }
        // the first field, variant or element that is linear when every type argument is Copy
        var part = Span::from_static(&cx, "");
        let (members, label) = match td.body {
            Struct(fields) => (fields, " in its field "),
            Enum(variants) => (variants, " in its variant "),
            _ => (ArenaVec::new(&cx), ""),
        };
        i = 0usize;
        while i < members.len(&cx) && part.is_empty() {
            if !types.is_copy(&cx, members.at(&cx, i).ty, kinds) {
                part = Buffer!::new().put(label).write(&cx, members.at(&cx, i).name).save(&cx);
            }
            i = i + 1usize;
        }
        let unit = match td.body {
            Tuple(elems) => {
                i = 0usize;
                while i < elems.len(&cx) && part.is_empty() {
                    if !types.is_copy(&cx, elems.at(&cx, i), kinds) {
                        part = Buffer!::new().put(" in its element ").put(i).save(&cx);
                    }
                    i = i + 1usize;
                }
            },
            _ => (),
        };
        sig_error(Buffer!::new().write(&cx, decl.kind).put(" ").write(&cx, decl.name).put(" holds a linear type").write(&cx, part)
            .put(if generic { " whatever its type arguments" } else { "" }).put("; declare it ").write(&cx, decl.name).put("!").save(&cx), name_pos(decl.node))
    }

    fn payload(self, &cx: Domain!['k], types: ArenaVec[S::Type['k], 'k], scope: Scope['k]) -> Result[Type['k], SigError['k]] {
        if types.is_empty(&cx) {
            return Result::Ok.(C::unit(&cx));
        }
        if types.len(&cx) == 1usize {
            return self.ty(&cx, types.at(&cx, 0usize), scope);
        }
        Result::Ok.(Type::Tuple.(self.type_list(&cx, types, scope)?))
    }

    fn scope_module(self, &cx: Domain!['k], decl: Decl['k], path: ArenaVec[Span['k], 'k]) -> Result[ModuleId['k], SigError['k]] {
        let target = match self.r.need(&cx, decl.home, path, no_pos()) {
            Module(m) => Option::Some.(m),
            _ => Option::None,
        };
        match target {
            Some(m) => if decl.home.within(&cx, m) {
                return Result::Ok.(m);
            },
            None => (),
        };
        sig_error(Buffer!::new().put("an exposure scope is an enclosing module of ").write(&cx, decl.name).save(&cx), no_pos())
    }

    // The signature of a function, method or extern declaration.
    fn decl_signature(self, &cx: Domain!['k], decl: Decl['k]) -> Result[Sig['k], SigError['k]] {
        let node = match decl.node {
            Fn(f) => fn_header(f),
            Extern(x) => {
                if !x.abi.is(&cx, "C") {
                    return sig_error(Span::from_static(&cx, "the only extern ABI is \"C\""), x.abi_pos);
                }
                Header.{ params: x.params, ret: x.ret, quantifier: x.quantifier, is_unsafe: true, pos: x.pos }
            },
            _ => fail(&cx, Span::from_static(&cx, "internal error: a signature of a declaration that is not callable")),
        };
        self.signature(&cx, Option::Some.(decl), node, ArenaVec::new(&cx), ArenaVec::new(&cx), Option::None, Option::None)
    }

    fn signature(self, &cx: Domain!['k], decl: Option[Decl['k]], node: Header['k], outer: ArenaVec[Param['k], 'k], outer_premises: ArenaVec[Premise['k], 'k],
                 outer_scope: Option[Scope['k]], name: Option[Span['k]]) -> Result[Sig['k], SigError['k]] {
        var scope = match outer_scope {
            Some(s) => s,
            None => new_scope(&cx),
        };
        var outer = outer;
        var outer_premises = outer_premises;
        // a method's impl, which also gives `self` its type
        var method_impl = Option::None;
        let unit = match decl {
            Some(d) => if d.kind.is(&cx, "method") {
                method_impl = d.impl_block;
            },
            None => (),
        };
        let unit = match method_impl {
            Some(impl_block) => {
                let (impl_params, impl_premises, inner) = self.quantifier(&cx, impl_block.quantifier, scope)?;
                outer = outer.concat(&cx, impl_params);
                outer_premises = outer_premises.concat(&cx, impl_premises);
                scope = inner;
            },
            None => (),
        };
        let (params, premises, inner) = self.quantifier(&cx, node.quantifier, scope)?;
        let scope = inner;
        let copied = self.copy_names(&cx, node.quantifier)?;
        let adjusted: ArenaVec[Param['k], 'k] = ArenaVec::new(&cx);
        var i = 0usize;
        while i < outer.len(&cx) {
            let p = outer.at(&cx, i);
            let any = match p.kind {
                Any => true,
                _ => false,
            };
            adjusted.push(&cx, if copied.contains(&cx, p.name) && any { Param.{ name: p.name, kind: Kind::Copy } } else { p });
            i = i + 1usize;
        }
        let outer = adjusted;
        i = 0usize;
        while i < outer.len(&cx) {
            let p = outer.at(&cx, i);
            let unit = match p.kind {
                Brand => (),
                _ => { scope.kinds.insert(&cx, p.name, p.kind); },
            };
            i = i + 1usize;
        }
        let implicit: ArenaVec[Param['k], 'k] = ArenaVec::new(&cx);
        scope.implicit.set(&cx, Option::Some.(implicit));
        let pnames: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
        let ptypes: ArenaVec[Type['k], 'k] = ArenaVec::new(&cx);
        let places: ArenaVec[usize, 'k] = ArenaVec::new(&cx);
        var k = 0usize;
        while k < node.params.len(&cx) {
            let p = node.params.at(&cx, k);
            let unit = match p.ty {
                None => {
                    let self_type = match method_impl {
                        Some(impl_block) => if p.name.is(&cx, "self") { Option::Some.(impl_block.ty) } else { Option::None },
                        None => Option::None,
                    };
                    match self_type {
                        Some(t) => ptypes.push(&cx, self.ty(&cx, t, scope)?),
                        None => return sig_error(f"parameter {p.name} needs a type".write(&cx, Buffer!::new()).save(&cx), node.pos),
                    }
                },
                Some(t) => ptypes.push(&cx, self.ty(&cx, t, scope)?),
            };
            let unit = match decl {
                Some(d) => if d.kind.is(&cx, "extern") && !implicit.is_empty(&cx) {
                    return sig_error(f"a closure parameter of extern {d.name} needs [Env]".write(&cx, Buffer!::new()).save(&cx), p.pos);
                },
                None => (),
            };
            pnames.push(&cx, p.name);
            if p.lend {
                places.push(&cx, k);
            }
            k = k + 1usize;
        }
        scope.implicit.set(&cx, Option::None);
        let ret = match node.ret {
            None => C::unit(&cx),
            Some(t) => self.ty(&cx, t, scope)?,
        };
        let core_name = match name {
            Some(n) => n,
            None => match decl {
                Some(d) => self.name(&cx, d),
                None => fail(&cx, Span::from_static(&cx, "internal error: a signature without a name")),
            },
        };
        let all = outer.concat(&cx, params).concat(&cx, implicit);
        let home = match decl {
            Some(d) => Option::Some.(d.home),
            None => Option::None,
        };
        Result::Ok.(Sig.{ name: core_name, decl, params: all, premises: outer_premises.concat(&cx, premises), pnames, ptypes, places, ret,
                          is_unsafe: node.is_unsafe, home })
    }

    fn trait_decl(self, &cx: Domain!['k], decl: Decl['k]) -> Result[C::Trait['k], SigError['k]] {
        let node = match decl.node {
            Trait(t) => t,
            _ => fail(&cx, Span::from_static(&cx, "internal error: a trait declaration that declares no trait")),
        };
        let (declared, premises, declared_scope) = self.quantifier(&cx, node.quantifier, new_scope(&cx))?;
        if !premises.is_empty(&cx) {
            return sig_error(Span::from_static(&cx, "trait declarations cannot have their own trait premises"), node.pos);
        }
        let self_param = Param.{ name: Span::from_static(&cx, "Self"), kind: Kind::Any };
        let (params, scope) = if node.quantifier.is_none() {
            (ArenaVec::one(&cx, self_param), declared_scope.extend(&cx, ArenaVec::one(&cx, self_param)))
        } else {
            (declared, declared_scope)
        };
        let methods: ArenaVec[C::Method['k], 'k] = ArenaVec::new(&cx);
        var i = 0usize;
        while i < node.methods.len(&cx) {
            let m = node.methods.at(&cx, i);
            var d = 0usize;
            while d < methods.len(&cx) {
                if methods.at(&cx, d).name.eq(&cx, m.name) {
                    return sig_error(f"method {m.name} is declared twice".write(&cx, Buffer!::new()).save(&cx), m.pos);
                }
                d = d + 1usize;
            }
            let sig = self.signature(&cx, Option::None, fn_header(m), ArenaVec::new(&cx), ArenaVec::new(&cx), Option::Some.(scope), Option::Some.(m.name))?;
            if !sig.params.is_empty(&cx) {
                return sig_error(f"trait method {m.name} cannot be generic itself".write(&cx, Buffer!::new()).save(&cx), no_pos());
            }
            methods.push(&cx, C::Method.{ name: m.name, ret: sig.ret, ptypes: sig.ptypes, is_unsafe: sig.is_unsafe, places: sig.places });
            i = i + 1usize;
        }
        let names: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
        let kinds: ArenaVec[Kind, 'k] = ArenaVec::new(&cx);
        i = 0usize;
        while i < params.len(&cx) {
            names.push(&cx, params.at(&cx, i).name);
            kinds.push(&cx, params.at(&cx, i).kind);
            i = i + 1usize;
        }
        Result::Ok.(C::Trait.{ name: self.name(&cx, decl), params: names, methods, home: Option::Some.(decl.home), param_kinds: kinds })
    }

    fn instance_decl(self, &cx: Domain!['k], item: S::InstanceDecl['k], home: ModuleId['k])
        -> Result[(InstanceSig['k], S::InstanceDecl['k], ModuleId['k]), SigError['k]] {
        let (params, premises, scope) = self.quantifier(&cx, item.quantifier, new_scope(&cx))?;
        let head = match item.ty {
            Name(n) => n,
            _ => fail(&cx, Span::from_static(&cx, "internal error: an instance of something other than a trait")),
        };
        let trait_decl = match self.r.refs.get(&cx, head.id) {
            Some(r) => match r {
                Decl(d) => d,
                _ => fail(&cx, Span::from_static(&cx, "internal error: an instance of something other than a trait")),
            },
            None => fail(&cx, Span::from_static(&cx, "internal error: an unresolved instance")),
        };
        let arguments = self.type_list(&cx, head.args, scope)?;
        let unit = self.check_arguments(&cx, trait_decl, arguments, scope, head.pos)?;
        let methods: ArenaVec[Sig['k], 'k] = ArenaVec::new(&cx);
        var i = 0usize;
        while i < item.methods.len(&cx) {
            let m = item.methods.at(&cx, i);
            let sig = self.signature(&cx, Option::None, fn_header(m), params, premises, Option::Some.(scope), Option::Some.(m.name))?;
            methods.push(&cx, Sig.{ name: sig.name, decl: sig.decl, params: sig.params, premises: sig.premises, pnames: sig.pnames,
                               ptypes: sig.ptypes, places: sig.places, ret: sig.ret, is_unsafe: sig.is_unsafe, home: Option::Some.(home) });
            i = i + 1usize;
        }
        let inst = InstanceSig.{ trait_name: self.name(&cx, trait_decl), params, premises, head: arguments, methods, home, pos: item.pos };
        Result::Ok.((inst, item, home))
    }

    // An instance defines its trait's methods, once each, each with the trait's signature at the
    // instance's arguments: parameter types, which parameters are places, result, and no `unsafe` the
    // trait's method lacks.
    fn conforms(self, &cx: Domain!['k], inst: InstanceSig['k], item: S::InstanceDecl['k]) -> Result[bool, SigError['k]] {
        let tr = match self.traits.get(&cx, inst.trait_name) {
            Some(t) => t,
            None => fail(&cx, Span::from_static(&cx, "internal error: an instance of an unknown trait")),
        };
        let head: ArenaMap[Span['k], Type['k], 'k] = ArenaMap::new(&cx);
        var h = 0usize;
        while h < tr.params.len(&cx) && h < inst.head.len(&cx) {
            head.insert(&cx, tr.params.at(&cx, h), inst.head.at(&cx, h));
            h = h + 1usize;
        }
        let written = surface(&cx, ArenaVec::new(&cx), ArenaVec::one(&cx, inst.trait_name), ArenaMap::new(&cx)).name(&cx, inst.trait_name);
        let declared: ArenaSet[Span['k], 'k] = ArenaSet::new(&cx);
        var d = 0usize;
        while d < tr.methods.len(&cx) {
            declared.insert(&cx, tr.methods.at(&cx, d).name);
            d = d + 1usize;
        }
        // method name -> its index in the instance
        let defined: ArenaMap[Span['k], usize, 'k] = ArenaMap::new(&cx);
        var i = 0usize;
        while i < item.methods.len(&cx) {
            let node = item.methods.at(&cx, i);
            if defined.contains(&cx, node.name) {
                return sig_error(f"method {node.name} is defined twice".write(&cx, Buffer!::new()).save(&cx), node.pos);
            }
            if !declared.contains(&cx, node.name) {
                return sig_error(f"{node.name} is not a method of trait {written}".write(&cx, Buffer!::new()).save(&cx), node.pos);
            }
            defined.insert(&cx, node.name, i);
            i = i + 1usize;
        }
        var m = 0usize;
        while m < tr.methods.len(&cx) {
            let method = tr.methods.at(&cx, m);
            let at = match defined.get(&cx, method.name) {
                Some(k) => k,
                None => return sig_error(Buffer!::new().put("the instance lacks trait method ").write(&cx, method.name).save(&cx), no_pos()),
            };
            let sig = inst.methods.at(&cx, at);
            let node = item.methods.at(&cx, at);
            if sig.params.len(&cx) > inst.params.len(&cx) || sig.premises.len(&cx) > inst.premises.len(&cx) {
                return sig_error(f"instance method {method.name} cannot be generic itself".write(&cx, Buffer!::new()).save(&cx), node.pos);
            }
            let wanted: ArenaVec[Type['k], 'k] = ArenaVec::new(&cx);
            var k = 0usize;
            while k < method.ptypes.len(&cx) {
                wanted.push(&cx, subst(&cx, method.ptypes.at(&cx, k), head, self.counter));
                k = k + 1usize;
            }
            let want = C::fn_type(&cx, wanted, subst(&cx, method.ret, head, self.counter), false, method.places);
            let got = C::fn_type(&cx, sig.ptypes, sig.ret, false, sig.places);
            if !equal(&cx, got, want) || sig.is_unsafe && !method.is_unsafe {
                return sig_error(f"method {method.name} does not match its declaration in trait {written}".write(&cx, Buffer!::new()).save(&cx), node.pos);
            }
            m = m + 1usize;
        }
        Result::Ok.(true)
    }

    // ---- consts
    fn const_decl(self, &cx: Domain!['k], decl: Decl['k]) -> Result[ConstValue['k], SigError['k]] {
        let unit = match self.consts.get(&cx, decl.id) {
            Some(value) => return Result::Ok.(value),
            None => (),
        };
        if self.folding.contains(&cx, decl.id) {
            return sig_error(f"const {decl.name} depends on itself".write(&cx, Buffer!::new()).save(&cx), no_pos());
        }
        self.folding.insert(&cx, decl.id);
        let result = self.const_value(&cx, decl);
        self.folding.remove(&cx, decl.id);
        match result {
            Ok(value) => Result::Ok.(value),
            Err(e) => Result::Err.(SigError.{ message: e.message, pos: e.pos, in_const: true }),
        }
    }

    fn const_value(self, &cx: Domain!['k], decl: Decl['k]) -> Result[ConstValue['k], SigError['k]] {
        let node = match decl.node {
            Const(c) => c,
            _ => fail(&cx, Span::from_static(&cx, "internal error: a const declaration that declares no const")),
        };
        let value = self.typed(&cx, decl.name, node.value, self.ty(&cx, node.ty, new_scope(&cx))?, decl.home)?;
        self.consts.insert(&cx, decl.id, value);
        Result::Ok.(value)
    }

    // The value of `const name: want = expr`, which must have type `want`.
    fn typed(self, &cx: Domain!['k], name: Span['k], expr: Expr['k], want: Type['k], home: ModuleId['k]) -> Result[ConstValue['k], SigError['k]] {
        let value = self.fold(&cx, expr, Option::Some.(want), Option::Some.(home), true)?;
        let got = match const_type(&cx, value) {
            Some(t) => t,
            None => fail(&cx, Span::from_static(&cx, "internal error: an untyped constant")),
        };
        if !C::same(&cx, got, want) {
            let spelling = surface(&cx, ArenaVec::two(&cx, got, want), ArenaVec::new(&cx), ArenaMap::new(&cx));
            return sig_error(Buffer!::new().put("const ").write(&cx, name).put(" has type ").write(&cx, spelling.show(&cx, got))
                .put(", but its declared type is ").write(&cx, spelling.show(&cx, want)).save(&cx), S::expr_pos(expr));
        }
        Result::Ok.(value)
    }

    // `Slice[u8, 'static]`, the type of a string literal.
    fn string_type(self, &cx: Domain!['k], home: ModuleId['k]) -> Type['k] {
        Type::Named.(self.name(&cx, self.library(&cx, home, Span::from_static(&cx, "Slice"))), ArenaVec::two(&cx, C::prim(&cx, "u8"), Type::Skolem.(Span::from_static(&cx, "static"))))
    }

    // Type a constant expression and, when `evaluate`, its value.
    //
    // Unevaluated short-circuit operands still validate operators and literals; only computed
    // values (and their division-by-zero traps) are skipped. An operation on `usize` or `isize`, or on
    // the value of one, is not evaluated: it is a `ConstValue::Op`, which the C compiler folds at the
    // target's width.
    fn fold(self, &cx: Domain!['k], expr: Expr['k], want: Option[Type['k]], home: Option[ModuleId['k]], evaluate: bool) -> Result[ConstValue['k], SigError['k]] {
        match expr {
            Lit(lit) => match lit.kind {
                Int => {
                    let ty = match lit.suffix {
                        Some(suffix) => Option::Some.(Type::Prim.(suffix)),
                        None => want,
                    };
                    match integer_type(&cx, ty) {
                        Some(name) => self.literal(&cx, lit.int, false, name, lit.pos),
                        None => sig_error(Span::from_static(&cx, "an integer constant needs a type"), lit.pos),
                    }
                },
                Bool => Result::Ok.(ConstValue::Bool.(lit.int != 0u64)),
                Float => {
                    let ty = match lit.suffix {
                        Some(suffix) => Option::Some.(Type::Prim.(suffix)),
                        None => want,
                    };
                    if !is_float_type(&cx, ty) {
                        return sig_error(Span::from_static(&cx, "a floating constant needs a floating type"), lit.pos);
                    }
                    let prim = match ty {
                        Some(t) => t,
                        None => C::unit(&cx),
                    };
                    if !valid_literal(&cx, prim, lit.text) {
                        let name = match prim {
                            Prim(n) => n,
                            _ => Span::from_static(&cx, ""),
                        };
                        return sig_error(f"literal {lit.text} does not fit {name}".write(&cx, Buffer!::new()).save(&cx), lit.pos);
                    }
                    Result::Ok.(ConstValue::Float.(lit.text, prim))
                },
                Str => Result::Ok.(ConstValue::Str.(lit.text, match home {
                    Some(h) => Option::Some.(self.string_type(&cx, h)),
                    None => Option::None,
                })),
            },
            Path(path) => {
                let decl = match self.r.refs.get(&cx, path.id) {
                    Some(r) => match r {
                        Decl(d) => if d.kind.is(&cx, "const") { Option::Some.(d) } else { Option::None },
                        _ => Option::None,
                    },
                    None => Option::None,
                };
                match decl {
                    Some(d) => {
                        var i = 0usize;
                        while i < path.segments.len(&cx) {
                            if !path.segments.at(&cx, i).args.is_empty(&cx) {
                                return sig_error(Span::from_static(&cx, "constant paths take no type arguments"), path.pos);
                            }
                            i = i + 1usize;
                        }
                        self.const_decl(&cx, d)
                    },
                    None => sig_error(Span::from_static(&cx, "a constant expression names only consts"), path.pos),
                }
            },
            Tuple(t) => if t.value.len(&cx) == 1usize {
                self.fold(&cx, t.value.at(&cx, 0usize), want, home, evaluate)
            } else {
                sig_error(Span::from_static(&cx, "not a constant expression"), t.pos)
            },
            Unary(u) => if u.op.is(&cx, "-") || u.op.is(&cx, "!") {
                self.unary(&cx, u, want, home, evaluate)
            } else {
                sig_error(Span::from_static(&cx, "not a constant expression"), u.pos)
            },
            Cast(c) => {
                let v = self.fold(&cx, c.value.copy(&cx), Option::None, home, evaluate)?;
                let to = self.ty(&cx, c.ty, new_scope(&cx))?;
                let source = match integer_of(&cx, v) {
                    Some(name) => name,
                    None => match floating_of(&cx, v) {
                        Some(name) => name,
                        None => return sig_error(Span::from_static(&cx, "a constant cast converts between number types"), c.pos),
                    },
                };
                let target = match to {
                    Prim(name) => if C::is_integer(&cx, name) || C::is_float(&cx, name) {
                        name
                    } else {
                        return sig_error(Span::from_static(&cx, "a constant cast converts between number types"), c.pos);
                    },
                    _ => return sig_error(Span::from_static(&cx, "a constant cast converts between number types"), c.pos),
                };
                if C::is_float(&cx, source) || C::is_float(&cx, target) {
                    return Result::Ok.(op_value(&cx, "float_cast", ArenaVec::one(&cx, v), to));
                }
                let unit = match v {
                    Int(value, _ty) => if !C::is_pointer_sized(&cx, source) && !C::is_pointer_sized(&cx, target) {
                        return Result::Ok.(wrapped(&cx, value, target));
                    },
                    _ => (),
                };
                Result::Ok.(op_value(&cx, "int_cast", ArenaVec::one(&cx, v), to))
            },
            Binop(b) => self.binop(&cx, b, want, home, evaluate),
            _ => sig_error(Span::from_static(&cx, "not a constant expression"), S::expr_pos(expr)),
        }
    }

    // `-` or `!` applied to a constant.
    fn unary(self, &cx: Domain!['k], expr: S::Unary['k], want: Option[Type['k]], home: Option[ModuleId['k]], evaluate: bool) -> Result[ConstValue['k], SigError['k]] {
        if expr.op.is(&cx, "-") {
            let unit = match expr.operand.copy(&cx) {
                Lit(literal) => match literal.kind {
                    Int => {
                        let ty = match literal.suffix {
                            Some(suffix) => Option::Some.(Type::Prim.(suffix)),
                            None => want,
                        };
                        return match integer_type(&cx, ty) {
                            Some(name) => self.literal(&cx, literal.int, true, name, expr.pos),
                            None => sig_error(Span::from_static(&cx, "an integer constant needs a type"), expr.pos),
                        };
                    },
                    _ => (),
                },
                _ => (),
            };
        }
        let v = self.fold(&cx, expr.operand.copy(&cx), want, home, evaluate)?;
        match v {
            Float(digits, ty) => if expr.op.is(&cx, "-") {
                let negated = if digits.starts_with(&cx, Span::from_static(&cx, "-")) { digits.skip(1usize) } else { concat(&cx, Span::from_static(&cx, "-"), digits) };
                return Result::Ok.(ConstValue::Float.(negated, ty));
            },
            Bool(b) => if expr.op.is(&cx, "!") {
                return Result::Ok.(ConstValue::Bool.(!b));
            },
            Op(_o, _a, ty) => if expr.op.is(&cx, "-") && floating_of(&cx, v).is_some() {
                return Result::Ok.(op_value(&cx, "neg", ArenaVec::one(&cx, v), ty));
            } else if expr.op.is(&cx, "!") && C::same(&cx, ty, C::bool_type(&cx)) {
                return Result::Ok.(op_value(&cx, "not", ArenaVec::one(&cx, v), ty));
            },
            _ => (),
        };
        let name = match integer_of(&cx, v) {
            Some(name) => name,
            None => return sig_error(Span::from_static(&cx, "operator needs an integer"), expr.pos),
        };
        let unit = match v {
            Int(value, _ty) => if !C::is_pointer_sized(&cx, name) {
                return Result::Ok.(wrapped(&cx, if expr.op.is(&cx, "-") { 0u64 - value } else { value ^ all_bits() }, name));
            },
            _ => (),
        };
        Result::Ok.(op_value(&cx, if expr.op.is(&cx, "-") { "neg" } else { "not" }, ArenaVec::one(&cx, v), Type::Prim.(name)))
    }

    fn binop(self, &cx: Domain!['k], expr: S::Binop['k], want: Option[Type['k]], home: Option[ModuleId['k]], evaluate: bool) -> Result[ConstValue['k], SigError['k]] {
        let op = expr.op;
        if op.is(&cx, "&&") || op.is(&cx, "||") {
            let a = self.fold(&cx, expr.left.copy(&cx), Option::Some.(C::bool_type(&cx)), home, evaluate)?;
            if !is_boolean(&cx, a) {
                return sig_error(Span::from_static(&cx, "logical constant operands must be booleans"), expr.pos);
            }
            // An operand the C compiler folds may be either value: the other is needed.
            let needed = match a {
                Bool(x) => x == op.is(&cx, "&&"),
                _ => true,
            };
            let b = self.fold(&cx, expr.right.copy(&cx), Option::Some.(C::bool_type(&cx)), home, evaluate && needed)?;
            if !is_boolean(&cx, b) {
                return sig_error(Span::from_static(&cx, "logical constant operands must be booleans"), expr.pos);
            }
            if is_op(a) {
                return Result::Ok.(op_value(&cx, if op.is(&cx, "&&") { "and" } else { "or" }, ArenaVec::two(&cx, a, b), C::bool_type(&cx)));
            }
            return Result::Ok.(if needed { b } else { a });
        }
        let comparison = is_comparison(&cx, op);
        let hint = if comparison { Option::None } else { want };
        // The left operand first, giving the right its type; if that fails, the other way round.
        let first = match self.fold(&cx, expr.left.copy(&cx), hint, home, evaluate) {
            Ok(a) => match self.fold(&cx, expr.right.copy(&cx), const_type(&cx, a), home, evaluate) {
                Ok(b) => Option::Some.((a, b)),
                Err(_e) => Option::None,
            },
            Err(_e) => Option::None,
        };
        let (a, b) = match first {
            Some(pair) => pair,
            None => {
                let b = self.fold(&cx, expr.right.copy(&cx), hint, home, evaluate)?;
                let a = self.fold(&cx, expr.left.copy(&cx), const_type(&cx, b), home, evaluate)?;
                (a, b)
            },
        };
        if is_boolean(&cx, a) && (op.is(&cx, "==") || op.is(&cx, "!=")) {
            if !is_boolean(&cx, b) {
                return sig_error(Span::from_static(&cx, "constant comparison operands must have the same type"), expr.pos);
            }
            let unit = match a {
                Bool(x) => match b {
                    Bool(y) => return Result::Ok.(ConstValue::Bool.((x == y) == op.is(&cx, "=="))),
                    _ => (),
                },
                _ => (),
            };
            return Result::Ok.(op_value(&cx, binop_name(&cx, op), ArenaVec::two(&cx, a, b), C::bool_type(&cx)));
        }
        match floating_of(&cx, a) {
            Some(number) => {
                let same = match floating_of(&cx, b) {
                    Some(other) => number.eq(&cx, other),
                    None => false,
                };
                if same && (comparison || op.is(&cx, "+") || op.is(&cx, "-") || op.is(&cx, "*") || op.is(&cx, "/")) {
                    // The C compiler folds arithmetic on floats.
                    let ty = if comparison { C::bool_type(&cx) } else { Type::Prim.(number) };
                    return Result::Ok.(op_value(&cx, binop_name(&cx, op), ArenaVec::two(&cx, a, b), ty));
                }
            },
            None => (),
        }
        let name = match integer_of(&cx, a) {
            Some(name) => name,
            None => return sig_error(Span::from_static(&cx, "constant operands must be integers of one type"), expr.pos),
        };
        let ty = Type::Prim.(name);
        let same = match integer_of(&cx, b) {
            Some(other) => C::same(&cx, ty, Type::Prim.(other)),
            None => false,
        };
        if !same {
            return sig_error(Span::from_static(&cx, "constant operands must be integers of one type"), expr.pos);
        }
        // A literal 0 is 0 at every width.
        if evaluate && (op.is(&cx, "/") || op.is(&cx, "%")) {
            let unit = match b {
                Int(y, _t) => if y == 0u64 {
                    return sig_error(Span::from_static(&cx, "constant division by zero"), expr.pos);
                },
                _ => (),
            };
        }
        let known = match a {
            Int(x, _t) => match b {
                Int(y, _u) => if C::is_pointer_sized(&cx, name) { Option::None } else { Option::Some.((x, y)) },
                _ => Option::None,
            },
            _ => Option::None,
        };
        let (x, y) = match known {
            Some(pair) => pair,
            None => return Result::Ok.(op_value(&cx, binop_name(&cx, op), ArenaVec::two(&cx, a, b), if comparison { C::bool_type(&cx) } else { ty })),
        };
        if !evaluate {
            return Result::Ok.(if comparison { ConstValue::Bool.(false) } else { wrapped(&cx, 0u64, name) });
        }
        let signed = is_signed(&cx, name);
        if comparison {
            // Both values are sign-extended in a signed type: flipping the sign bit orders them as
            // unsigned numbers.
            let flip = if signed { sign_bit() } else { 0u64 };
            let p = x ^ flip;
            let q = y ^ flip;
            let result = if op.is(&cx, "==") {
                p == q
            } else if op.is(&cx, "!=") {
                p != q
            } else if op.is(&cx, "<") {
                p < q
            } else if op.is(&cx, "<=") {
                p <= q
            } else if op.is(&cx, ">") {
                p > q
            } else {
                p >= q
            };
            return Result::Ok.(ConstValue::Bool.(result));
        }
        let bits = C::integer_bits(&cx, name) as u64;
        let value = if op.is(&cx, "/") || op.is(&cx, "%") {
            // The quotient rounds toward zero, from the magnitudes; the most negative i64's
            // magnitude, 2^63, fits in a u64.
            let x_negative = signed && x >= sign_bit();
            let y_negative = signed && y >= sign_bit();
            let x_magnitude = if x_negative { 0u64 - x } else { x };
            let y_magnitude = if y_negative { 0u64 - y } else { y };
            let magnitude = x_magnitude / y_magnitude;
            let q = if x_negative == y_negative { magnitude } else { 0u64 - magnitude };
            if op.is(&cx, "/") { q } else { x - q * y }
        } else if op.is(&cx, "<<") || op.is(&cx, ">>") {
            // `y % bits` of the whole value: the width is a power of two.
            let shift = y & (bits - 1u64);
            if op.is(&cx, "<<") {
                x << shift
            } else if signed && x >= sign_bit() {
                // An arithmetic shift of a negative value.
                (((x ^ all_bits()) >> shift) ^ all_bits())
            } else {
                x >> shift
            }
        } else if op.is(&cx, "+") {
            x + y
        } else if op.is(&cx, "-") {
            x - y
        } else if op.is(&cx, "*") {
            x * y
        } else if op.is(&cx, "&") {
            x & y
        } else if op.is(&cx, "|") {
            x | y
        } else if op.is(&cx, "^") {
            x ^ y
        } else {
            fail(&cx, Buffer!::new().put("internal error: no constant operator ").write(&cx, op).save(&cx))
        };
        Result::Ok.(wrapped(&cx, value, name))
    }

    // A literal's value in the integer type `name`; it must fit (a negated one may reach the
    // minimum).
    fn literal(self, &cx: Domain!['k], magnitude: u64, negative: bool, name: Span['k], pos: Pos) -> Result[ConstValue['k], SigError['k]] {
        let spelled = if negative && magnitude != 0u64 {
            Buffer!::new().put("-").put(magnitude).save(&cx)
        } else {
            Buffer!::new().put(magnitude).save(&cx)
        };
        if !valid_literal(&cx, Type::Prim.(name), spelled) {
            return sig_error(f"{spelled} does not fit {name}".write(&cx, Buffer!::new()).save(&cx), pos);
        }
        // A literal fits its type: negated, its 64 bits are already sign-extended.
        Result::Ok.(ConstValue::Int.(if negative { 0u64 - magnitude } else { magnitude }, Type::Prim.(name)))
    }
}

// `value` in the width of the fixed-width integer type `name`, sign-extended when it is signed.
forall 'k.
fn wrapped(&cx: Domain!['k], value: u64, name: Span['k]) -> ConstValue['k] {
    let bits = C::integer_bits(&cx, name) as u64;
    var v = value;
    if bits < 64u64 {
        let mask = (1u64 << bits) - 1u64;
        v = v & mask;
        if is_signed(&cx, name) && v >= 1u64 << (bits - 1u64) {
            v = v | (mask ^ all_bits());
        }
    }
    ConstValue::Int.(v, Type::Prim.(name))
}

// The indices of a function type's place slots, from `first`.
forall 'k.
fn places_of(&cx: Domain!['k], slots: ArenaVec[S::Slot['k], 'k], first: usize) -> ArenaVec[usize, 'k] {
    let out: ArenaVec[usize, 'k] = ArenaVec::new(&cx);
    var i = 0usize;
    while i < slots.len(&cx) {
        if slots.at(&cx, i).lend {
            out.push(&cx, i + first);
        }
        i = i + 1usize;
    }
    out
}

forall 'k.
fn signatures(&cx: Domain!['k], resolver: Resolver['k], counter: Fresh['k]) -> Signatures['k] {
    Signatures::new(&cx, resolver, counter)
}
