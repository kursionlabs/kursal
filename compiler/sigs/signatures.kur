// Signatures: every resolved declaration in core terms.
//
// Types become core types, with each nominal declaration named by its identity. Functions, methods,
// externs and trait methods get core signatures, with place modes. Consts are folded to values.
//
// Folding a binary operation tries its operands in one order and, when that fails, in the other, so
// an error met while folding must be one the caller can recover from. The steps folding may reach
// (`type`, `check_arguments`, `require_copy`, `copy_names`, `array_length`, `const_decl`, `fold`,
// `binop`, `wrapped_literal`) therefore return a `Result` whose error is a `SigError`; the others
// stop at the first error, through `got`, as raising `SigError` does.
//
// An integer constant is held in 64 bits: its value in its type's width, sign-extended for a signed
// type, so every value of every integer type has one representation. Folding computes modulo 2^64
// and then reduces to the type's width, which gives the same result as computing exactly and then
// reducing: addition, subtraction, multiplication, negation and the bitwise operations depend only on
// their operands' low bits. Division, remainder, comparison and right shifts depend on whole values,
// and are computed on them (see `binop`).

use package::support::base::{Cell, Cx, Map, Seq, Set, Text, fail, text, text_of};
use std::bytes::buffer::Buffer;
use package::kurs::core::{Exposure, ExposureMode, Kind, Member, ModuleId, Param, Premise, Program, Type, TypeDecl};
use package::kurs::core as C;
use package::types::layout::check_type_expansion;
use package::types::literals::valid_literal;
use package::resolve::resolver::{Decl, NameRef, Named, Package, Resolver, Target, named_pos, repr, repr_tuple};
use package::syntax::ast as S;
use package::syntax::ast::{Expr, Pos, no_pos};
use package::types::ops::{Fresh, Types};
use std::option::{Option, Result};
use std::slice::Slice;

// ------------------------------------------------------------ the library --

// A library item the compiler itself refers to: its home library, its path there, and its path
// through std.
forall 'k.
exposed struct LibraryItem {
    home: Text['k],
    path: Seq[Text['k], 'k],
    std_path: Seq[Text['k], 'k],
}

forall 'k.
fn library_entry(&cx: Cx!['k], home: Slice[u8, 'static], path: Slice[u8, 'static], std_path: Slice[u8, 'static]) -> LibraryItem['k] {
    LibraryItem.{ home: text(&cx, home), path: text(&cx, path).split(&cx, text(&cx, "::")), std_path: text(&cx, std_path).split(&cx, text(&cx, "::")) }
}

// The table `LIBRARY`: the item named `name`.
forall 'k.
fn library_item(&cx: Cx!['k], name: Text['k]) -> LibraryItem['k] {
    if name.is(&cx, "Option") {
        library_entry(&cx, "core", "option::Option", "option::Option")
    } else if name.is(&cx, "Result") {
        library_entry(&cx, "core", "option::Result", "option::Result")
    } else if name.is(&cx, "Slice") {
        library_entry(&cx, "core", "slice::Slice", "slice::Slice")
    } else if name.is(&cx, "Buffer") {
        library_entry(&cx, "alloc", "buffer::Buffer", "bytes::buffer::Buffer")
    } else if name.is(&cx, "Iterator") {
        library_entry(&cx, "core", "iter::Iterator", "iter::Iterator")
    } else if name.is(&cx, "Format") {
        library_entry(&cx, "core", "fmt::Format", "text::fmt::Format")
    } else if name.is(&cx, "Writable") {
        library_entry(&cx, "core", "fmt::Writable", "text::fmt::Writable")
    } else if name.is(&cx, "Slice::from_raw_parts") {
        library_entry(&cx, "core", "slice::Slice::from_raw_parts", "slice::Slice::from_raw_parts")
    } else if name.is(&cx, "Buffer::new") {
        library_entry(&cx, "alloc", "buffer::Buffer::new", "bytes::buffer::Buffer::new")
    } else if name.is(&cx, "Ordering") {
        library_entry(&cx, "core", "atomic::Ordering", "atomic::Ordering")
    } else {
        fail(&cx, text_of(&cx, Buffer::new().push_static("internal error: no library item ").push_bytes(&cx, name)))
    }
}

// ----------------------------------------------------------------- errors --

// An error of this stage, before its file is known; a `pos` on line 0 is no position.
forall 'k.
exposed struct SigError {
    message: Text['k],
    pos: Pos,
}

forall T, 'k.
fn sig_error(message: Text['k], pos: Pos) -> Result[T, SigError['k]] {
    Result::Err.(SigError.{ message, pos })
}

forall T, 'k.
fn sig_error_static(&cx: Cx!['k], message: Slice[u8, 'static]) -> Result[T, SigError['k]] {
    sig_error(text(&cx, message), no_pos())
}

// ------------------------------------------------------------- the results --

// A callable's core signature.
forall 'k.
exposed struct Sig {
    // its core name
    name: Text['k],
    // the Decl, or none for an instance or trait method
    decl: Option[Decl['k]],
    // forall Params, implicit closure environments included
    params: Seq[Param['k], 'k],
    premises: Seq[Premise['k], 'k],
    // parameter names
    pnames: Seq[Text['k], 'k],
    ptypes: Seq[Type['k], 'k],
    // indices of `&` parameters, ascending
    places: Seq[usize, 'k],
    ret: Type['k],
    is_unsafe: bool,
    home: Option[ModuleId['k]],
}

// An instance header before its method bodies have been lowered to core functions.
forall 'k.
exposed struct InstanceSig {
    trait_name: Text['k],
    params: Seq[Param['k], 'k],
    premises: Seq[Premise['k], 'k],
    head: Seq[Type['k], 'k],
    methods: Seq[Sig['k], 'k],
    home: ModuleId['k],
    pos: Pos,
}

// A folded constant. An integer is its value in its type's width, in 64 bits, sign-extended for a
// signed type; its type is an integer `Prim`. A float keeps its digits. A string's type is the one
// wanted where it was folded, if any.
forall 'k.
exposed enum ConstValue {
    Int(u64, Type['k]),
    Bool(bool),
    Float(Text['k], Type['k]),
    Str(Text['k], Option[Type['k]]),
}

// `value[2]`: the constant's type.
forall 'k.
fn const_type(&cx: Cx!['k], value: ConstValue['k]) -> Option[Type['k]] {
    match value {
        ConstValue::Int(_v, ty) => Option::Some.(ty),
        ConstValue::Bool(_b) => Option::Some.(C::bool_type(&cx)),
        ConstValue::Float(_t, ty) => Option::Some.(ty),
        ConstValue::Str(_t, ty) => ty,
    }
}

// `value[0]`: which kind of constant it is.
forall 'k.
fn const_kind(&cx: Cx!['k], value: ConstValue['k]) -> Text['k] {
    match value {
        ConstValue::Int(_v, _t) => text(&cx, "int"),
        ConstValue::Bool(_b) => text(&cx, "bool"),
        ConstValue::Float(_t, _u) => text(&cx, "float"),
        ConstValue::Str(_t, _u) => text(&cx, "str"),
    }
}

forall 'k.
fn same_type(&cx: Cx!['k], a: Option[Type['k]], b: Option[Type['k]]) -> bool {
    match a {
        Option::Some(x) => match b {
            Option::Some(y) => C::same(&cx, x, y),
            Option::None => false,
        },
        Option::None => b.is_none(),
    }
}

// An integer type's name, if `ty` is one.
forall 'k.
fn integer_type(&cx: Cx!['k], ty: Option[Type['k]]) -> Option[Text['k]] {
    match ty {
        Option::Some(t) => match t {
            Type::Prim(name) => if C::is_integer(&cx, name) { Option::Some.(name) } else { Option::None },
            _ => Option::None,
        },
        Option::None => Option::None,
    }
}

forall 'k.
fn is_float_type(&cx: Cx!['k], ty: Option[Type['k]]) -> bool {
    match ty {
        Option::Some(t) => match t {
            Type::Prim(name) => C::is_float(&cx, name),
            _ => false,
        },
        Option::None => false,
    }
}

forall 'k.
fn is_signed(&cx: Cx!['k], name: Text['k]) -> bool {
    name.starts_with(&cx, text(&cx, "i"))
}

// A folded integer below zero: a signed value, stored sign-extended, with its top bit set.
forall 'k.
fn is_negative(&cx: Cx!['k], value: u64, ty: Type['k]) -> bool {
    match ty {
        Type::Prim(name) => is_signed(&cx, name) && value >= 9223372036854775808u64,
        _ => false,
    }
}

fn all_bits() -> u64 {
    18446744073709551615u64
}

fn sign_bit() -> u64 {
    9223372036854775808u64
}

// An integer constant's value as Python writes it.
forall 'k.
fn int_text(&cx: Cx!['k], value: u64, name: Text['k]) -> Text['k] {
    if is_signed(&cx, name) && value >= sign_bit() {
        text_of(&cx, Buffer::new().push_static("-").push_u64(0u64 - value))
    } else {
        text_of(&cx, Buffer::new().push_u64(value))
    }
}

// --------------------------------------------------------- Python's repr --

// A tuple's repr from its elements' reprs: `()`, `(a,)`, `(a, b)`.
forall 'k.
fn repr_parts(&cx: Cx!['k], parts: Seq[Text['k], 'k]) -> Text['k] {
    var out = Buffer::new().push_static("(");
    var i = 0usize;
    while i < parts.len(&cx) {
        if i > 0usize {
            out = out.push_static(", ");
        }
        out = out.push_bytes(&cx, parts.get(&cx, i));
        i = i + 1usize;
    }
    if parts.len(&cx) == 1usize {
        out = out.push_static(",");
    }
    text_of(&cx, out.push_static(")"))
}

forall 'k.
fn repr_types(&cx: Cx!['k], types: Seq[Type['k], 'k]) -> Text['k] {
    let parts: Seq[Text['k], 'k] = Seq::new(&cx);
    var i = 0usize;
    while i < types.len(&cx) {
        parts.push(&cx, type_repr(&cx, types.get(&cx, i)));
        i = i + 1usize;
    }
    repr_parts(&cx, parts)
}

forall 'k.
fn repr_members(&cx: Cx!['k], members: Seq[Member['k], 'k]) -> Text['k] {
    let parts: Seq[Text['k], 'k] = Seq::new(&cx);
    var i = 0usize;
    while i < members.len(&cx) {
        parts.push(&cx, repr_parts(&cx, Seq::two(&cx, repr(&cx, members.get(&cx, i).name), type_repr(&cx, members.get(&cx, i).type))));
        i = i + 1usize;
    }
    repr_parts(&cx, parts)
}

forall 'k.
fn repr_bool(&cx: Cx!['k], b: bool) -> Text['k] {
    text(&cx, if b { "True" } else { "False" })
}

forall 'k.
fn kind_repr(&cx: Cx!['k], k: Kind) -> Text['k] {
    match k {
        Kind::Brand => text(&cx, "'brand'"),
        Kind::Copy => text(&cx, "'copy'"),
        Kind::Any => text(&cx, "'any'"),
    }
}

// A core type as Python's dataclass `repr` writes it.
forall 'k.
fn type_repr(&cx: Cx!['k], ty: Type['k]) -> Text['k] {
    match ty {
        Type::Prim(name) => text_of(&cx, Buffer::new().push_static("Prim(name=").push_bytes(&cx, repr(&cx, name)).push_static(")")),
        Type::Never => text(&cx, "Never()"),
        Type::Named(name, args) => text_of(&cx, Buffer::new().push_static("Named(name=").push_bytes(&cx, repr(&cx, name)).push_static(", args=").push_bytes(&cx, repr_types(&cx, args)).push_static(")")),
        Type::Struct(fields) => text_of(&cx, Buffer::new().push_static("Struct(fields=").push_bytes(&cx, repr_members(&cx, fields)).push_static(")")),
        Type::Enum(variants) => text_of(&cx, Buffer::new().push_static("Enum(variants=").push_bytes(&cx, repr_members(&cx, variants)).push_static(")")),
        Type::Tuple(elems) => text_of(&cx, Buffer::new().push_static("Tuple(elems=").push_bytes(&cx, repr_types(&cx, elems)).push_static(")")),
        Type::Array(elem, length) => text_of(&cx, Buffer::new().push_static("Array(elem=").push_bytes(&cx, type_repr(&cx, elem.get(&cx))).push_static(", length=").push_u64(length).push_static(")")),
        Type::Ptr(inner) => text_of(&cx, Buffer::new().push_static("Ptr(inner=").push_bytes(&cx, type_repr(&cx, inner.get(&cx))).push_static(")")),
        Type::Skolem(label) => text_of(&cx, Buffer::new().push_static("Skolem(label=").push_bytes(&cx, repr(&cx, label)).push_static(")")),
        Type::Brand(brand) => text_of(&cx, Buffer::new().push_static("Brand(brand=").push_bytes(&cx, type_repr(&cx, brand.get(&cx))).push_static(")")),
        Type::Exists(binders, body) => text_of(&cx, Buffer::new().push_static("Exists(binders=").push_bytes(&cx, repr_tuple(&cx, binders)).push_static(", body=").push_bytes(&cx, type_repr(&cx, body.get(&cx))).push_static(")")),
        Type::Foreach(f) => text_of(&cx, Buffer::new().push_static("Foreach(binder=").push_bytes(&cx, repr(&cx, f.binder)).push_static(", indirect=").push_bytes(&cx, repr_bool(&cx, f.indirect))
            .push_static(", source=").push_bytes(&cx, type_repr(&cx, f.source.get(&cx))).push_static(", body=").push_bytes(&cx, type_repr(&cx, f.body.get(&cx)))
            .push_static(", retained=").push_bytes(&cx, repr_tuple(&cx, f.retained)).push_static(")")),
        Type::Fn(f) => {
            let quantified: Seq[Text['k], 'k] = Seq::new(&cx);
            var i = 0usize;
            while i < f.quantified.len(&cx) {
                let p = f.quantified.get(&cx, i);
                quantified.push(&cx, text_of(&cx, Buffer::new().push_static("Param(name=").push_bytes(&cx, repr(&cx, p.name)).push_static(", kind=").push_bytes(&cx, kind_repr(&cx, p.kind)).push_static(")")));
                i = i + 1usize;
            }
            var out = Buffer::new().push_static("Fn(params=").push_bytes(&cx, repr_types(&cx, f.params)).push_static(", ret=").push_bytes(&cx, type_repr(&cx, f.ret.get(&cx)))
                .push_static(", forall=").push_bytes(&cx, repr_parts(&cx, quantified)).push_static(", unsafe=").push_bytes(&cx, repr_bool(&cx, f.is_unsafe))
                .push_static(", places=");
            if f.places.is_empty(&cx) {
                out = out.push_static("frozenset()");
            } else {
                out = out.push_static("frozenset({");
                var k = 0usize;
                while k < f.places.len(&cx) {
                    if k > 0usize {
                        out = out.push_static(", ");
                    }
                    out = out.push_usize(f.places.get(&cx, k));
                    k = k + 1usize;
                }
                out = out.push_static("})");
            }
            text_of(&cx, out.push_static(")"))
        },
        Type::Ignored => text(&cx, "Ignored()"),
        Type::Meta(_m) => text(&cx, "Meta()"),
    }
}

// ------------------------------------------------------------------ scopes --

// The type names in scope while translating one declaration.
forall 'k.
exposed struct Scope {
    // type parameter -> Copy or Any
    kinds: Map[Text['k], Kind, 'k],
    brands: Set[Text['k], 'k],
    // hidden closure environments, when allowed
    implicit: Cell[Option[Seq[Param['k], 'k]], 'k],
}

forall 'k.
fn new_scope(&cx: Cx!['k]) -> Scope['k] {
    Scope.{ kinds: Map::new(&cx), brands: Set::new(&cx), implicit: Cell::new(&cx, Option::None) }
}

forall 'k.
impl Scope['k] {
    fn extend(self, &cx: Cx!['k], params: Seq[Param['k], 'k]) -> Scope['k] {
        let out = Scope.{ kinds: self.kinds.copy(&cx), brands: self.brands.copy(&cx), implicit: Cell::new(&cx, self.implicit.get(&cx)) };
        var i = 0usize;
        while i < params.len(&cx) {
            let p = params.get(&cx, i);
            let unit = match p.kind {
                Kind::Brand => out.brands.add(&cx, p.name),
                _ => out.kinds.set(&cx, p.name, p.kind),
            };
            i = i + 1usize;
        }
        out
    }
}

// ------------------------------------------------------------- the syntax --

// What a signature is made from: a function, a trait method's signature, or an extern.
forall 'k.
exposed struct Header {
    params: Seq[S::Param['k], 'k],
    ret: Option[S::Type['k]],
    quantifier: Option[S::Forall['k]],
    is_unsafe: bool,
    pos: Pos,
}

forall 'k.
fn fn_header(f: S::Fn['k]) -> Header['k] {
    Header.{ params: f.params, ret: f.ret, quantifier: f.quantifier, is_unsafe: f.is_unsafe, pos: f.pos }
}

forall 'k.
fn named_quantifier(node: Named['k]) -> Option[S::Forall['k]] {
    match node {
        Named::Struct(x) => x.quantifier,
        Named::Enum(x) => x.quantifier,
        Named::Tuple(x) => x.quantifier,
        Named::Fn(x) => x.quantifier,
        Named::Extern(x) => x.quantifier,
        Named::Trait(x) => x.quantifier,
        Named::Const(x) => x.quantifier,
    }
}

forall 'k.
fn is_copy_trait(&cx: Cx!['k], path: Seq[Text['k], 'k]) -> bool {
    path.len(&cx) == 1usize && path.get(&cx, 0usize).is(&cx, "Copy")
}

forall 'k.
fn is_skolem(ty: Type['k]) -> bool {
    match ty {
        Type::Skolem(_l) => true,
        _ => false,
    }
}

forall 'k.
fn all_params(&cx: Cx!['k], f: S::Forall['k]) -> Seq[Text['k], 'k] {
    let out = f.params.copy(&cx);
    out.append(&cx, f.determined);
    out
}

forall 'k.
fn concat_params(&cx: Cx!['k], a: Seq[Param['k], 'k], b: Seq[Param['k], 'k]) -> Seq[Param['k], 'k] {
    let out = a.copy(&cx);
    out.append(&cx, b);
    out
}

forall 'k.
fn concat_premises(&cx: Cx!['k], a: Seq[Premise['k], 'k], b: Seq[Premise['k], 'k]) -> Seq[Premise['k], 'k] {
    let out = a.copy(&cx);
    out.append(&cx, b);
    out
}

forall 'k.
fn is_comparison(&cx: Cx!['k], op: Text['k]) -> bool {
    op.is(&cx, "==") || op.is(&cx, "!=") || op.is(&cx, "<") || op.is(&cx, "<=") || op.is(&cx, ">") || op.is(&cx, ">=")
}

// ------------------------------------------------------------- Signatures --

forall 'k.
exposed struct Signatures {
    r: Resolver['k],
    packages: Seq[Package['k], 'k],
    // package id -> its name in core names
    package_names: Map[usize, Text['k], 'k],
    types: Map[Text['k], TypeDecl['k], 'k],
    // decl id -> its signature
    sigs: Map[u32, Sig['k], 'k],
    traits: Map[Text['k], C::Trait['k], 'k],
    // (instance with Sig methods, its declaration, its module)
    instances: Seq[(InstanceSig['k], S::InstanceDecl['k], ModuleId['k]), 'k],
    // decl id -> its value
    consts: Map[u32, ConstValue['k], 'k],
    // the ids of the consts being folded
    folding: Set[u32, 'k],
    implicit: Cell[u32, 'k],
    copy_checks: Seq[(Type['k], Map[Text['k], Kind, 'k]), 'k],
    types_ready: Cell[bool, 'k],
    counter: Fresh['k],
}

forall 'k.
impl Signatures['k] {
    fn new(&cx: Cx!['k], resolver: Resolver['k], counter: Fresh['k]) -> Signatures['k] {
        let packages = resolver.packages;
        let spelled: Set[Text['k], 'k] = Set::new(&cx);
        var p = 0usize;
        while p < packages.len(&cx) {
            spelled.add(&cx, packages.get(&cx, p).name.get(&cx));
            p = p + 1usize;
        }
        let clash = spelled.len(&cx) != packages.len(&cx);
        let package_names: Map[usize, Text['k], 'k] = Map::new(&cx);
        p = 0usize;
        while p < packages.len(&cx) {
            let package = packages.get(&cx, p);
            package_names.set(&cx, package.id, if clash {
                text_of(&cx, Buffer::new().push_bytes(&cx, package.name.get(&cx)).push_static("#").push_usize(package.id))
            } else {
                package.name.get(&cx)
            });
            p = p + 1usize;
        }
        let s = Signatures.{
            r: resolver,
            packages,
            package_names,
            types: Map::new(&cx),
            sigs: Map::new(&cx),
            traits: Map::new(&cx),
            instances: Seq::new(&cx),
            consts: Map::new(&cx),
            folding: Set::new(&cx),
            implicit: Cell::new(&cx, 0u32),
            copy_checks: Seq::new(&cx),
            types_ready: Cell::new(&cx, false),
            counter,
        };
        let scopes = resolver.scopes.values(&cx);
        var i = 0usize;
        while i < scopes.len(&cx) {
            let decls = scopes.get(&cx, i).decls.values(&cx);
            var k = 0usize;
            while k < decls.len(&cx) {
                let decl = decls.get(&cx, k);
                if decl.kind.is(&cx, "struct") || decl.kind.is(&cx, "enum") || decl.kind.is(&cx, "tuple") {
                    resolver.locate(&cx, decl.home, named_pos(decl.node));
                    let type_decl = s.type_decl(&cx, decl);
                    s.types.set(&cx, s.name(&cx, decl), type_decl);
                    resolver.unlocate(&cx);
                }
                k = k + 1usize;
            }
            i = i + 1usize;
        }
        check_type_expansion(&cx, s.program(&cx), counter);
        s.types_ready.set(&cx, true);
        i = 0usize;
        while i < s.copy_checks.len(&cx) {
            let (ty, kinds) = s.copy_checks.get(&cx, i);
            let unit = s.got(&cx, s.require_copy(&cx, ty, kinds));
            i = i + 1usize;
        }
        s.copy_checks.clear(&cx);
        i = 0usize;
        while i < scopes.len(&cx) {
            let scope = scopes.get(&cx, i);
            let decls = scope.decls.values(&cx);
            var k = 0usize;
            while k < decls.len(&cx) {
                let decl = decls.get(&cx, k);
                resolver.locate(&cx, decl.home, named_pos(decl.node));
                if decl.kind.is(&cx, "trait") {
                    let t = s.trait_decl(&cx, decl);
                    s.traits.set(&cx, s.name(&cx, decl), t);
                } else if decl.kind.is(&cx, "fn") || decl.kind.is(&cx, "method") || decl.kind.is(&cx, "extern") {
                    s.sigs.set(&cx, decl.id, s.decl_signature(&cx, decl));
                } else if decl.kind.is(&cx, "const") {
                    let unit = s.got(&cx, s.const_decl(&cx, decl));
                }
                resolver.unlocate(&cx);
                k = k + 1usize;
            }
            var n = 0usize;
            while n < scope.items.len(&cx) {
                let unit = match scope.items.get(&cx, n) {
                    S::Item::Instance(item) => {
                        resolver.locate(&cx, scope.home, item.pos);
                        s.instances.push(&cx, s.instance_decl(&cx, item, scope.home));
                        resolver.unlocate(&cx);
                    },
                    _ => (),
                };
                n = n + 1usize;
            }
            i = i + 1usize;
        }
        s
    }

    // The type declarations so far, as a program.
    fn program(self, &cx: Cx!['k]) -> Program['k] {
        Program.{ types: self.types, funs: Map::new(&cx), externs: Map::new(&cx), datas: Map::new(&cx), traits: Map::new(&cx), instances: Map::new(&cx) }
    }

    // ---- errors
    // Stops with `message` at `pos`, in the declaration being translated.
    fn fail(self, &cx: Cx!['k], message: Text['k], pos: Pos) -> ! {
        self.r.fail(&cx, message, pos)
    }

    // The value of a step that may fail, stopping if it did.
    forall T.
    fn got(self, &cx: Cx!['k], result: Result[T, SigError['k]]) -> T {
        match result {
            Result::Ok(value) => value,
            Result::Err(e) => self.fail(&cx, e.message, e.pos),
        }
    }

    // ---- naming
    fn name(self, &cx: Cx!['k], decl: Decl['k]) -> Text['k] {
        let parts = Seq::one(&cx, self.package_names.at(&cx, decl.home.package));
        parts.append(&cx, decl.home.path);
        parts.push(&cx, decl.name);
        var out = Buffer::new();
        var i = 0usize;
        while i < parts.len(&cx) {
            if i > 0usize {
                out = out.push_static("::");
            }
            out = out.push_bytes(&cx, parts.get(&cx, i));
            i = i + 1usize;
        }
        text_of(&cx, out)
    }

    // Resolve a compiler-known library item in the requesting module's package.
    fn library(self, &cx: Cx!['k], home: ModuleId['k], name: Text['k]) -> Decl['k] {
        let item = library_item(&cx, name);
        match self.r.library(&cx, home, item.home, item.path, item.std_path) {
            Target::Decl(d) => d,
            _ => fail(&cx, text_of(&cx, Buffer::new().push_static("internal error: library item ").push_bytes(&cx, name).push_static(" is not a declaration"))),
        }
    }

    // ---- headers
    // Core Params and premises of a `forall` header, and the scope it opens.
    fn quantifier(self, &cx: Cx!['k], header: Option[S::Forall['k]], scope: Scope['k]) -> (Seq[Param['k], 'k], Seq[Premise['k], 'k], Scope['k]) {
        let f = match header {
            Option::Some(f) => f,
            Option::None => return (Seq::new(&cx), Seq::new(&cx), scope),
        };
        let copy = self.got(&cx, self.copy_names(&cx, header));
        let names = all_params(&cx, f);
        let params: Seq[Param['k], 'k] = Seq::new(&cx);
        var i = 0usize;
        while i < names.len(&cx) {
            let p = names.get(&cx, i);
            params.push(&cx, if p.starts_with(&cx, text(&cx, "'")) {
                Param.{ name: p.from(1usize), kind: Kind::Brand }
            } else {
                Param.{ name: p, kind: if copy.has(&cx, p) { Kind::Copy } else { Kind::Any } }
            });
            i = i + 1usize;
        }
        let inner = scope.extend(&cx, params);
        let copied = copy.items(&cx);
        i = 0usize;
        while i < copied.len(&cx) {
            let name = copied.get(&cx, i);
            if !inner.kinds.has(&cx, name) {
                self.fail(&cx, text_of(&cx, Buffer::new().push_static("Copy requires an in-scope type parameter, not ").push_bytes(&cx, name)), no_pos());
            }
            inner.kinds.set(&cx, name, Kind::Copy);
            i = i + 1usize;
        }
        let premises: Seq[Premise['k], 'k] = Seq::new(&cx);
        i = 0usize;
        while i < f.premises.len(&cx) {
            let premise = f.premises.get(&cx, i);
            if !is_copy_trait(&cx, premise.trait_path) {
                premises.push(&cx, self.premise(&cx, premise.args, inner));
            }
            i = i + 1usize;
        }
        (params, premises, inner)
    }

    fn copy_names(self, &cx: Cx!['k], header: Option[S::Forall['k]]) -> Result[Set[Text['k], 'k], SigError['k]] {
        let names: Set[Text['k], 'k] = Set::new(&cx);
        let premises = match header {
            Option::Some(f) => f.premises,
            Option::None => Seq::new(&cx),
        };
        var i = 0usize;
        while i < premises.len(&cx) {
            let premise = premises.get(&cx, i);
            if is_copy_trait(&cx, premise.trait_path) {
                let args = premise.args.args;
                if args.len(&cx) != 1usize {
                    return sig_error_static(&cx, "Copy requires one type parameter");
                }
                let arg = match args.get(&cx, 0usize) {
                    S::Type::Name(n) => n,
                    _ => return sig_error_static(&cx, "Copy requires one type parameter"),
                };
                let param = match self.r.refs.get(&cx, arg.id) {
                    Option::Some(r) => match r {
                        NameRef::Param(name) => Option::Some.(name),
                        _ => Option::None,
                    },
                    Option::None => Option::None,
                };
                if !arg.args.is_empty(&cx) || arg.path.len(&cx) != 1usize || param.is_none() {
                    return sig_error_static(&cx, "Copy requires one bare, in-scope type parameter");
                }
                let unit = match param {
                    Option::Some(name) => names.add(&cx, name),
                    Option::None => (),
                };
            }
            i = i + 1usize;
        }
        Result::Ok.(names)
    }

    fn premise(self, &cx: Cx!['k], args: S::TypeArgs['k], scope: Scope['k]) -> Premise['k] {
        let r = match self.r.refs.get(&cx, args.id) {
            Option::Some(r) => r,
            Option::None => fail(&cx, text(&cx, "internal error: an unresolved premise")),
        };
        let is_exposed = match r {
            NameRef::Builtin(name) => name.is(&cx, "Exposed"),
            _ => false,
        };
        let actual = self.got(&cx, self.types_of(&cx, args.args, scope));
        if is_exposed {
            return Premise.{ trait_name: text(&cx, "builtin::Exposed"), args: actual };
        }
        let decl = match r {
            NameRef::Decl(d) => d,
            _ => fail(&cx, text(&cx, "internal error: a premise that names no trait")),
        };
        let unit = self.got(&cx, self.check_arguments(&cx, decl, actual, scope));
        Premise.{ trait_name: self.name(&cx, decl), args: actual }
    }

    fn check_arguments(self, &cx: Cx!['k], decl: Decl['k], args: Seq[Type['k], 'k], scope: Scope['k]) -> Result[bool, SigError['k]] {
        let header = named_quantifier(decl.node);
        let params = match header {
            Option::Some(f) => all_params(&cx, f),
            Option::None => if decl.kind.is(&cx, "trait") { Seq::one(&cx, text(&cx, "Self")) } else { Seq::new(&cx) },
        };
        if args.len(&cx) != params.len(&cx) {
            return sig_error(text_of(&cx, Buffer::new().push_bytes(&cx, decl.name).push_static(" takes ").push_usize(params.len(&cx)).push_static(" type arguments, got ").push_usize(args.len(&cx))), no_pos());
        }
        let copied = match self.copy_names(&cx, header) {
            Result::Ok(c) => c,
            Result::Err(e) => return Result::Err.(e),
        };
        var i = 0usize;
        while i < params.len(&cx) {
            let param = params.get(&cx, i);
            let arg = args.get(&cx, i);
            if param.starts_with(&cx, text(&cx, "'")) != is_skolem(arg) {
                return sig_error(text_of(&cx, Buffer::new().push_static("argument for ").push_bytes(&cx, param).push_static(" of ").push_bytes(&cx, decl.name)
                    .push_static(" has the wrong kind (brand versus type)")), no_pos());
            }
            if copied.has(&cx, param) {
                let unit = self.require_copy(&cx, arg, scope.kinds)?;
            }
            i = i + 1usize;
        }
        Result::Ok.(true)
    }

    fn require_copy(self, &cx: Cx!['k], ty: Type['k], kinds: Map[Text['k], Kind, 'k]) -> Result[bool, SigError['k]] {
        if !self.types_ready.get(&cx) {
            self.copy_checks.push(&cx, (ty, kinds.copy(&cx)));
        } else if !Types::new(&cx, self.program(&cx), self.counter).is_copy(&cx, ty, kinds) {
            return sig_error_static(&cx, "type argument must satisfy Copy");
        }
        Result::Ok.(true)
    }

    // ---- types
    fn types_of(self, &cx: Cx!['k], exprs: Seq[S::Type['k], 'k], scope: Scope['k]) -> Result[Seq[Type['k], 'k], SigError['k]] {
        let out: Seq[Type['k], 'k] = Seq::new(&cx);
        var i = 0usize;
        while i < exprs.len(&cx) {
            out.push(&cx, self.type(&cx, exprs.get(&cx, i), scope)?);
            i = i + 1usize;
        }
        Result::Ok.(out)
    }

    fn slot_types(self, &cx: Cx!['k], slots: Seq[S::Slot['k], 'k], scope: Scope['k]) -> Result[Seq[Type['k], 'k], SigError['k]] {
        let out: Seq[Type['k], 'k] = Seq::new(&cx);
        var i = 0usize;
        while i < slots.len(&cx) {
            out.push(&cx, self.type(&cx, slots.get(&cx, i).type, scope)?);
            i = i + 1usize;
        }
        Result::Ok.(out)
    }

    fn type(self, &cx: Cx!['k], type_expr: S::Type['k], scope: Scope['k]) -> Result[Type['k], SigError['k]] {
        match type_expr {
            S::Type::Name(n) => {
                let args = self.types_of(&cx, n.args, scope)?;
                let not_a_type = text_of(&cx, Buffer::new().push_static("not a type name: ").push_bytes(&cx, repr_tuple(&cx, n.path)));
                let r = match self.r.refs.get(&cx, n.id) {
                    Option::Some(r) => r,
                    Option::None => return sig_error(not_a_type, no_pos()),
                };
                match r {
                    NameRef::Param(name) => if !args.is_empty(&cx) {
                        sig_error(text_of(&cx, Buffer::new().push_static("type parameter ").push_bytes(&cx, name).push_static(" takes no type arguments")), no_pos())
                    } else {
                        Result::Ok.(C::named(name, Seq::new(&cx)))
                    },
                    NameRef::Prim(name) => if !args.is_empty(&cx) {
                        sig_error(text_of(&cx, Buffer::new().push_static("primitive ").push_bytes(&cx, name).push_static(" takes no type arguments")), no_pos())
                    } else {
                        Result::Ok.(Type::Prim.(name))
                    },
                    NameRef::Builtin(name) => if name.is(&cx, "Brand") {
                        if args.len(&cx) != 1usize || !is_skolem(args.get(&cx, 0usize)) {
                            sig_error_static(&cx, "Brand requires exactly one brand argument")
                        } else {
                            Result::Ok.(Type::Brand.(Cell::new(&cx, args.get(&cx, 0usize))))
                        }
                    } else if name.is(&cx, "Never") {
                        if !args.is_empty(&cx) {
                            sig_error_static(&cx, "Never takes no type arguments")
                        } else {
                            Result::Ok.(Type::Never)
                        }
                    } else {
                        sig_error(not_a_type, no_pos())
                    },
                    NameRef::Decl(decl) => {
                        let unit = self.check_arguments(&cx, decl, args, scope)?;
                        Result::Ok.(C::named(self.name(&cx, decl), args))
                    },
                    _ => sig_error(not_a_type, no_pos()),
                }
            },
            S::Type::Brand(quoted) => {
                let label = quoted.from(1usize);
                if !scope.brands.has(&cx, label) && !label.is(&cx, "static") {
                    return sig_error(text_of(&cx, Buffer::new().push_static("brand '").push_bytes(&cx, label).push_static(" is not in scope")), no_pos());
                }
                Result::Ok.(Type::Skolem.(label))
            },
            S::Type::Ptr(inner) => Result::Ok.(C::ptr(&cx, self.type(&cx, inner.get(&cx), scope)?)),
            S::Type::Never => Result::Ok.(Type::Never),
            S::Type::Tuple(elems) => Result::Ok.(Type::Tuple.(self.types_of(&cx, elems, scope)?)),
            S::Type::Array(elem, length) => {
                let elem_type = self.type(&cx, elem.get(&cx), scope)?;
                let count = self.array_length(&cx, length.get(&cx))?;
                Result::Ok.(Type::Array.(Cell::new(&cx, elem_type), count))
            },
            S::Type::Fn(f) => {
                let params = self.slot_types(&cx, f.params, scope)?;
                let ret = self.type(&cx, f.ret.get(&cx), scope)?;
                Result::Ok.(C::fn_type(&cx, params, ret, Seq::new(&cx), f.is_unsafe, places_of(&cx, f.params, 0usize)))
            },
            S::Type::Closure(c) => {
                let environment = match c.env {
                    Option::Some(env) => self.type(&cx, env.get(&cx), scope)?,
                    Option::None => match scope.implicit.get(&cx) {
                        Option::Some(implicit) => {
                            self.implicit.set(&cx, self.implicit.get(&cx) + 1u32);
                            let name = text_of(&cx, Buffer::new().push_static("Env#").push_u64(self.implicit.get(&cx) as u64));
                            implicit.push(&cx, Param.{ name, kind: Kind::Any });
                            C::named(name, Seq::new(&cx))
                        },
                        Option::None => return sig_error_static(&cx, "a closure type needs [Env] outside a parameter list"),
                    },
                };
                let params = Seq::one(&cx, environment);
                params.append(&cx, self.slot_types(&cx, c.params, scope)?);
                let ret = self.type(&cx, c.ret.get(&cx), scope)?;
                let code = C::fn_type(&cx, params, ret, Seq::new(&cx), false, places_of(&cx, c.params, 1usize));
                Result::Ok.(Type::Struct.(Seq::two(&cx, Member.{ name: text(&cx, "env"), type: environment }, Member.{ name: text(&cx, "code"), type: code })))
            },
            S::Type::Exists(brands, body) => {
                let labels: Seq[Text['k], 'k] = Seq::new(&cx);
                let binders: Seq[Param['k], 'k] = Seq::new(&cx);
                var i = 0usize;
                while i < brands.len(&cx) {
                    let label = brands.get(&cx, i).from(1usize);
                    labels.push(&cx, label);
                    binders.push(&cx, Param.{ name: label, kind: Kind::Brand });
                    i = i + 1usize;
                }
                let inner = self.type(&cx, body.get(&cx), scope.extend(&cx, binders))?;
                Result::Ok.(Type::Exists.(labels, Cell::new(&cx, inner)))
            },
            S::Type::Foreach(f) => {
                let source = self.type(&cx, f.source.get(&cx), scope)?;
                let body = self.type(&cx, f.body.get(&cx), scope.extend(&cx, Seq::one(&cx, Param.{ name: f.binder, kind: Kind::Any })))?;
                Result::Ok.(C::foreach_type(&cx, f.binder, f.indirect, source, body))
            },
            S::Type::Forall(tparams, body) => {
                let quantified: Seq[Param['k], 'k] = Seq::new(&cx);
                var all_brands = true;
                var i = 0usize;
                while i < tparams.len(&cx) {
                    let p = tparams.get(&cx, i);
                    quantified.push(&cx, Param.{ name: p.from(1usize), kind: Kind::Brand });
                    if !p.starts_with(&cx, text(&cx, "'")) {
                        all_brands = false;
                    }
                    i = i + 1usize;
                }
                let inner = self.type(&cx, body.get(&cx), scope.extend(&cx, quantified))?;
                match inner {
                    Type::Fn(f) => if all_brands {
                        Result::Ok.(C::fn_type(&cx, f.params, f.ret.get(&cx), quantified, f.is_unsafe, f.places))
                    } else {
                        sig_error_static(&cx, "forall in a type quantifies brands of a function type")
                    },
                    _ => sig_error_static(&cx, "forall in a type quantifies brands of a function type"),
                }
            },
            S::Type::Ignored => sig_error_static(&cx, "no core type for TIgnored"),
        }
    }

    // An array length is folded as a usize, but a literal with another integer suffix keeps its
    // own type: the length is the value's 64 bits, so a negative length of a signed type is its
    // two's complement.
    fn array_length(self, &cx: Cx!['k], expr: Expr['k]) -> Result[u64, SigError['k]] {
        match self.fold(&cx, expr, Option::Some.(C::usize_type(&cx)), Option::None, true)? {
            ConstValue::Int(value, ty) => if is_negative(&cx, value, ty) {
                sig_error_static(&cx, "negative array length")
            } else {
                Result::Ok.(value)
            },
            _ => sig_error_static(&cx, "an array length is an integer constant"),
        }
    }

    // ---- declarations
    fn type_decl(self, &cx: Cx!['k], decl: Decl['k]) -> TypeDecl['k] {
        let (params, premises, scope) = self.quantifier(&cx, named_quantifier(decl.node), new_scope(&cx));
        let (body, linear, written) = match decl.node {
            Named::Struct(node) => {
                let fields: Seq[Member['k], 'k] = Seq::new(&cx);
                var i = 0usize;
                while i < node.fields.len(&cx) {
                    let field = node.fields.get(&cx, i);
                    fields.push(&cx, Member.{ name: field.name, type: self.got(&cx, self.type(&cx, field.type, scope)) });
                    i = i + 1usize;
                }
                (Type::Struct.(fields), node.linear, node.exposure)
            },
            Named::Tuple(node) => (Type::Tuple.(self.got(&cx, self.types_of(&cx, node.elems, scope))), node.linear, node.exposure),
            Named::Enum(node) => {
                let variants: Seq[Member['k], 'k] = Seq::new(&cx);
                var i = 0usize;
                while i < node.variants.len(&cx) {
                    let variant = node.variants.get(&cx, i);
                    variants.push(&cx, Member.{ name: variant.name, type: self.got(&cx, self.payload(&cx, variant.payload, scope)) });
                    i = i + 1usize;
                }
                (Type::Enum.(variants), node.linear, node.exposure)
            },
            _ => fail(&cx, text(&cx, "internal error: a type declaration that declares no type")),
        };
        var exposure = Option::Some.(Exposure.{ mode: ExposureMode::Owner, home: decl.home });
        let unit = match written {
            Option::Some(e) => {
                exposure = match e.scope {
                    Option::Some(path) => Option::Some.(Exposure.{ mode: ExposureMode::Within, home: self.scope_module(&cx, decl, path) }),
                    Option::None => Option::None,
                };
            },
            Option::None => (),
        };
        TypeDecl.{ name: self.name(&cx, decl), linear, params, premises, body, home: Option::Some.(decl.home), exposure }
    }

    fn payload(self, &cx: Cx!['k], types: Seq[S::Type['k], 'k], scope: Scope['k]) -> Result[Type['k], SigError['k]] {
        if types.is_empty(&cx) {
            return Result::Ok.(C::unit(&cx));
        }
        if types.len(&cx) == 1usize {
            return self.type(&cx, types.get(&cx, 0usize), scope);
        }
        Result::Ok.(Type::Tuple.(self.types_of(&cx, types, scope)?))
    }

    fn scope_module(self, &cx: Cx!['k], decl: Decl['k], path: Seq[Text['k], 'k]) -> ModuleId['k] {
        let target = match self.r.need(&cx, decl.home, path, no_pos()) {
            Target::Module(m) => Option::Some.(m),
            _ => Option::None,
        };
        match target {
            Option::Some(m) => if decl.home.within(&cx, m) {
                return m;
            },
            Option::None => (),
        };
        self.fail(&cx, text_of(&cx, Buffer::new().push_static("an exposure scope is an enclosing module of ").push_bytes(&cx, decl.name)), no_pos())
    }

    // The signature of a function, method or extern declaration.
    fn decl_signature(self, &cx: Cx!['k], decl: Decl['k]) -> Sig['k] {
        let node = match decl.node {
            Named::Fn(f) => fn_header(f),
            Named::Extern(x) => Header.{ params: x.params, ret: x.ret, quantifier: x.quantifier, is_unsafe: true, pos: x.pos },
            _ => fail(&cx, text(&cx, "internal error: a signature of a declaration that is not callable")),
        };
        self.signature(&cx, Option::Some.(decl), node, Seq::new(&cx), Seq::new(&cx), Option::None, Option::None)
    }

    fn signature(self, &cx: Cx!['k], decl: Option[Decl['k]], node: Header['k], outer: Seq[Param['k], 'k], outer_premises: Seq[Premise['k], 'k],
                 outer_scope: Option[Scope['k]], name: Option[Text['k]]) -> Sig['k] {
        var scope = match outer_scope {
            Option::Some(s) => s,
            Option::None => new_scope(&cx),
        };
        var outer = outer;
        var outer_premises = outer_premises;
        // a method's impl, which also gives `self` its type
        var method_impl = Option::None;
        let unit = match decl {
            Option::Some(d) => if d.kind.is(&cx, "method") {
                method_impl = d.impl_block;
            },
            Option::None => (),
        };
        let unit = match method_impl {
            Option::Some(impl_block) => {
                let (impl_params, impl_premises, inner) = self.quantifier(&cx, impl_block.quantifier, scope);
                outer = concat_params(&cx, outer, impl_params);
                outer_premises = concat_premises(&cx, outer_premises, impl_premises);
                scope = inner;
            },
            Option::None => (),
        };
        let (params, premises, inner) = self.quantifier(&cx, node.quantifier, scope);
        let scope = inner;
        let copied = self.got(&cx, self.copy_names(&cx, node.quantifier));
        let adjusted: Seq[Param['k], 'k] = Seq::new(&cx);
        var i = 0usize;
        while i < outer.len(&cx) {
            let p = outer.get(&cx, i);
            let any = match p.kind {
                Kind::Any => true,
                _ => false,
            };
            adjusted.push(&cx, if copied.has(&cx, p.name) && any { Param.{ name: p.name, kind: Kind::Copy } } else { p });
            i = i + 1usize;
        }
        let outer = adjusted;
        i = 0usize;
        while i < outer.len(&cx) {
            let p = outer.get(&cx, i);
            let unit = match p.kind {
                Kind::Brand => (),
                _ => scope.kinds.set(&cx, p.name, p.kind),
            };
            i = i + 1usize;
        }
        let implicit: Seq[Param['k], 'k] = Seq::new(&cx);
        scope.implicit.set(&cx, Option::Some.(implicit));
        let pnames: Seq[Text['k], 'k] = Seq::new(&cx);
        let ptypes: Seq[Type['k], 'k] = Seq::new(&cx);
        let places: Seq[usize, 'k] = Seq::new(&cx);
        var k = 0usize;
        while k < node.params.len(&cx) {
            let p = node.params.get(&cx, k);
            let unit = match p.type {
                Option::None => {
                    let self_type = match method_impl {
                        Option::Some(impl_block) => if p.name.is(&cx, "self") { Option::Some.(impl_block.type) } else { Option::None },
                        Option::None => Option::None,
                    };
                    match self_type {
                        Option::Some(t) => ptypes.push(&cx, self.got(&cx, self.type(&cx, t, scope))),
                        Option::None => self.fail(&cx, text_of(&cx, Buffer::new().push_static("parameter ").push_bytes(&cx, p.name).push_static(" needs a type")), node.pos),
                    }
                },
                Option::Some(t) => ptypes.push(&cx, self.got(&cx, self.type(&cx, t, scope))),
            };
            pnames.push(&cx, p.name);
            if p.lend {
                places.push(&cx, k);
            }
            k = k + 1usize;
        }
        scope.implicit.set(&cx, Option::None);
        let ret = match node.ret {
            Option::None => C::unit(&cx),
            Option::Some(t) => self.got(&cx, self.type(&cx, t, scope)),
        };
        let core_name = match name {
            Option::Some(n) => n,
            Option::None => match decl {
                Option::Some(d) => self.name(&cx, d),
                Option::None => fail(&cx, text(&cx, "internal error: a signature without a name")),
            },
        };
        let all = concat_params(&cx, concat_params(&cx, outer, params), implicit);
        let home = match decl {
            Option::Some(d) => Option::Some.(d.home),
            Option::None => Option::None,
        };
        Sig.{ name: core_name, decl, params: all, premises: concat_premises(&cx, outer_premises, premises), pnames, ptypes, places, ret,
              is_unsafe: node.is_unsafe, home }
    }

    fn trait_decl(self, &cx: Cx!['k], decl: Decl['k]) -> C::Trait['k] {
        let node = match decl.node {
            Named::Trait(t) => t,
            _ => fail(&cx, text(&cx, "internal error: a trait declaration that declares no trait")),
        };
        let (declared, premises, declared_scope) = self.quantifier(&cx, node.quantifier, new_scope(&cx));
        if !premises.is_empty(&cx) {
            self.fail(&cx, text(&cx, "trait declarations cannot have their own trait premises"), node.pos);
        }
        let self_param = Param.{ name: text(&cx, "Self"), kind: Kind::Any };
        let (params, scope) = if node.quantifier.is_none() {
            (Seq::one(&cx, self_param), declared_scope.extend(&cx, Seq::one(&cx, self_param)))
        } else {
            (declared, declared_scope)
        };
        let methods: Seq[C::Method['k], 'k] = Seq::new(&cx);
        var i = 0usize;
        while i < node.methods.len(&cx) {
            let m = node.methods.get(&cx, i);
            let sig = self.signature(&cx, Option::None, fn_header(m), Seq::new(&cx), Seq::new(&cx), Option::Some.(scope), Option::Some.(m.name));
            if !sig.params.is_empty(&cx) {
                self.fail(&cx, text_of(&cx, Buffer::new().push_static("trait method ").push_bytes(&cx, m.name).push_static(" cannot be generic itself")), no_pos());
            }
            methods.push(&cx, C::Method.{ name: m.name, ret: sig.ret, ptypes: sig.ptypes, is_unsafe: sig.is_unsafe, places: sig.places });
            i = i + 1usize;
        }
        let names: Seq[Text['k], 'k] = Seq::new(&cx);
        let kinds: Seq[Kind, 'k] = Seq::new(&cx);
        i = 0usize;
        while i < params.len(&cx) {
            names.push(&cx, params.get(&cx, i).name);
            kinds.push(&cx, params.get(&cx, i).kind);
            i = i + 1usize;
        }
        C::Trait.{ name: self.name(&cx, decl), params: names, methods, home: Option::Some.(decl.home), param_kinds: kinds }
    }

    fn instance_decl(self, &cx: Cx!['k], item: S::InstanceDecl['k], home: ModuleId['k]) -> (InstanceSig['k], S::InstanceDecl['k], ModuleId['k]) {
        let (params, premises, scope) = self.quantifier(&cx, item.quantifier, new_scope(&cx));
        let head = match item.type {
            S::Type::Name(n) => n,
            _ => fail(&cx, text(&cx, "internal error: an instance of something other than a trait")),
        };
        let trait_decl = match self.r.refs.get(&cx, head.id) {
            Option::Some(r) => match r {
                NameRef::Decl(d) => d,
                _ => fail(&cx, text(&cx, "internal error: an instance of something other than a trait")),
            },
            Option::None => fail(&cx, text(&cx, "internal error: an unresolved instance")),
        };
        let arguments = self.got(&cx, self.types_of(&cx, head.args, scope));
        let unit = self.got(&cx, self.check_arguments(&cx, trait_decl, arguments, scope));
        let methods: Seq[Sig['k], 'k] = Seq::new(&cx);
        var i = 0usize;
        while i < item.methods.len(&cx) {
            let m = item.methods.get(&cx, i);
            let sig = self.signature(&cx, Option::None, fn_header(m), params, premises, Option::Some.(scope), Option::Some.(m.name));
            methods.push(&cx, Sig.{ name: sig.name, decl: sig.decl, params: sig.params, premises: sig.premises, pnames: sig.pnames,
                               ptypes: sig.ptypes, places: sig.places, ret: sig.ret, is_unsafe: sig.is_unsafe, home: Option::Some.(home) });
            i = i + 1usize;
        }
        let inst = InstanceSig.{ trait_name: self.name(&cx, trait_decl), params, premises, head: arguments, methods, home, pos: item.pos };
        (inst, item, home)
    }

    // ---- consts
    fn const_decl(self, &cx: Cx!['k], decl: Decl['k]) -> Result[ConstValue['k], SigError['k]] {
        let unit = match self.consts.get(&cx, decl.id) {
            Option::Some(value) => return Result::Ok.(value),
            Option::None => (),
        };
        if self.folding.has(&cx, decl.id) {
            return sig_error(text_of(&cx, Buffer::new().push_static("const ").push_bytes(&cx, decl.name).push_static(" depends on itself")), no_pos());
        }
        self.folding.add(&cx, decl.id);
        let result = self.const_value(&cx, decl);
        self.folding.remove(&cx, decl.id);
        result
    }

    fn const_value(self, &cx: Cx!['k], decl: Decl['k]) -> Result[ConstValue['k], SigError['k]] {
        let node = match decl.node {
            Named::Const(c) => c,
            _ => fail(&cx, text(&cx, "internal error: a const declaration that declares no const")),
        };
        let value = self.typed(&cx, decl.name, node.value, self.type(&cx, node.type, new_scope(&cx))?, decl.home)?;
        self.consts.set(&cx, decl.id, value);
        Result::Ok.(value)
    }

    // The value of `const name: want = expr`, which must have type `want`.
    fn typed(self, &cx: Cx!['k], name: Text['k], expr: Expr['k], want: Type['k], home: ModuleId['k]) -> Result[ConstValue['k], SigError['k]] {
        let value = self.fold(&cx, expr, Option::Some.(want), Option::Some.(home), true)?;
        if !same_type(&cx, const_type(&cx, value), Option::Some.(want)) {
            return sig_error(text_of(&cx, Buffer::new().push_static("const ").push_bytes(&cx, name).push_static(" is not a ").push_bytes(&cx, type_repr(&cx, want))), no_pos());
        }
        Result::Ok.(value)
    }

    // `Slice[u8, 'static]`, the type of a string literal.
    fn string_type(self, &cx: Cx!['k], home: ModuleId['k]) -> Type['k] {
        Type::Named.(self.name(&cx, self.library(&cx, home, text(&cx, "Slice"))), Seq::two(&cx, C::prim(&cx, "u8"), Type::Skolem.(text(&cx, "static"))))
    }

    // Type a constant expression and, when `evaluate`, its value.
    //
    // Unevaluated short-circuit operands still validate operators and literals; only computed
    // values (and their division-by-zero traps) are skipped.
    fn fold(self, &cx: Cx!['k], expr: Expr['k], want: Option[Type['k]], home: Option[ModuleId['k]], evaluate: bool) -> Result[ConstValue['k], SigError['k]] {
        match expr {
            Expr::Lit(lit) => match lit.kind {
                S::LitKind::Int => {
                    let ty = match lit.suffix {
                        Option::Some(suffix) => Option::Some.(Type::Prim.(suffix)),
                        Option::None => want,
                    };
                    match integer_type(&cx, ty) {
                        Option::Some(name) => self.wrapped_literal(&cx, lit.int, false, name, lit.pos),
                        Option::None => sig_error(text(&cx, "an integer constant needs a type"), lit.pos),
                    }
                },
                S::LitKind::Bool => Result::Ok.(ConstValue::Bool.(lit.int != 0u64)),
                S::LitKind::Float => {
                    let ty = match lit.suffix {
                        Option::Some(suffix) => Option::Some.(Type::Prim.(suffix)),
                        Option::None => want,
                    };
                    if !is_float_type(&cx, ty) {
                        return sig_error(text(&cx, "a floating constant needs a floating type"), lit.pos);
                    }
                    let prim = match ty {
                        Option::Some(t) => t,
                        Option::None => C::unit(&cx),
                    };
                    if !valid_literal(&cx, prim, lit.text) {
                        let name = match prim {
                            Type::Prim(n) => n,
                            _ => text(&cx, ""),
                        };
                        return sig_error(text_of(&cx, Buffer::new().push_static("literal ").push_bytes(&cx, lit.text).push_static(" does not fit ").push_bytes(&cx, name)), lit.pos);
                    }
                    Result::Ok.(ConstValue::Float.(lit.text, prim))
                },
                S::LitKind::Str => Result::Ok.(ConstValue::Str.(lit.text, match home {
                    Option::Some(h) => Option::Some.(self.string_type(&cx, h)),
                    Option::None => Option::None,
                })),
            },
            Expr::Path(path) => {
                let decl = match self.r.refs.get(&cx, path.id) {
                    Option::Some(r) => match r {
                        NameRef::Decl(d) => if d.kind.is(&cx, "const") { Option::Some.(d) } else { Option::None },
                        _ => Option::None,
                    },
                    Option::None => Option::None,
                };
                match decl {
                    Option::Some(d) => {
                        var i = 0usize;
                        while i < path.segments.len(&cx) {
                            if !path.segments.get(&cx, i).args.is_empty(&cx) {
                                return sig_error(text(&cx, "constant paths take no type arguments"), path.pos);
                            }
                            i = i + 1usize;
                        }
                        self.const_decl(&cx, d)
                    },
                    Option::None => sig_error(text(&cx, "a constant expression names only consts"), path.pos),
                }
            },
            Expr::Tuple(t) => if t.value.len(&cx) == 1usize {
                self.fold(&cx, t.value.get(&cx, 0usize), want, home, evaluate)
            } else {
                sig_error(text(&cx, "not a constant expression"), t.pos)
            },
            Expr::Unary(u) => if u.op.is(&cx, "-") || u.op.is(&cx, "!") {
                self.unary(&cx, u, want, home, evaluate)
            } else {
                sig_error(text(&cx, "not a constant expression"), u.pos)
            },
            Expr::Cast(c) => {
                let v = self.fold(&cx, c.value.get(&cx), Option::None, home, evaluate)?;
                let to = self.type(&cx, c.type, new_scope(&cx))?;
                let unit = match v {
                    ConstValue::Int(value, _ty) => match integer_type(&cx, Option::Some.(to)) {
                        Option::Some(name) => return Result::Ok.(wrapped(&cx, value, name)),
                        Option::None => (),
                    },
                    _ => (),
                };
                sig_error(text(&cx, "a constant cast converts between integer types"), c.pos)
            },
            Expr::Binop(b) => self.binop(&cx, b, want, home, evaluate),
            _ => sig_error(text(&cx, "not a constant expression"), S::expr_pos(expr)),
        }
    }

    // `-` or `!` applied to a constant.
    fn unary(self, &cx: Cx!['k], expr: S::Unary['k], want: Option[Type['k]], home: Option[ModuleId['k]], evaluate: bool) -> Result[ConstValue['k], SigError['k]] {
        if expr.op.is(&cx, "-") {
            let unit = match expr.operand.get(&cx) {
                Expr::Lit(literal) => match literal.kind {
                    S::LitKind::Int => {
                        let ty = match literal.suffix {
                            Option::Some(suffix) => Option::Some.(Type::Prim.(suffix)),
                            Option::None => want,
                        };
                        return match integer_type(&cx, ty) {
                            Option::Some(name) => self.wrapped_literal(&cx, literal.int, true, name, expr.pos),
                            Option::None => sig_error(text(&cx, "an integer constant needs a type"), expr.pos),
                        };
                    },
                    _ => (),
                },
                _ => (),
            };
        }
        let v = self.fold(&cx, expr.operand.get(&cx), want, home, evaluate)?;
        match v {
            ConstValue::Float(digits, ty) => if expr.op.is(&cx, "-") {
                let negated = if digits.starts_with(&cx, text(&cx, "-")) { digits.from(1usize) } else { text(&cx, "-").concat(&cx, digits) };
                return Result::Ok.(ConstValue::Float.(negated, ty));
            },
            ConstValue::Bool(b) => if expr.op.is(&cx, "!") {
                return Result::Ok.(ConstValue::Bool.(!b));
            },
            _ => (),
        };
        match v {
            ConstValue::Int(value, ty) => {
                let name = match ty {
                    Type::Prim(n) => n,
                    _ => text(&cx, ""),
                };
                Result::Ok.(wrapped(&cx, if expr.op.is(&cx, "-") { 0u64 - value } else { value ^ all_bits() }, name))
            },
            _ => sig_error(text(&cx, "operator needs an integer"), expr.pos),
        }
    }

    fn binop(self, &cx: Cx!['k], expr: S::Binop['k], want: Option[Type['k]], home: Option[ModuleId['k]], evaluate: bool) -> Result[ConstValue['k], SigError['k]] {
        let op = expr.op;
        if op.is(&cx, "&&") || op.is(&cx, "||") {
            let a = match self.fold(&cx, expr.left.get(&cx), Option::Some.(C::bool_type(&cx)), home, evaluate)? {
                ConstValue::Bool(x) => x,
                _ => return sig_error(text(&cx, "logical constant operands must be booleans"), expr.pos),
            };
            let needed = if op.is(&cx, "&&") { a } else { !a };
            let b = match self.fold(&cx, expr.right.get(&cx), Option::Some.(C::bool_type(&cx)), home, evaluate && needed)? {
                ConstValue::Bool(x) => x,
                _ => return sig_error(text(&cx, "logical constant operands must be booleans"), expr.pos),
            };
            return Result::Ok.(ConstValue::Bool.(if op.is(&cx, "&&") { a && b } else { a || b }));
        }
        let comparison = is_comparison(&cx, op);
        let hint = if comparison { Option::None } else { want };
        // The left operand first, giving the right its type; if that fails, the other way round.
        let first = match self.fold(&cx, expr.left.get(&cx), hint, home, evaluate) {
            Result::Ok(a) => match self.fold(&cx, expr.right.get(&cx), const_type(&cx, a), home, evaluate) {
                Result::Ok(b) => Option::Some.((a, b)),
                Result::Err(_e) => Option::None,
            },
            Result::Err(_e) => Option::None,
        };
        let (a, b) = match first {
            Option::Some(pair) => pair,
            Option::None => {
                let b = self.fold(&cx, expr.right.get(&cx), hint, home, evaluate)?;
                let a = self.fold(&cx, expr.left.get(&cx), const_type(&cx, b), home, evaluate)?;
                (a, b)
            },
        };
        let unit = match a {
            ConstValue::Bool(x) => if op.is(&cx, "==") || op.is(&cx, "!=") {
                return match b {
                    ConstValue::Bool(y) => Result::Ok.(ConstValue::Bool.((x == y) == op.is(&cx, "=="))),
                    _ => sig_error(text(&cx, "constant comparison operands must have the same type"), expr.pos),
                };
            },
            _ => (),
        };
        let (x, ty) = match a {
            ConstValue::Int(x, ty) => (x, ty),
            _ => return sig_error(text(&cx, "constant operands must be integers of one type"), expr.pos),
        };
        let y = match b {
            ConstValue::Int(y, other) => if C::same(&cx, ty, other) { y } else {
                return sig_error(text(&cx, "constant operands must be integers of one type"), expr.pos);
            },
            _ => return sig_error(text(&cx, "constant operands must be integers of one type"), expr.pos),
        };
        let name = match ty {
            Type::Prim(n) => n,
            _ => text(&cx, ""),
        };
        if !evaluate {
            return Result::Ok.(if comparison { ConstValue::Bool.(false) } else { wrapped(&cx, 0u64, name) });
        }
        let signed = is_signed(&cx, name);
        if comparison {
            // Both values are sign-extended in a signed type: flipping the sign bit orders them as
            // unsigned numbers.
            let flip = if signed { sign_bit() } else { 0u64 };
            let p = x ^ flip;
            let q = y ^ flip;
            let result = if op.is(&cx, "==") {
                p == q
            } else if op.is(&cx, "!=") {
                p != q
            } else if op.is(&cx, "<") {
                p < q
            } else if op.is(&cx, "<=") {
                p <= q
            } else if op.is(&cx, ">") {
                p > q
            } else {
                p >= q
            };
            return Result::Ok.(ConstValue::Bool.(result));
        }
        let bits = C::integer_bits(&cx, name) as u64;
        let value = if op.is(&cx, "/") || op.is(&cx, "%") {
            if y == 0u64 {
                return sig_error(text(&cx, "constant division by zero"), expr.pos);
            }
            // The quotient rounds toward zero, from the magnitudes; the most negative i64's
            // magnitude, 2^63, fits in a u64.
            let x_negative = signed && x >= sign_bit();
            let y_negative = signed && y >= sign_bit();
            let x_magnitude = if x_negative { 0u64 - x } else { x };
            let y_magnitude = if y_negative { 0u64 - y } else { y };
            let magnitude = x_magnitude / y_magnitude;
            let q = if x_negative == y_negative { magnitude } else { 0u64 - magnitude };
            if op.is(&cx, "/") { q } else { x - q * y }
        } else if op.is(&cx, "<<") || op.is(&cx, ">>") {
            // `y % bits` of the whole value: the width is a power of two.
            let shift = y & (bits - 1u64);
            if op.is(&cx, "<<") {
                x << shift
            } else if signed && x >= sign_bit() {
                // An arithmetic shift of a negative value.
                (((x ^ all_bits()) >> shift) ^ all_bits())
            } else {
                x >> shift
            }
        } else if op.is(&cx, "+") {
            x + y
        } else if op.is(&cx, "-") {
            x - y
        } else if op.is(&cx, "*") {
            x * y
        } else if op.is(&cx, "&") {
            x & y
        } else if op.is(&cx, "|") {
            x | y
        } else if op.is(&cx, "^") {
            x ^ y
        } else {
            fail(&cx, text_of(&cx, Buffer::new().push_static("internal error: no constant operator ").push_bytes(&cx, op)))
        };
        Result::Ok.(wrapped(&cx, value, name))
    }

    // A literal's value in the integer type `name`; it must fit (a negated one may reach the
    // minimum).
    fn wrapped_literal(self, &cx: Cx!['k], magnitude: u64, negative: bool, name: Text['k], pos: Pos) -> Result[ConstValue['k], SigError['k]] {
        let spelled = if negative && magnitude != 0u64 {
            text_of(&cx, Buffer::new().push_static("-").push_u64(magnitude))
        } else {
            text_of(&cx, Buffer::new().push_u64(magnitude))
        };
        if !valid_literal(&cx, Type::Prim.(name), spelled) {
            return sig_error(text_of(&cx, Buffer::new().push_bytes(&cx, spelled).push_static(" does not fit ").push_bytes(&cx, name)), pos);
        }
        Result::Ok.(wrapped(&cx, if negative { 0u64 - magnitude } else { magnitude }, name))
    }
}

// `value` in the integer type `name`'s width, sign-extended when it is signed.
forall 'k.
fn wrapped(&cx: Cx!['k], value: u64, name: Text['k]) -> ConstValue['k] {
    let bits = C::integer_bits(&cx, name) as u64;
    var v = value;
    if bits < 64u64 {
        let mask = (1u64 << bits) - 1u64;
        v = v & mask;
        if is_signed(&cx, name) && v >= 1u64 << (bits - 1u64) {
            v = v | (mask ^ all_bits());
        }
    }
    ConstValue::Int.(v, Type::Prim.(name))
}

// The indices of a function type's place slots, from `first`.
forall 'k.
fn places_of(&cx: Cx!['k], slots: Seq[S::Slot['k], 'k], first: usize) -> Seq[usize, 'k] {
    let out: Seq[usize, 'k] = Seq::new(&cx);
    var i = 0usize;
    while i < slots.len(&cx) {
        if slots.get(&cx, i).lend {
            out.push(&cx, i + first);
        }
        i = i + 1usize;
    }
    out
}

forall 'k.
fn signatures(&cx: Cx!['k], resolver: Resolver['k], counter: Fresh['k]) -> Signatures['k] {
    Signatures::new(&cx, resolver, counter)
}
