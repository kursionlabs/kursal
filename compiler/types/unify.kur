// First-order type unification, shared by inference and instance coherence.
//
// The inference variable is `core::Meta` (`Type::Meta`): its kind is type, int, float or brand,
// and solving it sets its solution.

use package::support::base::{Cx, Map, Seq, Set, Text, text};
use package::kurs::core::{FnType, Kind, Member, Meta, MetaKind, Param, Type};
use package::kurs::core as C;
use package::types::ops::{Fresh, extractable_names, foreach_binders, free_names, fresh, map_children, subst, type_tag};
use package::types::ops as T;
use std::collections::hashmap::{Found, OwnedMap};
use std::option::Option;

forall 'k.
fn prune(&cx: Cx!['k], ty: Type['k]) -> Type['k] {
    var ty = ty;
    var going = true;
    while going {
        going = false;
        let unit = match ty {
            Type::Meta(m) => match m.solution(&cx) {
                Option::Some(t) => {
                    ty = t;
                    going = true;
                },
                Option::None => (),
            },
            _ => (),
        };
    }
    ty
}

// `ty` with every solved metavariable replaced by its solution.
forall 'k.
fn zonk(&cx: Cx!['k], ty: Type['k]) -> Type['k] {
    map_children(&cx, prune(&cx, ty), |&cx, child: Type['k]| zonk(&cx, child))
}

// `ty` mentions no unsolved metavariable.
forall 'k.
fn ground(&cx: Cx!['k], ty: Type['k]) -> bool {
    let ty = zonk(&cx, ty);
    match ty {
        Type::Meta(_m) => false,
        _ => {
            let parts = T::children(&cx, ty);
            var all = true;
            var i = 0usize;
            while all && i < parts.len(&cx) {
                all = ground(&cx, parts.get(&cx, i));
                i = i + 1usize;
            }
            all
        },
    }
}

// A fresh metavariable for each type parameter (brand parameters get brand-kind ones).
forall 'k.
fn instantiate(&cx: Cx!['k], params: Seq[Param['k], 'k]) -> Map[Text['k], Type['k], 'k] {
    let out: Map[Text['k], Type['k], 'k] = Map::new(&cx);
    var i = 0usize;
    while i < params.len(&cx) {
        let p = params.get(&cx, i);
        let kind = match p.kind {
            Kind::Brand => MetaKind::Brand,
            _ => MetaKind::Type,
        };
        out.set(&cx, p.name, Type::Meta.(Meta::new(&cx, kind)));
        i = i + 1usize;
    }
    out
}

forall 'k.
fn is_meta(ty: Type['k], meta: Meta['k]) -> bool {
    match ty {
        Type::Meta(m) => m.id() == meta.id(),
        _ => false,
    }
}

forall 'k.
fn occurs(&cx: Cx!['k], meta: Meta['k], ty: Type['k]) -> bool {
    let ty = prune(&cx, ty);
    if is_meta(ty, meta) {
        return true;
    }
    let parts = T::children(&cx, ty);
    var found = false;
    var i = 0usize;
    while !found && i < parts.len(&cx) {
        found = occurs(&cx, meta, parts.get(&cx, i));
        i = i + 1usize;
    }
    found
}

forall 'k.
fn fits_kind(&cx: Cx!['k], kind: MetaKind, ty: Type['k]) -> bool {
    match kind {
        MetaKind::Int => match ty {
            Type::Prim(name) => C::is_integer(&cx, name),
            _ => false,
        },
        MetaKind::Float => match ty {
            Type::Prim(name) => C::is_float(&cx, name),
            _ => false,
        },
        MetaKind::Brand => match ty {
            Type::Skolem(_label) => true,
            _ => false,
        },
        MetaKind::Type => match ty {
            Type::Skolem(_label) => false,
            _ => true,
        },
    }
}

fn meta_kind_index(k: MetaKind) -> u32 {
    match k {
        MetaKind::Type => 0u32,
        MetaKind::Int => 1u32,
        MetaKind::Float => 2u32,
        MetaKind::Brand => 3u32,
    }
}

fn is_type_kind(k: MetaKind) -> bool {
    meta_kind_index(k) == 0u32
}

// The unsolved variables reachable through a type, including premises; each once.
forall 'k.
fn metas(&cx: Cx!['k], ty: Type['k]) -> Seq[Meta['k], 'k] {
    let out: Seq[Meta['k], 'k] = Seq::new(&cx);
    var seen = OwnedMap::new[usize, bool]();
    metas_into(&cx, ty, out, &seen);
    seen.free();
    out
}

forall 'k.
fn metas_into(&cx: Cx!['k], ty: Type['k], out: Seq[Meta['k], 'k], &seen: OwnedMap![usize, bool]) {
    let ty = prune(&cx, ty);
    match ty {
        Type::Meta(m) => match &seen.insert(m.id(), true) {
            Found::Missing => out.push(&cx, m),
            Found::Item(old) => (),
        },
        _ => {
            let parts = T::children(&cx, ty);
            var i = 0usize;
            while i < parts.len(&cx) {
                metas_into(&cx, parts.get(&cx, i), out, &seen);
                i = i + 1usize;
            }
        },
    }
}

forall 'k.
fn kinds_differ(&cx: Cx!['k], left: Seq[Param['k], 'k], right: Seq[Param['k], 'k]) -> bool {
    !T::same_kinds(&cx, left, right)
}

forall 'k.
fn concat(&cx: Cx!['k], xs: Seq[Type['k], 'k], ys: Seq[Type['k], 'k]) -> Seq[Type['k], 'k] {
    let out = xs.copy(&cx);
    out.append(&cx, ys);
    out
}

// Instance variables live outside binders; body inference variables may live inside.
forall 'k.
fn quantified(&cx: Cx!['k], left: Seq[Param['k], 'k], right: Seq[Param['k], 'k], xs: Seq[Type['k], 'k], ys: Seq[Type['k], 'k], closed: bool, counter: Fresh['k]) -> bool {
    if kinds_differ(&cx, left, right) || xs.len(&cx) != ys.len(&cx) {
        return false;
    }
    if !closed {
        let rename: Map[Text['k], Type['k], 'k] = Map::new(&cx);
        var i = 0usize;
        while i < left.len(&cx) && i < right.len(&cx) {
            let p = left.get(&cx, i);
            let q = right.get(&cx, i);
            rename.set(&cx, q.name, rigid(&cx, p.kind, p.name));
            i = i + 1usize;
        }
        var all = true;
        var j = 0usize;
        while all && j < xs.len(&cx) {
            all = unify(&cx, zonk(&cx, xs.get(&cx, j)), subst(&cx, zonk(&cx, ys.get(&cx, j)), rename, counter), false, counter);
            j = j + 1usize;
        }
        return all;
    }
    if left.is_empty(&cx) {
        var all = true;
        var j = 0usize;
        while all && j < xs.len(&cx) {
            all = unify(&cx, xs.get(&cx, j), ys.get(&cx, j), true, counter);
            j = j + 1usize;
        }
        return all;
    }
    let both = concat(&cx, xs, ys);
    let variables: Seq[Meta['k], 'k] = Seq::new(&cx);
    var seen = OwnedMap::new[usize, bool]();
    var k = 0usize;
    while k < both.len(&cx) {
        metas_into(&cx, both.get(&cx, k), variables, &seen);
        k = k + 1usize;
    }
    seen.free();
    let occupied: Set[Text['k], 'k] = Set::new(&cx);
    var k2 = 0usize;
    while k2 < both.len(&cx) {
        T::add_all(&cx, occupied, free_names(&cx, zonk(&cx, both.get(&cx, k2))));
        k2 = k2 + 1usize;
    }
    let labels: Seq[Text['k], 'k] = Seq::new(&cx);
    var n = 0usize;
    while n < left.len(&cx) {
        var label = fresh(&cx, text(&cx, "rigid"), counter);
        while occupied.has(&cx, label) {
            label = fresh(&cx, text(&cx, "rigid"), counter);
        }
        labels.push(&cx, label);
        n = n + 1usize;
    }
    let a: Map[Text['k], Type['k], 'k] = Map::new(&cx);
    let b: Map[Text['k], Type['k], 'k] = Map::new(&cx);
    var r = 0usize;
    while r < left.len(&cx) {
        let rigid_type = rigid(&cx, left.get(&cx, r).kind, labels.get(&cx, r));
        a.set(&cx, left.get(&cx, r).name, rigid_type);
        if r < right.len(&cx) {
            b.set(&cx, right.get(&cx, r).name, rigid_type);
        }
        r = r + 1usize;
    }
    var all = true;
    var j = 0usize;
    while all && j < xs.len(&cx) {
        all = unify(&cx, subst(&cx, zonk(&cx, xs.get(&cx, j)), a, counter), subst(&cx, zonk(&cx, ys.get(&cx, j)), b, counter), true, counter);
        j = j + 1usize;
    }
    if !all {
        return false;
    }
    let label_set = T::with_names(&cx, Set::new(&cx), labels);
    var escaped = false;
    var v = 0usize;
    while !escaped && v < variables.len(&cx) {
        escaped = T::overlap(&cx, free_names(&cx, zonk(&cx, Type::Meta.(variables.get(&cx, v)))), label_set);
        v = v + 1usize;
    }
    !escaped
}

// A rigid stand-in for a quantified parameter: a brand label or a type variable.
forall 'k.
fn rigid(&cx: Cx!['k], kind: Kind, name: Text['k]) -> Type['k] {
    match kind {
        Kind::Brand => Type::Skolem.(name),
        _ => C::named(name, Seq::new(&cx)),
    }
}

forall 'k.
fn params_named(&cx: Cx!['k], names: Seq[Text['k], 'k], kind: Kind) -> Seq[Param['k], 'k] {
    let out: Seq[Param['k], 'k] = Seq::new(&cx);
    var i = 0usize;
    while i < names.len(&cx) {
        out.push(&cx, Param.{ name: names.get(&cx, i), kind });
        i = i + 1usize;
    }
    out
}

forall 'k.
fn unify_all(&cx: Cx!['k], xs: Seq[Type['k], 'k], ys: Seq[Type['k], 'k], closed: bool, counter: Fresh['k]) -> bool {
    var ok = xs.len(&cx) == ys.len(&cx);
    var i = 0usize;
    while ok && i < xs.len(&cx) {
        ok = unify(&cx, xs.get(&cx, i), ys.get(&cx, i), closed, counter);
        i = i + 1usize;
    }
    ok
}

forall 'k.
fn unify_members(&cx: Cx!['k], xs: Seq[Member['k], 'k], ys: Seq[Member['k], 'k], closed: bool, counter: Fresh['k]) -> bool {
    var ok = xs.len(&cx) == ys.len(&cx);
    var i = 0usize;
    while ok && i < xs.len(&cx) {
        ok = xs.get(&cx, i).name.eq(&cx, ys.get(&cx, i).name) && unify(&cx, xs.get(&cx, i).type, ys.get(&cx, i).type, closed, counter);
        i = i + 1usize;
    }
    ok
}

// Solve equality; closed instance solutions cannot depend on nested binders.
//
// Two identical metavariables unify at once; any other pair is compared by structure.
forall 'k.
fn unify(&cx: Cx!['k], a: Type['k], b: Type['k], closed: bool, counter: Fresh['k]) -> bool {
    let a = prune(&cx, a);
    let b = prune(&cx, b);
    let unit = match a {
        Type::Meta(x) => {
            if is_meta(b, x) {
                return true;
            }
            return solve(&cx, x, b);
        },
        _ => match b {
            Type::Meta(y) => {
                return solve(&cx, y, a);
            },
            _ => (),
        },
    };
    if type_tag(a) != type_tag(b) {
        return false;
    }
    match a {
        Type::Named(n, xs) => match b {
            Type::Named(m, ys) => n.eq(&cx, m) && unify_all(&cx, xs, ys, closed, counter),
            _ => false,
        },
        Type::Prim(_n) => C::same(&cx, a, b),
        Type::Skolem(_n) => C::same(&cx, a, b),
        Type::Never => C::same(&cx, a, b),
        Type::Ignored => C::same(&cx, a, b),
        Type::Struct(fa) => match b {
            Type::Struct(fb) => unify_members(&cx, fa, fb, closed, counter),
            _ => false,
        },
        Type::Enum(fa) => match b {
            Type::Enum(fb) => unify_members(&cx, fa, fb, closed, counter),
            _ => false,
        },
        Type::Exists(xs, p) => match b {
            Type::Exists(ys, q) => quantified(&cx, params_named(&cx, xs, Kind::Brand), params_named(&cx, ys, Kind::Brand), Seq::one(&cx, p.get(&cx)), Seq::one(&cx, q.get(&cx)), closed, counter),
            _ => false,
        },
        Type::Foreach(x) => match b {
            Type::Foreach(y) => x.indirect == y.indirect && unify(&cx, x.source.get(&cx), y.source.get(&cx), closed, counter)
                && quantified(&cx, params_named(&cx, foreach_binders(&cx, x), Kind::Any), params_named(&cx, foreach_binders(&cx, y), Kind::Any), Seq::one(&cx, x.body.get(&cx)), Seq::one(&cx, y.body.get(&cx)), closed, counter),
            _ => false,
        },
        Type::Fn(x) => match b {
            Type::Fn(y) => {
                if x.params.len(&cx) != y.params.len(&cx) || !x.places.same(&cx, y.places) || x.is_unsafe != y.is_unsafe {
                    return false;
                }
                quantified(&cx, x.quantified, y.quantified, with_ret(&cx, x), with_ret(&cx, y), closed, counter)
            },
            _ => false,
        },
        Type::Array(_x, n) => match b {
            Type::Array(_y, m) => n == m && unify_all(&cx, T::children(&cx, a), T::children(&cx, b), closed, counter),
            _ => false,
        },
        _ => unify_all(&cx, T::children(&cx, a), T::children(&cx, b), closed, counter),
    }
}

forall 'k.
fn with_ret(&cx: Cx!['k], f: FnType['k]) -> Seq[Type['k], 'k] {
    let out = f.params.copy(&cx);
    out.push(&cx, f.ret.get(&cx));
    out
}

// Solves the variable `a` with `b`, which is not `a` itself. Of two variables, the less specific
// is bound to the more specific one.
forall 'k.
fn solve(&cx: Cx!['k], a: Meta['k], b: Type['k]) -> bool {
    match b {
        Type::Meta(other) => {
            var x = a;
            var y = other;
            if !is_type_kind(x.kind(&cx)) && !is_type_kind(y.kind(&cx)) && meta_kind_index(x.kind(&cx)) != meta_kind_index(y.kind(&cx)) {
                return false;
            }
            if !is_type_kind(x.kind(&cx)) {
                let t = x;
                x = y;
                y = t;
            }
            x.solve(&cx, Type::Meta.(y));
            true
        },
        _ => {
            if !fits_kind(&cx, a.kind(&cx), b) || occurs(&cx, a, b) {
                return false;
            }
            a.solve(&cx, b);
            true
        },
    }
}

// Match rigid query types by solving only fresh instance parameters.
//
// Surface inference passes the input prefix; its output-only variables remain unsolved. Only
// binder-free occurrences contribute extracted parameters. KURS passes the full head and requires
// every parameter to be extractable. Failure discards all tentative bindings.
forall 'k.
fn match_head(&cx: Cx!['k], params: Seq[Param['k], 'k], head: Seq[Type['k], 'k], query: Seq[Type['k], 'k], require_extractable: bool, counter: Fresh['k]) -> Option[Map[Text['k], Type['k], 'k]] {
    let reachable: Set[Text['k], 'k] = Set::new(&cx);
    var i = 0usize;
    while i < head.len(&cx) {
        T::add_all(&cx, reachable, extractable_names(&cx, head.get(&cx, i)));
        i = i + 1usize;
    }
    if head.len(&cx) != query.len(&cx) {
        return Option::None;
    }
    var j = 0usize;
    while j < query.len(&cx) {
        if !ground(&cx, query.get(&cx, j)) {
            return Option::None;
        }
        j = j + 1usize;
    }
    if require_extractable {
        var k = 0usize;
        while k < params.len(&cx) {
            if !reachable.has(&cx, params.get(&cx, k).name) {
                return Option::None;
            }
            k = k + 1usize;
        }
    }
    let sub = instantiate(&cx, params);
    var m = 0usize;
    while m < head.len(&cx) {
        if !unify(&cx, subst(&cx, head.get(&cx, m), sub, counter), query.get(&cx, m), true, counter) {
            return Option::None;
        }
        m = m + 1usize;
    }
    let out: Map[Text['k], Type['k], 'k] = Map::new(&cx);
    let names = sub.keys(&cx);
    var n = 0usize;
    while n < names.len(&cx) {
        let t = sub.at(&cx, names.get(&cx, n));
        if reachable.has(&cx, names.get(&cx, n)) && ground(&cx, t) {
            out.set(&cx, names.get(&cx, n), zonk(&cx, t));
        }
        n = n + 1usize;
    }
    Option::Some.(out)
}
