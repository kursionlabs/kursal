// Pure scalar-literal contract shared by source lowering and core assertions.

use package::support::base::{Cx, Out, Text, fail, text};
use package::kurs::core::Type;
use package::kurs::core as C;
use std::float::parse_f64;
use std::option::Option;
use std::slice::Slice;

fn is_digit(b: u8) -> bool {
    b >= b'0' && b <= b'9'
}

// The end of the digits of `t` starting at `i`.
forall 'k.
fn digits_end(&cx: Cx!['k], t: Text['k], i: usize) -> usize {
    var j = i;
    while j < t.len() && is_digit(t.byte(&cx, j)) {
        j = j + 1usize;
    }
    j
}

// `t` matches `[+-]?(?:[0-9]+(?:\.[0-9]*)?|\.[0-9]+)(?:[eE][+-]?[0-9]+)?` entirely.
forall 'k.
fn float_syntax(&cx: Cx!['k], t: Text['k]) -> bool {
    var i = 0usize;
    if t.byte(&cx, i) == b'+' || t.byte(&cx, i) == b'-' {
        i = i + 1usize;
    }
    let whole = digits_end(&cx, t, i);
    if whole > i {
        i = whole;
        if i < t.len() && t.byte(&cx, i) == b'.' {
            i = digits_end(&cx, t, i + 1usize);
        }
    } else if i < t.len() && t.byte(&cx, i) == b'.' && digits_end(&cx, t, i + 1usize) > i + 1usize {
        i = digits_end(&cx, t, i + 1usize);
    } else {
        return false;
    }
    if i < t.len() && (t.byte(&cx, i) == b'e' || t.byte(&cx, i) == b'E') {
        var j = i + 1usize;
        if j < t.len() && (t.byte(&cx, j) == b'+' || t.byte(&cx, j) == b'-') {
            j = j + 1usize;
        }
        let end = digits_end(&cx, t, j);
        if end == j {
            return false;
        }
        i = end;
    }
    i == t.len()
}

// `t` matches `0|-?[1-9][0-9]*` entirely.
forall 'k.
fn integer_syntax(&cx: Cx!['k], t: Text['k]) -> bool {
    if t.is(&cx, "0") {
        return true;
    }
    let start = if t.byte(&cx, 0usize) == b'-' { 1usize } else { 0usize };
    start < t.len() && t.byte(&cx, start) != b'0' && digits_end(&cx, t, start) == t.len()
}

// The decimal digits of `n` are at most `bound`'s digits, as numbers: neither has leading zeros.
forall 'k.
fn at_most(&cx: Cx!['k], n: Text['k], bound: Slice[u8, 'static]) -> bool {
    let b = text(&cx, bound);
    n.len() < b.len() || (n.len() == b.len() && n.compare(&cx, b) <= 0)
}

// The largest magnitude of a non-negative and of a negative value of an integer type, in decimal.
// Integer literals are compared as digit strings, so a literal of any length is judged exactly.
forall 'k.
fn bounds(&cx: Cx!['k], name: Text['k]) -> (Slice[u8, 'static], Slice[u8, 'static]) {
    if name.is(&cx, "i8") {
        ("127", "128")
    } else if name.is(&cx, "i16") {
        ("32767", "32768")
    } else if name.is(&cx, "i32") {
        ("2147483647", "2147483648")
    } else if name.is(&cx, "i64") || name.is(&cx, "isize") {
        ("9223372036854775807", "9223372036854775808")
    } else if name.is(&cx, "u8") {
        ("255", "0")
    } else if name.is(&cx, "u16") {
        ("65535", "0")
    } else if name.is(&cx, "u32") {
        ("4294967295", "0")
    } else {
        ("18446744073709551615", "0")
    }
}

forall 'k.
fn valid_literal(&cx: Cx!['k], ty: Type['k], t: Text['k]) -> bool {
    let name = match ty {
        Type::Prim(name) => name,
        _ => fail(&cx, text(&cx, "internal error: a literal of a non-primitive type")),
    };
    if name.is(&cx, "bool") {
        return t.is(&cx, "true") || t.is(&cx, "false");
    }
    if C::is_float(&cx, name) {
        if !float_syntax(&cx, t) {
            return false;
        }
        let value = match parse_f64(&cx.tag, t.bytes) {
            Option::Some(v) => v,
            Option::None => fail(&cx, text(&cx, "internal error: a float literal strtod does not read")),
        };
        if ((value.to_bits() >> 52u64) & 2047u64) == 2047u64 {
            return false;
        }
        if name.is(&cx, "f32") {
            // Python packs the double into four bytes, failing when it rounds past the largest
            // f32; the conversion here rounds the same way, to an infinity.
            return (value.to_f32().to_bits() & 2139095040u32) != 2139095040u32;
        }
        return true;
    }
    if !C::is_integer(&cx, name) || !integer_syntax(&cx, t) {
        return false;
    }
    let (positive, negative) = bounds(&cx, name);
    if t.byte(&cx, 0usize) == b'-' {
        at_most(&cx, t.from(1usize), negative)
    } else {
        at_most(&cx, t, positive)
    }
}
