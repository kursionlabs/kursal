// Type operations shared by the checker and the backend: substitution, equality, multiplicity,
// exposure and logical shape.

use package::support::base::fail;
use std::hash::{HashState, key_eq};
use std::cmp::Order;
use std::collections::arena_vec::ArenaVec;
use std::collections::arena_map::{ArenaMap, ArenaSet};
use std::mem::Ref;
use std::raw::Span;
use std::slice::Slice;
use std::slice::hash_bytes;
use std::arena::{Domain!, seed};
use std::buffer::Buffer!;
use package::kurs::core::{Exposure, ExposureMode, FnType, ForeachType, Kind, Member, ModuleId, Param, Premise, Program, Type, TypeDecl};
use package::kurs::core as C;
use package::kurs::sexpr::located;
use package::syntax::ast::{Pos, no_pos};
use std::option::Option;

// The target's pointer width in bytes, which the layout assumes: of a pointer, a function value,
// `usize` and `isize` (TY-SIZE-LIMIT). Every formed type's size is below 2^64.
const WORD: u64 = 8u64;

// The size of a primitive, which is its alignment too.
forall 'k.
fn prim_size(&cx: Domain!['k], name: Span['k]) -> u64 {
    if C::is_pointer_sized(&cx, name) {
        WORD
    } else if name.is(&cx, "bool") {
        1u64
    } else if name.is(&cx, "f32") {
        4u64
    } else if name.is(&cx, "f64") {
        8u64
    } else {
        (C::integer_bits(&cx, name) / 8u32) as u64
    }
}

// `offset` rounded up to a multiple of `align`, or none at 2^64 or more.
fn round_up(offset: u64, align: u64) -> Option[u64] {
    if offset > u64::MAX - (align - 1u64) {
        Option::None
    } else {
        Option::Some.((offset + align - 1u64) / align * align)
    }
}

// A C struct of the parts that are not zero-size, in order; none when a part has none, or the size is
// 2^64 or more.
forall 'k.
fn product(&cx: Domain!['k], parts: ArenaVec[Option[(u64, u64)], 'k]) -> Option[(u64, u64)] {
    var offset = 0u64;
    var align = 1u64;
    var i = 0usize;
    while i < parts.len(&cx) {
        match parts.at(&cx, i) {
            Option::Some(part) => {
                let (size, a) = part;
                if size > 0u64 {
                    match round_up(offset, a) {
                        Option::Some(at) => {
                            if at > u64::MAX - size {
                                return Option::None;
                            }
                            offset = at + size;
                        },
                        Option::None => return Option::None,
                    }
                    if a > align {
                        align = a;
                    }
                }
            },
            Option::None => return Option::None,
        }
        i = i + 1usize;
    }
    match round_up(offset, align) {
        Option::Some(size) => Option::Some.((size, align)),
        Option::None => Option::None,
    }
}

// A pointer source points to a product, an array or a leaf; a pointer to a sum is opaque.
const POINTER_TO_SUM: Slice[u8, 'static] = "a foreach source cannot be a pointer to a sum";

// Stops the compiler with a KursError's text: `line:col: message` when `pos` is a position, the
// message alone when it is none (line 0).
forall 'k.
fn kurs_error(&cx: Domain!['k], message: Span['k], pos: Pos) -> ! {
    if pos.line == 0u32 {
        fail(&cx, message)
    } else {
        fail(&cx, located(&cx, message, pos))
    }
}

// `kurs_error`, naming `file` unless it is empty.
forall 'k.
fn kurs_error_in(&cx: Domain!['k], message: Span['k], file: Span['k], pos: Pos) -> ! {
    if file.is_empty() {
        kurs_error(&cx, message, pos)
    } else if pos.line == 0u32 {
        fail(&cx, Buffer!::new().push_bytes(&cx, file).push_static(": ").push_bytes(&cx, message).save(&cx))
    } else {
        fail(&cx, Buffer!::new().push_bytes(&cx, file).push_static(":").push_bytes(&cx, located(&cx, message, pos)).save(&cx))
    }
}

// The file of the `k`th of some headers, named by `files` when it is not empty; else nothing.
forall 'k.
fn file_of(&cx: Domain!['k], files: ArenaVec[Span['k], 'k], k: usize) -> Span['k] {
    if files.is_empty(&cx) { Span::from_static(&cx, "") } else { files.at(&cx, k) }
}

// --------------------------------------------------------------- fresh names --

// The counter that numbers fresh names. The compiler makes one and passes it to everything that
// may rename a binder, so names are numbered in the order they are made.
forall 'k.
exposed struct Fresh {
    next: Ref[u64, 'k],
}

forall 'k.
impl Fresh['k] {
    fn new(&cx: Domain!['k]) -> Fresh['k] {
        Fresh.{ next: Ref::new(&cx, 0u64) }
    }
}

// `counter` carried on into the arena of `to`: names made there are numbered on from where it
// stopped.
forall 'a, 'b.
fn carry_fresh(&from: Domain!['a], &to: Domain!['b], counter: Fresh['a]) -> Fresh['b] {
    Fresh.{ next: Ref::new(&to, counter.next.copy(&from)) }
}

// `label` without any `#` suffix, numbered anew: `a#3`.
forall 'k.
fn fresh(&cx: Domain!['k], label: Span['k], counter: Fresh['k]) -> Span['k] {
    let n = counter.next.copy(&cx);
    counter.next.set(&cx, n + 1u64);
    let stem = match label.find(&cx, Span::from_static(&cx, "#"), 0usize) {
        Option::Some(at) => label.slice(0usize, at),
        Option::None => label,
    };
    Buffer!::new().push_bytes(&cx, stem).push_static("#").push_u64(n).save(&cx)
}

// ------------------------------------------------------------- name sets --

forall 'k.
fn with_names(&cx: Domain!['k], bound: ArenaSet[Span['k], 'k], names: ArenaVec[Span['k], 'k]) -> ArenaSet[Span['k], 'k] {
    let out = bound.clone(&cx);
    var i = 0usize;
    while i < names.len(&cx) {
        out.insert(&cx, names.at(&cx, i));
        i = i + 1usize;
    }
    out
}

// The two sets share a name.
forall 'k.
fn overlap(&cx: Domain!['k], a: ArenaSet[Span['k], 'k], b: ArenaSet[Span['k], 'k]) -> bool {
    let items = a.keys(&cx);
    var found = false;
    var i = 0usize;
    while !found && i < items.len(&cx) {
        found = b.contains(&cx, items.at(&cx, i));
        i = i + 1usize;
    }
    found
}


// `t` with every non-overlapping `old` replaced by `new`, left to right.
forall 'k.
fn replace_all(&cx: Domain!['k], t: Span['k], old: Span['k], new: Span['k]) -> Span['k] {
    var out = Buffer!::new();
    var i = 0usize;
    while i < t.len() {
        if i + old.len() <= t.len() && t.slice(i, i + old.len()).eq(&cx, old) {
            out = out.push_bytes(&cx, new);
            i = i + old.len();
        } else {
            out = out.push_byte(t.byte_or_zero(&cx, i));
            i = i + 1usize;
        }
    }
    out.save(&cx)
}

forall 'k.
fn kind_name(&cx: Domain!['k], k: Kind) -> Span['k] {
    match k {
        Kind::Brand => Span::from_static(&cx, "brand"),
        Kind::Copy => Span::from_static(&cx, "copy"),
        Kind::Any => Span::from_static(&cx, "any"),
    }
}

// Which constructor a type is: equal for two types exactly when Python's `type(a) is type(b)`.
forall 'k.
fn type_tag(t: Type['k]) -> u32 {
    match t {
        Type::Prim(_x) => 0u32,
        Type::Never => 1u32,
        Type::Named(_x, _y) => 2u32,
        Type::Struct(_x) => 3u32,
        Type::Enum(_x) => 4u32,
        Type::Tuple(_x) => 5u32,
        Type::Array(_x, _y) => 6u32,
        Type::Ptr(_x) => 7u32,
        Type::Skolem(_x) => 8u32,
        Type::Brand(_x) => 9u32,
        Type::Exists(_x, _y) => 10u32,
        Type::Foreach(_x) => 11u32,
        Type::Fn(_x) => 12u32,
        Type::Meta(_x) => 14u32,
        Type::NonNull(_x) => 15u32,
    }
}

// ------------------------------------------------------------- structure --

// Rebuild one type layer, applying `transform` to its type children (including premises).
//
// Binders, labels, lengths and calling conventions are preserved. The caller controls recursion
// and scope; this helper does not substitute bound names.
forall Env, 'k where Copy[Env].
fn map_children(&cx: Domain!['k], ty: Type['k], transform: closure[Env](&_: Domain!['k], Type['k]) -> Type['k]) -> Type['k] {
    match ty {
        Type::Named(name, args) => {
            if args.is_empty(&cx) {
                ty
            } else {
                let out: ArenaVec[Type['k], 'k] = ArenaVec::new(&cx);
                var i = 0usize;
                while i < args.len(&cx) {
                    out.push(&cx, transform(&cx, args.at(&cx, i)));
                    i = i + 1usize;
                }
                Type::Named.(name, out)
            }
        },
        Type::Brand(brand) => Type::Brand.(Ref::new(&cx, transform(&cx, brand.copy(&cx)))),
        Type::Ptr(inner) => Type::Ptr.(Ref::new(&cx, transform(&cx, inner.copy(&cx)))),
        Type::NonNull(inner) => Type::NonNull.(Ref::new(&cx, transform(&cx, inner.copy(&cx)))),
        Type::Array(elem, length) => Type::Array.(Ref::new(&cx, transform(&cx, elem.copy(&cx))), length),
        Type::Tuple(elems) => {
            let out: ArenaVec[Type['k], 'k] = ArenaVec::new(&cx);
            var i = 0usize;
            while i < elems.len(&cx) {
                out.push(&cx, transform(&cx, elems.at(&cx, i)));
                i = i + 1usize;
            }
            Type::Tuple.(out)
        },
        Type::Struct(fields) => {
            let out: ArenaVec[Member['k], 'k] = ArenaVec::new(&cx);
            var i = 0usize;
            while i < fields.len(&cx) {
                out.push(&cx, Member.{ name: fields.at(&cx, i).name, type: transform(&cx, fields.at(&cx, i).type) });
                i = i + 1usize;
            }
            Type::Struct.(out)
        },
        Type::Enum(variants) => {
            let out: ArenaVec[Member['k], 'k] = ArenaVec::new(&cx);
            var i = 0usize;
            while i < variants.len(&cx) {
                out.push(&cx, Member.{ name: variants.at(&cx, i).name, type: transform(&cx, variants.at(&cx, i).type) });
                i = i + 1usize;
            }
            Type::Enum.(out)
        },
        Type::Exists(binders, body) => Type::Exists.(binders, Ref::new(&cx, transform(&cx, body.copy(&cx)))),
        Type::Foreach(f) => {
            let source = transform(&cx, f.source.copy(&cx));
            let body = transform(&cx, f.body.copy(&cx));
            Type::Foreach.(ForeachType.{ binder: f.binder, indirect: f.indirect, source: Ref::new(&cx, source), body: Ref::new(&cx, body) })
        },
        Type::Fn(f) => {
            let params: ArenaVec[Type['k], 'k] = ArenaVec::new(&cx);
            var i = 0usize;
            while i < f.params.len(&cx) {
                params.push(&cx, transform(&cx, f.params.at(&cx, i)));
                i = i + 1usize;
            }
            let ret = transform(&cx, f.ret.copy(&cx));
            Type::Fn.(FnType.{ params, ret: Ref::new(&cx, ret), is_unsafe: f.is_unsafe, places: f.places })
        },
        _ => ty,
    }
}

// Simultaneous, capture-avoiding substitution.
//
// `sub` maps type-variable names (written `Named(name)`) and brand labels (written
// `Skolem(label)`) to types; a brand maps to a `Skolem`.
forall 'k.
fn subst(&cx: Domain!['k], ty: Type['k], sub: ArenaMap[Span['k], Type['k], 'k], counter: Fresh['k]) -> Type['k] {
    if sub.is_empty(&cx) {
        return ty;
    }
    match ty {
        Type::Named(name, args) => {
            if args.is_empty(&cx) && sub.contains(&cx, name) {
                sub.at(&cx, name)
            } else {
                map_children(&cx, ty, |&cx, child: Type['k]| subst(&cx, child, sub, counter))
            }
        },
        Type::Skolem(label) => sub.get_or(&cx, label, ty),
        Type::Exists(binders, body) => {
            let (names, inner) = rebind(&cx, binders, sub, true, counter);
            Type::Exists.(names, Ref::new(&cx, subst(&cx, body.copy(&cx), inner, counter)))
        },
        Type::Foreach(f) => {
            let source = subst(&cx, f.source.copy(&cx), sub, counter);
            let (binders, inner) = rebind(&cx, ArenaVec::one(&cx, f.binder), sub, false, counter);
            Type::Foreach.(ForeachType.{ binder: binders.at(&cx, 0usize), indirect: f.indirect, source: Ref::new(&cx, source),
                body: Ref::new(&cx, subst(&cx, f.body.copy(&cx), inner, counter)) })
        },
        _ => map_children(&cx, ty, |&cx, child: Type['k]| subst(&cx, child, sub, counter)),
    }
}

// The mapper's input where the operand is the source: the binder, or a pointer to it.
forall 'k.
fn foreach_item(&cx: Domain!['k], ty: ForeachType['k]) -> Type['k] {
    let binder = C::named(ty.binder, ArenaVec::new(&cx));
    if ty.indirect { C::ptr(&cx, binder) } else { binder }
}

// The operand of a traversal, when it is mapped (the map form): a value of a foreach type, whose
// components are the mapper's inputs. None where the operand is the source, which is never a foreach.
forall 'k.
fn mapped_operand(operand: Type['k]) -> Option[ForeachType['k]] {
    match operand {
        Type::Foreach(f) => Option::Some.(f),
        _ => Option::None,
    }
}

// The type of a mapped operand's component whose row binds the binder to `binding`.
forall 'k.
fn mapped_component(&cx: Domain!['k], operand: ForeachType['k], binding: Type['k], counter: Fresh['k]) -> Type['k] {
    let sub: ArenaMap[Span['k], Type['k], 'k] = ArenaMap::new(&cx);
    sub.insert(&cx, operand.binder, binding);
    subst(&cx, operand.body.copy(&cx), sub, counter)
}

// Drop `binders` from `sub`, renaming any a replacement would capture.
forall 'k.
fn rebind(&cx: Domain!['k], binders: ArenaVec[Span['k], 'k], sub: ArenaMap[Span['k], Type['k], 'k], brand: bool, counter: Fresh['k]) -> (ArenaVec[Span['k], 'k], ArenaMap[Span['k], Type['k], 'k]) {
    let inner: ArenaMap[Span['k], Type['k], 'k] = ArenaMap::new(&cx);
    let keys = sub.keys(&cx);
    var i = 0usize;
    while i < keys.len(&cx) {
        if !binders.contains(&cx, keys.at(&cx, i)) {
            inner.insert(&cx, keys.at(&cx, i), sub.at(&cx, keys.at(&cx, i)));
        }
        i = i + 1usize;
    }
    let captured: ArenaSet[Span['k], 'k] = ArenaSet::new(&cx);
    let values = inner.values(&cx);
    var j = 0usize;
    while j < values.len(&cx) {
        captured.insert_all(&cx, free_names(&cx, values.at(&cx, j)).keys(&cx));
        j = j + 1usize;
    }
    let out: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
    var k = 0usize;
    while k < binders.len(&cx) {
        let b = binders.at(&cx, k);
        if captured.contains(&cx, b) {
            let new = fresh(&cx, b, counter);
            inner.insert(&cx, b, if brand { Type::Skolem.(new) } else { C::named(new, ArenaVec::new(&cx)) });
            out.push(&cx, new);
        } else {
            out.push(&cx, b);
        }
        k = k + 1usize;
    }
    (out, inner)
}

// Free type-variable names and brand labels of `ty` (over-approximating nominal names as
// variables, which only makes renaming more eager).
forall 'k.
fn free_names(&cx: Domain!['k], ty: Type['k]) -> ArenaSet[Span['k], 'k] {
    let out: ArenaSet[Span['k], 'k] = ArenaSet::new(&cx);
    free_names_in(&cx, ty, ArenaSet::new(&cx), Option::None, out);
    out
}

// Adds the names free in `ty` under `bound` to `out`, in the order they first occur; with `only`,
// just the ones in it.
forall 'k.
fn free_names_in(&cx: Domain!['k], ty: Type['k], bound: ArenaSet[Span['k], 'k], only: Option[ArenaSet[Span['k], 'k]], out: ArenaSet[Span['k], 'k]) {
    match ty {
        Type::Named(name, args) => {
            if args.is_empty(&cx) && !bound.contains(&cx, name) {
                add_name(&cx, name, only, out);
            }
            free_names_all(&cx, args, bound, only, out);
        },
        Type::Skolem(label) => {
            if !bound.contains(&cx, label) {
                add_name(&cx, label, only, out);
            }
        },
        Type::Exists(binders, body) => free_names_in(&cx, body.copy(&cx), with_names(&cx, bound, binders), only, out),
        Type::Foreach(f) => {
            free_names_in(&cx, f.source.copy(&cx), bound, only, out);
            free_names_in(&cx, f.body.copy(&cx), with_names(&cx, bound, ArenaVec::one(&cx, f.binder)), only, out);
        },
        Type::Fn(f) => {
            free_names_in(&cx, f.ret.copy(&cx), bound, only, out);
            free_names_all(&cx, f.params, bound, only, out);
        },
        Type::Ptr(inner) => free_names_in(&cx, inner.copy(&cx), bound, only, out),
        Type::NonNull(inner) => free_names_in(&cx, inner.copy(&cx), bound, only, out),
        Type::Brand(brand) => free_names_in(&cx, brand.copy(&cx), bound, only, out),
        Type::Array(elem, _length) => free_names_in(&cx, elem.copy(&cx), bound, only, out),
        Type::Tuple(elems) => free_names_all(&cx, elems, bound, only, out),
        Type::Struct(fields) => free_names_members(&cx, fields, bound, only, out),
        Type::Enum(variants) => free_names_members(&cx, variants, bound, only, out),
        _ => (),
    }
}

forall 'k.
fn add_name(&cx: Domain!['k], name: Span['k], only: Option[ArenaSet[Span['k], 'k]], out: ArenaSet[Span['k], 'k]) {
    let wanted = match only {
        Option::Some(names) => names.contains(&cx, name),
        Option::None => true,
    };
    if wanted {
        out.insert(&cx, name);
    }
}

forall 'k.
fn free_names_all(&cx: Domain!['k], types: ArenaVec[Type['k], 'k], bound: ArenaSet[Span['k], 'k], only: Option[ArenaSet[Span['k], 'k]], out: ArenaSet[Span['k], 'k]) {
    var i = 0usize;
    while i < types.len(&cx) {
        free_names_in(&cx, types.at(&cx, i), bound, only, out);
        i = i + 1usize;
    }
}

forall 'k.
fn free_names_members(&cx: Domain!['k], members: ArenaVec[Member['k], 'k], bound: ArenaSet[Span['k], 'k], only: Option[ArenaSet[Span['k], 'k]], out: ArenaSet[Span['k], 'k]) {
    var i = 0usize;
    while i < members.len(&cx) {
        free_names_in(&cx, members.at(&cx, i).type, bound, only, out);
        i = i + 1usize;
    }
}

// Some brand label occurs in `ty`, free or bound. Unlike `free_brands`, this allocates nothing.
forall 'k.
fn mentions_brand(&cx: Domain!['k], ty: Type['k]) -> bool {
    match ty {
        Type::Skolem(_label) => true,
        Type::Named(_name, args) => any_mentions_brand(&cx, args),
        Type::Tuple(elems) => any_mentions_brand(&cx, elems),
        Type::Struct(fields) => members_mention_brand(&cx, fields),
        Type::Enum(variants) => members_mention_brand(&cx, variants),
        Type::Array(elem, _length) => mentions_brand(&cx, elem.copy(&cx)),
        Type::Ptr(inner) => mentions_brand(&cx, inner.copy(&cx)),
        Type::NonNull(inner) => mentions_brand(&cx, inner.copy(&cx)),
        Type::Brand(brand) => mentions_brand(&cx, brand.copy(&cx)),
        Type::Exists(_binders, body) => mentions_brand(&cx, body.copy(&cx)),
        Type::Foreach(f) => mentions_brand(&cx, f.source.copy(&cx)) || mentions_brand(&cx, f.body.copy(&cx)),
        Type::Fn(f) => any_mentions_brand(&cx, f.params) || mentions_brand(&cx, f.ret.copy(&cx)),
        _ => false,
    }
}

forall 'k.
fn any_mentions_brand(&cx: Domain!['k], types: ArenaVec[Type['k], 'k]) -> bool {
    var i = 0usize;
    while i < types.len(&cx) {
        if mentions_brand(&cx, types.at(&cx, i)) {
            return true;
        }
        i = i + 1usize;
    }
    false
}

forall 'k.
fn members_mention_brand(&cx: Domain!['k], members: ArenaVec[Member['k], 'k]) -> bool {
    var i = 0usize;
    while i < members.len(&cx) {
        if mentions_brand(&cx, members.at(&cx, i).type) {
            return true;
        }
        i = i + 1usize;
    }
    false
}

forall 'k.
fn free_brands(&cx: Domain!['k], ty: Type['k]) -> ArenaSet[Span['k], 'k] {
    let out: ArenaSet[Span['k], 'k] = ArenaSet::new(&cx);
    if !mentions_brand(&cx, ty) {
        return out;
    }
    let found: ArenaSet[Span['k], 'k] = ArenaSet::new(&cx);
    skolems(&cx, ty, found);
    free_names_in(&cx, ty, ArenaSet::new(&cx), Option::Some.(found), out);
    out
}

// Adds every brand label in `part`, free or bound, to `found`.
forall 'k.
fn skolems(&cx: Domain!['k], part: Type['k], found: ArenaSet[Span['k], 'k]) {
    match part {
        Type::Skolem(label) => { found.insert(&cx, label); },
        Type::Named(_name, args) => skolems_all(&cx, args, found),
        Type::Tuple(elems) => skolems_all(&cx, elems, found),
        Type::Struct(fields) => skolems_members(&cx, fields, found),
        Type::Enum(variants) => skolems_members(&cx, variants, found),
        Type::Array(elem, _length) => skolems(&cx, elem.copy(&cx), found),
        Type::Ptr(inner) => skolems(&cx, inner.copy(&cx), found),
        Type::NonNull(inner) => skolems(&cx, inner.copy(&cx), found),
        Type::Brand(brand) => skolems(&cx, brand.copy(&cx), found),
        Type::Exists(_binders, body) => skolems(&cx, body.copy(&cx), found),
        Type::Foreach(f) => {
            skolems(&cx, f.source.copy(&cx), found);
            skolems(&cx, f.body.copy(&cx), found);
        },
        Type::Fn(f) => {
            skolems_all(&cx, f.params, found);
            skolems(&cx, f.ret.copy(&cx), found);
        },
        _ => (),
    }
}

forall 'k.
fn skolems_all(&cx: Domain!['k], types: ArenaVec[Type['k], 'k], found: ArenaSet[Span['k], 'k]) {
    var i = 0usize;
    while i < types.len(&cx) {
        skolems(&cx, types.at(&cx, i), found);
        i = i + 1usize;
    }
}

forall 'k.
fn skolems_members(&cx: Domain!['k], members: ArenaVec[Member['k], 'k], found: ArenaSet[Span['k], 'k]) {
    var i = 0usize;
    while i < members.len(&cx) {
        skolems(&cx, members.at(&cx, i).type, found);
        i = i + 1usize;
    }
}

forall 'k.
fn children(&cx: Domain!['k], ty: Type['k]) -> ArenaVec[Type['k], 'k] {
    match ty {
        Type::Ptr(inner) => ArenaVec::one(&cx, inner.copy(&cx)),
        Type::NonNull(inner) => ArenaVec::one(&cx, inner.copy(&cx)),
        Type::Brand(brand) => ArenaVec::one(&cx, brand.copy(&cx)),
        Type::Array(elem, _length) => ArenaVec::one(&cx, elem.copy(&cx)),
        Type::Tuple(elems) => elems,
        Type::Struct(fields) => member_types(&cx, fields),
        Type::Enum(variants) => member_types(&cx, variants),
        Type::Named(_name, args) => args,
        Type::Exists(_binders, body) => ArenaVec::one(&cx, body.copy(&cx)),
        Type::Foreach(f) => ArenaVec::two(&cx, f.source.copy(&cx), f.body.copy(&cx)),
        Type::Fn(f) => {
            let out = f.params.clone(&cx);
            out.push(&cx, f.ret.copy(&cx));
            out
        },
        _ => ArenaVec::new(&cx),
    }
}

forall 'k.
fn member_types(&cx: Domain!['k], members: ArenaVec[Member['k], 'k]) -> ArenaVec[Type['k], 'k] {
    let out: ArenaVec[Type['k], 'k] = ArenaVec::new(&cx);
    var i = 0usize;
    while i < members.len(&cx) {
        out.push(&cx, members.at(&cx, i).type);
        i = i + 1usize;
    }
    out
}

// Free names reachable by matching without crossing a type binder.
forall 'k.
fn extractable_names(&cx: Domain!['k], ty: Type['k]) -> ArenaSet[Span['k], 'k] {
    let out: ArenaSet[Span['k], 'k] = ArenaSet::new(&cx);
    extractable_in(&cx, ty, out);
    out
}

forall 'k.
fn extractable_in(&cx: Domain!['k], ty: Type['k], out: ArenaSet[Span['k], 'k]) {
    match ty {
        Type::Exists(_binders, _body) => (),
        Type::Foreach(f) => extractable_in(&cx, f.source.copy(&cx), out),
        Type::Fn(_f) => {
            let parts = children(&cx, ty);
            var i = 0usize;
            while i < parts.len(&cx) {
                extractable_in(&cx, parts.at(&cx, i), out);
                i = i + 1usize;
            }
        },
        Type::Named(name, args) => {
            if args.is_empty(&cx) {
                out.insert(&cx, name);
            } else {
                var i = 0usize;
                while i < args.len(&cx) {
                    extractable_in(&cx, args.at(&cx, i), out);
                    i = i + 1usize;
                }
            }
        },
        Type::Skolem(label) => { out.insert(&cx, label); },
        _ => {
            let parts = children(&cx, ty);
            var i = 0usize;
            while i < parts.len(&cx) {
                extractable_in(&cx, parts.at(&cx, i), out);
                i = i + 1usize;
            }
        },
    }
}

// `ty` and every type inside it, parents first.
forall 'k.
fn walk(&cx: Domain!['k], ty: Type['k]) -> ArenaVec[Type['k], 'k] {
    let out: ArenaVec[Type['k], 'k] = ArenaVec::new(&cx);
    walk_into(&cx, ty, out);
    out
}

forall 'k.
fn walk_into(&cx: Domain!['k], ty: Type['k], out: ArenaVec[Type['k], 'k]) {
    out.push(&cx, ty);
    let parts = children(&cx, ty);
    var i = 0usize;
    while i < parts.len(&cx) {
        walk_into(&cx, parts.at(&cx, i), out);
        i = i + 1usize;
    }
}

// ---------------------------------------------------------------- equality --

// The names bound on each side of an equality, each to a mark shared by the binder it pairs
// with. Each side has its own scope: a name on the left may also occur on the right. None until
// the first binder, so comparing types without binders allocates nothing.
forall 'k.
exposed struct Alpha {
    scopes: Option[Scopes['k]],
}

forall 'k.
exposed struct Scopes {
    left: ArenaMap[Span['k], u64, 'k],
    right: ArenaMap[Span['k], u64, 'k],
    marks: Ref[u64, 'k],
}

forall 'k.
fn alpha() -> Alpha['k] {
    Alpha.{ scopes: Option::None }
}

// Whether `x` is bound on the left or `y` on the right.
forall 'k.
fn binds(&cx: Domain!['k], env: Alpha['k], x: Span['k], y: Span['k]) -> bool {
    match env.scopes {
        Option::Some(s) => s.left.contains(&cx, x) || s.right.contains(&cx, y),
        Option::None => false,
    }
}

// `left.get(x, x) == right.get(y, y)`: two bound names with the same mark, or the same free name.
forall 'k.
fn same_name(&cx: Domain!['k], env: Alpha['k], x: Span['k], y: Span['k]) -> bool {
    let env = match env.scopes {
        Option::Some(s) => s,
        Option::None => return x.eq(&cx, y),
    };
    match env.left.get(&cx, x) {
        Option::Some(m) => match env.right.get(&cx, y) {
            Option::Some(n) => m == n,
            Option::None => false,
        },
        Option::None => match env.right.get(&cx, y) {
            Option::Some(_n) => false,
            Option::None => x.eq(&cx, y),
        },
    }
}

forall 'k.
fn bind(&cx: Domain!['k], env: Alpha['k], left: ArenaVec[Span['k], 'k], right: ArenaVec[Span['k], 'k]) -> Alpha['k] {
    let env = match env.scopes {
        Option::Some(s) => s,
        Option::None => Scopes.{ left: ArenaMap::new(&cx), right: ArenaMap::new(&cx), marks: Ref::new(&cx, 0u64) },
    };
    let a = env.left.clone(&cx);
    let b = env.right.clone(&cx);
    var i = 0usize;
    while i < left.len(&cx) && i < right.len(&cx) {
        let mark = env.marks.copy(&cx) + 1u64;
        env.marks.set(&cx, mark);
        a.insert(&cx, left.at(&cx, i), mark);
        b.insert(&cx, right.at(&cx, i), mark);
        i = i + 1usize;
    }
    Alpha.{ scopes: Option::Some.(Scopes.{ left: a, right: b, marks: env.marks }) }
}

// Nominal/structural equality modulo renaming of bound names.
forall 'k.
fn equal(&cx: Domain!['k], a: Type['k], b: Type['k]) -> bool {
    equal_in(&cx, a, b, alpha())
}

forall 'k.
fn equal_all(&cx: Domain!['k], xs: ArenaVec[Type['k], 'k], ys: ArenaVec[Type['k], 'k], env: Alpha['k]) -> bool {
    var ok = xs.len(&cx) == ys.len(&cx);
    var i = 0usize;
    while ok && i < xs.len(&cx) {
        ok = equal_in(&cx, xs.at(&cx, i), ys.at(&cx, i), env);
        i = i + 1usize;
    }
    ok
}

forall 'k.
fn equal_members(&cx: Domain!['k], xs: ArenaVec[Member['k], 'k], ys: ArenaVec[Member['k], 'k], env: Alpha['k]) -> bool {
    var ok = xs.len(&cx) == ys.len(&cx);
    var i = 0usize;
    while ok && i < xs.len(&cx) {
        ok = xs.at(&cx, i).name.eq(&cx, ys.at(&cx, i).name) && equal_in(&cx, xs.at(&cx, i).type, ys.at(&cx, i).type, env);
        i = i + 1usize;
    }
    ok
}

forall 'k.
fn equal_in(&cx: Domain!['k], a: Type['k], b: Type['k], env: Alpha['k]) -> bool {
    if type_tag(a) != type_tag(b) {
        return false;
    }
    match a {
        Type::Skolem(x) => match b {
            Type::Skolem(y) => same_name(&cx, env, x, y),
            _ => false,
        },
        Type::Named(x, xs) => match b {
            Type::Named(y, ys) => {
                if xs.is_empty(&cx) && ys.is_empty(&cx) && binds(&cx, env, x, y) {
                    same_name(&cx, env, x, y)
                } else {
                    x.eq(&cx, y) && equal_all(&cx, xs, ys, env)
                }
            },
            _ => false,
        },
        Type::Exists(xs, p) => match b {
            Type::Exists(ys, q) => xs.len(&cx) == ys.len(&cx) && equal_in(&cx, p.copy(&cx), q.copy(&cx), bind(&cx, env, xs, ys)),
            _ => false,
        },
        Type::Foreach(x) => match b {
            Type::Foreach(y) => x.indirect == y.indirect && equal_in(&cx, x.source.copy(&cx), y.source.copy(&cx), env)
                && equal_in(&cx, x.body.copy(&cx), y.body.copy(&cx), bind(&cx, env, ArenaVec::one(&cx, x.binder), ArenaVec::one(&cx, y.binder))),
            _ => false,
        },
        Type::Fn(x) => match b {
            Type::Fn(y) => {
                if x.is_unsafe != y.is_unsafe || !x.places.eq(&cx, y.places) || x.params.len(&cx) != y.params.len(&cx) {
                    return false;
                }
                equal_in(&cx, x.ret.copy(&cx), y.ret.copy(&cx), env) && equal_all(&cx, x.params, y.params, env)
            },
            _ => false,
        },
        Type::Struct(xs) => match b {
            Type::Struct(ys) => equal_members(&cx, xs, ys, env),
            _ => false,
        },
        Type::Enum(xs) => match b {
            Type::Enum(ys) => equal_members(&cx, xs, ys, env),
            _ => false,
        },
        Type::Array(x, n) => match b {
            Type::Array(y, m) => n == m && equal_in(&cx, x.copy(&cx), y.copy(&cx), env),
            _ => false,
        },
        Type::Tuple(xs) => match b {
            Type::Tuple(ys) => equal_all(&cx, xs, ys, env),
            _ => false,
        },
        Type::Ptr(x) => match b {
            Type::Ptr(y) => equal_in(&cx, x.copy(&cx), y.copy(&cx), env),
            _ => false,
        },
        Type::NonNull(x) => match b {
            Type::NonNull(y) => equal_in(&cx, x.copy(&cx), y.copy(&cx), env),
            _ => false,
        },
        Type::Brand(x) => match b {
            Type::Brand(y) => equal_in(&cx, x.copy(&cx), y.copy(&cx), env),
            _ => false,
        },
        _ => C::same(&cx, a, b),
    }
}

// A hash that `equal` types share, under the arena's seed: their structure, leaving out every name
// a binder may rename (a brand, a type without arguments, a binder).
forall 'k.
fn alpha_hashes(&cx: Domain!['k], ts: ArenaVec[Type['k], 'k]) -> u64 {
    alpha_types(&cx, HashState::new(seed(&cx)), ts).finish()
}

forall 'k.
fn alpha_hash(&cx: Domain!['k], t: Type['k], state: HashState) -> HashState {
    match t {
        Type::Prim(x) => hash_bytes(&cx, x, state.write_u64(1u64)),
        Type::Named(x, xs) => if xs.is_empty(&cx) { state.write_u64(3u64) } else { alpha_types(&cx, hash_bytes(&cx, x, state.write_u64(3u64)), xs) },
        Type::Struct(ms) => alpha_members(&cx, state.write_u64(4u64), ms),
        Type::Enum(ms) => alpha_members(&cx, state.write_u64(5u64), ms),
        Type::Tuple(xs) => alpha_types(&cx, state.write_u64(6u64), xs),
        Type::Array(x, n) => alpha_hash(&cx, x.copy(&cx), state.write_u64(7u64)).write_u64(n),
        Type::Ptr(x) => alpha_hash(&cx, x.copy(&cx), state.write_u64(8u64)),
        Type::Brand(x) => alpha_hash(&cx, x.copy(&cx), state.write_u64(10u64)),
        Type::Exists(xs, x) => alpha_hash(&cx, x.copy(&cx), state.write_u64(11u64).write_u64(xs.len(&cx) as u64)),
        Type::Foreach(f) => alpha_hash(&cx, f.body.copy(&cx), alpha_hash(&cx, f.source.copy(&cx), state.write_u64(12u64))),
        Type::Fn(f) => alpha_hash(&cx, f.ret.copy(&cx), alpha_types(&cx, state.write_u64(13u64), f.params)),
        Type::NonNull(x) => alpha_hash(&cx, x.copy(&cx), state.write_u64(16u64)),
        _ => state.write_u64(type_tag(t) as u64),
    }
}

forall 'k.
fn alpha_types(&cx: Domain!['k], state: HashState, ts: ArenaVec[Type['k], 'k]) -> HashState {
    var state = state.write_u64(ts.len(&cx) as u64);
    var i = 0usize;
    while i < ts.len(&cx) {
        state = alpha_hash(&cx, ts.at(&cx, i), state);
        i = i + 1usize;
    }
    state
}

forall 'k.
fn alpha_members(&cx: Domain!['k], state: HashState, ms: ArenaVec[Member['k], 'k]) -> HashState {
    var state = state.write_u64(ms.len(&cx) as u64);
    var i = 0usize;
    while i < ms.len(&cx) {
        state = alpha_hash(&cx, ms.at(&cx, i).type, hash_bytes(&cx, ms.at(&cx, i).name, state));
        i = i + 1usize;
    }
    state
}

// The parameters have the same kinds, in order.
forall 'k.
fn same_kinds(&cx: Domain!['k], a: ArenaVec[Param['k], 'k], b: ArenaVec[Param['k], 'k]) -> bool {
    var ok = a.len(&cx) == b.len(&cx);
    var i = 0usize;
    while ok && i < a.len(&cx) {
        ok = C::same_kind(a.at(&cx, i).kind, b.at(&cx, i).kind);
        i = i + 1usize;
    }
    ok
}

// A value of type `a` may go where `b` is expected.
forall 'k.
fn fits(&cx: Domain!['k], a: Type['k], b: Type['k]) -> bool {
    match a {
        Type::Never => true,
        _ => equal(&cx, a, b),
    }
}

// --------------------------------------------------------- foreach rows --

// One component of a foreach source: its label and item type.
forall 'k.
exposed struct Row {
    label: Span['k],
    item: Type['k],
}

// A foreach source's outer skeleton (a structural type, or none for a leaf) and its rows.
forall 'k.
exposed struct Rows {
    skeleton: Option[Type['k]],
    rows: ArenaVec[Row['k], 'k],
}

// ------------------------------------------------------------------ Types --

// Declaration-aware queries over one program.
forall 'k.
exposed struct Types {
    program: Program['k],
    // (type, its parameters' kinds sorted by name) -> whether it is Copy
    copy_cache: ArenaMap[(Type['k], ArenaVec[(Span['k], u32), 'k]), bool, 'k],
    // a nominal type -> its unfolding, when making it renamed no binder
    unfolded: ArenaMap[Type['k], Type['k], 'k],
    // the foreach types whose Copy query is active
    expanding: ArenaVec[Type['k], 'k],
    // a closed type -> its size and alignment, none at 2^64 bytes or more
    layouts: ArenaMap[Type['k], Option[(u64, u64)], 'k],
    counter: Fresh['k],
}

forall 'k.
fn name_order(&cx: Domain!['k], a: (Span['k], u32), b: (Span['k], u32)) -> Order {
    let (x, _k) = a;
    let (y, _l) = b;
    x.cmp(&cx, y)
}

forall 'k.
impl Types['k] {
    fn new(&cx: Domain!['k], program: Program['k], counter: Fresh['k]) -> Types['k] {
        Types.{ program, copy_cache: ArenaMap::new(&cx), unfolded: ArenaMap::new(&cx), expanding: ArenaVec::new(&cx), layouts: ArenaMap::new(&cx), counter }
    }

    fn decl(self, &cx: Domain!['k], name: Span['k]) -> TypeDecl['k] {
        match self.program.types.get(&cx, name) {
            Option::Some(decl) => decl,
            Option::None => kurs_error(&cx, Buffer!::new().push_static("unknown type ").push_bytes(&cx, name).save(&cx), no_pos()),
        }
    }

    // `ty` has no bytes of its own: unit-like products, empty arrays, brand witnesses, Never. A
    // type parameter is answered when it is instantiated.
    fn zero_size(self, &cx: Domain!['k], ty: Type['k]) -> bool {
        self.zero_size_at(&cx, ty, false)
    }

    // `zero_size`, a type parameter taken to be zero-size when `parameters` says so, as it may be, and
    // so a foreach type that mentions one: `ty` then has bytes only through a part that has them
    // whatever the parameters are.
    fn zero_size_at(self, &cx: Domain!['k], ty: Type['k], parameters: bool) -> bool {
        let unit = match ty {
            Type::Brand(_b) => {
                return true;
            },
            Type::Never => {
                return true;
            },
            Type::Named(name, args) => {
                if args.is_empty(&cx) && !self.program.types.contains(&cx, name) {
                    return parameters;
                }
            },
            Type::Foreach(_f) => {
                if parameters && !self.closed(&cx, ty) {
                    return true;
                }
            },
            _ => (),
        };
        match self.shape(&cx, ty, Option::None) {
            Type::Tuple(elems) => {
                var all = true;
                var i = 0usize;
                while all && i < elems.len(&cx) {
                    all = self.zero_size_at(&cx, elems.at(&cx, i), parameters);
                    i = i + 1usize;
                }
                all
            },
            Type::Struct(fields) => {
                var all = true;
                var i = 0usize;
                while all && i < fields.len(&cx) {
                    all = self.zero_size_at(&cx, fields.at(&cx, i).type, parameters);
                    i = i + 1usize;
                }
                all
            },
            Type::Array(elem, length) => length == 0u64 || self.zero_size_at(&cx, elem.copy(&cx), parameters),
            Type::Exists(_binders, body) => self.zero_size_at(&cx, body.copy(&cx), parameters),
            _ => false,
        }
    }

    // `ty` mentions no type parameter or binder: every name it has is a declaration's. Brands do not
    // change a layout.
    // The pointer sources that mention a type parameter of the foreach types in `ty`, declarations
    // that mention one unfolded, each once (TY-FOREACH-EXPOSED-PTR): `sizeof` of `ty` needs `Exposed`
    // of each, as a traversal does, so none points to a sum at an instantiation.
    fn pointer_sources(self, &cx: Domain!['k], ty: Type['k]) -> ArenaVec[Type['k], 'k] {
        let out: ArenaVec[Type['k], 'k] = ArenaVec::new(&cx);
        self.pointer_sources_in(&cx, ty, out, ArenaVec::new(&cx));
        out
    }

    fn pointer_sources_in(self, &cx: Domain!['k], ty: Type['k], out: ArenaVec[Type['k], 'k], seen: ArenaVec[Type['k], 'k]) {
        let parts = walk(&cx, ty);
        var i = 0usize;
        while i < parts.len(&cx) {
            let part = parts.at(&cx, i);
            match part {
                Type::Foreach(f) => {
                    let source = f.source.copy(&cx);
                    match source {
                        Type::Ptr(_inner) => {
                            if !self.closed(&cx, source) {
                                out.push(&cx, source);
                            }
                        },
                        _ => (),
                    };
                },
                Type::Named(name, _args) => {
                    if self.program.types.contains(&cx, name) && !self.closed(&cx, part)
                        && !seen.any(&cx, |&cx, s: Type['k]| equal(&cx, s, part)) {
                        seen.push(&cx, part);
                        self.pointer_sources_in(&cx, self.unfold(&cx, part, Option::None), out, seen);
                    }
                },
                _ => (),
            };
            i = i + 1usize;
        }
    }

    fn closed(self, &cx: Domain!['k], ty: Type['k]) -> bool {
        let brands = free_brands(&cx, ty);
        let names = free_names(&cx, ty).keys(&cx);
        var n = 0usize;
        while n < names.len(&cx) {
            let name = names.at(&cx, n);
            if !brands.contains(&cx, name) && !self.program.types.contains(&cx, name) {
                return false;
            }
            n = n + 1usize;
        }
        true
    }

    // The size and alignment of a closed type's value as the backend lays it out at the target's
    // pointer width: a primitive its width, a pointer or a function value a word, a zero-size part
    // erased, a product a C struct of the rest, and an enum a `uint32_t` tag and a union of its
    // payloads, or its payload in the niche layout. None when the size is 2^64 or more: no formed type
    // has one (TY-SIZE-LIMIT).
    fn layout(self, &cx: Domain!['k], ty: Type['k]) -> Option[(u64, u64)] {
        match self.layouts.get(&cx, ty) {
            Option::Some(known) => return known,
            Option::None => (),
        }
        let found = self.lay_out(&cx, ty);
        self.layouts.insert(&cx, ty, found);
        found
    }

    fn lay_out(self, &cx: Domain!['k], ty: Type['k]) -> Option[(u64, u64)] {
        match ty {
            Type::Prim(name) => {
                let size = prim_size(&cx, name);
                Option::Some.((size, size))
            },
            Type::Ptr(_inner) => Option::Some.((WORD, WORD)),
            Type::NonNull(_inner) => Option::Some.((WORD, WORD)),
            Type::Fn(_f) => Option::Some.((WORD, WORD)),
            Type::Named(_name, _args) => self.layout(&cx, self.shape(&cx, ty, Option::None)),
            Type::Foreach(_f) => self.layout(&cx, self.shape(&cx, ty, Option::None)),
            Type::Exists(_binders, body) => self.layout(&cx, body.copy(&cx)),
            Type::Array(elem, length) => {
                if length == 0u64 {
                    return Option::Some.((0u64, 1u64));
                }
                match self.layout(&cx, elem.copy(&cx)) {
                    Option::Some(part) => {
                        let (size, align) = part;
                        if size != 0u64 && length > u64::MAX / size {
                            Option::None
                        } else {
                            Option::Some.((size * length, align))
                        }
                    },
                    Option::None => Option::None,
                }
            },
            Type::Tuple(elems) => {
                let parts: ArenaVec[Option[(u64, u64)], 'k] = ArenaVec::new(&cx);
                var i = 0usize;
                while i < elems.len(&cx) {
                    parts.push(&cx, self.layout(&cx, elems.at(&cx, i)));
                    i = i + 1usize;
                }
                product(&cx, parts)
            },
            Type::Struct(fields) => {
                let parts: ArenaVec[Option[(u64, u64)], 'k] = ArenaVec::new(&cx);
                var i = 0usize;
                while i < fields.len(&cx) {
                    parts.push(&cx, self.layout(&cx, fields.at(&cx, i).type));
                    i = i + 1usize;
                }
                product(&cx, parts)
            },
            Type::Enum(variants) => {
                match self.niche_variant(&cx, variants) {
                    Option::Some(held) => return self.layout(&cx, variants.at(&cx, held).type),
                    Option::None => (),
                }
                // A union of the payloads that are not zero-size: as big as the biggest, rounded up to
                // the strictest alignment.
                var size = 0u64;
                var align = 1u64;
                var i = 0usize;
                while i < variants.len(&cx) {
                    match self.layout(&cx, variants.at(&cx, i).type) {
                        Option::Some(part) => {
                            let (s, a) = part;
                            if s > 0u64 {
                                if s > size {
                                    size = s;
                                }
                                if a > align {
                                    align = a;
                                }
                            }
                        },
                        Option::None => return Option::None,
                    }
                    i = i + 1usize;
                }
                match round_up(size, align) {
                    Option::Some(union) => product(&cx, ArenaVec::two(&cx, Option::Some.((4u64, 4u64)), Option::Some.((union, align)))),
                    Option::None => Option::None,
                }
            },
            // a brand witness or Never
            _ => Option::Some.((0u64, 1u64)),
        }
    }

    // Where a value of `ty` has bytes that hold no value of it: the path (field names, tuple indices,
    // `0` for an array's first element) to its first `NonNull` in layout order, whose all-zero value
    // is none of its values. A struct, tuple or non-empty array has the niche of its first component
    // that has one; a pointer, a primitive, a zero-size type and an enum have none. A type parameter
    // is answered when it is instantiated.
    fn niche(self, &cx: Domain!['k], ty: Type['k]) -> Option[ArenaVec[Span['k], 'k]] {
        let unit = match ty {
            Type::NonNull(_inner) => {
                return Option::Some.(ArenaVec::new(&cx));
            },
            Type::Named(name, args) => {
                if args.is_empty(&cx) && !self.program.types.contains(&cx, name) {
                    return Option::None;
                }
            },
            _ => (),
        };
        let parts: ArenaVec[Member['k], 'k] = ArenaVec::new(&cx);
        let unit = match self.shape(&cx, ty, Option::None) {
            Type::NonNull(_inner) => {
                return Option::Some.(ArenaVec::new(&cx));
            },
            Type::Struct(fields) => {
                parts.append(&cx, fields);
            },
            Type::Tuple(elems) => {
                var i = 0usize;
                while i < elems.len(&cx) {
                    parts.push(&cx, Member.{ name: Buffer!::new().push_u64(i as u64).save(&cx), type: elems.at(&cx, i) });
                    i = i + 1usize;
                }
            },
            Type::Array(elem, length) => {
                if length > 0u64 {
                    parts.push(&cx, Member.{ name: Span::from_static(&cx, "0"), type: elem.copy(&cx) });
                }
            },
            Type::Exists(_binders, body) => {
                return self.niche(&cx, body.copy(&cx));
            },
            _ => (),
        };
        var i = 0usize;
        while i < parts.len(&cx) {
            let unit = match self.niche(&cx, parts.at(&cx, i).type) {
                Option::Some(path) => {
                    let out = ArenaVec::one(&cx, parts.at(&cx, i).name);
                    out.append(&cx, path);
                    return Option::Some.(out);
                },
                Option::None => (),
            };
            i = i + 1usize;
        }
        Option::None
    }

    // The variant an enum of these variants is represented as, when it has the niche layout: one
    // variant's payload has a niche, and the one other variant is zero-size, written as the niche's
    // invalid value. A `NonNull` offers one invalid value, so one dataless variant. Otherwise the
    // enum is a tag and a union of its payloads.
    fn niche_variant(self, &cx: Domain!['k], variants: ArenaVec[Member['k], 'k]) -> Option[usize] {
        if variants.len(&cx) != 2usize {
            return Option::None;
        }
        let first = self.zero_size(&cx, variants.at(&cx, 0usize).type);
        let second = self.zero_size(&cx, variants.at(&cx, 1usize).type);
        if first == second {
            return Option::None;
        }
        let k = if first { 1usize } else { 0usize };
        match self.niche(&cx, variants.at(&cx, k).type) {
            Option::Some(_path) => Option::Some.(k),
            Option::None => Option::None,
        }
    }

    // The compiler chooses how `ty`'s value is laid out: an enum or a `NonNull` is in its value
    // representation (named types unfolded; not through a pointer, a function or an array of length
    // 0, which holds no value; a type parameter is a leaf).
    fn chosen_layout(self, &cx: Domain!['k], ty: Type['k]) -> bool {
        match ty {
            Type::Enum(_variants) => true,
            Type::NonNull(_inner) => true,
            Type::Ptr(_inner) => false,
            Type::Fn(_f) => false,
            Type::Brand(_brand) => false,
            Type::Array(elem, length) => length != 0u64 && self.chosen_layout(&cx, elem.copy(&cx)),
            Type::Named(name, args) => {
                if args.is_empty(&cx) && !self.program.types.contains(&cx, name) {
                    false
                } else {
                    self.chosen_layout(&cx, self.shape(&cx, ty, Option::None))
                }
            },
            Type::Foreach(_f) => self.chosen_layout(&cx, self.shape(&cx, ty, Option::None)),
            _ => {
                let parts = children(&cx, ty);
                var found = false;
                var i = 0usize;
                while !found && i < parts.len(&cx) {
                    found = self.chosen_layout(&cx, parts.at(&cx, i));
                    i = i + 1usize;
                }
                found
            },
        }
    }

    // One nominal step: the declaration's body at its arguments.
    //
    // With `home` given, the declaration must expose its shape there.
    fn unfold(self, &cx: Domain!['k], ty: Type['k], home: Option[ModuleId['k]]) -> Type['k] {
        let (name, args) = match ty {
            Type::Named(name, args) => (name, args),
            _ => fail(&cx, Span::from_static(&cx, "internal error: unfold of a type that is not nominal")),
        };
        let decl = self.decl(&cx, name);
        if args.len(&cx) != decl.params.len(&cx) {
            kurs_error(&cx, Buffer!::new().push_bytes(&cx, name).push_static(" takes ").push_usize(decl.params.len(&cx)).push_static(" type arguments").save(&cx), no_pos());
        }
        if !self.is_exposed(&cx, decl, home) {
            kurs_error(&cx, Buffer!::new().push_static("the shape of ").push_bytes(&cx, name).push_static(" is not exposed here").save(&cx), no_pos());
        }
        match self.unfolded.get(&cx, ty) {
            Option::Some(body) => return body,
            Option::None => (),
        }
        let sub: ArenaMap[Span['k], Type['k], 'k] = ArenaMap::new(&cx);
        var i = 0usize;
        while i < decl.params.len(&cx) {
            sub.insert(&cx, decl.params.at(&cx, i).name, args.at(&cx, i));
            i = i + 1usize;
        }
        // An unfolding that drew a fresh name is made again each time, so that every unfolding
        // draws the names it would have.
        let before = self.counter.next.copy(&cx);
        let body = subst(&cx, decl.body, sub, self.counter);
        if self.counter.next.copy(&cx) == before {
            self.unfolded.insert(&cx, ty, body);
        }
        body
    }

    fn is_exposed(self, &cx: Domain!['k], decl: TypeDecl['k], home: Option[ModuleId['k]]) -> bool {
        match decl.exposure {
            Option::None => true,
            Option::Some(exposure) => match home {
                Option::None => true,
                Option::Some(m) => match exposure.mode {
                    ExposureMode::Owner => key_eq(&cx, m, exposure.home),
                    ExposureMode::Within => m.within(&cx, exposure.home),
                },
            },
        }
    }

    // Exact assumed authority, or a concrete traversable outer shape.
    //
    // Authority is not recursive field exposure. A derived foreach source cannot borrow an
    // assumption about its underlying source; it needs its own exact assumption or a concretely
    // visible shape.
    fn exposure_available(self, &cx: Domain!['k], source: Type['k], home: Option[ModuleId['k]], kinds: ArenaMap[Span['k], Kind, 'k], premises: ArenaVec[Premise['k], 'k]) -> bool {
        var i = 0usize;
        while i < premises.len(&cx) {
            let p = premises.at(&cx, i);
            if p.trait_name.is(&cx, "Exposed") && p.args.len(&cx) == 1usize && equal(&cx, p.args.at(&cx, 0usize), source) {
                return true;
            }
            i = i + 1usize;
        }
        self.concrete_exposure(&cx, source, home, kinds)
    }

    // `Sized[ty]` (TY-SIZED): `ty` has a finite by-value layout of non-zero size, at every
    // instantiation. An exact assumption gives it; otherwise its shape decides it, with each type
    // parameter standing for a zero-size type: a part of it held by value, a primitive, a pointer, a
    // sum or a function value, has bytes whatever the parameters are. So `Sized[T]` and `Sized[U]` do
    // not give `Sized[(T, U)]`, and the same holds on every target. A raw load, store or `alloca` at
    // `ty` needs it. Every declaration's by-value layout is finite (`check_type_expansion`).
    fn sized_available(self, &cx: Domain!['k], ty: Type['k], premises: ArenaVec[Premise['k], 'k]) -> bool {
        var i = 0usize;
        while i < premises.len(&cx) {
            let p = premises.at(&cx, i);
            if p.trait_name.is(&cx, "Sized") && p.args.len(&cx) == 1usize && equal(&cx, p.args.at(&cx, 0usize), ty) {
                return true;
            }
            i = i + 1usize;
        }
        !self.zero_size_at(&cx, ty, true)
    }

    fn concrete_exposure(self, &cx: Domain!['k], source: Type['k], home: Option[ModuleId['k]], kinds: ArenaMap[Span['k], Kind, 'k]) -> bool {
        match self.visible_shape(&cx, source, home, kinds) {
            Option::None => false,
            Option::Some(shape) => match shape {
                Type::Ptr(inner) => {
                    // An indirect traversal requires an explicit outer pointer.
                    match source {
                        Type::Ptr(_s) => match self.visible_shape(&cx, inner.copy(&cx), home, kinds) {
                            Option::None => false,
                            Option::Some(t) => match t {
                                Type::Enum(_v) => false,
                                _ => true,
                            },
                        },
                        _ => false,
                    }
                },
                _ => true,
            },
        }
    }

    // A foreach source that is a pointer to a sum, named types unfolded whether exposed or not: no
    // traversal has one, as a pointer source points to a product, an array or a leaf. A parameter
    // decides nothing here; an instantiation at a sum has no rows.
    fn points_to_sum(self, &cx: Domain!['k], source: Type['k], kinds: ArenaMap[Span['k], Kind, 'k]) -> bool {
        match self.fixed_shape(&cx, source, kinds) {
            Option::Some(shape) => match shape {
                Type::Ptr(inner) => match self.fixed_shape(&cx, inner.copy(&cx), kinds) {
                    Option::Some(pointee) => match pointee {
                        Type::Enum(_v) => true,
                        _ => false,
                    },
                    Option::None => false,
                },
                _ => false,
            },
            Option::None => false,
        }
    }

    // Reveal only the outer shape, without treating abstract types as leaves.
    fn visible_shape(self, &cx: Domain!['k], ty: Type['k], home: Option[ModuleId['k]], kinds: ArenaMap[Span['k], Kind, 'k]) -> Option[Type['k]] {
        var ty = ty;
        while true {
            match ty {
                Type::Named(name, _args) => {
                    if kinds.contains(&cx, name) {
                        return Option::None;
                    }
                    let decl = self.decl(&cx, name);
                    if decl.exposure.is_some() && (home.is_none() || !self.is_exposed(&cx, decl, home)) {
                        return Option::None;
                    }
                    ty = self.unfold(&cx, ty, home);
                },
                Type::Foreach(f) => {
                    if !self.concrete_exposure(&cx, f.source.copy(&cx), home, kinds) {
                        return Option::None;
                    }
                    ty = self.expand(&cx, f, home);
                },
                _ => {
                    return Option::Some.(ty);
                },
            }
        }
        Option::None
    }

    // The outer structural type of `ty` (Named unfolded, foreach expanded).
    fn shape(self, &cx: Domain!['k], ty: Type['k], home: Option[ModuleId['k]]) -> Type['k] {
        var ty = ty;
        while true {
            match ty {
                Type::Named(_name, _args) => {
                    ty = self.unfold(&cx, ty, home);
                },
                Type::Foreach(f) => {
                    ty = self.expand(&cx, f, home);
                },
                _ => {
                    return ty;
                },
            }
        }
        ty
    }

    fn is_copy(self, &cx: Domain!['k], ty: Type['k], kinds: ArenaMap[Span['k], Kind, 'k]) -> bool {
        match ty {
            Type::Prim(_n) => true,
            Type::Ptr(_i) => true,
            Type::NonNull(_i) => true,
            Type::Brand(_b) => true,
            Type::Fn(_f) => true,
            Type::Never => true,
            Type::Named(name, args) => {
                if args.is_empty(&cx) && kinds.contains(&cx, name) {
                    return C::same_kind(kinds.at(&cx, name), Kind::Copy);
                }
                if self.decl(&cx, name).linear(&cx) {
                    return false;
                }
                // Whether `T` is Copy changes the answer for `Node[T]`.
                let key = (ty, sorted_kinds(&cx, kinds));
                if !self.copy_cache.contains(&cx, key) {
                    // An active nominal Copy query cannot justify itself. A valid recursive type
                    // reaches a pointer, function, or zero-length array before demanding the
                    // same query.
                    self.copy_cache.insert(&cx, key, false);
                    let answer = self.is_copy(&cx, self.unfold(&cx, ty, Option::None), kinds);
                    self.copy_cache.insert(&cx, key, answer);
                }
                self.copy_cache.at(&cx, key)
            },
            Type::Array(elem, length) => length == 0u64 || self.is_copy(&cx, elem.copy(&cx), kinds),
            Type::Exists(_binders, body) => self.is_copy(&cx, body.copy(&cx), kinds),
            Type::Foreach(f) => {
                // A source whose rows are fixed expands; otherwise every row is the body only when
                // the body does not mention a binder.
                if self.rows_fixed(&cx, f.source.copy(&cx), kinds) {
                    // Like a nominal query, an active one cannot justify itself: a foreach whose
                    // expansion holds it again by value has no finite layout, which
                    // `check_type_expansion` rejects.
                    var i = 0usize;
                    while i < self.expanding.len(&cx) {
                        if equal(&cx, ty, self.expanding.at(&cx, i)) {
                            return false;
                        }
                        i = i + 1usize;
                    }
                    self.expanding.push(&cx, ty);
                    let answer = self.is_copy(&cx, self.expand(&cx, f, Option::None), kinds);
                    let unit = self.expanding.pop(&cx);
                    return answer;
                }
                let body = f.body.copy(&cx);
                !free_names(&cx, body).contains(&cx, f.binder) && self.is_copy(&cx, body, kinds)
            },
            _ => {
                let parts = children(&cx, ty);
                var all = true;
                var i = 0usize;
                while all && i < parts.len(&cx) {
                    all = self.is_copy(&cx, parts.at(&cx, i), kinds);
                    i = i + 1usize;
                }
                all
            },
        }
    }

    // Whether a foreach source's rows are the same whatever the type parameters in `kinds`, and any
    // name no declaration gives, stand for: its outer shape, and a pointer's pointee's, is reached
    // without meeting one. A parameter's shape is unknown, and even a Copy argument may have a
    // linear component, in an array of length zero.
    fn rows_fixed(self, &cx: Domain!['k], source: Type['k], kinds: ArenaMap[Span['k], Kind, 'k]) -> bool {
        match self.fixed_shape(&cx, source, kinds) {
            Option::None => false,
            Option::Some(shape) => match shape {
                Type::Ptr(inner) => self.fixed_shape(&cx, inner.copy(&cx), kinds).is_some(),
                _ => true,
            },
        }
    }

    // The outer structural type of `ty`, or none when a parameter or undeclared name decides it.
    fn fixed_shape(self, &cx: Domain!['k], ty: Type['k], kinds: ArenaMap[Span['k], Kind, 'k]) -> Option[Type['k]] {
        var ty = ty;
        while true {
            match ty {
                Type::Named(name, args) => {
                    if (args.is_empty(&cx) && kinds.contains(&cx, name)) || !self.program.types.contains(&cx, name) {
                        return Option::None;
                    }
                    ty = self.unfold(&cx, ty, Option::None);
                },
                Type::Foreach(f) => {
                    if !self.rows_fixed(&cx, f.source.copy(&cx), kinds) {
                        return Option::None;
                    }
                    ty = self.expand(&cx, f, Option::None);
                },
                _ => {
                    return Option::Some.(ty);
                },
            }
        }
        Option::None
    }

    // The component types of a product (struct, tuple or array).
    fn fields(self, &cx: Domain!['k], ty: Type['k], home: Option[ModuleId['k]]) -> ArenaVec[Type['k], 'k] {
        match self.shape(&cx, ty, home) {
            Type::Struct(fields) => member_types(&cx, fields),
            Type::Tuple(elems) => elems,
            Type::Array(elem, length) => {
                let out: ArenaVec[Type['k], 'k] = ArenaVec::new(&cx);
                var i = 0u64;
                while i < length {
                    out.push(&cx, elem.copy(&cx));
                    i = i + 1u64;
                }
                out
            },
            _ => kurs_error(&cx, Buffer!::new().push_bytes(&cx, show(&cx, ty)).push_static(" is not a product").save(&cx), no_pos()),
        }
    }

    fn variants(self, &cx: Domain!['k], ty: Type['k], home: Option[ModuleId['k]]) -> ArenaVec[Member['k], 'k] {
        match self.shape(&cx, ty, home) {
            Type::Enum(variants) => variants,
            _ => kurs_error(&cx, Buffer!::new().push_bytes(&cx, show(&cx, ty)).push_static(" is not a sum").save(&cx), no_pos()),
        }
    }

    // One-level traversal of a foreach source: its outer skeleton (a structural type, or none for
    // a leaf) and one (label, item type) row per component, in order. With
    // `schema`, an array contributes one element type even when its runtime length is zero.
    fn rows(self, &cx: Domain!['k], source: Type['k], home: Option[ModuleId['k]], schema: bool) -> Rows['k] {
        var s = self.shape(&cx, source, home);
        var pointer = false;
        let unit = match s {
            // Behind a pointer each component is a pointer to it; a sum has none, so no rows
            // (TY-FOREACH-ROWS-PTR). Formation rejects a written one, and a traversal or `sizeof` with a
            // parameter in the pointee needs `Exposed` of the source, which no sum has.
            Type::Ptr(inner) => {
                s = self.shape(&cx, inner.copy(&cx), home);
                pointer = true;
                match s {
                    Type::Enum(_v) => {
                        return Rows.{ skeleton: Option::Some.(Type::Tuple.(ArenaVec::new(&cx))), rows: ArenaVec::new(&cx) };
                    },
                    _ => (),
                };
            },
            _ => (),
        };
        let rows: ArenaVec[Row['k], 'k] = ArenaVec::new(&cx);
        match s {
            Type::Struct(fields) => {
                var i = 0usize;
                while i < fields.len(&cx) {
                    rows.push(&cx, Row.{ label: fields.at(&cx, i).name, item: wrap(&cx, fields.at(&cx, i).type, pointer) });
                    i = i + 1usize;
                }
                Rows.{ skeleton: Option::Some.(s), rows }
            },
            Type::Tuple(elems) => {
                var i = 0usize;
                while i < elems.len(&cx) {
                    rows.push(&cx, Row.{ label: Buffer!::new().push_usize(i).save(&cx), item: wrap(&cx, elems.at(&cx, i), pointer) });
                    i = i + 1usize;
                }
                Rows.{ skeleton: Option::Some.(s), rows }
            },
            Type::Array(elem, length) => {
                let count = if schema { 1u64 } else { length };
                var i = 0u64;
                while i < count {
                    rows.push(&cx, Row.{ label: Buffer!::new().push_u64(i).save(&cx), item: wrap(&cx, elem.copy(&cx), pointer) });
                    i = i + 1u64;
                }
                Rows.{ skeleton: Option::Some.(s), rows }
            },
            Type::Enum(variants) => {
                var i = 0usize;
                while i < variants.len(&cx) {
                    rows.push(&cx, Row.{ label: variants.at(&cx, i).name, item: wrap(&cx, variants.at(&cx, i).type, pointer) });
                    i = i + 1usize;
                }
                Rows.{ skeleton: Option::Some.(s), rows }
            },
            _ => {
                rows.push(&cx, Row.{ label: Span::from_static(&cx, "0"), item: source });
                Rows.{ skeleton: Option::None, rows }
            },
        }
    }

    // What `ty`'s binder stands for at the row whose item is `item`: the item, or the pointee of a
    // pointer item for the `*F` pattern.
    fn binding(self, &cx: Domain!['k], ty: ForeachType['k], item: Type['k]) -> Type['k] {
        if !ty.indirect {
            return item;
        }
        match item {
            Type::Ptr(inner) => inner.copy(&cx),
            _ => kurs_error(&cx, Span::from_static(&cx, "a pointer pattern needs pointer components"), no_pos()),
        }
    }

    // `ty`'s body at the row whose item is `item`.
    fn row_body(self, &cx: Domain!['k], ty: ForeachType['k], item: Type['k]) -> Type['k] {
        let sub: ArenaMap[Span['k], Type['k], 'k] = ArenaMap::new(&cx);
        sub.insert(&cx, ty.binder, self.binding(&cx, ty, item));
        subst(&cx, ty.body.copy(&cx), sub, self.counter)
    }

    // Prove *F matches every component from the source as written: an explicit pointer, or a tuple,
    // struct, enum or array whose components are written as pointers. A name is not looked through,
    // even where its shape is visible.
    //
    // Source exposure is a separate obligation.
    fn pattern_available(self, &cx: Domain!['k], ty: ForeachType['k]) -> bool {
        if !ty.indirect {
            return true;
        }
        match ty.source.copy(&cx) {
            Type::Ptr(_inner) => true,
            Type::Tuple(elems) => {
                var all = true;
                var i = 0usize;
                while all && i < elems.len(&cx) {
                    all = is_ptr(elems.at(&cx, i));
                    i = i + 1usize;
                }
                all
            },
            Type::Struct(members) => all_ptr_members(&cx, members),
            Type::Enum(members) => all_ptr_members(&cx, members),
            Type::Array(elem, _length) => is_ptr(elem.copy(&cx)),
            _ => false,
        }
    }

    // The structural type a foreach transform denotes.
    fn expand(self, &cx: Domain!['k], ty: ForeachType['k], home: Option[ModuleId['k]]) -> Type['k] {
        let found = self.rows(&cx, ty.source.copy(&cx), home, true);
        let mapped: ArenaVec[Member['k], 'k] = ArenaVec::new(&cx);
        var i = 0usize;
        while i < found.rows.len(&cx) {
            let row = found.rows.at(&cx, i);
            mapped.push(&cx, Member.{ name: row.label, type: self.row_body(&cx, ty, row.item) });
            i = i + 1usize;
        }
        match found.skeleton {
            Option::Some(skeleton) => match skeleton {
                Type::Struct(_f) => Type::Struct.(mapped),
                Type::Enum(_v) => Type::Enum.(mapped),
                Type::Array(_e, length) => Type::Array.(Ref::new(&cx, mapped.at(&cx, 0usize).type), length),
                _ => Type::Tuple.(member_types(&cx, mapped)),
            },
            Option::None => Type::Tuple.(member_types(&cx, mapped)),
        }
    }

    // `ty`'s head, unfolding declarations, is a foreach type (TY-FLAT). A declaration whose body's
    // head is one of its parameters takes the head of that argument; a cycle of heads is no foreach,
    // and a type parameter never is one. Components are not looked at.
    fn expands_to_foreach(self, &cx: Domain!['k], ty: Type['k]) -> bool {
        let seen: ArenaVec[Type['k], 'k] = ArenaVec::new(&cx);
        var head = ty;
        var more = true;
        while more {
            more = false;
            let unit = match head {
                Type::Named(name, args) => match self.program.types.get(&cx, name) {
                    Option::Some(decl) => {
                        var known = false;
                        var i = 0usize;
                        while !known && i < seen.len(&cx) {
                            known = equal(&cx, head, seen.at(&cx, i));
                            i = i + 1usize;
                        }
                        if !known {
                            seen.push(&cx, head);
                            let sub: ArenaMap[Span['k], Type['k], 'k] = ArenaMap::new(&cx);
                            var p = 0usize;
                            while p < decl.params.len(&cx) && p < args.len(&cx) {
                                sub.insert(&cx, decl.params.at(&cx, p).name, args.at(&cx, p));
                                p = p + 1usize;
                            }
                            head = match decl.body {
                                Type::Named(body_name, body_args) => if body_args.is_empty(&cx) && sub.contains(&cx, body_name) {
                                    sub.at(&cx, body_name)
                                } else {
                                    let applied: ArenaVec[Type['k], 'k] = ArenaVec::new(&cx);
                                    var a = 0usize;
                                    while a < body_args.len(&cx) {
                                        applied.push(&cx, subst(&cx, body_args.at(&cx, a), sub, self.counter));
                                        a = a + 1usize;
                                    }
                                    Type::Named.(body_name, applied)
                                },
                                _ => decl.body,
                            };
                            more = true;
                        }
                    },
                    Option::None => (),
                },
                _ => (),
            };
        }
        match head {
            Type::Foreach(_f) => true,
            _ => false,
        }
    }
}

forall 'k.
fn wrap(&cx: Domain!['k], t: Type['k], pointer: bool) -> Type['k] {
    if pointer { C::ptr(&cx, t) } else { t }
}

forall 'k.
fn all_ptr_members(&cx: Domain!['k], members: ArenaVec[Member['k], 'k]) -> bool {
    var all = true;
    var i = 0usize;
    while all && i < members.len(&cx) {
        all = is_ptr(members.at(&cx, i).type);
        i = i + 1usize;
    }
    all
}

forall 'k.
fn is_ptr(t: Type['k]) -> bool {
    match t {
        Type::Ptr(_inner) => true,
        _ => false,
    }
}

// The kinds as a map key: (name, kind) pairs sorted by name.
forall 'k.
fn sorted_kinds(&cx: Domain!['k], kinds: ArenaMap[Span['k], Kind, 'k]) -> ArenaVec[(Span['k], u32), 'k] {
    let out: ArenaVec[(Span['k], u32), 'k] = ArenaVec::new(&cx);
    let names = kinds.keys(&cx);
    var i = 0usize;
    while i < names.len(&cx) {
        out.push(&cx, (names.at(&cx, i), C::kind_index(kinds.at(&cx, names.at(&cx, i)))));
        i = i + 1usize;
    }
    out.sort_by(&cx, |&cx, a, b| name_order(&cx, a, b));
    out
}

// ------------------------------------------------------------------- show --

// `ty` as KURS writes it, a brand as `$label`: for messages about KURS, and for dumps.
forall 'k.
fn show(&cx: Domain!['k], ty: Type['k]) -> Span['k] {
    render(&cx, ty)
}

// Types as source writes them: `Vec![T]`, `Brand['k]`, `(A, B)`, `*T`, `[T; 4]`, `exists 'k. T`,
// `fn(A, &_: B) -> R`. A brand reads as written, `'k`; a name the compiler made reads as the name it
// was made from (`'b` for the brand `b#open9` that `let exists 'b.` opened, `Env` for a closure's
// environment `Env#1`), or `_` when it was made from none.
//
// One `Surface` writes every type of one message, and the `nominal` names it writes outside them,
// such as a trait's. A nominal name reads as its last path segment unless another name in the
// message reads the same, when it reads as its full path. Where two different brands would read the
// same, each that a `let exists` opened, at a position in `origins`, says where:
// `'k (opened at 15:9)`, and any other the compiler made reads as its stem numbered apart from every
// other reading, as `'b1` for the brand `b#4` that a function value keeps beside the brand `'b`.
forall 'k.
exposed struct Surface {
    origins: ArenaMap[Span['k], Pos, 'k],
    // the brands written with where they were opened
    qualified: ArenaSet[Span['k], 'k],
    // the brands the compiler made written numbered, with their reading
    renamed: ArenaMap[Span['k], Span['k], 'k],
    // the nominal types written with their full path
    paths: ArenaSet[Span['k], 'k],
}

forall 'k.
fn surface(&cx: Domain!['k], types: ArenaVec[Type['k], 'k], nominal: ArenaVec[Span['k], 'k], origins: ArenaMap[Span['k], Pos, 'k]) -> Surface['k] {
    let labels: ArenaSet[Span['k], 'k] = ArenaSet::new(&cx);
    let names: ArenaSet[Span['k], 'k] = ArenaSet::new(&cx);
    names.insert_all(&cx, nominal);
    var i = 0usize;
    while i < types.len(&cx) {
        brand_labels(&cx, types.at(&cx, i), labels);
        type_names(&cx, types.at(&cx, i), names);
        i = i + 1usize;
    }
    let all = labels.keys(&cx);
    let spellings: ArenaMap[Span['k], usize, 'k] = ArenaMap::new(&cx);
    i = 0usize;
    while i < all.len(&cx) {
        let name = made_from(&cx, all.at(&cx, i));
        spellings.insert(&cx, name, spellings.get_or(&cx, name, 0usize) + 1usize);
        i = i + 1usize;
    }
    let qualified: ArenaSet[Span['k], 'k] = ArenaSet::new(&cx);
    let made: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
    i = 0usize;
    while i < all.len(&cx) {
        let label = all.at(&cx, i);
        if spellings.at(&cx, made_from(&cx, label)) > 1usize {
            if origins.contains(&cx, label) {
                qualified.insert(&cx, label);
            } else if label.contains(&cx, Span::from_static(&cx, "#")) {
                made.push(&cx, label);
            }
        }
        i = i + 1usize;
    }
    // Any other brand the compiler made that reads as another does reads as its stem numbered anew.
    made.sort_by(&cx, |&cx, a, b| a.cmp(&cx, b));
    let taken: ArenaSet[Span['k], 'k] = ArenaSet::new(&cx);
    taken.insert_all(&cx, spellings.keys(&cx));
    let renamed: ArenaMap[Span['k], Span['k], 'k] = ArenaMap::new(&cx);
    i = 0usize;
    while i < made.len(&cx) {
        let stem = made_from(&cx, made.at(&cx, i));
        var n = 1u64;
        var reading = Buffer!::new().push_bytes(&cx, stem).push_u64(n).save(&cx);
        while taken.contains(&cx, reading) {
            n = n + 1u64;
            reading = Buffer!::new().push_bytes(&cx, stem).push_u64(n).save(&cx);
        }
        renamed.insert(&cx, made.at(&cx, i), reading);
        taken.insert(&cx, reading);
        i = i + 1usize;
    }
    let every = names.keys(&cx);
    let readings: ArenaMap[Span['k], usize, 'k] = ArenaMap::new(&cx);
    i = 0usize;
    while i < every.len(&cx) {
        let reading = short(&cx, every.at(&cx, i));
        readings.insert(&cx, reading, readings.get_or(&cx, reading, 0usize) + 1usize);
        i = i + 1usize;
    }
    let paths: ArenaSet[Span['k], 'k] = ArenaSet::new(&cx);
    i = 0usize;
    while i < every.len(&cx) {
        let name = every.at(&cx, i);
        if readings.at(&cx, short(&cx, name)) > 1usize {
            paths.insert(&cx, name);
        }
        i = i + 1usize;
    }
    Surface.{ origins, qualified, renamed, paths }
}

forall 'k.
impl Surface['k] {
    fn brand(self, &cx: Domain!['k], label: Span['k]) -> Span['k] {
        let name = brand_name(&cx, label);
        if self.qualified.contains(&cx, label) {
            let at = self.origins.at(&cx, label);
            Buffer!::new().push_bytes(&cx, name).push_static(" (opened at ").push_u64(at.line as u64).push_static(":").push_u64(at.col as u64)
                .push_static(")").save(&cx)
        } else if self.renamed.contains(&cx, label) {
            Buffer!::new().push_static("'").push_bytes(&cx, self.renamed.at(&cx, label)).save(&cx)
        } else {
            name
        }
    }

    // A nominal type's name or a type variable, as this message writes it.
    fn name(self, &cx: Domain!['k], name: Span['k]) -> Span['k] {
        if !name.contains(&cx, Span::from_static(&cx, "::")) {
            return variable(&cx, name);
        }
        if self.paths.contains(&cx, name) { name } else { short(&cx, name) }
    }

    fn show(self, &cx: Domain!['k], ty: Type['k]) -> Span['k] {
        source(&cx, ty, self)
    }
}

// The brand `label` as written in source, as `Surface` writes it where no other brand reads the same.
forall 'k.
fn brand_name(&cx: Domain!['k], label: Span['k]) -> Span['k] {
    Buffer!::new().push_static("'").push_bytes(&cx, made_from(&cx, label)).save(&cx)
}

// The name a compiler-made name `name#...` was made from; a source name is its own.
forall 'k.
fn made_from(&cx: Domain!['k], name: Span['k]) -> Span['k] {
    match name.find_byte(&cx, b'#', 0usize) {
        Option::Some(at) => name.take(at),
        Option::None => name,
    }
}

// A type variable as a message writes it; a nominal type's path is its own.
forall 'k.
fn variable(&cx: Domain!['k], name: Span['k]) -> Span['k] {
    if name.contains(&cx, Span::from_static(&cx, "::")) || name.find_byte(&cx, b'#', 0usize).is_none() {
        return name;
    }
    let base = made_from(&cx, name);
    if base.is_empty() { Span::from_static(&cx, "_") } else { base }
}

// A nominal type's last path segment; a type variable as a message writes it.
forall 'k.
fn short(&cx: Domain!['k], name: Span['k]) -> Span['k] {
    let separator = Span::from_static(&cx, "::");
    if !name.contains(&cx, separator) {
        return variable(&cx, name);
    }
    var rest = name;
    var more = true;
    while more {
        more = match rest.find(&cx, separator, 0usize) {
            Option::Some(at) => {
                rest = rest.skip(at + 2usize);
                true
            },
            Option::None => false,
        };
    }
    rest
}

forall 'k.
fn type_names(&cx: Domain!['k], ty: Type['k], out: ArenaSet[Span['k], 'k]) {
    let unit = match ty {
        Type::Named(name, _args) => { out.insert(&cx, name); },
        Type::Foreach(f) => { out.insert(&cx, f.binder); },
        _ => (),
    };
    let parts = children(&cx, ty);
    var i = 0usize;
    while i < parts.len(&cx) {
        type_names(&cx, parts.at(&cx, i), out);
        i = i + 1usize;
    }
}

forall 'k.
fn brand_labels(&cx: Domain!['k], ty: Type['k], out: ArenaSet[Span['k], 'k]) {
    let unit = match ty {
        Type::Skolem(label) => { out.insert(&cx, label); },
        Type::Exists(binders, _body) => {
            var i = 0usize;
            while i < binders.len(&cx) {
                out.insert(&cx, binders.at(&cx, i));
                i = i + 1usize;
            }
        },
        _ => (),
    };
    let parts = children(&cx, ty);
    var i = 0usize;
    while i < parts.len(&cx) {
        brand_labels(&cx, parts.at(&cx, i), out);
        i = i + 1usize;
    }
}

// `ts` as source writes them, separated by `, `.
forall 'k.
fn source_all(&cx: Domain!['k], out: Buffer!, ts: ArenaVec[Type['k], 'k], surface: Surface['k]) -> Buffer! {
    var out = out;
    var i = 0usize;
    while i < ts.len(&cx) {
        if i > 0usize {
            out = out.push_static(", ");
        }
        out = out.push_bytes(&cx, source(&cx, ts.at(&cx, i), surface));
        i = i + 1usize;
    }
    out
}

// The members of an anonymous struct, `a: T, b: U`, or enum, `A(T), B(U)`.
forall 'k.
fn source_members(&cx: Domain!['k], out: Buffer!, ms: ArenaVec[Member['k], 'k], variants: bool, surface: Surface['k]) -> Buffer! {
    var out = out;
    var i = 0usize;
    while i < ms.len(&cx) {
        if i > 0usize {
            out = out.push_static(", ");
        }
        out = out.push_bytes(&cx, ms.at(&cx, i).name);
        let shown = source(&cx, ms.at(&cx, i).type, surface);
        out = if variants { out.push_static("(").push_bytes(&cx, shown).push_static(")") } else { out.push_static(": ").push_bytes(&cx, shown) };
        i = i + 1usize;
    }
    out
}

// `ty` as source writes it, by `surface`.
forall 'k.
fn source(&cx: Domain!['k], ty: Type['k], surface: Surface['k]) -> Span['k] {
    match ty {
        Type::Prim(name) => name,
        Type::Never => Span::from_static(&cx, "!"),
        Type::Named(name, args) => {
            if args.is_empty(&cx) {
                surface.name(&cx, name)
            } else {
                source_all(&cx, Buffer!::new().push_bytes(&cx, surface.name(&cx, name)).push_static("["), args, surface).push_static("]").save(&cx)
            }
        },
        Type::Skolem(label) => surface.brand(&cx, label),
        Type::Brand(brand) => Buffer!::new().push_static("Brand[").push_bytes(&cx, source(&cx, brand.copy(&cx), surface)).push_static("]").save(&cx),
        Type::Ptr(inner) => Buffer!::new().push_static("*").push_bytes(&cx, source(&cx, inner.copy(&cx), surface)).save(&cx),
        Type::NonNull(inner) => Buffer!::new().push_static("NonNull[").push_bytes(&cx, source(&cx, inner.copy(&cx), surface)).push_static("]").save(&cx),
        Type::Tuple(elems) => {
            let out = source_all(&cx, Buffer!::new().push_static("("), elems, surface);
            (if elems.len(&cx) == 1usize { out.push_static(",)") } else { out.push_static(")") }).save(&cx)
        },
        Type::Array(elem, length) => Buffer!::new().push_static("[").push_bytes(&cx, source(&cx, elem.copy(&cx), surface)).push_static("; ").push_u64(length).push_static("]").save(&cx),
        Type::Struct(fields) => source_members(&cx, Buffer!::new().push_static("struct { "), fields, false, surface).push_static(" }").save(&cx),
        Type::Enum(variants) => source_members(&cx, Buffer!::new().push_static("enum { "), variants, true, surface).push_static(" }").save(&cx),
        Type::Exists(binders, body) => {
            var out = Buffer!::new().push_static("exists ");
            var i = 0usize;
            while i < binders.len(&cx) {
                if i > 0usize {
                    out = out.push_static(", ");
                }
                out = out.push_bytes(&cx, surface.brand(&cx, binders.at(&cx, i)));
                i = i + 1usize;
            }
            out.push_static(". ").push_bytes(&cx, source(&cx, body.copy(&cx), surface)).save(&cx)
        },
        Type::Foreach(f) => {
            var out = Buffer!::new().push_static("foreach ");
            if f.indirect {
                out = out.push_static("*");
            }
            out.push_bytes(&cx, surface.name(&cx, f.binder)).push_static(" of ").push_bytes(&cx, source(&cx, f.source.copy(&cx), surface))
                .push_static(" => ").push_bytes(&cx, source(&cx, f.body.copy(&cx), surface)).save(&cx)
        },
        Type::Fn(f) => {
            var out = Buffer!::new();
            if f.is_unsafe {
                out = out.push_static("unsafe ");
            }
            out = out.push_static("fn(");
            var i = 0usize;
            while i < f.params.len(&cx) {
                if i > 0usize {
                    out = out.push_static(", ");
                }
                if f.places.contains(&cx, i) {
                    out = out.push_static("&_: ");
                }
                out = out.push_bytes(&cx, source(&cx, f.params.at(&cx, i), surface));
                i = i + 1usize;
            }
            out.push_static(") -> ").push_bytes(&cx, source(&cx, f.ret.copy(&cx), surface)).save(&cx)
        },
        _ => Span::from_static(&cx, "_"),
    }
}

forall 'k.
fn render_all(&cx: Domain!['k], out: Buffer!, ts: ArenaVec[Type['k], 'k]) -> Buffer! {
    var out = out;
    var i = 0usize;
    while i < ts.len(&cx) {
        if i > 0usize {
            out = out.push_static(" ");
        }
        out = out.push_bytes(&cx, render(&cx, ts.at(&cx, i)));
        i = i + 1usize;
    }
    out
}

forall 'k.
fn render_members(&cx: Domain!['k], out: Buffer!, ms: ArenaVec[Member['k], 'k]) -> Buffer! {
    var out = out;
    var i = 0usize;
    while i < ms.len(&cx) {
        if i > 0usize {
            out = out.push_static(" ");
        }
        out = out.push_static("(").push_bytes(&cx, ms.at(&cx, i).name).push_static(" ").push_bytes(&cx, render(&cx, ms.at(&cx, i).type)).push_static(")");
        i = i + 1usize;
    }
    out
}

// `ty` as KURS writes it.
forall 'k.
fn render(&cx: Domain!['k], ty: Type['k]) -> Span['k] {
    match ty {
        Type::Prim(name) => name,
        Type::Never => Span::from_static(&cx, "!"),
        Type::Named(name, args) => {
            if args.is_empty(&cx) {
                name
            } else {
                render_all(&cx, Buffer!::new().push_static("(").push_bytes(&cx, name).push_static(" "), args).push_static(")").save(&cx)
            }
        },
        Type::Skolem(label) => Buffer!::new().push_static("$").push_bytes(&cx, label).save(&cx),
        Type::Brand(brand) => Buffer!::new().push_static("(brand ").push_bytes(&cx, render(&cx, brand.copy(&cx))).push_static(")").save(&cx),
        Type::Ptr(inner) => Buffer!::new().push_static("(ptr ").push_bytes(&cx, render(&cx, inner.copy(&cx))).push_static(")").save(&cx),
        Type::NonNull(inner) => Buffer!::new().push_static("(non_null ").push_bytes(&cx, render(&cx, inner.copy(&cx))).push_static(")").save(&cx),
        Type::Tuple(elems) => replace_all(&cx, render_all(&cx, Buffer!::new().push_static("(tuple "), elems).push_static(")").save(&cx), Span::from_static(&cx, " )"), Span::from_static(&cx, ")")),
        Type::Array(elem, length) => Buffer!::new().push_static("(array ").push_bytes(&cx, render(&cx, elem.copy(&cx))).push_static(" ").push_u64(length).push_static(")").save(&cx),
        Type::Struct(fields) => render_members(&cx, Buffer!::new().push_static("(struct "), fields).push_static(")").save(&cx),
        Type::Enum(variants) => render_members(&cx, Buffer!::new().push_static("(enum "), variants).push_static(")").save(&cx),
        Type::Exists(binders, body) => {
            var out = Buffer!::new().push_static("(exists (");
            var i = 0usize;
            while i < binders.len(&cx) {
                if i > 0usize {
                    out = out.push_static(" ");
                }
                out = out.push_static("$").push_bytes(&cx, binders.at(&cx, i));
                i = i + 1usize;
            }
            out.push_static(") ").push_bytes(&cx, render(&cx, body.copy(&cx))).push_static(")").save(&cx)
        },
        Type::Foreach(f) => {
            var out = Buffer!::new().push_static("(foreach (");
            if f.indirect {
                out = out.push_static("(ptr ").push_bytes(&cx, f.binder).push_static(")");
            } else {
                out = out.push_bytes(&cx, f.binder);
            }
            out.push_static(" ").push_bytes(&cx, render(&cx, f.source.copy(&cx))).push_static(") ").push_bytes(&cx, render(&cx, f.body.copy(&cx)))
                .push_static(")").save(&cx)
        },
        Type::Fn(f) => {
            var out = Buffer!::new().push_static("(fn ");
            if f.is_unsafe {
                out = out.push_static("(unsafe) ");
            }
            render_all(&cx, out.push_static("("), f.params).push_static(") ").push_bytes(&cx, render(&cx, f.ret.copy(&cx))).push_static(")").save(&cx)
        },
        _ => Span::from_static(&cx, "_"),
    }
}

// When `a` and `b` differ only in brands, as `equal` compares them: the brand labels where they
// differ, in the order met, each pair's left one first. None when they differ in more than brands.
forall 'k.
fn brand_differences(&cx: Domain!['k], a: Type['k], b: Type['k]) -> Option[ArenaVec[Span['k], 'k]] {
    let found: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
    if differ_in(&cx, a, b, alpha(), found) { Option::Some.(found) } else { Option::None }
}

forall 'k.
fn note_brand(&cx: Domain!['k], found: ArenaVec[Span['k], 'k], label: Span['k]) {
    if !found.contains(&cx, label) {
        found.push(&cx, label);
    }
}

forall 'k.
fn differ_all(&cx: Domain!['k], xs: ArenaVec[Type['k], 'k], ys: ArenaVec[Type['k], 'k], env: Alpha['k], found: ArenaVec[Span['k], 'k]) -> bool {
    var ok = xs.len(&cx) == ys.len(&cx);
    var i = 0usize;
    while ok && i < xs.len(&cx) {
        ok = differ_in(&cx, xs.at(&cx, i), ys.at(&cx, i), env, found);
        i = i + 1usize;
    }
    ok
}

forall 'k.
fn differ_members(&cx: Domain!['k], xs: ArenaVec[Member['k], 'k], ys: ArenaVec[Member['k], 'k], env: Alpha['k], found: ArenaVec[Span['k], 'k]) -> bool {
    var ok = xs.len(&cx) == ys.len(&cx);
    var i = 0usize;
    while ok && i < xs.len(&cx) {
        ok = xs.at(&cx, i).name.eq(&cx, ys.at(&cx, i).name);
        i = i + 1usize;
    }
    ok && differ_all(&cx, member_types(&cx, xs), member_types(&cx, ys), env, found)
}

// `equal_in`, except that two brands that differ are noted in `found` rather than unequal.
forall 'k.
fn differ_in(&cx: Domain!['k], a: Type['k], b: Type['k], env: Alpha['k], found: ArenaVec[Span['k], 'k]) -> bool {
    if type_tag(a) != type_tag(b) {
        return false;
    }
    match a {
        Type::Skolem(x) => match b {
            Type::Skolem(y) => {
                if !same_name(&cx, env, x, y) {
                    note_brand(&cx, found, x);
                    note_brand(&cx, found, y);
                }
                true
            },
            _ => false,
        },
        Type::Named(x, xs) => match b {
            Type::Named(y, ys) => {
                if xs.is_empty(&cx) && ys.is_empty(&cx) && binds(&cx, env, x, y) {
                    same_name(&cx, env, x, y)
                } else {
                    x.eq(&cx, y) && differ_all(&cx, xs, ys, env, found)
                }
            },
            _ => false,
        },
        Type::Exists(xs, p) => match b {
            Type::Exists(ys, q) => xs.len(&cx) == ys.len(&cx) && differ_in(&cx, p.copy(&cx), q.copy(&cx), bind(&cx, env, xs, ys), found),
            _ => false,
        },
        Type::Foreach(x) => match b {
            Type::Foreach(y) => x.indirect == y.indirect && differ_in(&cx, x.source.copy(&cx), y.source.copy(&cx), env, found)
                && differ_in(&cx, x.body.copy(&cx), y.body.copy(&cx), bind(&cx, env, ArenaVec::one(&cx, x.binder), ArenaVec::one(&cx, y.binder)), found),
            _ => false,
        },
        Type::Fn(x) => match b {
            Type::Fn(y) => {
                if x.is_unsafe != y.is_unsafe || !x.places.eq(&cx, y.places) || x.params.len(&cx) != y.params.len(&cx) {
                    return false;
                }
                differ_all(&cx, x.params, y.params, env, found) && differ_in(&cx, x.ret.copy(&cx), y.ret.copy(&cx), env, found)
            },
            _ => false,
        },
        Type::Struct(xs) => match b {
            Type::Struct(ys) => differ_members(&cx, xs, ys, env, found),
            _ => false,
        },
        Type::Enum(xs) => match b {
            Type::Enum(ys) => differ_members(&cx, xs, ys, env, found),
            _ => false,
        },
        Type::Array(x, n) => match b {
            Type::Array(y, m) => n == m && differ_in(&cx, x.copy(&cx), y.copy(&cx), env, found),
            _ => false,
        },
        Type::Tuple(xs) => match b {
            Type::Tuple(ys) => differ_all(&cx, xs, ys, env, found),
            _ => false,
        },
        Type::Ptr(x) => match b {
            Type::Ptr(y) => differ_in(&cx, x.copy(&cx), y.copy(&cx), env, found),
            _ => false,
        },
        Type::NonNull(x) => match b {
            Type::NonNull(y) => differ_in(&cx, x.copy(&cx), y.copy(&cx), env, found),
            _ => false,
        },
        Type::Brand(x) => match b {
            Type::Brand(y) => differ_in(&cx, x.copy(&cx), y.copy(&cx), env, found),
            _ => false,
        },
        _ => C::same(&cx, a, b),
    }
}
