// SCC restrictions for instance search and function specialization.
//
// For specialization inside a recursive component, pass parameters unchanged or choose fixed
// types. Across components, arbitrary construction is finite because the SCC graph is a DAG.
// Instance matching only extracts subterms of the trait arguments. Thus each component draws from
// a finite set of incoming types, constants and subterms; memoizing specialization tuples
// exhausts that set. This is conservative: a rejected cycle need not actually grow (another edge
// might reset its arguments). Instance search instead requires structural descent on every
// recursive edge.

use package::support::base::fail;
use std::collections::arena_vec::ArenaVec;
use std::collections::arena_map::{ArenaMap, ArenaSet};
use std::cmp::min;
use std::raw::Span;
use std::arena::{Domain!, seed};
use std::buffer::Buffer!;
use package::kurs::core::{Fun, Instr, Kind, Param, Premise, Program, Type};
use package::kurs::core as C;
use package::types::formation::strict_subterm;
use package::syntax::ast::Pos;
use package::types::ops::{file_of, free_names, kurs_error, kurs_error_in, overlap, show, surface};
use std::collections::hashmap::OwnedMap!;
use std::collections::vec::OwnedVec!;
use std::option::Option;

// Tarjan's algorithm: mutually reachable nodes receive the same ID. A node is a key: (function,)
// or (trait, method). The walk's numbering, stack and active set are its own, freed when it ends;
// only the components are kept.
forall 'k.
fn components(&cx: Domain!['k], graph: ArenaMap[ArenaVec[Span['k], 'k], ArenaSet[ArenaVec[Span['k], 'k], 'k], 'k]) -> ArenaMap[ArenaVec[Span['k], 'k], usize, 'k] {
    let result: ArenaMap[ArenaVec[Span['k], 'k], usize, 'k] = ArenaMap::new(&cx);
    var walk = Tarjan!.{ indices: OwnedMap!::new(seed(&cx)), low: OwnedMap!::new(seed(&cx)), stack: OwnedVec!::new(), active: OwnedMap!::new(seed(&cx)) };
    var i = 0usize;
    while i < graph.positions(&cx) {
        match graph.key_at(&cx, i) {
            Some(node) => if !&walk.numbered(&cx, node) {
                &walk.visit(&cx, graph, result, node);
            },
            None => (),
        };
        i = i + 1usize;
    }
    let { indices, low, stack, active } = walk;
    indices.destroy();
    low.destroy();
    stack.destroy();
    active.destroy();
    result
}

forall 'k.
exposed struct Tarjan! {
    indices: OwnedMap![ArenaVec[Span['k], 'k], usize],
    low: OwnedMap![ArenaVec[Span['k], 'k], usize],
    stack: OwnedVec![ArenaVec[Span['k], 'k]],
    active: OwnedMap![ArenaVec[Span['k], 'k], bool],
}


// The number `numbers` gives `node`, which it must have.
forall 'k.
fn number(&cx: Domain!['k], &numbers: OwnedMap![ArenaVec[Span['k], 'k], usize], node: ArenaVec[Span['k], 'k]) -> usize {
    match &numbers.get_in(&cx, node) {
        Some(n) => n,
        None => fail(&cx, Span::from_static(&cx, "internal error: a node the walk has not numbered")),
    }
}

forall 'k.
impl Tarjan!['k] {
    fn numbered(&self, &cx: Domain!['k], node: ArenaVec[Span['k], 'k]) -> bool {
        match &self.indices.get_in(&cx, node) {
            Some(n) => true,
            None => false,
        }
    }

    fn visit(&self, &cx: Domain!['k], graph: ArenaMap[ArenaVec[Span['k], 'k], ArenaSet[ArenaVec[Span['k], 'k], 'k], 'k], result: ArenaMap[ArenaVec[Span['k], 'k], usize, 'k], node: ArenaVec[Span['k], 'k]) {
        let index = &self.indices.len();
        let fresh = &self.indices.insert_in(&cx, node, index);
        let first = &self.low.insert_in(&cx, node, index);
        &self.stack.push(node);
        let entered = &self.active.insert_in(&cx, node, true);
        let targets = graph.at(&cx, node);
        var i = 0usize;
        while i < targets.positions(&cx) {
            match targets.key_at(&cx, i) {
                Some(target) => {
                    if !&self.numbered(&cx, target) {
                        &self.visit(&cx, graph, result, target);
                        let lowest = min(number(&cx, &self.low, node), number(&cx, &self.low, target));
                        let old = &self.low.insert_in(&cx, node, lowest);
                    } else {
                        match &self.active.get_in(&cx, target) {
                            Some(on_stack) => {
                                let lowest = min(number(&cx, &self.low, node), number(&cx, &self.indices, target));
                                let old = &self.low.insert_in(&cx, node, lowest);
                            },
                            None => (),
                        };
                    }
                },
                None => (),
            };
            i = i + 1usize;
        }
        let own = number(&cx, &self.indices, node);
        if number(&cx, &self.low, node) == own {
            var going = true;
            while going {
                match &self.stack.pop() {
                    Some(member) => {
                        let left = &self.active.remove_in(&cx, member);
                        result.insert(&cx, member, own);
                        going = !member.eq(&cx, node);
                    },
                    None => {
                        going = false;
                    },
                };
            }
        }
    }
}

forall 'k.
fn node1(&cx: Domain!['k], a: Span['k]) -> ArenaVec[Span['k], 'k] {
    ArenaVec::one(&cx, a)
}

forall 'k.
fn add_node(&cx: Domain!['k], graph: ArenaMap[ArenaVec[Span['k], 'k], ArenaSet[ArenaVec[Span['k], 'k], 'k], 'k], node: ArenaVec[Span['k], 'k]) {
    if !graph.contains(&cx, node) {
        graph.insert(&cx, node, ArenaSet::new(&cx));
    }
}

// Every premise edge within a trait SCC decreases its first argument.
//
// A finite proof tree follows: each recursive component strictly decreases a finite type term,
// and edges between components follow a finite DAG. Headers are shared by surface inference and
// KURS, before either searches. `files` names the file of each header, when it has one. With
// `in_surface` set, a message writes trait names as a message about source does
// (`types::ops::Surface`).
forall 'k.
fn check_instance_termination(&cx: Domain!['k], headers: ArenaVec[(Premise['k], ArenaVec[Premise['k], 'k], Pos), 'k], files: ArenaVec[Span['k], 'k], in_surface: bool) {
    let graph: ArenaMap[ArenaVec[Span['k], 'k], ArenaSet[ArenaVec[Span['k], 'k], 'k], 'k] = ArenaMap::new(&cx);
    var i = 0usize;
    while i < headers.len(&cx) {
        let (head, premises, _pos) = headers.at(&cx, i);
        add_node(&cx, graph, node1(&cx, head.trait_name));
        var j = 0usize;
        while j < premises.len(&cx) {
            add_node(&cx, graph, node1(&cx, premises.at(&cx, j).trait_name));
            graph.at(&cx, node1(&cx, head.trait_name)).insert(&cx, node1(&cx, premises.at(&cx, j).trait_name));
            j = j + 1usize;
        }
        i = i + 1usize;
    }
    let scc = components(&cx, graph);
    var k = 0usize;
    while k < headers.len(&cx) {
        let (head, premises, pos) = headers.at(&cx, k);
        var j = 0usize;
        while j < premises.len(&cx) {
            let premise = premises.at(&cx, j);
            if scc.at(&cx, node1(&cx, head.trait_name)) == scc.at(&cx, node1(&cx, premise.trait_name)) {
                if head.args.is_empty(&cx) || premise.args.is_empty(&cx) || !strict_subterm(&cx, premise.args.at(&cx, 0usize), head.args.at(&cx, 0usize)) {
                    let (from, to) = if in_surface {
                        let spelling = surface(&cx, ArenaVec::new(&cx), ArenaVec::two(&cx, head.trait_name, premise.trait_name), ArenaMap::new(&cx));
                        (spelling.name(&cx, head.trait_name), spelling.name(&cx, premise.trait_name))
                    } else {
                        (head.trait_name, premise.trait_name)
                    };
                    kurs_error_in(&cx, Buffer!::new().push_static("recursive instance premise ").push_bytes(&cx, from).push_static(" -> ").push_bytes(&cx, to)
                        .push_static(": first argument must be a strict structural subterm of the head's first argument").save(&cx), file_of(&cx, files, k), pos);
                }
            }
            j = j + 1usize;
        }
        k = k + 1usize;
    }
}

// A specialization request: the calling body, the body it requests, the caller's value
// parameters, and the instruction.
forall 'k.
exposed struct Site {
    caller: ArenaVec[Span['k], 'k],
    callee: ArenaVec[Span['k], 'k],
    scope: ArenaSet[Span['k], 'k],
    instr: Instr['k],
}

// Check every specialization request before starting the backend worklist.
//
// Trait-method nodes unite all their instance bodies. Indirect calls require no edge: their code
// was already requested at a statically named `fn` site. Lifted closures and foreach mappers are
// ordinary functions in this graph.
forall 'k.
fn check_mono_termination(&cx: Domain!['k], program: Program['k]) {
    let keys: ArenaVec[ArenaVec[Span['k], 'k], 'k] = ArenaVec::new(&cx);
    let bodies: ArenaVec[Fun['k], 'k] = ArenaVec::new(&cx);
    let scopes: ArenaVec[ArenaVec[Param['k], 'k], 'k] = ArenaVec::new(&cx);
    let funs = program.funs.values(&cx);
    var f = 0usize;
    while f < funs.len(&cx) {
        keys.push(&cx, node1(&cx, funs.at(&cx, f).name));
        bodies.push(&cx, funs.at(&cx, f));
        scopes.push(&cx, funs.at(&cx, f).params);
        f = f + 1usize;
    }
    let groups = program.instances.values(&cx);
    var g = 0usize;
    while g < groups.len(&cx) {
        let instances = groups.at(&cx, g);
        var n = 0usize;
        while n < instances.len(&cx) {
            let inst = instances.at(&cx, n);
            var m = 0usize;
            while m < inst.methods.len(&cx) {
                let fun = inst.methods.at(&cx, m);
                keys.push(&cx, ArenaVec::two(&cx, inst.trait_name, fun.name));
                bodies.push(&cx, fun);
                let params = inst.params.clone(&cx);
                params.append(&cx, fun.params);
                scopes.push(&cx, params);
                m = m + 1usize;
            }
            n = n + 1usize;
        }
        g = g + 1usize;
    }
    let graph: ArenaMap[ArenaVec[Span['k], 'k], ArenaSet[ArenaVec[Span['k], 'k], 'k], 'k] = ArenaMap::new(&cx);
    var b = 0usize;
    while b < keys.len(&cx) {
        graph.insert(&cx, keys.at(&cx, b), ArenaSet::new(&cx));
        b = b + 1usize;
    }
    let sites: ArenaVec[Site['k], 'k] = ArenaVec::new(&cx);
    var c = 0usize;
    while c < keys.len(&cx) {
        let key = keys.at(&cx, c);
        let fun = bodies.at(&cx, c);
        // Brands have no type constructors and cannot grow.
        let scope: ArenaSet[Span['k], 'k] = ArenaSet::new(&cx);
        let params = scopes.at(&cx, c);
        var p = 0usize;
        while p < params.len(&cx) {
            if !C::same_kind(params.at(&cx, p).kind, Kind::Brand) {
                scope.insert(&cx, params.at(&cx, p).name);
            }
            p = p + 1usize;
        }
        var k = 0usize;
        while k < fun.blocks.len(&cx) {
            let instrs = fun.blocks.at(&cx, k).instrs;
            var i = 0usize;
            while i < instrs.len(&cx) {
                let instr = instrs.at(&cx, i);
                let target: Option[ArenaVec[Span['k], 'k]] = if instr.op.is(&cx, "call") || instr.op.is(&cx, "fn") {
                    Option::Some.(node1(&cx, instr.args.at(&cx, 0usize)))
                } else if instr.op.is(&cx, "trait_call") {
                    Option::Some.(ArenaVec::two(&cx, instr.args.at(&cx, 0usize), instr.args.at(&cx, 1usize)))
                } else if instr.op.is(&cx, "foreach") {
                    Option::Some.(node1(&cx, instr.args.at(&cx, 1usize)))
                } else {
                    Option::None
                };
                let unit = match target {
                    Some(t) => {
                        if graph.contains(&cx, t) {
                            graph.at(&cx, key).insert(&cx, t);
                            sites.push(&cx, Site.{ caller: key, callee: t, scope, instr });
                        }
                    },
                    None => (),
                };
                i = i + 1usize;
            }
            k = k + 1usize;
        }
        c = c + 1usize;
    }
    let scc = components(&cx, graph);
    var s = 0usize;
    while s < sites.len(&cx) {
        let site = sites.at(&cx, s);
        if scc.at(&cx, site.caller) == scc.at(&cx, site.callee) {
            check_site(&cx, site);
        }
        s = s + 1usize;
    }
}

forall 'k.
fn check_site(&cx: Domain!['k], site: Site['k]) {
    let instr = site.instr;
    let context = Buffer!::new().push_static("recursive specialization ").push_bytes(&cx, site.caller.join(&cx, "::")).push_static(" -> ").push_bytes(&cx, site.callee.join(&cx, "::")).save(&cx);
    var i = 0usize;
    while i < instr.tys.len(&cx) {
        let ty = instr.tys.at(&cx, i);
        let unchanged = match ty {
            Named(name, args) => args.is_empty(&cx) && site.scope.contains(&cx, name),
            _ => false,
        };
        if !unchanged && overlap(&cx, free_names(&cx, ty), site.scope) {
            kurs_error(&cx, Buffer!::new().push_bytes(&cx, context).push_static(": ").push_bytes(&cx, show(&cx, ty))
                .push_static(" must be an unchanged parameter or independent of the caller's parameters").save(&cx), instr.pos);
        }
        i = i + 1usize;
    }
    // A nominal component need not be a subterm of its source: unfolding Node[T] may yield
    // Node[(tuple T T)]. Without a separate structural descent proof, only parameter-independent
    // traversal is safe in a cycle.
    let unit = match instr.ty {
        Some(t) => match t {
            Foreach(f) => {
                if instr.op.is(&cx, "foreach") && overlap(&cx, free_names(&cx, f.source.copy(&cx)), site.scope) {
                    kurs_error(&cx, Buffer!::new().push_bytes(&cx, context).push_static(": recursive foreach requires a parameter-independent source").save(&cx), instr.pos);
                }
            },
            _ => (),
        },
        None => (),
    };
}
