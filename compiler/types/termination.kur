// SCC restrictions for instance search and function specialization.
//
// For specialization inside a recursive component, pass parameters unchanged or choose fixed
// types. Across components, arbitrary construction is finite because the SCC graph is a DAG.
// Instance matching only extracts subterms of the trait arguments. Thus each component draws from
// a finite set of incoming types, constants and subterms; memoizing specialization tuples
// exhausts that set. This is conservative: a rejected cycle need not actually grow (another edge
// might reset its arguments). Instance search instead requires structural descent on every
// recursive edge.

use package::support::base::{Cx, Map, Seq, Set, Text, fail, text, text_of};
use std::bytes::buffer::Buffer;
use package::kurs::core::{Fun, Instr, Kind, Param, Premise, Program, Type};
use package::kurs::core as C;
use package::types::formation::strict_subterm;
use package::syntax::ast::Pos;
use package::types::ops::{free_names, kurs_error, overlap, show};
use std::collections::hashmap::{Found, OwnedMap};
use std::collections::vec::{OwnedVec, Popped};
use std::option::Option;

// Tarjan's algorithm: mutually reachable nodes receive the same ID. A node is a key: (function,)
// or (trait, method). The walk's numbering, stack and active set are its own, freed when it ends;
// only the components are kept.
forall 'k.
fn components(&cx: Cx!['k], graph: Map[Seq[Text['k], 'k], Set[Seq[Text['k], 'k], 'k], 'k]) -> Map[Seq[Text['k], 'k], usize, 'k] {
    let result: Map[Seq[Text['k], 'k], usize, 'k] = Map::new(&cx);
    var walk = Tarjan.{ indices: OwnedMap::new(), low: OwnedMap::new(), stack: OwnedVec::new(), active: OwnedMap::new() };
    var i = 0usize;
    while i < graph.positions(&cx) {
        match graph.entry(&cx, i) {
            Option::Some(node) => if !&walk.numbered(&cx, node) {
                &walk.visit(&cx, graph, result, node);
            },
            Option::None => (),
        };
        i = i + 1usize;
    }
    let { indices, low, stack, active } = walk;
    indices.free();
    low.free();
    stack.free();
    active.free();
    result
}

forall 'k.
exposed struct Tarjan! {
    indices: OwnedMap![Seq[Text['k], 'k], usize],
    low: OwnedMap![Seq[Text['k], 'k], usize],
    stack: OwnedVec![Seq[Text['k], 'k]],
    active: OwnedMap![Seq[Text['k], 'k], bool],
}

fn min(a: usize, b: usize) -> usize {
    if a < b { a } else { b }
}

// The number `numbers` gives `node`, which it must have.
forall 'k.
fn number(&cx: Cx!['k], &numbers: OwnedMap![Seq[Text['k], 'k], usize], node: Seq[Text['k], 'k]) -> usize {
    match &numbers.get_in(&cx, node) {
        Found::Item(n) => n,
        Found::Missing => fail(&cx, text(&cx, "internal error: a node the walk has not numbered")),
    }
}

forall 'k.
impl Tarjan['k] {
    fn numbered(&self, &cx: Cx!['k], node: Seq[Text['k], 'k]) -> bool {
        match &self.indices.get_in(&cx, node) {
            Found::Item(n) => true,
            Found::Missing => false,
        }
    }

    fn visit(&self, &cx: Cx!['k], graph: Map[Seq[Text['k], 'k], Set[Seq[Text['k], 'k], 'k], 'k], result: Map[Seq[Text['k], 'k], usize, 'k], node: Seq[Text['k], 'k]) {
        let index = &self.indices.len();
        let fresh = &self.indices.insert_in(&cx, node, index);
        let first = &self.low.insert_in(&cx, node, index);
        self.stack = self.stack.push(node);
        let entered = &self.active.insert_in(&cx, node, true);
        let targets = graph.at(&cx, node);
        var i = 0usize;
        while i < targets.positions(&cx) {
            match targets.entry(&cx, i) {
                Option::Some(target) => {
                    if !&self.numbered(&cx, target) {
                        &self.visit(&cx, graph, result, target);
                        let lowest = min(number(&cx, &self.low, node), number(&cx, &self.low, target));
                        let old = &self.low.insert_in(&cx, node, lowest);
                    } else {
                        match &self.active.get_in(&cx, target) {
                            Found::Item(on_stack) => {
                                let lowest = min(number(&cx, &self.low, node), number(&cx, &self.indices, target));
                                let old = &self.low.insert_in(&cx, node, lowest);
                            },
                            Found::Missing => (),
                        };
                    }
                },
                Option::None => (),
            };
            i = i + 1usize;
        }
        let own = number(&cx, &self.indices, node);
        if number(&cx, &self.low, node) == own {
            var going = true;
            while going {
                match &self.stack.pop() {
                    Popped::Item(member) => {
                        let left = &self.active.remove_in(&cx, member);
                        result.set(&cx, member, own);
                        going = !member.same(&cx, node);
                    },
                    Popped::Empty => {
                        going = false;
                    },
                };
            }
        }
    }
}

forall 'k.
fn node1(&cx: Cx!['k], a: Text['k]) -> Seq[Text['k], 'k] {
    Seq::one(&cx, a)
}

forall 'k.
fn add_node(&cx: Cx!['k], graph: Map[Seq[Text['k], 'k], Set[Seq[Text['k], 'k], 'k], 'k], node: Seq[Text['k], 'k]) {
    if !graph.has(&cx, node) {
        graph.set(&cx, node, Set::new(&cx));
    }
}

// Every premise edge within a trait SCC decreases its first argument.
//
// A finite proof tree follows: each recursive component strictly decreases a finite type term,
// and edges between components follow a finite DAG. Headers are shared by surface inference and
// KURS, before either searches.
forall 'k.
fn check_instance_termination(&cx: Cx!['k], headers: Seq[(Premise['k], Seq[Premise['k], 'k], Pos), 'k]) {
    let graph: Map[Seq[Text['k], 'k], Set[Seq[Text['k], 'k], 'k], 'k] = Map::new(&cx);
    var i = 0usize;
    while i < headers.len(&cx) {
        let (head, premises, _pos) = headers.get(&cx, i);
        add_node(&cx, graph, node1(&cx, head.trait_name));
        var j = 0usize;
        while j < premises.len(&cx) {
            add_node(&cx, graph, node1(&cx, premises.get(&cx, j).trait_name));
            graph.at(&cx, node1(&cx, head.trait_name)).add(&cx, node1(&cx, premises.get(&cx, j).trait_name));
            j = j + 1usize;
        }
        i = i + 1usize;
    }
    let scc = components(&cx, graph);
    var k = 0usize;
    while k < headers.len(&cx) {
        let (head, premises, pos) = headers.get(&cx, k);
        var j = 0usize;
        while j < premises.len(&cx) {
            let premise = premises.get(&cx, j);
            if scc.at(&cx, node1(&cx, head.trait_name)) == scc.at(&cx, node1(&cx, premise.trait_name)) {
                if head.args.is_empty(&cx) || premise.args.is_empty(&cx) || !strict_subterm(&cx, premise.args.get(&cx, 0usize), head.args.get(&cx, 0usize)) {
                    kurs_error(&cx, text_of(&cx, Buffer::new().push_static("recursive instance premise ").push_bytes(&cx, head.trait_name).push_static(" -> ").push_bytes(&cx, premise.trait_name)
                        .push_static(": first argument must be a strict structural subterm of the head's first argument")), pos);
                }
            }
            j = j + 1usize;
        }
        k = k + 1usize;
    }
}

// A specialization request: the calling body, the body it requests, the caller's value
// parameters, and the instruction.
forall 'k.
exposed struct Site {
    caller: Seq[Text['k], 'k],
    callee: Seq[Text['k], 'k],
    scope: Set[Text['k], 'k],
    instr: Instr['k],
}

forall 'k.
fn join(&cx: Cx!['k], key: Seq[Text['k], 'k]) -> Text['k] {
    var out = Buffer::new();
    var i = 0usize;
    while i < key.len(&cx) {
        if i > 0usize {
            out = out.push_static("::");
        }
        out = out.push_bytes(&cx, key.get(&cx, i));
        i = i + 1usize;
    }
    text_of(&cx, out)
}

// Check every specialization request before starting the backend worklist.
//
// Trait-method nodes unite all their instance bodies. Indirect calls require no edge: their code
// was already requested at a statically named `fn` site. Lifted closures and foreach mappers are
// ordinary functions in this graph.
forall 'k.
fn check_mono_termination(&cx: Cx!['k], program: Program['k]) {
    let keys: Seq[Seq[Text['k], 'k], 'k] = Seq::new(&cx);
    let bodies: Seq[Fun['k], 'k] = Seq::new(&cx);
    let scopes: Seq[Seq[Param['k], 'k], 'k] = Seq::new(&cx);
    let funs = program.funs.values(&cx);
    var f = 0usize;
    while f < funs.len(&cx) {
        keys.push(&cx, node1(&cx, funs.get(&cx, f).name));
        bodies.push(&cx, funs.get(&cx, f));
        scopes.push(&cx, funs.get(&cx, f).params);
        f = f + 1usize;
    }
    let groups = program.instances.values(&cx);
    var g = 0usize;
    while g < groups.len(&cx) {
        let instances = groups.get(&cx, g);
        var n = 0usize;
        while n < instances.len(&cx) {
            let inst = instances.get(&cx, n);
            var m = 0usize;
            while m < inst.methods.len(&cx) {
                let fun = inst.methods.get(&cx, m);
                keys.push(&cx, Seq::two(&cx, inst.trait_name, fun.name));
                bodies.push(&cx, fun);
                let params = inst.params.copy(&cx);
                params.append(&cx, fun.params);
                scopes.push(&cx, params);
                m = m + 1usize;
            }
            n = n + 1usize;
        }
        g = g + 1usize;
    }
    let graph: Map[Seq[Text['k], 'k], Set[Seq[Text['k], 'k], 'k], 'k] = Map::new(&cx);
    var b = 0usize;
    while b < keys.len(&cx) {
        graph.set(&cx, keys.get(&cx, b), Set::new(&cx));
        b = b + 1usize;
    }
    let sites: Seq[Site['k], 'k] = Seq::new(&cx);
    var c = 0usize;
    while c < keys.len(&cx) {
        let key = keys.get(&cx, c);
        let fun = bodies.get(&cx, c);
        // Brands have no type constructors and cannot grow.
        let scope: Set[Text['k], 'k] = Set::new(&cx);
        let params = scopes.get(&cx, c);
        var p = 0usize;
        while p < params.len(&cx) {
            if !C::same_kind(params.get(&cx, p).kind, Kind::Brand) {
                scope.add(&cx, params.get(&cx, p).name);
            }
            p = p + 1usize;
        }
        var k = 0usize;
        while k < fun.blocks.len(&cx) {
            let instrs = fun.blocks.get(&cx, k).instrs;
            var i = 0usize;
            while i < instrs.len(&cx) {
                let instr = instrs.get(&cx, i);
                let target: Option[Seq[Text['k], 'k]] = if instr.op.is(&cx, "call") || instr.op.is(&cx, "fn") {
                    Option::Some.(node1(&cx, instr.args.get(&cx, 0usize)))
                } else if instr.op.is(&cx, "trait_call") {
                    Option::Some.(Seq::two(&cx, instr.args.get(&cx, 0usize), instr.args.get(&cx, 1usize)))
                } else if instr.op.is(&cx, "foreach") {
                    Option::Some.(node1(&cx, instr.args.get(&cx, 1usize)))
                } else {
                    Option::None
                };
                let unit = match target {
                    Option::Some(t) => {
                        if graph.has(&cx, t) {
                            graph.at(&cx, key).add(&cx, t);
                            sites.push(&cx, Site.{ caller: key, callee: t, scope, instr });
                        }
                    },
                    Option::None => (),
                };
                i = i + 1usize;
            }
            k = k + 1usize;
        }
        c = c + 1usize;
    }
    let scc = components(&cx, graph);
    var s = 0usize;
    while s < sites.len(&cx) {
        let site = sites.get(&cx, s);
        if scc.at(&cx, site.caller) == scc.at(&cx, site.callee) {
            check_site(&cx, site);
        }
        s = s + 1usize;
    }
}

forall 'k.
fn check_site(&cx: Cx!['k], site: Site['k]) {
    let instr = site.instr;
    let context = text_of(&cx, Buffer::new().push_static("recursive specialization ").push_bytes(&cx, join(&cx, site.caller)).push_static(" -> ").push_bytes(&cx, join(&cx, site.callee)));
    var i = 0usize;
    while i < instr.tys.len(&cx) {
        let ty = instr.tys.get(&cx, i);
        let unchanged = match ty {
            Type::Named(name, args) => args.is_empty(&cx) && site.scope.has(&cx, name),
            _ => false,
        };
        if !unchanged && overlap(&cx, free_names(&cx, ty), site.scope) {
            kurs_error(&cx, text_of(&cx, Buffer::new().push_bytes(&cx, context).push_static(": ").push_bytes(&cx, show(&cx, ty))
                .push_static(" must be an unchanged parameter or independent of the caller's parameters")), instr.pos);
        }
        i = i + 1usize;
    }
    // A nominal component need not be a subterm of its source: unfolding Node[T] may yield
    // Node[(tuple T T)]. Without a separate structural descent proof, only parameter-independent
    // traversal is safe in a cycle.
    let unit = match instr.ty {
        Option::Some(t) => match t {
            Type::Foreach(f) => {
                if instr.op.is(&cx, "foreach") && overlap(&cx, free_names(&cx, f.source.get(&cx)), site.scope) {
                    kurs_error(&cx, text_of(&cx, Buffer::new().push_bytes(&cx, context).push_static(": recursive foreach requires a parameter-independent source")), instr.pos);
                }
            },
            _ => (),
        },
        Option::None => (),
    };
}
