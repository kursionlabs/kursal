// Finite type expansion, productive C aliases, and finite by-value layouts.
//
// First, recursive nominal applications pass parameters unchanged or choose fixed types. Then
// symbolic unfolding checks aliases and stored values. Pointer and function representations break
// storage cycles; aggregate names break C alias cycles. A foreach whose source has known
// components unfolds to its expansion, like a name, and its source is walked; one whose source a
// type parameter decides is opaque, and the walk covers its source and, for the pointer pattern, the
// origin of its rows, the pointee of the pointer source. Last, a C representation key, which expands every
// foreach, must reach a name before the same foreach again. No concrete specialization budget is
// needed.

use std::collections::arena_vec::ArenaVec;
use std::collections::arena_map::{ArenaMap, ArenaSet};
use std::mem::Ref;
use std::raw::Span;
use std::arena::{Domain!, ref_in};
use std::buffer::Buffer!;
use std::fmt::Writer;
use package::kurs::core::{ForeachType, Kind, Member, Program, Type};
use package::kurs::core as C;
use package::syntax::ast::{Pos, no_pos};
use package::types::termination::components;
use package::types::ops::{Fresh, Row, Rows, children, equal, free_brands, free_names, is_ptr, kurs_error_in, member_types, overlap, subst, with_names, wrap};
use std::option::{Option, Result};
use std::slice::Slice;

// A `*F` pattern binds its binder to the pointee of each component. Where a type parameter decides
// the source's shape only an explicit pointer source has pointer components at every instantiation.
const STUCK_POINTER_PATTERN: Slice[u8, 'static] = "needs a source written as a pointer *P, as a type parameter decides its shape";

// What the rows of a foreach source are: decided, decided by the type parameter given (the foreach
// is stuck), or unknown (formation reports an unknown name or a pattern that does not fit).
forall 'k.
enum SourceRows {
    Decided(Rows['k]),
    Stuck(Type['k]),
    Unknown,
}

// A nominal application found while collecting: its owner declaration, the application, and the
// owner's parameters and the names derived from them in scope there.
forall 'k.
exposed struct ExpansionSite {
    owner: Span['k],
    name: Span['k],
    args: ArenaVec[Type['k], 'k],
    params: ArenaSet[Span['k], 'k],
    derived: ArenaSet[Span['k], 'k],
}

forall 'k.
exposed struct Expansion {
    program: Program['k],
    counter: Fresh['k],
    graph: ArenaMap[ArenaVec[Span['k], 'k], ArenaSet[ArenaVec[Span['k], 'k], 'k], 'k],
    sites: ArenaVec[ExpansionSite['k], 'k],
    places: ArenaMap[Span['k], (Span['k], Pos), 'k],
    // The keys `walk` has unfolded to the end without an error, by value and as aliases. Nothing
    // reachable from one of them reaches it again, so walking it again would find nothing.
    walked: ArenaSet[Type['k], 'k],
    aliased: ArenaSet[Type['k], 'k],
}

forall 'k.
fn without(&cx: Domain!['k], names: ArenaSet[Span['k], 'k], removed: ArenaSet[Span['k], 'k]) -> ArenaSet[Span['k], 'k] {
    let out: ArenaSet[Span['k], 'k] = ArenaSet::new(&cx);
    let items = names.keys(&cx);
    var i = 0usize;
    while i < items.len(&cx) {
        if !removed.contains(&cx, items.at(&cx, i)) {
            out.insert(&cx, items.at(&cx, i));
        }
        i = i + 1usize;
    }
    out
}

forall 'k.
fn with_type(&cx: Domain!['k], active: ArenaVec[Type['k], 'k], t: Type['k]) -> ArenaVec[Type['k], 'k] {
    let out = active.clone(&cx);
    out.push(&cx, t);
    out
}

forall 'k.
fn any_equal(&cx: Domain!['k], t: Type['k], active: ArenaVec[Type['k], 'k]) -> bool {
    var found = false;
    var i = 0usize;
    while !found && i < active.len(&cx) {
        found = equal(&cx, t, active.at(&cx, i));
        i = i + 1usize;
    }
    found
}

forall 'k.
impl Expansion['k] {
    fn collect(self, &cx: Domain!['k], owner: Span['k], ty: Type['k], bound: ArenaSet[Span['k], 'k], params: ArenaSet[Span['k], 'k], derived: ArenaSet[Span['k], 'k]) {
        match ty {
            Named(name, args) => {
                if !bound.contains(&cx, name) && self.program.types.contains(&cx, name) {
                    self.graph.at(&cx, ArenaVec::one(&cx, owner)).insert(&cx, ArenaVec::one(&cx, name));
                    self.sites.push(&cx, ExpansionSite.{ owner, name, args, params, derived });
                }
                var i = 0usize;
                while i < args.len(&cx) {
                    self.collect(&cx, owner, args.at(&cx, i), bound, params, derived);
                    i = i + 1usize;
                }
            },
            Foreach(f) => {
                self.collect(&cx, owner, f.source.copy(&cx), bound, params, derived);
                let binders = with_names(&cx, ArenaSet::new(&cx), ArenaVec::one(&cx, f.binder));
                let tainted = if overlap(&cx, free_names(&cx, f.source.copy(&cx)), params.union(&cx, derived)) { binders } else { ArenaSet::new(&cx) };
                self.collect(&cx, owner, f.body.copy(&cx), bound.union(&cx, binders), without(&cx, params, binders), without(&cx, derived, binders).union(&cx, tainted));
            },
            _ => {
                let parts = children(&cx, ty);
                var i = 0usize;
                while i < parts.len(&cx) {
                    self.collect(&cx, owner, parts.at(&cx, i), bound, params, derived);
                    i = i + 1usize;
                }
            },
        }
    }

    fn unfold(self, &cx: Domain!['k], name: Span['k], args: ArenaVec[Type['k], 'k], bound: ArenaSet[Span['k], 'k]) -> Option[Type['k]] {
        if bound.contains(&cx, name) || !self.program.types.contains(&cx, name) {
            // Formation reports unknown names and arities separately.
            return Option::None;
        }
        let decl = self.program.types.at(&cx, name);
        let sub: ArenaMap[Span['k], Type['k], 'k] = ArenaMap::new(&cx);
        var i = 0usize;
        while i < decl.params.len(&cx) && i < args.len(&cx) {
            sub.insert(&cx, decl.params.at(&cx, i).name, args.at(&cx, i));
            i = i + 1usize;
        }
        Option::Some.(subst(&cx, decl.body, sub, self.counter))
    }

    // Brand identity cannot affect size or C representation. Equality also ignores alpha-renaming
    // of binders introduced by subst.
    fn key(self, &cx: Domain!['k], ty: Type['k]) -> Type['k] {
        let sub: ArenaMap[Span['k], Type['k], 'k] = ArenaMap::new(&cx);
        let brands = free_brands(&cx, ty).keys(&cx);
        var b = 0usize;
        while b < brands.len(&cx) {
            sub.insert(&cx, brands.at(&cx, b), Type::Skolem.(Span::from_static(&cx, "_")));
            b = b + 1usize;
        }
        subst(&cx, ty, sub, self.counter)
    }

    // Stops with `message`, at the declaration named `owner` when `places` has it.
    fn fail(self, &cx: Domain!['k], owner: Span['k], message: Span['k]) -> ! {
        let (file, pos) = self.places.get_or(&cx, owner, (Span::from_static(&cx, ""), no_pos()));
        kurs_error_in(&cx, message, file, pos)
    }

    // Demand just the outer shape needed by foreach rows (one pointer layer, which only the pointer
    // pattern looks through).
    fn shape(self, &cx: Domain!['k], ty: Type['k], active: ArenaVec[Type['k], 'k], bound: ArenaSet[Span['k], 'k], pointer: bool) -> Result[(), Span['k]] {
        match ty {
            Named(name, args) => match self.unfold(&cx, name, args, bound) {
                Some(found) => {
                    let current = self.key(&cx, ty);
                    if any_equal(&cx, current, active) {
                        return Result::Err.(f"recursive foreach source shape through {name}".write(&cx, Buffer!::new()).save(&cx));
                    }
                    self.shape(&cx, found, with_type(&cx, active, current), bound, pointer)
                },
                None => Result::Ok.(()),
            },
            Foreach(f) => self.shape(&cx, f.source.copy(&cx), active, bound, f.indirect),
            Ptr(inner) => if pointer { self.shape(&cx, inner.copy(&cx), active, bound, false) } else { Result::Ok.(()) },
            _ => Result::Ok.(()),
        }
    }

    // The components of a foreach source, as `Types::rows` and `Types::expand` find them, following
    // only what `shape` has demanded of it.

    // The outer shape of `ty`: a structural type, or the parameter of `bound` that decides it; none
    // for an unknown name or a pattern that does not fit its components (formation reports those).
    fn outer(self, &cx: Domain!['k], ty: Type['k], bound: ArenaSet[Span['k], 'k]) -> Option[Type['k]] {
        match ty {
            Named(name, args) => {
                if bound.contains(&cx, name) {
                    return Option::Some.(ty);
                }
                match self.unfold(&cx, name, args, bound) {
                    Some(next) => self.outer(&cx, next, bound),
                    None => Option::None,
                }
            },
            Foreach(f) => match self.rows(&cx, f.source.copy(&cx), f.indirect, bound) {
                Decided(rows) => self.expand(&cx, f, rows),
                Stuck(param) => Option::Some.(param),
                Unknown => Option::None,
            },
            _ => Option::Some.(ty),
        }
    }

    // The skeleton and rows of `source` under the pattern `indirect` (`*F`) or not, or the parameter
    // that decides them (the foreach is stuck). Only `*F` looks through a pointer source; under the
    // value pattern it is a leaf.
    fn rows(self, &cx: Domain!['k], source: Type['k], indirect: bool, bound: ArenaSet[Span['k], 'k]) -> SourceRows['k] {
        var shape = match self.outer(&cx, source, bound) {
            Some(shape) => shape,
            None => return SourceRows::Unknown,
        };
        var pointer = false;
        let unit = match shape {
            Ptr(inner) => {
                if indirect {
                    shape = match self.outer(&cx, inner.copy(&cx), bound) {
                        Some(pointee) => pointee,
                        None => return SourceRows::Unknown,
                    };
                    pointer = true;
                }
            },
            _ => (),
        };
        let rows: ArenaVec[Row['k], 'k] = ArenaVec::new(&cx);
        match shape {
            Named(_name, _args) => SourceRows::Stuck.(shape),
            Struct(fields) => {
                var i = 0usize;
                while i < fields.len(&cx) {
                    rows.push(&cx, Row.{ label: fields.at(&cx, i).name, item: wrap(&cx, fields.at(&cx, i).ty, pointer) });
                    i = i + 1usize;
                }
                SourceRows::Decided.(Rows.{ skeleton: Option::Some.(shape), rows })
            },
            Tuple(elems) => {
                var i = 0usize;
                while i < elems.len(&cx) {
                    rows.push(&cx, Row.{ label: Buffer!::new().put(i).save(&cx), item: wrap(&cx, elems.at(&cx, i), pointer) });
                    i = i + 1usize;
                }
                SourceRows::Decided.(Rows.{ skeleton: Option::Some.(shape), rows })
            },
            Array(elem, _length) => {
                rows.push(&cx, Row.{ label: Span::from_static(&cx, "0"), item: wrap(&cx, elem.copy(&cx), pointer) });
                SourceRows::Decided.(Rows.{ skeleton: Option::Some.(shape), rows })
            },
            Enum(variants) => {
                var i = 0usize;
                while i < variants.len(&cx) {
                    rows.push(&cx, Row.{ label: variants.at(&cx, i).name, item: wrap(&cx, variants.at(&cx, i).ty, pointer) });
                    i = i + 1usize;
                }
                SourceRows::Decided.(Rows.{ skeleton: Option::Some.(shape), rows })
            },
            _ => {
                rows.push(&cx, Row.{ label: Span::from_static(&cx, "0"), item: source });
                SourceRows::Decided.(Rows.{ skeleton: Option::None, rows })
            },
        }
    }

    // The expansion of `ty` over `found`, or none when its pattern does not fit a row.
    fn expand(self, &cx: Domain!['k], ty: ForeachType['k], found: Rows['k]) -> Option[Type['k]] {
        let mapped: ArenaVec[Member['k], 'k] = ArenaVec::new(&cx);
        var i = 0usize;
        while i < found.rows.len(&cx) {
            let row = found.rows.at(&cx, i);
            let bind = if ty.indirect {
                match row.item {
                    Ptr(inner) => inner.copy(&cx),
                    _ => return Option::None,
                }
            } else {
                row.item
            };
            let sub: ArenaMap[Span['k], Type['k], 'k] = ArenaMap::new(&cx);
            sub.insert(&cx, ty.binder, bind);
            mapped.push(&cx, Member.{ name: row.label, ty: subst(&cx, ty.body.copy(&cx), sub, self.counter) });
            i = i + 1usize;
        }
        Option::Some.(match found.skeleton {
            Some(skeleton) => match skeleton {
                Struct(_f) => Type::Struct.(mapped),
                Enum(_v) => Type::Enum.(mapped),
                Array(_e, length) => Type::Array.(ref_in(&cx, mapped.at(&cx, 0usize).ty), length),
                _ => Type::Tuple.(member_types(&cx, mapped)),
            },
            None => Type::Tuple.(member_types(&cx, mapped)),
        })
    }

    // The pointee of a pointer source, whose components the rows of the pointer pattern point to.
    fn origin(self, &cx: Domain!['k], source: Type['k], bound: ArenaSet[Span['k], 'k]) -> Option[Type['k]] {
        match source {
            Named(name, args) => match self.unfold(&cx, name, args, bound) {
                Some(found) => self.origin(&cx, found, bound),
                None => Option::None,
            },
            Ptr(inner) => Option::Some.(inner.copy(&cx)),
            _ => Option::None,
        }
    }

    // Whether `bound` leaves every declared type name meaning the declaration, so that a key walks
    // the same way under it as under any other such set.
    fn plain(self, &cx: Domain!['k], bound: ArenaSet[Span['k], 'k]) -> bool {
        var i = 0usize;
        while i < bound.positions(&cx) {
            let unit = match bound.key_at(&cx, i) {
                Some(name) => {
                    if self.program.types.contains(&cx, name) {
                        return false;
                    }
                },
                None => (),
            };
            i = i + 1usize;
        }
        true
    }

    // The by-value walk of `ty` in the declaration `owner`, or in a type written elsewhere when `owner`
    // is empty: the message of what it finds wrong, if anything.
    fn walk(self, &cx: Domain!['k], owner: Span['k], ty: Type['k], active: ArenaVec[Type['k], 'k], bound: ArenaSet[Span['k], 'k], aliases: bool) -> Result[(), Span['k]] {
        match ty {
            Named(name, args) => match self.unfold(&cx, name, args, bound) {
                Some(found) => {
                    let current = self.key(&cx, ty);
                    if any_equal(&cx, current, active) {
                        let reason = if aliases { Span::from_static(&cx, "recursive alias needs an aggregate boundary") } else { Span::from_static(&cx, "infinite by-value layout") };
                        return Result::Err.(f"type {name}: {reason}".write(&cx, Buffer!::new()).save(&cx));
                    }
                    let done = if aliases { self.aliased } else { self.walked };
                    let plain = self.plain(&cx, bound);
                    if !(plain && done.contains(&cx, current)) {
                        self.walk(&cx, owner, found, with_type(&cx, active, current), bound, aliases)?;
                        if plain {
                            done.insert(&cx, current);
                        }
                    }
                    Result::Ok.(())
                },
                None => Result::Ok.(()),
            },
            Foreach(f) => {
                self.shape(&cx, f.source.copy(&cx), ArenaVec::new(&cx), bound, f.indirect)?;
                if aliases {
                    // Every foreach result has an aggregate representation.
                    return Result::Ok.(());
                }
                self.walk(&cx, owner, f.source.copy(&cx), active, bound, aliases)?;
                let expanded = match self.rows(&cx, f.source.copy(&cx), f.indirect, bound) {
                    Decided(rows) => self.expand(&cx, f, rows),
                    Stuck(_param) => {
                        if f.indirect {
                            // What the binder is bound to at an instantiation is a component of the
                            // pointee, the origin of the rows, which only an explicit pointer source
                            // gives at every instantiation.
                            if !is_ptr(f.source.copy(&cx)) {
                                let message = Buffer!::new().put("foreach *").write(&cx, f.binder).put(" ").put(STUCK_POINTER_PATTERN);
                                return Result::Err.((if owner.is_empty() { message } else { message.put(" in type ").write(&cx, owner) }).save(&cx));
                            }
                            match self.origin(&cx, f.source.copy(&cx), bound) {
                                Some(origin) => self.walk(&cx, owner, origin, active, bound, aliases)?,
                                None => (),
                            }
                        }
                        Option::None
                    },
                    Unknown => Option::None,
                };
                match expanded {
                    Some(expanded) => {
                        // A component may hold this foreach again by value, unfolding no name on
                        // the way: it is active like a name.
                        let current = self.key(&cx, ty);
                        if any_equal(&cx, current, active) {
                            let message = if owner.is_empty() { Buffer!::new() } else { Buffer!::new().put("type ").write(&cx, owner).put(": ") };
                            return Result::Err.(message.put("infinite by-value layout").save(&cx));
                        }
                        self.walk(&cx, owner, expanded, with_type(&cx, active, current), bound, aliases)
                    },
                    // Opaque here; its rows are those of the source and origin walked above at
                    // each instantiation.
                    None => self.walk(&cx, owner, f.body.copy(&cx), active, with_names(&cx, bound, ArenaVec::one(&cx, f.binder)), aliases),
                }
            },
            Brand(_b) => Result::Ok.(()),
            Ptr(_i) => if !aliases { Result::Ok.(()) } else { self.walk_children(&cx, owner, ty, active, bound, aliases) },
            NonNull(_i) => if !aliases { Result::Ok.(()) } else { self.walk_children(&cx, owner, ty, active, bound, aliases) },
            Fn(_f) => if !aliases { Result::Ok.(()) } else { self.walk_children(&cx, owner, ty, active, bound, aliases) },
            Tuple(_e) => if aliases { Result::Ok.(()) } else { self.walk_children(&cx, owner, ty, active, bound, aliases) },
            Struct(_f) => if aliases { Result::Ok.(()) } else { self.walk_children(&cx, owner, ty, active, bound, aliases) },
            Enum(_v) => if aliases { Result::Ok.(()) } else { self.walk_children(&cx, owner, ty, active, bound, aliases) },
            Array(_e, _length) => if aliases { Result::Ok.(()) } else { self.walk_children(&cx, owner, ty, active, bound, aliases) },
            _ => self.walk_children(&cx, owner, ty, active, bound, aliases),
        }
    }

    fn walk_children(self, &cx: Domain!['k], owner: Span['k], ty: Type['k], active: ArenaVec[Type['k], 'k], bound: ArenaSet[Span['k], 'k], aliases: bool) -> Result[(), Span['k]] {
        let parts = children(&cx, ty);
        var i = 0usize;
        while i < parts.len(&cx) {
            self.walk(&cx, owner, parts.at(&cx, i), active, bound, aliases)?;
            i = i + 1usize;
        }
        Result::Ok.(())
    }

    // The C representation key (`backend::cgen::erase`) keeps names and expands every foreach,
    // behind pointers and functions too: a foreach whose expansion reaches it again before a name
    // has none (`struct T { f: fn(foreach *F of *T => *F) -> u32 }`).
    fn represent(self, &cx: Domain!['k], owner: Span['k], ty: Type['k], active: ArenaVec[Type['k], 'k], bound: ArenaSet[Span['k], 'k]) -> Result[(), Span['k]] {
        match ty {
            Foreach(f) => {
                self.shape(&cx, f.source.copy(&cx), ArenaVec::new(&cx), bound, f.indirect)?;
                let expanded = match self.rows(&cx, f.source.copy(&cx), f.indirect, bound) {
                    Decided(rows) => self.expand(&cx, f, rows),
                    _ => Option::None,
                };
                match expanded {
                    Some(expanded) => {
                        let current = self.key(&cx, ty);
                        if any_equal(&cx, current, active) {
                            return Result::Err.(f"type {owner}: recursive foreach needs a named type between".write(&cx, Buffer!::new()).save(&cx));
                        }
                        self.represent(&cx, owner, expanded, with_type(&cx, active, current), bound)
                    },
                    None => self.represent(&cx, owner, f.body.copy(&cx), active, with_names(&cx, bound, ArenaVec::one(&cx, f.binder))),
                }
            },
            _ => {
                let parts = children(&cx, ty);
                var i = 0usize;
                while i < parts.len(&cx) {
                    self.represent(&cx, owner, parts.at(&cx, i), active, bound)?;
                    i = i + 1usize;
                }
                Result::Ok.(())
            },
        }
    }
}

// The by-value walk of a type written outside a declaration, with the names of `bound` leaves: a
// use is walked as a declaration is, where it is written. The message of what it finds wrong, if
// anything.
forall 'k.
fn check_written_type(&cx: Domain!['k], program: Program['k], counter: Fresh['k], ty: Type['k], bound: ArenaSet[Span['k], 'k]) -> Result[(), Span['k]] {
    let state = Expansion.{ program, counter, graph: ArenaMap::new(&cx), sites: ArenaVec::new(&cx), places: ArenaMap::new(&cx), walked: ArenaSet::new(&cx), aliased: ArenaSet::new(&cx) };
    state.walk(&cx, Span::from_static(&cx, ""), ty, ArenaVec::new(&cx), bound, false)
}

// `places` names the file and position of a declaration, by its name, when it has them.
forall 'k.
fn check_type_expansion(&cx: Domain!['k], program: Program['k], counter: Fresh['k], places: ArenaMap[Span['k], (Span['k], Pos), 'k]) {
    let graph: ArenaMap[ArenaVec[Span['k], 'k], ArenaSet[ArenaVec[Span['k], 'k], 'k], 'k] = ArenaMap::new(&cx);
    let names = program.types.keys(&cx);
    var n = 0usize;
    while n < names.len(&cx) {
        graph.insert(&cx, ArenaVec::one(&cx, names.at(&cx, n)), ArenaSet::new(&cx));
        n = n + 1usize;
    }
    let state = Expansion.{ program, counter, graph, sites: ArenaVec::new(&cx), places, walked: ArenaSet::new(&cx), aliased: ArenaSet::new(&cx) };
    let decls = program.types.values(&cx);
    var d = 0usize;
    while d < decls.len(&cx) {
        let decl = decls.at(&cx, d);
        let params: ArenaSet[Span['k], 'k] = ArenaSet::new(&cx);
        var p = 0usize;
        while p < decl.params.len(&cx) {
            if !C::same_kind(decl.params.at(&cx, p).kind, Kind::Brand) {
                params.insert(&cx, decl.params.at(&cx, p).name);
            }
            p = p + 1usize;
        }
        state.collect(&cx, decl.name, decl.body, params, params, ArenaSet::new(&cx));
        d = d + 1usize;
    }
    let scc = components(&cx, graph);
    var s = 0usize;
    while s < state.sites.len(&cx) {
        let site = state.sites.at(&cx, s);
        if scc.at(&cx, ArenaVec::one(&cx, site.owner)) == scc.at(&cx, ArenaVec::one(&cx, site.name)) {
            var a = 0usize;
            while a < site.args.len(&cx) {
                let arg = site.args.at(&cx, a);
                let names = free_names(&cx, arg);
                let bare = match arg {
                    Named(name, args) => args.is_empty(&cx) && site.params.contains(&cx, name),
                    _ => false,
                };
                if overlap(&cx, names, site.derived) || (overlap(&cx, names, site.params) && !bare) {
                    state.fail(&cx, site.owner, f"recursive type expansion {site.owner} -> {site.name}: arguments must be unchanged parameters or independent of them; foreach components of parameter-dependent sources may grow".write(&cx, Buffer!::new()).save(&cx));
                }
                a = a + 1usize;
            }
        }
        s = s + 1usize;
    }
    var r = 0usize;
    while r < decls.len(&cx) {
        let decl = decls.at(&cx, r);
        let bound: ArenaSet[Span['k], 'k] = ArenaSet::new(&cx);
        let root_args: ArenaVec[Type['k], 'k] = ArenaVec::new(&cx);
        var p = 0usize;
        while p < decl.params.len(&cx) {
            let param = decl.params.at(&cx, p);
            bound.insert(&cx, param.name);
            root_args.push(&cx, if C::same_kind(param.kind, Kind::Brand) { Type::Skolem.(param.name) } else { C::named(param.name, ArenaVec::new(&cx)) });
            p = p + 1usize;
        }
        let root = state.key(&cx, C::named(decl.name, root_args));
        // Every declaration is walked, one whose body is a foreach or holds one like any other.
        let walked = match state.walk(&cx, decl.name, decl.body, ArenaVec::one(&cx, root), bound, false) {
            Ok(_u) => match state.walk(&cx, decl.name, decl.body, ArenaVec::one(&cx, root), bound, true) {
                Ok(_v) => state.represent(&cx, decl.name, decl.body, ArenaVec::new(&cx), bound),
                Err(message) => Result::Err.(message),
            },
            Err(message) => Result::Err.(message),
        };
        match walked {
            Ok(_u) => (),
            Err(message) => state.fail(&cx, decl.name, message),
        }
        r = r + 1usize;
    }
}
