// At most one instance head matches any fully specified trait application.
//
// Compare full heads, including output parameters. Premises and Copy constraints cannot establish
// disjointness. Each side gets fresh metavariables so coincident parameter names never identify
// the two instances' scopes. Every quantified parameter needs a binder-free occurrence in its
// full head.
//
// Surface inference checks its instances here as KURS does; with `in_surface` set, a message
// writes types and brands as a message about source does (`types::ops::Surface`), not as KURS
// does.
//
// The test over-approximates: every subterm that binds names (a package, a transform, a
// quantified function type) is compared as a wildcard. Two heads that differ only under binders
// count as overlapping, so no overlap can hide in how binders are compared.

use std::collections::arena_vec::ArenaVec;
use std::collections::arena_map::{ArenaMap, ArenaSet};
use std::raw::Span;
use std::arena::Domain!;
use std::buffer::Buffer!;
use package::kurs::core::{Kind, Meta, MetaKind, Param, Premise, Type};
use package::kurs::core as C;
use package::syntax::ast::Pos;
use package::types::ops::{Fresh, Surface, extractable_names, file_of, kurs_error_in, map_children, show, subst, surface};
use package::types::unify::{instantiate, unify};
use std::option::Option;

forall 'k.
fn binders_as_wildcards(&cx: Domain!['k], ty: Type['k]) -> Type['k] {
    match ty {
        Type::Exists(_binders, _body) => Type::Meta.(Meta::new(&cx, MetaKind::Type)),
        Type::Foreach(_f) => Type::Meta.(Meta::new(&cx, MetaKind::Type)),
        Type::Fn(f) => {
            if f.quantified.is_empty(&cx) {
                map_children(&cx, ty, |&cx, child: Type['k]| binders_as_wildcards(&cx, child))
            } else {
                Type::Meta.(Meta::new(&cx, MetaKind::Type))
            }
        },
        _ => map_children(&cx, ty, |&cx, child: Type['k]| binders_as_wildcards(&cx, child)),
    }
}

// Every quantified parameter is extractable without crossing a binder. An error is in `file`, unless
// it is empty.
forall 'k.
fn check_instance_range(&cx: Domain!['k], head: Premise['k], params: ArenaVec[Param['k], 'k], file: Span['k], pos: Pos, in_surface: bool) {
    let used: ArenaSet[Span['k], 'k] = ArenaSet::new(&cx);
    var i = 0usize;
    while i < head.args.len(&cx) {
        used.insert_all(&cx, extractable_names(&cx, head.args.at(&cx, i)).keys(&cx));
        i = i + 1usize;
    }
    var j = 0usize;
    while j < params.len(&cx) {
        let param = params.at(&cx, j);
        if !used.contains(&cx, param.name) {
            let name = if !C::same_kind(param.kind, Kind::Brand) {
                param.name
            } else {
                Buffer!::new().push_static(if in_surface { "'" } else { "$" }).push_bytes(&cx, param.name).save(&cx)
            };
            let trait_name = if in_surface {
                surface(&cx, ArenaVec::new(&cx), ArenaVec::one(&cx, head.trait_name), ArenaMap::new(&cx)).name(&cx, head.trait_name)
            } else {
                head.trait_name
            };
            kurs_error_in(&cx, Buffer!::new().push_static("instance of ").push_bytes(&cx, trait_name).push_static(": parameter ").push_bytes(&cx, name)
                .push_static(" needs a binder-free head occurrence").save(&cx), file, pos);
        }
        j = j + 1usize;
    }
}

forall 'k.
fn show_args(&cx: Domain!['k], args: ArenaVec[Type['k], 'k], spelling: Option[Surface['k]]) -> Span['k] {
    var out = Buffer!::new();
    var i = 0usize;
    while i < args.len(&cx) {
        if i > 0usize {
            out = out.push_static(", ");
        }
        out = out.push_bytes(&cx, match spelling {
            Option::Some(s) => s.show(&cx, args.at(&cx, i)),
            Option::None => show(&cx, args.at(&cx, i)),
        });
        i = i + 1usize;
    }
    out.save(&cx)
}

forall 'k.
fn wildcards(&cx: Domain!['k], args: ArenaVec[Type['k], 'k], sub: ArenaMap[Span['k], Type['k], 'k], counter: Fresh['k]) -> ArenaVec[Type['k], 'k] {
    let out: ArenaVec[Type['k], 'k] = ArenaVec::new(&cx);
    var i = 0usize;
    while i < args.len(&cx) {
        out.push(&cx, binders_as_wildcards(&cx, subst(&cx, args.at(&cx, i), sub, counter)));
        i = i + 1usize;
    }
    out
}

// `files` names the file of each header, when it has one.
forall 'k.
fn check_coherence(&cx: Domain!['k], headers: ArenaVec[(Premise['k], ArenaVec[Param['k], 'k], Pos), 'k], counter: Fresh['k], files: ArenaVec[Span['k], 'k], in_surface: bool) {
    let seen: ArenaMap[Span['k], ArenaVec[(Premise['k], ArenaVec[Param['k], 'k]), 'k], 'k] = ArenaMap::new(&cx);
    var h = 0usize;
    while h < headers.len(&cx) {
        let (head, params, pos) = headers.at(&cx, h);
        check_instance_range(&cx, head, params, file_of(&cx, files, h), pos, in_surface);
        let earlier_heads = seen.get_or(&cx, head.trait_name, ArenaVec::new(&cx));
        var e = 0usize;
        while e < earlier_heads.len(&cx) {
            let (earlier, earlier_params) = earlier_heads.at(&cx, e);
            // Freshen for every comparison: failed unification can leave some variables solved,
            // so its substitutions must not reach another pair.
            let left = instantiate(&cx, params);
            let right = instantiate(&cx, earlier_params);
            let xs = wildcards(&cx, head.args, left, counter);
            let ys = wildcards(&cx, earlier.args, right, counter);
            var overlapping = xs.len(&cx) == ys.len(&cx);
            var i = 0usize;
            while overlapping && i < xs.len(&cx) {
                overlapping = unify(&cx, xs.at(&cx, i), ys.at(&cx, i), true, counter);
                i = i + 1usize;
            }
            if overlapping {
                let spelling = if in_surface {
                    Option::Some.(surface(&cx, head.args.concat(&cx, earlier.args), ArenaVec::one(&cx, head.trait_name), ArenaMap::new(&cx)))
                } else {
                    Option::None
                };
                let trait_name = match spelling {
                    Option::Some(s) => s.name(&cx, head.trait_name),
                    Option::None => head.trait_name,
                };
                kurs_error_in(&cx, Buffer!::new().push_static("overlapping instances of ").push_bytes(&cx, trait_name).push_static(": (")
                    .push_bytes(&cx, show_args(&cx, head.args, spelling)).push_static(") and (").push_bytes(&cx, show_args(&cx, earlier.args, spelling)).push_static(")").save(&cx),
                    file_of(&cx, files, h), pos);
            }
            e = e + 1usize;
        }
        if !seen.contains(&cx, head.trait_name) {
            seen.insert(&cx, head.trait_name, ArenaVec::new(&cx));
        }
        seen.at(&cx, head.trait_name).push(&cx, (head, params));
        h = h + 1usize;
    }
}
