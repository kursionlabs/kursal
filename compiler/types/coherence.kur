// At most one instance head matches any fully specified trait application.
//
// Compare full heads, including output parameters. Premises and Copy constraints cannot establish
// disjointness. Each side gets fresh metavariables so coincident parameter names never identify
// the two instances' scopes. Every quantified parameter needs a binder-free occurrence in its
// full head.
//
// The test over-approximates: every subterm that binds names (a package, a transform, a
// quantified function type) is compared as a wildcard. Two heads that differ only under binders
// count as overlapping, so no overlap can hide in how binders are compared.

use package::support::base::{Cx, Map, Seq, Set, Text, text_of};
use std::bytes::buffer::Buffer;
use package::kurs::core::{Kind, Meta, MetaKind, Param, Premise, Type};
use package::kurs::core as C;
use package::syntax::ast::Pos;
use package::types::ops::{Fresh, add_all, extractable_names, kurs_error, map_children, show, subst};
use package::types::unify::{instantiate, unify};
use std::option::Option;

forall 'k.
fn binders_as_wildcards(&cx: Cx!['k], ty: Type['k]) -> Type['k] {
    match ty {
        Type::Exists(_binders, _body) => Type::Meta.(Meta::new(&cx, MetaKind::Type)),
        Type::Foreach(_f) => Type::Meta.(Meta::new(&cx, MetaKind::Type)),
        Type::Fn(f) => {
            if f.quantified.is_empty(&cx) {
                map_children(&cx, ty, |&cx, child: Type['k]| binders_as_wildcards(&cx, child))
            } else {
                Type::Meta.(Meta::new(&cx, MetaKind::Type))
            }
        },
        _ => map_children(&cx, ty, |&cx, child: Type['k]| binders_as_wildcards(&cx, child)),
    }
}

// Every quantified parameter is extractable without crossing a binder.
forall 'k.
fn check_instance_range(&cx: Cx!['k], head: Premise['k], params: Seq[Param['k], 'k], pos: Pos) {
    let used: Set[Text['k], 'k] = Set::new(&cx);
    var i = 0usize;
    while i < head.args.len(&cx) {
        add_all(&cx, used, extractable_names(&cx, head.args.get(&cx, i)));
        i = i + 1usize;
    }
    var j = 0usize;
    while j < params.len(&cx) {
        let param = params.get(&cx, j);
        if !used.has(&cx, param.name) {
            let name = if C::same_kind(param.kind, Kind::Brand) { text_of(&cx, Buffer::new().push_static("$").push_bytes(&cx, param.name)) } else { param.name };
            kurs_error(&cx, text_of(&cx, Buffer::new().push_static("instance of ").push_bytes(&cx, head.trait_name).push_static(": parameter ").push_bytes(&cx, name)
                .push_static(" needs a binder-free head occurrence")), pos);
        }
        j = j + 1usize;
    }
}

forall 'k.
fn show_args(&cx: Cx!['k], args: Seq[Type['k], 'k]) -> Text['k] {
    var out = Buffer::new();
    var i = 0usize;
    while i < args.len(&cx) {
        if i > 0usize {
            out = out.push_static(", ");
        }
        out = out.push_bytes(&cx, show(&cx, args.get(&cx, i)));
        i = i + 1usize;
    }
    text_of(&cx, out)
}

forall 'k.
fn wildcards(&cx: Cx!['k], args: Seq[Type['k], 'k], sub: Map[Text['k], Type['k], 'k], counter: Fresh['k]) -> Seq[Type['k], 'k] {
    let out: Seq[Type['k], 'k] = Seq::new(&cx);
    var i = 0usize;
    while i < args.len(&cx) {
        out.push(&cx, binders_as_wildcards(&cx, subst(&cx, args.get(&cx, i), sub, counter)));
        i = i + 1usize;
    }
    out
}

forall 'k.
fn check_coherence(&cx: Cx!['k], headers: Seq[(Premise['k], Seq[Param['k], 'k], Pos), 'k], counter: Fresh['k]) {
    let seen: Map[Text['k], Seq[(Premise['k], Seq[Param['k], 'k]), 'k], 'k] = Map::new(&cx);
    var h = 0usize;
    while h < headers.len(&cx) {
        let (head, params, pos) = headers.get(&cx, h);
        check_instance_range(&cx, head, params, pos);
        let earlier_heads = seen.get_or(&cx, head.trait_name, Seq::new(&cx));
        var e = 0usize;
        while e < earlier_heads.len(&cx) {
            let (earlier, earlier_params) = earlier_heads.get(&cx, e);
            // Freshen for every comparison: failed unification can leave some variables solved,
            // so its substitutions must not reach another pair.
            let left = instantiate(&cx, params);
            let right = instantiate(&cx, earlier_params);
            let xs = wildcards(&cx, head.args, left, counter);
            let ys = wildcards(&cx, earlier.args, right, counter);
            var overlapping = xs.len(&cx) == ys.len(&cx);
            var i = 0usize;
            while overlapping && i < xs.len(&cx) {
                overlapping = unify(&cx, xs.get(&cx, i), ys.get(&cx, i), true, counter);
                i = i + 1usize;
            }
            if overlapping {
                kurs_error(&cx, text_of(&cx, Buffer::new().push_static("overlapping instances of ").push_bytes(&cx, head.trait_name).push_static(": (").push_bytes(&cx, show_args(&cx, head.args))
                    .push_static(") and (").push_bytes(&cx, show_args(&cx, earlier.args)).push_static(")")), pos);
            }
            e = e + 1usize;
        }
        if !seen.has(&cx, head.trait_name) {
            seen.set(&cx, head.trait_name, Seq::new(&cx));
        }
        seen.at(&cx, head.trait_name).push(&cx, (head, params));
        h = h + 1usize;
    }
}
