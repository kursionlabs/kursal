// `kursal selftest-types CASE...`: runs the type modules (types, unify, literals, formation,
// layout, termination, coherence) on small cases and prints one line per case, for comparison with
// the reference compiler's modules (reference-compiler/tests/test_compiler.py).
//
// A case is one S-expression. Types are written in KURS syntax; `?a` (or `$?a` in a brand
// position) names a metavariable that the case declares. Declarations are
// `(type NAME (PARAM...) BODY)` or `(opaque NAME (PARAM...) BODY)`, where a linear type's name ends
// with `!` and a parameter is `T`, `+T` (Copy) or `$k` (a brand). A failing case stops with the reference
// compiler's message.
//
//   (show T)                         the type as text
//   (subst T ((NAME T)...))          the substitution's result
//   (free T) (brands T) (extractable T)
//                                    free names, free brands, extractable names, sorted
//   (equal A B) (fits A B)           equality modulo bound names; Never fits anything
//   (unify METAS A B) (unify-closed METAS A B)
//                                    whether they unify, both sides afterwards, every metavariable's
//                                    solution; METAS is ((NAME KIND)...), KIND type, int, float or brand
//   (match-head (PARAM...) (HEAD...) (QUERY...) REQUIRE)
//                                    the extracted parameters, or none
//   (literal PRIM "TEXT")            whether TEXT is a literal of PRIM
//   (copy (DECL...) ((NAME KIND)...) T) (zero (DECL...) T) (expand (DECL...) T)
//                                    is_copy, zero_size, the outer shape
//   (layout DECL...) (formation DECL...)
//                                    check_type_expansion, Formation.declarations
//   (kind (DECL...) ((NAME KIND)...) T)
//                                    Formation.kind
//   (instances ((TRAIT T...) (TRAIT T...)...)...)
//                                    check_instance_termination of heads and their premises
//   (coherence ((PARAM...) (TRAIT T...))...)
//                                    check_coherence
//   (fields (DECL...) T) (variants (DECL...) T)
//                                    a product's components, a sum's variants
//   (exposure (DECL...) ((NAME KIND)...) T)
//                                    the visible outer shape (or hidden), and whether it is a concrete
//                                    exposure; an `(opaque NAME ...)` declaration is exposed only
//                                    in a module m
//   (pattern (DECL...) FOREACH-TYPE)
//                                    whether the foreach pattern matches every component
//   (function (DECL...) FUN...)      Formation.function of each FUN, written as for mono
//   (mono (NAME (PARAM...) INSTR...)...)
//                                    check_mono_termination; INSTR is (call F T...), (fn F T...),
//                                    (trait_call TRAIT METHOD T...) or (foreach F FOREACH-TYPE T...)

use package::support::base::{emit_buffer, fail};
use std::parse::parse_u64;
use std::collections::arena_vec::ArenaVec;
use std::collections::arena_map::{ArenaMap, ArenaSet};
use std::mem::Ref;
use std::raw::Span;
use std::arena::Domain!;
use std::buffer::Buffer!;
use package::types::coherence::check_coherence;
use package::kurs::core::{Block, Exposure, ExposureMode, Fun, ModuleId, Instr, Kind, Member, Meta, MetaKind, Param, Premise, Program, Terminator, Type, TypeDecl};
use package::kurs::core as C;
use package::types::formation::{Formation, NoDischarge};
use package::types::layout::check_type_expansion;
use package::types::literals::valid_literal;
use package::kurs::sexpr::{Form, read};
use package::syntax::ast::{Pos, no_pos};
use package::types::termination::{check_instance_termination, check_mono_termination};
use package::types::ops::{Fresh, Types, equal, extractable_names, fits, free_brands, free_names, kind_name, show, subst};
use package::types::unify::{match_head, unify, zonk};
use std::option::Option;

// ---------------------------------------------------------------- reading --


forall 'k.
fn parse_types(&cx: Domain!['k], forms: ArenaVec[Form['k], 'k], start: usize) -> ArenaVec[Type['k], 'k] {
    let out: ArenaVec[Type['k], 'k] = ArenaVec::new(&cx);
    var i = start;
    while i < forms.len(&cx) {
        out.push(&cx, parse_type(&cx, forms.at(&cx, i)));
        i = i + 1usize;
    }
    out
}

forall 'k.
fn parse_members(&cx: Domain!['k], forms: ArenaVec[Form['k], 'k]) -> ArenaVec[Member['k], 'k] {
    let out: ArenaVec[Member['k], 'k] = ArenaVec::new(&cx);
    var i = 1usize;
    while i < forms.len(&cx) {
        let f = forms.at(&cx, i);
        out.push(&cx, Member.{ name: f.at(&cx, 0usize).text, type: parse_type(&cx, f.at(&cx, 1usize)) });
        i = i + 1usize;
    }
    out
}

forall 'k.
fn brand_label(f: Form['k]) -> Span['k] {
    f.text.skip(1usize)
}

// A KURS type, as `kurs.parse_type` reads it.
forall 'k.
fn parse_type(&cx: Domain!['k], f: Form['k]) -> Type['k] {
    if !f.is_list() {
        let t = f.text;
        if t.is(&cx, "_") {
            return Type::Ignored;
        }
        if t.is(&cx, "!") {
            return Type::Never;
        }
        if t.byte_or_zero(&cx, 0usize) == b'$' {
            return Type::Skolem.(brand_label(f));
        }
        if C::is_prim(&cx, t) {
            return Type::Prim.(t);
        }
        return C::named(t, ArenaVec::new(&cx));
    }
    let head = f.at(&cx, 0usize).text;
    if head.is(&cx, "struct") {
        Type::Struct.(parse_members(&cx, f.items))
    } else if head.is(&cx, "enum") {
        Type::Enum.(parse_members(&cx, f.items))
    } else if head.is(&cx, "tuple") {
        Type::Tuple.(parse_types(&cx, f.items, 1usize))
    } else if head.is(&cx, "array") {
        Type::Array.(Ref::new(&cx, parse_type(&cx, f.at(&cx, 1usize))), parse_u64(&cx, f.at(&cx, 2usize).text).unwrap_or(0u64))
    } else if head.is(&cx, "ptr") {
        C::ptr(&cx, parse_type(&cx, f.at(&cx, 1usize)))
    } else if head.is(&cx, "brand") {
        Type::Brand.(Ref::new(&cx, Type::Skolem.(brand_label(f.at(&cx, 1usize)))))
    } else if head.is(&cx, "exists") {
        let binders: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
        var i = 0usize;
        while i < f.at(&cx, 1usize).len(&cx) {
            binders.push(&cx, brand_label(f.at(&cx, 1usize).at(&cx, i)));
            i = i + 1usize;
        }
        Type::Exists.(binders, Ref::new(&cx, parse_type(&cx, f.at(&cx, 2usize))))
    } else if head.is(&cx, "foreach") {
        let pattern = f.at(&cx, 1usize).at(&cx, 0usize);
        let source = parse_type(&cx, f.at(&cx, 1usize).at(&cx, 1usize));
        let indirect = pattern.is_list() && pattern.len(&cx) == 2usize && pattern.at(&cx, 0usize).text.is(&cx, "ptr");
        let binder = if indirect { pattern.at(&cx, 1usize).text } else { pattern.text };
        let body = parse_type(&cx, f.at(&cx, 2usize));
        C::foreach_type(&cx, binder, indirect, source, body)
    } else if head.is(&cx, "fn") {
        var at = 1usize;
        let first = f.at(&cx, 1usize);
        let is_unsafe = first.is_list() && first.len(&cx) == 1usize && first.at(&cx, 0usize).text.is(&cx, "unsafe");
        if is_unsafe {
            at = 2usize;
        }
        let header = f.at(&cx, at);
        if header.is_list() && header.len(&cx) == 5usize && header.at(&cx, 0usize).is_atom() && header.at(&cx, 0usize).text.is(&cx, "forall") {
            let params = parse_params(&cx, header.at(&cx, 1usize));
            C::fn_type(&cx, parse_types(&cx, header.at(&cx, 4usize).items, 0usize), parse_type(&cx, header.at(&cx, 3usize)), params, is_unsafe, ArenaVec::new(&cx))
        } else {
            C::fn_type(&cx, parse_types(&cx, header.items, 0usize), parse_type(&cx, f.at(&cx, at + 1usize)), ArenaVec::new(&cx), is_unsafe, ArenaVec::new(&cx))
        }
    } else {
        C::named(head, parse_types(&cx, f.items, 1usize))
    }
}

// Parameters: `$k` a brand, `+T` a Copy type, `T` any type.
forall 'k.
fn parse_params(&cx: Domain!['k], f: Form['k]) -> ArenaVec[Param['k], 'k] {
    let out: ArenaVec[Param['k], 'k] = ArenaVec::new(&cx);
    var i = 0usize;
    while i < f.len(&cx) {
        let t = f.at(&cx, i).text;
        if t.byte_or_zero(&cx, 0usize) == b'$' {
            out.push(&cx, Param.{ name: t.skip(1usize), kind: Kind::Brand });
        } else if t.byte_or_zero(&cx, 0usize) == b'+' {
            out.push(&cx, Param.{ name: t.skip(1usize), kind: Kind::Copy });
        } else {
            out.push(&cx, Param.{ name: t, kind: Kind::Any });
        }
        i = i + 1usize;
    }
    out
}

forall 'k.
fn parse_kind(&cx: Domain!['k], t: Span['k]) -> Kind {
    if t.is(&cx, "brand") {
        Kind::Brand
    } else if t.is(&cx, "copy") {
        Kind::Copy
    } else {
        Kind::Any
    }
}

forall 'k.
fn parse_kinds(&cx: Domain!['k], f: Form['k]) -> ArenaMap[Span['k], Kind, 'k] {
    let out: ArenaMap[Span['k], Kind, 'k] = ArenaMap::new(&cx);
    var i = 0usize;
    while i < f.len(&cx) {
        out.insert(&cx, f.at(&cx, i).at(&cx, 0usize).text, parse_kind(&cx, f.at(&cx, i).at(&cx, 1usize).text));
        i = i + 1usize;
    }
    out
}

forall 'k.
fn parse_premise(&cx: Domain!['k], f: Form['k]) -> Premise['k] {
    Premise.{ trait_name: f.at(&cx, 0usize).text, args: parse_types(&cx, f.items, 1usize) }
}

forall 'k.
fn parse_decl(&cx: Domain!['k], f: Form['k]) -> TypeDecl['k] {
    TypeDecl.{
        name: f.at(&cx, 1usize).text,
        params: parse_params(&cx, f.at(&cx, 2usize)),
        premises: ArenaVec::new(&cx),
        body: parse_type(&cx, f.at(&cx, 3usize)),
        home: Option::None,
        exposure: if f.at(&cx, 0usize).text.is(&cx, "opaque") {
            Option::Some.(Exposure.{ mode: ExposureMode::Owner, home: ModuleId::root(&cx, 0usize).child(&cx, Span::from_static(&cx, "m")) })
        } else {
            Option::None
        },
    }
}

forall 'k.
fn parse_program(&cx: Domain!['k], forms: ArenaVec[Form['k], 'k], start: usize) -> Program['k] {
    let program = Program::new(&cx);
    var i = start;
    while i < forms.len(&cx) {
        let decl = parse_decl(&cx, forms.at(&cx, i));
        program.types.insert(&cx, decl.name, decl);
        i = i + 1usize;
    }
    program
}

forall 'k.
fn parse_instr(&cx: Domain!['k], f: Form['k]) -> Instr['k] {
    let op = f.at(&cx, 0usize).text;
    let args: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
    var ty: Option[Type['k]] = Option::None;
    var first = 2usize;
    if op.is(&cx, "trait_call") {
        args.push(&cx, f.at(&cx, 1usize).text);
        args.push(&cx, f.at(&cx, 2usize).text);
        first = 3usize;
    } else if op.is(&cx, "foreach") {
        args.push(&cx, Span::from_static(&cx, "items"));
        args.push(&cx, f.at(&cx, 1usize).text);
        ty = Option::Some.(parse_type(&cx, f.at(&cx, 2usize)));
        first = 3usize;
    } else {
        args.push(&cx, f.at(&cx, 1usize).text);
    }
    Instr.{ lhs: ArenaVec::new(&cx), op, args, ty, tys: parse_types(&cx, f.items, first), lit: Option::None, is_unsafe: false, binders: ArenaVec::new(&cx), pos: f.pos }
}

forall 'k.
fn parse_fun(&cx: Domain!['k], f: Form['k]) -> Fun['k] {
    let instrs: ArenaVec[Instr['k], 'k] = ArenaVec::new(&cx);
    var i = 2usize;
    while i < f.len(&cx) {
        instrs.push(&cx, parse_instr(&cx, f.at(&cx, i)));
        i = i + 1usize;
    }
    let entry = Block.{ label: Span::from_static(&cx, "entry"), params: ArenaVec::new(&cx), instrs, term: Terminator::Ret.(Span::from_static(&cx, "x"), no_pos()), brands: ArenaVec::new(&cx), empty: ArenaVec::new(&cx), known: ArenaVec::new(&cx), opened: ArenaVec::new(&cx), pos: no_pos() };
    Fun.{ name: f.at(&cx, 0usize).text, params: parse_params(&cx, f.at(&cx, 1usize)), premises: ArenaVec::new(&cx), ret: C::unit(&cx), ptypes: ArenaVec::new(&cx), blocks: ArenaVec::one(&cx, entry), locals: ArenaVec::new(&cx), is_unsafe: false, home: Option::None, pos: no_pos() }
}

// --------------------------------------------------------------- printing --

forall 'k.
fn show_set(&cx: Domain!['k], names: ArenaSet[Span['k], 'k]) -> Span['k] {
    let items = names.keys(&cx);
    items.sort_by(&cx, |&cx, a, b| a.cmp(&cx, b));
    var out = Buffer!::new().push_static("[");
    var i = 0usize;
    while i < items.len(&cx) {
        if i > 0usize {
            out = out.push_static(" ");
        }
        out = out.push_bytes(&cx, items.at(&cx, i));
        i = i + 1usize;
    }
    out.push_static("]").save(&cx)
}

forall 'k.
fn flag(&cx: Domain!['k], b: bool) -> Span['k] {
    if b { Span::from_static(&cx, "true") } else { Span::from_static(&cx, "false") }
}

forall 'k.
fn meta_kind(&cx: Domain!['k], t: Span['k]) -> MetaKind {
    if t.is(&cx, "int") {
        MetaKind::Int
    } else if t.is(&cx, "float") {
        MetaKind::Float
    } else if t.is(&cx, "brand") {
        MetaKind::Brand
    } else {
        MetaKind::Type
    }
}

// ------------------------------------------------------------------ cases --

forall 'k.
fn run_case(&cx: Domain!['k], source: Span['k], counter: Fresh['k]) -> Span['k] {
    let form = read(&cx, source).at(&cx, 0usize);
    let op = form.at(&cx, 0usize).text;
    if op.is(&cx, "show") {
        show(&cx, parse_type(&cx, form.at(&cx, 1usize)))
    } else if op.is(&cx, "subst") {
        let sub: ArenaMap[Span['k], Type['k], 'k] = ArenaMap::new(&cx);
        let pairs = form.at(&cx, 2usize);
        var i = 0usize;
        while i < pairs.len(&cx) {
            sub.insert(&cx, pairs.at(&cx, i).at(&cx, 0usize).text, parse_type(&cx, pairs.at(&cx, i).at(&cx, 1usize)));
            i = i + 1usize;
        }
        show(&cx, subst(&cx, parse_type(&cx, form.at(&cx, 1usize)), sub, counter))
    } else if op.is(&cx, "free") {
        show_set(&cx, free_names(&cx, parse_type(&cx, form.at(&cx, 1usize))))
    } else if op.is(&cx, "brands") {
        show_set(&cx, free_brands(&cx, parse_type(&cx, form.at(&cx, 1usize))))
    } else if op.is(&cx, "extractable") {
        show_set(&cx, extractable_names(&cx, parse_type(&cx, form.at(&cx, 1usize))))
    } else if op.is(&cx, "equal") {
        flag(&cx, equal(&cx, parse_type(&cx, form.at(&cx, 1usize)), parse_type(&cx, form.at(&cx, 2usize))))
    } else if op.is(&cx, "fits") {
        flag(&cx, fits(&cx, parse_type(&cx, form.at(&cx, 1usize)), parse_type(&cx, form.at(&cx, 2usize))))
    } else if op.is(&cx, "unify") || op.is(&cx, "unify-closed") {
        let metas: ArenaMap[Span['k], Type['k], 'k] = ArenaMap::new(&cx);
        let names: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
        let declared = form.at(&cx, 1usize);
        var i = 0usize;
        while i < declared.len(&cx) {
            let name = Buffer!::new().push_static("?").push_bytes(&cx, declared.at(&cx, i).at(&cx, 0usize).text).save(&cx);
            names.push(&cx, name);
            metas.insert(&cx, name, Type::Meta.(Meta::new(&cx, meta_kind(&cx, declared.at(&cx, i).at(&cx, 1usize).text))));
            i = i + 1usize;
        }
        let a = subst(&cx, parse_type(&cx, form.at(&cx, 2usize)), metas, counter);
        let b = subst(&cx, parse_type(&cx, form.at(&cx, 3usize)), metas, counter);
        let ok = unify(&cx, a, b, op.is(&cx, "unify-closed"), counter);
        var out = Buffer!::new().push_bytes(&cx, flag(&cx, ok)).push_static(" | ").push_bytes(&cx, show(&cx, zonk(&cx, a))).push_static(" | ").push_bytes(&cx, show(&cx, zonk(&cx, b))).push_static(" |");
        var j = 0usize;
        while j < names.len(&cx) {
            out = out.push_static(" ").push_bytes(&cx, names.at(&cx, j)).push_static("=").push_bytes(&cx, show(&cx, zonk(&cx, metas.at(&cx, names.at(&cx, j)))));
            j = j + 1usize;
        }
        out.save(&cx)
    } else if op.is(&cx, "match-head") {
        let params = parse_params(&cx, form.at(&cx, 1usize));
        let found = match_head(&cx, params, parse_types(&cx, form.at(&cx, 2usize).items, 0usize), parse_types(&cx, form.at(&cx, 3usize).items, 0usize), form.at(&cx, 4usize).text.is(&cx, "true"), counter);
        match found {
            Option::None => Span::from_static(&cx, "none"),
            Option::Some(sub) => {
                var out = Buffer!::new().push_static("{");
                let keys = sub.keys(&cx);
                var i = 0usize;
                while i < keys.len(&cx) {
                    if i > 0usize {
                        out = out.push_static(" ");
                    }
                    out = out.push_bytes(&cx, keys.at(&cx, i)).push_static("=").push_bytes(&cx, show(&cx, sub.at(&cx, keys.at(&cx, i))));
                    i = i + 1usize;
                }
                out.push_static("}").save(&cx)
            },
        }
    } else if op.is(&cx, "literal") {
        flag(&cx, valid_literal(&cx, parse_type(&cx, form.at(&cx, 1usize)), form.at(&cx, 2usize).text))
    } else if op.is(&cx, "copy") {
        let types = Types::new(&cx, parse_program(&cx, form.at(&cx, 1usize).items, 0usize), counter);
        flag(&cx, types.is_copy(&cx, parse_type(&cx, form.at(&cx, 3usize)), parse_kinds(&cx, form.at(&cx, 2usize))))
    } else if op.is(&cx, "zero") {
        let types = Types::new(&cx, parse_program(&cx, form.at(&cx, 1usize).items, 0usize), counter);
        flag(&cx, types.zero_size(&cx, parse_type(&cx, form.at(&cx, 2usize))))
    } else if op.is(&cx, "expand") {
        let types = Types::new(&cx, parse_program(&cx, form.at(&cx, 1usize).items, 0usize), counter);
        show(&cx, types.shape(&cx, parse_type(&cx, form.at(&cx, 2usize)), Option::None))
    } else if op.is(&cx, "layout") {
        check_type_expansion(&cx, parse_program(&cx, form.items, 1usize), counter, ArenaMap::new(&cx));
        Span::from_static(&cx, "ok")
    } else if op.is(&cx, "formation") {
        let formation: Formation[NoDischarge, 'k] = Formation::new(&cx, parse_program(&cx, form.items, 1usize), counter);
        formation.declarations(&cx);
        Span::from_static(&cx, "ok")
    } else if op.is(&cx, "kind") {
        let formation: Formation[NoDischarge, 'k] = Formation::new(&cx, parse_program(&cx, form.at(&cx, 1usize).items, 0usize), counter);
        kind_name(&cx, formation.kind(&cx, parse_type(&cx, form.at(&cx, 3usize)), parse_kinds(&cx, form.at(&cx, 2usize))))
    } else if op.is(&cx, "instances") {
        let headers: ArenaVec[(Premise['k], ArenaVec[Premise['k], 'k], Pos), 'k] = ArenaVec::new(&cx);
        var i = 1usize;
        while i < form.len(&cx) {
            let h = form.at(&cx, i);
            let premises: ArenaVec[Premise['k], 'k] = ArenaVec::new(&cx);
            var j = 1usize;
            while j < h.len(&cx) {
                premises.push(&cx, parse_premise(&cx, h.at(&cx, j)));
                j = j + 1usize;
            }
            headers.push(&cx, (parse_premise(&cx, h.at(&cx, 0usize)), premises, h.pos));
            i = i + 1usize;
        }
        check_instance_termination(&cx, headers, ArenaVec::new(&cx), false);
        Span::from_static(&cx, "ok")
    } else if op.is(&cx, "coherence") {
        let headers: ArenaVec[(Premise['k], ArenaVec[Param['k], 'k], Pos), 'k] = ArenaVec::new(&cx);
        var i = 1usize;
        while i < form.len(&cx) {
            let h = form.at(&cx, i);
            headers.push(&cx, (parse_premise(&cx, h.at(&cx, 1usize)), parse_params(&cx, h.at(&cx, 0usize)), h.pos));
            i = i + 1usize;
        }
        check_coherence(&cx, headers, counter, ArenaVec::new(&cx), false);
        Span::from_static(&cx, "ok")
    } else if op.is(&cx, "mono") {
        let program = Program::new(&cx);
        var i = 1usize;
        while i < form.len(&cx) {
            let fun = parse_fun(&cx, form.at(&cx, i));
            program.funs.insert(&cx, fun.name, fun);
            i = i + 1usize;
        }
        check_mono_termination(&cx, program);
        Span::from_static(&cx, "ok")
    } else if op.is(&cx, "function") {
        let program = parse_program(&cx, form.at(&cx, 1usize).items, 0usize);
        let funs: ArenaVec[Fun['k], 'k] = ArenaVec::new(&cx);
        var i = 2usize;
        while i < form.len(&cx) {
            let fun = parse_fun(&cx, form.at(&cx, i));
            program.funs.insert(&cx, fun.name, fun);
            funs.push(&cx, fun);
            i = i + 1usize;
        }
        let formation: Formation[NoDischarge, 'k] = Formation::new(&cx, program, counter);
        var j = 0usize;
        while j < funs.len(&cx) {
            formation.function(&cx, funs.at(&cx, j), ArenaVec::new(&cx), ArenaVec::new(&cx));
            j = j + 1usize;
        }
        Span::from_static(&cx, "ok")
    } else if op.is(&cx, "fields") {
        let types = Types::new(&cx, parse_program(&cx, form.at(&cx, 1usize).items, 0usize), counter);
        let found = types.fields(&cx, parse_type(&cx, form.at(&cx, 2usize)), Option::None);
        var out = Buffer!::new().push_static("[");
        var i = 0usize;
        while i < found.len(&cx) {
            if i > 0usize {
                out = out.push_static(" ");
            }
            out = out.push_bytes(&cx, show(&cx, found.at(&cx, i)));
            i = i + 1usize;
        }
        out.push_static("]").save(&cx)
    } else if op.is(&cx, "variants") {
        let types = Types::new(&cx, parse_program(&cx, form.at(&cx, 1usize).items, 0usize), counter);
        let found = types.variants(&cx, parse_type(&cx, form.at(&cx, 2usize)), Option::None);
        var out = Buffer!::new().push_static("[");
        var i = 0usize;
        while i < found.len(&cx) {
            if i > 0usize {
                out = out.push_static(" ");
            }
            out = out.push_bytes(&cx, found.at(&cx, i).name).push_static(":").push_bytes(&cx, show(&cx, found.at(&cx, i).type));
            i = i + 1usize;
        }
        out.push_static("]").save(&cx)
    } else if op.is(&cx, "exposure") {
        let types = Types::new(&cx, parse_program(&cx, form.at(&cx, 1usize).items, 0usize), counter);
        let unit = match types.visible_shape(&cx, parse_type(&cx, form.at(&cx, 3usize)), Option::None, parse_kinds(&cx, form.at(&cx, 2usize))) {
            Option::Some(t) => Buffer!::new().push_bytes(&cx, show(&cx, t)).save(&cx),
            Option::None => Span::from_static(&cx, "hidden"),
        };
        Buffer!::new().push_bytes(&cx, unit).push_static(" ").push_bytes(&cx, flag(&cx, types.concrete_exposure(&cx, parse_type(&cx, form.at(&cx, 3usize)), Option::None, parse_kinds(&cx, form.at(&cx, 2usize))))).save(&cx)
    } else if op.is(&cx, "pattern") {
        let types = Types::new(&cx, parse_program(&cx, form.at(&cx, 1usize).items, 0usize), counter);
        match parse_type(&cx, form.at(&cx, 2usize)) {
            Type::Foreach(f) => flag(&cx, types.pattern_available(&cx, f)),
            _ => fail(&cx, Span::from_static(&cx, "a pattern case needs a foreach type")),
        }
    } else {
        fail(&cx, Buffer!::new().push_static("unknown case ").push_bytes(&cx, op).save(&cx))
    }
}

// Runs each case in order, printing its result on a line of its own.
forall 'k.
fn selftest_types(&cx: Domain!['k], cases: ArenaVec[Span['k], 'k]) {
    let counter = Fresh::new(&cx);
    var i = 0usize;
    while i < cases.len(&cx) {
        emit_buffer(Buffer!::new().push_bytes(&cx, run_case(&cx, cases.at(&cx, i), counter)).push_static("\n"));
        i = i + 1usize;
    }
}
