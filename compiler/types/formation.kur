// Type formation: Γ ⊢ T : kind. Nominal types are checked without unfolding.
//
// This pass validates written contracts, not recursive layout or trait coherence. Premises are
// checked for formation here and discharged by the assertion checker.

use package::support::base::{Cell, Cx, Map, Out, Seq, Set, Text, text};
use package::kurs::core::{Block, Edge, Fun, Kind, ModuleId, Param, Premise, Program, Terminator, Trait, Type};
use package::kurs::core as C;
use package::resolve::resolver::Resolver;
use package::syntax::ast::{Pos, no_pos};
use package::types::ops::{Fresh, Types, children, equal, foreach_binders, free_brands, kind_name, kurs_error, subst};
use std::option::Option;
use std::slice::Slice;

// Children admissible for descent; a path cannot cross a binder.
forall 'k.
fn formation_children(&cx: Cx!['k], ty: Type['k]) -> Seq[Type['k], 'k] {
    match ty {
        Type::Exists(_binders, _body) => Seq::new(&cx),
        Type::Foreach(f) => Seq::one(&cx, f.source.get(&cx)),
        Type::Fn(f) => if f.quantified.is_empty(&cx) { children(&cx, ty) } else { Seq::new(&cx) },
        _ => children(&cx, ty),
    }
}

forall 'k.
fn strict_subterm(&cx: Cx!['k], child: Type['k], parent: Type['k]) -> bool {
    let parts = formation_children(&cx, parent);
    var found = false;
    var i = 0usize;
    while !found && i < parts.len(&cx) {
        found = equal(&cx, child, parts.get(&cx, i)) || strict_subterm(&cx, child, parts.get(&cx, i));
        i = i + 1usize;
    }
    found
}

// Componentwise subterms, with at least one strict component.
forall 'k.
fn nominal_descent(&cx: Cx!['k], args: Seq[Type['k], 'k], previous: Seq[Type['k], 'k]) -> bool {
    if args.len(&cx) != previous.len(&cx) {
        return false;
    }
    var all = true;
    var any = false;
    var i = 0usize;
    while i < args.len(&cx) {
        let strict = strict_subterm(&cx, args.get(&cx, i), previous.get(&cx, i));
        all = all && (equal(&cx, args.get(&cx, i), previous.get(&cx, i)) || strict);
        any = any || strict;
        i = i + 1usize;
    }
    all && any
}

// A reference to one brand, respecting nested brand binders.
forall 'k.
fn brand_occurs(&cx: Cx!['k], ty: Type['k], label: Text['k]) -> bool {
    let unit = match ty {
        Type::Skolem(found) => {
            return found.eq(&cx, label);
        },
        Type::Exists(binders, _body) => {
            if binders.has(&cx, label) {
                return false;
            }
        },
        Type::Fn(f) => {
            var i = 0usize;
            while i < f.quantified.len(&cx) {
                if f.quantified.get(&cx, i).name.eq(&cx, label) {
                    return false;
                }
                i = i + 1usize;
            }
        },
        _ => (),
    };
    let parts = children(&cx, ty);
    var found = false;
    var i = 0usize;
    while !found && i < parts.len(&cx) {
        found = brand_occurs(&cx, parts.get(&cx, i), label);
        i = i + 1usize;
    }
    found
}

// Discharges a premise that a nominal type's declaration requires, under the parameter kinds,
// assumptions and module of the declaration being formed. The assertion checker provides one.
forall D, 'k.
trait Discharge {
    fn discharge_premise(discharger: D, &cx: Cx!['k], premise: Premise['k], env: Map[Text['k], Kind, 'k], premises: Seq[Premise['k], 'k], home: Option[ModuleId['k]]) -> bool;
}

// A formation that discharges nothing: its `discharge` stays none.
exposed struct NoDischarge {
    unused: bool,
}

forall 'k.
instance Discharge[NoDischarge, 'k] {
    fn discharge_premise(discharger: NoDischarge, &cx: Cx!['k], premise: Premise['k], env: Map[Text['k], Kind, 'k], premises: Seq[Premise['k], 'k], home: Option[ModuleId['k]]) -> bool {
        false
    }
}

forall D, 'k.
exposed struct Formation {
    program: Program['k],
    types: Types['k],
    pos: Cell[Pos, 'k],
    discharge: Cell[Option[D], 'k],
    premises: Cell[Seq[Premise['k], 'k], 'k],
    home: Cell[Option[ModuleId['k]], 'k],
    // nominal types whose premises are being formed, with their arguments
    active: Seq[(Text['k], Seq[Type['k], 'k]), 'k],
    // the resolver that locates errors, when a declaration's file is known
    reporter: Cell[Option[Resolver['k]], 'k],
}

forall 'k.
fn with_kind(&cx: Cx!['k], env: Map[Text['k], Kind, 'k], name: Text['k], kind: Kind) -> Map[Text['k], Kind, 'k] {
    let out = env.copy(&cx);
    out.set(&cx, name, kind);
    out
}

fn is_brand(kind: Kind) -> bool {
    C::same_kind(kind, Kind::Brand)
}

forall 'k.
fn params_of(&cx: Cx!['k], names: Seq[Text['k], 'k], kind: Kind) -> Seq[Param['k], 'k] {
    let out: Seq[Param['k], 'k] = Seq::new(&cx);
    var i = 0usize;
    while i < names.len(&cx) {
        out.push(&cx, Param.{ name: names.get(&cx, i), kind });
        i = i + 1usize;
    }
    out
}

forall 'k.
fn is_ignored(t: Type['k]) -> bool {
    match t {
        Type::Ignored => true,
        _ => false,
    }
}

forall 'k.
fn concat_params(&cx: Cx!['k], a: Seq[Param['k], 'k], b: Seq[Param['k], 'k]) -> Seq[Param['k], 'k] {
    let out = a.copy(&cx);
    out.append(&cx, b);
    out
}

forall 'k.
fn concat_premises(&cx: Cx!['k], a: Seq[Premise['k], 'k], b: Seq[Premise['k], 'k]) -> Seq[Premise['k], 'k] {
    let out = a.copy(&cx);
    out.append(&cx, b);
    out
}

forall D, 'k where Copy[D], Discharge[D, 'k].
impl Formation[D, 'k] {
    fn new(&cx: Cx!['k], program: Program['k], counter: Fresh['k]) -> Formation[D, 'k] {
        Formation.{
            program,
            types: Types::new(&cx, program, counter),
            pos: Cell::new(&cx, no_pos()),
            discharge: Cell::new(&cx, Option::None),
            premises: Cell::new(&cx, Seq::new(&cx)),
            home: Cell::new(&cx, Option::None),
            active: Seq::new(&cx),
            reporter: Cell::new(&cx, Option::None),
        }
    }

    fn fail(self, &cx: Cx!['k], message: Text['k]) -> ! {
        let full = Out::new(&cx).put(&cx, "type formation: ").add(&cx, message).done(&cx);
        match self.reporter.get(&cx) {
            Option::Some(r) => r.fail(&cx, full, self.pos.get(&cx)),
            Option::None => kurs_error(&cx, full, self.pos.get(&cx)),
        }
    }

    fn fail_static(self, &cx: Cx!['k], message: Slice[u8, 'static]) -> ! {
        self.fail(&cx, text(&cx, message))
    }

    fn extend(self, &cx: Cx!['k], env: Map[Text['k], Kind, 'k], params: Seq[Param['k], 'k]) -> Map[Text['k], Kind, 'k] {
        let names: Set[Text['k], 'k] = Set::new(&cx);
        var i = 0usize;
        while i < params.len(&cx) {
            names.add(&cx, params.get(&cx, i).name);
            i = i + 1usize;
        }
        if names.len(&cx) != params.len(&cx) {
            self.fail_static(&cx, "duplicate parameter");
        }
        if names.has(&cx, text(&cx, "static")) {
            self.fail_static(&cx, "static is not a parameter name");
        }
        // A `Kind` is one of the three kinds by construction.
        let out = env.copy(&cx);
        var j = 0usize;
        while j < params.len(&cx) {
            out.set(&cx, params.get(&cx, j).name, params.get(&cx, j).kind);
            j = j + 1usize;
        }
        out
    }

    fn fits(self, &cx: Cx!['k], ty: Type['k], want: Kind, env: Map[Text['k], Kind, 'k]) {
        let got = self.kind(&cx, ty, env);
        if is_brand(got) != is_brand(want) {
            self.fail(&cx, Out::new(&cx).put(&cx, "expected ").add(&cx, kind_name(&cx, want)).put(&cx, " argument").done(&cx));
        }
        if C::same_kind(want, Kind::Copy) && !self.types.is_copy(&cx, ty, env) {
            self.fail_static(&cx, "expected Copy argument");
        }
    }

    fn arguments(self, &cx: Cx!['k], params: Seq[Param['k], 'k], args: Seq[Type['k], 'k], env: Map[Text['k], Kind, 'k], retain: bool) {
        if params.len(&cx) != args.len(&cx) {
            self.fail_static(&cx, "wrong number of type arguments");
        }
        var i = 0usize;
        while i < params.len(&cx) {
            let param = params.get(&cx, i);
            let arg = args.get(&cx, i);
            let skip = retain && is_brand(param.kind) && is_ignored(arg);
            if !skip {
                self.fits(&cx, arg, param.kind, env);
            }
            i = i + 1usize;
        }
    }

    fn premise(self, &cx: Cx!['k], premise: Premise['k], env: Map[Text['k], Kind, 'k]) {
        let params = if premise.trait_name.is(&cx, "builtin::Exposed") {
            Seq::one(&cx, Param.{ name: text(&cx, "T"), kind: Kind::Any })
        } else {
            match self.program.traits.get(&cx, premise.trait_name) {
                Option::Some(t) => self.trait_params(&cx, t),
                Option::None => self.fail(&cx, Out::new(&cx).put(&cx, "unknown trait ").add(&cx, premise.trait_name).done(&cx)),
            }
        };
        self.arguments(&cx, params, premise.args, env, false);
    }

    fn trait_params(self, &cx: Cx!['k], t: Trait['k]) -> Seq[Param['k], 'k] {
        let kinds: Seq[Kind, 'k] = if t.param_kinds.is_empty(&cx) {
            let all: Seq[Kind, 'k] = Seq::new(&cx);
            var i = 0usize;
            while i < t.params.len(&cx) {
                all.push(&cx, Kind::Any);
                i = i + 1usize;
            }
            all
        } else {
            t.param_kinds
        };
        if kinds.len(&cx) != t.params.len(&cx) {
            self.fail_static(&cx, "trait parameter kinds disagree");
        }
        let out: Seq[Param['k], 'k] = Seq::new(&cx);
        var j = 0usize;
        while j < kinds.len(&cx) {
            out.push(&cx, Param.{ name: t.params.get(&cx, j), kind: kinds.get(&cx, j) });
            j = j + 1usize;
        }
        out
    }

    // Validate structure and distinguish brands from values; fits refines Copy.
    fn kind(self, &cx: Cx!['k], ty: Type['k], env: Map[Text['k], Kind, 'k]) -> Kind {
        match ty {
            Type::Skolem(label) => {
                let in_scope = match env.get(&cx, label) {
                    Option::Some(k) => is_brand(k),
                    Option::None => false,
                };
                if !in_scope {
                    self.fail(&cx, Out::new(&cx).put(&cx, "brand ").add(&cx, label).put(&cx, " is not in scope").done(&cx));
                }
                return Kind::Brand;
            },
            Type::Named(name, args) => self.named(&cx, name, args, env),
            Type::Brand(brand) => self.fits(&cx, brand.get(&cx), Kind::Brand, env),
            Type::Exists(binders, body) => {
                if binders.is_empty(&cx) {
                    self.fail_static(&cx, "existential requires at least one brand binder");
                }
                let inner = self.extend(&cx, env, params_of(&cx, binders, Kind::Brand));
                let unit = match body.get(&cx) {
                    Type::Exists(_b, _t) => self.fail_static(&cx, "nested existential binders must be flattened"),
                    _ => (),
                };
                var i = 0usize;
                while i < binders.len(&cx) {
                    if !brand_occurs(&cx, body.get(&cx), binders.get(&cx, i)) {
                        self.fail_static(&cx, "existential brand binder is unused");
                    }
                    i = i + 1usize;
                }
                self.fits(&cx, body.get(&cx), Kind::Any, inner);
            },
            Type::Foreach(f) => {
                self.fits(&cx, f.source.get(&cx), Kind::Any, env);
                let available = match f.source.get(&cx) {
                    Type::Foreach(source) => foreach_binders(&cx, source),
                    _ => Seq::new(&cx),
                };
                if !available.slice(&cx, 0usize, f.retained.len(&cx)).same(&cx, f.retained) {
                    self.fail_static(&cx, "foreach retained binders must be a source prefix");
                }
                self.fits(&cx, f.body.get(&cx), Kind::Any, self.extend(&cx, env, params_of(&cx, foreach_binders(&cx, f), Kind::Any)));
            },
            Type::Fn(f) => {
                var i = 0usize;
                while i < f.quantified.len(&cx) {
                    if !is_brand(f.quantified.get(&cx, i).kind) {
                        self.fail_static(&cx, "function values quantify only brands");
                    }
                    i = i + 1usize;
                }
                var j = 0usize;
                while j < f.places.len(&cx) {
                    if f.places.get(&cx, j) >= f.params.len(&cx) {
                        self.fail_static(&cx, "function place index out of range");
                    }
                    j = j + 1usize;
                }
                let inner = self.extend(&cx, env, f.quantified);
                var k = 0usize;
                while k < f.params.len(&cx) {
                    self.fits(&cx, f.params.get(&cx, k), Kind::Any, inner);
                    k = k + 1usize;
                }
                self.fits(&cx, f.ret.get(&cx), Kind::Any, inner);
            },
            Type::Prim(name) => {
                if !C::is_prim(&cx, name) {
                    self.fail(&cx, Out::new(&cx).put(&cx, "unknown primitive ").add(&cx, name).done(&cx));
                }
            },
            // A length is never negative: it is unsigned.
            Type::Struct(fields) => self.components(&cx, ty, fields, env),
            Type::Enum(variants) => self.components(&cx, ty, variants, env),
            Type::Ignored => self.fail_static(&cx, "_ is only a retained fn brand argument"),
            Type::Ptr(_inner) => self.children_fit(&cx, ty, env),
            Type::Tuple(_elems) => self.children_fit(&cx, ty, env),
            Type::Array(_elem, _length) => self.children_fit(&cx, ty, env),
            Type::Never => self.children_fit(&cx, ty, env),
            _ => self.fail_static(&cx, "unknown type node"),
        }
        Kind::Any
    }

    fn components(self, &cx: Cx!['k], ty: Type['k], members: Seq[C::Member['k], 'k], env: Map[Text['k], Kind, 'k]) {
        let names: Set[Text['k], 'k] = Set::new(&cx);
        var i = 0usize;
        while i < members.len(&cx) {
            names.add(&cx, members.get(&cx, i).name);
            i = i + 1usize;
        }
        if names.len(&cx) != members.len(&cx) {
            self.fail_static(&cx, "duplicate component name");
        }
        self.children_fit(&cx, ty, env);
    }

    fn children_fit(self, &cx: Cx!['k], ty: Type['k], env: Map[Text['k], Kind, 'k]) {
        let parts = children(&cx, ty);
        var i = 0usize;
        while i < parts.len(&cx) {
            self.fits(&cx, parts.get(&cx, i), Kind::Any, env);
            i = i + 1usize;
        }
    }

    fn named(self, &cx: Cx!['k], name: Text['k], args: Seq[Type['k], 'k], env: Map[Text['k], Kind, 'k]) {
        let unit = match env.get(&cx, name) {
            Option::Some(k) => {
                if !args.is_empty(&cx) || is_brand(k) {
                    self.fail(&cx, Out::new(&cx).put(&cx, "invalid type parameter ").add(&cx, name).done(&cx));
                }
                return ();
            },
            Option::None => (),
        };
        let decl = match self.program.types.get(&cx, name) {
            Option::Some(d) => d,
            Option::None => self.fail(&cx, Out::new(&cx).put(&cx, "unknown type ").add(&cx, name).done(&cx)),
        };
        self.arguments(&cx, decl.params, args, env, false);
        let discharger = match self.discharge.get(&cx) {
            Option::Some(d) => d,
            Option::None => {
                return ();
            },
        };
        if decl.premises.is_empty(&cx) {
            return ();
        }
        var i = 0usize;
        while i < self.active.len(&cx) {
            let (n, previous) = self.active.get(&cx, i);
            if n.eq(&cx, name) && !nominal_descent(&cx, args, previous) {
                self.fail(&cx, Out::new(&cx).put(&cx, "non-descending nominal premise formation for ").add(&cx, name).done(&cx));
            }
            i = i + 1usize;
        }
        self.active.push(&cx, (name, args));
        let sub: Map[Text['k], Type['k], 'k] = Map::new(&cx);
        var j = 0usize;
        while j < decl.params.len(&cx) && j < args.len(&cx) {
            sub.set(&cx, decl.params.get(&cx, j).name, args.get(&cx, j));
            j = j + 1usize;
        }
        var k = 0usize;
        while k < decl.premises.len(&cx) {
            let p = decl.premises.get(&cx, k);
            let required_args: Seq[Type['k], 'k] = Seq::new(&cx);
            var a = 0usize;
            while a < p.args.len(&cx) {
                required_args.push(&cx, subst(&cx, p.args.get(&cx, a), sub, self.types.counter));
                a = a + 1usize;
            }
            let required = Premise.{ trait_name: p.trait_name, args: required_args };
            self.premise(&cx, required, env);
            if !Discharge[D, 'k]::discharge_premise(discharger, &cx, required, env, self.premises.get(&cx), self.home.get(&cx)) {
                self.fail(&cx, Out::new(&cx).put(&cx, "unsatisfied nominal premise ").add(&cx, required.trait_name).put(&cx, " for ").add(&cx, name).done(&cx));
            }
            k = k + 1usize;
        }
        let unit = self.active.pop(&cx);
    }

    fn function(self, &cx: Cx!['k], fun: Fun['k], outer: Seq[Param['k], 'k], premises: Seq[Premise['k], 'k]) {
        self.pos.set(&cx, fun.pos);
        let all_premises = concat_premises(&cx, premises, fun.premises);
        self.home.set(&cx, fun.home);
        self.premises.set(&cx, all_premises);
        let params = concat_params(&cx, outer, fun.params);
        let env = self.extend(&cx, with_kind(&cx, Map::new(&cx), text(&cx, "static"), Kind::Brand), params);
        var i = 0usize;
        while i < all_premises.len(&cx) {
            self.premise(&cx, all_premises.get(&cx, i), env);
            i = i + 1usize;
        }
        var j = 0usize;
        while j < fun.ptypes.len(&cx) {
            self.fits(&cx, fun.ptypes.get(&cx, j), Kind::Any, env);
            j = j + 1usize;
        }
        self.fits(&cx, fun.ret, Kind::Any, env);
        let generic_brands: Set[Text['k], 'k] = Set::new(&cx);
        var g = 0usize;
        while g < params.len(&cx) {
            if is_brand(params.get(&cx, g).kind) {
                generic_brands.add(&cx, params.get(&cx, g).name);
            }
            g = g + 1usize;
        }
        var l = 0usize;
        while l < fun.locals.len(&cx) {
            let t = fun.locals.get(&cx, l).type;
            let brands = free_brands(&cx, t).items(&cx);
            var b = 0usize;
            while b < brands.len(&cx) {
                if !generic_brands.has(&cx, brands.get(&cx, b)) {
                    self.fail_static(&cx, "local types may mention only function-generic free brands");
                }
                b = b + 1usize;
            }
            self.fits(&cx, t, Kind::Any, env);
            l = l + 1usize;
        }
        var n = 0usize;
        while n < fun.blocks.len(&cx) {
            self.block(&cx, fun.blocks.get(&cx, n), env);
            n = n + 1usize;
        }
    }

    fn block(self, &cx: Cx!['k], block: Block['k], env: Map[Text['k], Kind, 'k]) {
        self.pos.set(&cx, block.pos);
        var i = 0usize;
        while i < block.brands.len(&cx) {
            let rebinds = match env.get(&cx, block.brands.get(&cx, i)) {
                Option::Some(k) => is_brand(k),
                Option::None => false,
            };
            if rebinds {
                self.fail_static(&cx, "a block brand parameter cannot rebind a function brand");
            }
            i = i + 1usize;
        }
        var scope = self.extend(&cx, env, params_of(&cx, block.brands, Kind::Brand));
        var o = 0usize;
        while o < block.opened.len(&cx) {
            let view_brands = block.opened.get(&cx, o).brands;
            var v = 0usize;
            while v < view_brands.len(&cx) {
                self.fits(&cx, Type::Skolem.(view_brands.get(&cx, v)), Kind::Brand, scope);
                v = v + 1usize;
            }
            o = o + 1usize;
        }
        var p = 0usize;
        while p < block.params.len(&cx) {
            self.fits(&cx, block.params.get(&cx, p).type, Kind::Any, scope);
            p = p + 1usize;
        }
        var n = 0usize;
        while n < block.instrs.len(&cx) {
            let instr = block.instrs.get(&cx, n);
            self.pos.set(&cx, instr.pos);
            let unit = match instr.ty {
                Option::Some(t) => self.fits(&cx, t, Kind::Any, scope),
                Option::None => (),
            };
            let call = instr.op.is(&cx, "call") || instr.op.is(&cx, "fn");
            if call && self.program.funs.has(&cx, instr.args.get(&cx, 0usize)) {
                self.arguments(&cx, self.program.funs.at(&cx, instr.args.get(&cx, 0usize)).params, instr.tys, scope, instr.op.is(&cx, "fn"));
            } else if call && self.program.externs.has(&cx, instr.args.get(&cx, 0usize)) {
                self.arguments(&cx, Seq::new(&cx), instr.tys, scope, false);
            } else if instr.op.is(&cx, "foreach") && self.program.funs.has(&cx, instr.args.get(&cx, 1usize)) {
                let count = match instr.ty {
                    Option::Some(t) => match t {
                        Type::Foreach(f) => foreach_binders(&cx, f).len(&cx),
                        _ => 0usize,
                    },
                    Option::None => 0usize,
                };
                let mapper = self.program.funs.at(&cx, instr.args.get(&cx, 1usize));
                let leading = mapper.params.slice(&cx, 0usize, count);
                var q = 0usize;
                while q < leading.len(&cx) {
                    if is_brand(leading.get(&cx, q).kind) {
                        self.fail_static(&cx, "foreach binders require value parameters");
                    }
                    q = q + 1usize;
                }
                self.arguments(&cx, mapper.params.from(&cx, count), instr.tys, scope, false);
            } else if instr.op.is(&cx, "trait_call") {
                self.premise(&cx, Premise.{ trait_name: instr.args.get(&cx, 0usize), args: instr.tys }, scope);
            } else {
                var t = 0usize;
                while t < instr.tys.len(&cx) {
                    let unit = self.kind(&cx, instr.tys.get(&cx, t), scope);
                    t = t + 1usize;
                }
            }
            if instr.op.is(&cx, "open") {
                scope = self.extend(&cx, scope, params_of(&cx, instr.binders, Kind::Brand));
            }
            n = n + 1usize;
        }
        let edges: Seq[Edge['k], 'k] = Seq::new(&cx);
        let unit = match block.term {
            Terminator::Switch(_scrutinee, ty, arms, pos) => {
                self.pos.set(&cx, pos);
                self.fits(&cx, ty, Kind::Any, scope);
                var a = 0usize;
                while a < arms.len(&cx) {
                    edges.push(&cx, arms.get(&cx, a).edge);
                    a = a + 1usize;
                }
            },
            Terminator::Jnz(_cond, then, other, pos) => {
                self.pos.set(&cx, pos);
                edges.push(&cx, then);
                edges.push(&cx, other);
            },
            Terminator::Jmp(edge, pos) => {
                self.pos.set(&cx, pos);
                edges.push(&cx, edge);
            },
            Terminator::Ret(_value, pos) => self.pos.set(&cx, pos),
            Terminator::Unreachable(pos) => self.pos.set(&cx, pos),
        };
        var e = 0usize;
        while e < edges.len(&cx) {
            let tys = edges.get(&cx, e).tys;
            var t = 0usize;
            while t < tys.len(&cx) {
                self.fits(&cx, tys.get(&cx, t), Kind::Brand, scope);
                t = t + 1usize;
            }
            e = e + 1usize;
        }
    }

    fn declarations(self, &cx: Cx!['k]) {
        let env = with_kind(&cx, Map::new(&cx), text(&cx, "static"), Kind::Brand);
        let decls = self.program.types.values(&cx);
        var i = 0usize;
        while i < decls.len(&cx) {
            let decl = decls.get(&cx, i);
            self.home.set(&cx, decl.home);
            self.premises.set(&cx, decl.premises);
            let scope = self.extend(&cx, env, decl.params);
            var p = 0usize;
            while p < decl.premises.len(&cx) {
                self.premise(&cx, decl.premises.get(&cx, p), scope);
                p = p + 1usize;
            }
            self.fits(&cx, decl.body, Kind::Any, scope);
            i = i + 1usize;
        }
        let traits = self.program.traits.values(&cx);
        var t = 0usize;
        while t < traits.len(&cx) {
            let tr = traits.get(&cx, t);
            self.home.set(&cx, tr.home);
            self.premises.set(&cx, Seq::new(&cx));
            let scope = self.extend(&cx, env, self.trait_params(&cx, tr));
            var m = 0usize;
            while m < tr.methods.len(&cx) {
                let method = tr.methods.get(&cx, m);
                var k = 0usize;
                while k < method.ptypes.len(&cx) {
                    self.fits(&cx, method.ptypes.get(&cx, k), Kind::Any, scope);
                    k = k + 1usize;
                }
                self.fits(&cx, method.ret, Kind::Any, scope);
                m = m + 1usize;
            }
            t = t + 1usize;
        }
        let groups = self.program.instances.values(&cx);
        var g = 0usize;
        while g < groups.len(&cx) {
            let insts = groups.get(&cx, g);
            var n = 0usize;
            while n < insts.len(&cx) {
                let inst = insts.get(&cx, n);
                self.pos.set(&cx, inst.pos);
                self.home.set(&cx, inst.home);
                self.premises.set(&cx, inst.premises);
                let scope = self.extend(&cx, env, inst.params);
                self.premise(&cx, Premise.{ trait_name: inst.trait_name, args: inst.head }, scope);
                var p = 0usize;
                while p < inst.premises.len(&cx) {
                    self.premise(&cx, inst.premises.get(&cx, p), scope);
                    p = p + 1usize;
                }
                n = n + 1usize;
            }
            g = g + 1usize;
        }
        self.home.set(&cx, Option::None);
        self.premises.set(&cx, Seq::new(&cx));
        let externs = self.program.externs.values(&cx);
        var x = 0usize;
        while x < externs.len(&cx) {
            let ext = externs.get(&cx, x);
            self.pos.set(&cx, ext.pos);
            let unit = match ext.ret {
                Option::None => self.fail_static(&cx, "extern requires a type"),
                Option::Some(ret) => {
                    let unit = match ext.ptypes {
                        Option::Some(ptypes) => {
                            var k = 0usize;
                            while k < ptypes.len(&cx) {
                                self.fits(&cx, ptypes.get(&cx, k), Kind::Any, env);
                                k = k + 1usize;
                            }
                        },
                        Option::None => (),
                    };
                    self.fits(&cx, ret, Kind::Any, env);
                },
            };
            x = x + 1usize;
        }
        let datas = self.program.datas.values(&cx);
        var d = 0usize;
        while d < datas.len(&cx) {
            let data = datas.get(&cx, d);
            self.home.set(&cx, data.home);
            self.pos.set(&cx, no_pos());
            self.fits(&cx, data.ty, Kind::Any, env);
            d = d + 1usize;
        }
    }
}
