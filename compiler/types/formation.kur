// Type formation: Γ ⊢ T : kind. Nominal types are checked without unfolding.
//
// This pass validates written contracts, not recursive layout or trait coherence. Premises are
// checked for formation here and discharged by the assertion checker.

use std::collections::arena_vec::ArenaVec;
use std::collections::arena_map::{ArenaMap, ArenaSet};
use std::mem::Ref;
use std::raw::Span;
use std::arena::{Domain!, ref_in};
use std::buffer::Buffer!;
use package::kurs::core::{Block, Edge, Fun, Kind, ModuleId, Param, Premise, Program, Terminator, Trait, Type, TypeDecl};
use package::kurs::core as C;
use package::resolve::resolver::Resolver;
use package::syntax::ast::{Pos, no_pos};
use package::types::layout::check_written_type;
use package::types::ops::{Fresh, Types, children, equal, free_brands, free_names, kind_name, kurs_error, show, strict_subterm, subst, walk, walk_into, with_names};
use std::option::Option;
use std::slice::Slice;

// Componentwise subterms, with at least one strict component.
forall 'k.
fn nominal_descent(&cx: Domain!['k], args: ArenaVec[Type['k], 'k], previous: ArenaVec[Type['k], 'k]) -> bool {
    if args.len(&cx) != previous.len(&cx) {
        return false;
    }
    var all = true;
    var any = false;
    var i = 0usize;
    while i < args.len(&cx) {
        let strict = strict_subterm(&cx, args.at(&cx, i), previous.at(&cx, i));
        all = all && (equal(&cx, args.at(&cx, i), previous.at(&cx, i)) || strict);
        any = any || strict;
        i = i + 1usize;
    }
    all && any
}

// A reference to one brand, respecting nested brand binders.
forall 'k.
fn brand_occurs(&cx: Domain!['k], ty: Type['k], label: Span['k]) -> bool {
    let unit = match ty {
        Skolem(found) => {
            return found.eq(&cx, label);
        },
        Exists(binders, _body) => {
            if binders.contains(&cx, label) {
                return false;
            }
        },
        _ => (),
    };
    let parts = children(&cx, ty);
    var found = false;
    var i = 0usize;
    while !found && i < parts.len(&cx) {
        found = brand_occurs(&cx, parts.at(&cx, i), label);
        i = i + 1usize;
    }
    found
}

// Discharges a premise that a nominal type's declaration requires, under the parameter kinds,
// assumptions and module of the declaration being formed. The assertion checker provides one.
forall D, 'k.
trait Discharge {
    fn discharge_premise(discharger: D, &cx: Domain!['k], premise: Premise['k], env: ArenaMap[Span['k], Kind, 'k], premises: ArenaVec[Premise['k], 'k], home: Option[ModuleId['k]]) -> bool;
}

// A formation that discharges nothing: its `discharge` stays none.
exposed struct NoDischarge {
    unused: bool,
}

forall 'k.
instance Discharge[NoDischarge, 'k] {
    fn discharge_premise(discharger: NoDischarge, &cx: Domain!['k], premise: Premise['k], env: ArenaMap[Span['k], Kind, 'k], premises: ArenaVec[Premise['k], 'k], home: Option[ModuleId['k]]) -> bool {
        false
    }
}

forall D, 'k.
exposed struct Formation {
    program: Program['k],
    types: Types['k],
    pos: Ref[Pos, 'k],
    discharge: Ref[Option[D], 'k],
    premises: Ref[ArenaVec[Premise['k], 'k], 'k],
    home: Ref[Option[ModuleId['k]], 'k],
    // nominal types whose premises are being formed, with their arguments and the number of binders
    // `opened` held when each began: a binder opened since is a different variable from any name its
    // arguments mention, however it is spelled
    active: ArenaVec[(Span['k], ArenaVec[Type['k], 'k], usize), 'k],
    opened: ArenaVec[Span['k], 'k],
    // the resolver that locates errors, when a declaration's file is known
    reporter: Ref[Option[Resolver['k]], 'k],
    // the type declaration being formed: it has no position of its own, so its name says where
    declaration: Ref[Option[Span['k]], 'k],
    // off while the declarations are being formed (`declarations`)
    sizes: Ref[bool, 'k],
}

forall 'k.
fn with_kind(&cx: Domain!['k], env: ArenaMap[Span['k], Kind, 'k], name: Span['k], kind: Kind) -> ArenaMap[Span['k], Kind, 'k] {
    let out = env.clone(&cx);
    out.insert(&cx, name, kind);
    out
}

fn is_brand(kind: Kind) -> bool {
    C::same_kind(kind, Kind::Brand)
}

// The arguments of `premises`, in order.
forall 'k.
fn premise_args(&cx: Domain!['k], premises: ArenaVec[Premise['k], 'k]) -> ArenaVec[Type['k], 'k] {
    let out: ArenaVec[Type['k], 'k] = ArenaVec::new(&cx);
    var i = 0usize;
    while i < premises.len(&cx) {
        out.append(&cx, premises.at(&cx, i).args);
        i = i + 1usize;
    }
    out
}

forall 'k.
fn params_of(&cx: Domain!['k], names: ArenaVec[Span['k], 'k], kind: Kind) -> ArenaVec[Param['k], 'k] {
    let out: ArenaVec[Param['k], 'k] = ArenaVec::new(&cx);
    var i = 0usize;
    while i < names.len(&cx) {
        out.push(&cx, Param.{ name: names.at(&cx, i), kind });
        i = i + 1usize;
    }
    out
}


forall D, 'k where Copy[D], Discharge[D, 'k].
impl Formation[D, 'k] {
    fn new(&cx: Domain!['k], program: Program['k], counter: Fresh['k]) -> Formation[D, 'k] {
        Formation.{
            program,
            types: Types::new(&cx, program, counter),
            pos: ref_in(&cx, no_pos()),
            discharge: ref_in(&cx, Option::None),
            premises: ref_in(&cx, ArenaVec::new(&cx)),
            home: ref_in(&cx, Option::None),
            active: ArenaVec::new(&cx),
            opened: ArenaVec::new(&cx),
            reporter: ref_in(&cx, Option::None),
            declaration: ref_in(&cx, Option::None),
            sizes: ref_in(&cx, true),
        }
    }

    fn fail(self, &cx: Domain!['k], message: Span['k]) -> ! {
        let full = match self.declaration.copy(&cx) {
            Some(name) => Buffer!::new().push_static("type formation: ").push_bytes(&cx, message).push_static(" in type ").push_bytes(&cx, name).save(&cx),
            None => Buffer!::new().push_static("type formation: ").push_bytes(&cx, message).save(&cx),
        };
        match self.reporter.copy(&cx) {
            Some(r) => r.fail(&cx, full, self.pos.copy(&cx)),
            None => kurs_error(&cx, full, self.pos.copy(&cx)),
        }
    }

    fn fail_static(self, &cx: Domain!['k], message: Slice[u8, 'static]) -> ! {
        self.fail(&cx, Span::from_static(&cx, message))
    }

    fn extend(self, &cx: Domain!['k], env: ArenaMap[Span['k], Kind, 'k], params: ArenaVec[Param['k], 'k]) -> ArenaMap[Span['k], Kind, 'k] {
        let names: ArenaSet[Span['k], 'k] = ArenaSet::new(&cx);
        var i = 0usize;
        while i < params.len(&cx) {
            names.insert(&cx, params.at(&cx, i).name);
            i = i + 1usize;
        }
        if names.len(&cx) != params.len(&cx) {
            self.fail_static(&cx, "duplicate parameter");
        }
        if names.contains(&cx, Span::from_static(&cx, "static")) {
            self.fail_static(&cx, "static is not a parameter name");
        }
        // A parameter is a variable everywhere, but a name a declaration also has would read as that
        // declaration wherever a type is unfolded.
        var d = 0usize;
        while d < params.len(&cx) {
            let name = params.at(&cx, d).name;
            if self.program.types.contains(&cx, name) {
                self.fail(&cx, Buffer!::new().push_bytes(&cx, name).push_static(" is a declared type, not a parameter name").save(&cx));
            }
            d = d + 1usize;
        }
        // A `Kind` is one of the three kinds by construction.
        let out = env.clone(&cx);
        var j = 0usize;
        while j < params.len(&cx) {
            out.insert(&cx, params.at(&cx, j).name, params.at(&cx, j).kind);
            j = j + 1usize;
        }
        out
    }

    fn fits(self, &cx: Domain!['k], ty: Type['k], want: Kind, env: ArenaMap[Span['k], Kind, 'k]) {
        let got = self.kind(&cx, ty, env);
        if is_brand(got) != is_brand(want) {
            self.fail(&cx, Buffer!::new().push_static("expected ").push_bytes(&cx, kind_name(&cx, want)).push_static(" argument").save(&cx));
        }
        if C::same_kind(want, Kind::Copy) && !self.types.is_copy(&cx, ty, env) {
            self.fail_static(&cx, "expected Copy argument");
        }
    }

    fn arguments(self, &cx: Domain!['k], params: ArenaVec[Param['k], 'k], args: ArenaVec[Type['k], 'k], env: ArenaMap[Span['k], Kind, 'k]) {
        if params.len(&cx) != args.len(&cx) {
            self.fail_static(&cx, "wrong number of type arguments");
        }
        var i = 0usize;
        while i < params.len(&cx) {
            let param = params.at(&cx, i);
            let arg = args.at(&cx, i);
            self.fits(&cx, arg, param.kind, env);
            i = i + 1usize;
        }
    }

    fn premise(self, &cx: Domain!['k], premise: Premise['k], env: ArenaMap[Span['k], Kind, 'k]) {
        let params = if premise.trait_name.is(&cx, "Exposed") || premise.trait_name.is(&cx, "Sized") {
            ArenaVec::one(&cx, Param.{ name: Span::from_static(&cx, "T"), kind: Kind::Any })
        } else {
            match self.program.traits.get(&cx, premise.trait_name) {
                Some(t) => self.trait_params(&cx, t),
                None => self.fail(&cx, Buffer!::new().push_static("unknown trait ").push_bytes(&cx, premise.trait_name).save(&cx)),
            }
        };
        self.arguments(&cx, params, premise.args, env);
    }

    fn trait_params(self, &cx: Domain!['k], t: Trait['k]) -> ArenaVec[Param['k], 'k] {
        let kinds: ArenaVec[Kind, 'k] = if t.param_kinds.is_empty(&cx) {
            let all: ArenaVec[Kind, 'k] = ArenaVec::new(&cx);
            var i = 0usize;
            while i < t.params.len(&cx) {
                all.push(&cx, Kind::Any);
                i = i + 1usize;
            }
            all
        } else {
            t.param_kinds
        };
        if kinds.len(&cx) != t.params.len(&cx) {
            self.fail_static(&cx, "trait parameter kinds disagree");
        }
        let out: ArenaVec[Param['k], 'k] = ArenaVec::new(&cx);
        var j = 0usize;
        while j < kinds.len(&cx) {
            out.push(&cx, Param.{ name: t.params.at(&cx, j), kind: kinds.at(&cx, j) });
            j = j + 1usize;
        }
        out
    }

    // Validate structure and distinguish brands from values; fits refines Copy.
    fn kind(self, &cx: Domain!['k], ty: Type['k], env: ArenaMap[Span['k], Kind, 'k]) -> Kind {
        match ty {
            Skolem(label) => {
                let in_scope = match env.get(&cx, label) {
                    Some(k) => is_brand(k),
                    None => false,
                };
                if !in_scope {
                    self.fail(&cx, Buffer!::new().push_static("brand ").push_bytes(&cx, label).push_static(" is not in scope").save(&cx));
                }
                return Kind::Brand;
            },
            Named(name, args) => self.named(&cx, name, args, env),
            Brand(brand) => self.fits(&cx, brand.copy(&cx), Kind::Brand, env),
            Exists(binders, body) => {
                if binders.is_empty(&cx) {
                    self.fail_static(&cx, "existential requires at least one brand binder");
                }
                let inner = self.extend(&cx, env, params_of(&cx, binders, Kind::Brand));
                let unit = match body.copy(&cx) {
                    Exists(_b, _t) => self.fail_static(&cx, "nested existential binders must be flattened"),
                    _ => (),
                };
                var i = 0usize;
                while i < binders.len(&cx) {
                    if !brand_occurs(&cx, body.copy(&cx), binders.at(&cx, i)) {
                        self.fail_static(&cx, "existential brand binder is unused");
                    }
                    i = i + 1usize;
                }
                let mark = self.opened.len(&cx);
                self.opened.append(&cx, binders);
                self.fits(&cx, body.copy(&cx), Kind::Any, inner);
                self.opened.truncate(&cx, mark);
            },
            Foreach(f) => {
                self.fits(&cx, f.source.copy(&cx), Kind::Any, env);
                // The type has an expansion only if every component is a pointer for `*F` to match,
                // and it must have one at every instantiation: a source whose shape is decided shows
                // its pointers as written. Where a type parameter decides it, the walk asks for an
                // explicit pointer.
                if f.indirect && self.types.rows_fixed(&cx, f.source.copy(&cx), true, env) && !self.types.pattern_available(&cx, f) {
                    self.fail(&cx, Buffer!::new().push_static("foreach *").push_bytes(&cx, f.binder).push_static(" needs a source written with pointer components").save(&cx));
                }
                let names = ArenaVec::one(&cx, f.binder);
                let mark = self.opened.len(&cx);
                self.opened.append(&cx, names);
                self.fits(&cx, f.body.copy(&cx), Kind::Any, self.extend(&cx, env, params_of(&cx, names, Kind::Any)));
                self.opened.truncate(&cx, mark);
                match check_written_type(&cx, self.program, self.types.counter, ty, with_names(&cx, ArenaSet::new(&cx), env.keys(&cx))) {
                    Ok(_u) => (),
                    Err(message) => self.fail(&cx, message),
                }
            },
            Fn(f) => {
                var j = 0usize;
                while j < f.places.len(&cx) {
                    if f.places.at(&cx, j) >= f.params.len(&cx) {
                        self.fail_static(&cx, "function place index out of range");
                    }
                    j = j + 1usize;
                }
                var k = 0usize;
                while k < f.params.len(&cx) {
                    self.fits(&cx, f.params.at(&cx, k), Kind::Any, env);
                    k = k + 1usize;
                }
                self.fits(&cx, f.ret.copy(&cx), Kind::Any, env);
            },
            Prim(name) => {
                if !C::is_prim(&cx, name) {
                    self.fail(&cx, Buffer!::new().push_static("unknown primitive ").push_bytes(&cx, name).save(&cx));
                }
            },
            // A length is never negative: it is unsigned.
            Struct(fields) => self.components(&cx, ty, fields, env),
            Enum(variants) => {
                if variants.is_empty(&cx) {
                    self.fail_static(&cx, "an enum has at least one variant");
                }
                self.components(&cx, ty, variants, env);
            },
            Ptr(_inner) => self.children_fit(&cx, ty, env),
            NonNull(_inner) => self.children_fit(&cx, ty, env),
            Tuple(_elems) => self.children_fit(&cx, ty, env),
            Array(_elem, _length) => self.children_fit(&cx, ty, env),
            Never => self.children_fit(&cx, ty, env),
            _ => self.fail_static(&cx, "unknown type node"),
        }
        if self.sizes.copy(&cx) {
            self.sized(&cx, ty);
        }
        Kind::Any
    }

    // A closed type's size is below 2^64, the target's address space. A type that
    // mentions a parameter is checked at each instantiation: where it is written closed, and in the
    // backend's specializations.
    fn sized(self, &cx: Domain!['k], ty: Type['k]) {
        if self.types.closed(&cx, ty) && self.types.layout(&cx, ty).is_none() {
            self.fail(&cx, Buffer!::new().push_bytes(&cx, show(&cx, ty)).push_static(" is too large: its size is not below 2^64 bytes").save(&cx));
        }
    }

    fn components(self, &cx: Domain!['k], ty: Type['k], members: ArenaVec[C::Member['k], 'k], env: ArenaMap[Span['k], Kind, 'k]) {
        let names: ArenaSet[Span['k], 'k] = ArenaSet::new(&cx);
        var i = 0usize;
        while i < members.len(&cx) {
            names.insert(&cx, members.at(&cx, i).name);
            i = i + 1usize;
        }
        if names.len(&cx) != members.len(&cx) {
            self.fail_static(&cx, "duplicate component name");
        }
        self.children_fit(&cx, ty, env);
    }

    // Each child of `ty` fits as a value type.
    fn children_fit(self, &cx: Domain!['k], ty: Type['k], env: ArenaMap[Span['k], Kind, 'k]) {
        let parts = children(&cx, ty);
        var i = 0usize;
        while i < parts.len(&cx) {
            self.fits(&cx, parts.at(&cx, i), Kind::Any, env);
            i = i + 1usize;
        }
    }

    fn named(self, &cx: Domain!['k], name: Span['k], args: ArenaVec[Type['k], 'k], env: ArenaMap[Span['k], Kind, 'k]) {
        let unit = match env.get(&cx, name) {
            Some(k) => {
                if !args.is_empty(&cx) || is_brand(k) {
                    self.fail(&cx, Buffer!::new().push_static("invalid type parameter ").push_bytes(&cx, name).save(&cx));
                }
                return ();
            },
            None => (),
        };
        let decl = match self.program.types.get(&cx, name) {
            Some(d) => d,
            None => self.fail(&cx, Buffer!::new().push_static("unknown type ").push_bytes(&cx, name).save(&cx)),
        };
        self.arguments(&cx, decl.params, args, env);
        let discharger = match self.discharge.copy(&cx) {
            Some(d) => d,
            None => {
                return ();
            },
        };
        if decl.premises.is_empty(&cx) {
            return ();
        }
        var i = 0usize;
        while i < self.active.len(&cx) {
            let (n, previous, depth) = self.active.at(&cx, i);
            if n.eq(&cx, name) && (self.mentions_opened_since(&cx, args, depth) || !nominal_descent(&cx, args, previous)) {
                self.fail(&cx, Buffer!::new().push_static("the premises of ").push_bytes(&cx, name).push_static(" require ").push_bytes(&cx, name)
                    .push_static(" again at arguments that are not smaller").save(&cx));
            }
            i = i + 1usize;
        }
        self.active.push(&cx, (name, args, self.opened.len(&cx)));
        let sub: ArenaMap[Span['k], Type['k], 'k] = ArenaMap::new(&cx);
        var j = 0usize;
        while j < decl.params.len(&cx) && j < args.len(&cx) {
            sub.insert(&cx, decl.params.at(&cx, j).name, args.at(&cx, j));
            j = j + 1usize;
        }
        var k = 0usize;
        while k < decl.premises.len(&cx) {
            let p = decl.premises.at(&cx, k);
            let required_args: ArenaVec[Type['k], 'k] = ArenaVec::new(&cx);
            var a = 0usize;
            while a < p.args.len(&cx) {
                required_args.push(&cx, subst(&cx, p.args.at(&cx, a), sub, self.types.counter));
                a = a + 1usize;
            }
            let required = Premise.{ trait_name: p.trait_name, args: required_args };
            self.premise(&cx, required, env);
            if !Discharge[D, 'k]::discharge_premise(discharger, &cx, required, env, self.premises.copy(&cx), self.home.copy(&cx)) {
                self.fail(&cx, Buffer!::new().push_static("unsatisfied nominal premise ").push_bytes(&cx, required.trait_name).push_static(" for ").push_bytes(&cx, name).save(&cx));
            }
            k = k + 1usize;
        }
        let unit = self.active.pop(&cx);
    }

    // Whether `args` mention a binder opened after the first `depth` of `opened`.
    fn mentions_opened_since(self, &cx: Domain!['k], args: ArenaVec[Type['k], 'k], depth: usize) -> bool {
        var a = 0usize;
        while a < args.len(&cx) {
            let names = free_names(&cx, args.at(&cx, a));
            var i = depth;
            while i < self.opened.len(&cx) {
                if names.contains(&cx, self.opened.at(&cx, i)) {
                    return true;
                }
                i = i + 1usize;
            }
            a = a + 1usize;
        }
        false
    }

    // A package type binds no brand in scope where it is written, which `env`
    // holds, nor one an enclosing package binds. A type the checker derives, as by unfolding a
    // declaration, was checked where it is written.
    fn written(self, &cx: Domain!['k], types: ArenaVec[Type['k], 'k], env: ArenaMap[Span['k], Kind, 'k]) {
        var i = 0usize;
        while i < types.len(&cx) {
            let ty = types.at(&cx, i);
            let unit = match ty {
                Exists(binders, body) => {
                    var b = 0usize;
                    while b < binders.len(&cx) {
                        let shadows = match env.get(&cx, binders.at(&cx, b)) {
                            Some(k) => is_brand(k),
                            None => false,
                        };
                        if shadows {
                            self.fail_static(&cx, "an existential brand binder shadows a brand in scope");
                        }
                        b = b + 1usize;
                    }
                    self.written(&cx, ArenaVec::one(&cx, body.copy(&cx)), self.extend(&cx, env, params_of(&cx, binders, Kind::Brand)));
                },
                _ => self.written(&cx, children(&cx, ty), env),
            };
            i = i + 1usize;
        }
    }

    fn function(self, &cx: Domain!['k], fun: Fun['k], outer: ArenaVec[Param['k], 'k], premises: ArenaVec[Premise['k], 'k]) {
        self.pos.set(&cx, fun.pos);
        let all_premises = premises.concat(&cx, fun.premises);
        self.home.set(&cx, fun.home);
        self.premises.set(&cx, all_premises);
        let params = outer.concat(&cx, fun.params);
        let env = self.extend(&cx, with_kind(&cx, ArenaMap::new(&cx), Span::from_static(&cx, "static"), Kind::Brand), params);
        var i = 0usize;
        while i < all_premises.len(&cx) {
            self.premise(&cx, all_premises.at(&cx, i), env);
            self.written(&cx, all_premises.at(&cx, i).args, env);
            i = i + 1usize;
        }
        var j = 0usize;
        while j < fun.ptypes.len(&cx) {
            self.fits(&cx, fun.ptypes.at(&cx, j), Kind::Any, env);
            j = j + 1usize;
        }
        self.fits(&cx, fun.ret, Kind::Any, env);
        let signature = fun.ptypes.clone(&cx);
        signature.push(&cx, fun.ret);
        self.written(&cx, signature, env);
        let generic_brands: ArenaSet[Span['k], 'k] = ArenaSet::new(&cx);
        var g = 0usize;
        while g < params.len(&cx) {
            if is_brand(params.at(&cx, g).kind) {
                generic_brands.insert(&cx, params.at(&cx, g).name);
            }
            g = g + 1usize;
        }
        var l = 0usize;
        while l < fun.locals.len(&cx) {
            let t = fun.locals.at(&cx, l).type;
            let brands = free_brands(&cx, t).keys(&cx);
            var b = 0usize;
            while b < brands.len(&cx) {
                if !generic_brands.contains(&cx, brands.at(&cx, b)) {
                    self.fail_static(&cx, "local types may mention only function-generic free brands");
                }
                b = b + 1usize;
            }
            self.fits(&cx, t, Kind::Any, env);
            self.written(&cx, ArenaVec::one(&cx, t), env);
            l = l + 1usize;
        }
        var n = 0usize;
        while n < fun.blocks.len(&cx) {
            self.block(&cx, fun.blocks.at(&cx, n), env);
            n = n + 1usize;
        }
    }

    fn block(self, &cx: Domain!['k], block: Block['k], env: ArenaMap[Span['k], Kind, 'k]) {
        self.pos.set(&cx, block.pos);
        var i = 0usize;
        while i < block.brands.len(&cx) {
            let rebinds = match env.get(&cx, block.brands.at(&cx, i)) {
                Some(k) => is_brand(k),
                None => false,
            };
            if rebinds {
                self.fail_static(&cx, "a block brand parameter cannot rebind a function brand");
            }
            i = i + 1usize;
        }
        var scope = self.extend(&cx, env, params_of(&cx, block.brands, Kind::Brand));
        var o = 0usize;
        while o < block.opened.len(&cx) {
            let view_brands = block.opened.at(&cx, o).brands;
            var v = 0usize;
            while v < view_brands.len(&cx) {
                self.fits(&cx, Type::Skolem.(view_brands.at(&cx, v)), Kind::Brand, scope);
                v = v + 1usize;
            }
            o = o + 1usize;
        }
        let params: ArenaVec[Type['k], 'k] = ArenaVec::new(&cx);
        var p = 0usize;
        while p < block.params.len(&cx) {
            self.fits(&cx, block.params.at(&cx, p).type, Kind::Any, scope);
            params.push(&cx, block.params.at(&cx, p).type);
            p = p + 1usize;
        }
        self.written(&cx, params, scope);
        var n = 0usize;
        while n < block.instrs.len(&cx) {
            let instr = block.instrs.at(&cx, n);
            self.pos.set(&cx, instr.pos);
            let unit = match instr.ty {
                Some(t) => {
                    self.fits(&cx, t, Kind::Any, scope);
                    self.written(&cx, ArenaVec::one(&cx, t), scope);
                },
                None => (),
            };
            let call = instr.op.is(&cx, "call") || instr.op.is(&cx, "fn");
            if call && self.program.funs.contains(&cx, instr.args.at(&cx, 0usize)) {
                self.arguments(&cx, self.program.funs.at(&cx, instr.args.at(&cx, 0usize)).params, instr.tys, scope);
            } else if call && (self.program.externs.contains(&cx, instr.args.at(&cx, 0usize)) || instr.args.at(&cx, 0usize).starts_with(&cx, Span::from_static(&cx, "%"))) {
                self.arguments(&cx, ArenaVec::new(&cx), instr.tys, scope);
            } else if instr.op.is(&cx, "foreach") && self.program.funs.contains(&cx, instr.args.at(&cx, 1usize)) {
                let count = match instr.ty {
                    Some(t) => match t {
                        Foreach(_f) => 1usize,
                        _ => 0usize,
                    },
                    None => 0usize,
                };
                let mapper = self.program.funs.at(&cx, instr.args.at(&cx, 1usize));
                let leading = mapper.params.slice(&cx, 0usize, count);
                var q = 0usize;
                while q < leading.len(&cx) {
                    if is_brand(leading.at(&cx, q).kind) {
                        self.fail_static(&cx, "the foreach binder requires a value parameter");
                    }
                    q = q + 1usize;
                }
                self.arguments(&cx, mapper.params.skip(&cx, count), instr.tys, scope);
            } else if instr.op.is(&cx, "trait_call") {
                self.premise(&cx, Premise.{ trait_name: instr.args.at(&cx, 0usize), args: instr.tys }, scope);
            } else {
                var t = 0usize;
                while t < instr.tys.len(&cx) {
                    let unit = self.kind(&cx, instr.tys.at(&cx, t), scope);
                    t = t + 1usize;
                }
            }
            self.written(&cx, instr.tys, scope);
            if instr.op.is(&cx, "open") {
                scope = self.extend(&cx, scope, params_of(&cx, instr.binders, Kind::Brand));
            }
            n = n + 1usize;
        }
        let edges: ArenaVec[Edge['k], 'k] = ArenaVec::new(&cx);
        let unit = match block.term {
            Switch(_scrutinee, ty, arms, pos) => {
                self.pos.set(&cx, pos);
                self.fits(&cx, ty, Kind::Any, scope);
                self.written(&cx, ArenaVec::one(&cx, ty), scope);
                var a = 0usize;
                while a < arms.len(&cx) {
                    edges.push(&cx, arms.at(&cx, a).edge);
                    a = a + 1usize;
                }
            },
            Jnz(_cond, then, other, pos) => {
                self.pos.set(&cx, pos);
                edges.push(&cx, then);
                edges.push(&cx, other);
            },
            Jmp(edge, pos) => {
                self.pos.set(&cx, pos);
                edges.push(&cx, edge);
            },
            Ret(_value, pos) => self.pos.set(&cx, pos),
            Unreachable(pos) => self.pos.set(&cx, pos),
        };
        var e = 0usize;
        while e < edges.len(&cx) {
            let tys = edges.at(&cx, e).tys;
            var t = 0usize;
            while t < tys.len(&cx) {
                self.fits(&cx, tys.at(&cx, t), Kind::Brand, scope);
                t = t + 1usize;
            }
            e = e + 1usize;
        }
    }

    // A type whose name has no `!` is not linear for every instantiation: it is Copy when its type
    // arguments are.
    fn unmarked(self, &cx: Domain!['k], decl: TypeDecl['k]) {
        if decl.linear(&cx) {
            return;
        }
        let args: ArenaVec[Type['k], 'k] = ArenaVec::new(&cx);
        let kinds: ArenaMap[Span['k], Kind, 'k] = ArenaMap::new(&cx);
        var generic = false;
        var i = 0usize;
        while i < decl.params.len(&cx) {
            let p = decl.params.at(&cx, i);
            if is_brand(p.kind) {
                args.push(&cx, Type::Skolem.(p.name));
            } else {
                args.push(&cx, C::named(p.name, ArenaVec::new(&cx)));
                kinds.insert(&cx, p.name, Kind::Copy);
                generic = true;
            }
            i = i + 1usize;
        }
        if !self.types.is_copy(&cx, C::named(decl.name, args), kinds) {
            self.fail(&cx, Buffer!::new().push_static("type ").push_bytes(&cx, decl.name).push_static(" holds a linear type")
                .push_static(if generic { " whatever its type arguments" } else { "" }).push_static("; declare it ").push_bytes(&cx, decl.name).push_static("!").save(&cx));
        }
    }

    fn declarations(self, &cx: Domain!['k]) {
        let env = with_kind(&cx, ArenaMap::new(&cx), Span::from_static(&cx, "static"), Kind::Brand);
        let decls = self.program.types.values(&cx);
        // A size unfolds other declarations, so the closed parts of each are sized once all are formed.
        self.sizes.set(&cx, false);
        var i = 0usize;
        while i < decls.len(&cx) {
            let decl = decls.at(&cx, i);
            self.home.set(&cx, decl.home);
            self.premises.set(&cx, decl.premises);
            self.declaration.set(&cx, Option::Some.(decl.name));
            let scope = self.extend(&cx, env, decl.params);
            var p = 0usize;
            while p < decl.premises.len(&cx) {
                if decl.premises.at(&cx, p).trait_name.is(&cx, "Sized") {
                    self.fail(&cx, Span::from_static(&cx, "Sized is not a premise of a type declaration"));
                }
                self.premise(&cx, decl.premises.at(&cx, p), scope);
                p = p + 1usize;
            }
            self.fits(&cx, decl.body, Kind::Any, scope);
            let parts = ArenaVec::one(&cx, decl.body);
            parts.append(&cx, premise_args(&cx, decl.premises));
            self.written(&cx, parts, scope);
            i = i + 1usize;
        }
        self.sizes.set(&cx, true);
        var d = 0usize;
        while d < decls.len(&cx) {
            let decl = decls.at(&cx, d);
            self.declaration.set(&cx, Option::Some.(decl.name));
            let parts = walk(&cx, decl.body);
            var p = 0usize;
            while p < decl.premises.len(&cx) {
                let args = decl.premises.at(&cx, p).args;
                var a = 0usize;
                while a < args.len(&cx) {
                    walk_into(&cx, args.at(&cx, a), parts);
                    a = a + 1usize;
                }
                p = p + 1usize;
            }
            var w = 0usize;
            while w < parts.len(&cx) {
                self.sized(&cx, parts.at(&cx, w));
                w = w + 1usize;
            }
            d = d + 1usize;
        }
        self.declaration.set(&cx, Option::None);
        var u = 0usize;
        while u < decls.len(&cx) {
            self.unmarked(&cx, decls.at(&cx, u));
            u = u + 1usize;
        }
        let traits = self.program.traits.values(&cx);
        var t = 0usize;
        while t < traits.len(&cx) {
            let tr = traits.at(&cx, t);
            self.home.set(&cx, tr.home);
            self.premises.set(&cx, ArenaVec::new(&cx));
            let scope = self.extend(&cx, env, self.trait_params(&cx, tr));
            var m = 0usize;
            while m < tr.methods.len(&cx) {
                let method = tr.methods.at(&cx, m);
                var k = 0usize;
                while k < method.ptypes.len(&cx) {
                    self.fits(&cx, method.ptypes.at(&cx, k), Kind::Any, scope);
                    k = k + 1usize;
                }
                self.fits(&cx, method.ret, Kind::Any, scope);
                let signature = method.ptypes.clone(&cx);
                signature.push(&cx, method.ret);
                self.written(&cx, signature, scope);
                m = m + 1usize;
            }
            t = t + 1usize;
        }
        let groups = self.program.instances.values(&cx);
        var g = 0usize;
        while g < groups.len(&cx) {
            let insts = groups.at(&cx, g);
            var n = 0usize;
            while n < insts.len(&cx) {
                let inst = insts.at(&cx, n);
                self.pos.set(&cx, inst.pos);
                self.home.set(&cx, inst.home);
                self.premises.set(&cx, inst.premises);
                let scope = self.extend(&cx, env, inst.params);
                self.premise(&cx, Premise.{ trait_name: inst.trait_name, args: inst.head }, scope);
                var p = 0usize;
                while p < inst.premises.len(&cx) {
                    self.premise(&cx, inst.premises.at(&cx, p), scope);
                    p = p + 1usize;
                }
                let parts = inst.head.clone(&cx);
                parts.append(&cx, premise_args(&cx, inst.premises));
                self.written(&cx, parts, scope);
                n = n + 1usize;
            }
            g = g + 1usize;
        }
        self.home.set(&cx, Option::None);
        self.premises.set(&cx, ArenaVec::new(&cx));
        let externs = self.program.externs.values(&cx);
        var x = 0usize;
        while x < externs.len(&cx) {
            let ext = externs.at(&cx, x);
            self.pos.set(&cx, ext.pos);
            var k = 0usize;
            while k < ext.ptypes.len(&cx) {
                self.fits(&cx, ext.ptypes.at(&cx, k), Kind::Any, env);
                k = k + 1usize;
            }
            self.fits(&cx, ext.ret, Kind::Any, env);
            let signature = ext.ptypes.clone(&cx);
            signature.push(&cx, ext.ret);
            self.written(&cx, signature, env);
            x = x + 1usize;
        }
        let datas = self.program.datas.values(&cx);
        var d = 0usize;
        while d < datas.len(&cx) {
            let data = datas.at(&cx, d);
            self.home.set(&cx, data.home);
            self.pos.set(&cx, no_pos());
            self.fits(&cx, data.ty, Kind::Any, env);
            self.written(&cx, ArenaVec::one(&cx, data.ty), env);
            d = d + 1usize;
        }
    }
}
