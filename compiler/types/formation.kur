// Type formation: Γ ⊢ T : kind. Nominal types are checked without unfolding.
//
// This pass validates written contracts, not recursive layout or trait coherence. Premises are
// checked for formation here and discharged by the assertion checker.

use package::support::base::{Cell, Map, Out, Seq, Set, Text, text};
use package::kurs::core::{Block, Edge, Fun, Kind, ModuleId, Param, Premise, Program, Terminator, Trait, Type};
use package::kurs::core as C;
use package::resolve::resolver::Resolver;
use package::syntax::ast::{Pos, no_pos};
use package::types::ops::{Fresh, Types, children, equal, foreach_binders, free_brands, kind_name, kurs_error, subst};
use std::option::Option;
use std::slice::Slice;

// Children admissible for descent; a path cannot cross a binder.
fn formation_children(ty: Type) -> Seq[Type] {
    match ty {
        Type::Exists(_binders, _body) => Seq::new(),
        Type::Foreach(f) => Seq::one(f.source.get()),
        Type::Fn(f) => if f.quantified.is_empty() { children(ty) } else { Seq::new() },
        _ => children(ty),
    }
}

fn strict_subterm(child: Type, parent: Type) -> bool {
    let parts = formation_children(parent);
    var found = false;
    var i = 0usize;
    while !found && i < parts.len() {
        found = equal(child, parts.get(i)) || strict_subterm(child, parts.get(i));
        i = i + 1usize;
    }
    found
}

// Componentwise subterms, with at least one strict component.
fn nominal_descent(args: Seq[Type], previous: Seq[Type]) -> bool {
    if args.len() != previous.len() {
        return false;
    }
    var all = true;
    var any = false;
    var i = 0usize;
    while i < args.len() {
        let strict = strict_subterm(args.get(i), previous.get(i));
        all = all && (equal(args.get(i), previous.get(i)) || strict);
        any = any || strict;
        i = i + 1usize;
    }
    all && any
}

// A reference to one brand, respecting nested brand binders.
fn brand_occurs(ty: Type, label: Text) -> bool {
    let unit = match ty {
        Type::Skolem(found) => {
            return found.eq(label);
        },
        Type::Exists(binders, _body) => {
            if binders.has(label) {
                return false;
            }
        },
        Type::Fn(f) => {
            var i = 0usize;
            while i < f.quantified.len() {
                if f.quantified.get(i).name.eq(label) {
                    return false;
                }
                i = i + 1usize;
            }
        },
        _ => (),
    };
    let parts = children(ty);
    var found = false;
    var i = 0usize;
    while !found && i < parts.len() {
        found = brand_occurs(parts.get(i), label);
        i = i + 1usize;
    }
    found
}

// Discharges a premise that a nominal type's declaration requires, under the parameter kinds,
// assumptions and module of the declaration being formed. The assertion checker provides one.
forall D.
trait Discharge {
    fn discharge_premise(discharger: D, premise: Premise, env: Map[Text, Kind], premises: Seq[Premise], home: Option[ModuleId]) -> bool;
}

// A formation that discharges nothing: its `discharge` stays none.
exposed struct NoDischarge {
    unused: bool,
}

instance Discharge[NoDischarge] {
    fn discharge_premise(discharger: NoDischarge, premise: Premise, env: Map[Text, Kind], premises: Seq[Premise], home: Option[ModuleId]) -> bool {
        false
    }
}

forall D.
exposed struct Formation {
    program: Program,
    types: Types,
    pos: Cell[Pos],
    discharge: Cell[Option[D]],
    premises: Cell[Seq[Premise]],
    home: Cell[Option[ModuleId]],
    // nominal types whose premises are being formed, with their arguments
    active: Seq[(Text, Seq[Type])],
    // the resolver that locates errors, when a declaration's file is known
    reporter: Cell[Option[Resolver]],
}

fn with_kind(env: Map[Text, Kind], name: Text, kind: Kind) -> Map[Text, Kind] {
    let out = env.copy();
    out.set(name, kind);
    out
}

fn is_brand(kind: Kind) -> bool {
    C::same_kind(kind, Kind::Brand)
}

fn params_of(names: Seq[Text], kind: Kind) -> Seq[Param] {
    let out: Seq[Param] = Seq::new();
    var i = 0usize;
    while i < names.len() {
        out.push(Param.{ name: names.get(i), kind });
        i = i + 1usize;
    }
    out
}

fn is_ignored(t: Type) -> bool {
    match t {
        Type::Ignored => true,
        _ => false,
    }
}

fn concat_params(a: Seq[Param], b: Seq[Param]) -> Seq[Param] {
    let out = a.copy();
    out.append(b);
    out
}

fn concat_premises(a: Seq[Premise], b: Seq[Premise]) -> Seq[Premise] {
    let out = a.copy();
    out.append(b);
    out
}

forall D where Copy[D], Discharge[D].
impl Formation[D] {
    fn new(program: Program, counter: Fresh) -> Formation[D] {
        Formation.{
            program,
            types: Types::new(program, counter),
            pos: Cell::new(no_pos()),
            discharge: Cell::new(Option::None),
            premises: Cell::new(Seq::new()),
            home: Cell::new(Option::None),
            active: Seq::new(),
            reporter: Cell::new(Option::None),
        }
    }

    fn fail(self, message: Text) -> ! {
        let full = Out::new().put("type formation: ").add(message).done();
        match self.reporter.get() {
            Option::Some(r) => r.fail(full, self.pos.get()),
            Option::None => kurs_error(full, self.pos.get()),
        }
    }

    fn fail_static(self, message: Slice[u8, 'static]) -> ! {
        self.fail(text(message))
    }

    fn extend(self, env: Map[Text, Kind], params: Seq[Param]) -> Map[Text, Kind] {
        let names: Set[Text] = Set::new();
        var i = 0usize;
        while i < params.len() {
            names.add(params.get(i).name);
            i = i + 1usize;
        }
        if names.len() != params.len() {
            self.fail_static("duplicate parameter");
        }
        if names.has(text("static")) {
            self.fail_static("static is not a parameter name");
        }
        // A `Kind` is one of the three kinds by construction.
        let out = env.copy();
        var j = 0usize;
        while j < params.len() {
            out.set(params.get(j).name, params.get(j).kind);
            j = j + 1usize;
        }
        out
    }

    fn fits(self, ty: Type, want: Kind, env: Map[Text, Kind]) {
        let got = self.kind(ty, env);
        if is_brand(got) != is_brand(want) {
            self.fail(Out::new().put("expected ").add(kind_name(want)).put(" argument").done());
        }
        if C::same_kind(want, Kind::Copy) && !self.types.is_copy(ty, env) {
            self.fail_static("expected Copy argument");
        }
    }

    fn arguments(self, params: Seq[Param], args: Seq[Type], env: Map[Text, Kind], retain: bool) {
        if params.len() != args.len() {
            self.fail_static("wrong number of type arguments");
        }
        var i = 0usize;
        while i < params.len() {
            let param = params.get(i);
            let arg = args.get(i);
            let skip = retain && is_brand(param.kind) && is_ignored(arg);
            if !skip {
                self.fits(arg, param.kind, env);
            }
            i = i + 1usize;
        }
    }

    fn premise(self, premise: Premise, env: Map[Text, Kind]) {
        let params = if premise.trait_name.is("builtin::Exposed") {
            Seq::one(Param.{ name: text("T"), kind: Kind::Any })
        } else {
            match self.program.traits.get(premise.trait_name) {
                Option::Some(t) => self.trait_params(t),
                Option::None => self.fail(Out::new().put("unknown trait ").add(premise.trait_name).done()),
            }
        };
        self.arguments(params, premise.args, env, false);
    }

    fn trait_params(self, t: Trait) -> Seq[Param] {
        let kinds: Seq[Kind] = if t.param_kinds.is_empty() {
            let all: Seq[Kind] = Seq::new();
            var i = 0usize;
            while i < t.params.len() {
                all.push(Kind::Any);
                i = i + 1usize;
            }
            all
        } else {
            t.param_kinds
        };
        if kinds.len() != t.params.len() {
            self.fail_static("trait parameter kinds disagree");
        }
        let out: Seq[Param] = Seq::new();
        var j = 0usize;
        while j < kinds.len() {
            out.push(Param.{ name: t.params.get(j), kind: kinds.get(j) });
            j = j + 1usize;
        }
        out
    }

    // Validate structure and distinguish brands from values; fits refines Copy.
    fn kind(self, ty: Type, env: Map[Text, Kind]) -> Kind {
        match ty {
            Type::Skolem(label) => {
                let in_scope = match env.get(label) {
                    Option::Some(k) => is_brand(k),
                    Option::None => false,
                };
                if !in_scope {
                    self.fail(Out::new().put("brand ").add(label).put(" is not in scope").done());
                }
                return Kind::Brand;
            },
            Type::Named(name, args) => self.named(name, args, env),
            Type::Brand(brand) => self.fits(brand.get(), Kind::Brand, env),
            Type::Exists(binders, body) => {
                if binders.is_empty() {
                    self.fail_static("existential requires at least one brand binder");
                }
                let inner = self.extend(env, params_of(binders, Kind::Brand));
                let unit = match body.get() {
                    Type::Exists(_b, _t) => self.fail_static("nested existential binders must be flattened"),
                    _ => (),
                };
                var i = 0usize;
                while i < binders.len() {
                    if !brand_occurs(body.get(), binders.get(i)) {
                        self.fail_static("existential brand binder is unused");
                    }
                    i = i + 1usize;
                }
                self.fits(body.get(), Kind::Any, inner);
            },
            Type::Foreach(f) => {
                self.fits(f.source.get(), Kind::Any, env);
                let available = match f.source.get() {
                    Type::Foreach(source) => foreach_binders(source),
                    _ => Seq::new(),
                };
                if !available.slice(0usize, f.retained.len()).same(f.retained) {
                    self.fail_static("foreach retained binders must be a source prefix");
                }
                self.fits(f.body.get(), Kind::Any, self.extend(env, params_of(foreach_binders(f), Kind::Any)));
            },
            Type::Fn(f) => {
                var i = 0usize;
                while i < f.quantified.len() {
                    if !is_brand(f.quantified.get(i).kind) {
                        self.fail_static("function values quantify only brands");
                    }
                    i = i + 1usize;
                }
                var j = 0usize;
                while j < f.places.len() {
                    if f.places.get(j) >= f.params.len() {
                        self.fail_static("function place index out of range");
                    }
                    j = j + 1usize;
                }
                let inner = self.extend(env, f.quantified);
                var k = 0usize;
                while k < f.params.len() {
                    self.fits(f.params.get(k), Kind::Any, inner);
                    k = k + 1usize;
                }
                self.fits(f.ret.get(), Kind::Any, inner);
            },
            Type::Prim(name) => {
                if !C::is_prim(name) {
                    self.fail(Out::new().put("unknown primitive ").add(name).done());
                }
            },
            // A length is never negative: it is unsigned.
            Type::Struct(fields) => self.components(ty, fields, env),
            Type::Enum(variants) => self.components(ty, variants, env),
            Type::Ignored => self.fail_static("_ is only a retained fn brand argument"),
            Type::Ptr(_inner) => self.children_fit(ty, env),
            Type::Tuple(_elems) => self.children_fit(ty, env),
            Type::Array(_elem, _length) => self.children_fit(ty, env),
            Type::Never => self.children_fit(ty, env),
            _ => self.fail_static("unknown type node"),
        }
        Kind::Any
    }

    fn components(self, ty: Type, members: Seq[C::Member], env: Map[Text, Kind]) {
        let names: Set[Text] = Set::new();
        var i = 0usize;
        while i < members.len() {
            names.add(members.get(i).name);
            i = i + 1usize;
        }
        if names.len() != members.len() {
            self.fail_static("duplicate component name");
        }
        self.children_fit(ty, env);
    }

    fn children_fit(self, ty: Type, env: Map[Text, Kind]) {
        let parts = children(ty);
        var i = 0usize;
        while i < parts.len() {
            self.fits(parts.get(i), Kind::Any, env);
            i = i + 1usize;
        }
    }

    fn named(self, name: Text, args: Seq[Type], env: Map[Text, Kind]) {
        let unit = match env.get(name) {
            Option::Some(k) => {
                if !args.is_empty() || is_brand(k) {
                    self.fail(Out::new().put("invalid type parameter ").add(name).done());
                }
                return ();
            },
            Option::None => (),
        };
        let decl = match self.program.types.get(name) {
            Option::Some(d) => d,
            Option::None => self.fail(Out::new().put("unknown type ").add(name).done()),
        };
        self.arguments(decl.params, args, env, false);
        let discharger = match self.discharge.get() {
            Option::Some(d) => d,
            Option::None => {
                return ();
            },
        };
        if decl.premises.is_empty() {
            return ();
        }
        var i = 0usize;
        while i < self.active.len() {
            let (n, previous) = self.active.get(i);
            if n.eq(name) && !nominal_descent(args, previous) {
                self.fail(Out::new().put("non-descending nominal premise formation for ").add(name).done());
            }
            i = i + 1usize;
        }
        self.active.push((name, args));
        let sub: Map[Text, Type] = Map::new();
        var j = 0usize;
        while j < decl.params.len() && j < args.len() {
            sub.set(decl.params.get(j).name, args.get(j));
            j = j + 1usize;
        }
        var k = 0usize;
        while k < decl.premises.len() {
            let p = decl.premises.get(k);
            let required_args: Seq[Type] = Seq::new();
            var a = 0usize;
            while a < p.args.len() {
                required_args.push(subst(p.args.get(a), sub, self.types.counter));
                a = a + 1usize;
            }
            let required = Premise.{ trait_name: p.trait_name, args: required_args };
            self.premise(required, env);
            if !Discharge::discharge_premise(discharger, required, env, self.premises.get(), self.home.get()) {
                self.fail(Out::new().put("unsatisfied nominal premise ").add(required.trait_name).put(" for ").add(name).done());
            }
            k = k + 1usize;
        }
        let unit = self.active.pop();
    }

    fn function(self, fun: Fun, outer: Seq[Param], premises: Seq[Premise]) {
        self.pos.set(fun.pos);
        let all_premises = concat_premises(premises, fun.premises);
        self.home.set(fun.home);
        self.premises.set(all_premises);
        let params = concat_params(outer, fun.params);
        let env = self.extend(with_kind(Map::new(), text("static"), Kind::Brand), params);
        var i = 0usize;
        while i < all_premises.len() {
            self.premise(all_premises.get(i), env);
            i = i + 1usize;
        }
        var j = 0usize;
        while j < fun.ptypes.len() {
            self.fits(fun.ptypes.get(j), Kind::Any, env);
            j = j + 1usize;
        }
        self.fits(fun.ret, Kind::Any, env);
        let generic_brands: Set[Text] = Set::new();
        var g = 0usize;
        while g < params.len() {
            if is_brand(params.get(g).kind) {
                generic_brands.add(params.get(g).name);
            }
            g = g + 1usize;
        }
        var l = 0usize;
        while l < fun.locals.len() {
            let t = fun.locals.get(l).type;
            let brands = free_brands(t).items();
            var b = 0usize;
            while b < brands.len() {
                if !generic_brands.has(brands.get(b)) {
                    self.fail_static("local types may mention only function-generic free brands");
                }
                b = b + 1usize;
            }
            self.fits(t, Kind::Any, env);
            l = l + 1usize;
        }
        var n = 0usize;
        while n < fun.blocks.len() {
            self.block(fun.blocks.get(n), env);
            n = n + 1usize;
        }
    }

    fn block(self, block: Block, env: Map[Text, Kind]) {
        self.pos.set(block.pos);
        var i = 0usize;
        while i < block.brands.len() {
            let rebinds = match env.get(block.brands.get(i)) {
                Option::Some(k) => is_brand(k),
                Option::None => false,
            };
            if rebinds {
                self.fail_static("a block brand parameter cannot rebind a function brand");
            }
            i = i + 1usize;
        }
        var scope = self.extend(env, params_of(block.brands, Kind::Brand));
        var o = 0usize;
        while o < block.opened.len() {
            let view_brands = block.opened.get(o).brands;
            var v = 0usize;
            while v < view_brands.len() {
                self.fits(Type::Skolem.(view_brands.get(v)), Kind::Brand, scope);
                v = v + 1usize;
            }
            o = o + 1usize;
        }
        var p = 0usize;
        while p < block.params.len() {
            self.fits(block.params.get(p).type, Kind::Any, scope);
            p = p + 1usize;
        }
        var n = 0usize;
        while n < block.instrs.len() {
            let instr = block.instrs.get(n);
            self.pos.set(instr.pos);
            let unit = match instr.ty {
                Option::Some(t) => self.fits(t, Kind::Any, scope),
                Option::None => (),
            };
            let call = instr.op.is("call") || instr.op.is("fn");
            if call && self.program.funs.has(instr.args.get(0usize)) {
                self.arguments(self.program.funs.at(instr.args.get(0usize)).params, instr.tys, scope, instr.op.is("fn"));
            } else if call && self.program.externs.has(instr.args.get(0usize)) {
                self.arguments(Seq::new(), instr.tys, scope, false);
            } else if instr.op.is("foreach") && self.program.funs.has(instr.args.get(1usize)) {
                let count = match instr.ty {
                    Option::Some(t) => match t {
                        Type::Foreach(f) => foreach_binders(f).len(),
                        _ => 0usize,
                    },
                    Option::None => 0usize,
                };
                let mapper = self.program.funs.at(instr.args.get(1usize));
                let leading = mapper.params.slice(0usize, count);
                var q = 0usize;
                while q < leading.len() {
                    if is_brand(leading.get(q).kind) {
                        self.fail_static("foreach binders require value parameters");
                    }
                    q = q + 1usize;
                }
                self.arguments(mapper.params.from(count), instr.tys, scope, false);
            } else if instr.op.is("trait_call") {
                self.premise(Premise.{ trait_name: instr.args.get(0usize), args: instr.tys }, scope);
            } else {
                var t = 0usize;
                while t < instr.tys.len() {
                    let unit = self.kind(instr.tys.get(t), scope);
                    t = t + 1usize;
                }
            }
            if instr.op.is("open") {
                scope = self.extend(scope, params_of(instr.binders, Kind::Brand));
            }
            n = n + 1usize;
        }
        let edges: Seq[Edge] = Seq::new();
        let unit = match block.term {
            Terminator::Switch(_scrutinee, ty, arms, pos) => {
                self.pos.set(pos);
                self.fits(ty, Kind::Any, scope);
                var a = 0usize;
                while a < arms.len() {
                    edges.push(arms.get(a).edge);
                    a = a + 1usize;
                }
            },
            Terminator::Jnz(_cond, then, other, pos) => {
                self.pos.set(pos);
                edges.push(then);
                edges.push(other);
            },
            Terminator::Jmp(edge, pos) => {
                self.pos.set(pos);
                edges.push(edge);
            },
            Terminator::Ret(_value, pos) => self.pos.set(pos),
            Terminator::Unreachable(pos) => self.pos.set(pos),
        };
        var e = 0usize;
        while e < edges.len() {
            let tys = edges.get(e).tys;
            var t = 0usize;
            while t < tys.len() {
                self.fits(tys.get(t), Kind::Brand, scope);
                t = t + 1usize;
            }
            e = e + 1usize;
        }
    }

    fn declarations(self) {
        let env = with_kind(Map::new(), text("static"), Kind::Brand);
        let decls = self.program.types.values();
        var i = 0usize;
        while i < decls.len() {
            let decl = decls.get(i);
            self.home.set(decl.home);
            self.premises.set(decl.premises);
            let scope = self.extend(env, decl.params);
            var p = 0usize;
            while p < decl.premises.len() {
                self.premise(decl.premises.get(p), scope);
                p = p + 1usize;
            }
            self.fits(decl.body, Kind::Any, scope);
            i = i + 1usize;
        }
        let traits = self.program.traits.values();
        var t = 0usize;
        while t < traits.len() {
            let tr = traits.get(t);
            self.home.set(tr.home);
            self.premises.set(Seq::new());
            let scope = self.extend(env, self.trait_params(tr));
            var m = 0usize;
            while m < tr.methods.len() {
                let method = tr.methods.get(m);
                var k = 0usize;
                while k < method.ptypes.len() {
                    self.fits(method.ptypes.get(k), Kind::Any, scope);
                    k = k + 1usize;
                }
                self.fits(method.ret, Kind::Any, scope);
                m = m + 1usize;
            }
            t = t + 1usize;
        }
        let groups = self.program.instances.values();
        var g = 0usize;
        while g < groups.len() {
            let insts = groups.get(g);
            var n = 0usize;
            while n < insts.len() {
                let inst = insts.get(n);
                self.pos.set(inst.pos);
                self.home.set(inst.home);
                self.premises.set(inst.premises);
                let scope = self.extend(env, inst.params);
                self.premise(Premise.{ trait_name: inst.trait_name, args: inst.head }, scope);
                var p = 0usize;
                while p < inst.premises.len() {
                    self.premise(inst.premises.get(p), scope);
                    p = p + 1usize;
                }
                n = n + 1usize;
            }
            g = g + 1usize;
        }
        self.home.set(Option::None);
        self.premises.set(Seq::new());
        let externs = self.program.externs.values();
        var x = 0usize;
        while x < externs.len() {
            let ext = externs.get(x);
            self.pos.set(ext.pos);
            let unit = match ext.ret {
                Option::None => self.fail_static("extern requires a type"),
                Option::Some(ret) => {
                    let unit = match ext.ptypes {
                        Option::Some(ptypes) => {
                            var k = 0usize;
                            while k < ptypes.len() {
                                self.fits(ptypes.get(k), Kind::Any, env);
                                k = k + 1usize;
                            }
                        },
                        Option::None => (),
                    };
                    self.fits(ret, Kind::Any, env);
                },
            };
            x = x + 1usize;
        }
        let datas = self.program.datas.values();
        var d = 0usize;
        while d < datas.len() {
            let data = datas.get(d);
            self.home.set(data.home);
            self.pos.set(no_pos());
            self.fits(data.ty, Kind::Any, env);
            d = d + 1usize;
        }
    }
}
