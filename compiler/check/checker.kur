// The KURS assertion checker: every block is checked alone against its declared contract, using
// only signatures of its successors and callees.
//
// The checker records the type of every SSA value of every function it checks, for the backend
// and later passes. A function is identified by a `FunKey`: a program function by its name, an
// instance method by its trait, its instance's index among that trait's instances and its bare
// method name, since methods of different instances share names with each other and with
// functions.

use std::parse::parse_usize;
use std::collections::arena_vec::ArenaVec;
use std::collections::arena_map::{ArenaMap, ArenaSet};
use std::mem::Ref;
use std::raw::Span;
use std::arena::Domain!;
use std::buffer::Buffer!;
use package::kurs::transfer::copy_type;
use package::kurs::core::{Arm, Block, Edge, Fun, Instance, Instr, Kind, Member, Method, ModuleId, Opened, Param, Premise, Program, Terminator, Type};
use package::kurs::core as C;
use package::types::coherence::check_coherence;
use package::types::formation::{Discharge, Formation};
use package::types::layout::check_type_expansion;
use package::types::literals::valid_literal;
use package::kurs::sexpr::Form;
use package::syntax::ast::{Pos, no_pos};
use package::types::termination::check_instance_termination;
use package::types::ops::{Fresh, Types, children, equal, fits, foreach_binders, foreach_item, free_brands, kurs_error, subst};
use package::types::unify::match_head;
use std::hash::{HashIn, HashState};
use std::option::{Option, Result};
use std::slice::{Slice, hash_bytes};

forall 'k.
fn is_arith(&cx: Domain!['k], op: Span['k]) -> bool {
    op.is(&cx, "add") || op.is(&cx, "sub") || op.is(&cx, "mul") || op.is(&cx, "div") || op.is(&cx, "mod")
}

forall 'k.
fn is_order(&cx: Domain!['k], op: Span['k]) -> bool {
    op.is(&cx, "lt") || op.is(&cx, "le") || op.is(&cx, "gt") || op.is(&cx, "ge")
}

forall 'k.
fn is_equality(&cx: Domain!['k], op: Span['k]) -> bool {
    op.is(&cx, "eq") || op.is(&cx, "ne")
}

forall 'k.
fn is_bits(&cx: Domain!['k], op: Span['k]) -> bool {
    op.is(&cx, "bit_and") || op.is(&cx, "bit_or") || op.is(&cx, "bit_xor") || op.is(&cx, "shl") || op.is(&cx, "shr")
}

forall 'k.
fn is_ordering(&cx: Domain!['k], order: Span['k]) -> bool {
    order.is(&cx, "relaxed") || order.is(&cx, "acquire") || order.is(&cx, "release") || order.is(&cx, "acq_rel") || order.is(&cx, "seq_cst")
}

// The failure orderings a compare-exchange allows with a success ordering; none for an unknown one.
forall 'k.
fn cas_failure(&cx: Domain!['k], success: Span['k]) -> Option[ArenaVec[Span['k], 'k]] {
    let relaxed = Span::from_static(&cx, "relaxed");
    let acquire = Span::from_static(&cx, "acquire");
    if success.is(&cx, "relaxed") || success.is(&cx, "release") {
        Option::Some.(ArenaVec::one(&cx, relaxed))
    } else if success.is(&cx, "acquire") || success.is(&cx, "acq_rel") {
        Option::Some.(ArenaVec::two(&cx, relaxed, acquire))
    } else if success.is(&cx, "seq_cst") {
        let all = ArenaVec::two(&cx, relaxed, acquire);
        all.push(&cx, Span::from_static(&cx, "seq_cst"));
        Option::Some.(all)
    } else {
        Option::None
    }
}

// The number of operands of an atomic operation of kind `kind` (`kurs::core::atomic_kind`).
forall 'k.
fn atomic_arity(&cx: Domain!['k], kind: Span['k]) -> usize {
    if kind.is(&cx, "fence") {
        0usize
    } else if kind.is(&cx, "load") {
        1usize
    } else if kind.is(&cx, "compare_exchange") {
        3usize
    } else {
        2usize
    }
}

forall 'k.
fn static_brand(&cx: Domain!['k]) -> Span['k] {
    Span::from_static(&cx, "static")
}

// The module of a declaration that names none: inside no exposure scope, so it has no shape
// authority over restricted declarations.
forall 'k.
fn nowhere(&cx: Domain!['k]) -> ModuleId['k] {
    ModuleId.{ package: 18446744073709551615usize, path: ArenaVec::one(&cx, Span::from_static(&cx, "<no module>")) }
}

// Compiler-reserved trait names: no user trait or instance.
forall 'k.
fn sealed(&cx: Domain!['k], name: Span['k]) -> bool {
    name.is(&cx, "Copy") || name.is(&cx, "Exposed")
}

forall 'k.
fn segments(&cx: Domain!['k], path: Span['k]) -> ArenaVec[Span['k], 'k] {
    path.split(&cx, Span::from_static(&cx, "."))
}

// Resolve a bounded decimal tuple component without parsing huge atoms.
forall 'k.
fn canonical_tuple_index(&cx: Domain!['k], segment: Span['k], arity: usize) -> Option[usize] {
    if arity == 0usize || segment.is_empty() || segment.len() > 1usize && segment.byte_or_zero(&cx, 0usize) == b'0' {
        return Option::None;
    }
    var i = 0usize;
    while i < segment.len() {
        let b = segment.byte_or_zero(&cx, i);
        if b < b'0' || b > b'9' {
            return Option::None;
        }
        i = i + 1usize;
    }
    let largest = Buffer!::new().push_usize(arity - 1usize).save(&cx);
    if segment.len() > largest.len() || segment.len() == largest.len() && segment.cmp(&cx, largest).is_gt() {
        return Option::None;
    }
    parse_usize(&cx, segment)
}

// `parent` is an ancestor of `other_path`, or the path itself: its segments begin
// `other_path`'s. A segment holds no `.`, so this compares bytes without splitting.
forall 'k.
fn prefix(&cx: Domain!['k], parent: Span['k], other_path: Span['k]) -> bool {
    other_path.starts_with(&cx, parent) && (other_path.len() == parent.len() || other_path.byte_or_zero(&cx, parent.len()) == b'.')
}

// The end of the segment of `path` that starts at `start`: the next `.`, or the path's end.
forall 'k.
fn segment_end(&cx: Domain!['k], path: Span['k], start: usize) -> usize {
    var i = start;
    while i < path.len() && path.byte_or_zero(&cx, i) != b'.' {
        i = i + 1usize;
    }
    i
}

forall 'k.
fn overlap(&cx: Domain!['k], path: Span['k], other_path: Span['k]) -> bool {
    prefix(&cx, path, other_path) || prefix(&cx, other_path, path)
}

// The root `path` starts at: its first segment.
forall 'k.
fn root_of(&cx: Domain!['k], path: Span['k]) -> Span['k] {
    path.slice(0usize, segment_end(&cx, path, 0usize))
}

// Some path of `paths` is a proper ancestor of `path`, answered by looking up each of its ancestors
// rather than by scanning the set.
forall 'k.
fn strict_ancestor_in(&cx: Domain!['k], paths: ArenaSet[Span['k], 'k], path: Span['k]) -> bool {
    if paths.is_empty(&cx) {
        return false;
    }
    var found = false;
    var dot = path.find_byte(&cx, b'.', 0usize);
    while !found && dot.is_some() {
        let at = match dot {
            Option::Some(i) => i,
            Option::None => path.len(),
        };
        found = paths.contains(&cx, path.slice(0usize, at));
        dot = path.find_byte(&cx, b'.', at + 1usize);
    }
    found
}

// Some path of `paths` is `path` or an ancestor of it: `paths.any(|z| prefix(z, path))`.
forall 'k.
fn ancestor_in(&cx: Domain!['k], paths: ArenaSet[Span['k], 'k], path: Span['k]) -> bool {
    paths.contains(&cx, path) || strict_ancestor_in(&cx, paths, path)
}

// `holds` is true somewhere in the value representation of `ty`, or in the arguments of a named type
// in it. A named type is unfolded too, since its fields are its value; a pointer's target is not part
// of it, nor is the element of an array of length 0, which holds no value (and may be the type itself).
forall Env, 'k where Copy[Env].
fn contains(&cx: Domain!['k], types: Types['k], ty: Type['k], holds: closure[Env](&_: Domain!['k], Type['k]) -> bool) -> bool {
    if holds(&cx, ty) {
        return true;
    }
    match ty {
        Type::Ptr(_inner) => false,
        Type::NonNull(_inner) => false,
        Type::Array(elem, length) => length != 0u64 && contains(&cx, types, elem.copy(&cx), holds),
        _ => {
            let parts = children(&cx, ty);
            var found = false;
            var i = 0usize;
            while !found && i < parts.len(&cx) {
                found = contains(&cx, types, parts.at(&cx, i), holds);
                i = i + 1usize;
            }
            if found {
                return true;
            }
            match ty {
                Type::Named(name, _args) => types.program.types.contains(&cx, name) && contains(&cx, types, types.shape(&cx, ty, Option::None), holds),
                _ => false,
            }
        },
    }
}

// What only checked code makes, and foreign code never hands the program: a package, a brand
// witness, a safe function value, a transform, or Never. An `unsafe fn` value may come from C:
// calling it needs `unsafe`.
forall 'k.
fn checked_only(t: Type['k]) -> bool {
    match t {
        Type::Exists(_binders, _body) => true,
        Type::Brand(_brand) => true,
        Type::Foreach(_f) => true,
        Type::Never => true,
        Type::Fn(f) => !f.is_unsafe,
        _ => false,
    }
}

forall 'k.
fn is_never(t: Type['k]) -> bool {
    match t {
        Type::Never => true,
        _ => false,
    }
}

forall 'k.
fn is_non_null(t: Type['k]) -> bool {
    match t {
        Type::NonNull(_inner) => true,
        _ => false,
    }
}

// A pointer or a `NonNull`.
forall 'k.
fn is_pointer_like(t: Type['k]) -> bool {
    match t {
        Type::Ptr(_inner) => true,
        Type::NonNull(_inner) => true,
        _ => false,
    }
}

forall 'k.
fn is_exists(t: Type['k]) -> bool {
    match t {
        Type::Exists(_binders, _body) => true,
        _ => false,
    }
}

forall 'k.
fn is_struct_or_tuple(t: Type['k]) -> bool {
    match t {
        Type::Struct(_fields) => true,
        Type::Tuple(_elems) => true,
        _ => false,
    }
}

forall 'k.
fn is_integer_type(&cx: Domain!['k], t: Type['k]) -> bool {
    match t {
        Type::Prim(name) => C::is_integer(&cx, name),
        _ => false,
    }
}

forall 'k.
fn is_float_type(&cx: Domain!['k], t: Type['k]) -> bool {
    match t {
        Type::Prim(name) => C::is_float(&cx, name),
        _ => false,
    }
}

forall 'k.
fn is_number_type(&cx: Domain!['k], t: Type['k]) -> bool {
    is_integer_type(&cx, t) || is_float_type(&cx, t)
}

// The type of the last member named `name`, as `dict(members).get(name)` finds it.
forall 'k.
fn member(&cx: Domain!['k], members: ArenaVec[Member['k], 'k], name: Span['k]) -> Option[Type['k]] {
    var found = Option::None;
    var i = 0usize;
    while i < members.len(&cx) {
        if members.at(&cx, i).name.eq(&cx, name) {
            found = Option::Some.(members.at(&cx, i).type);
        }
        i = i + 1usize;
    }
    found
}

forall 'k.
fn texts_set(&cx: Domain!['k], names: ArenaVec[Span['k], 'k]) -> ArenaSet[Span['k], 'k] {
    let out: ArenaSet[Span['k], 'k] = ArenaSet::new(&cx);
    var i = 0usize;
    while i < names.len(&cx) {
        out.insert(&cx, names.at(&cx, i));
        i = i + 1usize;
    }
    out
}

forall 'k.
fn subset(&cx: Domain!['k], a: ArenaSet[Span['k], 'k], b: ArenaSet[Span['k], 'k]) -> bool {
    a.all(&cx, |&cx, x: Span['k]| b.contains(&cx, x))
}

forall 'k.
fn sets_meet(&cx: Domain!['k], a: ArenaSet[Span['k], 'k], b: ArenaSet[Span['k], 'k]) -> bool {
    !subset_none(&cx, a, b)
}

forall 'k.
fn subset_none(&cx: Domain!['k], a: ArenaSet[Span['k], 'k], b: ArenaSet[Span['k], 'k]) -> bool {
    !a.any(&cx, |&cx, x: Span['k]| b.contains(&cx, x))
}

// The two maps hold the same keys with the same values.
forall 'k.
fn opened_same(&cx: Domain!['k], a: ArenaMap[Span['k], ArenaVec[Span['k], 'k], 'k], b: ArenaMap[Span['k], ArenaVec[Span['k], 'k], 'k]) -> bool {
    if a.len(&cx) != b.len(&cx) {
        return false;
    }
    let keys = a.keys(&cx);
    var equal = true;
    var i = 0usize;
    while equal && i < keys.len(&cx) {
        equal = match b.get(&cx, keys.at(&cx, i)) {
            Option::Some(v) => v.eq(&cx, a.at(&cx, keys.at(&cx, i))),
            Option::None => false,
        };
        i = i + 1usize;
    }
    equal
}

// ---------------------------------------------------------- function keys --

forall 'k.
exposed enum FunKey {
    // a function of the program, by name
    Function(Span['k]),
    // an instance method: its trait, the instance's index among the trait's instances, and the
    // method's bare name
    Method(Span['k], usize, Span['k]),
}

forall 'k.
instance HashIn[FunKey['k], Domain!['k]] {
    fn hash_in(&cx: Domain!['k], key: FunKey['k], state: HashState) -> HashState {
        match key {
            FunKey::Function(name) => hash_bytes(&cx, name, state.write_u64(1u64)),
            FunKey::Method(trait_name, index, name) => hash_bytes(&cx, name, hash_bytes(&cx, trait_name, state.write_u64(2u64)).write_u64(index as u64)),
        }
    }

    fn eq_in(&cx: Domain!['k], a: FunKey['k], b: FunKey['k]) -> bool {
        let equal = {
            match a {
                FunKey::Function(x) => match b {
                    FunKey::Function(y) => x.eq(&cx, y),
                    _ => false,
                },
                FunKey::Method(t, i, x) => match b {
                    FunKey::Method(u, j, y) => t.eq(&cx, u) && i == j && x.eq(&cx, y),
                    _ => false,
                },
            }
        };
        equal
    }
}

// ------------------------------------------------------------------ places --

// P = (Z, K, O): empty paths, known variants, opened views.
forall 'k.
exposed struct Places {
    empty: ArenaSet[Span['k], 'k],
    known: ArenaMap[Span['k], Span['k], 'k],
    opened: ArenaMap[Span['k], ArenaVec[Span['k], 'k], 'k],
}

forall 'k.
impl Places['k] {
    fn new(empty: ArenaSet[Span['k], 'k], known: ArenaMap[Span['k], Span['k], 'k], opened: ArenaMap[Span['k], ArenaVec[Span['k], 'k], 'k]) -> Places['k] {
        Places.{ empty, known, opened }
    }

    fn copy(self, &cx: Domain!['k]) -> Places['k] {
        Places.{ empty: self.empty.clone(&cx), known: self.known.clone(&cx), opened: self.opened.clone(&cx) }
    }

    // Makes this state hold what `from` holds, in the room it already has: a scratch state loaded
    // again and again takes new room only to hold more than it has held before.
    fn load(self, &cx: Domain!['k], from: Places['k]) {
        self.empty.assign(&cx, from.empty);
        self.known.assign(&cx, from.known);
        self.opened.assign(&cx, from.opened);
    }

    // Some empty path is `path` or an ancestor of it.
    fn covered(self, &cx: Domain!['k], path: Span['k]) -> bool {
        ancestor_in(&cx, self.empty, path)
    }

    // No empty path is `path`, an ancestor or a descendant of it.
    fn full(self, &cx: Domain!['k], path: Span['k]) -> bool {
        !self.covered(&cx, path) && !self.empty.any(&cx, |&cx, z: Span['k]| prefix(&cx, path, z))
    }

    fn forget(self, &cx: Domain!['k], path: Span['k], keep_own_view: bool) {
        var i = 0usize;
        while i < self.known.positions(&cx) {
            match self.known.key_at(&cx, i) {
                Option::Some(q) => {
                    if prefix(&cx, path, q) {
                        self.known.remove(&cx, q);
                    }
                },
                Option::None => (),
            };
            i = i + 1usize;
        }
        var j = 0usize;
        while j < self.opened.positions(&cx) {
            match self.opened.key_at(&cx, j) {
                Option::Some(q) => {
                    if prefix(&cx, path, q) && !(keep_own_view && q.eq(&cx, path)) {
                        self.opened.remove(&cx, q);
                    }
                },
                Option::None => (),
            };
            j = j + 1usize;
        }
    }

    // Empties each of `roots`, none of which has a view opened at or below it, and forgets what is
    // known below them: `empty` and `forget` for each, in one pass over the state.
    fn forget_roots(self, &cx: Domain!['k], roots: ArenaSet[Span['k], 'k]) {
        var i = 0usize;
        while i < self.empty.positions(&cx) {
            match self.empty.key_at(&cx, i) {
                Option::Some(p) => if roots.contains(&cx, root_of(&cx, p)) {
                    self.empty.remove(&cx, p);
                },
                Option::None => (),
            };
            i = i + 1usize;
        }
        i = 0usize;
        while i < roots.positions(&cx) {
            match roots.key_at(&cx, i) {
                Option::Some(root) => { self.empty.insert(&cx, root); },
                Option::None => (),
            };
            i = i + 1usize;
        }
        i = 0usize;
        while i < self.known.positions(&cx) {
            match self.known.key_at(&cx, i) {
                Option::Some(q) => if roots.contains(&cx, root_of(&cx, q)) {
                    self.known.remove(&cx, q);
                },
                Option::None => (),
            };
            i = i + 1usize;
        }
    }

    // Retain views only when all their opened ancestors are retained too.
    fn keep_opened(self, &cx: Domain!['k], wanted: ArenaMap[Span['k], ArenaVec[Span['k], 'k], 'k]) {
        let current = self.opened.keys(&cx);
        let kept: ArenaMap[Span['k], ArenaVec[Span['k], 'k], 'k] = ArenaMap::new(&cx);
        let paths = wanted.keys(&cx);
        var i = 0usize;
        while i < paths.len(&cx) {
            let p = paths.at(&cx, i);
            var all = true;
            var j = 0usize;
            while all && j < current.len(&cx) {
                let q = current.at(&cx, j);
                if !q.eq(&cx, p) && prefix(&cx, q, p) {
                    all = wanted.contains(&cx, q);
                }
                j = j + 1usize;
            }
            if all {
                kept.insert(&cx, p, wanted.at(&cx, p));
            }
            i = i + 1usize;
        }
        let old = self.opened.keys(&cx);
        var k = 0usize;
        while k < old.len(&cx) {
            self.opened.remove(&cx, old.at(&cx, k));
            k = k + 1usize;
        }
        let new = kept.keys(&cx);
        var n = 0usize;
        while n < new.len(&cx) {
            self.opened.insert(&cx, new.at(&cx, n), kept.at(&cx, new.at(&cx, n)));
            n = n + 1usize;
        }
    }
}

// What `storage_fact` found of a path: its stored type, whether that is Copy when it is known, and
// whether the path is kept in `PathFacts.stored`.
forall 'k.
exposed struct Stored {
    type: Type['k],
    copy: Option[bool],
    kept: bool,
}

// What the checker knows of the paths of the function it checks or plans, under its roots and
// kinds maps, by their identities: made again when either changes.
forall 'k.
exposed struct PathFacts {
    roots: usize,
    kinds: usize,
    // path -> its stored type, and whether that is Copy once asked, for a path no state decides
    stored: ArenaMap[Span['k], (Type['k], Option[bool]), 'k],
    // block label -> the paths it declares empty, as a set
    empty_sets: ArenaMap[Span['k], ArenaSet[Span['k], 'k], 'k],
    // block label -> the paths it declares empty that `Checker::empty_to_check` gives
    linear_empty: ArenaMap[Span['k], ArenaVec[Span['k], 'k], 'k],
}

// (param types, result, unsafe, place indices) of a call's callee.
forall 'k.
exposed struct Signature {
    ptypes: ArenaVec[Type['k], 'k],
    ret: Type['k],
    is_unsafe: bool,
    places: ArenaVec[usize, 'k],
}

// ----------------------------------------------------------------- checker --

forall 'k.
exposed struct Checker {
    program: Program['k],
    counter: Fresh['k],
    formation: Formation[Checker['k], 'k],
    types: Types['k],
    // function -> (block label, SSA name) -> type, for the backend
    typed: ArenaMap[FunKey['k], ArenaMap[(Span['k], Span['k]), Type['k], 'k], 'k],
    home: Ref[Option[ModuleId['k]], 'k],
    kinds: Ref[ArenaMap[Span['k], Kind, 'k], 'k],
    // whether each type asked about is Copy, under the kinds map (by its identity) it was asked under
    copies: Ref[(usize, ArenaMap[Type['k], bool, 'k]), 'k],
    brands: Ref[ArenaSet[Span['k], 'k], 'k],
    premises: Ref[ArenaVec[Premise['k], 'k], 'k],
    // what is being checked, for messages
    location: Ref[Span['k], 'k],
    current: Ref[Option[Fun['k]], 'k],
    params: Ref[ArenaVec[Param['k], 'k], 'k],
    blocks: Ref[ArenaMap[Span['k], Block['k], 'k], 'k],
    record: Ref[ArenaMap[(Span['k], Span['k]), Type['k], 'k], 'k],
    roots: Ref[ArenaMap[Span['k], Type['k], 'k], 'k],
    param_roots: Ref[ArenaSet[Span['k], 'k], 'k],
    // the free brands of each root's type, as `edge` asks for them
    root_brand_cache: Ref[ArenaMap[Span['k], ArenaSet[Span['k], 'k], 'k], 'k],
    // `branded_locals` of the function being checked, once asked
    edge_roots: Ref[Option[(ArenaVec[Span['k], 'k], ArenaSet[Span['k], 'k])], 'k],
    // what is known of paths under the current roots and kinds
    facts: Ref[PathFacts['k], 'k],
    // The sets `empty_set` hands out, the n-th to a function's n-th block that asks, refilled for
    // each function; and the state a block is checked in, refilled for each block.
    set_pool: ArenaVec[ArenaSet[Span['k], 'k], 'k],
    working: Places['k],
    label: Ref[Span['k], 'k],
    env: Ref[ArenaMap[Span['k], Type['k], 'k], 'k],
    used: Ref[ArenaSet[Span['k], 'k], 'k],
    places: Ref[Places['k], 'k],
    instr: Ref[Option[Instr['k]], 'k],
}

forall 'k.
instance Discharge[Checker['k], 'k] {
    fn discharge_premise(discharger: Checker['k], &cx: Domain!['k], premise: Premise['k], env: ArenaMap[Span['k], Kind, 'k], premises: ArenaVec[Premise['k], 'k], home: Option[ModuleId['k]]) -> bool {
        discharger.formation_holds(&cx, premise, env, premises, home)
    }
}

forall 'k.
fn with_brands(&cx: Domain!['k], kinds: ArenaMap[Span['k], Kind, 'k], brands: ArenaSet[Span['k], 'k]) -> ArenaMap[Span['k], Kind, 'k] {
    let out = kinds.clone(&cx);
    let names = brands.keys(&cx);
    var i = 0usize;
    while i < names.len(&cx) {
        out.insert(&cx, names.at(&cx, i), Kind::Brand);
        i = i + 1usize;
    }
    out
}

forall 'k.
fn brand_params(&cx: Domain!['k], params: ArenaVec[Param['k], 'k]) -> ArenaSet[Span['k], 'k] {
    let out: ArenaSet[Span['k], 'k] = ArenaSet::new(&cx);
    var i = 0usize;
    while i < params.len(&cx) {
        if C::same_kind(params.at(&cx, i).kind, Kind::Brand) {
            out.insert(&cx, params.at(&cx, i).name);
        }
        i = i + 1usize;
    }
    out
}

forall 'k.
fn subst_all(&cx: Domain!['k], types: ArenaVec[Type['k], 'k], sub: ArenaMap[Span['k], Type['k], 'k], counter: Fresh['k]) -> ArenaVec[Type['k], 'k] {
    let out: ArenaVec[Type['k], 'k] = ArenaVec::new(&cx);
    var i = 0usize;
    while i < types.len(&cx) {
        out.push(&cx, subst(&cx, types.at(&cx, i), sub, counter));
        i = i + 1usize;
    }
    out
}

forall 'k.
impl Checker['k] {
    fn new(&cx: Domain!['k], program: Program['k], counter: Fresh['k]) -> Checker['k] {
        check_type_expansion(&cx, program, counter, ArenaMap::new(&cx));
        let formation: Formation[Checker['k], 'k] = Formation::new(&cx, program, counter);
        formation.declarations(&cx);
        let heads: ArenaVec[(Premise['k], ArenaVec[Param['k], 'k], Pos), 'k] = ArenaVec::new(&cx);
        let headers: ArenaVec[(Premise['k], ArenaVec[Premise['k], 'k], Pos), 'k] = ArenaVec::new(&cx);
        let groups = program.instances.values(&cx);
        var g = 0usize;
        while g < groups.len(&cx) {
            let insts = groups.at(&cx, g);
            var i = 0usize;
            while i < insts.len(&cx) {
                let inst = insts.at(&cx, i);
                heads.push(&cx, (Premise.{ trait_name: inst.trait_name, args: inst.head }, inst.params, inst.pos));
                headers.push(&cx, (Premise.{ trait_name: inst.trait_name, args: inst.head }, inst.premises, no_pos()));
                i = i + 1usize;
            }
            g = g + 1usize;
        }
        check_coherence(&cx, heads, counter, ArenaVec::new(&cx), false);
        check_instance_termination(&cx, headers, ArenaVec::new(&cx), false);
        let checker = Checker.{
            program,
            counter,
            formation,
            types: Types::new(&cx, program, counter),
            typed: ArenaMap::new(&cx),
            home: Ref::new(&cx, Option::None),
            kinds: Ref::new(&cx, ArenaMap::new(&cx)),
            copies: Ref::new(&cx, (0usize, ArenaMap::new(&cx))),
            brands: Ref::new(&cx, ArenaSet::new(&cx)),
            premises: Ref::new(&cx, ArenaVec::new(&cx)),
            location: Ref::new(&cx, Span::from_static(&cx, "")),
            current: Ref::new(&cx, Option::None),
            params: Ref::new(&cx, ArenaVec::new(&cx)),
            blocks: Ref::new(&cx, ArenaMap::new(&cx)),
            record: Ref::new(&cx, ArenaMap::new(&cx)),
            roots: Ref::new(&cx, ArenaMap::new(&cx)),
            param_roots: Ref::new(&cx, ArenaSet::new(&cx)),
            root_brand_cache: Ref::new(&cx, ArenaMap::new(&cx)),
            edge_roots: Ref::new(&cx, Option::None),
            facts: Ref::new(&cx, PathFacts.{ roots: 0usize, kinds: 0usize, stored: ArenaMap::new(&cx), empty_sets: ArenaMap::new(&cx), linear_empty: ArenaMap::new(&cx) }),
            set_pool: ArenaVec::new(&cx),
            working: Places::new(ArenaSet::new(&cx), ArenaMap::new(&cx), ArenaMap::new(&cx)),
            label: Ref::new(&cx, Span::from_static(&cx, "")),
            env: Ref::new(&cx, ArenaMap::new(&cx)),
            used: Ref::new(&cx, ArenaSet::new(&cx)),
            places: Ref::new(&cx, Places::new(ArenaSet::new(&cx), ArenaMap::new(&cx), ArenaMap::new(&cx))),
            instr: Ref::new(&cx, Option::None),
        };
        checker.brands.copy(&cx).insert(&cx, static_brand(&cx));
        formation.discharge.set(&cx, Option::Some.(checker));
        formation.declarations(&cx);
        checker
    }

    fn formation_holds(self, &cx: Domain!['k], premise: Premise['k], kinds: ArenaMap[Span['k], Kind, 'k], premises: ArenaVec[Premise['k], 'k], home: Option[ModuleId['k]]) -> bool {
        let saved_kinds = self.kinds.copy(&cx);
        let saved_premises = self.premises.copy(&cx);
        let saved_home = self.home.copy(&cx);
        let saved_brands = self.brands.copy(&cx);
        self.kinds.set(&cx, kinds.clone(&cx));
        self.premises.set(&cx, premises);
        self.home.set(&cx, home);
        let brands: ArenaSet[Span['k], 'k] = ArenaSet::new(&cx);
        let names = kinds.keys(&cx);
        var i = 0usize;
        while i < names.len(&cx) {
            if C::same_kind(kinds.at(&cx, names.at(&cx, i)), Kind::Brand) {
                brands.insert(&cx, names.at(&cx, i));
            }
            i = i + 1usize;
        }
        self.brands.set(&cx, brands);
        let result = self.holds(&cx, premise.trait_name, premise.args);
        self.kinds.set(&cx, saved_kinds);
        self.premises.set(&cx, saved_premises);
        self.home.set(&cx, saved_home);
        self.brands.set(&cx, saved_brands);
        result
    }

    fn fail(self, &cx: Domain!['k], message: Slice[u8, 'static]) -> ! {
        kurs_error(&cx, Buffer!::new().push_bytes(&cx, self.location.copy(&cx)).push_static(": ").push_static(message).save(&cx), no_pos())
    }

    fn fun(self, &cx: Domain!['k]) -> Fun['k] {
        match self.current.copy(&cx) {
            Option::Some(fun) => fun,
            Option::None => kurs_error(&cx, Span::from_static(&cx, "internal error: no function is being checked"), no_pos()),
        }
    }

    fn scope(self, &cx: Domain!['k]) -> ArenaMap[Span['k], Kind, 'k] {
        with_brands(&cx, self.kinds.copy(&cx), self.brands.copy(&cx))
    }

    // ----------------------------------------------------------------- program --

    fn check(self, &cx: Domain!['k]) {
        let externs = self.program.externs.values(&cx);
        var e = 0usize;
        while e < externs.len(&cx) {
            let ext = externs.at(&cx, e);
            self.location.set(&cx, Buffer!::new().push_static("extern ").push_bytes(&cx, ext.name).save(&cx));
            let unit = match ext.ptypes {
                Option::Some(ptypes) => {
                    var i = 0usize;
                    while i < ptypes.len(&cx) {
                        self.has_memory_form(&cx, ptypes.at(&cx, i));
                        i = i + 1usize;
                    }
                },
                Option::None => match ext.ret {
                    Option::Some(ty) => self.has_memory_form(&cx, ty),
                    Option::None => (),
                },
            };
            let unit = match ext.ret {
                Option::Some(ty) => if !is_never(ty) {
                    self.foreign_result(&cx, ty);
                },
                Option::None => (),
            };
            e = e + 1usize;
        }
        let traits = self.program.traits.values(&cx);
        var t = 0usize;
        while t < traits.len(&cx) {
            let tr = traits.at(&cx, t);
            self.location.set(&cx, Buffer!::new().push_static("trait ").push_bytes(&cx, tr.name).save(&cx));
            if sealed(&cx, tr.name) {
                self.fail(&cx, "trait_name_is_reserved");
            }
            let names: ArenaSet[Span['k], 'k] = ArenaSet::new(&cx);
            var m = 0usize;
            while m < tr.methods.len(&cx) {
                names.insert(&cx, tr.methods.at(&cx, m).name);
                m = m + 1usize;
            }
            if names.len(&cx) != tr.methods.len(&cx) {
                self.fail(&cx, "duplicate_trait_method");
            }
            t = t + 1usize;
        }
        let funs = self.program.funs.values(&cx);
        var f = 0usize;
        while f < funs.len(&cx) {
            self.check_fun(&cx, funs.at(&cx, f), ArenaVec::new(&cx), ArenaVec::new(&cx), FunKey::Function.(funs.at(&cx, f).name));
            f = f + 1usize;
        }
        let trait_names = self.program.instances.keys(&cx);
        var g = 0usize;
        while g < trait_names.len(&cx) {
            let insts = self.program.instances.at(&cx, trait_names.at(&cx, g));
            var i = 0usize;
            while i < insts.len(&cx) {
                self.check_instance(&cx, insts.at(&cx, i), trait_names.at(&cx, g), i);
                i = i + 1usize;
            }
            g = g + 1usize;
        }
        let datas = self.program.datas.values(&cx);
        var d = 0usize;
        while d < datas.len(&cx) {
            let data = datas.at(&cx, d);
            self.location.set(&cx, data.name);
            self.home.set(&cx, Option::Some.(match data.home {
                Option::Some(m) => m,
                Option::None => nowhere(&cx),
            }));
            self.check_data(&cx, data.ty, data.init);
            d = d + 1usize;
        }
    }

    // `group` is the key of the instance's list in the program, and `index` its place there.
    fn check_instance(self, &cx: Domain!['k], inst: Instance['k], group: Span['k], index: usize) {
        let found = self.program.traits.get(&cx, inst.trait_name);
        self.location.set(&cx, Buffer!::new().push_static("instance ").push_bytes(&cx, inst.trait_name).save(&cx));
        if sealed(&cx, inst.trait_name) {
            self.fail(&cx, "trait_name_is_reserved");
        }
        let tr = match found {
            Option::Some(tr) => tr,
            Option::None => self.fail(&cx, "instance_unknown_trait_wrong"),
        };
        if tr.params.len(&cx) != inst.head.len(&cx) {
            self.fail(&cx, "instance_unknown_trait_wrong");
        }
        let head: ArenaMap[Span['k], Type['k], 'k] = ArenaMap::new(&cx);
        var h = 0usize;
        while h < tr.params.len(&cx) {
            head.insert(&cx, tr.params.at(&cx, h), inst.head.at(&cx, h));
            h = h + 1usize;
        }
        let by_name: ArenaMap[Span['k], Fun['k], 'k] = ArenaMap::new(&cx);
        var i = 0usize;
        while i < inst.methods.len(&cx) {
            by_name.insert(&cx, inst.methods.at(&cx, i).name, inst.methods.at(&cx, i));
            i = i + 1usize;
        }
        if by_name.len(&cx) != inst.methods.len(&cx) {
            self.fail(&cx, "duplicate_instance_method");
        }
        let declared: ArenaSet[Span['k], 'k] = ArenaSet::new(&cx);
        var s = 0usize;
        while s < tr.methods.len(&cx) {
            declared.insert(&cx, tr.methods.at(&cx, s).name);
            s = s + 1usize;
        }
        if !subset(&cx, texts_set(&cx, by_name.keys(&cx)), declared) {
            self.fail(&cx, "instance_method_not_in_trait");
        }
        var m = 0usize;
        while m < tr.methods.len(&cx) {
            let sig = tr.methods.at(&cx, m);
            let fun = match by_name.get(&cx, sig.name) {
                Option::Some(fun) => fun,
                Option::None => self.fail(&cx, "instance_lacks_method"),
            };
            if !fun.params.is_empty(&cx) || !fun.premises.is_empty(&cx) {
                self.fail(&cx, "instance_method_has_own_quantifier");
            }
            let want = C::fn_type(&cx, subst_all(&cx, sig.ptypes, head, self.counter), subst(&cx, sig.ret, head, self.counter), ArenaVec::new(&cx), false, sig.places);
            let got = C::fn_type(&cx, fun.ptypes, fun.ret, ArenaVec::new(&cx), false, fun.places(&cx));
            if !equal(&cx, got, want) || (fun.is_unsafe && !sig.is_unsafe) {
                self.fail(&cx, "method_does_match_trait");
            }
            self.check_fun(&cx, fun, inst.params, inst.premises, FunKey::Method.(group, index, sig.name));
            m = m + 1usize;
        }
    }

    fn check_data(self, &cx: Domain!['k], ty: Type['k], form: Form['k]) {
        let s = self.types.shape(&cx, ty, self.home.copy(&cx));
        let unit = match s {
            Type::Prim(_name) => {
                if form.is_list() || form.is_str() {
                    self.fail(&cx, "data_scalar_requires_atom");
                }
                self.scalar_literal(&cx, s, form.text);
                return ();
            },
            Type::Tuple(_elems) => (),
            Type::Struct(_fields) => (),
            Type::Array(_elem, _length) => (),
            _ => self.fail(&cx, "data_initializer_type"),
        };
        if !form.is_list() {
            self.fail(&cx, "data_product_requires_list");
        }
        let unit = match s {
            Type::Array(elem, length) => {
                var count = 0u64;
                var i = 0usize;
                while i < form.len(&cx) {
                    let part = form.at(&cx, i);
                    if C::same(&cx, elem.copy(&cx), C::prim(&cx, "u8")) && part.is_str() {
                        count = count + (part.text.len() as u64);
                    } else {
                        self.check_data(&cx, elem.copy(&cx), part);
                        count = count + 1u64;
                    }
                    i = i + 1usize;
                }
                if count != length {
                    self.fail(&cx, "data_initializer_wrong_number");
                }
                return ();
            },
            _ => (),
        };
        let parts = self.types.fields(&cx, ty, self.home.copy(&cx));
        if form.len(&cx) != parts.len(&cx) {
            self.fail(&cx, "data_initializer_wrong_number");
        }
        var i = 0usize;
        while i < parts.len(&cx) {
            self.check_data(&cx, parts.at(&cx, i), form.at(&cx, i));
            i = i + 1usize;
        }
    }

    // ---------------------------------------------------------------- function --

    fn check_fun(self, &cx: Domain!['k], fun: Fun['k], outer_params: ArenaVec[Param['k], 'k], outer_premises: ArenaVec[Premise['k], 'k], key: FunKey['k]) {
        self.formation.function(&cx, fun, outer_params, outer_premises);
        self.current.set(&cx, Option::Some.(fun));
        self.location.set(&cx, fun.name);
        let params = outer_params.concat(&cx, fun.params);
        self.params.set(&cx, params);
        let kinds: ArenaMap[Span['k], Kind, 'k] = ArenaMap::new(&cx);
        var p = 0usize;
        while p < params.len(&cx) {
            kinds.insert(&cx, params.at(&cx, p).name, params.at(&cx, p).kind);
            p = p + 1usize;
        }
        self.kinds.set(&cx, kinds);
        self.premises.set(&cx, outer_premises.concat(&cx, fun.premises));
        self.home.set(&cx, Option::Some.(match fun.home {
            Option::Some(m) => m,
            Option::None => nowhere(&cx),
        }));
        let blocks: ArenaMap[Span['k], Block['k], 'k] = ArenaMap::new(&cx);
        var b = 0usize;
        while b < fun.blocks.len(&cx) {
            blocks.insert(&cx, fun.blocks.at(&cx, b).label, fun.blocks.at(&cx, b));
            b = b + 1usize;
        }
        self.blocks.set(&cx, blocks);
        let record = match self.typed.get(&cx, key) {
            Option::Some(r) => r,
            Option::None => {
                let r: ArenaMap[(Span['k], Span['k]), Type['k], 'k] = ArenaMap::new(&cx);
                self.typed.insert(&cx, key, r);
                r
            },
        };
        self.record.set(&cx, record);
        if blocks.len(&cx) != fun.blocks.len(&cx) {
            self.fail(&cx, "duplicate_block_label");
        }
        let entry = fun.blocks.at(&cx, 0usize);
        if entry.params.len(&cx) != fun.ptypes.len(&cx) || !entry.brands.is_empty(&cx) {
            self.fail(&cx, "entry_parameters_disagree_signature");
        }
        let roots: ArenaMap[Span['k], Type['k], 'k] = ArenaMap::new(&cx);
        var l = 0usize;
        while l < fun.locals.len(&cx) {
            roots.insert(&cx, fun.locals.at(&cx, l).name, fun.locals.at(&cx, l).type);
            l = l + 1usize;
        }
        self.roots.set(&cx, roots);
        self.root_brand_cache.set(&cx, ArenaMap::new(&cx));
        self.edge_roots.set(&cx, Option::None);
        if roots.len(&cx) != fun.locals.len(&cx) {
            self.fail(&cx, "duplicate_place_root");
        }
        let param_roots: ArenaSet[Span['k], 'k] = ArenaSet::new(&cx);
        var i = 0usize;
        while i < entry.params.len(&cx) {
            let binding = entry.params.at(&cx, i);
            if !equal(&cx, binding.type, fun.ptypes.at(&cx, i)) {
                self.fail(&cx, "entry_parameter_disagrees_signature");
            }
            if binding.name.starts_with(&cx, Span::from_static(&cx, "&")) {
                if roots.contains(&cx, binding.name) {
                    self.fail(&cx, "duplicate_place_root");
                }
                roots.insert(&cx, binding.name, binding.type);
            }
            i = i + 1usize;
        }
        var j = 0usize;
        while j < entry.params.len(&cx) {
            if entry.params.at(&cx, j).name.starts_with(&cx, Span::from_static(&cx, "&")) {
                param_roots.insert(&cx, entry.params.at(&cx, j).name);
            }
            j = j + 1usize;
        }
        self.param_roots.set(&cx, param_roots);
        var k = 0usize;
        while k < fun.blocks.len(&cx) {
            self.check_block(&cx, fun.blocks.at(&cx, k), k == 0usize);
            k = k + 1usize;
        }
    }

    fn check_block(self, &cx: Domain!['k], block: Block['k], is_entry: bool) {
        let fun = self.fun(&cx);
        self.formation.pos.set(&cx, block.pos);
        self.location.set(&cx, Buffer!::new().push_bytes(&cx, fun.name).push_static("/").push_bytes(&cx, block.label).save(&cx));
        self.label.set(&cx, block.label);
        let brands = brand_params(&cx, self.params.copy(&cx));
        var b = 0usize;
        while b < block.brands.len(&cx) {
            brands.insert(&cx, block.brands.at(&cx, b));
            b = b + 1usize;
        }
        brands.insert(&cx, static_brand(&cx));
        self.brands.set(&cx, brands);
        self.env.set(&cx, ArenaMap::new(&cx));
        self.used.set(&cx, ArenaSet::new(&cx));
        var p = 0usize;
        while p < block.params.len(&cx) {
            let binding = block.params.at(&cx, p);
            if binding.name.starts_with(&cx, Span::from_static(&cx, "&")) {
                if !is_entry {
                    self.fail(&cx, "only_entry_declares_place");
                }
            } else {
                self.bind(&cx, binding.name, binding.type);
            }
            p = p + 1usize;
        }
        if is_entry {
            if !block.opened.is_empty(&cx) {
                self.fail(&cx, "entry_cannot_assume_opened_views");
            }
            let state = self.working;
            state.empty.clear(&cx);
            var l = 0usize;
            while l < fun.locals.len(&cx) {
                state.empty.insert(&cx, fun.locals.at(&cx, l).name);
                l = l + 1usize;
            }
            state.known.clear(&cx);
            state.opened.clear(&cx);
            self.places.set(&cx, state);
        } else {
            let state = self.working;
            state.known.clear(&cx);
            var k = 0usize;
            while k < block.known.len(&cx) {
                state.known.insert(&cx, block.known.at(&cx, k).path, block.known.at(&cx, k).variant);
                k = k + 1usize;
            }
            state.empty.assign(&cx, self.empty_set(&cx, block));
            state.opened.clear(&cx);
            self.places.set(&cx, state);
            let paths: ArenaSet[Span['k], 'k] = ArenaSet::new(&cx);
            var o = 0usize;
            while o < block.opened.len(&cx) {
                paths.insert(&cx, block.opened.at(&cx, o).path);
                o = o + 1usize;
            }
            if paths.len(&cx) != block.opened.len(&cx) {
                self.fail(&cx, "duplicate_opened_view");
            }
            let sorted = block.opened.clone(&cx);
            sorted.sort_by(&cx, |&cx, a, b| a.path.cmp(&cx, b.path));
            let block_brands = texts_set(&cx, block.brands);
            var s = 0usize;
            while s < sorted.len(&cx) {
                let path = sorted.at(&cx, s).path;
                let view = sorted.at(&cx, s).brands;
                let view_set = texts_set(&cx, view);
                let ty = self.path_type(&cx, path);
                let fits_package = match ty {
                    Type::Exists(binders, _body) => binders.len(&cx) == view.len(&cx) && view_set.len(&cx) == view.len(&cx),
                    _ => false,
                };
                if !fits_package {
                    self.fail(&cx, "opened_contract_requires_package_brands");
                }
                if !subset(&cx, view_set, block_brands) {
                    self.fail(&cx, "opened_contract_requires_block_brands");
                }
                let others = self.places.copy(&cx).opened.values(&cx);
                var x = 0usize;
                while x < others.len(&cx) {
                    if sets_meet(&cx, view_set, texts_set(&cx, others.at(&cx, x))) {
                        self.fail(&cx, "opened_contract_brand_names_one_view");
                    }
                    x = x + 1usize;
                }
                self.places.copy(&cx).opened.insert(&cx, path, view);
                s = s + 1usize;
            }
            var e = 0usize;
            while e < block.empty.len(&cx) {
                let unit = self.path_type(&cx, block.empty.at(&cx, e));
                e = e + 1usize;
            }
            var n = 0usize;
            while n < block.known.len(&cx) {
                let known = block.known.at(&cx, n);
                let names_variant = match self.types.shape(&cx, self.path_type(&cx, known.path), self.home.copy(&cx)) {
                    Type::Enum(variants) => member(&cx, variants, known.variant).is_some(),
                    _ => false,
                };
                if !names_variant {
                    self.fail(&cx, "known_contract_names_a_variant");
                }
                n = n + 1usize;
            }
        }
        var last: Option[Instr['k]] = Option::None;
        var i = 0usize;
        while i < block.instrs.len(&cx) {
            self.check_instr(&cx, block.instrs.at(&cx, i));
            last = Option::Some.(block.instrs.at(&cx, i));
            i = i + 1usize;
        }
        self.check_term(&cx, block.term, last);
    }

    // -------------------------------------------------------------- SSA values --

    fn bind(self, &cx: Domain!['k], name: Span['k], ty: Type['k]) {
        self.formation.fits(&cx, ty, Kind::Any, self.scope(&cx));
        let env = self.env.copy(&cx);
        if env.contains(&cx, name) {
            self.fail(&cx, "defined_twice");
        }
        env.insert(&cx, name, ty);
        self.record.copy(&cx).insert(&cx, (self.label.copy(&cx), name), ty);
    }

    fn use_value(self, &cx: Domain!['k], name: Span['k]) -> Type['k] {
        let ty = self.peek(&cx, name);
        self.used.copy(&cx).insert(&cx, name);
        ty
    }

    fn peek(self, &cx: Domain!['k], name: Span['k]) -> Type['k] {
        let ty = match self.env.copy(&cx).get(&cx, name) {
            Option::Some(ty) => ty,
            Option::None => self.fail(&cx, "defined"),
        };
        if self.used.copy(&cx).contains(&cx, name) {
            self.fail(&cx, "was_already_consumed");
        }
        ty
    }

    // `free_brands` of a root's type, computed once per function.
    fn root_brands(self, &cx: Domain!['k], root: Span['k]) -> ArenaSet[Span['k], 'k] {
        let cache = self.root_brand_cache.copy(&cx);
        match cache.get(&cx, root) {
            Option::Some(brands) => brands,
            Option::None => {
                let brands = free_brands(&cx, self.roots.copy(&cx).at(&cx, root));
                cache.insert(&cx, root, brands);
                brands
            },
        }
    }

    // The empty paths `block` declares, as a set, made once per function.
    fn empty_set(self, &cx: Domain!['k], block: Block['k]) -> ArenaSet[Span['k], 'k] {
        let cache = self.path_facts(&cx).empty_sets;
        match cache.get(&cx, block.label) {
            Option::Some(set) => set,
            Option::None => {
                let n = cache.len(&cx);
                let set = match self.set_pool.get(&cx, n) {
                    Option::Some(pooled) => pooled,
                    Option::None => {
                        let made: ArenaSet[Span['k], 'k] = ArenaSet::new(&cx);
                        self.set_pool.push(&cx, made);
                        made
                    },
                };
                set.clear(&cx);
                set.insert_all(&cx, block.empty);
                cache.insert(&cx, block.label, set);
                set
            },
        }
    }

    fn copy_type(self, &cx: Domain!['k], ty: Type['k]) -> bool {
        let kinds = self.kinds.copy(&cx);
        let identity = kinds.address();
        let (asked, known) = self.copies.copy(&cx);
        let cache = if asked == identity {
            known
        } else {
            let fresh: ArenaMap[Type['k], bool, 'k] = ArenaMap::new(&cx);
            self.copies.set(&cx, (identity, fresh));
            fresh
        };
        match cache.get(&cx, ty) {
            Option::Some(answer) => answer,
            Option::None => {
                let answer = self.types.is_copy(&cx, ty, kinds);
                cache.insert(&cx, ty, answer);
                answer
            },
        }
    }

    fn accounted(self, &cx: Domain!['k], used: ArenaSet[Span['k], 'k]) {
        let env = self.env.copy(&cx);
        var i = 0usize;
        while i < env.positions(&cx) {
            match env.key_at(&cx, i) {
                Option::Some(name) => {
                    if !used.contains(&cx, name) && !self.copy_type(&cx, env.at(&cx, name)) {
                        self.fail(&cx, "linear_value_never_consumed");
                    }
                },
                Option::None => (),
            };
            i = i + 1usize;
        }
    }

    // ------------------------------------------------------------------ places --

    // The value of a place query, stopping with its failure.
    forall T.
    fn got(self, &cx: Domain!['k], result: Result[T, Slice[u8, 'static]]) -> T {
        match result {
            Result::Ok(value) => value,
            Result::Err(message) => self.fail(&cx, message),
        }
    }

    fn path_type(self, &cx: Domain!['k], path: Span['k]) -> Type['k] {
        self.got(&cx, self.place_type(&cx, path))
    }

    fn storage_type(self, &cx: Domain!['k], path: Span['k]) -> Type['k] {
        self.got(&cx, self.place_storage(&cx, path))
    }

    fn view(self, &cx: Domain!['k], path: Span['k], ty: Type['k]) -> Type['k] {
        self.got(&cx, self.place_view(&cx, path, ty))
    }

    // Whether p may be discarded; ty is its stored type, before its own view.
    fn no_linear(self, &cx: Domain!['k], path: Span['k], ty: Type['k]) -> bool {
        self.got(&cx, self.discardable(&cx, path, ty))
    }

    // The place queries return the checker's failure rather than stop, for place flow, which leaves
    // a malformed path to the checker.
    fn place_type(self, &cx: Domain!['k], path: Span['k]) -> Result[Type['k], Slice[u8, 'static]] {
        let stored = self.place_storage(&cx, path)?;
        self.place_view(&cx, path, stored)
    }

    // The path facts of the current roots and kinds, cleared when either map changes.
    fn path_facts(self, &cx: Domain!['k]) -> PathFacts['k] {
        let roots = self.roots.copy(&cx).address();
        let kinds = self.kinds.copy(&cx).address();
        let facts = self.facts.copy(&cx);
        if facts.roots == roots && facts.kinds == kinds {
            return facts;
        }
        facts.stored.clear(&cx);
        facts.empty_sets.clear(&cx);
        facts.linear_empty.clear(&cx);
        let fresh = PathFacts.{ roots, kinds, stored: facts.stored, empty_sets: facts.empty_sets, linear_empty: facts.linear_empty };
        self.facts.set(&cx, fresh);
        fresh
    }

    // The final slot's stored type, applying views only to its ancestors.
    fn place_storage(self, &cx: Domain!['k], path: Span['k]) -> Result[Type['k], Slice[u8, 'static]] {
        let found = self.storage_fact(&cx, path)?;
        Result::Ok.(found.type)
    }

    // `place_storage`, with what is known of the type. A path that no place state decides (no view
    // is open, and no enum is on the way) is kept in `stored` once finding it drew no fresh name,
    // and answered from there while no view is open.
    fn storage_fact(self, &cx: Domain!['k], path: Span['k]) -> Result[Stored['k], Slice[u8, 'static]] {
        let stateless = self.places.copy(&cx).opened.is_empty(&cx);
        let stored = self.path_facts(&cx).stored;
        if stateless {
            match stored.get(&cx, path) {
                Option::Some(fact) => {
                    let (ty, copy) = fact;
                    return Result::Ok.(Stored.{ type: ty, copy, kept: true });
                },
                Option::None => (),
            };
        }
        let before = self.counter.next.copy(&cx);
        let (ty, decided) = self.find_storage(&cx, path)?;
        let kept = stateless && !decided && self.counter.next.copy(&cx) == before;
        if kept {
            stored.insert(&cx, path, (ty, Option::None));
        }
        Result::Ok.(Stored.{ type: ty, copy: Option::None, kept })
    }

    // Whether the stored type `found` of `path` is Copy, kept with it where it is kept.
    fn storage_copy(self, &cx: Domain!['k], path: Span['k], found: Stored['k]) -> bool {
        match found.copy {
            Option::Some(answer) => answer,
            Option::None => {
                let answer = self.copy_type(&cx, found.type);
                if found.kept {
                    self.path_facts(&cx).stored.insert(&cx, path, (found.type, Option::Some.(answer)));
                }
                answer
            },
        }
    }

    // `discardable(path, place_storage(path))`, stopping at the first failure of either.
    fn storage_discardable(self, &cx: Domain!['k], path: Span['k]) -> Result[bool, Slice[u8, 'static]] {
        let (result, always) = self.empty_discardable(&cx, path);
        result
    }

    // `storage_discardable`, and whether `path` holds no linear contents in every state of the
    // function while no view is open: no state decides its stored type, and that type is Copy.
    fn empty_discardable(self, &cx: Domain!['k], path: Span['k]) -> (Result[bool, Slice[u8, 'static]], bool) {
        match self.storage_fact(&cx, path) {
            Result::Ok(found) => {
                let copy = self.storage_copy(&cx, path, found);
                (self.discardable_with(&cx, path, found.type, copy), copy && found.kept)
            },
            Result::Err(message) => (Result::Err.(message), false),
        }
    }

    // The paths `block` declares empty that an edge into it must show hold no linear contents, in
    // order: all of them, or, once an edge has found them while no view was open, those of them
    // `empty_discardable` does not answer for every state. The others answer `Ok(true)` with
    // nothing found or drawn, so leaving them out changes nothing.
    fn empty_to_check(self, &cx: Domain!['k], block: Block['k]) -> ArenaVec[Span['k], 'k] {
        if self.places.copy(&cx).opened.is_empty(&cx) {
            match self.path_facts(&cx).linear_empty.get(&cx, block.label) {
                Option::Some(paths) => return paths,
                Option::None => (),
            };
        }
        block.empty
    }

    // Records what one edge into `block` found of the paths `empty_to_check` gave: `rest` are
    // those not answered for every state. Kept only when the edge checked all of `block.empty`
    // with no view open.
    fn checked_empty(self, &cx: Domain!['k], block: Block['k], checked: ArenaVec[Span['k], 'k], rest: ArenaVec[Span['k], 'k]) {
        if checked.address() == block.empty.address() && rest.address() != checked.address() && self.places.copy(&cx).opened.is_empty(&cx) {
            self.path_facts(&cx).linear_empty.insert(&cx, block.label, rest);
        }
    }

    // The stored type of `path`, and whether the place state decided it: a known variant chose an
    // enum's component on the way.
    fn find_storage(self, &cx: Domain!['k], path: Span['k]) -> Result[(Type['k], bool), Slice[u8, 'static]] {
        // The segments are read in place: `sofar` is the path up to the current one.
        var end = segment_end(&cx, path, 0usize);
        let roots = self.roots.copy(&cx);
        var ty = match roots.get(&cx, path.slice(0usize, end)) {
            Option::Some(t) => t,
            Option::None => return Result::Err.("place_function"),
        };
        var decided = false;
        while end < path.len() {
            let sofar = path.slice(0usize, end);
            let next = segment_end(&cx, path, end + 1usize);
            let seg = path.slice(end + 1usize, next);
            ty = self.place_view(&cx, sofar, ty)?;
            let component = match self.types.shape(&cx, ty, self.home.copy(&cx)) {
                Type::Enum(variants) => {
                    decided = true;
                    let known = match self.places.copy(&cx).known.get(&cx, sofar) {
                        Option::Some(v) => v.eq(&cx, seg),
                        Option::None => false,
                    };
                    if !known {
                        return Result::Err.("known");
                    }
                    member(&cx, variants, seg)
                },
                Type::Tuple(elems) => match canonical_tuple_index(&cx, seg, elems.len(&cx)) {
                    Option::Some(index) => Option::Some.(elems.at(&cx, index)),
                    Option::None => Option::None,
                },
                Type::Struct(fields) => member(&cx, fields, seg),
                _ => Option::None,
            };
            ty = match component {
                Option::Some(t) => t,
                Option::None => return Result::Err.("names_component"),
            };
            end = next;
        }
        Result::Ok.((ty, decided))
    }

    fn place_view(self, &cx: Domain!['k], path: Span['k], ty: Type['k]) -> Result[Type['k], Slice[u8, 'static]] {
        let brands = match self.places.copy(&cx).opened.get(&cx, path) {
            Option::Some(b) => b,
            Option::None => return Result::Ok.(ty),
        };
        match ty {
            Type::Exists(binders, body) => {
                let sub: ArenaMap[Span['k], Type['k], 'k] = ArenaMap::new(&cx);
                var i = 0usize;
                while i < binders.len(&cx) && i < brands.len(&cx) {
                    sub.insert(&cx, binders.at(&cx, i), Type::Skolem.(brands.at(&cx, i)));
                    i = i + 1usize;
                }
                Result::Ok.(subst(&cx, body.copy(&cx), sub, self.counter))
            },
            _ => Result::Err.("opened_view_requires_existential"),
        }
    }

    fn discardable(self, &cx: Domain!['k], path: Span['k], ty: Type['k]) -> Result[bool, Slice[u8, 'static]] {
        self.discardable_with(&cx, path, ty, self.copy_type(&cx, ty))
    }

    // `discardable`, given whether `ty` is Copy.
    fn discardable_with(self, &cx: Domain!['k], path: Span['k], ty: Type['k], copy: bool) -> Result[bool, Slice[u8, 'static]] {
        let places = self.places.copy(&cx);
        if copy || places.covered(&cx, path) {
            return Result::Ok.(true);
        }
        if places.opened.contains(&cx, path) {
            let viewed = self.place_view(&cx, path, ty)?;
            return self.discardable_parts(&cx, path, viewed);
        }
        self.linear_parts_discardable(&cx, path, ty)
    }

    fn discardable_parts(self, &cx: Domain!['k], path: Span['k], ty: Type['k]) -> Result[bool, Slice[u8, 'static]] {
        if self.copy_type(&cx, ty) {
            return Result::Ok.(true);
        }
        self.linear_parts_discardable(&cx, path, ty)
    }

    // `discardable_parts` of a type that is not Copy.
    fn linear_parts_discardable(self, &cx: Domain!['k], path: Span['k], ty: Type['k]) -> Result[bool, Slice[u8, 'static]] {
        let places = self.places.copy(&cx);
        let decomposed = places.empty.any(&cx, |&cx, z: Span['k]| prefix(&cx, path, z) && !z.eq(&cx, path));
        let known = places.known.get(&cx, path);
        if !decomposed && known.is_none() {
            // A full non-Copy value cannot be discarded, irrespective of shape.
            // In particular, abstract parameters have no nominal body to unfold.
            return Result::Ok.(false);
        }
        let rows: ArenaVec[Member['k], 'k] = match self.types.shape(&cx, ty, self.home.copy(&cx)) {
            Type::Enum(variants) => match known {
                Option::Some(variant) => {
                    let payload = match member(&cx, variants, variant) {
                        Option::Some(t) => t,
                        Option::None => kurs_error(&cx, Span::from_static(&cx, "internal error: a known variant is not a variant"), no_pos()),
                    };
                    return self.discardable(&cx, Buffer!::new().push_bytes(&cx, path).push_static(".").push_bytes(&cx, variant).save(&cx), payload);
                },
                Option::None => return Result::Ok.(false),
            },
            Type::Struct(fields) => {
                if !decomposed {
                    return Result::Ok.(false);
                }
                fields
            },
            Type::Tuple(elems) => {
                if !decomposed {
                    return Result::Ok.(false);
                }
                let out: ArenaVec[Member['k], 'k] = ArenaVec::new(&cx);
                var k = 0usize;
                while k < elems.len(&cx) {
                    out.push(&cx, Member.{ name: Buffer!::new().push_usize(k).save(&cx), type: elems.at(&cx, k) });
                    k = k + 1usize;
                }
                out
            },
            _ => return Result::Ok.(false),
        };
        var r = 0usize;
        while r < rows.len(&cx) {
            if !self.discardable(&cx, Buffer!::new().push_bytes(&cx, path).push_static(".").push_bytes(&cx, rows.at(&cx, r).name).save(&cx), rows.at(&cx, r).type)? {
                return Result::Ok.(false);
            }
            r = r + 1usize;
        }
        Result::Ok.(true)
    }

    // A view opened strictly inside `path` is closed (packed) before `path` is loaded or lent.
    fn nested_view_closed(self, &cx: Domain!['k], path: Span['k]) {
        if self.places.copy(&cx).opened.any(&cx, |&cx, q: Span['k], value| prefix(&cx, path, q) && !q.eq(&cx, path)) {
            self.fail(&cx, "nested_view_open");
        }
    }

    fn load(self, &cx: Domain!['k], path: Span['k]) -> Type['k] {
        let ty = self.path_type(&cx, path);
        if !self.places.copy(&cx).full(&cx, path) {
            self.fail(&cx, "full");
        }
        self.nested_view_closed(&cx, path);
        if !self.copy_type(&cx, ty) {
            self.places.copy(&cx).empty.insert(&cx, path);
            self.places.copy(&cx).forget(&cx, path, true);
        }
        ty
    }

    fn store(self, &cx: Domain!['k], path: Span['k], ty: Type['k]) {
        let want = self.path_type(&cx, path);
        if !fits(&cx, ty, want) {
            self.fail(&cx, "storing_into");
        }
        let places = self.places.copy(&cx);
        if places.empty.any(&cx, |&cx, z: Span['k]| prefix(&cx, z, path) && !z.eq(&cx, path)) {
            self.fail(&cx, "empty_ancestor_store_whole");
        }
        let empty = places.empty.keys(&cx);
        // What the store overwrites holds no linear contents: a Copy value, or a place whose linear
        // parts were moved out (dropping that empty linear place is its destruct in the value-only
        // translation).
        if !self.got(&cx, self.storage_discardable(&cx, path)) {
            self.fail(&cx, "storing_into_discard_linear");
        }
        var j = 0usize;
        while j < empty.len(&cx) {
            if prefix(&cx, path, empty.at(&cx, j)) {
                places.empty.remove(&cx, empty.at(&cx, j));
            }
            j = j + 1usize;
        }
        places.forget(&cx, path, true);
    }

    // Any number of whole roots, and at most two paths below roots, which part at a struct or tuple.
    fn lend(self, &cx: Domain!['k], paths: ArenaVec[Span['k], 'k]) {
        var i = 0usize;
        while i < paths.len(&cx) {
            let p = paths.at(&cx, i);
            if !self.places.copy(&cx).full(&cx, p) {
                self.fail(&cx, "lent_place_full");
            }
            self.nested_view_closed(&cx, p);
            var j = i + 1usize;
            while j < paths.len(&cx) {
                if overlap(&cx, p, paths.at(&cx, j)) {
                    self.fail(&cx, "lent_places_overlap");
                }
                j = j + 1usize;
            }
            i = i + 1usize;
        }
        let nested: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
        var k = 0usize;
        while k < paths.len(&cx) {
            if paths.at(&cx, k).contains(&cx, Span::from_static(&cx, ".")) {
                nested.push(&cx, paths.at(&cx, k));
            }
            k = k + 1usize;
        }
        if nested.len(&cx) > 2usize {
            self.fail(&cx, "at_most_two_nested_lends");
        }
        if nested.len(&cx) == 2usize && !self.product_branches(&cx, nested) {
            self.fail(&cx, "nested_lends_part_at_a_product");
        }
    }

    fn common_parent(self, &cx: Domain!['k], paths: ArenaVec[Span['k], 'k]) -> Span['k] {
        let parts = split_all(&cx, paths);
        parts.at(&cx, 0usize).slice(&cx, 0usize, common_depth(&cx, parts)).join(&cx, ".")
    }

    // The paths part at a struct or tuple, and reach it through structs and tuples only, past no
    // known variant or opened view.
    fn product_branches(self, &cx: Domain!['k], paths: ArenaVec[Span['k], 'k]) -> bool {
        self.got(&cx, self.parts_at_product(&cx, paths))
    }

    // `product_branches`, or the failure of a place query on the way, for place flow.
    fn parts_at_product(self, &cx: Domain!['k], paths: ArenaVec[Span['k], 'k]) -> Result[bool, Slice[u8, 'static]] {
        let parts = split_all(&cx, paths);
        let common = common_depth(&cx, parts);
        if segments_agree(&cx, parts, common) {
            return Result::Ok.(false);
        }
        let places = self.places.copy(&cx);
        var i = 0usize;
        while i < parts.len(&cx) {
            let s = parts.at(&cx, i);
            var depth = 1usize;
            while depth < s.len(&cx) {
                let step = s.slice(&cx, 0usize, depth).join(&cx, ".");
                if places.known.contains(&cx, step) || places.opened.contains(&cx, step) {
                    return Result::Ok.(false);
                }
                let ty = self.place_type(&cx, step)?;
                if !is_struct_or_tuple(self.types.shape(&cx, ty, self.home.copy(&cx))) {
                    return Result::Ok.(false);
                }
                depth = depth + 1usize;
            }
            i = i + 1usize;
        }
        Result::Ok.(true)
    }

    fn after_call(self, &cx: Domain!['k], paths: ArenaVec[Span['k], 'k]) {
        var i = 0usize;
        while i < paths.len(&cx) {
            self.places.copy(&cx).forget(&cx, paths.at(&cx, i), true);
            i = i + 1usize;
        }
    }

    // ---------------------------------------------------------------- premises --

    // A premise is discharged by an assumption, or by an instance whose head matches and whose own
    // premises hold.
    fn holds(self, &cx: Domain!['k], trait_name: Span['k], args: ArenaVec[Type['k], 'k]) -> bool {
        if trait_name.is(&cx, "Exposed") {
            return args.len(&cx) == 1usize && self.types.exposure_available(&cx, args.at(&cx, 0usize), self.home.copy(&cx), self.kinds.copy(&cx), self.premises.copy(&cx));
        }
        let premises = self.premises.copy(&cx);
        var i = 0usize;
        while i < premises.len(&cx) {
            let p = premises.at(&cx, i);
            if p.trait_name.eq(&cx, trait_name) && p.args.len(&cx) == args.len(&cx) {
                var all = true;
                var j = 0usize;
                while all && j < args.len(&cx) {
                    all = equal(&cx, p.args.at(&cx, j), args.at(&cx, j));
                    j = j + 1usize;
                }
                if all {
                    return true;
                }
            }
            i = i + 1usize;
        }
        self.find_instance(&cx, trait_name, args).is_some()
    }

    // Select the unique coherent head, with its index among the trait's instances; this does not
    // authorize its use.
    fn matching_instance(self, &cx: Domain!['k], trait_name: Span['k], args: ArenaVec[Type['k], 'k]) -> Option[(usize, Instance['k], ArenaMap[Span['k], Type['k], 'k])] {
        matching_instance(&cx, self.program, self.counter, trait_name, args)
    }

    fn find_instance(self, &cx: Domain!['k], trait_name: Span['k], args: ArenaVec[Type['k], 'k]) -> Option[(usize, Instance['k], ArenaMap[Span['k], Type['k], 'k])] {
        let found = self.matching_instance(&cx, trait_name, args);
        let (_index, inst, sub) = match found {
            Option::Some(f) => f,
            Option::None => {
                return Option::None;
            },
        };
        var p = 0usize;
        while p < inst.params.len(&cx) {
            let param = inst.params.at(&cx, p);
            if C::same_kind(param.kind, Kind::Copy) && !self.copy_type(&cx, sub.at(&cx, param.name)) {
                return Option::None;
            }
            p = p + 1usize;
        }
        // A matched type can have been formed under a function type's own premises. Those
        // assumptions do not escape into this instance call.
        let saved_premises = self.formation.premises.copy(&cx);
        let saved_home = self.formation.home.copy(&cx);
        self.formation.premises.set(&cx, self.premises.copy(&cx));
        self.formation.home.set(&cx, self.home.copy(&cx));
        let chosen: ArenaVec[Type['k], 'k] = ArenaVec::new(&cx);
        var c = 0usize;
        while c < inst.params.len(&cx) {
            chosen.push(&cx, sub.at(&cx, inst.params.at(&cx, c).name));
            c = c + 1usize;
        }
        self.formation.arguments(&cx, inst.params, chosen, self.scope(&cx), false);
        self.formation.premises.set(&cx, saved_premises);
        self.formation.home.set(&cx, saved_home);
        var q = 0usize;
        while q < inst.premises.len(&cx) {
            let premise = inst.premises.at(&cx, q);
            if !self.holds(&cx, premise.trait_name, subst_all(&cx, premise.args, sub, self.counter)) {
                return Option::None;
            }
            q = q + 1usize;
        }
        found
    }

    // -------------------------------------------------------------- signatures --

    fn instantiate(self, &cx: Domain!['k], params: ArenaVec[Param['k], 'k], premises: ArenaVec[Premise['k], 'k], tys: ArenaVec[Type['k], 'k]) -> ArenaMap[Span['k], Type['k], 'k] {
        if tys.len(&cx) != params.len(&cx) {
            self.fail(&cx, "takes_type_arguments_got");
        }
        let sub: ArenaMap[Span['k], Type['k], 'k] = ArenaMap::new(&cx);
        var i = 0usize;
        while i < params.len(&cx) {
            let p = params.at(&cx, i);
            let t = tys.at(&cx, i);
            var skip = false;
            if C::same_kind(p.kind, Kind::Brand) {
                let unit = match t {
                    Type::Ignored => {
                        skip = true;
                    },
                    Type::Skolem(label) => {
                        if !self.brands.copy(&cx).contains(&cx, label) {
                            self.fail(&cx, "brand_argument_scope");
                        }
                    },
                    _ => self.fail(&cx, "brand_argument_scope"),
                };
            } else if C::same_kind(p.kind, Kind::Copy) && !self.copy_type(&cx, t) {
                self.fail(&cx, "copy");
            }
            if !skip {
                sub.insert(&cx, p.name, t);
            }
            i = i + 1usize;
        }
        var j = 0usize;
        while j < premises.len(&cx) {
            let premise = premises.at(&cx, j);
            if !self.holds(&cx, premise.trait_name, subst_all(&cx, premise.args, sub, self.counter)) {
                self.fail(&cx, "unsatisfied_premise");
            }
            j = j + 1usize;
        }
        sub
    }

    fn signature(self, &cx: Domain!['k], instr: Instr['k]) -> Signature['k] {
        let callee = instr.args.at(&cx, 0usize);
        let tys = instr.tys;
        if callee.starts_with(&cx, Span::from_static(&cx, "%")) {
            let ty = self.use_value(&cx, callee);
            let f = match ty {
                Type::Fn(f) => f,
                _ => self.fail(&cx, "function_value"),
            };
            let sub = self.instantiate(&cx, f.quantified, ArenaVec::new(&cx), tys);
            return Signature.{ ptypes: subst_all(&cx, f.params, sub, self.counter), ret: subst(&cx, f.ret.copy(&cx), sub, self.counter), is_unsafe: f.is_unsafe, places: f.places };
        }
        match self.program.externs.get(&cx, callee) {
            Option::Some(ext) => {
                let ptypes = match ext.ptypes {
                    Option::Some(p) => p,
                    Option::None => self.fail(&cx, "extern_value_not_callable"),
                };
                let ret = match ext.ret {
                    Option::Some(r) => r,
                    Option::None => self.fail(&cx, "extern_value_not_callable"),
                };
                return Signature.{ ptypes, ret, is_unsafe: true, places: ArenaVec::new(&cx) };
            },
            Option::None => (),
        };
        let fun = match self.program.funs.get(&cx, callee) {
            Option::Some(f) => f,
            Option::None => self.fail(&cx, "unknown_function"),
        };
        let sub = self.instantiate(&cx, fun.params, fun.premises, tys);
        Signature.{ ptypes: subst_all(&cx, fun.ptypes, sub, self.counter), ret: subst(&cx, fun.ret, sub, self.counter), is_unsafe: fun.is_unsafe, places: fun.places(&cx) }
    }

    fn arguments(self, &cx: Domain!['k], ptypes: ArenaVec[Type['k], 'k], args: ArenaVec[Span['k], 'k], places: ArenaVec[usize, 'k]) -> ArenaVec[Span['k], 'k] {
        if ptypes.len(&cx) != args.len(&cx) {
            self.fail(&cx, "expected_arguments_got");
        }
        let lent: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
        var k = 0usize;
        while k < ptypes.len(&cx) {
            let want = ptypes.at(&cx, k);
            let arg = args.at(&cx, k);
            if places.contains(&cx, k) != arg.starts_with(&cx, Span::from_static(&cx, "&")) {
                self.fail(&cx, "argument_mode");
            }
            if arg.starts_with(&cx, Span::from_static(&cx, "&*")) {
                self.authorize(&cx, self.current_instr(&cx), true);
                let ty = self.use_value(&cx, arg.skip(2usize));
                let ok = match ty {
                    Type::Ptr(inner) => equal(&cx, inner.copy(&cx), want),
                    _ => false,
                };
                if !ok {
                    self.fail(&cx, "raw_target_lend_wrong");
                }
            } else if arg.starts_with(&cx, Span::from_static(&cx, "&")) {
                if !equal(&cx, self.path_type(&cx, arg), want) {
                    self.fail(&cx, "lent_place_type_expected");
                }
                lent.push(&cx, arg);
            } else {
                let got = self.use_value(&cx, arg);
                if !fits(&cx, got, want) {
                    self.fail(&cx, "argument_expected");
                }
            }
            k = k + 1usize;
        }
        self.lend(&cx, lent);
        lent
    }

    fn current_instr(self, &cx: Domain!['k]) -> Instr['k] {
        match self.instr.copy(&cx) {
            Option::Some(instr) => instr,
            Option::None => kurs_error(&cx, Span::from_static(&cx, "internal error: no instruction is being checked"), no_pos()),
        }
    }

    fn authorize(self, &cx: Domain!['k], instr: Instr['k], is_unsafe: bool) {
        if is_unsafe && !(self.fun(&cx).is_unsafe || instr.is_unsafe) {
            self.fail(&cx, "unsafe_authorization");
        }
    }

    // ------------------------------------------------------------ instructions --

    fn check_instr(self, &cx: Domain!['k], instr: Instr['k]) {
        self.formation.pos.set(&cx, instr.pos);
        let op = instr.op;
        self.instr.set(&cx, Option::Some.(instr));
        if C::is_unsafe_op(&cx, op) {
            self.authorize(&cx, instr, true);
        }
        let outs: ArenaVec[Type['k], 'k] = if op.is(&cx, "const") {
            ArenaVec::one(&cx, self.op_const(&cx, instr))
        } else if op.is(&cx, "copy") {
            ArenaVec::one(&cx, self.op_copy(&cx, instr))
        } else if op.is(&cx, "construct") {
            ArenaVec::one(&cx, self.op_construct(&cx, instr))
        } else if op.is(&cx, "destruct") {
            self.op_destruct(&cx, instr)
        } else if op.is(&cx, "construct_variant") {
            ArenaVec::one(&cx, self.op_construct_variant(&cx, instr))
        } else if op.is(&cx, "variant_tag") {
            ArenaVec::one(&cx, self.op_variant_tag(&cx, instr))
        } else if op.is(&cx, "int_cast") {
            ArenaVec::one(&cx, self.op_int_cast(&cx, instr))
        } else if op.is(&cx, "float_cast") {
            ArenaVec::one(&cx, self.op_float_cast(&cx, instr))
        } else if op.is(&cx, "to_ptr") {
            ArenaVec::one(&cx, self.op_to_ptr(&cx, instr))
        } else if op.is(&cx, "cast") {
            ArenaVec::one(&cx, self.op_cast(&cx, instr))
        } else if op.is(&cx, "call") {
            ArenaVec::one(&cx, self.op_call(&cx, instr))
        } else if op.is(&cx, "trait_call") {
            ArenaVec::one(&cx, self.op_trait_call(&cx, instr))
        } else if op.is(&cx, "fn") {
            ArenaVec::one(&cx, self.op_fn(&cx, instr))
        } else if op.is(&cx, "alloca") {
            ArenaVec::one(&cx, self.op_alloca(&cx, instr))
        } else if op.is(&cx, "sizeof") {
            ArenaVec::one(&cx, self.op_sizeof(&cx, instr))
        } else if op.is(&cx, "data") {
            ArenaVec::one(&cx, self.op_data(&cx, instr))
        } else if op.is(&cx, "static_brand") {
            ArenaVec::one(&cx, self.op_static_brand(&cx, instr))
        } else if op.is(&cx, "fresh") {
            ArenaVec::one(&cx, self.op_fresh(&cx, instr))
        } else if op.is(&cx, "trap") {
            ArenaVec::one(&cx, Type::Never)
        } else if op.is(&cx, "pack") {
            ArenaVec::one(&cx, self.op_pack(&cx, instr))
        } else if op.is(&cx, "open") {
            ArenaVec::one(&cx, self.op_open(&cx, instr))
        } else if op.is(&cx, "ptr_load") || op.is(&cx, "ptr_load_volatile") {
            ArenaVec::one(&cx, self.op_ptr_load(&cx, instr))
        } else if op.is(&cx, "ptr_store") || op.is(&cx, "ptr_store_volatile") {
            ArenaVec::one(&cx, self.op_ptr_store(&cx, instr))
        } else if op.is(&cx, "load") {
            ArenaVec::one(&cx, self.op_load(&cx, instr))
        } else if op.is(&cx, "store") {
            ArenaVec::one(&cx, self.op_store(&cx, instr))
        } else if op.is(&cx, "foreach") {
            ArenaVec::one(&cx, self.op_foreach(&cx, instr))
        } else if is_arith(&cx, op) || is_order(&cx, op) || is_equality(&cx, op) || is_bits(&cx, op) {
            ArenaVec::one(&cx, self.primitive(&cx, instr))
        } else if C::atomic_kind(&cx, op).is_some() {
            ArenaVec::one(&cx, self.atomic(&cx, instr))
        } else {
            self.fail(&cx, "unknown_instruction")
        };
        if outs.len(&cx) != instr.lhs.len(&cx) {
            self.fail(&cx, "produces_results_named");
        }
        var i = 0usize;
        while i < outs.len(&cx) {
            self.bind(&cx, instr.lhs.at(&cx, i), outs.at(&cx, i));
            i = i + 1usize;
        }
    }

    fn type_operand(self, &cx: Domain!['k], instr: Instr['k]) -> Type['k] {
        match instr.ty {
            Option::Some(t) => t,
            Option::None => self.fail(&cx, "instruction_requires_type"),
        }
    }

    fn op_const(self, &cx: Domain!['k], instr: Instr['k]) -> Type['k] {
        let lit = match instr.lit {
            Option::Some(l) => l,
            Option::None => self.fail(&cx, "const_requires_literal"),
        };
        let t = match instr.ty {
            Option::Some(t) => t,
            Option::None => self.fail(&cx, "const_scalar_type"),
        };
        let unit = match t {
            Type::Prim(_name) => (),
            _ => self.fail(&cx, "const_scalar_type"),
        };
        self.scalar_literal(&cx, t, lit);
        t
    }

    fn scalar_literal(self, &cx: Domain!['k], t: Type['k], lit: Span['k]) {
        if !valid_literal(&cx, t, lit) {
            self.fail(&cx, "invalid");
        }
    }

    fn op_copy(self, &cx: Domain!['k], instr: Instr['k]) -> Type['k] {
        let t = self.peek(&cx, instr.args.at(&cx, 0usize));
        if !self.copy_type(&cx, t) {
            self.fail(&cx, "copy_linear");
        }
        t
    }

    fn op_construct(self, &cx: Domain!['k], instr: Instr['k]) -> Type['k] {
        let ty = self.type_operand(&cx, instr);
        let want: ArenaVec[Type['k], 'k] = match self.types.shape(&cx, ty, self.home.copy(&cx)) {
            Type::Array(elem, length) => {
                let n = instr.args.len(&cx) as u64;
                if !(n == length || 0u64 < n && n < length && self.copy_type(&cx, elem.copy(&cx))) {
                    self.fail(&cx, "array_construct_element_copy");
                }
                let out: ArenaVec[Type['k], 'k] = ArenaVec::new(&cx);
                var i = 0u64;
                while i < n {
                    out.push(&cx, elem.copy(&cx));
                    i = i + 1u64;
                }
                out
            },
            _ => {
                let fields = self.types.fields(&cx, ty, self.home.copy(&cx));
                if fields.len(&cx) != instr.args.len(&cx) {
                    self.fail(&cx, "components_given");
                }
                fields
            },
        };
        var i = 0usize;
        while i < instr.args.len(&cx) && i < want.len(&cx) {
            let got = self.use_value(&cx, instr.args.at(&cx, i));
            if !fits(&cx, got, want.at(&cx, i)) {
                self.fail(&cx, "component_expected");
            }
            i = i + 1usize;
        }
        ty
    }

    fn op_destruct(self, &cx: Domain!['k], instr: Instr['k]) -> ArenaVec[Type['k], 'k] {
        let ty = self.type_operand(&cx, instr);
        let arg = instr.args.at(&cx, 0usize);
        let got = if arg.starts_with(&cx, Span::from_static(&cx, "&")) { self.load(&cx, arg) } else { self.use_value(&cx, arg) };
        match got {
            Type::Ptr(inner) => {
                if !equal(&cx, got, ty) {
                    self.fail(&cx, "destruct");
                }
                let fields = self.types.fields(&cx, inner.copy(&cx), self.home.copy(&cx));
                let out: ArenaVec[Type['k], 'k] = ArenaVec::new(&cx);
                var i = 0usize;
                while i < fields.len(&cx) {
                    out.push(&cx, C::ptr(&cx, fields.at(&cx, i)));
                    i = i + 1usize;
                }
                out
            },
            _ => {
                if !equal(&cx, got, ty) {
                    self.fail(&cx, "destruct");
                }
                self.types.fields(&cx, ty, self.home.copy(&cx)).clone(&cx)
            },
        }
    }

    fn op_construct_variant(self, &cx: Domain!['k], instr: Instr['k]) -> Type['k] {
        let ty = self.type_operand(&cx, instr);
        let variants = self.types.variants(&cx, ty, self.home.copy(&cx));
        let payload = match instr.lit {
            Option::Some(lit) => match member(&cx, variants, lit) {
                Option::Some(t) => t,
                Option::None => self.fail(&cx, "variant"),
            },
            Option::None => self.fail(&cx, "variant"),
        };
        let got = self.use_value(&cx, instr.args.at(&cx, 0usize));
        if !fits(&cx, got, payload) {
            self.fail(&cx, "payload_expected");
        }
        ty
    }

    fn op_variant_tag(self, &cx: Domain!['k], instr: Instr['k]) -> Type['k] {
        let ty = self.type_operand(&cx, instr);
        let arg = instr.args.at(&cx, 0usize);
        let got = if arg.starts_with(&cx, Span::from_static(&cx, "&")) {
            if !self.places.copy(&cx).full(&cx, arg) {
                self.fail(&cx, "readable_tag");
            }
            self.path_type(&cx, arg)
        } else {
            self.peek(&cx, arg)
        };
        if !equal(&cx, got, ty) {
            self.fail(&cx, "variant_tag");
        }
        let unit = self.types.variants(&cx, ty, self.home.copy(&cx));
        C::u32_type(&cx)
    }

    fn op_int_cast(self, &cx: Domain!['k], instr: Instr['k]) -> Type['k] {
        let got = self.use_value(&cx, instr.args.at(&cx, 0usize));
        let target = match instr.ty {
            Option::Some(t) => is_integer_type(&cx, t),
            Option::None => false,
        };
        let ok = is_integer_type(&cx, got) && target;
        if !ok {
            self.fail(&cx, "int_cast_converts_between");
        }
        self.type_operand(&cx, instr)
    }

    // A conversion by value between two number types, at least one of them a float: an integer to
    // the nearest float; a float toward zero to an integer, saturating at its bounds, NaN to 0; a
    // float to the nearest float of the other width.
    fn op_float_cast(self, &cx: Domain!['k], instr: Instr['k]) -> Type['k] {
        let got = self.use_value(&cx, instr.args.at(&cx, 0usize));
        let ok = match instr.ty {
            Option::Some(t) => is_number_type(&cx, got) && is_number_type(&cx, t)
                && (is_float_type(&cx, got) || is_float_type(&cx, t)),
            Option::None => false,
        };
        if !ok {
            self.fail(&cx, "float_cast_converts_between");
        }
        self.type_operand(&cx, instr)
    }

    fn op_cast(self, &cx: Domain!['k], instr: Instr['k]) -> Type['k] {
        let ty = self.type_operand(&cx, instr);
        let got = self.use_value(&cx, instr.args.at(&cx, 0usize));
        if contains(&cx, self.types, got, |&cx, t: Type['k]| self.uncastable(&cx, t))
            || contains(&cx, self.types, ty, |&cx, t: Type['k]| self.uncastable(&cx, t)) {
            self.fail(&cx, "unsafe_cast_cannot_produce");
        }
        self.has_memory_form(&cx, got);
        self.has_memory_form(&cx, ty);
        self.castable(&cx, got, ty);
        ty
    }

    // `NonNull T` to `*T`: forgetting that a pointer is not null is safe.
    fn op_to_ptr(self, &cx: Domain!['k], instr: Instr['k]) -> Type['k] {
        let got = self.use_value(&cx, instr.args.at(&cx, 0usize));
        let ty = match instr.ty {
            Option::Some(t) => t,
            Option::None => self.fail(&cx, "to_ptr_converts_non_null"),
        };
        let ok = match got {
            Type::NonNull(inner) => equal(&cx, C::ptr(&cx, inner.copy(&cx)), ty),
            _ => false,
        };
        if !ok {
            self.fail(&cx, "to_ptr_converts_non_null");
        }
        ty
    }

    // An unsafe cast reinterprets only representations the program fixes: a `NonNull` is cast only
    // from or to a pointer (whose obligation is that it is not null), and nothing that holds an enum
    // or a `NonNull` within it is cast, since the compiler chooses an enum's layout (a tag, or the
    // niche of a `NonNull`: `Types::niche_variant`). A type parameter cannot be cast at all. Nor is a
    // number cast to a number: that is a conversion by value, `int_cast` or `float_cast`.
    fn castable(self, &cx: Domain!['k], got: Type['k], want: Type['k]) {
        if is_non_null(got) || is_non_null(want) {
            if !(is_pointer_like(got) && is_pointer_like(want)) {
                self.fail(&cx, "non_null_cast_pointer");
            }
            return ();
        }
        if self.types.chosen_layout(&cx, got) || self.types.chosen_layout(&cx, want) {
            self.fail(&cx, "unsafe_cast_layout_chosen");
        }
        if is_number_type(&cx, got) && is_number_type(&cx, want) {
            self.fail(&cx, "unsafe_cast_between_numbers");
        }
    }

    // What no unsafe cast may conjure in a value: a package, a brand witness, a function value, a
    // transform, a value of an abstract type parameter, or Never. Behind a pointer, reading any of
    // them is a separate unsafe operation.
    fn uncastable(self, &cx: Domain!['k], ty: Type['k]) -> bool {
        match ty {
            Type::Exists(_binders, _body) => true,
            Type::Brand(_brand) => true,
            Type::Fn(_f) => true,
            Type::Foreach(_f) => true,
            Type::Never => true,
            Type::Named(name, args) => args.is_empty(&cx) && self.kinds.copy(&cx).contains(&cx, name),
            _ => false,
        }
    }

    fn primitive(self, &cx: Domain!['k], instr: Instr['k]) -> Type['k] {
        if instr.args.len(&cx) != 2usize {
            self.fail(&cx, "takes_two_operands");
        }
        let x = self.use_value(&cx, instr.args.at(&cx, 0usize));
        let y = self.use_value(&cx, instr.args.at(&cx, 1usize));
        if !equal(&cx, x, y) {
            self.fail(&cx, "operands_differ");
        }
        let (integer, floating, scalar) = match x {
            Type::Prim(name) => (C::is_integer(&cx, name), C::is_float(&cx, name), true),
            Type::Ptr(_inner) => (false, false, true),
            Type::NonNull(_inner) => (false, false, true),
            _ => (false, false, false),
        };
        let op = instr.op;
        let ok = if is_order(&cx, op) || is_arith(&cx, op) && !op.is(&cx, "mod") {
            integer || floating
        } else if is_bits(&cx, op) || op.is(&cx, "mod") {
            integer
        } else {
            scalar
        };
        if !ok {
            self.fail(&cx, "does_apply");
        }
        if is_order(&cx, op) || is_equality(&cx, op) { C::bool_type(&cx) } else { x }
    }

    fn op_call(self, &cx: Domain!['k], instr: Instr['k]) -> Type['k] {
        let sig = self.signature(&cx, instr);
        self.authorize(&cx, instr, sig.is_unsafe);
        self.after_call(&cx, self.arguments(&cx, sig.ptypes, instr.args.skip(&cx, 1usize), sig.places));
        sig.ret
    }

    fn op_trait_call(self, &cx: Domain!['k], instr: Instr['k]) -> Type['k] {
        let tr = match self.program.traits.get(&cx, instr.args.at(&cx, 0usize)) {
            Option::Some(tr) => tr,
            Option::None => self.fail(&cx, "unknown_trait_wrong_arity"),
        };
        if tr.params.len(&cx) != instr.tys.len(&cx) {
            self.fail(&cx, "unknown_trait_wrong_arity");
        }
        var found: Option[Method['k]] = Option::None;
        var i = 0usize;
        while found.is_none() && i < tr.methods.len(&cx) {
            if tr.methods.at(&cx, i).name.eq(&cx, instr.args.at(&cx, 1usize)) {
                found = Option::Some.(tr.methods.at(&cx, i));
            }
            i = i + 1usize;
        }
        let sig = match found {
            Option::Some(m) => m,
            Option::None => self.fail(&cx, "trait_method"),
        };
        if !self.holds(&cx, tr.name, instr.tys) {
            self.fail(&cx, "evidence");
        }
        let sub: ArenaMap[Span['k], Type['k], 'k] = ArenaMap::new(&cx);
        var p = 0usize;
        while p < tr.params.len(&cx) {
            sub.insert(&cx, tr.params.at(&cx, p), instr.tys.at(&cx, p));
            p = p + 1usize;
        }
        self.authorize(&cx, instr, sig.is_unsafe);
        self.after_call(&cx, self.arguments(&cx, subst_all(&cx, sig.ptypes, sub, self.counter), instr.args.skip(&cx, 2usize), sig.places));
        subst(&cx, sig.ret, sub, self.counter)
    }

    fn op_fn(self, &cx: Domain!['k], instr: Instr['k]) -> Type['k] {
        let name = instr.args.at(&cx, 0usize);
        match self.program.externs.get(&cx, name) {
            Option::Some(ext) => {
                let ptypes = match ext.ptypes {
                    Option::Some(p) => p,
                    Option::None => self.fail(&cx, "extern_value_not_callable"),
                };
                let ret = match ext.ret {
                    Option::Some(r) => r,
                    Option::None => self.fail(&cx, "extern_value_not_callable"),
                };
                return C::fn_type(&cx, ptypes, ret, ArenaVec::new(&cx), true, ArenaVec::new(&cx));
            },
            Option::None => (),
        };
        let fun = match self.program.funs.get(&cx, name) {
            Option::Some(f) => f,
            Option::None => self.fail(&cx, "unknown_function"),
        };
        let retained: ArenaVec[Param['k], 'k] = ArenaVec::new(&cx);
        var i = 0usize;
        while i < fun.params.len(&cx) && i < instr.tys.len(&cx) {
            let p = fun.params.at(&cx, i);
            let ignored = match instr.tys.at(&cx, i) {
                Type::Ignored => true,
                _ => false,
            };
            if C::same_kind(p.kind, Kind::Brand) && ignored {
                retained.push(&cx, p);
            }
            i = i + 1usize;
        }
        let retained_brands: ArenaSet[Span['k], 'k] = ArenaSet::new(&cx);
        var r = 0usize;
        while r < retained.len(&cx) {
            retained_brands.insert(&cx, retained.at(&cx, r).name);
            r = r + 1usize;
        }
        // A function value may keep brands quantified, but no premise on them: every premise is
        // discharged where the value is made.
        var q = 0usize;
        while q < fun.premises.len(&cx) {
            let args = fun.premises.at(&cx, q).args;
            var a = 0usize;
            while a < args.len(&cx) {
                if sets_meet(&cx, retained_brands, free_brands(&cx, args.at(&cx, a))) {
                    self.fail(&cx, "retained_brand_with_premise");
                }
                a = a + 1usize;
            }
            q = q + 1usize;
        }
        let sub = self.instantiate(&cx, fun.params, fun.premises, instr.tys);
        C::fn_type(&cx, subst_all(&cx, fun.ptypes, sub, self.counter), subst(&cx, fun.ret, sub, self.counter), retained, fun.is_unsafe, fun.places(&cx))
    }

    // What foreign code hands the program, an extern function's result or an extern value, is
    // reinterpreted from C's bytes as an unsafe cast's result is: it holds nothing only checked code
    // makes (`checked_only`; a result of `!` itself says the function does not return), and no enum
    // or `NonNull`, whose layout the compiler chooses.
    fn foreign_result(self, &cx: Domain!['k], ty: Type['k]) {
        if contains(&cx, self.types, ty, |&cx, t: Type['k]| checked_only(t)) {
            self.fail(&cx, "extern_result_cannot_produce");
        }
        if self.types.chosen_layout(&cx, ty) {
            self.fail(&cx, "extern_result_layout_chosen");
        }
    }

    // A zero-size type is erased: it has no C object and no C value, and `sizeof` of one is 0. A load
    // or store of one through a pointer reads and writes nothing, and `alloca` of one gives a pointer that
    // is not null, so those accept it; an unsafe cast reinterprets a representation, which a zero-size
    // type does not have, and C has no zero-size parameter or object, so casts and extern parameters and
    // values reject zero-size types.
    fn has_memory_form(self, &cx: Domain!['k], ty: Type['k]) {
        if self.types.zero_size(&cx, ty) {
            self.fail(&cx, "zero_size_type_has_no_memory_form");
        }
    }

    fn op_alloca(self, &cx: Domain!['k], instr: Instr['k]) -> Type['k] {
        C::ptr(&cx, self.type_operand(&cx, instr))
    }

    fn op_sizeof(self, &cx: Domain!['k], instr: Instr['k]) -> Type['k] {
        self.type_operand(&cx, instr);
        C::usize_type(&cx)
    }

    fn op_data(self, &cx: Domain!['k], instr: Instr['k]) -> Type['k] {
        match self.program.datas.get(&cx, instr.args.at(&cx, 0usize)) {
            Option::Some(data) => C::ptr(&cx, data.ty),
            Option::None => self.fail(&cx, "unknown_data"),
        }
    }

    fn op_static_brand(self, &cx: Domain!['k], instr: Instr['k]) -> Type['k] {
        Type::Brand.(Ref::new(&cx, Type::Skolem.(static_brand(&cx))))
    }

    fn op_fresh(self, &cx: Domain!['k], instr: Instr['k]) -> Type['k] {
        Type::Exists.(ArenaVec::one(&cx, Span::from_static(&cx, "k")), Ref::new(&cx, Type::Brand.(Ref::new(&cx, Type::Skolem.(Span::from_static(&cx, "k"))))))
    }

    fn op_pack(self, &cx: Domain!['k], instr: Instr['k]) -> Type['k] {
        let t = match instr.ty {
            Option::Some(t) => t,
            Option::None => self.fail(&cx, "pack_existential_type_brand"),
        };
        let (binders, body) = match t {
            Type::Exists(binders, body) => (binders, body.copy(&cx)),
            _ => self.fail(&cx, "pack_existential_type_brand"),
        };
        if instr.tys.len(&cx) != binders.len(&cx) {
            self.fail(&cx, "pack_existential_type_brand");
        }
        let witnesses: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
        var i = 0usize;
        while i < instr.tys.len(&cx) {
            let unit = match instr.tys.at(&cx, i) {
                Type::Skolem(label) => {
                    if !self.brands.copy(&cx).contains(&cx, label) {
                        self.fail(&cx, "pack_witness_scope");
                    }
                    witnesses.push(&cx, label);
                },
                _ => self.fail(&cx, "pack_witness_scope"),
            };
            i = i + 1usize;
        }
        let sub: ArenaMap[Span['k], Type['k], 'k] = ArenaMap::new(&cx);
        var j = 0usize;
        while j < binders.len(&cx) {
            sub.insert(&cx, binders.at(&cx, j), instr.tys.at(&cx, j));
            j = j + 1usize;
        }
        let payload = subst(&cx, body, sub, self.counter);
        let arg = instr.args.at(&cx, 0usize);
        if arg.starts_with(&cx, Span::from_static(&cx, "&")) {
            let places = self.places.copy(&cx);
            let matches = match places.opened.get(&cx, arg) {
                Option::Some(view) => view.eq(&cx, witnesses),
                Option::None => false,
            };
            if !matches {
                self.fail(&cx, "open_at_those_brands");
            }
            if !equal(&cx, self.path_type(&cx, arg), payload) {
                self.fail(&cx, "packing");
            }
            if !places.full(&cx, arg) {
                self.fail(&cx, "pack_place_full");
            }
            places.forget(&cx, arg, false);
            if !equal(&cx, self.path_type(&cx, arg), t) {
                self.fail(&cx, "pack_place_type");
            }
            return C::unit(&cx);
        }
        let got = self.use_value(&cx, arg);
        if !fits(&cx, got, payload) {
            self.fail(&cx, "packing");
        }
        t
    }

    fn op_open(self, &cx: Domain!['k], instr: Instr['k]) -> Type['k] {
        let arg = instr.args.at(&cx, 0usize);
        let brands = self.brands.copy(&cx);
        var i = 0usize;
        while i < instr.binders.len(&cx) {
            if brands.contains(&cx, instr.binders.at(&cx, i)) {
                self.fail(&cx, "open_binder_already_scope");
            }
            brands.insert(&cx, instr.binders.at(&cx, i));
            i = i + 1usize;
        }
        if arg.starts_with(&cx, Span::from_static(&cx, "&")) {
            let places = self.places.copy(&cx);
            if places.opened.contains(&cx, arg) {
                self.fail(&cx, "place_already_open");
            }
            let ok = match self.path_type(&cx, arg) {
                Type::Exists(binders, _body) => binders.len(&cx) == instr.binders.len(&cx) && places.full(&cx, arg),
                _ => false,
            };
            if !ok {
                self.fail(&cx, "full_package_brands");
            }
            places.opened.insert(&cx, arg, instr.binders);
            return C::unit(&cx);
        }
        match self.use_value(&cx, arg) {
            Type::Exists(binders, body) => {
                if binders.len(&cx) != instr.binders.len(&cx) {
                    self.fail(&cx, "open_binders");
                }
                let sub: ArenaMap[Span['k], Type['k], 'k] = ArenaMap::new(&cx);
                var j = 0usize;
                while j < binders.len(&cx) {
                    sub.insert(&cx, binders.at(&cx, j), Type::Skolem.(instr.binders.at(&cx, j)));
                    j = j + 1usize;
                }
                subst(&cx, body.copy(&cx), sub, self.counter)
            },
            _ => self.fail(&cx, "open_binders"),
        }
    }

    // Also `ptr_load_volatile`.
    fn op_ptr_load(self, &cx: Domain!['k], instr: Instr['k]) -> Type['k] {
        let inner = match self.use_value(&cx, instr.args.at(&cx, 0usize)) {
            Type::Ptr(inner) => inner.copy(&cx),
            _ => self.fail(&cx, "ptr_load_non_pointer"),
        };
        if contains(&cx, self.types, inner, |&cx, t: Type['k]| is_never(t)) {
            self.fail(&cx, "unsafe_read_cannot_produce_never");
        }
        inner
    }

    // Also `ptr_store_volatile`.
    fn op_ptr_store(self, &cx: Domain!['k], instr: Instr['k]) -> Type['k] {
        let p = self.use_value(&cx, instr.args.at(&cx, 0usize));
        let v = self.use_value(&cx, instr.args.at(&cx, 1usize));
        let inner = match p {
            Type::Ptr(inner) => inner.copy(&cx),
            _ => self.fail(&cx, "store_through_pointer_another"),
        };
        if !fits(&cx, v, inner) {
            self.fail(&cx, "store_through_pointer_another");
        }
        C::unit(&cx)
    }

    fn atomic(self, &cx: Domain!['k], instr: Instr['k]) -> Type['k] {
        let kind = match C::atomic_kind(&cx, instr.op) {
            Option::Some(k) => k,
            Option::None => self.fail(&cx, "unknown_instruction"),
        };
        let arity = atomic_arity(&cx, kind);
        if instr.args.len(&cx) != arity {
            self.fail(&cx, "atomic_operand_count");
        }
        let order = match instr.lit {
            Option::Some(o) => o,
            Option::None => self.fail(&cx, "atomic_requires_ordering"),
        };
        if kind.is(&cx, "compare_exchange") {
            let (success, failure) = match order.find(&cx, Span::from_static(&cx, "/"), 0usize) {
                Option::Some(at) => (order.slice(0usize, at), order.skip(at + 1usize)),
                Option::None => (order, Span::from_static(&cx, "")),
            };
            let allowed = match cas_failure(&cx, success) {
                Option::Some(a) => a.contains(&cx, failure),
                Option::None => false,
            };
            if !allowed {
                self.fail(&cx, "bad_compare_exchange_ordering");
            }
        } else if !is_ordering(&cx, order) || kind.is(&cx, "load") && (order.is(&cx, "release") || order.is(&cx, "acq_rel"))
            || kind.is(&cx, "store") && (order.is(&cx, "acquire") || order.is(&cx, "acq_rel")) || kind.is(&cx, "fence") && order.is(&cx, "relaxed") {
            self.fail(&cx, "bad_ordering");
        }
        if kind.is(&cx, "fence") {
            return C::unit(&cx);
        }
        let inner = match self.use_value(&cx, instr.args.at(&cx, 0usize)) {
            Type::Ptr(inner) => inner.copy(&cx),
            _ => self.fail(&cx, "atomic_operation_non_pointer"),
        };
        let integer = is_integer_type(&cx, inner);
        let pointer = match inner {
            Type::Ptr(_x) => true,
            _ => false,
        };
        let transfer = C::same(&cx, inner, C::bool_type(&cx)) || pointer;
        if kind.starts_with(&cx, Span::from_static(&cx, "fetch_")) && !integer || !(integer || transfer) {
            self.fail(&cx, "atomic_pointee_type");
        }
        var i = 1usize;
        while i < instr.args.len(&cx) {
            if !equal(&cx, self.use_value(&cx, instr.args.at(&cx, i)), inner) {
                self.fail(&cx, "atomic_operand_wrong_type");
            }
            i = i + 1usize;
        }
        if kind.is(&cx, "store") {
            C::unit(&cx)
        } else if kind.is(&cx, "compare_exchange") {
            Type::Tuple.(ArenaVec::two(&cx, inner, C::bool_type(&cx)))
        } else {
            inner
        }
    }

    fn op_load(self, &cx: Domain!['k], instr: Instr['k]) -> Type['k] {
        self.load(&cx, instr.args.at(&cx, 0usize))
    }

    fn op_store(self, &cx: Domain!['k], instr: Instr['k]) -> Type['k] {
        self.store(&cx, instr.args.at(&cx, 0usize), self.use_value(&cx, instr.args.at(&cx, 1usize)));
        C::unit(&cx)
    }

    fn op_foreach(self, &cx: Domain!['k], instr: Instr['k]) -> Type['k] {
        let t = match instr.ty {
            Option::Some(ty) => ty,
            Option::None => self.fail(&cx, "foreach_builds_foreach_type"),
        };
        let f = match t {
            Type::Foreach(f) => f,
            _ => self.fail(&cx, "foreach_builds_foreach_type"),
        };
        let got = self.use_value(&cx, instr.args.at(&cx, 0usize));
        if !equal(&cx, got, f.source.copy(&cx)) {
            self.fail(&cx, "foreach_source");
        }
        if !self.holds(&cx, Span::from_static(&cx, "Exposed"), ArenaVec::one(&cx, f.source.copy(&cx))) {
            self.fail(&cx, "foreach_source_not_exposed");
        }
        if !self.types.pattern_available(&cx, f, self.home.copy(&cx), self.kinds.copy(&cx)) {
            self.fail(&cx, "foreach_pointer_pattern_requires_pointer_components");
        }
        let mapper = match self.program.funs.get(&cx, instr.args.at(&cx, 1usize)) {
            Option::Some(m) => m,
            Option::None => self.fail(&cx, "unknown_mapper"),
        };
        let binders = foreach_binders(&cx, f);
        if mapper.params.len(&cx) != binders.len(&cx) + instr.tys.len(&cx) || !mapper.places(&cx).is_empty(&cx) {
            self.fail(&cx, "mapper_takes_traversal_binders");
        }
        let sub: ArenaMap[Span['k], Type['k], 'k] = ArenaMap::new(&cx);
        var i = 0usize;
        while i < mapper.params.len(&cx) && i < binders.len(&cx) {
            sub.insert(&cx, mapper.params.at(&cx, i).name, C::named(binders.at(&cx, i), ArenaVec::new(&cx)));
            i = i + 1usize;
        }
        var j = binders.len(&cx);
        while j < mapper.params.len(&cx) {
            sub.insert(&cx, mapper.params.at(&cx, j).name, instr.tys.at(&cx, j - binders.len(&cx)));
            j = j + 1usize;
        }
        // The mapper is checked for an arbitrary component, not only today's rows.
        let saved_kinds = self.kinds.copy(&cx);
        let kinds = saved_kinds.clone(&cx);
        var b = 0usize;
        while b < binders.len(&cx) {
            kinds.insert(&cx, binders.at(&cx, b), Kind::Any);
            b = b + 1usize;
        }
        self.kinds.set(&cx, kinds);
        let chosen: ArenaVec[Type['k], 'k] = ArenaVec::new(&cx);
        var c = 0usize;
        while c < mapper.params.len(&cx) {
            chosen.push(&cx, sub.at(&cx, mapper.params.at(&cx, c).name));
            c = c + 1usize;
        }
        let unit = self.instantiate(&cx, mapper.params, mapper.premises, chosen);
        self.kinds.set(&cx, saved_kinds);
        let item = foreach_item(&cx, f);
        let ptypes = subst_all(&cx, mapper.ptypes, sub, self.counter);
        if ptypes.is_empty(&cx) || !equal(&cx, ptypes.at(&cx, 0usize), item) || !equal(&cx, subst(&cx, mapper.ret, sub, self.counter), f.body.copy(&cx)) {
            self.fail(&cx, "mapper_does_map");
        }
        var k = 2usize;
        while k < instr.args.len(&cx) && k - 1usize < ptypes.len(&cx) {
            let got = self.use_value(&cx, instr.args.at(&cx, k));
            if !self.copy_type(&cx, got) || !fits(&cx, got, ptypes.at(&cx, k - 1usize)) {
                self.fail(&cx, "foreach_capture_copy_fit");
            }
            k = k + 1usize;
        }
        if instr.args.len(&cx) - 2usize != ptypes.len(&cx) - 1usize {
            self.fail(&cx, "foreach_capture_count_disagrees");
        }
        self.authorize(&cx, instr, mapper.is_unsafe);
        t
    }

    // ------------------------------------------------------------- terminators --

    fn check_term(self, &cx: Domain!['k], term: Terminator['k], last: Option[Instr['k]]) {
        match term {
            Terminator::Ret(value, _pos) => {
                let fun = self.fun(&cx);
                let got = self.use_value(&cx, value);
                if !fits(&cx, got, fun.ret) {
                    self.fail(&cx, "returning_function");
                }
                self.accounted(&cx, self.used.copy(&cx));
                let roots = self.roots.copy(&cx);
                let param_roots = self.param_roots.copy(&cx);
                let places = self.places.copy(&cx);
                let names = roots.keys(&cx);
                var i = 0usize;
                while i < names.len(&cx) {
                    let root = names.at(&cx, i);
                    let ty = roots.at(&cx, root);
                    if param_roots.contains(&cx, root) && places.opened.any(&cx, |&cx, q: Span['k], value| prefix(&cx, root, q)) {
                        self.fail(&cx, "place_parameter_sealed");
                    }
                    if param_roots.contains(&cx, root) && !places.full(&cx, root) {
                        self.fail(&cx, "place_parameter_restored");
                    }
                    if !param_roots.contains(&cx, root) && !self.no_linear(&cx, root, ty) {
                        self.fail(&cx, "local_place_still_holds");
                    }
                    i = i + 1usize;
                }
                let generic = brand_params(&cx, self.params.copy(&cx));
                let found = free_brands(&cx, got).keys(&cx);
                var local = false;
                var k = 0usize;
                while k < found.len(&cx) {
                    if !generic.contains(&cx, found.at(&cx, k)) && !found.at(&cx, k).eq(&cx, static_brand(&cx)) {
                        local = true;
                    }
                    k = k + 1usize;
                }
                if local && !is_never(got) {
                    self.fail(&cx, "result_mentions_local_brands");
                }
            },
            Terminator::Jmp(edge, _pos) => self.edge(&cx, edge, self.used.copy(&cx), self.places.copy(&cx), Option::None),
            Terminator::Jnz(cond, then, other, _pos) => {
                if !C::same(&cx, self.use_value(&cx, cond), C::bool_type(&cx)) {
                    self.fail(&cx, "jnz_bool_condition");
                }
                // An edge reads the place state and changes nothing in it, so both share it.
                let used = self.used.copy(&cx).clone(&cx);
                self.edge(&cx, then, used.clone(&cx), self.places.copy(&cx), Option::None);
                self.edge(&cx, other, used.clone(&cx), self.places.copy(&cx), Option::None);
            },
            Terminator::Switch(scrutinee, ty, arms, _pos) => self.switch(&cx, scrutinee, ty, arms),
            Terminator::Unreachable(_pos) => {
                let ok = match last {
                    Option::Some(instr) => instr.lhs.len(&cx) == 1usize && is_never(self.env.copy(&cx).at(&cx, instr.lhs.at(&cx, 0usize))),
                    Option::None => false,
                };
                if !ok {
                    self.fail(&cx, "unreachable_follow_instruction_producing");
                }
            },
        };
    }

    fn edge(self, &cx: Domain!['k], edge: Edge['k], used: ArenaSet[Span['k], 'k], places: Places['k], payload: Option[Type['k]]) {
        let fun = self.fun(&cx);
        let target = match self.blocks.copy(&cx).get(&cx, edge.target) {
            Option::Some(b) => b,
            Option::None => self.fail(&cx, "jump"),
        };
        if target.label.eq(&cx, fun.blocks.at(&cx, 0usize).label) {
            self.fail(&cx, "jump");
        }
        if edge.tys.len(&cx) != target.brands.len(&cx) {
            self.fail(&cx, "takes_brand_arguments");
        }
        let sub: ArenaMap[Span['k], Type['k], 'k] = ArenaMap::new(&cx);
        var i = 0usize;
        while i < target.brands.len(&cx) {
            let t = edge.tys.at(&cx, i);
            let unit = match t {
                Type::Skolem(label) => {
                    if !self.brands.copy(&cx).contains(&cx, label) {
                        self.fail(&cx, "brand_argument_scope");
                    }
                },
                _ => self.fail(&cx, "brand_argument_scope"),
            };
            sub.insert(&cx, target.brands.at(&cx, i), t);
            i = i + 1usize;
        }
        let offset = if payload.is_some() { 1usize } else { 0usize };
        if edge.args.len(&cx) + offset != target.params.len(&cx) {
            self.fail(&cx, "takes_arguments_got");
        }
        let saved = self.used.copy(&cx);
        self.used.set(&cx, used);
        var k = 0usize;
        while k < target.params.len(&cx) {
            let got = if k < offset {
                match payload {
                    Option::Some(t) => t,
                    Option::None => C::unit(&cx),
                }
            } else {
                self.use_value(&cx, edge.args.at(&cx, k - offset))
            };
            if !fits(&cx, got, subst(&cx, target.params.at(&cx, k).type, sub, self.counter)) {
                self.fail(&cx, "argument_expected");
            }
            k = k + 1usize;
        }
        self.accounted(&cx, self.used.copy(&cx));
        self.used.set(&cx, saved);
        self.entails(&cx, places, target, sub);
        // The brands kept across the edge: the function's own, `static`, and the target's brands
        // the edge passes themselves. Only a local whose brands are not all the function's own can
        // name one that is not kept.
        let (local_roots, global) = self.branded_locals(&cx);
        let target_empty = self.empty_set(&cx, target);
        var r = 0usize;
        while r < local_roots.len(&cx) {
            let root = local_roots.at(&cx, r);
            if !ancestor_in(&cx, target_empty, root) {
                if !self.root_brands(&cx, root).all(&cx, |&cx, b: Span['k]| kept_brand(&cx, global, sub, b)) {
                    self.fail(&cx, "full_local_block_brand");
                }
            }
            r = r + 1usize;
        }
    }

    // The function's local roots (in the order of `roots`, but for its place parameters) whose
    // free brands are not all among its brand parameters and `static`, and the set of those: made
    // once per function.
    fn branded_locals(self, &cx: Domain!['k]) -> (ArenaVec[Span['k], 'k], ArenaSet[Span['k], 'k]) {
        match self.edge_roots.copy(&cx) {
            Option::Some(known) => return known,
            Option::None => (),
        };
        let global = brand_params(&cx, self.params.copy(&cx));
        global.insert(&cx, static_brand(&cx));
        let roots = self.roots.copy(&cx);
        let param_roots = self.param_roots.copy(&cx);
        let locals: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
        var r = 0usize;
        while r < roots.positions(&cx) {
            match roots.key_at(&cx, r) {
                Option::Some(root) => if !param_roots.contains(&cx, root) && !subset(&cx, self.root_brands(&cx, root), global) {
                    locals.push(&cx, root);
                },
                Option::None => (),
            };
            r = r + 1usize;
        }
        self.edge_roots.set(&cx, Option::Some.((locals, global)));
        (locals, global)
    }

    fn entails(self, &cx: Domain!['k], places: Places['k], target: Block['k], sub: ArenaMap[Span['k], Type['k], 'k]) {
        let saved = self.places.copy(&cx);
        self.places.set(&cx, places);
        let wanted: ArenaMap[Span['k], ArenaVec[Span['k], 'k], 'k] = ArenaMap::new(&cx);
        var o = 0usize;
        while o < target.opened.len(&cx) {
            let brands = target.opened.at(&cx, o).brands;
            let labels: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
            var b = 0usize;
            while b < brands.len(&cx) {
                let label = match sub.get(&cx, brands.at(&cx, b)) {
                    Option::Some(t) => match t {
                        Type::Skolem(l) => l,
                        _ => brands.at(&cx, b),
                    },
                    Option::None => brands.at(&cx, b),
                };
                labels.push(&cx, label);
                b = b + 1usize;
            }
            wanted.insert(&cx, target.opened.at(&cx, o).path, labels);
            o = o + 1usize;
        }
        if !opened_same(&cx, places.opened, wanted) {
            self.fail(&cx, "opened_view_contract");
        }
        let target_empty = self.empty_set(&cx, target);
        // Most often the edge leaves empty exactly what the target assumes: then each path covers
        // itself, and no path is newly empty.
        let exact = places.empty.len(&cx) == target_empty.len(&cx) && places.empty.all(&cx, |&cx, z: Span['k]| target_empty.contains(&cx, z));
        if !exact && places.empty.any(&cx, |&cx, z: Span['k]| !ancestor_in(&cx, target_empty, z)) {
            self.fail(&cx, "empty_assumes_full");
        }
        let fresh: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
        var f = 0usize;
        while !exact && f < target.empty.len(&cx) {
            if !places.covered(&cx, target.empty.at(&cx, f)) {
                fresh.push(&cx, target.empty.at(&cx, f));
            }
            f = f + 1usize;
        }
        let roots: ArenaSet[Span['k], 'k] = ArenaSet::new(&cx);
        var s = 0usize;
        while s < fresh.len(&cx) {
            roots.insert(&cx, segments(&cx, fresh.at(&cx, s)).at(&cx, 0usize));
            s = s + 1usize;
        }
        let root_names = roots.keys(&cx);
        var r = 0usize;
        while r < root_names.len(&cx) {
            let own: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
            var q = 0usize;
            while q < fresh.len(&cx) {
                if segments(&cx, fresh.at(&cx, q)).at(&cx, 0usize).eq(&cx, root_names.at(&cx, r)) {
                    own.push(&cx, fresh.at(&cx, q));
                }
                q = q + 1usize;
            }
            // One newly empty path per root, or leaves of one full product tree.
            if own.len(&cx) > 1usize && !(self.product_branches(&cx, own) && places.full(&cx, self.common_parent(&cx, own))) {
                self.fail(&cx, "edge_empties_one_path_or_product_leaves");
            }
            r = r + 1usize;
        }
        let checked = self.empty_to_check(&cx, target);
        let whole = checked.address() == target.empty.address();
        let rest: ArenaVec[Span['k], 'k] = if whole { ArenaVec::new(&cx) } else { checked };
        var e = 0usize;
        while e < checked.len(&cx) {
            let (result, always) = self.empty_discardable(&cx, checked.at(&cx, e));
            if !self.got(&cx, result) {
                self.fail(&cx, "holds_linear_contents_assumes");
            }
            if whole && !always {
                rest.push(&cx, checked.at(&cx, e));
            }
            e = e + 1usize;
        }
        self.checked_empty(&cx, target, checked, rest);
        var k = 0usize;
        while k < target.known.len(&cx) {
            let known = target.known.at(&cx, k);
            let ok = match places.known.get(&cx, known.path) {
                Option::Some(v) => v.eq(&cx, known.variant),
                Option::None => false,
            };
            if !ok {
                self.fail(&cx, "assumes");
            }
            k = k + 1usize;
        }
        self.places.set(&cx, saved);
    }

    // An enum switch: one arm per variant, each variant once. A value switch passes each arm its
    // variant's payload; a place switch tells each arm which variant the place holds.
    fn switch(self, &cx: Domain!['k], arg: Span['k], ty: Type['k], arms: ArenaVec[Arm['k], 'k]) {
        let place = arg.starts_with(&cx, Span::from_static(&cx, "&"));
        let got = if place {
            let t = self.path_type(&cx, arg);
            if !self.places.copy(&cx).full(&cx, arg) {
                self.fail(&cx, "switch_which_full");
            }
            t
        } else {
            self.use_value(&cx, arg)
        };
        if !equal(&cx, got, ty) {
            self.fail(&cx, "switch");
        }
        let unit = match self.types.shape(&cx, ty, self.home.copy(&cx)) {
            Type::Prim(_name) => self.fail(&cx, "switch_on_enum"),
            _ => (),
        };
        let variants = self.types.variants(&cx, ty, self.home.copy(&cx));
        let names: ArenaSet[Span['k], 'k] = ArenaSet::new(&cx);
        let arm_names: ArenaSet[Span['k], 'k] = ArenaSet::new(&cx);
        var v = 0usize;
        while v < variants.len(&cx) {
            names.insert(&cx, variants.at(&cx, v).name);
            v = v + 1usize;
        }
        var a = 0usize;
        while a < arms.len(&cx) {
            arm_names.insert(&cx, arms.at(&cx, a).variant);
            a = a + 1usize;
        }
        if arm_names.len(&cx) != arms.len(&cx) || !subset(&cx, arm_names, names) || !subset(&cx, names, arm_names) {
            self.fail(&cx, "switch_arm_per_variant");
        }
        let used = self.used.copy(&cx).clone(&cx);
        var i = 0usize;
        while i < arms.len(&cx) {
            let arm = arms.at(&cx, i);
            // The edge changes nothing in the state it is given; an arm of a place switch knows
            // one more variant, in a copy of the known variants.
            var places = self.places.copy(&cx);
            var payload: Option[Type['k]] = Option::None;
            if place {
                let known = places.known.clone(&cx);
                known.insert(&cx, arg, arm.variant);
                places = Places.{ empty: places.empty, known, opened: places.opened };
            } else {
                payload = member(&cx, variants, arm.variant);
            }
            self.edge(&cx, arm.edge, used.clone(&cx), places, payload);
            i = i + 1usize;
        }
    }
}

// A brand kept across an edge whose target's brands are bound by `sub`: one of `global`, or a
// target brand the edge passes itself.
forall 'k.
fn kept_brand(&cx: Domain!['k], global: ArenaSet[Span['k], 'k], sub: ArenaMap[Span['k], Type['k], 'k], b: Span['k]) -> bool {
    if global.contains(&cx, b) {
        return true;
    }
    match sub.get(&cx, b) {
        Option::Some(t) => match t {
            Type::Skolem(label) => label.eq(&cx, b),
            _ => false,
        },
        Option::None => false,
    }
}

forall 'k.
fn split_all(&cx: Domain!['k], paths: ArenaVec[Span['k], 'k]) -> ArenaVec[ArenaVec[Span['k], 'k], 'k] {
    let out: ArenaVec[ArenaVec[Span['k], 'k], 'k] = ArenaVec::new(&cx);
    var i = 0usize;
    while i < paths.len(&cx) {
        out.push(&cx, segments(&cx, paths.at(&cx, i)));
        i = i + 1usize;
    }
    out
}

// Every path has the same segment at `depth`.
forall 'k.
fn segments_agree(&cx: Domain!['k], parts: ArenaVec[ArenaVec[Span['k], 'k], 'k], depth: usize) -> bool {
    let first = parts.at(&cx, 0usize).at(&cx, depth);
    var all = true;
    var i = 1usize;
    while all && i < parts.len(&cx) {
        all = parts.at(&cx, i).at(&cx, depth).eq(&cx, first);
        i = i + 1usize;
    }
    all
}

// The number of leading segments the paths share, keeping at least one more segment in each.
forall 'k.
fn common_depth(&cx: Domain!['k], parts: ArenaVec[ArenaVec[Span['k], 'k], 'k]) -> usize {
    var common = 0usize;
    var going = true;
    while going {
        var long = true;
        var i = 0usize;
        while long && i < parts.len(&cx) {
            long = parts.at(&cx, i).len(&cx) > common + 1usize;
            i = i + 1usize;
        }
        if long && segments_agree(&cx, parts, common) {
            common = common + 1usize;
        } else {
            going = false;
        }
    }
    common
}

forall 'k.
fn check_program(&cx: Domain!['k], program: Program['k], counter: Fresh['k]) -> Checker['k] {
    let checker = Checker::new(&cx, program, counter);
    checker.check(&cx);
    checker
}

// The first instance of `trait_name` in `program` whose head matches `args`: its index among the
// trait's instances, the instance, and the substitution of its parameters.
forall 'k.
fn matching_instance(&cx: Domain!['k], program: Program['k], counter: Fresh['k], trait_name: Span['k], args: ArenaVec[Type['k], 'k]) -> Option[(usize, Instance['k], ArenaMap[Span['k], Type['k], 'k])] {
    let insts = match program.instances.get(&cx, trait_name) {
        Option::Some(insts) => insts,
        Option::None => {
            return Option::None;
        },
    };
    var i = 0usize;
    while i < insts.len(&cx) {
        let inst = insts.at(&cx, i);
        match match_head(&cx, inst.params, inst.head, args, true, counter) {
            Option::Some(sub) => {
                return Option::Some.((i, inst, sub));
            },
            Option::None => (),
        };
        i = i + 1usize;
    }
    Option::None
}

// What the checker recorded for the backend, `Checker.typed`, copied from the arena of `from` into
// that of `to`, in the same order.
forall 'a, 'b.
fn copy_typed(&from: Domain!['a], &to: Domain!['b], typed: ArenaMap[FunKey['a], ArenaMap[(Span['a], Span['a]), Type['a], 'a], 'a]) -> ArenaMap[FunKey['b], ArenaMap[(Span['b], Span['b]), Type['b], 'b], 'b] {
    let out: ArenaMap[FunKey['b], ArenaMap[(Span['b], Span['b]), Type['b], 'b], 'b] = ArenaMap::new(&to);
    var i = 0usize;
    while i < typed.positions(&from) {
        match typed.key_at(&from, i) {
            Option::Some(key) => {
                let key_b = match key {
                    FunKey::Function(name) => FunKey::Function.(name.copy_to(&from, &to)),
                    FunKey::Method(trait_name, index, name) => FunKey::Method.(trait_name.copy_to(&from, &to), index, name.copy_to(&from, &to)),
                };
                let values = typed.at(&from, key);
                let values_b: ArenaMap[(Span['b], Span['b]), Type['b], 'b] = ArenaMap::new(&to);
                var k = 0usize;
                while k < values.positions(&from) {
                    match values.key_at(&from, k) {
                        Option::Some(at) => {
                            let (label, name) = at;
                            values_b.insert(&to, (label.copy_to(&from, &to), name.copy_to(&from, &to)), copy_type(&from, &to, values.at(&from, at)));
                        },
                        Option::None => (),
                    };
                    k = k + 1usize;
                }
                out.insert(&to, key_b, values_b);
            },
            Option::None => (),
        };
        i = i + 1usize;
    }
    out
}
