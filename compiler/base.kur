// The compiler's storage: text, growable sequences, hash maps and cells.
//
// A compiler builds one large web of values and keeps it until it exits, so this storage is never
// freed and is shared freely: every handle here is a Copy pointer, and a change made through one
// copy is seen through all of them, as with Python's lists and dicts. Elements are Copy values,
// read and written whole; no reference into storage is ever handed out, so growing a sequence or
// a map never leaves one dangling. The compiler runs on one thread.

use std::alloc::heap::{malloc, realloc};
use std::io::write_all;
use std::option::Option;
use std::raw::elem_ptr;
use std::slice::Slice;

extern "C" fn exit(code: i32) -> !;
extern "C" fn memcmp(a: *u8, b: *u8, n: usize) -> i32;
extern "C" fn memcpy(dest: *u8, src: *u8, n: usize) -> *u8;

// ----------------------------------------------------------------- memory --

// Storage for `count` values of `T`, never freed.
forall T.
fn alloc(count: usize) -> *T {
    let bytes = count * sizeof[T]();
    unsafe (unsafe malloc(if bytes == 0usize { 1usize } else { bytes }) as *T)
}

forall T where Copy[T].
fn load_at(base: *T, i: usize) -> T {
    unsafe *(unsafe elem_ptr(base, i))
}

forall T where Copy[T].
fn store_at(base: *T, i: usize, value: T) {
    unsafe *(unsafe elem_ptr(base, i)) = value;
}

// One value on the heap: the way a recursive type refers to itself. `set` replaces it for every
// copy of the cell.
forall T.
exposed struct Cell {
    at: *T,
}

forall T where Copy[T].
impl Cell[T] {
    fn new(value: T) -> Cell[T] {
        let at: *T = alloc(1usize);
        store_at(at, 0usize, value);
        Cell.{ at }
    }

    fn get(self) -> T {
        load_at(self.at, 0usize)
    }

    fn set(self, value: T) {
        store_at(self.at, 0usize, value);
    }
}

// --------------------------------------------------------------- failure --

// Prints `message` and stops the compiler with status 1.
fn fail(message: Text) -> ! {
    let unit = unsafe write_all(2, message.ptr, message.len);
    let unit = unsafe write_all(2, text("\n").ptr, 1usize);
    unsafe exit(1)
}

fn fail_static(message: Slice[u8, 'static]) -> ! {
    fail(text(message))
}

fn stop(status: i32) -> ! {
    unsafe exit(status)
}

// ------------------------------------------------------------------- text --

// Bytes that never change: a view of a literal, of a file, or of text the compiler built.
exposed struct Text {
    ptr: *u8,
    len: usize,
}

fn text(literal: Slice[u8, 'static]) -> Text {
    let (ptr, len, brand) = literal.into_parts();
    Text.{ ptr, len }
}

fn empty_text() -> Text {
    text("")
}

impl Text {
    fn byte(self, i: usize) -> u8 {
        if i < self.len { load_at(self.ptr, i) } else { 0u8 }
    }

    fn is_empty(self) -> bool {
        self.len == 0usize
    }

    // Bytes `start` to `end`, clamped to the text.
    fn slice(self, start: usize, end: usize) -> Text {
        let end = if end > self.len { self.len } else { end };
        let start = if start > end { end } else { start };
        Text.{ ptr: unsafe elem_ptr(self.ptr, start), len: end - start }
    }

    fn from(self, start: usize) -> Text {
        self.slice(start, self.len)
    }

    fn eq(self, other: Text) -> bool {
        if self.len != other.len {
            false
        } else if self.len == 0usize {
            true
        } else {
            unsafe memcmp(self.ptr, other.ptr, self.len) == 0
        }
    }

    fn is(self, literal: Slice[u8, 'static]) -> bool {
        self.eq(text(literal))
    }

    // Byte order, as Python orders `str`s of ASCII: negative, zero or positive.
    fn compare(self, other: Text) -> i32 {
        let n = if self.len < other.len { self.len } else { other.len };
        let c = if n == 0usize { 0 } else { unsafe memcmp(self.ptr, other.ptr, n) };
        if c != 0 {
            c
        } else if self.len < other.len {
            -1
        } else if self.len > other.len {
            1
        } else {
            0
        }
    }

    fn starts_with(self, prefix: Text) -> bool {
        prefix.len <= self.len && self.slice(0usize, prefix.len).eq(prefix)
    }

    fn ends_with(self, suffix: Text) -> bool {
        suffix.len <= self.len && self.from(self.len - suffix.len).eq(suffix)
    }

    // The first index at or after `start` of `needle`, if any.
    fn find(self, needle: Text, start: usize) -> Option[usize] {
        var i = start;
        var found = Option::None;
        while found.is_none() && i + needle.len <= self.len {
            if self.slice(i, i + needle.len).eq(needle) {
                found = Option::Some.(i);
            }
            i = i + 1usize;
        }
        found
    }

    fn contains(self, needle: Text) -> bool {
        self.find(needle, 0usize).is_some()
    }

    // The last index of `byte`, if any.
    fn rfind_byte(self, byte: u8) -> Option[usize] {
        var i = self.len;
        var found = Option::None;
        while found.is_none() && i > 0usize {
            i = i - 1usize;
            if self.byte(i) == byte {
                found = Option::Some.(i);
            }
        }
        found
    }

    fn hash(self) -> u64 {
        var h = 14695981039346656037u64;
        var i = 0usize;
        while i < self.len {
            h = (h ^ (self.byte(i) as u64)) * 1099511628211u64;
            i = i + 1usize;
        }
        h
    }

    fn concat(self, other: Text) -> Text {
        Out::new().add(self).add(other).done()
    }

    // The pieces between occurrences of `separator`.
    fn split(self, separator: Text) -> Seq[Text] {
        let pieces: Seq[Text] = Seq::new();
        var start = 0usize;
        var going = true;
        while going {
            let unit = match self.find(separator, start) {
                Option::Some(at) => {
                    pieces.push(self.slice(start, at));
                    start = at + separator.len;
                },
                Option::None => {
                    pieces.push(self.from(start));
                    going = false;
                },
            };
        }
        pieces
    }

    // The decimal value of the text's digits, if it is all digits.
    fn to_usize(self) -> Option[usize] {
        var n = 0usize;
        var ok = self.len > 0usize;
        var i = 0usize;
        while ok && i < self.len {
            let b = self.byte(i);
            if b >= b'0' && b <= b'9' {
                n = n * 10usize + ((b - b'0') as usize);
            } else {
                ok = false;
            }
            i = i + 1usize;
        }
        if ok { Option::Some.(n) } else { Option::None }
    }

    fn print(self, fd: i32) {
        let unit = unsafe write_all(fd, self.ptr, self.len);
    }
}

// Text being built. `done` returns what was written; the builder may go on growing after it.
exposed struct Out {
    bytes: Seq[u8],
}

impl Out {
    fn new() -> Out {
        Out.{ bytes: Seq::new() }
    }

    fn byte(self, b: u8) -> Out {
        self.bytes.push(b);
        self
    }

    fn add(self, t: Text) -> Out {
        self.bytes.push_bytes(t.ptr, t.len);
        self
    }

    fn put(self, literal: Slice[u8, 'static]) -> Out {
        self.add(text(literal))
    }

    fn u64(self, n: u64) -> Out {
        if n >= 10u64 {
            let unit = self.u64(n / 10u64);
        }
        self.byte(b'0' + ((n % 10u64) as u8))
    }

    fn usize(self, n: usize) -> Out {
        self.u64(n as u64)
    }

    fn i64(self, n: i64) -> Out {
        if n < 0i64 {
            // The magnitude of the most negative value is one past the largest positive one.
            self.byte(b'-').u64(((0i64 - (n + 1i64)) as u64) + 1u64)
        } else {
            self.u64(n as u64)
        }
    }

    fn len(self) -> usize {
        self.bytes.len()
    }

    fn done(self) -> Text {
        Text.{ ptr: self.bytes.data(), len: self.bytes.len() }
    }
}

// --------------------------------------------------------------- sequences --

forall T.
exposed struct Seq {
    head: *SeqHead[T],
}

forall T.
exposed struct SeqHead {
    data: *T,
    len: usize,
    cap: usize,
}

forall T where Copy[T].
impl Seq[T] {
    fn new() -> Seq[T] {
        let head: *SeqHead[T] = alloc(1usize);
        store_at(head, 0usize, SeqHead.{ data: alloc(4usize), len: 0usize, cap: 4usize });
        Seq.{ head }
    }

    fn one(value: T) -> Seq[T] {
        let s: Seq[T] = Seq::new();
        s.push(value);
        s
    }

    fn two(a: T, b: T) -> Seq[T] {
        let s: Seq[T] = Seq::new();
        s.push(a);
        s.push(b);
        s
    }

    fn state(self) -> SeqHead[T] {
        load_at(self.head, 0usize)
    }

    fn len(self) -> usize {
        self.state().len
    }

    fn is_empty(self) -> bool {
        self.len() == 0usize
    }

    fn data(self) -> *T {
        self.state().data
    }

    fn reserve(self, extra: usize) {
        let h = self.state();
        if h.len + extra > h.cap {
            var cap = h.cap * 2usize;
            while cap < h.len + extra {
                cap = cap * 2usize;
            }
            let data = unsafe (unsafe realloc(unsafe (h.data as *u8), cap * sizeof[T]()) as *T);
            store_at(self.head, 0usize, SeqHead.{ data, len: h.len, cap });
        }
    }

    fn push(self, value: T) {
        self.reserve(1usize);
        let h = self.state();
        store_at(h.data, h.len, value);
        store_at(self.head, 0usize, SeqHead.{ data: h.data, len: h.len + 1usize, cap: h.cap });
    }

    fn push_bytes(self, ptr: *u8, count: usize) {
        self.reserve(count);
        let h = self.state();
        if count > 0usize {
            let unit = unsafe memcpy(unsafe (unsafe elem_ptr(h.data, h.len) as *u8), ptr, count * sizeof[T]());
        }
        store_at(self.head, 0usize, SeqHead.{ data: h.data, len: h.len + count, cap: h.cap });
    }

    fn get(self, i: usize) -> T {
        let h = self.state();
        if i >= h.len {
            fail_static("internal error: sequence index out of range");
        }
        load_at(h.data, i)
    }

    fn set(self, i: usize, value: T) {
        let h = self.state();
        if i >= h.len {
            fail_static("internal error: sequence index out of range");
        }
        store_at(h.data, i, value);
    }

    fn last(self) -> T {
        self.get(self.len() - 1usize)
    }

    fn pop(self) -> T {
        let h = self.state();
        if h.len == 0usize {
            fail_static("internal error: pop from an empty sequence");
        }
        store_at(self.head, 0usize, SeqHead.{ data: h.data, len: h.len - 1usize, cap: h.cap });
        load_at(h.data, h.len - 1usize)
    }

    // Keeps the first `len` values.
    fn truncate(self, len: usize) {
        let h = self.state();
        if len < h.len {
            store_at(self.head, 0usize, SeqHead.{ data: h.data, len, cap: h.cap });
        }
    }

    fn clear(self) {
        self.truncate(0usize);
    }

    fn append(self, other: Seq[T]) {
        var i = 0usize;
        let n = other.len();
        while i < n {
            self.push(other.get(i));
            i = i + 1usize;
        }
    }

    // A new sequence holding the same values.
    fn copy(self) -> Seq[T] {
        let s: Seq[T] = Seq::new();
        s.append(self);
        s
    }

    // Values `start` to `end`, as a new sequence.
    fn slice(self, start: usize, end: usize) -> Seq[T] {
        let s: Seq[T] = Seq::new();
        var i = start;
        while i < end && i < self.len() {
            s.push(self.get(i));
            i = i + 1usize;
        }
        s
    }

    fn from(self, start: usize) -> Seq[T] {
        self.slice(start, self.len())
    }

    fn insert(self, at: usize, value: T) {
        self.push(value);
        var i = self.len() - 1usize;
        while i > at {
            self.set(i, self.get(i - 1usize));
            i = i - 1usize;
        }
        self.set(at, value);
    }

    fn remove(self, at: usize) -> T {
        let value = self.get(at);
        var i = at;
        while i + 1usize < self.len() {
            self.set(i, self.get(i + 1usize));
            i = i + 1usize;
        }
        let unit = self.pop();
        value
    }

    fn reverse(self) {
        var i = 0usize;
        var j = self.len();
        while i + 1usize < j {
            j = j - 1usize;
            let a = self.get(i);
            self.set(i, self.get(j));
            self.set(j, a);
            i = i + 1usize;
        }
    }

    // Sorts in place by `before`, keeping equal values in their order (insertion sort).
    fn sort(self, before: fn(T, T) -> bool) {
        var i = 1usize;
        while i < self.len() {
            let value = self.get(i);
            var j = i;
            while j > 0usize && before(value, self.get(j - 1usize)) {
                self.set(j, self.get(j - 1usize));
                j = j - 1usize;
            }
            self.set(j, value);
            i = i + 1usize;
        }
    }
}

forall T where Copy[T], Key[T].
impl Seq[T] {
    fn index_of(self, value: T) -> Option[usize] {
        var i = 0usize;
        var found = Option::None;
        while found.is_none() && i < self.len() {
            if Key::key_same(self.get(i), value) {
                found = Option::Some.(i);
            }
            i = i + 1usize;
        }
        found
    }

    fn has(self, value: T) -> bool {
        self.index_of(value).is_some()
    }

    fn same(self, other: Seq[T]) -> bool {
        var equal = self.len() == other.len();
        var i = 0usize;
        while equal && i < self.len() {
            equal = Key::key_same(self.get(i), other.get(i));
            i = i + 1usize;
        }
        equal
    }
}

// ------------------------------------------------------------- hash maps --

// Keys of maps: hashed and compared by value.
forall K.
trait Key {
    fn key_hash(key: K) -> u64;
    fn key_same(a: K, b: K) -> bool;
}

instance Key[Text] {
    fn key_hash(key: Text) -> u64 {
        key.hash()
    }

    fn key_same(a: Text, b: Text) -> bool {
        a.eq(b)
    }
}

instance Key[u32] {
    fn key_hash(key: u32) -> u64 {
        mix(key as u64)
    }

    fn key_same(a: u32, b: u32) -> bool {
        a == b
    }
}

instance Key[usize] {
    fn key_hash(key: usize) -> u64 {
        mix(key as u64)
    }

    fn key_same(a: usize, b: usize) -> bool {
        a == b
    }
}

instance Key[bool] {
    fn key_hash(key: bool) -> u64 {
        if key { 1u64 } else { 2u64 }
    }

    fn key_same(a: bool, b: bool) -> bool {
        a == b
    }
}

forall A, B where Copy[A], Copy[B], Key[A], Key[B].
instance Key[(A, B)] {
    fn key_hash(key: (A, B)) -> u64 {
        let (a, b) = key;
        combine(Key::key_hash(a), Key::key_hash(b))
    }

    fn key_same(x: (A, B), y: (A, B)) -> bool {
        let (a, b) = x;
        let (c, d) = y;
        Key::key_same(a, c) && Key::key_same(b, d)
    }
}

forall A, B, C where Copy[A], Copy[B], Copy[C], Key[A], Key[B], Key[C].
instance Key[(A, B, C)] {
    fn key_hash(key: (A, B, C)) -> u64 {
        let (a, b, c) = key;
        combine(combine(Key::key_hash(a), Key::key_hash(b)), Key::key_hash(c))
    }

    fn key_same(x: (A, B, C), y: (A, B, C)) -> bool {
        let (a, b, c) = x;
        let (d, e, f) = y;
        Key::key_same(a, d) && Key::key_same(b, e) && Key::key_same(c, f)
    }
}

forall T where Copy[T], Key[T].
instance Key[Seq[T]] {
    fn key_hash(key: Seq[T]) -> u64 {
        var h = 7u64;
        var i = 0usize;
        while i < key.len() {
            h = combine(h, Key::key_hash(key.get(i)));
            i = i + 1usize;
        }
        h
    }

    fn key_same(a: Seq[T], b: Seq[T]) -> bool {
        a.same(b)
    }
}

fn mix(x: u64) -> u64 {
    let x = (x ^ (x >> 33u64)) * 18397679294719823053u64;
    let x = (x ^ (x >> 33u64)) * 14181476777654086739u64;
    x ^ (x >> 33u64)
}

fn combine(h: u64, x: u64) -> u64 {
    mix(h * 31u64 + x)
}

// A hash map that remembers the order its keys were first inserted, as Python's dict does:
// `keys` lists them in that order, and removing a key keeps the order of the rest.
forall K, V.
exposed struct Map {
    head: *MapHead[K, V],
}

forall K, V.
exposed struct MapHead {
    // Indices into `keys`/`values`, plus one; zero for an empty slot.
    slots: *usize,
    slot_count: usize,
    keys: Seq[K],
    values: Seq[V],
    // The positions of removed keys, so `keys` can skip them.
    live: Seq[bool],
    count: usize,
}

forall K, V where Copy[K], Copy[V], Key[K].
impl Map[K, V] {
    fn new() -> Map[K, V] {
        let head: *MapHead[K, V] = alloc(1usize);
        let slots: *usize = alloc(8usize);
        var i = 0usize;
        while i < 8usize {
            store_at(slots, i, 0usize);
            i = i + 1usize;
        }
        store_at(head, 0usize, MapHead.{ slots, slot_count: 8usize, keys: Seq::new(), values: Seq::new(), live: Seq::new(), count: 0usize });
        Map.{ head }
    }

    fn state(self) -> MapHead[K, V] {
        load_at(self.head, 0usize)
    }

    fn len(self) -> usize {
        self.state().count
    }

    fn is_empty(self) -> bool {
        self.len() == 0usize
    }

    // The slot holding `key`, or the empty slot where it would go.
    fn slot(self, key: K) -> usize {
        let h = self.state();
        let mask = h.slot_count - 1usize;
        var i = (Key::key_hash(key) as usize) & mask;
        var going = true;
        while going {
            let entry = load_at(h.slots, i);
            if entry == 0usize {
                going = false;
            } else if Key::key_same(h.keys.get(entry - 1usize), key) {
                going = false;
            } else {
                i = (i + 1usize) & mask;
            }
        }
        i
    }

    fn index(self, key: K) -> Option[usize] {
        let h = self.state();
        let entry = load_at(h.slots, self.slot(key));
        if entry == 0usize || !h.live.get(entry - 1usize) {
            Option::None
        } else {
            Option::Some.(entry - 1usize)
        }
    }

    fn has(self, key: K) -> bool {
        self.index(key).is_some()
    }

    fn get(self, key: K) -> Option[V] {
        match self.index(key) {
            Option::Some(i) => Option::Some.(self.state().values.get(i)),
            Option::None => Option::None,
        }
    }

    // The value of a key that must be present.
    fn at(self, key: K) -> V {
        match self.get(key) {
            Option::Some(v) => v,
            Option::None => fail_static("internal error: missing map key"),
        }
    }

    fn get_or(self, key: K, default: V) -> V {
        match self.get(key) {
            Option::Some(v) => v,
            Option::None => default,
        }
    }

    fn set(self, key: K, value: V) {
        let h = self.state();
        let slot = self.slot(key);
        let entry = load_at(h.slots, slot);
        if entry != 0usize {
            h.values.set(entry - 1usize, value);
            if !h.live.get(entry - 1usize) {
                // A removed key comes back at the end of the order.
                h.live.set(entry - 1usize, false);
                store_at(h.slots, slot, h.keys.len() + 1usize);
                h.keys.push(key);
                h.values.push(value);
                h.live.push(true);
                self.count(h, h.count + 1usize);
            }
        } else {
            store_at(h.slots, slot, h.keys.len() + 1usize);
            h.keys.push(key);
            h.values.push(value);
            h.live.push(true);
            self.count(h, h.count + 1usize);
            if h.keys.len() * 2usize > h.slot_count {
                self.grow();
            }
        }
    }

    fn count(self, h: MapHead[K, V], count: usize) {
        store_at(self.head, 0usize, MapHead.{ slots: h.slots, slot_count: h.slot_count, keys: h.keys, values: h.values, live: h.live, count });
    }

    fn remove(self, key: K) {
        match self.index(key) {
            Option::Some(i) => {
                let h = self.state();
                h.live.set(i, false);
                self.count(h, h.count - 1usize);
            },
            Option::None => (),
        }
    }

    fn grow(self) {
        let h = self.state();
        let slot_count = h.slot_count * 2usize;
        let slots: *usize = alloc(slot_count);
        var i = 0usize;
        while i < slot_count {
            store_at(slots, i, 0usize);
            i = i + 1usize;
        }
        store_at(self.head, 0usize, MapHead.{ slots, slot_count, keys: h.keys, values: h.values, live: h.live, count: h.count });
        var k = 0usize;
        while k < h.keys.len() {
            store_at(slots, self.slot(h.keys.get(k)), k + 1usize);
            k = k + 1usize;
        }
    }

    // The keys, in insertion order.
    fn keys(self) -> Seq[K] {
        let h = self.state();
        let out: Seq[K] = Seq::new();
        var i = 0usize;
        while i < h.keys.len() {
            if h.live.get(i) {
                out.push(h.keys.get(i));
            }
            i = i + 1usize;
        }
        out
    }

    // The values, in their keys' insertion order.
    fn values(self) -> Seq[V] {
        let h = self.state();
        let out: Seq[V] = Seq::new();
        var i = 0usize;
        while i < h.keys.len() {
            if h.live.get(i) {
                out.push(h.values.get(i));
            }
            i = i + 1usize;
        }
        out
    }

    fn copy(self) -> Map[K, V] {
        let m: Map[K, V] = Map::new();
        let keys = self.keys();
        var i = 0usize;
        while i < keys.len() {
            m.set(keys.get(i), self.at(keys.get(i)));
            i = i + 1usize;
        }
        m
    }
}

// A set, in insertion order.
forall K.
exposed struct Set {
    map: Map[K, bool],
}

forall K where Copy[K], Key[K].
impl Set[K] {
    fn new() -> Set[K] {
        Set.{ map: Map::new() }
    }

    fn add(self, key: K) {
        self.map.set(key, true);
    }

    fn has(self, key: K) -> bool {
        self.map.has(key)
    }

    fn remove(self, key: K) {
        self.map.remove(key);
    }

    fn len(self) -> usize {
        self.map.len()
    }

    fn items(self) -> Seq[K] {
        self.map.keys()
    }

    fn copy(self) -> Set[K] {
        Set.{ map: self.map.copy() }
    }
}
