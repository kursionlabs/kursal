// The typed KURS core: the program that lowering produces, the checker accepts and C is made from.
//
// Types are values compared by structure (`same`); language-level equality, which knows nominal
// declarations and renames binders, lives in `types`. An inference variable (`Meta`) is a type
// too, compared by identity; checked programs contain none.

use std::collections::arena_vec::ArenaVec;
use std::collections::arena_map::ArenaMap;
use std::mem::Ref;
use std::raw::Span;
use std::arena::Domain!;
use package::kurs::sexpr::Form;
use std::hash::{HashIn, HashState};
use std::slice::{Slice, hash_bytes};
use package::syntax::ast::Pos;
use std::option::Option;

exposed enum Kind {
    // a brand
    Brand,
    // a Copy value type
    Copy,
    // any value type
    Any,
}

fn same_kind(a: Kind, b: Kind) -> bool {
    kind_index(a) == kind_index(b)
}

fn kind_index(k: Kind) -> u32 {
    match k {
        Kind::Brand => 0u32,
        Kind::Copy => 1u32,
        Kind::Any => 2u32,
    }
}

// The width in bits of a fixed-width integer type, or 0 for any other name.
forall 'k.
fn integer_bits(&cx: Domain!['k], name: Span['k]) -> u32 {
    if name.is(&cx, "i8") || name.is(&cx, "u8") {
        8u32
    } else if name.is(&cx, "i16") || name.is(&cx, "u16") {
        16u32
    } else if name.is(&cx, "i32") || name.is(&cx, "u32") {
        32u32
    } else if name.is(&cx, "i64") || name.is(&cx, "u64") {
        64u32
    } else {
        0u32
    }
}

// `usize` and `isize` are pointer-sized: their width is the target's, which only the C compiler
// knows.
forall 'k.
fn is_pointer_sized(&cx: Domain!['k], name: Span['k]) -> bool {
    name.is(&cx, "isize") || name.is(&cx, "usize")
}

// The range of an integer literal, in bits: its type's width, and 64 bits for `usize` and `isize`.
forall 'k.
fn literal_bits(&cx: Domain!['k], name: Span['k]) -> u32 {
    if is_pointer_sized(&cx, name) { 64u32 } else { integer_bits(&cx, name) }
}

forall 'k.
fn is_integer(&cx: Domain!['k], name: Span['k]) -> bool {
    integer_bits(&cx, name) != 0u32 || is_pointer_sized(&cx, name)
}

forall 'k.
fn is_float(&cx: Domain!['k], name: Span['k]) -> bool {
    name.is(&cx, "f32") || name.is(&cx, "f64")
}

forall 'k.
fn is_prim(&cx: Domain!['k], name: Span['k]) -> bool {
    is_integer(&cx, name) || is_float(&cx, name) || name.is(&cx, "bool")
}

// The kind of an atomic operation, if `op` is one: one per atomic method of `*T` (`ptr_atomic_` and
// the kind, whatever the method's own name), and the fence, which takes no pointer. Each carries its
// ordering.
forall 'k.
fn atomic_kind(&cx: Domain!['k], op: Span['k]) -> Option[Span['k]] {
    if op.is(&cx, "fence") {
        return Option::Some.(op);
    }
    let prefix = Span::from_static(&cx, "ptr_atomic_");
    if !op.starts_with(&cx, prefix) {
        return Option::None;
    }
    let kind = op.skip(prefix.len());
    if kind.is(&cx, "load") || kind.is(&cx, "store") || kind.is(&cx, "swap") || kind.is(&cx, "compare_exchange")
        || kind.is(&cx, "fetch_add") || kind.is(&cx, "fetch_sub") || kind.is(&cx, "fetch_and") || kind.is(&cx, "fetch_or")
        || kind.is(&cx, "fetch_xor") {
        Option::Some.(kind)
    } else {
        Option::None
    }
}

// The operations that need an unsafe context: the instruction's `(unsafe ...)` marker, or an unsafe
// function.
forall 'k.
fn is_unsafe_op(&cx: Domain!['k], op: Span['k]) -> bool {
    op.is(&cx, "cast") || op.is(&cx, "alloca") || op.is(&cx, "static_brand") || op.is(&cx, "ptr_load") || op.is(&cx, "ptr_store")
        || op.is(&cx, "ptr_load_volatile") || op.is(&cx, "ptr_store_volatile") || atomic_kind(&cx, op).is_some()
}

// ------------------------------------------------------------------ types --

forall 'k.
exposed enum Type {
    Prim(Span['k]),
    Never,
    Named(Span['k], ArenaVec[Type['k], 'k]),
    Struct(ArenaVec[Member['k], 'k]),
    // variants in tag order
    Enum(ArenaVec[Member['k], 'k]),
    Tuple(ArenaVec[Type['k], 'k]),
    Array(Ref[Type['k], 'k], u64),
    Ptr(Ref[Type['k], 'k]),
    // `non_null T`: a pointer like `*T` that is never null. Its all-zero value is no value of the
    // type, the niche an enum's layout may use (`types::ops::Types::niche`).
    NonNull(Ref[Type['k], 'k]),
    // A brand variable or identity; of kind Brand, never a value type.
    Skolem(Span['k]),
    // `brand $k`, the Copy witness type of brand `$k`: a Skolem in checked IR; inference may
    // use a brand metavariable.
    Brand(Ref[Type['k], 'k]),
    // brand labels, and the body they scope over
    Exists(ArenaVec[Span['k], 'k], Ref[Type['k], 'k]),
    Foreach(ForeachType['k]),
    Fn(FnType['k]),
    Meta(Meta['k]),
}

// A field of a struct or a variant of an enum.
forall 'k.
exposed struct Member {
    name: Span['k],
    type: Type['k],
}

forall 'k.
exposed struct ForeachType {
    binder: Span['k],
    // the `(ptr F)` pattern
    indirect: bool,
    source: Ref[Type['k], 'k],
    body: Ref[Type['k], 'k],
}

forall 'k.
exposed struct FnType {
    params: ArenaVec[Type['k], 'k],
    ret: Ref[Type['k], 'k],
    is_unsafe: bool,
    // indices of place parameters, ascending
    places: ArenaVec[usize, 'k],
}

exposed enum MetaKind {
    Type,
    Int,
    Float,
    Brand,
}

// An inference variable: its solution once it has one.
forall 'k.
exposed struct Meta {
    state: Ref[MetaState['k], 'k],
}

forall 'k.
exposed struct MetaState {
    solution: Option[Type['k]],
    kind: MetaKind,
    pos: Pos,
}

forall 'k.
impl Meta['k] {
    fn new(&cx: Domain!['k], kind: MetaKind) -> Meta['k] {
        Meta.{ state: Ref::new(&cx, MetaState.{ solution: Option::None, kind, pos: Pos.{ line: 0u32, col: 0u32 } }) }
    }

    fn id(self) -> usize {
        self.state.address()
    }

    fn solution(self, &cx: Domain!['k]) -> Option[Type['k]] {
        self.state.copy(&cx).solution
    }

    fn kind(self, &cx: Domain!['k]) -> MetaKind {
        self.state.copy(&cx).kind
    }

    fn pos(self, &cx: Domain!['k]) -> Pos {
        self.state.copy(&cx).pos
    }

    fn solve(self, &cx: Domain!['k], t: Type['k]) {
        let s = self.state.copy(&cx);
        self.state.set(&cx, MetaState.{ solution: Option::Some.(t), kind: s.kind, pos: s.pos });
    }

    fn unsolve(self, &cx: Domain!['k]) {
        let s = self.state.copy(&cx);
        self.state.set(&cx, MetaState.{ solution: Option::None, kind: s.kind, pos: s.pos });
    }

    fn set_kind(self, &cx: Domain!['k], kind: MetaKind) {
        let s = self.state.copy(&cx);
        self.state.set(&cx, MetaState.{ solution: s.solution, kind, pos: s.pos });
    }

    fn set_pos(self, &cx: Domain!['k], pos: Pos) {
        let s = self.state.copy(&cx);
        self.state.set(&cx, MetaState.{ solution: s.solution, kind: s.kind, pos });
    }
}

forall 'k.
exposed struct Param {
    name: Span['k],
    kind: Kind,
}

forall 'k.
exposed struct Premise {
    trait_name: Span['k],
    args: ArenaVec[Type['k], 'k],
}

forall 'k.
fn prim(&cx: Domain!['k], name: Slice[u8, 'static]) -> Type['k] {
    Type::Prim.(Span::from_static(&cx, name))
}

forall 'k.
fn unit(&cx: Domain!['k]) -> Type['k] {
    Type::Tuple.(ArenaVec::new(&cx))
}

forall 'k.
fn bool_type(&cx: Domain!['k]) -> Type['k] {
    prim(&cx, "bool")
}

forall 'k.
fn u32_type(&cx: Domain!['k]) -> Type['k] {
    prim(&cx, "u32")
}

forall 'k.
fn usize_type(&cx: Domain!['k]) -> Type['k] {
    prim(&cx, "usize")
}

forall 'k.
fn ptr(&cx: Domain!['k], inner: Type['k]) -> Type['k] {
    Type::Ptr.(Ref::new(&cx, inner))
}

forall 'k.
fn non_null(&cx: Domain!['k], inner: Type['k]) -> Type['k] {
    Type::NonNull.(Ref::new(&cx, inner))
}

forall 'k.
fn named(name: Span['k], args: ArenaVec[Type['k], 'k]) -> Type['k] {
    Type::Named.(name, args)
}

// The foreach type binding `binder` in `body`, over `source`.
forall 'k.
fn foreach_type(&cx: Domain!['k], binder: Span['k], indirect: bool, source: Type['k], body: Type['k]) -> Type['k] {
    Type::Foreach.(ForeachType.{ binder, indirect, source: Ref::new(&cx, source), body: Ref::new(&cx, body) })
}

forall 'k.
fn fn_type(&cx: Domain!['k], params: ArenaVec[Type['k], 'k], ret: Type['k], is_unsafe: bool, places: ArenaVec[usize, 'k]) -> Type['k] {
    Type::Fn.(FnType.{ params, ret: Ref::new(&cx, ret), is_unsafe, places })
}

forall 'k.
fn types_same(&cx: Domain!['k], a: ArenaVec[Type['k], 'k], b: ArenaVec[Type['k], 'k]) -> bool {
    if a.address() == b.address() {
        return true;
    }
    var equal = a.len(&cx) == b.len(&cx);
    var i = 0usize;
    while equal && i < a.len(&cx) {
        equal = same(&cx, a.at(&cx, i), b.at(&cx, i));
        i = i + 1usize;
    }
    equal
}

forall 'k.
fn members_same(&cx: Domain!['k], a: ArenaVec[Member['k], 'k], b: ArenaVec[Member['k], 'k]) -> bool {
    if a.address() == b.address() {
        return true;
    }
    var equal = a.len(&cx) == b.len(&cx);
    var i = 0usize;
    while equal && i < a.len(&cx) {
        equal = a.at(&cx, i).name.eq(&cx, b.at(&cx, i).name) && same(&cx, a.at(&cx, i).type, b.at(&cx, i).type);
        i = i + 1usize;
    }
    equal
}

forall 'k.
fn texts_same(&cx: Domain!['k], a: ArenaVec[Span['k], 'k], b: ArenaVec[Span['k], 'k]) -> bool {
    a.eq(&cx, b)
}


// `same` of the types two refs hold; one ref, or one vec of parts above, is the same as itself
// without a walk.
forall 'k.
fn same_ref(&cx: Domain!['k], a: Ref[Type['k], 'k], b: Ref[Type['k], 'k]) -> bool {
    a.address() == b.address() || same(&cx, a.copy(&cx), b.copy(&cx))
}

// Structural equality: the same constructor with the same parts. Variables are equal only to
// themselves.
forall 'k.
fn same(&cx: Domain!['k], a: Type['k], b: Type['k]) -> bool {
    match a {
        Type::Prim(x) => match b {
            Type::Prim(y) => x.eq(&cx, y),
            _ => false,
        },
        Type::Never => match b {
            Type::Never => true,
            _ => false,
        },
        Type::Named(x, xs) => match b {
            Type::Named(y, ys) => x.eq(&cx, y) && types_same(&cx, xs, ys),
            _ => false,
        },
        Type::Struct(xs) => match b {
            Type::Struct(ys) => members_same(&cx, xs, ys),
            _ => false,
        },
        Type::Enum(xs) => match b {
            Type::Enum(ys) => members_same(&cx, xs, ys),
            _ => false,
        },
        Type::Tuple(xs) => match b {
            Type::Tuple(ys) => types_same(&cx, xs, ys),
            _ => false,
        },
        Type::Array(x, n) => match b {
            Type::Array(y, m) => n == m && same_ref(&cx, x, y),
            _ => false,
        },
        Type::Ptr(x) => match b {
            Type::Ptr(y) => same_ref(&cx, x, y),
            _ => false,
        },
        Type::NonNull(x) => match b {
            Type::NonNull(y) => same_ref(&cx, x, y),
            _ => false,
        },
        Type::Skolem(x) => match b {
            Type::Skolem(y) => x.eq(&cx, y),
            _ => false,
        },
        Type::Brand(x) => match b {
            Type::Brand(y) => same_ref(&cx, x, y),
            _ => false,
        },
        Type::Exists(xs, x) => match b {
            Type::Exists(ys, y) => texts_same(&cx, xs, ys) && same_ref(&cx, x, y),
            _ => false,
        },
        Type::Foreach(x) => match b {
            Type::Foreach(y) => x.binder.eq(&cx, y.binder) && x.indirect == y.indirect && same_ref(&cx, x.source, y.source)
                && same_ref(&cx, x.body, y.body),
            _ => false,
        },
        Type::Fn(x) => match b {
            Type::Fn(y) => types_same(&cx, x.params, y.params) && same_ref(&cx, x.ret, y.ret)
                && x.is_unsafe == y.is_unsafe && x.places.eq(&cx, y.places),
            _ => false,
        },
        Type::Meta(x) => match b {
            Type::Meta(y) => x.id() == y.id(),
            _ => false,
        },
    }
}

// A type's hash writes its structure into the state, in the encoding of `std::hash`: each variant's
// tag first, a vec its length first.
forall 'k.
fn hash_types(&cx: Domain!['k], state: HashState, ts: ArenaVec[Type['k], 'k]) -> HashState {
    var state = state.write_u64(ts.len(&cx) as u64);
    var i = 0usize;
    while i < ts.len(&cx) {
        state = hash(&cx, ts.at(&cx, i), state);
        i = i + 1usize;
    }
    state
}

// A name's part of a type's hash: its length and at most its last 8 bytes, where names that differ
// mostly do (`a::b::Vec!`, `a::b::Map`), so hashing a type costs little for each name it holds. Names
// alike in both collide whatever the seed; the names are the program's own, so only the program being
// built can slow its build down that way.
forall 'k.
fn name_hash(&cx: Domain!['k], name: Span['k], state: HashState) -> HashState {
    let n = name.len();
    var word = 0u64;
    var i = if n > 8usize { n - 8usize } else { 0usize };
    while i < n {
        word = (word << 8u64) | (name.byte_or_zero(&cx, i) as u64);
        i = i + 1usize;
    }
    state.write_u64(n as u64).write_u64(word)
}

forall 'k.
fn hash_members(&cx: Domain!['k], state: HashState, ms: ArenaVec[Member['k], 'k]) -> HashState {
    var state = state.write_u64(ms.len(&cx) as u64);
    var i = 0usize;
    while i < ms.len(&cx) {
        state = hash(&cx, ms.at(&cx, i).type, name_hash(&cx, ms.at(&cx, i).name, state));
        i = i + 1usize;
    }
    state
}

forall 'k.
fn hash(&cx: Domain!['k], t: Type['k], state: HashState) -> HashState {
    match t {
        Type::Prim(x) => name_hash(&cx, x, state.write_u64(1u64)),
        Type::Never => state.write_u64(2u64),
        Type::Named(x, xs) => hash_types(&cx, name_hash(&cx, x, state.write_u64(3u64)), xs),
        Type::Struct(xs) => hash_members(&cx, state.write_u64(4u64), xs),
        Type::Enum(xs) => hash_members(&cx, state.write_u64(5u64), xs),
        Type::Tuple(xs) => hash_types(&cx, state.write_u64(6u64), xs),
        Type::Array(x, n) => hash(&cx, x.copy(&cx), state.write_u64(7u64)).write_u64(n),
        Type::Ptr(x) => hash(&cx, x.copy(&cx), state.write_u64(8u64)),
        Type::Skolem(x) => name_hash(&cx, x, state.write_u64(9u64)),
        Type::Brand(x) => hash(&cx, x.copy(&cx), state.write_u64(10u64)),
        Type::Exists(xs, x) => hash(&cx, x.copy(&cx), HashIn[ArenaVec[Span['k], 'k], Domain!['k]]::hash_in(&cx, xs, state.write_u64(11u64))),
        Type::Foreach(x) => hash(&cx, x.body.copy(&cx), hash(&cx, x.source.copy(&cx), name_hash(&cx, x.binder, state.write_u64(12u64)))),
        Type::Fn(x) => hash(&cx, x.ret.copy(&cx), hash_types(&cx, state.write_u64(13u64), x.params)),
        Type::Meta(x) => state.write_u64(15u64).write_u64(x.id() as u64),
        Type::NonNull(x) => hash(&cx, x.copy(&cx), state.write_u64(16u64)),
    }
}

forall 'k.
instance HashIn[Type['k], Domain!['k]] {
    fn hash_in(&cx: Domain!['k], key: Type['k], state: HashState) -> HashState {
        hash(&cx, key, state)
    }

    fn eq_in(&cx: Domain!['k], a: Type['k], b: Type['k]) -> bool {
        let equal = same(&cx, a, b);
        equal
    }
}

forall 'k.
instance HashIn[Param['k], Domain!['k]] {
    fn hash_in(&cx: Domain!['k], key: Param['k], state: HashState) -> HashState {
        hash_bytes(&cx, key.name, state).write_u64(kind_index(key.kind) as u64)
    }

    fn eq_in(&cx: Domain!['k], a: Param['k], b: Param['k]) -> bool {
        let equal = a.name.eq(&cx, b.name) && same_kind(a.kind, b.kind);
        equal
    }
}

forall 'k.
instance HashIn[Premise['k], Domain!['k]] {
    fn hash_in(&cx: Domain!['k], key: Premise['k], state: HashState) -> HashState {
        hash_types(&cx, hash_bytes(&cx, key.trait_name, state), key.args)
    }

    fn eq_in(&cx: Domain!['k], a: Premise['k], b: Premise['k]) -> bool {
        let equal = a.trait_name.eq(&cx, b.trait_name) && types_same(&cx, a.args, b.args);
        equal
    }
}

// ---------------------------------------------------------------- modules --

forall 'k.
exposed struct ModuleId {
    package: usize,
    path: ArenaVec[Span['k], 'k],
}

forall 'k.
impl ModuleId['k] {
    fn root(&cx: Domain!['k], package: usize) -> ModuleId['k] {
        ModuleId.{ package, path: ArenaVec::new(&cx) }
    }

    fn child(self, &cx: Domain!['k], name: Span['k]) -> ModuleId['k] {
        let path = self.path.clone(&cx);
        path.push(&cx, name);
        ModuleId.{ package: self.package, path }
    }

    // `self` is `scope` or a module inside it.
    fn within(self, &cx: Domain!['k], scope: ModuleId['k]) -> bool {
        self.package == scope.package && self.path.len(&cx) >= scope.path.len(&cx) && self.path.slice(&cx, 0usize, scope.path.len(&cx)).eq(&cx, scope.path)
    }
}

forall 'k.
instance HashIn[ModuleId['k], Domain!['k]] {
    fn hash_in(&cx: Domain!['k], key: ModuleId['k], state: HashState) -> HashState {
        HashIn[ArenaVec[Span['k], 'k], Domain!['k]]::hash_in(&cx, key.path, state.write_u64(key.package as u64))
    }

    fn eq_in(&cx: Domain!['k], a: ModuleId['k], b: ModuleId['k]) -> bool {
        let equal = a.package == b.package && a.path.eq(&cx, b.path);
        equal
    }
}

exposed enum ExposureMode {
    Owner,
    Within,
}

forall 'k.
exposed struct Exposure {
    mode: ExposureMode,
    home: ModuleId['k],
}

// ----------------------------------------------------------- declarations --

forall 'k.
exposed struct TypeDecl {
    // a linear type's name ends with `!`
    name: Span['k],
    params: ArenaVec[Param['k], 'k],
    premises: ArenaVec[Premise['k], 'k],
    body: Type['k],
    home: Option[ModuleId['k]],
    // none: transparent
    exposure: Option[Exposure['k]],
}

forall 'k.
impl TypeDecl['k] {
    fn linear(self, &cx: Domain!['k]) -> bool {
        self.name.ends_with(&cx, Span::from_static(&cx, "!"))
    }
}

forall 'k.
exposed struct Instr {
    lhs: ArenaVec[Span['k], 'k],
    op: Span['k],
    args: ArenaVec[Span['k], 'k],
    // the type operand
    ty: Option[Type['k]],
    // type arguments
    tys: ArenaVec[Type['k], 'k],
    lit: Option[Span['k]],
    // the instruction's discharge marker
    is_unsafe: bool,
    // `open`'s brand binders
    binders: ArenaVec[Span['k], 'k],
    pos: Pos,
}

forall 'k.
exposed struct Edge {
    target: Span['k],
    args: ArenaVec[Span['k], 'k],
    tys: ArenaVec[Type['k], 'k],
}

forall 'k.
exposed struct Arm {
    variant: Span['k],
    edge: Edge['k],
}

forall 'k.
exposed enum Terminator {
    Ret(Span['k], Pos),
    Jmp(Edge['k], Pos),
    // condition, then, other
    Jnz(Span['k], Edge['k], Edge['k], Pos),
    // scrutinee, its enum type, one arm per variant
    Switch(Span['k], Type['k], ArenaVec[Arm['k], 'k], Pos),
    Unreachable(Pos),
}

forall 'k.
exposed struct Binding {
    name: Span['k],
    type: Type['k],
}

// A known variant of a place: `known &path = Variant`.
forall 'k.
exposed struct Known {
    path: Span['k],
    variant: Span['k],
}

// An opened package place and the brands of its view.
forall 'k.
exposed struct Opened {
    path: Span['k],
    brands: ArenaVec[Span['k], 'k],
}

forall 'k.
exposed struct Block {
    label: Span['k],
    params: ArenaVec[Binding['k], 'k],
    instrs: ArenaVec[Instr['k], 'k],
    term: Terminator['k],
    brands: ArenaVec[Span['k], 'k],
    // place paths declared empty
    empty: ArenaVec[Span['k], 'k],
    known: ArenaVec[Known['k], 'k],
    opened: ArenaVec[Opened['k], 'k],
    pos: Pos,
}

forall 'k.
exposed struct Fun {
    name: Span['k],
    // quantified parameters
    params: ArenaVec[Param['k], 'k],
    premises: ArenaVec[Premise['k], 'k],
    ret: Type['k],
    // a place parameter's type is the root type; see `places`
    ptypes: ArenaVec[Type['k], 'k],
    blocks: ArenaVec[Block['k], 'k],
    // whole-function places: `&name` and its type
    locals: ArenaVec[Binding['k], 'k],
    is_unsafe: bool,
    home: Option[ModuleId['k]],
    pos: Pos,
}

forall 'k.
impl Fun['k] {
    // The indices of the place parameters, whose entry names start with `&`.
    fn places(self, &cx: Domain!['k]) -> ArenaVec[usize, 'k] {
        let out: ArenaVec[usize, 'k] = ArenaVec::new(&cx);
        let params = self.blocks.at(&cx, 0usize).params;
        var i = 0usize;
        while i < params.len(&cx) {
            if params.at(&cx, i).name.byte_or_zero(&cx, 0usize) == b'&' {
                out.push(&cx, i);
            }
            i = i + 1usize;
        }
        out
    }
}

forall 'k.
exposed struct Extern {
    name: Span['k],
    ret: Option[Type['k]],
    // none for an extern value
    ptypes: Option[ArenaVec[Type['k], 'k]],
    pos: Pos,
}

forall 'k.
exposed struct Method {
    name: Span['k],
    ret: Type['k],
    ptypes: ArenaVec[Type['k], 'k],
    is_unsafe: bool,
    places: ArenaVec[usize, 'k],
}

forall 'k.
exposed struct Trait {
    name: Span['k],
    params: ArenaVec[Span['k], 'k],
    methods: ArenaVec[Method['k], 'k],
    home: Option[ModuleId['k]],
    // omitted kinds are Any, as in plain KURS headers
    param_kinds: ArenaVec[Kind, 'k],
}

forall 'k.
exposed struct Instance {
    trait_name: Span['k],
    params: ArenaVec[Param['k], 'k],
    premises: ArenaVec[Premise['k], 'k],
    // one type per trait parameter
    head: ArenaVec[Type['k], 'k],
    // functions with bare method names
    methods: ArenaVec[Fun['k], 'k],
    home: Option[ModuleId['k]],
    pos: Pos,
}

forall 'k.
exposed struct Data {
    name: Span['k],
    ty: Type['k],
    // the raw form
    init: Form['k],
    home: Option[ModuleId['k]],
}

forall 'k.
exposed struct Program {
    types: ArenaMap[Span['k], TypeDecl['k], 'k],
    funs: ArenaMap[Span['k], Fun['k], 'k],
    externs: ArenaMap[Span['k], Extern['k], 'k],
    datas: ArenaMap[Span['k], Data['k], 'k],
    traits: ArenaMap[Span['k], Trait['k], 'k],
    // trait -> its instances
    instances: ArenaMap[Span['k], ArenaVec[Instance['k], 'k], 'k],
}

forall 'k.
impl Program['k] {
    fn new(&cx: Domain!['k]) -> Program['k] {
        Program.{ types: ArenaMap::new(&cx), funs: ArenaMap::new(&cx), externs: ArenaMap::new(&cx), datas: ArenaMap::new(&cx), traits: ArenaMap::new(&cx), instances: ArenaMap::new(&cx) }
    }
}
