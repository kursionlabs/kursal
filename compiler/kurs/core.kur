// The typed KURS core: the program that lowering produces, the checker accepts and C is made from.
//
// Types are values compared by structure (`same`); language-level equality, which knows nominal
// declarations and renames binders, lives in `types`. An inference variable (`Meta`) is a type
// too, compared by identity; checked programs contain none.

use package::support::base::{Cell, Cx, Map, Seq, Text, combine, key_hash, text};
use package::kurs::sexpr::Form;
use std::hash::{HashIn, HashState};
use std::slice::Slice;
use package::syntax::ast::Pos;
use std::option::Option;

exposed enum Kind {
    // a brand
    Brand,
    // a Copy value type
    Copy,
    // any value type
    Any,
}

fn same_kind(a: Kind, b: Kind) -> bool {
    kind_index(a) == kind_index(b)
}

fn kind_index(k: Kind) -> u32 {
    match k {
        Kind::Brand => 0u32,
        Kind::Copy => 1u32,
        Kind::Any => 2u32,
    }
}

// The width in bits of an integer type, or 0 for any other name.
forall 'k.
fn integer_bits(&cx: Cx!['k], name: Text['k]) -> u32 {
    if name.is(&cx, "i8") || name.is(&cx, "u8") {
        8u32
    } else if name.is(&cx, "i16") || name.is(&cx, "u16") {
        16u32
    } else if name.is(&cx, "i32") || name.is(&cx, "u32") {
        32u32
    } else if name.is(&cx, "i64") || name.is(&cx, "u64") || name.is(&cx, "isize") || name.is(&cx, "usize") {
        64u32
    } else {
        0u32
    }
}

forall 'k.
fn is_integer(&cx: Cx!['k], name: Text['k]) -> bool {
    integer_bits(&cx, name) != 0u32
}

forall 'k.
fn is_float(&cx: Cx!['k], name: Text['k]) -> bool {
    name.is(&cx, "f32") || name.is(&cx, "f64")
}

forall 'k.
fn is_prim(&cx: Cx!['k], name: Text['k]) -> bool {
    is_integer(&cx, name) || is_float(&cx, name) || name.is(&cx, "bool")
}

// ------------------------------------------------------------------ types --

forall 'k.
exposed enum Type {
    Prim(Text['k]),
    Never,
    Named(Text['k], Seq[Type['k], 'k]),
    Struct(Seq[Member['k], 'k]),
    // variants in tag order
    Enum(Seq[Member['k], 'k]),
    Tuple(Seq[Type['k], 'k]),
    Array(Cell[Type['k], 'k], u64),
    Ptr(Cell[Type['k], 'k]),
    // A brand variable or identity; of kind Brand, never a value type.
    Skolem(Text['k]),
    // `builtin::Brand $k`, the Copy witness type of brand `$k`: a Skolem in checked IR; inference may
    // use a brand metavariable.
    Brand(Cell[Type['k], 'k]),
    // brand labels, and the body they scope over
    Exists(Seq[Text['k], 'k], Cell[Type['k], 'k]),
    Foreach(ForeachType['k]),
    Fn(FnType['k]),
    // `_`: a retained brand slot of `fn`'s type arguments
    Ignored,
    Meta(Meta['k]),
}

// A field of a struct or a variant of an enum.
forall 'k.
exposed struct Member {
    name: Text['k],
    type: Type['k],
}

forall 'k.
exposed struct ForeachType {
    binder: Text['k],
    // the `(builtin::Pointer F)` pattern
    indirect: bool,
    source: Cell[Type['k], 'k],
    body: Cell[Type['k], 'k],
    retained: Seq[Text['k], 'k],
}

forall 'k.
exposed struct FnType {
    params: Seq[Type['k], 'k],
    ret: Cell[Type['k], 'k],
    // retained brand parameters; a function value carries no premises
    quantified: Seq[Param['k], 'k],
    is_unsafe: bool,
    // indices of place parameters, ascending
    places: Seq[usize, 'k],
}

exposed enum MetaKind {
    Type,
    Int,
    Float,
    Brand,
}

// An inference variable: its solution once it has one.
forall 'k.
exposed struct Meta {
    state: Cell[MetaState['k], 'k],
}

forall 'k.
exposed struct MetaState {
    solution: Option[Type['k]],
    kind: MetaKind,
    pos: Pos,
}

forall 'k.
impl Meta['k] {
    fn new(&cx: Cx!['k], kind: MetaKind) -> Meta['k] {
        Meta.{ state: Cell::new(&cx, MetaState.{ solution: Option::None, kind, pos: Pos.{ line: 0u32, col: 0u32 } }) }
    }

    fn id(self) -> usize {
        self.state.address()
    }

    fn solution(self, &cx: Cx!['k]) -> Option[Type['k]] {
        self.state.get(&cx).solution
    }

    fn kind(self, &cx: Cx!['k]) -> MetaKind {
        self.state.get(&cx).kind
    }

    fn pos(self, &cx: Cx!['k]) -> Pos {
        self.state.get(&cx).pos
    }

    fn solve(self, &cx: Cx!['k], t: Type['k]) {
        let s = self.state.get(&cx);
        self.state.set(&cx, MetaState.{ solution: Option::Some.(t), kind: s.kind, pos: s.pos });
    }

    fn set_kind(self, &cx: Cx!['k], kind: MetaKind) {
        let s = self.state.get(&cx);
        self.state.set(&cx, MetaState.{ solution: s.solution, kind, pos: s.pos });
    }

    fn set_pos(self, &cx: Cx!['k], pos: Pos) {
        let s = self.state.get(&cx);
        self.state.set(&cx, MetaState.{ solution: s.solution, kind: s.kind, pos });
    }
}

forall 'k.
exposed struct Param {
    name: Text['k],
    kind: Kind,
}

forall 'k.
exposed struct Premise {
    trait_name: Text['k],
    args: Seq[Type['k], 'k],
}

forall 'k.
fn prim(&cx: Cx!['k], name: Slice[u8, 'static]) -> Type['k] {
    Type::Prim.(text(&cx, name))
}

forall 'k.
fn unit(&cx: Cx!['k]) -> Type['k] {
    Type::Tuple.(Seq::new(&cx))
}

forall 'k.
fn bool_type(&cx: Cx!['k]) -> Type['k] {
    prim(&cx, "bool")
}

forall 'k.
fn u32_type(&cx: Cx!['k]) -> Type['k] {
    prim(&cx, "u32")
}

forall 'k.
fn usize_type(&cx: Cx!['k]) -> Type['k] {
    prim(&cx, "usize")
}

forall 'k.
fn ptr(&cx: Cx!['k], inner: Type['k]) -> Type['k] {
    Type::Ptr.(Cell::new(&cx, inner))
}

forall 'k.
fn named(name: Text['k], args: Seq[Type['k], 'k]) -> Type['k] {
    Type::Named.(name, args)
}

// A foreach type whose retained binders default to those of a foreach source.
forall 'k.
fn foreach_type(&cx: Cx!['k], binder: Text['k], indirect: bool, source: Type['k], body: Type['k]) -> Type['k] {
    let retained: Seq[Text['k], 'k] = Seq::new(&cx);
    let unit = match source {
        Type::Foreach(f) => {
            retained.push(&cx, f.binder);
            retained.append(&cx, f.retained);
        },
        _ => (),
    };
    Type::Foreach.(ForeachType.{ binder, indirect, source: Cell::new(&cx, source), body: Cell::new(&cx, body), retained })
}

forall 'k.
fn fn_type(&cx: Cx!['k], params: Seq[Type['k], 'k], ret: Type['k], quantified: Seq[Param['k], 'k], is_unsafe: bool, places: Seq[usize, 'k]) -> Type['k] {
    Type::Fn.(FnType.{ params, ret: Cell::new(&cx, ret), quantified, is_unsafe, places })
}

forall 'k.
fn types_same(&cx: Cx!['k], a: Seq[Type['k], 'k], b: Seq[Type['k], 'k]) -> bool {
    var equal = a.len(&cx) == b.len(&cx);
    var i = 0usize;
    while equal && i < a.len(&cx) {
        equal = same(&cx, a.get(&cx, i), b.get(&cx, i));
        i = i + 1usize;
    }
    equal
}

forall 'k.
fn members_same(&cx: Cx!['k], a: Seq[Member['k], 'k], b: Seq[Member['k], 'k]) -> bool {
    var equal = a.len(&cx) == b.len(&cx);
    var i = 0usize;
    while equal && i < a.len(&cx) {
        equal = a.get(&cx, i).name.eq(&cx, b.get(&cx, i).name) && same(&cx, a.get(&cx, i).type, b.get(&cx, i).type);
        i = i + 1usize;
    }
    equal
}

forall 'k.
fn texts_same(&cx: Cx!['k], a: Seq[Text['k], 'k], b: Seq[Text['k], 'k]) -> bool {
    a.same(&cx, b)
}

forall 'k.
fn params_same(&cx: Cx!['k], a: Seq[Param['k], 'k], b: Seq[Param['k], 'k]) -> bool {
    var equal = a.len(&cx) == b.len(&cx);
    var i = 0usize;
    while equal && i < a.len(&cx) {
        equal = a.get(&cx, i).name.eq(&cx, b.get(&cx, i).name) && same_kind(a.get(&cx, i).kind, b.get(&cx, i).kind);
        i = i + 1usize;
    }
    equal
}

// Structural equality: the same constructor with the same parts. Variables are equal only to
// themselves.
forall 'k.
fn same(&cx: Cx!['k], a: Type['k], b: Type['k]) -> bool {
    match a {
        Type::Prim(x) => match b {
            Type::Prim(y) => x.eq(&cx, y),
            _ => false,
        },
        Type::Never => match b {
            Type::Never => true,
            _ => false,
        },
        Type::Named(x, xs) => match b {
            Type::Named(y, ys) => x.eq(&cx, y) && types_same(&cx, xs, ys),
            _ => false,
        },
        Type::Struct(xs) => match b {
            Type::Struct(ys) => members_same(&cx, xs, ys),
            _ => false,
        },
        Type::Enum(xs) => match b {
            Type::Enum(ys) => members_same(&cx, xs, ys),
            _ => false,
        },
        Type::Tuple(xs) => match b {
            Type::Tuple(ys) => types_same(&cx, xs, ys),
            _ => false,
        },
        Type::Array(x, n) => match b {
            Type::Array(y, m) => n == m && same(&cx, x.get(&cx), y.get(&cx)),
            _ => false,
        },
        Type::Ptr(x) => match b {
            Type::Ptr(y) => same(&cx, x.get(&cx), y.get(&cx)),
            _ => false,
        },
        Type::Skolem(x) => match b {
            Type::Skolem(y) => x.eq(&cx, y),
            _ => false,
        },
        Type::Brand(x) => match b {
            Type::Brand(y) => same(&cx, x.get(&cx), y.get(&cx)),
            _ => false,
        },
        Type::Exists(xs, x) => match b {
            Type::Exists(ys, y) => texts_same(&cx, xs, ys) && same(&cx, x.get(&cx), y.get(&cx)),
            _ => false,
        },
        Type::Foreach(x) => match b {
            Type::Foreach(y) => x.binder.eq(&cx, y.binder) && x.indirect == y.indirect && same(&cx, x.source.get(&cx), y.source.get(&cx))
                && same(&cx, x.body.get(&cx), y.body.get(&cx)) && texts_same(&cx, x.retained, y.retained),
            _ => false,
        },
        Type::Fn(x) => match b {
            Type::Fn(y) => types_same(&cx, x.params, y.params) && same(&cx, x.ret.get(&cx), y.ret.get(&cx)) && params_same(&cx, x.quantified, y.quantified)
                && x.is_unsafe == y.is_unsafe && x.places.same(&cx, y.places),
            _ => false,
        },
        Type::Ignored => match b {
            Type::Ignored => true,
            _ => false,
        },
        Type::Meta(x) => match b {
            Type::Meta(y) => x.id() == y.id(),
            _ => false,
        },
    }
}

forall 'k.
fn hash_types(&cx: Cx!['k], h: u64, ts: Seq[Type['k], 'k]) -> u64 {
    var h = h;
    var i = 0usize;
    while i < ts.len(&cx) {
        h = combine(h, hash(&cx, ts.get(&cx, i)));
        i = i + 1usize;
    }
    h
}

forall 'k.
fn hash_members(&cx: Cx!['k], h: u64, ms: Seq[Member['k], 'k]) -> u64 {
    var h = h;
    var i = 0usize;
    while i < ms.len(&cx) {
        h = combine(combine(h, ms.get(&cx, i).name.hash(&cx)), hash(&cx, ms.get(&cx, i).type));
        i = i + 1usize;
    }
    h
}

forall 'k.
fn hash(&cx: Cx!['k], t: Type['k]) -> u64 {
    match t {
        Type::Prim(x) => combine(1u64, x.hash(&cx)),
        Type::Never => 2u64,
        Type::Named(x, xs) => hash_types(&cx, combine(3u64, x.hash(&cx)), xs),
        Type::Struct(xs) => hash_members(&cx, 4u64, xs),
        Type::Enum(xs) => hash_members(&cx, 5u64, xs),
        Type::Tuple(xs) => hash_types(&cx, 6u64, xs),
        Type::Array(x, n) => combine(combine(7u64, hash(&cx, x.get(&cx))), n),
        Type::Ptr(x) => combine(8u64, hash(&cx, x.get(&cx))),
        Type::Skolem(x) => combine(9u64, x.hash(&cx)),
        Type::Brand(x) => combine(10u64, hash(&cx, x.get(&cx))),
        Type::Exists(xs, x) => combine(combine(11u64, key_hash(&cx, xs)), hash(&cx, x.get(&cx))),
        Type::Foreach(x) => combine(combine(12u64, x.binder.hash(&cx)), combine(hash(&cx, x.source.get(&cx)), hash(&cx, x.body.get(&cx)))),
        Type::Fn(x) => combine(hash_types(&cx, 13u64, x.params), hash(&cx, x.ret.get(&cx))),
        Type::Ignored => 14u64,
        Type::Meta(x) => combine(15u64, x.id() as u64),
    }
}

forall 'k.
instance HashIn[Type['k], Cx!['k]] {
    fn hash_in(&cx: Cx!['k], key: Type['k], state: HashState) -> HashState {
        let h = hash(&cx, key);
        state.write_u64(h)
    }

    fn eq_in(&cx: Cx!['k], a: Type['k], b: Type['k]) -> bool {
        let equal = same(&cx, a, b);
        equal
    }
}

forall 'k.
instance HashIn[Param['k], Cx!['k]] {
    fn hash_in(&cx: Cx!['k], key: Param['k], state: HashState) -> HashState {
        let h = combine(key.name.hash(&cx), kind_index(key.kind) as u64);
        state.write_u64(h)
    }

    fn eq_in(&cx: Cx!['k], a: Param['k], b: Param['k]) -> bool {
        let equal = a.name.eq(&cx, b.name) && same_kind(a.kind, b.kind);
        equal
    }
}

forall 'k.
instance HashIn[Premise['k], Cx!['k]] {
    fn hash_in(&cx: Cx!['k], key: Premise['k], state: HashState) -> HashState {
        let h = hash_types(&cx, key.trait_name.hash(&cx), key.args);
        state.write_u64(h)
    }

    fn eq_in(&cx: Cx!['k], a: Premise['k], b: Premise['k]) -> bool {
        let equal = a.trait_name.eq(&cx, b.trait_name) && types_same(&cx, a.args, b.args);
        equal
    }
}

// ---------------------------------------------------------------- modules --

forall 'k.
exposed struct ModuleId {
    package: usize,
    path: Seq[Text['k], 'k],
}

forall 'k.
impl ModuleId['k] {
    fn root(&cx: Cx!['k], package: usize) -> ModuleId['k] {
        ModuleId.{ package, path: Seq::new(&cx) }
    }

    fn child(self, &cx: Cx!['k], name: Text['k]) -> ModuleId['k] {
        let path = self.path.copy(&cx);
        path.push(&cx, name);
        ModuleId.{ package: self.package, path }
    }

    // `self` is `scope` or a module inside it.
    fn within(self, &cx: Cx!['k], scope: ModuleId['k]) -> bool {
        self.package == scope.package && self.path.len(&cx) >= scope.path.len(&cx) && self.path.slice(&cx, 0usize, scope.path.len(&cx)).same(&cx, scope.path)
    }
}

forall 'k.
instance HashIn[ModuleId['k], Cx!['k]] {
    fn hash_in(&cx: Cx!['k], key: ModuleId['k], state: HashState) -> HashState {
        let h = combine(key.package as u64, key_hash(&cx, key.path));
        state.write_u64(h)
    }

    fn eq_in(&cx: Cx!['k], a: ModuleId['k], b: ModuleId['k]) -> bool {
        let equal = a.package == b.package && a.path.same(&cx, b.path);
        equal
    }
}

exposed enum ExposureMode {
    Owner,
    Within,
}

forall 'k.
exposed struct Exposure {
    mode: ExposureMode,
    home: ModuleId['k],
}

// ----------------------------------------------------------- declarations --

forall 'k.
exposed struct TypeDecl {
    name: Text['k],
    linear: bool,
    params: Seq[Param['k], 'k],
    premises: Seq[Premise['k], 'k],
    body: Type['k],
    home: Option[ModuleId['k]],
    // none: transparent
    exposure: Option[Exposure['k]],
}

forall 'k.
exposed struct Instr {
    lhs: Seq[Text['k], 'k],
    op: Text['k],
    args: Seq[Text['k], 'k],
    // the type operand
    ty: Option[Type['k]],
    // type arguments
    tys: Seq[Type['k], 'k],
    lit: Option[Text['k]],
    // the instruction's discharge marker
    is_unsafe: bool,
    // `open`'s brand binders
    binders: Seq[Text['k], 'k],
    pos: Pos,
}

forall 'k.
exposed struct Edge {
    target: Text['k],
    args: Seq[Text['k], 'k],
    tys: Seq[Type['k], 'k],
}

forall 'k.
exposed struct Arm {
    variant: Text['k],
    edge: Edge['k],
}

forall 'k.
exposed enum Terminator {
    Ret(Text['k], Pos),
    Jmp(Edge['k], Pos),
    // condition, then, other
    Jnz(Text['k], Edge['k], Edge['k], Pos),
    // scrutinee, its enum type, one arm per variant
    Switch(Text['k], Type['k], Seq[Arm['k], 'k], Pos),
    Unreachable(Pos),
}

forall 'k.
exposed struct Binding {
    name: Text['k],
    type: Type['k],
}

// A known variant of a place: `known &path = Variant`.
forall 'k.
exposed struct Known {
    path: Text['k],
    variant: Text['k],
}

// An opened package place and the brands of its view.
forall 'k.
exposed struct Opened {
    path: Text['k],
    brands: Seq[Text['k], 'k],
}

forall 'k.
exposed struct Block {
    label: Text['k],
    params: Seq[Binding['k], 'k],
    instrs: Seq[Instr['k], 'k],
    term: Terminator['k],
    brands: Seq[Text['k], 'k],
    // place paths declared empty
    empty: Seq[Text['k], 'k],
    known: Seq[Known['k], 'k],
    opened: Seq[Opened['k], 'k],
    pos: Pos,
}

forall 'k.
exposed struct Fun {
    name: Text['k],
    // quantified parameters
    params: Seq[Param['k], 'k],
    premises: Seq[Premise['k], 'k],
    ret: Type['k],
    // a place parameter's type is the root type; see `places`
    ptypes: Seq[Type['k], 'k],
    blocks: Seq[Block['k], 'k],
    // whole-function places: `&name` and its type
    locals: Seq[Binding['k], 'k],
    is_unsafe: bool,
    home: Option[ModuleId['k]],
    pos: Pos,
}

forall 'k.
impl Fun['k] {
    // The indices of the place parameters, whose entry names start with `&`.
    fn places(self, &cx: Cx!['k]) -> Seq[usize, 'k] {
        let out: Seq[usize, 'k] = Seq::new(&cx);
        let params = self.blocks.get(&cx, 0usize).params;
        var i = 0usize;
        while i < params.len(&cx) {
            if params.get(&cx, i).name.byte(&cx, 0usize) == b'&' {
                out.push(&cx, i);
            }
            i = i + 1usize;
        }
        out
    }
}

forall 'k.
exposed struct Extern {
    name: Text['k],
    ret: Option[Type['k]],
    // none for an extern value
    ptypes: Option[Seq[Type['k], 'k]],
    pos: Pos,
}

forall 'k.
exposed struct Method {
    name: Text['k],
    ret: Type['k],
    ptypes: Seq[Type['k], 'k],
    is_unsafe: bool,
    places: Seq[usize, 'k],
}

forall 'k.
exposed struct Trait {
    name: Text['k],
    params: Seq[Text['k], 'k],
    methods: Seq[Method['k], 'k],
    home: Option[ModuleId['k]],
    // omitted kinds are Any, as in plain KURS headers
    param_kinds: Seq[Kind, 'k],
}

forall 'k.
exposed struct Instance {
    trait_name: Text['k],
    params: Seq[Param['k], 'k],
    premises: Seq[Premise['k], 'k],
    // one type per trait parameter
    head: Seq[Type['k], 'k],
    // functions with bare method names
    methods: Seq[Fun['k], 'k],
    home: Option[ModuleId['k]],
    pos: Pos,
}

forall 'k.
exposed struct Data {
    name: Text['k],
    ty: Type['k],
    // the raw form
    init: Form['k],
    home: Option[ModuleId['k]],
}

forall 'k.
exposed struct Program {
    types: Map[Text['k], TypeDecl['k], 'k],
    funs: Map[Text['k], Fun['k], 'k],
    externs: Map[Text['k], Extern['k], 'k],
    datas: Map[Text['k], Data['k], 'k],
    traits: Map[Text['k], Trait['k], 'k],
    // trait -> its instances
    instances: Map[Text['k], Seq[Instance['k], 'k], 'k],
}

forall 'k.
impl Program['k] {
    fn new(&cx: Cx!['k]) -> Program['k] {
        Program.{ types: Map::new(&cx), funs: Map::new(&cx), externs: Map::new(&cx), datas: Map::new(&cx), traits: Map::new(&cx), instances: Map::new(&cx) }
    }
}
