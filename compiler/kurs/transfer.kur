// A core program copied from one arena to another, so that the phase which made it can drop its
// arena. Every value is copied whole, with nothing left pointing into the arena it came from; a
// part shared by two places in the original is copied for each, since nothing changes a program
// once it is lowered.

use std::collections::arena_vec::ArenaVec;
use std::mem::Ref;
use std::raw::Span;
use std::arena::Domain!;
use package::kurs::core::{Arm, Binding, Block, Data, Edge, Exposure, Extern, ForeachType, FnType, Fun, Instance, Instr, Known,
    Member, Meta, MetaState, Method, ModuleId, Opened, Param, Premise, Program, Terminator, Trait, Type, TypeDecl};
use package::kurs::sexpr::Form;
use std::option::Option;

forall 'a, 'b.
fn copy_texts(&from: Domain!['a], &to: Domain!['b], items: ArenaVec[Span['a], 'a]) -> ArenaVec[Span['b], 'b] {
    let out: ArenaVec[Span['b], 'b] = ArenaVec::new(&to);
    var i = 0usize;
    while i < items.len(&from) {
        out.push(&to, items.at(&from, i).copy_to(&from, &to));
        i = i + 1usize;
    }
    out
}

forall 'a, 'b.
fn copy_option_text(&from: Domain!['a], &to: Domain!['b], t: Option[Span['a]]) -> Option[Span['b]] {
    match t {
        Option::Some(x) => Option::Some.(x.copy_to(&from, &to)),
        Option::None => Option::None,
    }
}

// A sequence of values that hold no storage, such as indices and kinds.
forall T, 'a, 'b where Copy[T].
fn copy_plain(&from: Domain!['a], &to: Domain!['b], items: ArenaVec[T, 'a]) -> ArenaVec[T, 'b] {
    let out: ArenaVec[T, 'b] = ArenaVec::new(&to);
    var i = 0usize;
    while i < items.len(&from) {
        out.push(&to, items.at(&from, i));
        i = i + 1usize;
    }
    out
}

// ------------------------------------------------------------------ types --

forall 'a, 'b.
fn copy_cell(&from: Domain!['a], &to: Domain!['b], t: Ref[Type['a], 'a]) -> Ref[Type['b], 'b] {
    Ref::new(&to, copy_type(&from, &to, t.copy(&from)))
}

forall 'a, 'b.
fn copy_type(&from: Domain!['a], &to: Domain!['b], t: Type['a]) -> Type['b] {
    match t {
        Type::Prim(name) => Type::Prim.(name.copy_to(&from, &to)),
        Type::Never => Type::Never,
        Type::Named(name, args) => Type::Named.(name.copy_to(&from, &to), copy_types(&from, &to, args)),
        Type::Struct(members) => Type::Struct.(copy_members(&from, &to, members)),
        Type::Enum(members) => Type::Enum.(copy_members(&from, &to, members)),
        Type::Tuple(items) => Type::Tuple.(copy_types(&from, &to, items)),
        Type::Array(item, n) => Type::Array.(copy_cell(&from, &to, item), n),
        Type::Ptr(inner) => Type::Ptr.(copy_cell(&from, &to, inner)),
        Type::NonNull(inner) => Type::NonNull.(copy_cell(&from, &to, inner)),
        Type::Skolem(name) => Type::Skolem.(name.copy_to(&from, &to)),
        Type::Brand(inner) => Type::Brand.(copy_cell(&from, &to, inner)),
        Type::Exists(labels, body) => Type::Exists.(copy_texts(&from, &to, labels), copy_cell(&from, &to, body)),
        Type::Foreach(f) => Type::Foreach.(ForeachType.{ binder: f.binder.copy_to(&from, &to), indirect: f.indirect,
            source: copy_cell(&from, &to, f.source), body: copy_cell(&from, &to, f.body) }),
        Type::Fn(f) => Type::Fn.(FnType.{ params: copy_types(&from, &to, f.params), ret: copy_cell(&from, &to, f.ret),
            is_unsafe: f.is_unsafe, places: copy_plain(&from, &to, f.places) }),
        // A solved variable is its solution; an unsolved one stays a variable of its own.
        Type::Meta(m) => match m.solution(&from) {
            Option::Some(solution) => copy_type(&from, &to, solution),
            Option::None => Type::Meta.(Meta.{ state: Ref::new(&to, MetaState.{ solution: Option::None, kind: m.kind(&from), pos: m.pos(&from) }) }),
        },
    }
}

forall 'a, 'b.
fn copy_types(&from: Domain!['a], &to: Domain!['b], items: ArenaVec[Type['a], 'a]) -> ArenaVec[Type['b], 'b] {
    let out: ArenaVec[Type['b], 'b] = ArenaVec::new(&to);
    var i = 0usize;
    while i < items.len(&from) {
        out.push(&to, copy_type(&from, &to, items.at(&from, i)));
        i = i + 1usize;
    }
    out
}

forall 'a, 'b.
fn copy_option_type(&from: Domain!['a], &to: Domain!['b], t: Option[Type['a]]) -> Option[Type['b]] {
    match t {
        Option::Some(x) => Option::Some.(copy_type(&from, &to, x)),
        Option::None => Option::None,
    }
}

forall 'a, 'b.
fn copy_members(&from: Domain!['a], &to: Domain!['b], items: ArenaVec[Member['a], 'a]) -> ArenaVec[Member['b], 'b] {
    let out: ArenaVec[Member['b], 'b] = ArenaVec::new(&to);
    var i = 0usize;
    while i < items.len(&from) {
        let m = items.at(&from, i);
        out.push(&to, Member.{ name: m.name.copy_to(&from, &to), type: copy_type(&from, &to, m.type) });
        i = i + 1usize;
    }
    out
}

forall 'a, 'b.
fn copy_params(&from: Domain!['a], &to: Domain!['b], items: ArenaVec[Param['a], 'a]) -> ArenaVec[Param['b], 'b] {
    let out: ArenaVec[Param['b], 'b] = ArenaVec::new(&to);
    var i = 0usize;
    while i < items.len(&from) {
        let p = items.at(&from, i);
        out.push(&to, Param.{ name: p.name.copy_to(&from, &to), kind: p.kind });
        i = i + 1usize;
    }
    out
}

forall 'a, 'b.
fn copy_premises(&from: Domain!['a], &to: Domain!['b], items: ArenaVec[Premise['a], 'a]) -> ArenaVec[Premise['b], 'b] {
    let out: ArenaVec[Premise['b], 'b] = ArenaVec::new(&to);
    var i = 0usize;
    while i < items.len(&from) {
        let p = items.at(&from, i);
        out.push(&to, Premise.{ trait_name: p.trait_name.copy_to(&from, &to), args: copy_types(&from, &to, p.args) });
        i = i + 1usize;
    }
    out
}

forall 'a, 'b.
fn copy_home(&from: Domain!['a], &to: Domain!['b], home: Option[ModuleId['a]]) -> Option[ModuleId['b]] {
    match home {
        Option::Some(m) => Option::Some.(ModuleId.{ package: m.package, path: copy_texts(&from, &to, m.path) }),
        Option::None => Option::None,
    }
}

// ----------------------------------------------------------- declarations --

forall 'a, 'b.
fn copy_type_decl(&from: Domain!['a], &to: Domain!['b], d: TypeDecl['a]) -> TypeDecl['b] {
    let exposure = match d.exposure {
        Option::Some(e) => Option::Some.(Exposure.{ mode: e.mode, home: ModuleId.{ package: e.home.package, path: copy_texts(&from, &to, e.home.path) } }),
        Option::None => Option::None,
    };
    TypeDecl.{ name: d.name.copy_to(&from, &to), params: copy_params(&from, &to, d.params),
        premises: copy_premises(&from, &to, d.premises), body: copy_type(&from, &to, d.body), home: copy_home(&from, &to, d.home), exposure }
}

forall 'a, 'b.
fn copy_instr(&from: Domain!['a], &to: Domain!['b], i: Instr['a]) -> Instr['b] {
    Instr.{ lhs: copy_texts(&from, &to, i.lhs), op: i.op.copy_to(&from, &to), args: copy_texts(&from, &to, i.args),
        ty: copy_option_type(&from, &to, i.ty), tys: copy_types(&from, &to, i.tys), lit: copy_option_text(&from, &to, i.lit),
        is_unsafe: i.is_unsafe, binders: copy_texts(&from, &to, i.binders), pos: i.pos }
}

forall 'a, 'b.
fn copy_edge(&from: Domain!['a], &to: Domain!['b], e: Edge['a]) -> Edge['b] {
    Edge.{ target: e.target.copy_to(&from, &to), args: copy_texts(&from, &to, e.args), tys: copy_types(&from, &to, e.tys) }
}

forall 'a, 'b.
fn copy_terminator(&from: Domain!['a], &to: Domain!['b], t: Terminator['a]) -> Terminator['b] {
    match t {
        Terminator::Ret(value, pos) => Terminator::Ret.(value.copy_to(&from, &to), pos),
        Terminator::Jmp(edge, pos) => Terminator::Jmp.(copy_edge(&from, &to, edge), pos),
        Terminator::Jnz(cond, then, other, pos) => Terminator::Jnz.(cond.copy_to(&from, &to), copy_edge(&from, &to, then), copy_edge(&from, &to, other), pos),
        Terminator::Switch(scrutinee, ty, arms, pos) => {
            let out: ArenaVec[Arm['b], 'b] = ArenaVec::new(&to);
            var i = 0usize;
            while i < arms.len(&from) {
                let arm = arms.at(&from, i);
                out.push(&to, Arm.{ variant: arm.variant.copy_to(&from, &to), edge: copy_edge(&from, &to, arm.edge) });
                i = i + 1usize;
            }
            Terminator::Switch.(scrutinee.copy_to(&from, &to), copy_type(&from, &to, ty), out, pos)
        },
        Terminator::Unreachable(pos) => Terminator::Unreachable.(pos),
    }
}

forall 'a, 'b.
fn copy_bindings(&from: Domain!['a], &to: Domain!['b], items: ArenaVec[Binding['a], 'a]) -> ArenaVec[Binding['b], 'b] {
    let out: ArenaVec[Binding['b], 'b] = ArenaVec::new(&to);
    var i = 0usize;
    while i < items.len(&from) {
        let b = items.at(&from, i);
        out.push(&to, Binding.{ name: b.name.copy_to(&from, &to), type: copy_type(&from, &to, b.type) });
        i = i + 1usize;
    }
    out
}

forall 'a, 'b.
fn copy_block(&from: Domain!['a], &to: Domain!['b], b: Block['a]) -> Block['b] {
    let instrs: ArenaVec[Instr['b], 'b] = ArenaVec::new(&to);
    var i = 0usize;
    while i < b.instrs.len(&from) {
        instrs.push(&to, copy_instr(&from, &to, b.instrs.at(&from, i)));
        i = i + 1usize;
    }
    let known: ArenaVec[Known['b], 'b] = ArenaVec::new(&to);
    i = 0usize;
    while i < b.known.len(&from) {
        let k = b.known.at(&from, i);
        known.push(&to, Known.{ path: k.path.copy_to(&from, &to), variant: k.variant.copy_to(&from, &to) });
        i = i + 1usize;
    }
    let opened: ArenaVec[Opened['b], 'b] = ArenaVec::new(&to);
    i = 0usize;
    while i < b.opened.len(&from) {
        let o = b.opened.at(&from, i);
        opened.push(&to, Opened.{ path: o.path.copy_to(&from, &to), brands: copy_texts(&from, &to, o.brands) });
        i = i + 1usize;
    }
    Block.{ label: b.label.copy_to(&from, &to), params: copy_bindings(&from, &to, b.params), instrs, term: copy_terminator(&from, &to, b.term),
        brands: copy_texts(&from, &to, b.brands), empty: copy_texts(&from, &to, b.empty), known, opened, pos: b.pos }
}

forall 'a, 'b.
fn copy_fun(&from: Domain!['a], &to: Domain!['b], f: Fun['a]) -> Fun['b] {
    let blocks: ArenaVec[Block['b], 'b] = ArenaVec::new(&to);
    var i = 0usize;
    while i < f.blocks.len(&from) {
        blocks.push(&to, copy_block(&from, &to, f.blocks.at(&from, i)));
        i = i + 1usize;
    }
    Fun.{ name: f.name.copy_to(&from, &to), params: copy_params(&from, &to, f.params), premises: copy_premises(&from, &to, f.premises),
        ret: copy_type(&from, &to, f.ret), ptypes: copy_types(&from, &to, f.ptypes), blocks, locals: copy_bindings(&from, &to, f.locals),
        is_unsafe: f.is_unsafe, home: copy_home(&from, &to, f.home), pos: f.pos }
}

forall 'a, 'b.
fn copy_form(&from: Domain!['a], &to: Domain!['b], f: Form['a]) -> Form['b] {
    let items: ArenaVec[Form['b], 'b] = ArenaVec::new(&to);
    var i = 0usize;
    while i < f.items.len(&from) {
        items.push(&to, copy_form(&from, &to, f.items.at(&from, i)));
        i = i + 1usize;
    }
    Form.{ kind: f.kind, text: f.text.copy_to(&from, &to), items, pos: f.pos }
}

forall 'a, 'b.
fn copy_instance(&from: Domain!['a], &to: Domain!['b], inst: Instance['a]) -> Instance['b] {
    let methods: ArenaVec[Fun['b], 'b] = ArenaVec::new(&to);
    var i = 0usize;
    while i < inst.methods.len(&from) {
        methods.push(&to, copy_fun(&from, &to, inst.methods.at(&from, i)));
        i = i + 1usize;
    }
    Instance.{ trait_name: inst.trait_name.copy_to(&from, &to), params: copy_params(&from, &to, inst.params),
        premises: copy_premises(&from, &to, inst.premises), head: copy_types(&from, &to, inst.head), methods,
        home: copy_home(&from, &to, inst.home), pos: inst.pos }
}

forall 'a, 'b.
fn copy_trait(&from: Domain!['a], &to: Domain!['b], t: Trait['a]) -> Trait['b] {
    let methods: ArenaVec[Method['b], 'b] = ArenaVec::new(&to);
    var i = 0usize;
    while i < t.methods.len(&from) {
        let m = t.methods.at(&from, i);
        methods.push(&to, Method.{ name: m.name.copy_to(&from, &to), ret: copy_type(&from, &to, m.ret), ptypes: copy_types(&from, &to, m.ptypes),
            is_unsafe: m.is_unsafe, places: copy_plain(&from, &to, m.places) });
        i = i + 1usize;
    }
    Trait.{ name: t.name.copy_to(&from, &to), params: copy_texts(&from, &to, t.params), methods, home: copy_home(&from, &to, t.home),
        param_kinds: copy_plain(&from, &to, t.param_kinds) }
}

// The whole program, its maps in the same order.
forall 'a, 'b.
fn copy_program(&from: Domain!['a], &to: Domain!['b], p: Program['a]) -> Program['b] {
    let out = Program::new(&to);
    var i = 0usize;
    while i < p.types.positions(&from) {
        match p.types.key_at(&from, i) {
            Option::Some(name) => { out.types.insert(&to, name.copy_to(&from, &to), copy_type_decl(&from, &to, p.types.at(&from, name))); },
            Option::None => (),
        };
        i = i + 1usize;
    }
    i = 0usize;
    while i < p.funs.positions(&from) {
        match p.funs.key_at(&from, i) {
            Option::Some(name) => { out.funs.insert(&to, name.copy_to(&from, &to), copy_fun(&from, &to, p.funs.at(&from, name))); },
            Option::None => (),
        };
        i = i + 1usize;
    }
    i = 0usize;
    while i < p.externs.positions(&from) {
        match p.externs.key_at(&from, i) {
            Option::Some(name) => {
                let x = p.externs.at(&from, name);
                let ptypes = match x.ptypes {
                    Option::Some(ts) => Option::Some.(copy_types(&from, &to, ts)),
                    Option::None => Option::None,
                };
                out.externs.insert(&to, name.copy_to(&from, &to), Extern.{ name: x.name.copy_to(&from, &to), ret: copy_option_type(&from, &to, x.ret), ptypes, pos: x.pos });
            },
            Option::None => (),
        };
        i = i + 1usize;
    }
    i = 0usize;
    while i < p.datas.positions(&from) {
        match p.datas.key_at(&from, i) {
            Option::Some(name) => {
                let d = p.datas.at(&from, name);
                out.datas.insert(&to, name.copy_to(&from, &to), Data.{ name: d.name.copy_to(&from, &to), ty: copy_type(&from, &to, d.ty),
                    init: copy_form(&from, &to, d.init), home: copy_home(&from, &to, d.home) });
            },
            Option::None => (),
        };
        i = i + 1usize;
    }
    i = 0usize;
    while i < p.traits.positions(&from) {
        match p.traits.key_at(&from, i) {
            Option::Some(name) => { out.traits.insert(&to, name.copy_to(&from, &to), copy_trait(&from, &to, p.traits.at(&from, name))); },
            Option::None => (),
        };
        i = i + 1usize;
    }
    i = 0usize;
    while i < p.instances.positions(&from) {
        match p.instances.key_at(&from, i) {
            Option::Some(name) => {
                let insts = p.instances.at(&from, name);
                let copied: ArenaVec[Instance['b], 'b] = ArenaVec::new(&to);
                var k = 0usize;
                while k < insts.len(&from) {
                    copied.push(&to, copy_instance(&from, &to, insts.at(&from, k)));
                    k = k + 1usize;
                }
                out.instances.insert(&to, name.copy_to(&from, &to), copied);
            },
            Option::None => (),
        };
        i = i + 1usize;
    }
    out
}
