// S-expressions: the forms serialized KURS is written in.

use package::support::base::{fail, fail_static};
use std::collections::arena_vec::ArenaVec;
use std::raw::Span;
use std::arena::Domain!;
use std::buffer::Buffer!;
use package::syntax::ast::Pos;
use std::collections::vec::OwnedVec!;
use std::slice::Slice;
use std::option::Option;

exposed enum FormKind {
    // a word
    Atom,
    // a double-quoted string literal, unescaped
    Str,
    List,
}

forall 'k.
exposed struct Form {
    kind: FormKind,
    text: Span['k],
    items: ArenaVec[Form['k], 'k],
    pos: Pos,
}

forall 'k.
impl Form['k] {
    fn is_list(self) -> bool {
        match self.kind {
            List => true,
            _ => false,
        }
    }

    fn is_str(self) -> bool {
        match self.kind {
            Str => true,
            _ => false,
        }
    }

    fn len(self, &cx: Domain!['k]) -> usize {
        self.items.len(&cx)
    }

    fn at(self, &cx: Domain!['k], i: usize) -> Form['k] {
        self.items.at(&cx, i)
    }
}

forall 'k.
fn located(&cx: Domain!['k], message: Span['k], pos: Pos) -> Span['k] {
    Buffer!::new().push_u64(pos.line as u64).push_static(":").push_u64(pos.col as u64).push_static(": ").push_bytes(&cx, message).save(&cx)
}

forall 'k.
fn fail_at(&cx: Domain!['k], message: Slice[u8, 'static], pos: Pos) -> ! {
    fail(&cx, located(&cx, Span::from_static(&cx, message), pos))
}

// Lists nest at most this deep. Every phase after the reader recurses into nested lists, so deeper
// input would exhaust its stack.
const MAX_DEPTH: usize = 256usize;

// Every top-level form of `source`, as one list.
forall 'k.
fn read(&cx: Domain!['k], source: Span['k]) -> Form['k] {
    let top = Form.{ kind: FormKind::List, text: Span::from_static(&cx, ""), items: ArenaVec::new(&cx), pos: Pos.{ line: 0u32, col: 0u32 } };
    // The lists open at this point, outermost first: the reader's own, freed when it is done.
    var stack = OwnedVec!::new[Form['k]]().push(top);
    var i = 0usize;
    let n = source.len();
    var line = 1u32;
    var line_start = 0usize;
    while i < n {
        let c = source.byte_or_zero(&cx, i);
        let pos = Pos.{ line, col: (i - line_start + 1usize) as u32 };
        if c == b'\n' {
            line = line + 1u32;
            line_start = i + 1usize;
        }
        if c == b' ' || c == b'\t' || c == b'\r' || c == b'\n' {
            i = i + 1usize;
        } else if c == b';' {
            while i < n && source.byte_or_zero(&cx, i) != b'\n' {
                i = i + 1usize;
            }
        } else if c == b'(' {
            let open = &stack.len();
            if open > MAX_DEPTH {
                fail_at(&cx, "lists nest deeper than 256", pos);
            }
            let form = Form.{ kind: FormKind::List, text: Span::from_static(&cx, ""), items: ArenaVec::new(&cx), pos };
            innermost(&stack).items.push(&cx, form);
            stack = stack.push(form);
            i = i + 1usize;
        } else if c == b')' {
            let open = &stack.len();
            if open == 1usize {
                fail_at(&cx, "unbalanced ')'", pos);
            }
            let closed = match &stack.pop() {
                Some(form) => form,
                None => top,
            };
            i = i + 1usize;
        } else if c == b'"' {
            var j = i + 1usize;
            var chars = Buffer!::new();
            while j < n && source.byte_or_zero(&cx, j) != b'"' {
                let d = source.byte_or_zero(&cx, j);
                if d == b'\\' && source.byte_or_zero(&cx, j + 1usize) == b'x' {
                    // An ASCII character: a string is UTF-8 text, and any other character is written as itself.
                    let high = source.byte_or_zero(&cx, j + 2usize);
                    let low = source.byte_or_zero(&cx, j + 3usize);
                    if j + 3usize >= n || !is_hex(high) || !is_hex(low) {
                        fail_at(&cx, "a \\x escape needs two hex digits in a string literal", pos);
                    }
                    let byte = hex(high) * 16u8 + hex(low);
                    if byte >= 128u8 {
                        fail_at(&cx, "a \\x escape is at most 7f in a string literal", pos);
                    }
                    chars = chars.push_byte(byte);
                    j = j + 4usize;
                } else if d == b'\\' {
                    let e = source.byte_or_zero(&cx, j + 1usize);
                    let byte = if e == b'n' {
                        b'\n'
                    } else if e == b't' {
                        b'\t'
                    } else if e == b'r' {
                        b'\r'
                    } else if e == b'0' {
                        0u8
                    } else if e == b'\\' || e == b'\'' || e == b'"' {
                        e
                    } else {
                        fail_at(&cx, "unknown escape in a string literal", pos)
                    };
                    chars = chars.push_byte(byte);
                    j = j + 2usize;
                } else {
                    chars = chars.push_byte(d);
                    j = j + 1usize;
                }
            }
            if j >= n {
                fail_at(&cx, "unterminated string literal", pos);
            }
            innermost(&stack).items.push(&cx, Form.{ kind: FormKind::Str, text: chars.save(&cx), items: ArenaVec::new(&cx), pos });
            i = j + 1usize;
        } else {
            var j = i;
            while j < n && !is_delimiter(source.byte_or_zero(&cx, j)) {
                j = j + 1usize;
            }
            innermost(&stack).items.push(&cx, Form.{ kind: FormKind::Atom, text: source.slice(i, j), items: ArenaVec::new(&cx), pos });
            i = j;
        }
    }
    let open = &stack.len();
    if open != 1usize {
        fail_at(&cx, "unclosed '('", innermost(&stack).pos);
    }
    stack.free();
    top
}

// The innermost open list.
forall 'k.
fn innermost(&stack: OwnedVec![Form['k]]) -> Form['k] {
    let last = &stack.len() - 1usize;
    match &stack.get(last) {
        Some(form) => form,
        None => fail_static("internal error: no list is open"),
    }
}

fn is_delimiter(c: u8) -> bool {
    c == b' ' || c == b'\t' || c == b'\r' || c == b'\n' || c == b'(' || c == b')' || c == b';' || c == b'"'
}

fn is_hex(c: u8) -> bool {
    (c >= b'0' && c <= b'9') || (c >= b'a' && c <= b'f') || (c >= b'A' && c <= b'F')
}

fn hex(c: u8) -> u8 {
    if c >= b'0' && c <= b'9' {
        c - b'0'
    } else if c >= b'a' && c <= b'f' {
        c - b'a' + 10u8
    } else {
        c - b'A' + 10u8
    }
}
