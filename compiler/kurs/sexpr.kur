// S-expressions: the forms serialized KURS is written in.

use package::support::base::{Out, Seq, Text, fail, text};
use package::syntax::ast::Pos;
use std::slice::Slice;
use std::option::Option;

exposed enum FormKind {
    // a word
    Atom,
    // a double-quoted string literal, unescaped
    Str,
    List,
}

exposed struct Form {
    kind: FormKind,
    text: Text,
    items: Seq[Form],
    pos: Pos,
}

impl Form {
    fn is_list(self) -> bool {
        match self.kind {
            FormKind::List => true,
            _ => false,
        }
    }

    fn is_str(self) -> bool {
        match self.kind {
            FormKind::Str => true,
            _ => false,
        }
    }

    fn is_atom(self) -> bool {
        match self.kind {
            FormKind::Atom => true,
            _ => false,
        }
    }

    fn len(self) -> usize {
        self.items.len()
    }

    fn at(self, i: usize) -> Form {
        self.items.get(i)
    }
}

fn located(message: Text, pos: Pos) -> Text {
    Out::new().u64(pos.line as u64).put(":").u64(pos.col as u64).put(": ").add(message).done()
}

fn fail_at(message: Slice[u8, 'static], pos: Pos) -> ! {
    fail(located(text(message), pos))
}

// Every top-level form of `source`, as one list.
fn read(source: Text) -> Form {
    let top = Form.{ kind: FormKind::List, text: text(""), items: Seq::new(), pos: Pos.{ line: 0u32, col: 0u32 } };
    let stack: Seq[Form] = Seq::one(top);
    var i = 0usize;
    let n = source.len;
    var line = 1u32;
    var line_start = 0usize;
    while i < n {
        let c = source.byte(i);
        let pos = Pos.{ line, col: (i - line_start + 1usize) as u32 };
        if c == b'\n' {
            line = line + 1u32;
            line_start = i + 1usize;
        }
        if c == b' ' || c == b'\t' || c == b'\r' || c == b'\n' {
            i = i + 1usize;
        } else if c == b';' {
            while i < n && source.byte(i) != b'\n' {
                i = i + 1usize;
            }
        } else if c == b'(' {
            let form = Form.{ kind: FormKind::List, text: text(""), items: Seq::new(), pos };
            stack.last().items.push(form);
            stack.push(form);
            i = i + 1usize;
        } else if c == b')' {
            if stack.len() == 1usize {
                fail_at("unbalanced ')'", pos);
            }
            let unit = stack.pop();
            i = i + 1usize;
        } else if c == b'"' {
            var j = i + 1usize;
            let chars = Out::new();
            while j < n && source.byte(j) != b'"' {
                let d = source.byte(j);
                if d == b'\\' && source.byte(j + 1usize) == b'x' {
                    let unit = chars.byte(hex(source.byte(j + 2usize)) * 16u8 + hex(source.byte(j + 3usize)));
                    j = j + 4usize;
                } else if d == b'\\' {
                    let e = source.byte(j + 1usize);
                    let byte = if e == b'n' {
                        b'\n'
                    } else if e == b't' {
                        b'\t'
                    } else if e == b'r' {
                        b'\r'
                    } else if e == b'0' {
                        0u8
                    } else if e == b'\\' || e == b'\'' || e == b'"' {
                        e
                    } else {
                        fail_at("unknown escape in a string literal", pos)
                    };
                    let unit = chars.byte(byte);
                    j = j + 2usize;
                } else {
                    let unit = chars.byte(d);
                    j = j + 1usize;
                }
            }
            if j >= n {
                fail_at("unterminated string literal", pos);
            }
            stack.last().items.push(Form.{ kind: FormKind::Str, text: chars.done(), items: Seq::new(), pos });
            i = j + 1usize;
        } else {
            var j = i;
            while j < n && !is_delimiter(source.byte(j)) {
                j = j + 1usize;
            }
            stack.last().items.push(Form.{ kind: FormKind::Atom, text: source.slice(i, j), items: Seq::new(), pos });
            i = j;
        }
    }
    if stack.len() != 1usize {
        fail_at("unclosed '('", stack.last().pos);
    }
    top
}

fn is_delimiter(c: u8) -> bool {
    c == b' ' || c == b'\t' || c == b'\r' || c == b'\n' || c == b'(' || c == b')' || c == b';' || c == b'"'
}

fn hex(c: u8) -> u8 {
    if c >= b'0' && c <= b'9' {
        c - b'0'
    } else if c >= b'a' && c <= b'f' {
        c - b'a' + 10u8
    } else {
        c - b'A' + 10u8
    }
}
