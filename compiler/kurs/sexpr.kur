// S-expressions: the forms serialized KURS is written in.

use package::support::base::{Cx, Out, Seq, Text, fail, fail_static, text};
use package::syntax::ast::Pos;
use std::collections::vec::{OwnedVec, Popped};
use std::slice::Slice;
use std::option::Option;

exposed enum FormKind {
    // a word
    Atom,
    // a double-quoted string literal, unescaped
    Str,
    List,
}

forall 'k.
exposed struct Form {
    kind: FormKind,
    text: Text['k],
    items: Seq[Form['k], 'k],
    pos: Pos,
}

forall 'k.
impl Form['k] {
    fn is_list(self) -> bool {
        match self.kind {
            FormKind::List => true,
            _ => false,
        }
    }

    fn is_str(self) -> bool {
        match self.kind {
            FormKind::Str => true,
            _ => false,
        }
    }

    fn is_atom(self) -> bool {
        match self.kind {
            FormKind::Atom => true,
            _ => false,
        }
    }

    fn len(self, &cx: Cx!['k]) -> usize {
        self.items.len(&cx)
    }

    fn at(self, &cx: Cx!['k], i: usize) -> Form['k] {
        self.items.get(&cx, i)
    }
}

forall 'k.
fn located(&cx: Cx!['k], message: Text['k], pos: Pos) -> Text['k] {
    Out::new(&cx).u64(&cx, pos.line as u64).put(&cx, ":").u64(&cx, pos.col as u64).put(&cx, ": ").add(&cx, message).done(&cx)
}

forall 'k.
fn fail_at(&cx: Cx!['k], message: Slice[u8, 'static], pos: Pos) -> ! {
    fail(&cx, located(&cx, text(&cx, message), pos))
}

// Every top-level form of `source`, as one list.
forall 'k.
fn read(&cx: Cx!['k], source: Text['k]) -> Form['k] {
    let top = Form.{ kind: FormKind::List, text: text(&cx, ""), items: Seq::new(&cx), pos: Pos.{ line: 0u32, col: 0u32 } };
    // The lists open at this point, outermost first: the reader's own, freed when it is done.
    var stack = OwnedVec::new[Form['k]]().push(top);
    var i = 0usize;
    let n = source.len();
    var line = 1u32;
    var line_start = 0usize;
    while i < n {
        let c = source.byte(&cx, i);
        let pos = Pos.{ line, col: (i - line_start + 1usize) as u32 };
        if c == b'\n' {
            line = line + 1u32;
            line_start = i + 1usize;
        }
        if c == b' ' || c == b'\t' || c == b'\r' || c == b'\n' {
            i = i + 1usize;
        } else if c == b';' {
            while i < n && source.byte(&cx, i) != b'\n' {
                i = i + 1usize;
            }
        } else if c == b'(' {
            let form = Form.{ kind: FormKind::List, text: text(&cx, ""), items: Seq::new(&cx), pos };
            innermost(&stack).items.push(&cx, form);
            stack = stack.push(form);
            i = i + 1usize;
        } else if c == b')' {
            let open = &stack.len();
            if open == 1usize {
                fail_at(&cx, "unbalanced ')'", pos);
            }
            let closed = match &stack.pop() {
                Popped::Item(form) => form,
                Popped::Empty => top,
            };
            i = i + 1usize;
        } else if c == b'"' {
            var j = i + 1usize;
            let chars = Out::new(&cx);
            while j < n && source.byte(&cx, j) != b'"' {
                let d = source.byte(&cx, j);
                if d == b'\\' && source.byte(&cx, j + 1usize) == b'x' {
                    let unit = chars.byte(&cx, hex(source.byte(&cx, j + 2usize)) * 16u8 + hex(source.byte(&cx, j + 3usize)));
                    j = j + 4usize;
                } else if d == b'\\' {
                    let e = source.byte(&cx, j + 1usize);
                    let byte = if e == b'n' {
                        b'\n'
                    } else if e == b't' {
                        b'\t'
                    } else if e == b'r' {
                        b'\r'
                    } else if e == b'0' {
                        0u8
                    } else if e == b'\\' || e == b'\'' || e == b'"' {
                        e
                    } else {
                        fail_at(&cx, "unknown escape in a string literal", pos)
                    };
                    let unit = chars.byte(&cx, byte);
                    j = j + 2usize;
                } else {
                    let unit = chars.byte(&cx, d);
                    j = j + 1usize;
                }
            }
            if j >= n {
                fail_at(&cx, "unterminated string literal", pos);
            }
            innermost(&stack).items.push(&cx, Form.{ kind: FormKind::Str, text: chars.done(&cx), items: Seq::new(&cx), pos });
            i = j + 1usize;
        } else {
            var j = i;
            while j < n && !is_delimiter(source.byte(&cx, j)) {
                j = j + 1usize;
            }
            innermost(&stack).items.push(&cx, Form.{ kind: FormKind::Atom, text: source.slice(i, j), items: Seq::new(&cx), pos });
            i = j;
        }
    }
    let open = &stack.len();
    if open != 1usize {
        fail_at(&cx, "unclosed '('", innermost(&stack).pos);
    }
    stack.free();
    top
}

// The innermost open list.
forall 'k.
fn innermost(&stack: OwnedVec![Form['k]]) -> Form['k] {
    let last = &stack.len() - 1usize;
    match &stack.get(last) {
        Option::Some(form) => form,
        Option::None => fail_static("internal error: no list is open"),
    }
}

fn is_delimiter(c: u8) -> bool {
    c == b' ' || c == b'\t' || c == b'\r' || c == b'\n' || c == b'(' || c == b')' || c == b';' || c == b'"'
}

fn hex(c: u8) -> u8 {
    if c >= b'0' && c <= b'9' {
        c - b'0'
    } else if c >= b'a' && c <= b'f' {
        c - b'a' + 10u8
    } else {
        c - b'A' + 10u8
    }
}
