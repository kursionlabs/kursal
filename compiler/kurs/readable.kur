// Readable rendering of typed KURS; the interchange reader is `kurs::serial`.
//
// This is a display format, not an alternate checker or a reconstruction from C.

use package::support::base::{Cx, Map, Out, Seq, Set, Text, text};
use package::kurs::core::{Binding, Edge, ExposureMode, Fun, Instr, Kind, Member, ModuleId, Param, Premise, Program, Terminator, Type};
use package::kurs::core as C;
use package::kurs::sexpr::Form;
use package::syntax::ast::no_pos;
use package::types::ops::{Fresh, kurs_error, subst};
use std::option::Option;
use std::slice::Slice;

forall 'k.
fn brand(&cx: Cx!['k], name: Text['k]) -> Text['k] {
    Out::new(&cx).put(&cx, "'").add(&cx, name).done(&cx)
}

fn is_brand(kind: Kind) -> bool {
    C::same_kind(kind, Kind::Brand)
}

fn is_copy(kind: Kind) -> bool {
    C::same_kind(kind, Kind::Copy)
}

forall 'k.
fn joined(&cx: Cx!['k], parts: Seq[Text['k], 'k], separator: Slice[u8, 'static]) -> Text['k] {
    let out = Out::new(&cx);
    var i = 0usize;
    while i < parts.len(&cx) {
        if i > 0usize {
            let unit = out.put(&cx, separator);
        }
        let unit = out.add(&cx, parts.get(&cx, i));
        i = i + 1usize;
    }
    out.done(&cx)
}

forall 'k.
fn brands(&cx: Cx!['k], names: Seq[Text['k], 'k]) -> Text['k] {
    let out: Seq[Text['k], 'k] = Seq::new(&cx);
    var i = 0usize;
    while i < names.len(&cx) {
        out.push(&cx, brand(&cx, names.get(&cx, i)));
        i = i + 1usize;
    }
    joined(&cx, out, ", ")
}

forall 'k.
fn indentation(&cx: Cx!['k], depth: usize) -> Text['k] {
    let out = Out::new(&cx);
    var i = 0usize;
    while i < depth {
        let unit = out.put(&cx, "    ");
        i = i + 1usize;
    }
    out.done(&cx)
}

forall 'k.
fn type_texts(&cx: Cx!['k], types: Seq[Type['k], 'k], depth: usize) -> Seq[Text['k], 'k] {
    let out: Seq[Text['k], 'k] = Seq::new(&cx);
    var i = 0usize;
    while i < types.len(&cx) {
        out.push(&cx, type_text(&cx, types.get(&cx, i), depth));
        i = i + 1usize;
    }
    out
}

forall 'k.
fn arguments(&cx: Cx!['k], types: Seq[Type['k], 'k], depth: usize) -> Text['k] {
    if types.is_empty(&cx) {
        text(&cx, "")
    } else {
        Out::new(&cx).put(&cx, "[").add(&cx, joined(&cx, type_texts(&cx, types, depth), ", ")).put(&cx, "]").done(&cx)
    }
}

forall 'k.
fn premise_text(&cx: Cx!['k], premise: Premise['k]) -> Text['k] {
    Out::new(&cx).add(&cx, premise.trait_name).put(&cx, "[").add(&cx, joined(&cx, type_texts(&cx, premise.args, 0usize), ", ")).put(&cx, "]").done(&cx)
}

forall 'k.
fn quantifier(&cx: Cx!['k], params: Seq[Param['k], 'k], premises: Seq[Premise['k], 'k]) -> Text['k] {
    let names: Seq[Text['k], 'k] = Seq::new(&cx);
    let bounds: Seq[Text['k], 'k] = Seq::new(&cx);
    var i = 0usize;
    while i < params.len(&cx) {
        let param = params.get(&cx, i);
        names.push(&cx, if is_brand(param.kind) { brand(&cx, param.name) } else { param.name });
        if is_copy(param.kind) {
            bounds.push(&cx, Out::new(&cx).put(&cx, "Copy[").add(&cx, param.name).put(&cx, "]").done(&cx));
        }
        i = i + 1usize;
    }
    var j = 0usize;
    while j < premises.len(&cx) {
        bounds.push(&cx, premise_text(&cx, premises.get(&cx, j)));
        j = j + 1usize;
    }
    if names.is_empty(&cx) && bounds.is_empty(&cx) {
        return text(&cx, "");
    }
    let out = Out::new(&cx).put(&cx, "forall ").add(&cx, joined(&cx, names, ", "));
    if !bounds.is_empty(&cx) {
        let unit = out.put(&cx, " where ").add(&cx, joined(&cx, bounds, ", "));
    }
    out.put(&cx, ". ").done(&cx)
}

forall 'k.
fn is_binder_type(t: Type['k]) -> bool {
    match t {
        Type::Exists(_binders, _body) => true,
        Type::Foreach(_f) => true,
        Type::Fn(_f) => true,
        _ => false,
    }
}

forall 'k.
fn members_text(&cx: Cx!['k], kind: Slice[u8, 'static], members: Seq[Member['k], 'k], depth: usize) -> Text['k] {
    if members.is_empty(&cx) {
        return Out::new(&cx).put(&cx, kind).put(&cx, " {}").done(&cx);
    }
    let rows: Seq[Text['k], 'k] = Seq::new(&cx);
    var i = 0usize;
    while i < members.len(&cx) {
        rows.push(&cx, Out::new(&cx).add(&cx, indentation(&cx, depth + 1usize)).add(&cx, members.get(&cx, i).name).put(&cx, ": ")
            .add(&cx, type_text(&cx, members.get(&cx, i).type, depth + 1usize)).put(&cx, ";").done(&cx));
        i = i + 1usize;
    }
    Out::new(&cx).put(&cx, kind).put(&cx, " {\n").add(&cx, joined(&cx, rows, "\n")).put(&cx, "\n").add(&cx, indentation(&cx, depth)).put(&cx, "}").done(&cx)
}

forall 'k.
fn type_text(&cx: Cx!['k], ty: Type['k], depth: usize) -> Text['k] {
    match ty {
        Type::Prim(name) => name,
        Type::Named(name, args) => if args.is_empty(&cx) { name } else { name.concat(&cx, arguments(&cx, args, depth)) },
        Type::Never => text(&cx, "Never"),
        Type::Ignored => text(&cx, "_"),
        Type::Skolem(label) => brand(&cx, label),
        Type::Brand(witness) => Out::new(&cx).put(&cx, "Brand[").add(&cx, type_text(&cx, witness.get(&cx), depth)).put(&cx, "]").done(&cx),
        Type::Ptr(inner) => {
            let t = type_text(&cx, inner.get(&cx), depth);
            if is_binder_type(inner.get(&cx)) { Out::new(&cx).put(&cx, "*(").add(&cx, t).put(&cx, ")").done(&cx) } else { Out::new(&cx).put(&cx, "*").add(&cx, t).done(&cx) }
        },
        Type::Tuple(elems) => {
            if elems.is_empty(&cx) {
                text(&cx, "unit")
            } else {
                Out::new(&cx).put(&cx, "(").add(&cx, joined(&cx, type_texts(&cx, elems, depth), ", ")).put(&cx, if elems.len(&cx) == 1usize { "," } else { "" }).put(&cx, ")").done(&cx)
            }
        },
        Type::Array(elem, length) => Out::new(&cx).put(&cx, "[").add(&cx, type_text(&cx, elem.get(&cx), depth)).put(&cx, "; ").u64(&cx, length).put(&cx, "]").done(&cx),
        Type::Struct(fields) => members_text(&cx, "struct", fields, depth),
        Type::Enum(variants) => members_text(&cx, "enum", variants, depth),
        Type::Exists(binders, body) => Out::new(&cx).put(&cx, "exists ").add(&cx, brands(&cx, binders)).put(&cx, ". ").add(&cx, type_text(&cx, body.get(&cx), depth)).done(&cx),
        Type::Foreach(f) => {
            let inferred: Seq[Text['k], 'k] = match f.source.get(&cx) {
                Type::Foreach(source) => {
                    let names = Seq::one(&cx, source.binder);
                    names.append(&cx, source.retained);
                    names
                },
                _ => Seq::new(&cx),
            };
            let retained = if f.retained.same(&cx, inferred) {
                text(&cx, "")
            } else {
                Out::new(&cx).put(&cx, " retain (").add(&cx, joined(&cx, f.retained, ", ")).put(&cx, ")").done(&cx)
            };
            Out::new(&cx).put(&cx, "foreach ").put(&cx, if f.indirect { "*" } else { "" }).add(&cx, f.binder).add(&cx, retained).put(&cx, " of ")
                .add(&cx, type_text(&cx, f.source.get(&cx), depth)).put(&cx, " => ").add(&cx, type_text(&cx, f.body.get(&cx), depth)).done(&cx)
        },
        Type::Fn(f) => {
            let modes: Seq[Text['k], 'k] = Seq::new(&cx);
            var i = 0usize;
            while i < f.params.len(&cx) {
                modes.push(&cx, Out::new(&cx).put(&cx, if f.places.has(&cx, i) { "&" } else { "" }).add(&cx, type_text(&cx, f.params.get(&cx, i), depth)).done(&cx));
                i = i + 1usize;
            }
            Out::new(&cx).add(&cx, quantifier(&cx, f.quantified, Seq::new(&cx))).put(&cx, if f.is_unsafe { "unsafe " } else { "" }).put(&cx, "fn(")
                .add(&cx, joined(&cx, modes, ", ")).put(&cx, ") -> ").add(&cx, type_text(&cx, f.ret.get(&cx), depth)).done(&cx)
        },
        Type::Meta(_m) => kurs_error(&cx, text(&cx, "unsupported readable KURS type: an inference variable"), no_pos()),
    }
}

forall 'k.
fn edge_text(&cx: Cx!['k], edge: Edge['k]) -> Text['k] {
    Out::new(&cx).add(&cx, edge.target).add(&cx, arguments(&cx, edge.tys, 0usize)).put(&cx, "(").add(&cx, joined(&cx, edge.args, ", ")).put(&cx, ")").done(&cx)
}

forall 'k.
fn instruction_text(&cx: Cx!['k], instr: Instr['k], depth: usize, omit_unit: bool, counter: Fresh['k]) -> Text['k] {
    let op = instr.op;
    let args = instr.args;
    let ty = match instr.ty {
        Option::Some(t) => type_text(&cx, t, depth),
        Option::None => text(&cx, ""),
    };
    let literal = match instr.lit {
        Option::Some(l) => l,
        Option::None => text(&cx, ""),
    };
    let lhs = if instr.lhs.len(&cx) == 1usize { instr.lhs.get(&cx, 0usize) } else { Out::new(&cx).put(&cx, "(").add(&cx, joined(&cx, instr.lhs, ", ")).put(&cx, ")").done(&cx) };
    let prefix = if instr.is_unsafe { text(&cx, "unsafe ") } else { text(&cx, "") };
    if op.is(&cx, "open") {
        let binding = if omit_unit && args.get(&cx, 0usize).starts_with(&cx, text(&cx, "&")) { text(&cx, "") } else { lhs.concat(&cx, text(&cx, " = ")) };
        return Out::new(&cx).add(&cx, prefix).put(&cx, "exists ").add(&cx, brands(&cx, instr.binders)).put(&cx, ". ").add(&cx, binding).put(&cx, "open ").add(&cx, args.get(&cx, 0usize)).put(&cx, ";").done(&cx);
    }
    let rhs = if op.is(&cx, "pack") {
        let (binders, body) = match instr.ty {
            Option::Some(t) => match t {
                Type::Exists(binders, body) => (binders, body.get(&cx)),
                _ => kurs_error(&cx, text(&cx, "unsupported readable instruction: a pack of a type that is not a package"), no_pos()),
            },
            Option::None => kurs_error(&cx, text(&cx, "unsupported readable instruction: a pack without its type"), no_pos()),
        };
        let sub: Map[Text['k], Type['k], 'k] = Map::new(&cx);
        var i = 0usize;
        while i < binders.len(&cx) && i < instr.tys.len(&cx) {
            sub.set(&cx, binders.get(&cx, i), instr.tys.get(&cx, i));
            i = i + 1usize;
        }
        let payload = subst(&cx, body, sub, counter);
        Out::new(&cx).put(&cx, "pack ").add(&cx, joined(&cx, type_texts(&cx, instr.tys, 0usize), ", ")).put(&cx, ". ").add(&cx, args.get(&cx, 0usize)).put(&cx, " as ")
            .add(&cx, type_text(&cx, payload, depth)).done(&cx)
    } else if op.is(&cx, "call") || op.is(&cx, "fn") {
        let out = Out::new(&cx).add(&cx, op).put(&cx, " ").add(&cx, args.get(&cx, 0usize)).add(&cx, arguments(&cx, instr.tys, depth));
        if op.is(&cx, "call") {
            let unit = out.put(&cx, "(").add(&cx, joined(&cx, args.from(&cx, 1usize), ", ")).put(&cx, ")");
        }
        out.done(&cx)
    } else if op.is(&cx, "trait_call") {
        Out::new(&cx).put(&cx, "trait_call ").add(&cx, args.get(&cx, 0usize)).add(&cx, arguments(&cx, instr.tys, depth)).put(&cx, "::").add(&cx, args.get(&cx, 1usize))
            .put(&cx, "(").add(&cx, joined(&cx, args.from(&cx, 2usize), ", ")).put(&cx, ")").done(&cx)
    } else if op.is(&cx, "foreach") {
        let f = match instr.ty {
            Option::Some(t) => match t {
                Type::Foreach(f) => f,
                _ => kurs_error(&cx, text(&cx, "unsupported readable instruction: a foreach of a type that is not a transform"), no_pos()),
            },
            Option::None => kurs_error(&cx, text(&cx, "unsupported readable instruction: a foreach without its type"), no_pos()),
        };
        Out::new(&cx).put(&cx, "foreach ").put(&cx, if f.indirect { "*" } else { "" }).add(&cx, f.binder).put(&cx, " of ").add(&cx, args.get(&cx, 0usize)).put(&cx, " : ")
            .add(&cx, type_text(&cx, f.source.get(&cx), depth)).put(&cx, " => ").add(&cx, type_text(&cx, f.body.get(&cx), depth))
            .put(&cx, " using ").add(&cx, args.get(&cx, 1usize)).add(&cx, arguments(&cx, instr.tys, depth)).put(&cx, "(").add(&cx, joined(&cx, args.from(&cx, 2usize), ", ")).put(&cx, ")").done(&cx)
    } else {
        let operands: Seq[Text['k], 'k] = if op.is(&cx, "const") {
            Seq::two(&cx, ty, literal)
        } else if op.is(&cx, "construct") || op.is(&cx, "destruct") || op.is(&cx, "variant_tag") {
            let out = Seq::one(&cx, ty);
            out.append(&cx, args);
            out
        } else if op.is(&cx, "construct_variant") {
            let out = Seq::two(&cx, ty, literal);
            out.append(&cx, args);
            out
        } else if op.is(&cx, "builtin::int_cast") || op.is(&cx, "builtin::unsafe::cast") {
            let out = args.copy(&cx);
            out.push(&cx, ty);
            out
        } else if op.is(&cx, "alloca") || op.is(&cx, "builtin::sizeof") {
            Seq::one(&cx, ty)
        } else if instr.lit.is_some() {
            let out = Seq::one(&cx, literal);
            out.append(&cx, args);
            out
        } else if instr.ty.is_some() || !instr.tys.is_empty(&cx) || !instr.binders.is_empty(&cx) {
            kurs_error(&cx, Out::new(&cx).put(&cx, "unsupported readable instruction metadata: ").add(&cx, op).done(&cx), no_pos())
        } else {
            args
        };
        if operands.is_empty(&cx) { op } else { Out::new(&cx).add(&cx, op).put(&cx, " ").add(&cx, joined(&cx, operands, ", ")).done(&cx) }
    };
    Out::new(&cx).add(&cx, prefix).add(&cx, lhs).put(&cx, " = ").add(&cx, rhs).put(&cx, ";").done(&cx)
}

forall 'k.
fn terminator_text(&cx: Cx!['k], term: Terminator['k]) -> Text['k] {
    match term {
        Terminator::Ret(value, _pos) => Out::new(&cx).put(&cx, "return ").add(&cx, value).put(&cx, ";").done(&cx),
        Terminator::Jmp(edge, _pos) => Out::new(&cx).put(&cx, "jump ").add(&cx, edge_text(&cx, edge)).put(&cx, ";").done(&cx),
        Terminator::Jnz(cond, then, other, _pos) => Out::new(&cx).put(&cx, "branch ").add(&cx, cond).put(&cx, ", ").add(&cx, edge_text(&cx, then)).put(&cx, ", ")
            .add(&cx, edge_text(&cx, other)).put(&cx, ";").done(&cx),
        Terminator::Switch(scrutinee, ty, arms, _pos) => {
            let lines = Seq::one(&cx, Out::new(&cx).put(&cx, "switch ").add(&cx, scrutinee).put(&cx, " : ").add(&cx, type_text(&cx, ty, 0usize)).put(&cx, " {").done(&cx));
            var i = 0usize;
            while i < arms.len(&cx) {
                lines.push(&cx, Out::new(&cx).put(&cx, "    ").add(&cx, arms.get(&cx, i).variant).put(&cx, " => ").add(&cx, edge_text(&cx, arms.get(&cx, i).edge)).put(&cx, ";").done(&cx));
                i = i + 1usize;
            }
            lines.push(&cx, text(&cx, "}"));
            joined(&cx, lines, "\n")
        },
        Terminator::Unreachable(_pos) => text(&cx, "unreachable;"),
    }
}

// `t` as a JSON string with only ASCII characters, as Python's `json.dumps` writes it.
forall 'k.
fn json_string(&cx: Cx!['k], t: Text['k]) -> Text['k] {
    let out = Out::new(&cx).put(&cx, "\"");
    var i = 0usize;
    while i < t.len() {
        let b = t.byte(&cx, i);
        let (code, count) = decode(&cx, t, i);
        if b == b'"' {
            let unit = out.put(&cx, "\\\"");
        } else if b == b'\\' {
            let unit = out.put(&cx, "\\\\");
        } else if b == b'\n' {
            let unit = out.put(&cx, "\\n");
        } else if b == b'\r' {
            let unit = out.put(&cx, "\\r");
        } else if b == b'\t' {
            let unit = out.put(&cx, "\\t");
        } else if b == 8u8 {
            let unit = out.put(&cx, "\\b");
        } else if b == 12u8 {
            let unit = out.put(&cx, "\\f");
        } else if code >= 32u32 && code < 127u32 {
            let unit = out.byte(&cx, b);
        } else if code >= 65536u32 {
            let v = code - 65536u32;
            let unit = unicode_escape(&cx, unicode_escape(&cx, out, 55296u32 + (v >> 10u32)), 56320u32 + (v & 1023u32));
        } else {
            let unit = unicode_escape(&cx, out, code);
        }
        i = i + count;
    }
    out.put(&cx, "\"").done(&cx)
}

forall 'k.
fn unicode_escape(&cx: Cx!['k], out: Out['k], code: u32) -> Out['k] {
    let digits = text(&cx, "0123456789abcdef");
    out.put(&cx, "\\u").byte(&cx, digits.byte(&cx, ((code >> 12u32) & 15u32) as usize)).byte(&cx, digits.byte(&cx, ((code >> 8u32) & 15u32) as usize))
        .byte(&cx, digits.byte(&cx, ((code >> 4u32) & 15u32) as usize)).byte(&cx, digits.byte(&cx, (code & 15u32) as usize))
}

// The code point of the UTF-8 character at `i` and its length in bytes; a byte that starts no
// well-formed character stands for itself.
forall 'k.
fn decode(&cx: Cx!['k], t: Text['k], i: usize) -> (u32, usize) {
    let b = t.byte(&cx, i);
    let (count, initial) = if b < 128u8 {
        (0usize, b as u32)
    } else if b >= 192u8 && b < 224u8 {
        (1usize, (b & 31u8) as u32)
    } else if b >= 224u8 && b < 240u8 {
        (2usize, (b & 15u8) as u32)
    } else if b >= 240u8 && b < 248u8 {
        (3usize, (b & 7u8) as u32)
    } else {
        (0usize, b as u32)
    };
    if i + count >= t.len() && count > 0usize {
        return (b as u32, 1usize);
    }
    var code = initial;
    var k = 1usize;
    while k <= count {
        let c = t.byte(&cx, i + k);
        if (c & 192u8) != 128u8 {
            return (b as u32, 1usize);
        }
        code = (code << 6u32) | ((c & 63u8) as u32);
        k = k + 1usize;
    }
    (code, count + 1usize)
}

forall 'k.
fn json_list(&cx: Cx!['k], items: Seq[Text['k], 'k]) -> Text['k] {
    let parts: Seq[Text['k], 'k] = Seq::new(&cx);
    var i = 0usize;
    while i < items.len(&cx) {
        parts.push(&cx, json_string(&cx, items.get(&cx, i)));
        i = i + 1usize;
    }
    Out::new(&cx).put(&cx, "[").add(&cx, joined(&cx, parts, ", ")).put(&cx, "]").done(&cx)
}

forall 'k.
fn metadata(&cx: Cx!['k], home: Option[ModuleId['k]], depth: usize) -> Seq[Text['k], 'k] {
    match home {
        Option::Some(m) => Seq::one(&cx, Out::new(&cx).add(&cx, indentation(&cx, depth)).put(&cx, "// owner: package ").usize(&cx, m.package).put(&cx, ", module ")
            .add(&cx, json_list(&cx, m.path)).done(&cx)),
        Option::None => Seq::new(&cx),
    }
}

// `t` without trailing whitespace.
forall 'k.
fn rstrip(&cx: Cx!['k], t: Text['k]) -> Text['k] {
    var end = t.len();
    while end > 0usize && (t.byte(&cx, end - 1usize) == b' ' || t.byte(&cx, end - 1usize) == b'\n' || t.byte(&cx, end - 1usize) == b'\t' || t.byte(&cx, end - 1usize) == b'\r') {
        end = end - 1usize;
    }
    t.slice(0usize, end)
}

forall 'k.
fn bindings_text(&cx: Cx!['k], bindings: Seq[Binding['k], 'k], depth: usize) -> Text['k] {
    let parts: Seq[Text['k], 'k] = Seq::new(&cx);
    var i = 0usize;
    while i < bindings.len(&cx) {
        parts.push(&cx, Out::new(&cx).add(&cx, bindings.get(&cx, i).name).put(&cx, ": ").add(&cx, type_text(&cx, bindings.get(&cx, i).type, depth)).done(&cx));
        i = i + 1usize;
    }
    joined(&cx, parts, ", ")
}

forall 'k.
fn add_all(&cx: Cx!['k], used: Set[Text['k], 'k], names: Seq[Text['k], 'k]) {
    var i = 0usize;
    while i < names.len(&cx) {
        used.add(&cx, names.get(&cx, i));
        i = i + 1usize;
    }
}

forall 'k.
fn function_lines(&cx: Cx!['k], fun: Fun['k], depth: usize, counter: Fresh['k]) -> Seq[Text['k], 'k] {
    let indent = indentation(&cx, depth);
    let lines = metadata(&cx, fun.home, depth);
    let quant = quantifier(&cx, fun.params, fun.premises);
    if !quant.is_empty() {
        lines.push(&cx, indent.concat(&cx, rstrip(&cx, quant)));
    }
    let params = bindings_text(&cx, fun.blocks.get(&cx, 0usize).params, depth);
    lines.push(&cx, Out::new(&cx).add(&cx, indent).put(&cx, if fun.is_unsafe { "unsafe " } else { "" }).put(&cx, "fn ").add(&cx, fun.name).put(&cx, "(").add(&cx, params)
        .put(&cx, ") -> ").add(&cx, type_text(&cx, fun.ret, depth)).put(&cx, " {").done(&cx));
    if !fun.locals.is_empty(&cx) {
        lines.push(&cx, indent.concat(&cx, text(&cx, "    locals {")));
        var l = 0usize;
        while l < fun.locals.len(&cx) {
            lines.push(&cx, Out::new(&cx).add(&cx, indent).put(&cx, "        ").add(&cx, fun.locals.get(&cx, l).name).put(&cx, ": ")
                .add(&cx, type_text(&cx, fun.locals.get(&cx, l).type, depth + 2usize)).put(&cx, ";").done(&cx));
            l = l + 1usize;
        }
        lines.push(&cx, indent.concat(&cx, text(&cx, "    }")));
    }
    var index = 0usize;
    while index < fun.blocks.len(&cx) {
        let block = fun.blocks.get(&cx, index);
        let block_brands = if block.brands.is_empty(&cx) { text(&cx, "") } else { Out::new(&cx).put(&cx, "[").add(&cx, brands(&cx, block.brands)).put(&cx, "]").done(&cx) };
        let block_params = bindings_text(&cx, block.params, depth + 1usize);
        let header = if index == 0usize {
            text(&cx, "entry")
        } else {
            Out::new(&cx).put(&cx, "block ").add(&cx, block.label).add(&cx, block_brands).put(&cx, "(").add(&cx, block_params).put(&cx, ")").done(&cx)
        };
        if index == 0usize && !block.label.is(&cx, "entry") {
            lines.push(&cx, Out::new(&cx).add(&cx, indent).put(&cx, "    // entry label: ").add(&cx, block.label).done(&cx));
        }
        lines.push(&cx, Out::new(&cx).add(&cx, indent).put(&cx, "    ").add(&cx, header).put(&cx, " {").done(&cx));
        if !block.empty.is_empty(&cx) || !block.known.is_empty(&cx) || !block.opened.is_empty(&cx) {
            lines.push(&cx, indent.concat(&cx, text(&cx, "        state {")));
            var o = 0usize;
            while o < block.opened.len(&cx) {
                lines.push(&cx, Out::new(&cx).add(&cx, indent).put(&cx, "            open ").add(&cx, brands(&cx, block.opened.get(&cx, o).brands)).put(&cx, ". ")
                    .add(&cx, block.opened.get(&cx, o).path).put(&cx, ";").done(&cx));
                o = o + 1usize;
            }
            var e = 0usize;
            while e < block.empty.len(&cx) {
                lines.push(&cx, Out::new(&cx).add(&cx, indent).put(&cx, "            empty ").add(&cx, block.empty.get(&cx, e)).put(&cx, ";").done(&cx));
                e = e + 1usize;
            }
            var k = 0usize;
            while k < block.known.len(&cx) {
                lines.push(&cx, Out::new(&cx).add(&cx, indent).put(&cx, "            known ").add(&cx, block.known.get(&cx, k).path).put(&cx, " = ")
                    .add(&cx, block.known.get(&cx, k).variant).put(&cx, ";").done(&cx));
                k = k + 1usize;
            }
            lines.push(&cx, indent.concat(&cx, text(&cx, "        }")));
        }
        // Preserve a unit binding if later code actually refers to it.
        let used: Set[Text['k], 'k] = Set::new(&cx);
        var u = 0usize;
        while u < block.instrs.len(&cx) {
            add_all(&cx, used, block.instrs.get(&cx, u).args);
            u = u + 1usize;
        }
        match block.term {
            Terminator::Ret(value, _pos) => used.add(&cx, value),
            Terminator::Jmp(edge, _pos) => add_all(&cx, used, edge.args),
            Terminator::Jnz(cond, then, other, _pos) => {
                used.add(&cx, cond);
                add_all(&cx, used, then.args);
                add_all(&cx, used, other.args);
            },
            Terminator::Switch(scrutinee, _ty, arms, _pos) => {
                used.add(&cx, scrutinee);
                var a = 0usize;
                while a < arms.len(&cx) {
                    add_all(&cx, used, arms.get(&cx, a).edge.args);
                    a = a + 1usize;
                }
            },
            Terminator::Unreachable(_pos) => (),
        };
        var i = 0usize;
        while i < block.instrs.len(&cx) {
            let instr = block.instrs.get(&cx, i);
            var any = false;
            var n = 0usize;
            while n < instr.lhs.len(&cx) {
                if used.has(&cx, instr.lhs.get(&cx, n)) {
                    any = true;
                }
                n = n + 1usize;
            }
            lines.push(&cx, Out::new(&cx).add(&cx, indent).put(&cx, "        ").add(&cx, instruction_text(&cx, instr, depth + 2usize, !any, counter)).done(&cx));
            i = i + 1usize;
        }
        let term_lines = terminator_text(&cx, block.term).split(&cx, text(&cx, "\n"));
        var t = 0usize;
        while t < term_lines.len(&cx) {
            lines.push(&cx, Out::new(&cx).add(&cx, indent).put(&cx, "        ").add(&cx, term_lines.get(&cx, t)).done(&cx));
            t = t + 1usize;
        }
        lines.push(&cx, indent.concat(&cx, text(&cx, "    }")));
        index = index + 1usize;
    }
    lines.push(&cx, indent.concat(&cx, text(&cx, "}")));
    lines
}

forall 'k.
fn initializer_text(&cx: Cx!['k], form: Form['k]) -> Text['k] {
    if form.is_str() {
        return json_string(&cx, form.text);
    }
    if form.is_list() {
        let parts: Seq[Text['k], 'k] = Seq::new(&cx);
        var i = 0usize;
        while i < form.len(&cx) {
            parts.push(&cx, initializer_text(&cx, form.at(&cx, i)));
            i = i + 1usize;
        }
        return Out::new(&cx).put(&cx, "[").add(&cx, joined(&cx, parts, ", ")).put(&cx, "]").done(&cx);
    }
    form.text
}

// Render all declarations without changing or checking the program.
forall 'k.
fn emit_kurs(&cx: Cx!['k], program: Program['k], counter: Fresh['k]) -> Text['k] {
    let sections: Seq[Text['k], 'k] = Seq::new(&cx);
    let decls = program.types.values(&cx);
    var d = 0usize;
    while d < decls.len(&cx) {
        let decl = decls.get(&cx, d);
        let lines = metadata(&cx, decl.home, 0usize);
        match decl.exposure {
            Option::Some(exposure) => {
                let mode = match exposure.mode {
                    ExposureMode::Owner => text(&cx, "owner"),
                    ExposureMode::Within => text(&cx, "within"),
                };
                lines.push(&cx, Out::new(&cx).put(&cx, "// exposure: ").add(&cx, mode).put(&cx, ", package ").usize(&cx, exposure.home.package).put(&cx, ", module ")
                    .add(&cx, json_list(&cx, exposure.home.path)).done(&cx));
            },
            Option::None => (),
        };
        let quant = quantifier(&cx, decl.params, decl.premises);
        if !quant.is_empty() {
            lines.push(&cx, rstrip(&cx, quant));
        }
        lines.push(&cx, Out::new(&cx).put(&cx, "type ").add(&cx, decl.name).put(&cx, if decl.linear { "!" } else { "" }).put(&cx, " = ").add(&cx, type_text(&cx, decl.body, 0usize))
            .put(&cx, ";").done(&cx));
        sections.push(&cx, joined(&cx, lines, "\n"));
        d = d + 1usize;
    }
    let externs = program.externs.values(&cx);
    var e = 0usize;
    while e < externs.len(&cx) {
        let external = externs.get(&cx, e);
        let ty = match external.ret {
            Option::Some(r) => type_text(&cx, r, 0usize),
            Option::None => kurs_error(&cx, text(&cx, "unsupported readable extern: an extern without a type"), no_pos()),
        };
        match external.ptypes {
            Option::None => sections.push(&cx, Out::new(&cx).put(&cx, "extern val ").add(&cx, external.name).put(&cx, ": ").add(&cx, ty).put(&cx, ";").done(&cx)),
            Option::Some(ptypes) => sections.push(&cx, Out::new(&cx).put(&cx, "extern fn ").add(&cx, external.name).put(&cx, "(")
                .add(&cx, joined(&cx, type_texts(&cx, ptypes, 0usize), ", ")).put(&cx, ") -> ").add(&cx, ty).put(&cx, ";").done(&cx)),
        };
        e = e + 1usize;
    }
    let datas = program.datas.values(&cx);
    var a = 0usize;
    while a < datas.len(&cx) {
        let data = datas.get(&cx, a);
        let lines = metadata(&cx, data.home, 0usize);
        lines.push(&cx, Out::new(&cx).put(&cx, "data ").add(&cx, data.name).put(&cx, ": ").add(&cx, type_text(&cx, data.ty, 0usize)).put(&cx, " = ")
            .add(&cx, initializer_text(&cx, data.init)).put(&cx, ";").done(&cx));
        sections.push(&cx, joined(&cx, lines, "\n"));
        a = a + 1usize;
    }
    let traits = program.traits.values(&cx);
    var t = 0usize;
    while t < traits.len(&cx) {
        let tr = traits.get(&cx, t);
        let names: Seq[Text['k], 'k] = Seq::new(&cx);
        let bounds: Seq[Text['k], 'k] = Seq::new(&cx);
        var p = 0usize;
        while p < tr.params.len(&cx) {
            let kind = if tr.param_kinds.is_empty(&cx) { Kind::Any } else { tr.param_kinds.get(&cx, p) };
            names.push(&cx, if is_brand(kind) { brand(&cx, tr.params.get(&cx, p)) } else { tr.params.get(&cx, p) });
            if is_copy(kind) {
                bounds.push(&cx, Out::new(&cx).put(&cx, "Copy[").add(&cx, tr.params.get(&cx, p)).put(&cx, "]").done(&cx));
            }
            p = p + 1usize;
        }
        let header = Out::new(&cx).put(&cx, "trait ").add(&cx, tr.name).put(&cx, "[").add(&cx, joined(&cx, names, ", ")).put(&cx, "]");
        if !bounds.is_empty(&cx) {
            let unit = header.put(&cx, " where ").add(&cx, joined(&cx, bounds, ", "));
        }
        let lines = metadata(&cx, tr.home, 0usize);
        lines.push(&cx, header.put(&cx, " {").done(&cx));
        var m = 0usize;
        while m < tr.methods.len(&cx) {
            let method = tr.methods.get(&cx, m);
            let modes: Seq[Text['k], 'k] = Seq::new(&cx);
            var i = 0usize;
            while i < method.ptypes.len(&cx) {
                modes.push(&cx, Out::new(&cx).put(&cx, if method.places.has(&cx, i) { "&" } else { "" }).add(&cx, type_text(&cx, method.ptypes.get(&cx, i), 1usize)).done(&cx));
                i = i + 1usize;
            }
            lines.push(&cx, Out::new(&cx).put(&cx, "    ").put(&cx, if method.is_unsafe { "unsafe " } else { "" }).put(&cx, "fn ").add(&cx, method.name).put(&cx, "(")
                .add(&cx, joined(&cx, modes, ", ")).put(&cx, ") -> ").add(&cx, type_text(&cx, method.ret, 1usize)).put(&cx, ";").done(&cx));
            m = m + 1usize;
        }
        lines.push(&cx, text(&cx, "}"));
        sections.push(&cx, joined(&cx, lines, "\n"));
        t = t + 1usize;
    }
    let groups = program.instances.values(&cx);
    var g = 0usize;
    while g < groups.len(&cx) {
        let insts = groups.get(&cx, g);
        var i = 0usize;
        while i < insts.len(&cx) {
            let inst = insts.get(&cx, i);
            let lines = metadata(&cx, inst.home, 0usize);
            let quant = quantifier(&cx, inst.params, inst.premises);
            if !quant.is_empty() {
                lines.push(&cx, rstrip(&cx, quant));
            }
            lines.push(&cx, Out::new(&cx).put(&cx, "instance ").add(&cx, inst.trait_name).add(&cx, arguments(&cx, inst.head, 0usize)).put(&cx, " {").done(&cx));
            var m = 0usize;
            while m < inst.methods.len(&cx) {
                lines.append(&cx, function_lines(&cx, inst.methods.get(&cx, m), 1usize, counter));
                m = m + 1usize;
            }
            lines.push(&cx, text(&cx, "}"));
            sections.push(&cx, joined(&cx, lines, "\n"));
            i = i + 1usize;
        }
        g = g + 1usize;
    }
    let funs = program.funs.values(&cx);
    var f = 0usize;
    while f < funs.len(&cx) {
        sections.push(&cx, joined(&cx, function_lines(&cx, funs.get(&cx, f), 0usize, counter), "\n"));
        f = f + 1usize;
    }
    Out::new(&cx).add(&cx, joined(&cx, sections, "\n\n")).put(&cx, "\n").done(&cx)
}
