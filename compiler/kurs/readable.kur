// Readable rendering of typed KURS; the interchange reader is `kurs::serial`.
//
// This is a display format, not an alternate checker or a reconstruction from C.

use std::collections::arena_vec::ArenaVec;
use std::collections::arena_map::ArenaSet;
use std::raw::Span;
use std::arena::{Domain!, concat};
use std::buffer::Buffer!;
use std::fmt::Writer;
use package::kurs::core::{Binding, Edge, ExposureMode, Fun, Instr, Kind, Member, ModuleId, Param, Premise, Program, Terminator, Type};
use package::kurs::core as C;
use package::kurs::sexpr::Form;
use package::syntax::ast::no_pos;
use package::types::ops::kurs_error;
use std::option::Option;
use std::slice::Slice;

forall 'k.
fn brand(&cx: Domain!['k], name: Span['k]) -> Span['k] {
    Buffer!::new().put("'").write(&cx, name).save(&cx)
}

fn is_brand(kind: Kind) -> bool {
    C::same_kind(kind, Kind::Brand)
}

fn is_copy(kind: Kind) -> bool {
    C::same_kind(kind, Kind::Copy)
}

forall 'k.
fn brands(&cx: Domain!['k], names: ArenaVec[Span['k], 'k]) -> Span['k] {
    let out: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
    var i = 0usize;
    while i < names.len(&cx) {
        out.push(&cx, brand(&cx, names.at(&cx, i)));
        i = i + 1usize;
    }
    out.join(&cx, ", ")
}

forall 'k.
fn indentation(&cx: Domain!['k], depth: usize) -> Span['k] {
    var out = Buffer!::new();
    var i = 0usize;
    while i < depth {
        out = out.put("    ");
        i = i + 1usize;
    }
    out.save(&cx)
}

forall 'k.
fn type_texts(&cx: Domain!['k], types: ArenaVec[Type['k], 'k], depth: usize) -> ArenaVec[Span['k], 'k] {
    let out: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
    var i = 0usize;
    while i < types.len(&cx) {
        out.push(&cx, type_text(&cx, types.at(&cx, i), depth));
        i = i + 1usize;
    }
    out
}

forall 'k.
fn arguments(&cx: Domain!['k], types: ArenaVec[Type['k], 'k], depth: usize) -> Span['k] {
    if types.is_empty(&cx) {
        Span::from_static(&cx, "")
    } else {
        Buffer!::new().put("[").write(&cx, type_texts(&cx, types, depth).join(&cx, ", ")).put("]").save(&cx)
    }
}

forall 'k.
fn premise_text(&cx: Domain!['k], premise: Premise['k]) -> Span['k] {
    Buffer!::new().write(&cx, premise.trait_name).put("[").write(&cx, type_texts(&cx, premise.args, 0usize).join(&cx, ", ")).put("]").save(&cx)
}

forall 'k.
fn quantifier(&cx: Domain!['k], params: ArenaVec[Param['k], 'k], premises: ArenaVec[Premise['k], 'k]) -> Span['k] {
    let names: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
    let bounds: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
    var i = 0usize;
    while i < params.len(&cx) {
        let param = params.at(&cx, i);
        names.push(&cx, if is_brand(param.kind) { brand(&cx, param.name) } else { param.name });
        if is_copy(param.kind) {
            bounds.push(&cx, f"Copy[{param.name}]".write(&cx, Buffer!::new()).save(&cx));
        }
        i = i + 1usize;
    }
    var j = 0usize;
    while j < premises.len(&cx) {
        bounds.push(&cx, premise_text(&cx, premises.at(&cx, j)));
        j = j + 1usize;
    }
    if names.is_empty(&cx) && bounds.is_empty(&cx) {
        return Span::from_static(&cx, "");
    }
    var out = Buffer!::new().put("forall ").write(&cx, names.join(&cx, ", "));
    if !bounds.is_empty(&cx) {
        out = out.put(" where ").write(&cx, bounds.join(&cx, ", "));
    }
    out.put(". ").save(&cx)
}

forall 'k.
fn is_binder_type(t: Type['k]) -> bool {
    match t {
        Exists(_binders, _body) => true,
        Foreach(_f) => true,
        Fn(_f) => true,
        _ => false,
    }
}

forall 'k.
fn members_text(&cx: Domain!['k], kind: Slice[u8, 'static], members: ArenaVec[Member['k], 'k], depth: usize) -> Span['k] {
    if members.is_empty(&cx) {
        return Buffer!::new().put(kind).put(" {}").save(&cx);
    }
    let rows: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
    var i = 0usize;
    while i < members.len(&cx) {
        rows.push(&cx, Buffer!::new().write(&cx, indentation(&cx, depth + 1usize)).write(&cx, members.at(&cx, i).name).put(": ")
            .write(&cx, type_text(&cx, members.at(&cx, i).ty, depth + 1usize)).put(";").save(&cx));
        i = i + 1usize;
    }
    Buffer!::new().put(kind).put(" {\n").write(&cx, rows.join(&cx, "\n")).put("\n").write(&cx, indentation(&cx, depth)).put("}").save(&cx)
}

forall 'k.
fn type_text(&cx: Domain!['k], ty: Type['k], depth: usize) -> Span['k] {
    match ty {
        Prim(name) => name,
        Named(name, args) => if args.is_empty(&cx) { name } else { concat(&cx, name, arguments(&cx, args, depth)) },
        Never => Span::from_static(&cx, "Never"),
        Skolem(label) => brand(&cx, label),
        Brand(witness) => Buffer!::new().put("Brand[").write(&cx, type_text(&cx, witness.copy(&cx), depth)).put("]").save(&cx),
        NonNull(inner) => Buffer!::new().put("NonNull[").write(&cx, type_text(&cx, inner.copy(&cx), depth)).put("]").save(&cx),
        Ptr(inner) => {
            let t = type_text(&cx, inner.copy(&cx), depth);
            if is_binder_type(inner.copy(&cx)) { f"*({t})".write(&cx, Buffer!::new()).save(&cx) } else { Buffer!::new().put("*").write(&cx, t).save(&cx) }
        },
        Tuple(elems) => {
            if elems.is_empty(&cx) {
                Span::from_static(&cx, "unit")
            } else {
                Buffer!::new().put("(").write(&cx, type_texts(&cx, elems, depth).join(&cx, ", ")).put(if elems.len(&cx) == 1usize { "," } else { "" }).put(")").save(&cx)
            }
        },
        Array(elem, length) => Buffer!::new().put("[").write(&cx, type_text(&cx, elem.copy(&cx), depth)).put("; ").put(length).put("]").save(&cx),
        Struct(fields) => members_text(&cx, "struct", fields, depth),
        Enum(variants) => members_text(&cx, "enum", variants, depth),
        Exists(binders, body) => Buffer!::new().put("exists ").write(&cx, brands(&cx, binders)).put(". ").write(&cx, type_text(&cx, body.copy(&cx), depth)).save(&cx),
        Foreach(f) => Buffer!::new().put("foreach ").put(if f.indirect { "*" } else { "" }).write(&cx, f.binder).put(" of ")
            .write(&cx, type_text(&cx, f.source.copy(&cx), depth)).put(" => ").write(&cx, type_text(&cx, f.body.copy(&cx), depth)).save(&cx),
        Fn(f) => {
            let modes: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
            var i = 0usize;
            while i < f.params.len(&cx) {
                modes.push(&cx, Buffer!::new().put(if f.places.contains(&cx, i) { "&" } else { "" }).write(&cx, type_text(&cx, f.params.at(&cx, i), depth)).save(&cx));
                i = i + 1usize;
            }
            Buffer!::new().put(if f.is_unsafe { "unsafe " } else { "" }).put("fn(")
                .write(&cx, modes.join(&cx, ", ")).put(") -> ").write(&cx, type_text(&cx, f.ret.copy(&cx), depth)).save(&cx)
        },
        Meta(_m) => kurs_error(&cx, Span::from_static(&cx, "unsupported readable KURS type: an inference variable"), no_pos()),
    }
}

forall 'k.
fn edge_text(&cx: Domain!['k], edge: Edge['k]) -> Span['k] {
    Buffer!::new().write(&cx, edge.target).write(&cx, arguments(&cx, edge.tys, 0usize)).put("(").write(&cx, edge.args.join(&cx, ", ")).put(")").save(&cx)
}

forall 'k.
fn instruction_text(&cx: Domain!['k], instr: Instr['k], depth: usize, omit_unit: bool) -> Span['k] {
    let op = instr.op;
    let args = instr.args;
    let ty = match instr.ty {
        Some(t) => type_text(&cx, t, depth),
        None => Span::from_static(&cx, ""),
    };
    let literal = match instr.lit {
        Some(l) => l,
        None => Span::from_static(&cx, ""),
    };
    let lhs = if instr.lhs.len(&cx) == 1usize { instr.lhs.at(&cx, 0usize) } else { Buffer!::new().put("(").write(&cx, instr.lhs.join(&cx, ", ")).put(")").save(&cx) };
    let prefix = if instr.is_unsafe { Span::from_static(&cx, "unsafe ") } else { Span::from_static(&cx, "") };
    if op.is(&cx, "open") {
        let binding = if omit_unit && args.at(&cx, 0usize).starts_with(&cx, Span::from_static(&cx, "&")) { Span::from_static(&cx, "") } else { concat(&cx, lhs, Span::from_static(&cx, " = ")) };
        return Buffer!::new().write(&cx, prefix).put("exists ").write(&cx, brands(&cx, instr.binders)).put(". ").write(&cx, binding).put("open ").write(&cx, args.at(&cx, 0usize)).put(";").save(&cx);
    }
    let rhs = if op.is(&cx, "pack") {
        Buffer!::new().put("pack ").write(&cx, type_texts(&cx, instr.tys, 0usize).join(&cx, ", ")).put(". ").write(&cx, args.at(&cx, 0usize)).put(" as ")
            .write(&cx, ty).save(&cx)
    } else if op.is(&cx, "call") || op.is(&cx, "fn") {
        var out = Buffer!::new().write(&cx, op).put(" ").write(&cx, args.at(&cx, 0usize)).write(&cx, arguments(&cx, instr.tys, depth));
        if op.is(&cx, "call") {
            out = out.put("(").write(&cx, args.skip(&cx, 1usize).join(&cx, ", ")).put(")");
        }
        out.save(&cx)
    } else if op.is(&cx, "trait_call") {
        Buffer!::new().put("trait_call ").write(&cx, args.at(&cx, 0usize)).write(&cx, arguments(&cx, instr.tys, depth)).put("::").write(&cx, args.at(&cx, 1usize))
            .put("(").write(&cx, args.skip(&cx, 2usize).join(&cx, ", ")).put(")").save(&cx)
    } else if op.is(&cx, "foreach") {
        let f = match instr.ty {
            Some(t) => match t {
                Foreach(f) => f,
                _ => kurs_error(&cx, Span::from_static(&cx, "unsupported readable instruction: a foreach of a type that is not a transform"), no_pos()),
            },
            None => kurs_error(&cx, Span::from_static(&cx, "unsupported readable instruction: a foreach without its type"), no_pos()),
        };
        Buffer!::new().put("foreach ").put(if f.indirect { "*" } else { "" }).write(&cx, f.binder).put(" of ").write(&cx, args.at(&cx, 0usize)).put(" : ")
            .write(&cx, type_text(&cx, f.source.copy(&cx), depth)).put(" => ").write(&cx, type_text(&cx, f.body.copy(&cx), depth))
            .put(" using ").write(&cx, args.at(&cx, 1usize)).write(&cx, arguments(&cx, instr.tys, depth)).put("(").write(&cx, args.skip(&cx, 2usize).join(&cx, ", ")).put(")").save(&cx)
    } else {
        let operands: ArenaVec[Span['k], 'k] = if op.is(&cx, "const") {
            ArenaVec::two(&cx, ty, literal)
        } else if op.is(&cx, "construct") || op.is(&cx, "destruct") || op.is(&cx, "variant_tag") {
            let out = ArenaVec::one(&cx, ty);
            out.append(&cx, args);
            out
        } else if op.is(&cx, "construct_variant") {
            let out = ArenaVec::two(&cx, ty, literal);
            out.append(&cx, args);
            out
        } else if op.is(&cx, "int_cast") || op.is(&cx, "float_cast") || op.is(&cx, "cast") || op.is(&cx, "to_ptr") {
            let out = args.clone(&cx);
            out.push(&cx, ty);
            out
        } else if op.is(&cx, "alloca") || op.is(&cx, "sizeof") {
            ArenaVec::one(&cx, ty)
        } else if instr.lit.is_some() {
            let out = ArenaVec::one(&cx, literal);
            out.append(&cx, args);
            out
        } else if instr.ty.is_some() || !instr.tys.is_empty(&cx) || !instr.binders.is_empty(&cx) {
            kurs_error(&cx, Buffer!::new().put("unsupported readable instruction metadata: ").write(&cx, op).save(&cx), no_pos())
        } else {
            args
        };
        if operands.is_empty(&cx) { op } else { Buffer!::new().write(&cx, op).put(" ").write(&cx, operands.join(&cx, ", ")).save(&cx) }
    };
    f"{prefix}{lhs} = {rhs};".write(&cx, Buffer!::new()).save(&cx)
}

forall 'k.
fn terminator_text(&cx: Domain!['k], term: Terminator['k]) -> Span['k] {
    match term {
        Ret(value, _pos) => f"return {value};".write(&cx, Buffer!::new()).save(&cx),
        Jmp(edge, _pos) => Buffer!::new().put("jump ").write(&cx, edge_text(&cx, edge)).put(";").save(&cx),
        Jnz(cond, then, other, _pos) => Buffer!::new().put("branch ").write(&cx, cond).put(", ").write(&cx, edge_text(&cx, then)).put(", ")
            .write(&cx, edge_text(&cx, other)).put(";").save(&cx),
        Switch(scrutinee, ty, arms, _pos) => {
            let lines = ArenaVec::one(&cx, Buffer!::new().put("switch ").write(&cx, scrutinee).put(" : ").write(&cx, type_text(&cx, ty, 0usize)).put(" {").save(&cx));
            var i = 0usize;
            while i < arms.len(&cx) {
                lines.push(&cx, Buffer!::new().put("    ").write(&cx, arms.at(&cx, i).variant).put(" => ").write(&cx, edge_text(&cx, arms.at(&cx, i).edge)).put(";").save(&cx));
                i = i + 1usize;
            }
            lines.push(&cx, Span::from_static(&cx, "}"));
            lines.join(&cx, "\n")
        },
        Unreachable(_pos) => Span::from_static(&cx, "unreachable;"),
    }
}

// `t` as a JSON string with only ASCII characters, as Python's `json.dumps` writes it.
forall 'k.
fn json_string(&cx: Domain!['k], t: Span['k]) -> Span['k] {
    var out = Buffer!::new().put("\"");
    var i = 0usize;
    while i < t.len() {
        let b = t.byte_or_zero(&cx, i);
        let (code, count) = decode(&cx, t, i);
        if b == b'"' {
            out = out.put("\\\"");
        } else if b == b'\\' {
            out = out.put("\\\\");
        } else if b == b'\n' {
            out = out.put("\\n");
        } else if b == b'\r' {
            out = out.put("\\r");
        } else if b == b'\t' {
            out = out.put("\\t");
        } else if b == 8u8 {
            out = out.put("\\b");
        } else if b == 12u8 {
            out = out.put("\\f");
        } else if code >= 32u32 && code < 127u32 {
            out = out.write_byte(b);
        } else if code >= 65536u32 {
            let v = code - 65536u32;
            out = unicode_escape(&cx, unicode_escape(&cx, out, 55296u32 + (v >> 10u32)), 56320u32 + (v & 1023u32));
        } else {
            out = unicode_escape(&cx, out, code);
        }
        i = i + count;
    }
    out.put("\"").save(&cx)
}

forall 'k.
fn unicode_escape(&cx: Domain!['k], out: Buffer!, code: u32) -> Buffer! {
    let digits = Span::from_static(&cx, "0123456789abcdef");
    out.put("\\u").write_byte(digits.byte_or_zero(&cx, ((code >> 12u32) & 15u32) as usize)).write_byte(digits.byte_or_zero(&cx, ((code >> 8u32) & 15u32) as usize))
        .write_byte(digits.byte_or_zero(&cx, ((code >> 4u32) & 15u32) as usize)).write_byte(digits.byte_or_zero(&cx, (code & 15u32) as usize))
}

// The code point of the UTF-8 character at `i` and its length in bytes; a byte that starts no
// well-formed character stands for itself.
forall 'k.
fn decode(&cx: Domain!['k], t: Span['k], i: usize) -> (u32, usize) {
    let b = t.byte_or_zero(&cx, i);
    let (count, initial) = if b < 128u8 {
        (0usize, b as u32)
    } else if b >= 192u8 && b < 224u8 {
        (1usize, (b & 31u8) as u32)
    } else if b >= 224u8 && b < 240u8 {
        (2usize, (b & 15u8) as u32)
    } else if b >= 240u8 && b < 248u8 {
        (3usize, (b & 7u8) as u32)
    } else {
        (0usize, b as u32)
    };
    if i + count >= t.len() && count > 0usize {
        return (b as u32, 1usize);
    }
    var code = initial;
    var k = 1usize;
    while k <= count {
        let c = t.byte_or_zero(&cx, i + k);
        if (c & 192u8) != 128u8 {
            return (b as u32, 1usize);
        }
        code = (code << 6u32) | ((c & 63u8) as u32);
        k = k + 1usize;
    }
    (code, count + 1usize)
}

forall 'k.
fn json_list(&cx: Domain!['k], items: ArenaVec[Span['k], 'k]) -> Span['k] {
    let parts: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
    var i = 0usize;
    while i < items.len(&cx) {
        parts.push(&cx, json_string(&cx, items.at(&cx, i)));
        i = i + 1usize;
    }
    Buffer!::new().put("[").write(&cx, parts.join(&cx, ", ")).put("]").save(&cx)
}

forall 'k.
fn metadata(&cx: Domain!['k], home: Option[ModuleId['k]], depth: usize) -> ArenaVec[Span['k], 'k] {
    match home {
        Some(m) => ArenaVec::one(&cx, Buffer!::new().write(&cx, indentation(&cx, depth)).put("// owner: package ").put(m.package).put(", module ")
            .write(&cx, json_list(&cx, m.path)).save(&cx)),
        None => ArenaVec::new(&cx),
    }
}

forall 'k.
fn bindings_text(&cx: Domain!['k], bindings: ArenaVec[Binding['k], 'k], depth: usize) -> Span['k] {
    let parts: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
    var i = 0usize;
    while i < bindings.len(&cx) {
        parts.push(&cx, Buffer!::new().write(&cx, bindings.at(&cx, i).name).put(": ").write(&cx, type_text(&cx, bindings.at(&cx, i).ty, depth)).save(&cx));
        i = i + 1usize;
    }
    parts.join(&cx, ", ")
}

forall 'k.
fn function_lines(&cx: Domain!['k], fun: Fun['k], depth: usize) -> ArenaVec[Span['k], 'k] {
    let indent = indentation(&cx, depth);
    let lines = metadata(&cx, fun.home, depth);
    let quant = quantifier(&cx, fun.params, fun.premises);
    if !quant.is_empty() {
        lines.push(&cx, concat(&cx, indent, quant.trim_end(&cx)));
    }
    let params = bindings_text(&cx, fun.blocks.at(&cx, 0usize).params, depth);
    lines.push(&cx, Buffer!::new().write(&cx, indent).put(if fun.is_unsafe { "unsafe " } else { "" }).put("fn ").write(&cx, fun.name).put("(").write(&cx, params)
        .put(") -> ").write(&cx, type_text(&cx, fun.ret, depth)).put(" {").save(&cx));
    if !fun.locals.is_empty(&cx) {
        lines.push(&cx, concat(&cx, indent, Span::from_static(&cx, "    locals {")));
        var l = 0usize;
        while l < fun.locals.len(&cx) {
            lines.push(&cx, Buffer!::new().write(&cx, indent).put("        ").write(&cx, fun.locals.at(&cx, l).name).put(": ")
                .write(&cx, type_text(&cx, fun.locals.at(&cx, l).ty, depth + 2usize)).put(";").save(&cx));
            l = l + 1usize;
        }
        lines.push(&cx, concat(&cx, indent, Span::from_static(&cx, "    }")));
    }
    var index = 0usize;
    while index < fun.blocks.len(&cx) {
        let block = fun.blocks.at(&cx, index);
        let block_brands = if block.brands.is_empty(&cx) { Span::from_static(&cx, "") } else { Buffer!::new().put("[").write(&cx, brands(&cx, block.brands)).put("]").save(&cx) };
        let block_params = bindings_text(&cx, block.params, depth + 1usize);
        let header = if index == 0usize {
            Span::from_static(&cx, "entry")
        } else {
            f"block {block.label}{block_brands}({block_params})".write(&cx, Buffer!::new()).save(&cx)
        };
        if index == 0usize && !block.label.is(&cx, "entry") {
            lines.push(&cx, f"{indent}    // entry label: {block.label}".write(&cx, Buffer!::new()).save(&cx));
        }
        lines.push(&cx, f"{indent}    {header} {{".write(&cx, Buffer!::new()).save(&cx));
        if !block.empty.is_empty(&cx) || !block.known.is_empty(&cx) || !block.opened.is_empty(&cx) {
            lines.push(&cx, concat(&cx, indent, Span::from_static(&cx, "        state {")));
            var o = 0usize;
            while o < block.opened.len(&cx) {
                lines.push(&cx, Buffer!::new().write(&cx, indent).put("            open ").write(&cx, brands(&cx, block.opened.at(&cx, o).brands)).put(". ")
                    .write(&cx, block.opened.at(&cx, o).path).put(";").save(&cx));
                o = o + 1usize;
            }
            var e = 0usize;
            while e < block.empty.len(&cx) {
                lines.push(&cx, Buffer!::new().write(&cx, indent).put("            empty ").write(&cx, block.empty.at(&cx, e)).put(";").save(&cx));
                e = e + 1usize;
            }
            var k = 0usize;
            while k < block.known.len(&cx) {
                lines.push(&cx, Buffer!::new().write(&cx, indent).put("            known ").write(&cx, block.known.at(&cx, k).path).put(" = ")
                    .write(&cx, block.known.at(&cx, k).variant).put(";").save(&cx));
                k = k + 1usize;
            }
            lines.push(&cx, concat(&cx, indent, Span::from_static(&cx, "        }")));
        }
        // Preserve a unit binding if later code actually refers to it.
        let used: ArenaSet[Span['k], 'k] = ArenaSet::new(&cx);
        var u = 0usize;
        while u < block.instrs.len(&cx) {
            used.insert_all(&cx, block.instrs.at(&cx, u).args);
            u = u + 1usize;
        }
        match block.term {
            Ret(value, _pos) => { used.insert(&cx, value); },
            Jmp(edge, _pos) => used.insert_all(&cx, edge.args),
            Jnz(cond, then, other, _pos) => {
                used.insert(&cx, cond);
                used.insert_all(&cx, then.args);
                used.insert_all(&cx, other.args);
            },
            Switch(scrutinee, _ty, arms, _pos) => {
                used.insert(&cx, scrutinee);
                var a = 0usize;
                while a < arms.len(&cx) {
                    used.insert_all(&cx, arms.at(&cx, a).edge.args);
                    a = a + 1usize;
                }
            },
            Unreachable(_pos) => (),
        };
        var i = 0usize;
        while i < block.instrs.len(&cx) {
            let instr = block.instrs.at(&cx, i);
            var any = false;
            var n = 0usize;
            while n < instr.lhs.len(&cx) {
                if used.contains(&cx, instr.lhs.at(&cx, n)) {
                    any = true;
                }
                n = n + 1usize;
            }
            lines.push(&cx, Buffer!::new().write(&cx, indent).put("        ").write(&cx, instruction_text(&cx, instr, depth + 2usize, !any)).save(&cx));
            i = i + 1usize;
        }
        let term_lines = ArenaVec::split(&cx, terminator_text(&cx, block.term), Span::from_static(&cx, "\n"));
        var t = 0usize;
        while t < term_lines.len(&cx) {
            lines.push(&cx, Buffer!::new().write(&cx, indent).put("        ").write(&cx, term_lines.at(&cx, t)).save(&cx));
            t = t + 1usize;
        }
        lines.push(&cx, concat(&cx, indent, Span::from_static(&cx, "    }")));
        index = index + 1usize;
    }
    lines.push(&cx, concat(&cx, indent, Span::from_static(&cx, "}")));
    lines
}

forall 'k.
fn initializer_text(&cx: Domain!['k], form: Form['k]) -> Span['k] {
    if form.is_str() {
        return json_string(&cx, form.text);
    }
    if form.is_list() {
        let parts: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
        var i = 0usize;
        while i < form.len(&cx) {
            parts.push(&cx, initializer_text(&cx, form.at(&cx, i)));
            i = i + 1usize;
        }
        return Buffer!::new().put("[").write(&cx, parts.join(&cx, ", ")).put("]").save(&cx);
    }
    form.text
}

// Render all declarations without changing or checking the program.
forall 'k.
fn emit_kurs(&cx: Domain!['k], program: Program['k]) -> Span['k] {
    let sections: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
    let decls = program.types.values(&cx);
    var d = 0usize;
    while d < decls.len(&cx) {
        let decl = decls.at(&cx, d);
        let lines = metadata(&cx, decl.home, 0usize);
        match decl.exposure {
            Some(exposure) => {
                let mode = match exposure.mode {
                    Owner => Span::from_static(&cx, "owner"),
                    Within => Span::from_static(&cx, "within"),
                };
                lines.push(&cx, Buffer!::new().put("// exposure: ").write(&cx, mode).put(", package ").put(exposure.home.package).put(", module ")
                    .write(&cx, json_list(&cx, exposure.home.path)).save(&cx));
            },
            None => (),
        };
        let quant = quantifier(&cx, decl.params, decl.premises);
        if !quant.is_empty() {
            lines.push(&cx, quant.trim_end(&cx));
        }
        lines.push(&cx, Buffer!::new().put("type ").write(&cx, decl.name).put(" = ").write(&cx, type_text(&cx, decl.body, 0usize))
            .put(";").save(&cx));
        sections.push(&cx, lines.join(&cx, "\n"));
        d = d + 1usize;
    }
    let externs = program.externs.values(&cx);
    var e = 0usize;
    while e < externs.len(&cx) {
        let external = externs.at(&cx, e);
        sections.push(&cx, Buffer!::new().put("extern fn ").write(&cx, external.name).put("(")
            .write(&cx, type_texts(&cx, external.ptypes, 0usize).join(&cx, ", ")).put(") -> ")
            .write(&cx, type_text(&cx, external.ret, 0usize)).put(";").save(&cx));
        e = e + 1usize;
    }
    let datas = program.datas.values(&cx);
    var a = 0usize;
    while a < datas.len(&cx) {
        let data = datas.at(&cx, a);
        let lines = metadata(&cx, data.home, 0usize);
        lines.push(&cx, Buffer!::new().put("data ").write(&cx, data.name).put(": ").write(&cx, type_text(&cx, data.ty, 0usize)).put(" = ")
            .write(&cx, initializer_text(&cx, data.init)).put(";").save(&cx));
        sections.push(&cx, lines.join(&cx, "\n"));
        a = a + 1usize;
    }
    let traits = program.traits.values(&cx);
    var t = 0usize;
    while t < traits.len(&cx) {
        let tr = traits.at(&cx, t);
        let names: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
        let bounds: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
        var p = 0usize;
        while p < tr.params.len(&cx) {
            let kind = if tr.param_kinds.is_empty(&cx) { Kind::Any } else { tr.param_kinds.at(&cx, p) };
            names.push(&cx, if is_brand(kind) { brand(&cx, tr.params.at(&cx, p)) } else { tr.params.at(&cx, p) });
            if is_copy(kind) {
                bounds.push(&cx, Buffer!::new().put("Copy[").write(&cx, tr.params.at(&cx, p)).put("]").save(&cx));
            }
            p = p + 1usize;
        }
        var header = Buffer!::new().put("trait ").write(&cx, tr.name).put("[").write(&cx, names.join(&cx, ", ")).put("]");
        if !bounds.is_empty(&cx) {
            header = header.put(" where ").write(&cx, bounds.join(&cx, ", "));
        }
        let lines = metadata(&cx, tr.home, 0usize);
        lines.push(&cx, header.put(" {").save(&cx));
        var m = 0usize;
        while m < tr.methods.len(&cx) {
            let method = tr.methods.at(&cx, m);
            let modes: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
            var i = 0usize;
            while i < method.ptypes.len(&cx) {
                modes.push(&cx, Buffer!::new().put(if method.places.contains(&cx, i) { "&" } else { "" }).write(&cx, type_text(&cx, method.ptypes.at(&cx, i), 1usize)).save(&cx));
                i = i + 1usize;
            }
            lines.push(&cx, Buffer!::new().put("    ").put(if method.is_unsafe { "unsafe " } else { "" }).put("fn ").write(&cx, method.name).put("(")
                .write(&cx, modes.join(&cx, ", ")).put(") -> ").write(&cx, type_text(&cx, method.ret, 1usize)).put(";").save(&cx));
            m = m + 1usize;
        }
        lines.push(&cx, Span::from_static(&cx, "}"));
        sections.push(&cx, lines.join(&cx, "\n"));
        t = t + 1usize;
    }
    let groups = program.instances.values(&cx);
    var g = 0usize;
    while g < groups.len(&cx) {
        let insts = groups.at(&cx, g);
        var i = 0usize;
        while i < insts.len(&cx) {
            let inst = insts.at(&cx, i);
            let lines = metadata(&cx, inst.home, 0usize);
            let quant = quantifier(&cx, inst.params, inst.premises);
            if !quant.is_empty() {
                lines.push(&cx, quant.trim_end(&cx));
            }
            lines.push(&cx, Buffer!::new().put("instance ").write(&cx, inst.trait_name).write(&cx, arguments(&cx, inst.head, 0usize)).put(" {").save(&cx));
            var m = 0usize;
            while m < inst.methods.len(&cx) {
                lines.append(&cx, function_lines(&cx, inst.methods.at(&cx, m), 1usize));
                m = m + 1usize;
            }
            lines.push(&cx, Span::from_static(&cx, "}"));
            sections.push(&cx, lines.join(&cx, "\n"));
            i = i + 1usize;
        }
        g = g + 1usize;
    }
    let funs = program.funs.values(&cx);
    var f = 0usize;
    while f < funs.len(&cx) {
        sections.push(&cx, function_lines(&cx, funs.at(&cx, f), 0usize).join(&cx, "\n"));
        f = f + 1usize;
    }
    Buffer!::new().write(&cx, sections.join(&cx, "\n\n")).put("\n").save(&cx)
}
