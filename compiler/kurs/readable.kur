// Readable rendering of typed KURS; the interchange reader is `kurs::serial`.
//
// This is a display format, not an alternate checker or a reconstruction from C.

use package::support::base::{Cx, Map, Seq, Set, Text, text, text_of};
use std::bytes::buffer::Buffer;
use package::kurs::core::{Binding, Edge, ExposureMode, Fun, Instr, Kind, Member, ModuleId, Param, Premise, Program, Terminator, Type};
use package::kurs::core as C;
use package::kurs::sexpr::Form;
use package::syntax::ast::no_pos;
use package::types::ops::{Fresh, kurs_error, subst};
use std::option::Option;
use std::slice::Slice;

forall 'k.
fn brand(&cx: Cx!['k], name: Text['k]) -> Text['k] {
    text_of(&cx, Buffer::new().push_static("'").push_bytes(&cx, name))
}

fn is_brand(kind: Kind) -> bool {
    C::same_kind(kind, Kind::Brand)
}

fn is_copy(kind: Kind) -> bool {
    C::same_kind(kind, Kind::Copy)
}

forall 'k.
fn joined(&cx: Cx!['k], parts: Seq[Text['k], 'k], separator: Slice[u8, 'static]) -> Text['k] {
    var out = Buffer::new();
    var i = 0usize;
    while i < parts.len(&cx) {
        if i > 0usize {
            out = out.push_static(separator);
        }
        out = out.push_bytes(&cx, parts.get(&cx, i));
        i = i + 1usize;
    }
    text_of(&cx, out)
}

forall 'k.
fn brands(&cx: Cx!['k], names: Seq[Text['k], 'k]) -> Text['k] {
    let out: Seq[Text['k], 'k] = Seq::new(&cx);
    var i = 0usize;
    while i < names.len(&cx) {
        out.push(&cx, brand(&cx, names.get(&cx, i)));
        i = i + 1usize;
    }
    joined(&cx, out, ", ")
}

forall 'k.
fn indentation(&cx: Cx!['k], depth: usize) -> Text['k] {
    var out = Buffer::new();
    var i = 0usize;
    while i < depth {
        out = out.push_static("    ");
        i = i + 1usize;
    }
    text_of(&cx, out)
}

forall 'k.
fn type_texts(&cx: Cx!['k], types: Seq[Type['k], 'k], depth: usize) -> Seq[Text['k], 'k] {
    let out: Seq[Text['k], 'k] = Seq::new(&cx);
    var i = 0usize;
    while i < types.len(&cx) {
        out.push(&cx, type_text(&cx, types.get(&cx, i), depth));
        i = i + 1usize;
    }
    out
}

forall 'k.
fn arguments(&cx: Cx!['k], types: Seq[Type['k], 'k], depth: usize) -> Text['k] {
    if types.is_empty(&cx) {
        text(&cx, "")
    } else {
        text_of(&cx, Buffer::new().push_static("[").push_bytes(&cx, joined(&cx, type_texts(&cx, types, depth), ", ")).push_static("]"))
    }
}

forall 'k.
fn premise_text(&cx: Cx!['k], premise: Premise['k]) -> Text['k] {
    text_of(&cx, Buffer::new().push_bytes(&cx, premise.trait_name).push_static("[").push_bytes(&cx, joined(&cx, type_texts(&cx, premise.args, 0usize), ", ")).push_static("]"))
}

forall 'k.
fn quantifier(&cx: Cx!['k], params: Seq[Param['k], 'k], premises: Seq[Premise['k], 'k]) -> Text['k] {
    let names: Seq[Text['k], 'k] = Seq::new(&cx);
    let bounds: Seq[Text['k], 'k] = Seq::new(&cx);
    var i = 0usize;
    while i < params.len(&cx) {
        let param = params.get(&cx, i);
        names.push(&cx, if is_brand(param.kind) { brand(&cx, param.name) } else { param.name });
        if is_copy(param.kind) {
            bounds.push(&cx, text_of(&cx, Buffer::new().push_static("Copy[").push_bytes(&cx, param.name).push_static("]")));
        }
        i = i + 1usize;
    }
    var j = 0usize;
    while j < premises.len(&cx) {
        bounds.push(&cx, premise_text(&cx, premises.get(&cx, j)));
        j = j + 1usize;
    }
    if names.is_empty(&cx) && bounds.is_empty(&cx) {
        return text(&cx, "");
    }
    var out = Buffer::new().push_static("forall ").push_bytes(&cx, joined(&cx, names, ", "));
    if !bounds.is_empty(&cx) {
        out = out.push_static(" where ").push_bytes(&cx, joined(&cx, bounds, ", "));
    }
    text_of(&cx, out.push_static(". "))
}

forall 'k.
fn is_binder_type(t: Type['k]) -> bool {
    match t {
        Type::Exists(_binders, _body) => true,
        Type::Foreach(_f) => true,
        Type::Fn(_f) => true,
        _ => false,
    }
}

forall 'k.
fn members_text(&cx: Cx!['k], kind: Slice[u8, 'static], members: Seq[Member['k], 'k], depth: usize) -> Text['k] {
    if members.is_empty(&cx) {
        return text_of(&cx, Buffer::new().push_static(kind).push_static(" {}"));
    }
    let rows: Seq[Text['k], 'k] = Seq::new(&cx);
    var i = 0usize;
    while i < members.len(&cx) {
        rows.push(&cx, text_of(&cx, Buffer::new().push_bytes(&cx, indentation(&cx, depth + 1usize)).push_bytes(&cx, members.get(&cx, i).name).push_static(": ")
            .push_bytes(&cx, type_text(&cx, members.get(&cx, i).type, depth + 1usize)).push_static(";")));
        i = i + 1usize;
    }
    text_of(&cx, Buffer::new().push_static(kind).push_static(" {\n").push_bytes(&cx, joined(&cx, rows, "\n")).push_static("\n").push_bytes(&cx, indentation(&cx, depth)).push_static("}"))
}

forall 'k.
fn type_text(&cx: Cx!['k], ty: Type['k], depth: usize) -> Text['k] {
    match ty {
        Type::Prim(name) => name,
        Type::Named(name, args) => if args.is_empty(&cx) { name } else { name.concat(&cx, arguments(&cx, args, depth)) },
        Type::Never => text(&cx, "Never"),
        Type::Ignored => text(&cx, "_"),
        Type::Skolem(label) => brand(&cx, label),
        Type::Brand(witness) => text_of(&cx, Buffer::new().push_static("Brand[").push_bytes(&cx, type_text(&cx, witness.get(&cx), depth)).push_static("]")),
        Type::Ptr(inner) => {
            let t = type_text(&cx, inner.get(&cx), depth);
            if is_binder_type(inner.get(&cx)) { text_of(&cx, Buffer::new().push_static("*(").push_bytes(&cx, t).push_static(")")) } else { text_of(&cx, Buffer::new().push_static("*").push_bytes(&cx, t)) }
        },
        Type::Tuple(elems) => {
            if elems.is_empty(&cx) {
                text(&cx, "unit")
            } else {
                text_of(&cx, Buffer::new().push_static("(").push_bytes(&cx, joined(&cx, type_texts(&cx, elems, depth), ", ")).push_static(if elems.len(&cx) == 1usize { "," } else { "" }).push_static(")"))
            }
        },
        Type::Array(elem, length) => text_of(&cx, Buffer::new().push_static("[").push_bytes(&cx, type_text(&cx, elem.get(&cx), depth)).push_static("; ").push_u64(length).push_static("]")),
        Type::Struct(fields) => members_text(&cx, "struct", fields, depth),
        Type::Enum(variants) => members_text(&cx, "enum", variants, depth),
        Type::Exists(binders, body) => text_of(&cx, Buffer::new().push_static("exists ").push_bytes(&cx, brands(&cx, binders)).push_static(". ").push_bytes(&cx, type_text(&cx, body.get(&cx), depth))),
        Type::Foreach(f) => {
            let inferred: Seq[Text['k], 'k] = match f.source.get(&cx) {
                Type::Foreach(source) => {
                    let names = Seq::one(&cx, source.binder);
                    names.append(&cx, source.retained);
                    names
                },
                _ => Seq::new(&cx),
            };
            let retained = if f.retained.same(&cx, inferred) {
                text(&cx, "")
            } else {
                text_of(&cx, Buffer::new().push_static(" retain (").push_bytes(&cx, joined(&cx, f.retained, ", ")).push_static(")"))
            };
            text_of(&cx, Buffer::new().push_static("foreach ").push_static(if f.indirect { "*" } else { "" }).push_bytes(&cx, f.binder).push_bytes(&cx, retained).push_static(" of ")
                .push_bytes(&cx, type_text(&cx, f.source.get(&cx), depth)).push_static(" => ").push_bytes(&cx, type_text(&cx, f.body.get(&cx), depth)))
        },
        Type::Fn(f) => {
            let modes: Seq[Text['k], 'k] = Seq::new(&cx);
            var i = 0usize;
            while i < f.params.len(&cx) {
                modes.push(&cx, text_of(&cx, Buffer::new().push_static(if f.places.has(&cx, i) { "&" } else { "" }).push_bytes(&cx, type_text(&cx, f.params.get(&cx, i), depth))));
                i = i + 1usize;
            }
            text_of(&cx, Buffer::new().push_bytes(&cx, quantifier(&cx, f.quantified, Seq::new(&cx))).push_static(if f.is_unsafe { "unsafe " } else { "" }).push_static("fn(")
                .push_bytes(&cx, joined(&cx, modes, ", ")).push_static(") -> ").push_bytes(&cx, type_text(&cx, f.ret.get(&cx), depth)))
        },
        Type::Meta(_m) => kurs_error(&cx, text(&cx, "unsupported readable KURS type: an inference variable"), no_pos()),
    }
}

forall 'k.
fn edge_text(&cx: Cx!['k], edge: Edge['k]) -> Text['k] {
    text_of(&cx, Buffer::new().push_bytes(&cx, edge.target).push_bytes(&cx, arguments(&cx, edge.tys, 0usize)).push_static("(").push_bytes(&cx, joined(&cx, edge.args, ", ")).push_static(")"))
}

forall 'k.
fn instruction_text(&cx: Cx!['k], instr: Instr['k], depth: usize, omit_unit: bool, counter: Fresh['k]) -> Text['k] {
    let op = instr.op;
    let args = instr.args;
    let ty = match instr.ty {
        Option::Some(t) => type_text(&cx, t, depth),
        Option::None => text(&cx, ""),
    };
    let literal = match instr.lit {
        Option::Some(l) => l,
        Option::None => text(&cx, ""),
    };
    let lhs = if instr.lhs.len(&cx) == 1usize { instr.lhs.get(&cx, 0usize) } else { text_of(&cx, Buffer::new().push_static("(").push_bytes(&cx, joined(&cx, instr.lhs, ", ")).push_static(")")) };
    let prefix = if instr.is_unsafe { text(&cx, "unsafe ") } else { text(&cx, "") };
    if op.is(&cx, "open") {
        let binding = if omit_unit && args.get(&cx, 0usize).starts_with(&cx, text(&cx, "&")) { text(&cx, "") } else { lhs.concat(&cx, text(&cx, " = ")) };
        return text_of(&cx, Buffer::new().push_bytes(&cx, prefix).push_static("exists ").push_bytes(&cx, brands(&cx, instr.binders)).push_static(". ").push_bytes(&cx, binding).push_static("open ").push_bytes(&cx, args.get(&cx, 0usize)).push_static(";"));
    }
    let rhs = if op.is(&cx, "pack") {
        let (binders, body) = match instr.ty {
            Option::Some(t) => match t {
                Type::Exists(binders, body) => (binders, body.get(&cx)),
                _ => kurs_error(&cx, text(&cx, "unsupported readable instruction: a pack of a type that is not a package"), no_pos()),
            },
            Option::None => kurs_error(&cx, text(&cx, "unsupported readable instruction: a pack without its type"), no_pos()),
        };
        let sub: Map[Text['k], Type['k], 'k] = Map::new(&cx);
        var i = 0usize;
        while i < binders.len(&cx) && i < instr.tys.len(&cx) {
            sub.set(&cx, binders.get(&cx, i), instr.tys.get(&cx, i));
            i = i + 1usize;
        }
        let payload = subst(&cx, body, sub, counter);
        text_of(&cx, Buffer::new().push_static("pack ").push_bytes(&cx, joined(&cx, type_texts(&cx, instr.tys, 0usize), ", ")).push_static(". ").push_bytes(&cx, args.get(&cx, 0usize)).push_static(" as ")
            .push_bytes(&cx, type_text(&cx, payload, depth)))
    } else if op.is(&cx, "call") || op.is(&cx, "fn") {
        var out = Buffer::new().push_bytes(&cx, op).push_static(" ").push_bytes(&cx, args.get(&cx, 0usize)).push_bytes(&cx, arguments(&cx, instr.tys, depth));
        if op.is(&cx, "call") {
            out = out.push_static("(").push_bytes(&cx, joined(&cx, args.from(&cx, 1usize), ", ")).push_static(")");
        }
        text_of(&cx, out)
    } else if op.is(&cx, "trait_call") {
        text_of(&cx, Buffer::new().push_static("trait_call ").push_bytes(&cx, args.get(&cx, 0usize)).push_bytes(&cx, arguments(&cx, instr.tys, depth)).push_static("::").push_bytes(&cx, args.get(&cx, 1usize))
            .push_static("(").push_bytes(&cx, joined(&cx, args.from(&cx, 2usize), ", ")).push_static(")"))
    } else if op.is(&cx, "foreach") {
        let f = match instr.ty {
            Option::Some(t) => match t {
                Type::Foreach(f) => f,
                _ => kurs_error(&cx, text(&cx, "unsupported readable instruction: a foreach of a type that is not a transform"), no_pos()),
            },
            Option::None => kurs_error(&cx, text(&cx, "unsupported readable instruction: a foreach without its type"), no_pos()),
        };
        text_of(&cx, Buffer::new().push_static("foreach ").push_static(if f.indirect { "*" } else { "" }).push_bytes(&cx, f.binder).push_static(" of ").push_bytes(&cx, args.get(&cx, 0usize)).push_static(" : ")
            .push_bytes(&cx, type_text(&cx, f.source.get(&cx), depth)).push_static(" => ").push_bytes(&cx, type_text(&cx, f.body.get(&cx), depth))
            .push_static(" using ").push_bytes(&cx, args.get(&cx, 1usize)).push_bytes(&cx, arguments(&cx, instr.tys, depth)).push_static("(").push_bytes(&cx, joined(&cx, args.from(&cx, 2usize), ", ")).push_static(")"))
    } else {
        let operands: Seq[Text['k], 'k] = if op.is(&cx, "const") {
            Seq::two(&cx, ty, literal)
        } else if op.is(&cx, "construct") || op.is(&cx, "destruct") || op.is(&cx, "variant_tag") {
            let out = Seq::one(&cx, ty);
            out.append(&cx, args);
            out
        } else if op.is(&cx, "construct_variant") {
            let out = Seq::two(&cx, ty, literal);
            out.append(&cx, args);
            out
        } else if op.is(&cx, "builtin::int_cast") || op.is(&cx, "builtin::unsafe::cast") {
            let out = args.copy(&cx);
            out.push(&cx, ty);
            out
        } else if op.is(&cx, "alloca") || op.is(&cx, "builtin::sizeof") {
            Seq::one(&cx, ty)
        } else if instr.lit.is_some() {
            let out = Seq::one(&cx, literal);
            out.append(&cx, args);
            out
        } else if instr.ty.is_some() || !instr.tys.is_empty(&cx) || !instr.binders.is_empty(&cx) {
            kurs_error(&cx, text_of(&cx, Buffer::new().push_static("unsupported readable instruction metadata: ").push_bytes(&cx, op)), no_pos())
        } else {
            args
        };
        if operands.is_empty(&cx) { op } else { text_of(&cx, Buffer::new().push_bytes(&cx, op).push_static(" ").push_bytes(&cx, joined(&cx, operands, ", "))) }
    };
    text_of(&cx, Buffer::new().push_bytes(&cx, prefix).push_bytes(&cx, lhs).push_static(" = ").push_bytes(&cx, rhs).push_static(";"))
}

forall 'k.
fn terminator_text(&cx: Cx!['k], term: Terminator['k]) -> Text['k] {
    match term {
        Terminator::Ret(value, _pos) => text_of(&cx, Buffer::new().push_static("return ").push_bytes(&cx, value).push_static(";")),
        Terminator::Jmp(edge, _pos) => text_of(&cx, Buffer::new().push_static("jump ").push_bytes(&cx, edge_text(&cx, edge)).push_static(";")),
        Terminator::Jnz(cond, then, other, _pos) => text_of(&cx, Buffer::new().push_static("branch ").push_bytes(&cx, cond).push_static(", ").push_bytes(&cx, edge_text(&cx, then)).push_static(", ")
            .push_bytes(&cx, edge_text(&cx, other)).push_static(";")),
        Terminator::Switch(scrutinee, ty, arms, _pos) => {
            let lines = Seq::one(&cx, text_of(&cx, Buffer::new().push_static("switch ").push_bytes(&cx, scrutinee).push_static(" : ").push_bytes(&cx, type_text(&cx, ty, 0usize)).push_static(" {")));
            var i = 0usize;
            while i < arms.len(&cx) {
                lines.push(&cx, text_of(&cx, Buffer::new().push_static("    ").push_bytes(&cx, arms.get(&cx, i).variant).push_static(" => ").push_bytes(&cx, edge_text(&cx, arms.get(&cx, i).edge)).push_static(";")));
                i = i + 1usize;
            }
            lines.push(&cx, text(&cx, "}"));
            joined(&cx, lines, "\n")
        },
        Terminator::Unreachable(_pos) => text(&cx, "unreachable;"),
    }
}

// `t` as a JSON string with only ASCII characters, as Python's `json.dumps` writes it.
forall 'k.
fn json_string(&cx: Cx!['k], t: Text['k]) -> Text['k] {
    var out = Buffer::new().push_static("\"");
    var i = 0usize;
    while i < t.len() {
        let b = t.byte(&cx, i);
        let (code, count) = decode(&cx, t, i);
        if b == b'"' {
            out = out.push_static("\\\"");
        } else if b == b'\\' {
            out = out.push_static("\\\\");
        } else if b == b'\n' {
            out = out.push_static("\\n");
        } else if b == b'\r' {
            out = out.push_static("\\r");
        } else if b == b'\t' {
            out = out.push_static("\\t");
        } else if b == 8u8 {
            out = out.push_static("\\b");
        } else if b == 12u8 {
            out = out.push_static("\\f");
        } else if code >= 32u32 && code < 127u32 {
            out = out.push_byte(b);
        } else if code >= 65536u32 {
            let v = code - 65536u32;
            out = unicode_escape(&cx, unicode_escape(&cx, out, 55296u32 + (v >> 10u32)), 56320u32 + (v & 1023u32));
        } else {
            out = unicode_escape(&cx, out, code);
        }
        i = i + count;
    }
    text_of(&cx, out.push_static("\""))
}

forall 'k.
fn unicode_escape(&cx: Cx!['k], out: Buffer!, code: u32) -> Buffer! {
    let digits = text(&cx, "0123456789abcdef");
    out.push_static("\\u").push_byte(digits.byte(&cx, ((code >> 12u32) & 15u32) as usize)).push_byte(digits.byte(&cx, ((code >> 8u32) & 15u32) as usize))
        .push_byte(digits.byte(&cx, ((code >> 4u32) & 15u32) as usize)).push_byte(digits.byte(&cx, (code & 15u32) as usize))
}

// The code point of the UTF-8 character at `i` and its length in bytes; a byte that starts no
// well-formed character stands for itself.
forall 'k.
fn decode(&cx: Cx!['k], t: Text['k], i: usize) -> (u32, usize) {
    let b = t.byte(&cx, i);
    let (count, initial) = if b < 128u8 {
        (0usize, b as u32)
    } else if b >= 192u8 && b < 224u8 {
        (1usize, (b & 31u8) as u32)
    } else if b >= 224u8 && b < 240u8 {
        (2usize, (b & 15u8) as u32)
    } else if b >= 240u8 && b < 248u8 {
        (3usize, (b & 7u8) as u32)
    } else {
        (0usize, b as u32)
    };
    if i + count >= t.len() && count > 0usize {
        return (b as u32, 1usize);
    }
    var code = initial;
    var k = 1usize;
    while k <= count {
        let c = t.byte(&cx, i + k);
        if (c & 192u8) != 128u8 {
            return (b as u32, 1usize);
        }
        code = (code << 6u32) | ((c & 63u8) as u32);
        k = k + 1usize;
    }
    (code, count + 1usize)
}

forall 'k.
fn json_list(&cx: Cx!['k], items: Seq[Text['k], 'k]) -> Text['k] {
    let parts: Seq[Text['k], 'k] = Seq::new(&cx);
    var i = 0usize;
    while i < items.len(&cx) {
        parts.push(&cx, json_string(&cx, items.get(&cx, i)));
        i = i + 1usize;
    }
    text_of(&cx, Buffer::new().push_static("[").push_bytes(&cx, joined(&cx, parts, ", ")).push_static("]"))
}

forall 'k.
fn metadata(&cx: Cx!['k], home: Option[ModuleId['k]], depth: usize) -> Seq[Text['k], 'k] {
    match home {
        Option::Some(m) => Seq::one(&cx, text_of(&cx, Buffer::new().push_bytes(&cx, indentation(&cx, depth)).push_static("// owner: package ").push_usize(m.package).push_static(", module ")
            .push_bytes(&cx, json_list(&cx, m.path)))),
        Option::None => Seq::new(&cx),
    }
}

// `t` without trailing whitespace.
forall 'k.
fn rstrip(&cx: Cx!['k], t: Text['k]) -> Text['k] {
    var end = t.len();
    while end > 0usize && (t.byte(&cx, end - 1usize) == b' ' || t.byte(&cx, end - 1usize) == b'\n' || t.byte(&cx, end - 1usize) == b'\t' || t.byte(&cx, end - 1usize) == b'\r') {
        end = end - 1usize;
    }
    t.slice(0usize, end)
}

forall 'k.
fn bindings_text(&cx: Cx!['k], bindings: Seq[Binding['k], 'k], depth: usize) -> Text['k] {
    let parts: Seq[Text['k], 'k] = Seq::new(&cx);
    var i = 0usize;
    while i < bindings.len(&cx) {
        parts.push(&cx, text_of(&cx, Buffer::new().push_bytes(&cx, bindings.get(&cx, i).name).push_static(": ").push_bytes(&cx, type_text(&cx, bindings.get(&cx, i).type, depth))));
        i = i + 1usize;
    }
    joined(&cx, parts, ", ")
}

forall 'k.
fn add_all(&cx: Cx!['k], used: Set[Text['k], 'k], names: Seq[Text['k], 'k]) {
    var i = 0usize;
    while i < names.len(&cx) {
        used.add(&cx, names.get(&cx, i));
        i = i + 1usize;
    }
}

forall 'k.
fn function_lines(&cx: Cx!['k], fun: Fun['k], depth: usize, counter: Fresh['k]) -> Seq[Text['k], 'k] {
    let indent = indentation(&cx, depth);
    let lines = metadata(&cx, fun.home, depth);
    let quant = quantifier(&cx, fun.params, fun.premises);
    if !quant.is_empty() {
        lines.push(&cx, indent.concat(&cx, rstrip(&cx, quant)));
    }
    let params = bindings_text(&cx, fun.blocks.get(&cx, 0usize).params, depth);
    lines.push(&cx, text_of(&cx, Buffer::new().push_bytes(&cx, indent).push_static(if fun.is_unsafe { "unsafe " } else { "" }).push_static("fn ").push_bytes(&cx, fun.name).push_static("(").push_bytes(&cx, params)
        .push_static(") -> ").push_bytes(&cx, type_text(&cx, fun.ret, depth)).push_static(" {")));
    if !fun.locals.is_empty(&cx) {
        lines.push(&cx, indent.concat(&cx, text(&cx, "    locals {")));
        var l = 0usize;
        while l < fun.locals.len(&cx) {
            lines.push(&cx, text_of(&cx, Buffer::new().push_bytes(&cx, indent).push_static("        ").push_bytes(&cx, fun.locals.get(&cx, l).name).push_static(": ")
                .push_bytes(&cx, type_text(&cx, fun.locals.get(&cx, l).type, depth + 2usize)).push_static(";")));
            l = l + 1usize;
        }
        lines.push(&cx, indent.concat(&cx, text(&cx, "    }")));
    }
    var index = 0usize;
    while index < fun.blocks.len(&cx) {
        let block = fun.blocks.get(&cx, index);
        let block_brands = if block.brands.is_empty(&cx) { text(&cx, "") } else { text_of(&cx, Buffer::new().push_static("[").push_bytes(&cx, brands(&cx, block.brands)).push_static("]")) };
        let block_params = bindings_text(&cx, block.params, depth + 1usize);
        let header = if index == 0usize {
            text(&cx, "entry")
        } else {
            text_of(&cx, Buffer::new().push_static("block ").push_bytes(&cx, block.label).push_bytes(&cx, block_brands).push_static("(").push_bytes(&cx, block_params).push_static(")"))
        };
        if index == 0usize && !block.label.is(&cx, "entry") {
            lines.push(&cx, text_of(&cx, Buffer::new().push_bytes(&cx, indent).push_static("    // entry label: ").push_bytes(&cx, block.label)));
        }
        lines.push(&cx, text_of(&cx, Buffer::new().push_bytes(&cx, indent).push_static("    ").push_bytes(&cx, header).push_static(" {")));
        if !block.empty.is_empty(&cx) || !block.known.is_empty(&cx) || !block.opened.is_empty(&cx) {
            lines.push(&cx, indent.concat(&cx, text(&cx, "        state {")));
            var o = 0usize;
            while o < block.opened.len(&cx) {
                lines.push(&cx, text_of(&cx, Buffer::new().push_bytes(&cx, indent).push_static("            open ").push_bytes(&cx, brands(&cx, block.opened.get(&cx, o).brands)).push_static(". ")
                    .push_bytes(&cx, block.opened.get(&cx, o).path).push_static(";")));
                o = o + 1usize;
            }
            var e = 0usize;
            while e < block.empty.len(&cx) {
                lines.push(&cx, text_of(&cx, Buffer::new().push_bytes(&cx, indent).push_static("            empty ").push_bytes(&cx, block.empty.get(&cx, e)).push_static(";")));
                e = e + 1usize;
            }
            var k = 0usize;
            while k < block.known.len(&cx) {
                lines.push(&cx, text_of(&cx, Buffer::new().push_bytes(&cx, indent).push_static("            known ").push_bytes(&cx, block.known.get(&cx, k).path).push_static(" = ")
                    .push_bytes(&cx, block.known.get(&cx, k).variant).push_static(";")));
                k = k + 1usize;
            }
            lines.push(&cx, indent.concat(&cx, text(&cx, "        }")));
        }
        // Preserve a unit binding if later code actually refers to it.
        let used: Set[Text['k], 'k] = Set::new(&cx);
        var u = 0usize;
        while u < block.instrs.len(&cx) {
            add_all(&cx, used, block.instrs.get(&cx, u).args);
            u = u + 1usize;
        }
        match block.term {
            Terminator::Ret(value, _pos) => used.add(&cx, value),
            Terminator::Jmp(edge, _pos) => add_all(&cx, used, edge.args),
            Terminator::Jnz(cond, then, other, _pos) => {
                used.add(&cx, cond);
                add_all(&cx, used, then.args);
                add_all(&cx, used, other.args);
            },
            Terminator::Switch(scrutinee, _ty, arms, _pos) => {
                used.add(&cx, scrutinee);
                var a = 0usize;
                while a < arms.len(&cx) {
                    add_all(&cx, used, arms.get(&cx, a).edge.args);
                    a = a + 1usize;
                }
            },
            Terminator::Unreachable(_pos) => (),
        };
        var i = 0usize;
        while i < block.instrs.len(&cx) {
            let instr = block.instrs.get(&cx, i);
            var any = false;
            var n = 0usize;
            while n < instr.lhs.len(&cx) {
                if used.has(&cx, instr.lhs.get(&cx, n)) {
                    any = true;
                }
                n = n + 1usize;
            }
            lines.push(&cx, text_of(&cx, Buffer::new().push_bytes(&cx, indent).push_static("        ").push_bytes(&cx, instruction_text(&cx, instr, depth + 2usize, !any, counter))));
            i = i + 1usize;
        }
        let term_lines = terminator_text(&cx, block.term).split(&cx, text(&cx, "\n"));
        var t = 0usize;
        while t < term_lines.len(&cx) {
            lines.push(&cx, text_of(&cx, Buffer::new().push_bytes(&cx, indent).push_static("        ").push_bytes(&cx, term_lines.get(&cx, t))));
            t = t + 1usize;
        }
        lines.push(&cx, indent.concat(&cx, text(&cx, "    }")));
        index = index + 1usize;
    }
    lines.push(&cx, indent.concat(&cx, text(&cx, "}")));
    lines
}

forall 'k.
fn initializer_text(&cx: Cx!['k], form: Form['k]) -> Text['k] {
    if form.is_str() {
        return json_string(&cx, form.text);
    }
    if form.is_list() {
        let parts: Seq[Text['k], 'k] = Seq::new(&cx);
        var i = 0usize;
        while i < form.len(&cx) {
            parts.push(&cx, initializer_text(&cx, form.at(&cx, i)));
            i = i + 1usize;
        }
        return text_of(&cx, Buffer::new().push_static("[").push_bytes(&cx, joined(&cx, parts, ", ")).push_static("]"));
    }
    form.text
}

// Render all declarations without changing or checking the program.
forall 'k.
fn emit_kurs(&cx: Cx!['k], program: Program['k], counter: Fresh['k]) -> Text['k] {
    let sections: Seq[Text['k], 'k] = Seq::new(&cx);
    let decls = program.types.values(&cx);
    var d = 0usize;
    while d < decls.len(&cx) {
        let decl = decls.get(&cx, d);
        let lines = metadata(&cx, decl.home, 0usize);
        match decl.exposure {
            Option::Some(exposure) => {
                let mode = match exposure.mode {
                    ExposureMode::Owner => text(&cx, "owner"),
                    ExposureMode::Within => text(&cx, "within"),
                };
                lines.push(&cx, text_of(&cx, Buffer::new().push_static("// exposure: ").push_bytes(&cx, mode).push_static(", package ").push_usize(exposure.home.package).push_static(", module ")
                    .push_bytes(&cx, json_list(&cx, exposure.home.path))));
            },
            Option::None => (),
        };
        let quant = quantifier(&cx, decl.params, decl.premises);
        if !quant.is_empty() {
            lines.push(&cx, rstrip(&cx, quant));
        }
        lines.push(&cx, text_of(&cx, Buffer::new().push_static("type ").push_bytes(&cx, decl.name).push_static(if decl.linear { "!" } else { "" }).push_static(" = ").push_bytes(&cx, type_text(&cx, decl.body, 0usize))
            .push_static(";")));
        sections.push(&cx, joined(&cx, lines, "\n"));
        d = d + 1usize;
    }
    let externs = program.externs.values(&cx);
    var e = 0usize;
    while e < externs.len(&cx) {
        let external = externs.get(&cx, e);
        let ty = match external.ret {
            Option::Some(r) => type_text(&cx, r, 0usize),
            Option::None => kurs_error(&cx, text(&cx, "unsupported readable extern: an extern without a type"), no_pos()),
        };
        match external.ptypes {
            Option::None => sections.push(&cx, text_of(&cx, Buffer::new().push_static("extern val ").push_bytes(&cx, external.name).push_static(": ").push_bytes(&cx, ty).push_static(";"))),
            Option::Some(ptypes) => sections.push(&cx, text_of(&cx, Buffer::new().push_static("extern fn ").push_bytes(&cx, external.name).push_static("(")
                .push_bytes(&cx, joined(&cx, type_texts(&cx, ptypes, 0usize), ", ")).push_static(") -> ").push_bytes(&cx, ty).push_static(";"))),
        };
        e = e + 1usize;
    }
    let datas = program.datas.values(&cx);
    var a = 0usize;
    while a < datas.len(&cx) {
        let data = datas.get(&cx, a);
        let lines = metadata(&cx, data.home, 0usize);
        lines.push(&cx, text_of(&cx, Buffer::new().push_static("data ").push_bytes(&cx, data.name).push_static(": ").push_bytes(&cx, type_text(&cx, data.ty, 0usize)).push_static(" = ")
            .push_bytes(&cx, initializer_text(&cx, data.init)).push_static(";")));
        sections.push(&cx, joined(&cx, lines, "\n"));
        a = a + 1usize;
    }
    let traits = program.traits.values(&cx);
    var t = 0usize;
    while t < traits.len(&cx) {
        let tr = traits.get(&cx, t);
        let names: Seq[Text['k], 'k] = Seq::new(&cx);
        let bounds: Seq[Text['k], 'k] = Seq::new(&cx);
        var p = 0usize;
        while p < tr.params.len(&cx) {
            let kind = if tr.param_kinds.is_empty(&cx) { Kind::Any } else { tr.param_kinds.get(&cx, p) };
            names.push(&cx, if is_brand(kind) { brand(&cx, tr.params.get(&cx, p)) } else { tr.params.get(&cx, p) });
            if is_copy(kind) {
                bounds.push(&cx, text_of(&cx, Buffer::new().push_static("Copy[").push_bytes(&cx, tr.params.get(&cx, p)).push_static("]")));
            }
            p = p + 1usize;
        }
        var header = Buffer::new().push_static("trait ").push_bytes(&cx, tr.name).push_static("[").push_bytes(&cx, joined(&cx, names, ", ")).push_static("]");
        if !bounds.is_empty(&cx) {
            header = header.push_static(" where ").push_bytes(&cx, joined(&cx, bounds, ", "));
        }
        let lines = metadata(&cx, tr.home, 0usize);
        lines.push(&cx, text_of(&cx, header.push_static(" {")));
        var m = 0usize;
        while m < tr.methods.len(&cx) {
            let method = tr.methods.get(&cx, m);
            let modes: Seq[Text['k], 'k] = Seq::new(&cx);
            var i = 0usize;
            while i < method.ptypes.len(&cx) {
                modes.push(&cx, text_of(&cx, Buffer::new().push_static(if method.places.has(&cx, i) { "&" } else { "" }).push_bytes(&cx, type_text(&cx, method.ptypes.get(&cx, i), 1usize))));
                i = i + 1usize;
            }
            lines.push(&cx, text_of(&cx, Buffer::new().push_static("    ").push_static(if method.is_unsafe { "unsafe " } else { "" }).push_static("fn ").push_bytes(&cx, method.name).push_static("(")
                .push_bytes(&cx, joined(&cx, modes, ", ")).push_static(") -> ").push_bytes(&cx, type_text(&cx, method.ret, 1usize)).push_static(";")));
            m = m + 1usize;
        }
        lines.push(&cx, text(&cx, "}"));
        sections.push(&cx, joined(&cx, lines, "\n"));
        t = t + 1usize;
    }
    let groups = program.instances.values(&cx);
    var g = 0usize;
    while g < groups.len(&cx) {
        let insts = groups.get(&cx, g);
        var i = 0usize;
        while i < insts.len(&cx) {
            let inst = insts.get(&cx, i);
            let lines = metadata(&cx, inst.home, 0usize);
            let quant = quantifier(&cx, inst.params, inst.premises);
            if !quant.is_empty() {
                lines.push(&cx, rstrip(&cx, quant));
            }
            lines.push(&cx, text_of(&cx, Buffer::new().push_static("instance ").push_bytes(&cx, inst.trait_name).push_bytes(&cx, arguments(&cx, inst.head, 0usize)).push_static(" {")));
            var m = 0usize;
            while m < inst.methods.len(&cx) {
                lines.append(&cx, function_lines(&cx, inst.methods.get(&cx, m), 1usize, counter));
                m = m + 1usize;
            }
            lines.push(&cx, text(&cx, "}"));
            sections.push(&cx, joined(&cx, lines, "\n"));
            i = i + 1usize;
        }
        g = g + 1usize;
    }
    let funs = program.funs.values(&cx);
    var f = 0usize;
    while f < funs.len(&cx) {
        sections.push(&cx, joined(&cx, function_lines(&cx, funs.get(&cx, f), 0usize, counter), "\n"));
        f = f + 1usize;
    }
    text_of(&cx, Buffer::new().push_bytes(&cx, joined(&cx, sections, "\n\n")).push_static("\n"))
}
