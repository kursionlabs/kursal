// The KURS S-expression serialization of the core: `parse_program` reads it into a `Program`, and
// `write_program` writes a program as text that `parse_program` reads back into the same program.

use package::support::base::fail;
use std::parse::parse_usize;
use std::collections::arena_vec::ArenaVec;
use std::mem::Ref;
use std::raw::Span;
use std::arena::Domain!;
use std::buffer::Buffer!;
use package::kurs::core as C;
use package::kurs::core::{Arm, Binding, Block, Data, Edge, Exposure, ExposureMode, Extern, Fun, ForeachType, Instance, Instr, Kind, Known, Member, Method, ModuleId, Opened, Param, Premise, Program, Terminator, Trait, Type, TypeDecl};
use package::kurs::sexpr::{Form, FormKind, located, read};
use package::syntax::ast::Pos;
use std::option::Option;
use std::slice::Slice;

// ---------------------------------------------------------------- parsing --

forall 'k.
fn fail_text_on(&cx: Domain!['k], message: Span['k], form: Form['k]) -> ! {
    if form.pos.line == 0u32 {
        fail(&cx, message)
    } else {
        fail(&cx, located(&cx, message, form.pos))
    }
}

forall 'k.
fn fail_on(&cx: Domain!['k], message: Slice[u8, 'static], form: Form['k]) -> ! {
    fail_text_on(&cx, Span::from_static(&cx, message), form)
}

// An empty list with no position.
forall 'k.
fn no_form(&cx: Domain!['k]) -> Form['k] {
    Form.{ kind: FormKind::List, text: Span::from_static(&cx, ""), items: ArenaVec::new(&cx), pos: Pos.{ line: 0u32, col: 0u32 } }
}

// `form` is an atom (or string) whose text is `word`.
forall 'k.
fn is_word(&cx: Domain!['k], form: Form['k], word: Slice[u8, 'static]) -> bool {
    !form.is_list() && form.text.is(&cx, word)
}

// `form` is a non-empty list headed by `head`.
forall 'k.
fn is_form(&cx: Domain!['k], form: Form['k], head: Slice[u8, 'static]) -> bool {
    form.is_list() && form.len(&cx) > 0usize && is_word(&cx, form.at(&cx, 0usize), head)
}

// ... with exactly `length` items.
forall 'k.
fn is_form_of(&cx: Domain!['k], form: Form['k], head: Slice[u8, 'static], length: usize) -> bool {
    is_form(&cx, form, head) && form.len(&cx) == length
}

forall 'k.
fn list_of(&cx: Domain!['k], form: Form['k]) -> Form['k] {
    if !form.is_list() {
        fail_on(&cx, "expected a list", form);
    }
    form
}

forall 'k.
fn atom_of(&cx: Domain!['k], form: Form['k]) -> Form['k] {
    if form.is_list() {
        fail_on(&cx, "expected an atom", form);
    }
    form
}

// A form as text: an atom's text, or a list as Python prints a list of strings.
forall 'k.
fn str_of(&cx: Domain!['k], form: Form['k]) -> Span['k] {
    if form.is_list() {
        repr_list(&cx, Buffer!::new(), form).save(&cx)
    } else {
        form.text
    }
}

forall 'k.
fn repr_list(&cx: Domain!['k], out: Buffer!, form: Form['k]) -> Buffer! {
    var out = out;
    out = out.push_byte(b'[');
    var i = 0usize;
    while i < form.len(&cx) {
        if i > 0usize {
            out = out.push_static(", ");
        }
        let item = form.at(&cx, i);
        out = if item.is_list() { repr_list(&cx, out, item) } else { repr_text(&cx, out, item.text) };
        i = i + 1usize;
    }
    out.push_byte(b']')
}

// A string as Python's `repr` writes it.
forall 'k.
fn repr_text(&cx: Domain!['k], out: Buffer!, t: Span['k]) -> Buffer! {
    var out = out;
    let quote = if t.contains(&cx, Span::from_static(&cx, "'")) && !t.contains(&cx, Span::from_static(&cx, "\"")) { b'"' } else { b'\'' };
    out = out.push_byte(quote);
    var i = 0usize;
    while i < t.len() {
        let b = t.byte_or_zero(&cx, i);
        out = if b == b'\\' || b == quote {
            out.push_byte(b'\\').push_byte(b)
        } else if b == b'\n' {
            out.push_static("\\n")
        } else if b == b'\t' {
            out.push_static("\\t")
        } else if b == b'\r' {
            out.push_static("\\r")
        } else if b < 32u8 || b == 127u8 {
            hex_escape(&cx, out, b)
        } else {
            out.push_byte(b)
        };
        i = i + 1usize;
    }
    out.push_byte(quote)
}

forall 'k.
fn hex_escape(&cx: Domain!['k], out: Buffer!, b: u8) -> Buffer! {
    let digits = Span::from_static(&cx, "0123456789abcdef");
    out.push_static("\\x").push_byte(digits.byte_or_zero(&cx, (b / 16u8) as usize)).push_byte(digits.byte_or_zero(&cx, (b % 16u8) as usize))
}

forall 'k.
fn strs(&cx: Domain!['k], forms: ArenaVec[Form['k], 'k]) -> ArenaVec[Span['k], 'k] {
    let out: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
    var i = 0usize;
    while i < forms.len(&cx) {
        out.push(&cx, str_of(&cx, forms.at(&cx, i)));
        i = i + 1usize;
    }
    out
}

forall 'k.
fn brand_of(&cx: Domain!['k], form: Form['k]) -> Span['k] {
    if form.is_list() || !form.text.starts_with(&cx, Span::from_static(&cx, "$")) || form.text.len() < 2usize {
        fail_text_on(&cx, Buffer!::new().push_static("expected a brand such as $k, got ").push_bytes(&cx, write_form(&cx, form)).save(&cx), form);
    }
    form.text.skip(1usize)
}

forall 'k.
fn brands_of(&cx: Domain!['k], form: Form['k]) -> ArenaVec[Span['k], 'k] {
    let out: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
    var i = 0usize;
    while i < form.len(&cx) {
        out.push(&cx, brand_of(&cx, form.at(&cx, i)));
        i = i + 1usize;
    }
    out
}

// The decimal value of an atom.
forall 'k.
fn int_of(&cx: Domain!['k], form: Form['k]) -> usize {
    match parse_usize(&cx, form.text) {
        Some(n) => n,
        None => fail_text_on(&cx, Buffer!::new().push_bytes(&cx, write_form(&cx, form)).push_static(" is not a usize").save(&cx), form),
    }
}


forall 'k.
fn parse_types(&cx: Domain!['k], forms: ArenaVec[Form['k], 'k]) -> ArenaVec[Type['k], 'k] {
    let out: ArenaVec[Type['k], 'k] = ArenaVec::new(&cx);
    var i = 0usize;
    while i < forms.len(&cx) {
        out.push(&cx, parse_type(&cx, forms.at(&cx, i)));
        i = i + 1usize;
    }
    out
}

// `(name TYPE)` for each form: struct fields and enum variants.
forall 'k.
fn parse_members(&cx: Domain!['k], forms: ArenaVec[Form['k], 'k]) -> ArenaVec[Member['k], 'k] {
    let out: ArenaVec[Member['k], 'k] = ArenaVec::new(&cx);
    var i = 0usize;
    while i < forms.len(&cx) {
        let f = list_of(&cx, forms.at(&cx, i));
        let name = str_of(&cx, f.at(&cx, 0usize));
        out.push(&cx, Member.{ name, type: parse_type(&cx, f.at(&cx, 1usize)) });
        i = i + 1usize;
    }
    out
}

// `(name TYPE)` for each form: block parameters and function locals.
forall 'k.
fn parse_bindings(&cx: Domain!['k], forms: ArenaVec[Form['k], 'k]) -> ArenaVec[Binding['k], 'k] {
    let out: ArenaVec[Binding['k], 'k] = ArenaVec::new(&cx);
    var i = 0usize;
    while i < forms.len(&cx) {
        let p = list_of(&cx, forms.at(&cx, i));
        let name = str_of(&cx, p.at(&cx, 0usize));
        out.push(&cx, Binding.{ name, type: parse_type(&cx, p.at(&cx, 1usize)) });
        i = i + 1usize;
    }
    out
}

forall 'k.
fn parse_type(&cx: Domain!['k], form: Form['k]) -> Type['k] {
    if !form.is_list() {
        let t = form.text;
        if t.is(&cx, "_") {
            fail_on(&cx, "_ is not a type: a function value names every brand of its function", form);
        }
        if t.is(&cx, "!") {
            return Type::Never;
        }
        if t.starts_with(&cx, Span::from_static(&cx, "$")) {
            return Type::Skolem.(brand_of(&cx, form));
        }
        if C::is_prim(&cx, t) {
            return Type::Prim.(t);
        }
        return Type::Named.(t, ArenaVec::new(&cx));
    }
    if form.len(&cx) == 0usize {
        fail_on(&cx, "empty type", form);
    }
    let head = atom_of(&cx, form.at(&cx, 0usize)).text;
    let rest = form.items.skip(&cx, 1usize);
    if head.is(&cx, "struct") {
        return Type::Struct.(parse_members(&cx, rest));
    }
    if head.is(&cx, "enum") {
        return Type::Enum.(parse_members(&cx, rest));
    }
    if head.is(&cx, "tuple") {
        return Type::Tuple.(parse_types(&cx, rest));
    }
    if head.is(&cx, "array") {
        let elem = parse_type(&cx, rest.at(&cx, 0usize));
        return Type::Array.(Ref::new(&cx, elem), int_of(&cx, atom_of(&cx, rest.at(&cx, 1usize))) as u64);
    }
    if head.is(&cx, "ptr") {
        return C::ptr(&cx, parse_type(&cx, rest.at(&cx, 0usize)));
    }
    if head.is(&cx, "non_null") {
        return C::non_null(&cx, parse_type(&cx, rest.at(&cx, 0usize)));
    }
    if head.is(&cx, "brand") {
        return Type::Brand.(Ref::new(&cx, Type::Skolem.(brand_of(&cx, rest.at(&cx, 0usize)))));
    }
    if head.is(&cx, "exists") {
        let binders = brands_of(&cx, list_of(&cx, rest.at(&cx, 0usize)));
        return Type::Exists.(binders, Ref::new(&cx, parse_type(&cx, rest.at(&cx, 1usize))));
    }
    if head.is(&cx, "foreach") {
        return parse_foreach(&cx, form, rest);
    }
    if head.is(&cx, "fn") {
        return parse_fn_type(&cx, rest);
    }
    Type::Named.(head, parse_types(&cx, rest))
}

forall 'k.
fn parse_foreach(&cx: Domain!['k], form: Form['k], rest: ArenaVec[Form['k], 'k]) -> Type['k] {
    let pair = list_of(&cx, rest.at(&cx, 0usize));
    if pair.len(&cx) != 2usize {
        fail(&cx, Span::from_static(&cx, "internal error: a foreach pattern and source are two forms"));
    }
    let pattern = pair.at(&cx, 0usize);
    let source = pair.at(&cx, 1usize);
    let indirect = is_form_of(&cx, pattern, "ptr", 2usize);
    let binder = str_of(&cx, if indirect { list_of(&cx, pattern).at(&cx, 1usize) } else { pattern });
    if rest.len(&cx) != 2usize {
        fail_on(&cx, "foreach requires source and body", form);
    }
    let source = parse_type(&cx, source);
    let body = parse_type(&cx, rest.at(&cx, 1usize));
    C::foreach_type(&cx, binder, indirect, source, body)
}

forall 'k.
fn parse_fn_type(&cx: Domain!['k], rest: ArenaVec[Form['k], 'k]) -> Type['k] {
    let is_unsafe = is_form_of(&cx, rest.at(&cx, 0usize), "unsafe", 1usize);
    let rest = if is_unsafe { rest.skip(&cx, 1usize) } else { rest };
    let header = rest.at(&cx, 0usize);
    if is_form(&cx, header, "forall") {
        fail_on(&cx, "a function type quantifies nothing", header);
    }
    let p = parse_ptypes(&cx, header);
    C::fn_type(&cx, p.types, parse_type(&cx, rest.at(&cx, 1usize)), is_unsafe, p.places)
}

forall 'k.
exposed struct Ptypes {
    types: ArenaVec[Type['k], 'k],
    // indices of the place parameters, ascending
    places: ArenaVec[usize, 'k],
}

// A function type's or trait method's `(PTYPE*)`, where `(& T)` is a place parameter of type T.
forall 'k.
fn parse_ptypes(&cx: Domain!['k], form: Form['k]) -> Ptypes['k] {
    let forms = list_of(&cx, form);
    let types: ArenaVec[Type['k], 'k] = ArenaVec::new(&cx);
    let places: ArenaVec[usize, 'k] = ArenaVec::new(&cx);
    var i = 0usize;
    while i < forms.len(&cx) {
        let f = forms.at(&cx, i);
        if is_form_of(&cx, f, "&", 2usize) {
            places.push(&cx, i);
        }
        i = i + 1usize;
    }
    i = 0usize;
    while i < forms.len(&cx) {
        let f = forms.at(&cx, i);
        types.push(&cx, parse_type(&cx, if is_form_of(&cx, f, "&", 2usize) { f.at(&cx, 1usize) } else { f }));
        i = i + 1usize;
    }
    Ptypes.{ types, places }
}

forall 'k.
exposed struct Quantified {
    params: ArenaVec[Param['k], 'k],
    premises: ArenaVec[Premise['k], 'k],
}

// A `(forall (PARAM*) (PREMISE*) ...)` header; `(Copy T)` sets T's kind.
forall 'k.
fn parse_forall(&cx: Domain!['k], params_form: Form['k], premises_form: Form['k]) -> Quantified['k] {
    let all: ArenaVec[Premise['k], 'k] = ArenaVec::new(&cx);
    let premise_forms = list_of(&cx, premises_form);
    var i = 0usize;
    while i < premise_forms.len(&cx) {
        let p = list_of(&cx, premise_forms.at(&cx, i));
        let trait_name = str_of(&cx, p.at(&cx, 0usize));
        all.push(&cx, Premise.{ trait_name, args: parse_types(&cx, p.items.skip(&cx, 1usize)) });
        i = i + 1usize;
    }
    let copy: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
    i = 0usize;
    while i < all.len(&cx) {
        let p = all.at(&cx, i);
        if p.trait_name.is(&cx, "Copy") {
            if p.args.len(&cx) != 1usize {
                fail_on(&cx, "Copy requires a type parameter name", premises_form);
            }
            let name = match p.args.at(&cx, 0usize) {
                Named(name, args) => name,
                Prim(name) => name,
                _ => fail_on(&cx, "Copy requires a type parameter name", premises_form),
            };
            copy.push(&cx, name);
        }
        i = i + 1usize;
    }
    let param_forms = list_of(&cx, params_form);
    let names: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
    i = 0usize;
    while i < param_forms.len(&cx) {
        names.push(&cx, str_of(&cx, atom_of(&cx, param_forms.at(&cx, i))));
        i = i + 1usize;
    }
    i = 0usize;
    while i < copy.len(&cx) {
        if !names.contains(&cx, copy.at(&cx, i)) {
            fail_on(&cx, "Copy requires a type parameter name", premises_form);
        }
        i = i + 1usize;
    }
    let params: ArenaVec[Param['k], 'k] = ArenaVec::new(&cx);
    i = 0usize;
    while i < param_forms.len(&cx) {
        let a = atom_of(&cx, param_forms.at(&cx, i)).text;
        params.push(&cx, if a.starts_with(&cx, Span::from_static(&cx, "$")) {
            Param.{ name: a.skip(1usize), kind: Kind::Brand }
        } else {
            Param.{ name: a, kind: if copy.contains(&cx, a) { Kind::Copy } else { Kind::Any } }
        });
        i = i + 1usize;
    }
    let premises: ArenaVec[Premise['k], 'k] = ArenaVec::new(&cx);
    i = 0usize;
    while i < all.len(&cx) {
        if !all.at(&cx, i).trait_name.is(&cx, "Copy") {
            premises.push(&cx, all.at(&cx, i));
        }
        i = i + 1usize;
    }
    Quantified.{ params, premises }
}

forall 'k.
fn parse_edge(&cx: Domain!['k], target: Form['k], args: ArenaVec[Form['k], 'k]) -> Edge['k] {
    if target.is_list() {
        let name = str_of(&cx, target.at(&cx, 0usize));
        return Edge.{ target: name, args: strs(&cx, args), tys: parse_types(&cx, target.items.skip(&cx, 1usize)) };
    }
    Edge.{ target: str_of(&cx, target), args: strs(&cx, args), tys: ArenaVec::new(&cx) }
}

// An edge written as one list: `(TARGET ARG*)`.
forall 'k.
fn parse_edge_form(&cx: Domain!['k], form: Form['k]) -> Edge['k] {
    let target = list_of(&cx, form).at(&cx, 0usize);
    parse_edge(&cx, target, list_of(&cx, form).items.skip(&cx, 1usize))
}

forall 'k.
fn parse_term(&cx: Domain!['k], form: Form['k]) -> Terminator['k] {
    let form = list_of(&cx, form);
    let head = form.at(&cx, 0usize);
    let pos = form.pos;
    if is_word(&cx, head, "ret") {
        return Terminator::Ret.(str_of(&cx, form.at(&cx, 1usize)), pos);
    }
    if is_word(&cx, head, "unreachable") {
        return Terminator::Unreachable.(pos);
    }
    if is_word(&cx, head, "jmp") {
        return Terminator::Jmp.(parse_edge(&cx, form.at(&cx, 1usize), form.items.skip(&cx, 2usize)), pos);
    }
    if is_word(&cx, head, "jnz") {
        let cond = str_of(&cx, form.at(&cx, 1usize));
        let then = parse_edge_form(&cx, form.at(&cx, 2usize));
        return Terminator::Jnz.(cond, then, parse_edge_form(&cx, form.at(&cx, 3usize)), pos);
    }
    if is_word(&cx, head, "switch") {
        let arms: ArenaVec[Arm['k], 'k] = ArenaVec::new(&cx);
        var i = 3usize;
        while i < form.len(&cx) {
            let arm = list_of(&cx, form.at(&cx, i));
            let variant = atom_of(&cx, arm.at(&cx, 0usize)).text;
            arms.push(&cx, Arm.{ variant, edge: parse_edge(&cx, arm.at(&cx, 1usize), arm.items.skip(&cx, 2usize)) });
            i = i + 1usize;
        }
        let scrutinee = str_of(&cx, form.at(&cx, 1usize));
        return Terminator::Switch.(scrutinee, parse_type(&cx, form.at(&cx, 2usize)), arms, pos);
    }
    fail_text_on(&cx, Buffer!::new().push_static("unknown terminator ").push_bytes(&cx, write_form(&cx, head)).save(&cx), form)
}

forall 'k.
exposed struct Applied {
    name: Span['k],
    tys: ArenaVec[Type['k], 'k],
}

// `name` or `(name T*)`: a callee, mapper or function-value name.
forall 'k.
fn parse_applied(&cx: Domain!['k], form: Form['k]) -> Applied['k] {
    if form.is_list() {
        let name = str_of(&cx, form.at(&cx, 0usize));
        return Applied.{ name, tys: parse_types(&cx, form.items.skip(&cx, 1usize)) };
    }
    Applied.{ name: str_of(&cx, form), tys: ArenaVec::new(&cx) }
}

forall 'k.
fn make_instr(&cx: Domain!['k], lhs: ArenaVec[Span['k], 'k], op: Span['k], pos: Pos, args: ArenaVec[Span['k], 'k], ty: Option[Type['k]], tys: ArenaVec[Type['k], 'k], lit: Option[Span['k]]) -> Instr['k] {
    Instr.{ lhs, op, args, ty, tys, lit, is_unsafe: false, binders: ArenaVec::new(&cx), pos }
}

forall 'k.
fn parse_instr(&cx: Domain!['k], form: Form['k]) -> Instr['k] {
    let form = list_of(&cx, form);
    if is_form_of(&cx, form, "unsafe", 2usize) {
        let i = parse_instr(&cx, form.at(&cx, 1usize));
        return Instr.{ lhs: i.lhs, op: i.op, args: i.args, ty: i.ty, tys: i.tys, lit: i.lit, is_unsafe: true, binders: i.binders, pos: i.pos };
    }
    // selected evidence is not consumed yet
    let form = if form.len(&cx) == 4usize && is_form(&cx, form.at(&cx, 3usize), "evidence") {
        Form.{ kind: FormKind::List, text: form.text, items: form.items.slice(&cx, 0usize, 3usize), pos: form.pos }
    } else {
        form
    };
    if !is_form_of(&cx, form, "=", 3usize) || !form.at(&cx, 2usize).is_list() {
        fail_on(&cx, "an instruction is (= lhs (op arg*))", form);
    }
    let lhs_form = form.at(&cx, 1usize);
    let operation = list_of(&cx, form.at(&cx, 2usize));
    let lhs = if lhs_form.is_list() { strs(&cx, lhs_form.items) } else { ArenaVec::one(&cx, str_of(&cx, lhs_form)) };
    let op = str_of(&cx, operation.at(&cx, 0usize));
    let rest = operation.items.skip(&cx, 1usize);
    let pos = form.pos;
    let none: ArenaVec[Type['k], 'k] = ArenaVec::new(&cx);
    if op.is(&cx, "const") {
        let ty = parse_type(&cx, rest.at(&cx, 0usize));
        return make_instr(&cx, lhs, op, pos, ArenaVec::new(&cx), Option::Some.(ty), none, Option::Some.(str_of(&cx, rest.at(&cx, 1usize))));
    }
    if op.is(&cx, "construct") {
        let ty = parse_type(&cx, rest.at(&cx, 0usize));
        return make_instr(&cx, lhs, op, pos, strs(&cx, rest.skip(&cx, 1usize)), Option::Some.(ty), none, Option::None);
    }
    if op.is(&cx, "destruct") || op.is(&cx, "variant_tag") || op.is(&cx, "cast") || op.is(&cx, "int_cast")
        || op.is(&cx, "float_cast") || op.is(&cx, "to_ptr") {
        let args = ArenaVec::one(&cx, str_of(&cx, rest.at(&cx, 0usize)));
        return make_instr(&cx, lhs, op, pos, args, Option::Some.(parse_type(&cx, rest.at(&cx, 1usize))), none, Option::None);
    }
    if op.is(&cx, "construct_variant") {
        let ty = parse_type(&cx, rest.at(&cx, 0usize));
        let lit = str_of(&cx, rest.at(&cx, 1usize));
        return make_instr(&cx, lhs, op, pos, ArenaVec::one(&cx, str_of(&cx, rest.at(&cx, 2usize))), Option::Some.(ty), none, Option::Some.(lit));
    }
    if op.is(&cx, "alloca") || op.is(&cx, "sizeof") {
        return make_instr(&cx, lhs, op, pos, ArenaVec::new(&cx), Option::Some.(parse_type(&cx, rest.at(&cx, 0usize))), none, Option::None);
    }
    if op.is(&cx, "pack") {
        let witnesses = if rest.at(&cx, 1usize).is_list() { rest.at(&cx, 1usize).items } else { ArenaVec::one(&cx, rest.at(&cx, 1usize)) };
        let ty = parse_type(&cx, rest.at(&cx, 0usize));
        let tys = parse_types(&cx, witnesses);
        return make_instr(&cx, lhs, op, pos, ArenaVec::one(&cx, str_of(&cx, rest.at(&cx, 2usize))), Option::Some.(ty), tys, Option::None);
    }
    if op.is(&cx, "open") {
        let args = ArenaVec::one(&cx, str_of(&cx, rest.at(&cx, 0usize)));
        let binders = brands_of(&cx, list_of(&cx, rest.at(&cx, 1usize)));
        return Instr.{ lhs, op, args, ty: Option::None, tys: none, lit: Option::None, is_unsafe: false, binders, pos };
    }
    if op.is(&cx, "call") || op.is(&cx, "fn") {
        let callee = parse_applied(&cx, rest.at(&cx, 0usize));
        let args = ArenaVec::one(&cx, callee.name);
        args.append(&cx, strs(&cx, rest.skip(&cx, 1usize)));
        return make_instr(&cx, lhs, op, pos, args, Option::None, callee.tys, Option::None);
    }
    if op.is(&cx, "foreach") {
        let mapper = parse_applied(&cx, rest.at(&cx, 2usize));
        let ty = parse_type(&cx, rest.at(&cx, 0usize));
        let args = ArenaVec::two(&cx, str_of(&cx, rest.at(&cx, 1usize)), mapper.name);
        args.append(&cx, strs(&cx, rest.skip(&cx, 3usize)));
        return make_instr(&cx, lhs, op, pos, args, Option::Some.(ty), mapper.tys, Option::None);
    }
    if op.is(&cx, "trait_call") {
        let args = ArenaVec::two(&cx, str_of(&cx, rest.at(&cx, 0usize)), str_of(&cx, rest.at(&cx, 1usize)));
        args.append(&cx, strs(&cx, rest.skip(&cx, 3usize)));
        return make_instr(&cx, lhs, op, pos, args, Option::None, parse_types(&cx, list_of(&cx, rest.at(&cx, 2usize)).items), Option::None);
    }
    if C::atomic_kind(&cx, op).is_some() {
        let lit = str_of(&cx, rest.at(&cx, 0usize));
        return make_instr(&cx, lhs, op, pos, strs(&cx, rest.skip(&cx, 1usize)), Option::None, none, Option::Some.(lit));
    }
    make_instr(&cx, lhs, op, pos, strs(&cx, rest), Option::None, none, Option::None)
}

// A form is a block's brands: a non-empty list of atoms that start with `$`.
forall 'k.
fn is_brand_list(&cx: Domain!['k], form: Form['k]) -> bool {
    var all = form.is_list() && form.len(&cx) > 0usize;
    var i = 0usize;
    while all && i < form.len(&cx) {
        all = !form.at(&cx, i).is_list() && form.at(&cx, i).text.starts_with(&cx, Span::from_static(&cx, "$"));
        i = i + 1usize;
    }
    all
}

forall 'k.
fn parse_block(&cx: Domain!['k], form: Form['k]) -> Block['k] {
    let form = list_of(&cx, form);
    let label = str_of(&cx, form.at(&cx, 0usize));
    // `k` is the start of the rest of the block
    var k = 1usize;
    var brands: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
    if k < form.len(&cx) && is_brand_list(&cx, form.at(&cx, k)) {
        brands = brands_of(&cx, form.at(&cx, k));
        k = k + 1usize;
    }
    let params = parse_bindings(&cx, list_of(&cx, form.at(&cx, k)).items);
    k = k + 1usize;
    let empty: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
    let known: ArenaVec[Known['k], 'k] = ArenaVec::new(&cx);
    let opened: ArenaVec[Opened['k], 'k] = ArenaVec::new(&cx);
    while form.len(&cx) - k > 1usize && (is_form(&cx, form.at(&cx, k), "empty") || is_form(&cx, form.at(&cx, k), "known") || is_form(&cx, form.at(&cx, k), "opened")) {
        let clause = form.at(&cx, k);
        if is_word(&cx, clause.at(&cx, 0usize), "empty") {
            empty.append(&cx, strs(&cx, clause.items.skip(&cx, 1usize)));
        } else if is_word(&cx, clause.at(&cx, 0usize), "known") {
            known.push(&cx, Known.{ path: str_of(&cx, clause.at(&cx, 1usize)), variant: str_of(&cx, clause.at(&cx, 2usize)) });
        } else {
            if clause.len(&cx) != 3usize {
                fail_on(&cx, "an opened contract is (opened PLACE ($brand*))", clause);
            }
            let path = atom_of(&cx, clause.at(&cx, 1usize)).text;
            opened.push(&cx, Opened.{ path, brands: brands_of(&cx, list_of(&cx, clause.at(&cx, 2usize))) });
        }
        k = k + 1usize;
    }
    if k >= form.len(&cx) {
        // there is no terminator
        let unit = form.at(&cx, form.len(&cx));
    }
    let instrs: ArenaVec[Instr['k], 'k] = ArenaVec::new(&cx);
    while k + 1usize < form.len(&cx) {
        instrs.push(&cx, parse_instr(&cx, form.at(&cx, k)));
        k = k + 1usize;
    }
    let term = parse_term(&cx, form.at(&cx, k));
    Block.{ label, params, instrs, term, brands, empty, known, opened, pos: form.pos }
}

// `RET (PARAM-TYPES) (locals ...)? BLOCK+`, possibly forall-wrapped.
forall 'k.
fn parse_fun(&cx: Domain!['k], forms: ArenaVec[Form['k], 'k], name: Span['k], home: Option[ModuleId['k]], is_unsafe: bool, pos: Pos) -> Fun['k] {
    var params: ArenaVec[Param['k], 'k] = ArenaVec::new(&cx);
    var premises: ArenaVec[Premise['k], 'k] = ArenaVec::new(&cx);
    var forms = forms;
    let header = forms.at(&cx, 0usize);
    if is_form(&cx, header, "forall") {
        if forms.len(&cx) > 1usize {
            fail_on(&cx, "a generic function's blocks are inside its forall", forms.at(&cx, 1usize));
        }
        let q = parse_forall(&cx, header.at(&cx, 1usize), header.at(&cx, 2usize));
        params = q.params;
        premises = q.premises;
        forms = header.items.skip(&cx, 3usize);
    }
    var body = forms.skip(&cx, 2usize);
    var locals: ArenaVec[Binding['k], 'k] = ArenaVec::new(&cx);
    if body.len(&cx) > 0usize && is_form(&cx, body.at(&cx, 0usize), "locals") {
        locals = parse_bindings(&cx, body.at(&cx, 0usize).items.skip(&cx, 1usize));
        body = body.skip(&cx, 1usize);
    }
    if body.is_empty(&cx) {
        let message = Span::from_static(&cx, "a function needs an entry block");
        if pos.line == 0u32 { fail(&cx, message) } else { fail(&cx, located(&cx, message, pos)) }
    }
    let ret = parse_type(&cx, forms.at(&cx, 0usize));
    let ptypes = parse_types(&cx, list_of(&cx, forms.at(&cx, 1usize)).items);
    let blocks: ArenaVec[Block['k], 'k] = ArenaVec::new(&cx);
    var i = 0usize;
    while i < body.len(&cx) {
        blocks.push(&cx, parse_block(&cx, body.at(&cx, i)));
        i = i + 1usize;
    }
    Fun.{ name, params, premises, ret, ptypes, blocks, locals, is_unsafe, home, pos }
}

forall 'k.
fn parse_module(&cx: Domain!['k], form: Form['k]) -> ModuleId['k] {
    let form = list_of(&cx, form);
    ModuleId.{ package: int_of(&cx, atom_of(&cx, form.at(&cx, 1usize))), path: strs(&cx, form.items.skip(&cx, 2usize)) }
}

// A declaration's optional `(unsafe)` or `(in OWNER POLICY?)` clause, after its head.
forall 'k.
exposed struct Clause {
    rest: ArenaVec[Form['k], 'k],
    home: Option[ModuleId['k]],
    is_unsafe: bool,
    exposure: Option[Exposure['k]],
}

forall 'k.
fn parse_clause(&cx: Domain!['k], form: Form['k]) -> Clause['k] {
    let rest = form.items.skip(&cx, 1usize);
    let none = Option::None;
    if form.len(&cx) > 1usize && is_form_of(&cx, form.at(&cx, 1usize), "unsafe", 1usize) {
        return Clause.{ rest: rest.skip(&cx, 1usize), home: none, is_unsafe: true, exposure: Option::None };
    }
    if !(form.len(&cx) > 1usize && is_form(&cx, form.at(&cx, 1usize), "in")) {
        return Clause.{ rest, home: none, is_unsafe: false, exposure: Option::None };
    }
    let clause = form.at(&cx, 1usize);
    let home = parse_module(&cx, clause.at(&cx, 1usize));
    var is_unsafe = false;
    var exposure = Option::None;
    if clause.len(&cx) > 2usize {
        let policy = clause.at(&cx, 2usize);
        if is_word(&cx, policy, "abstract") {
            exposure = Option::Some.(Exposure.{ mode: ExposureMode::Owner, home });
        } else if is_form(&cx, policy, "exposed") {
            exposure = Option::Some.(Exposure.{ mode: ExposureMode::Within, home: parse_module(&cx, policy.at(&cx, 1usize)) });
        }
        is_unsafe = is_word(&cx, policy, "unsafe");
    }
    Clause.{ rest: rest.skip(&cx, 1usize), home: Option::Some.(home), is_unsafe, exposure }
}

forall 'k.
fn parse_program(&cx: Domain!['k], source: Span['k]) -> Program['k] {
    let program = Program::new(&cx);
    let top = read(&cx, source);
    var n = 0usize;
    while n < top.len(&cx) {
        let form = list_of(&cx, top.at(&cx, n));
        let clause = parse_clause(&cx, form);
        let rest = clause.rest;
        let home = clause.home;
        let head = form.at(&cx, 0usize);
        if is_word(&cx, head, "type") {
            let raw = str_of(&cx, rest.at(&cx, 0usize));
            var params: ArenaVec[Param['k], 'k] = ArenaVec::new(&cx);
            var premises: ArenaVec[Premise['k], 'k] = ArenaVec::new(&cx);
            var body = rest.at(&cx, 1usize);
            while is_form(&cx, body, "forall") {
                let q = parse_forall(&cx, body.at(&cx, 1usize), body.at(&cx, 2usize));
                params = params.clone(&cx);
                params.append(&cx, q.params);
                premises = premises.clone(&cx);
                premises.append(&cx, q.premises);
                body = body.at(&cx, 3usize);
            }
            program.types.insert(&cx, raw, TypeDecl.{ name: raw, params, premises, body: parse_type(&cx, body), home, exposure: clause.exposure });
        } else if is_word(&cx, head, "fun") {
            let name = str_of(&cx, rest.at(&cx, 0usize));
            program.funs.insert(&cx, name, parse_fun(&cx, rest.skip(&cx, 1usize), name, home, clause.is_unsafe, form.pos));
        } else if is_word(&cx, head, "extern") {
            if form.len(&cx) != 5usize || !is_word(&cx, form.at(&cx, 1usize), "fun") {
                fail_on(&cx, "an extern is (extern fun NAME RET (PTYPE*))", form);
            }
            let name = str_of(&cx, form.at(&cx, 2usize));
            let ret = parse_type(&cx, form.at(&cx, 3usize));
            let ptypes = parse_types(&cx, list_of(&cx, form.at(&cx, 4usize)).items);
            program.externs.insert(&cx, name, Extern.{ name, ret, ptypes, pos: form.pos });
        } else if is_word(&cx, head, "trait") {
            let methods: ArenaVec[Method['k], 'k] = ArenaVec::new(&cx);
            var i = 2usize;
            while i < rest.len(&cx) {
                let method = list_of(&cx, rest.at(&cx, i));
                let m_unsafe = is_form_of(&cx, method.at(&cx, 0usize), "unsafe", 1usize);
                let m = if m_unsafe { method.items.skip(&cx, 1usize) } else { method.items };
                let ret = parse_type(&cx, m.at(&cx, 1usize));
                let p = parse_ptypes(&cx, m.at(&cx, 2usize));
                methods.push(&cx, Method.{ name: str_of(&cx, m.at(&cx, 0usize)), ret, ptypes: p.types, is_unsafe: m_unsafe, places: p.places });
                i = i + 1usize;
            }
            let params = parse_forall(&cx, rest.at(&cx, 1usize), no_form(&cx)).params;
            let names: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
            let kinds: ArenaVec[Kind, 'k] = ArenaVec::new(&cx);
            i = 0usize;
            while i < params.len(&cx) {
                names.push(&cx, params.at(&cx, i).name);
                kinds.push(&cx, params.at(&cx, i).kind);
                i = i + 1usize;
            }
            let name = str_of(&cx, rest.at(&cx, 0usize));
            program.traits.insert(&cx, name, Trait.{ name, params: names, methods, home, param_kinds: kinds });
        } else if is_word(&cx, head, "instance") {
            var head_form = rest.at(&cx, 1usize);
            var params: ArenaVec[Param['k], 'k] = ArenaVec::new(&cx);
            var premises: ArenaVec[Premise['k], 'k] = ArenaVec::new(&cx);
            if is_form(&cx, head_form, "forall") {
                let q = parse_forall(&cx, head_form.at(&cx, 1usize), head_form.at(&cx, 2usize));
                params = q.params;
                premises = q.premises;
                head_form = head_form.at(&cx, 3usize);
            }
            let methods: ArenaVec[Fun['k], 'k] = ArenaVec::new(&cx);
            var i = 2usize;
            while i < rest.len(&cx) {
                let m = list_of(&cx, rest.at(&cx, i));
                let m_clause = parse_clause(&cx, m);
                let m_rest = m_clause.rest;
                let m_name = str_of(&cx, m_rest.at(&cx, 0usize));
                methods.push(&cx, parse_fun(&cx, m_rest.skip(&cx, 1usize), m_name, home, clause.is_unsafe || m_clause.is_unsafe, m.pos));
                i = i + 1usize;
            }
            let trait_name = str_of(&cx, rest.at(&cx, 0usize));
            let decl = Instance.{ trait_name, params, premises, head: parse_types(&cx, list_of(&cx, head_form).items), methods, home, pos: form.pos };
            match program.instances.get(&cx, trait_name) {
                Some(list) => list.push(&cx, decl),
                None => { program.instances.insert(&cx, trait_name, ArenaVec::one(&cx, decl)); },
            };
        } else if is_word(&cx, head, "data") {
            let name = str_of(&cx, rest.at(&cx, 0usize));
            program.datas.insert(&cx, name, Data.{ name, ty: parse_type(&cx, rest.at(&cx, 1usize)), init: rest.at(&cx, 2usize), home });
        } else {
            fail_text_on(&cx, Buffer!::new().push_static("unknown declaration ").push_bytes(&cx, write_form(&cx, head)).save(&cx), form);
        }
        n = n + 1usize;
    }
    program
}

// ---------------------------------------------------------------- writing --
//
// `write_program` is the inverse of `parse_program`: one top-level form per declaration, and in a
// function one block header, clause, instruction or terminator per line. Every part has one
// spelling, so equal programs are written as equal text.

forall 'k.
fn cannot(&cx: Domain!['k], what: Span['k]) -> ! {
    fail(&cx, Buffer!::new().push_static("cannot write ").push_bytes(&cx, what).push_static(" as KURS").save(&cx))
}

// `t` as a string literal.
forall 'k.
fn write_string(&cx: Domain!['k], t: Span['k]) -> Span['k] {
    var out = Buffer!::new().push_byte(b'"');
    var i = 0usize;
    while i < t.len() {
        let c = t.byte_or_zero(&cx, i);
        out = if c == b'\n' {
            out.push_static("\\n")
        } else if c == b'\t' {
            out.push_static("\\t")
        } else if c == b'\r' {
            out.push_static("\\r")
        } else if c == b'\\' || c == b'"' {
            out.push_byte(b'\\').push_byte(c)
        } else if c < 32u8 || c == 127u8 {
            hex_escape(&cx, out, c)
        } else {
            out.push_byte(c)
        };
        i = i + 1usize;
    }
    out.push_byte(b'"').save(&cx)
}

// `t` as an atom, or as a string literal when it is not a single word.
forall 'k.
fn write_atom(&cx: Domain!['k], t: Span['k]) -> Span['k] {
    var word = t.len() > 0usize;
    var i = 0usize;
    while word && i < t.len() {
        let c = t.byte_or_zero(&cx, i);
        word = !(c <= 32u8 || c == b'(' || c == b')' || c == b';' || c == b'"' || c == 127u8);
        i = i + 1usize;
    }
    if word { t } else { write_string(&cx, t) }
}

forall 'k.
fn form_text(&cx: Domain!['k], parts: ArenaVec[Span['k], 'k]) -> Span['k] {
    var out = Buffer!::new().push_byte(b'(');
    var i = 0usize;
    while i < parts.len(&cx) {
        if i > 0usize {
            out = out.push_byte(b' ');
        }
        out = out.push_bytes(&cx, parts.at(&cx, i));
        i = i + 1usize;
    }
    out.push_byte(b')').save(&cx)
}

// `(head part*)`
forall 'k.
fn headed(&cx: Domain!['k], head: Slice[u8, 'static], parts: ArenaVec[Span['k], 'k]) -> Span['k] {
    let all = ArenaVec::one(&cx, Span::from_static(&cx, head));
    all.append(&cx, parts);
    form_text(&cx, all)
}

forall 'k.
fn write_form(&cx: Domain!['k], form: Form['k]) -> Span['k] {
    match form.kind {
        List => {
            let parts: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
            var i = 0usize;
            while i < form.len(&cx) {
                parts.push(&cx, write_form(&cx, form.at(&cx, i)));
                i = i + 1usize;
            }
            form_text(&cx, parts)
        },
        Str => write_string(&cx, form.text),
        Atom => write_atom(&cx, form.text),
    }
}

forall 'k.
fn write_types(&cx: Domain!['k], types: ArenaVec[Type['k], 'k]) -> ArenaVec[Span['k], 'k] {
    let out: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
    var i = 0usize;
    while i < types.len(&cx) {
        out.push(&cx, write_type(&cx, types.at(&cx, i)));
        i = i + 1usize;
    }
    out
}

forall 'k.
fn atoms(&cx: Domain!['k], names: ArenaVec[Span['k], 'k]) -> ArenaVec[Span['k], 'k] {
    let out: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
    var i = 0usize;
    while i < names.len(&cx) {
        out.push(&cx, write_atom(&cx, names.at(&cx, i)));
        i = i + 1usize;
    }
    out
}

forall 'k.
fn brand_atom(&cx: Domain!['k], label: Span['k]) -> Span['k] {
    write_atom(&cx, Span::from_static(&cx, "$").concat(&cx, label))
}

forall 'k.
fn write_type(&cx: Domain!['k], ty: Type['k]) -> Span['k] {
    match ty {
        Never => Span::from_static(&cx, "!"),
        Skolem(label) => brand_atom(&cx, label),
        Prim(name) => name,
        Named(name, args) => if args.is_empty(&cx) {
            write_atom(&cx, name)
        } else {
            let parts = ArenaVec::one(&cx, write_atom(&cx, name));
            parts.append(&cx, write_types(&cx, args));
            form_text(&cx, parts)
        },
        Struct(fields) => headed(&cx, "struct", members(&cx, fields)),
        Enum(variants) => headed(&cx, "enum", members(&cx, variants)),
        Tuple(elems) => headed(&cx, "tuple", write_types(&cx, elems)),
        Array(elem, length) => headed(&cx, "array", ArenaVec::two(&cx, write_type(&cx, elem.copy(&cx)), Buffer!::new().push_u64(length).save(&cx))),
        Ptr(inner) => headed(&cx, "ptr", ArenaVec::one(&cx, write_type(&cx, inner.copy(&cx)))),
        NonNull(inner) => headed(&cx, "non_null", ArenaVec::one(&cx, write_type(&cx, inner.copy(&cx)))),
        Brand(brand) => match brand.copy(&cx) {
            Skolem(label) => headed(&cx, "brand", ArenaVec::one(&cx, brand_atom(&cx, label))),
            _ => cannot(&cx, Span::from_static(&cx, "a brand witness type of a brand that is not a variable")),
        },
        Exists(binders, body) => headed(&cx, "exists", ArenaVec::two(&cx, brands_text(&cx, binders), write_type(&cx, body.copy(&cx)))),
        Foreach(f) => write_foreach(&cx, f),
        Fn(f) => {
            let parts: ArenaVec[Span['k], 'k] = ArenaVec::one(&cx, Span::from_static(&cx, "fn"));
            if f.is_unsafe {
                parts.push(&cx, Span::from_static(&cx, "(unsafe)"));
            }
            parts.push(&cx, write_ptypes(&cx, f.params, f.places));
            parts.push(&cx, write_type(&cx, f.ret.copy(&cx)));
            form_text(&cx, parts)
        },
        Meta(m) => cannot(&cx, Span::from_static(&cx, "an inference variable")),
    }
}

forall 'k.
fn write_foreach(&cx: Domain!['k], f: ForeachType['k]) -> Span['k] {
    let pattern = if f.indirect { headed(&cx, "ptr", ArenaVec::one(&cx, write_atom(&cx, f.binder))) } else { write_atom(&cx, f.binder) };
    let parts = ArenaVec::one(&cx, Span::from_static(&cx, "foreach"));
    parts.push(&cx, form_text(&cx, ArenaVec::two(&cx, pattern, write_type(&cx, f.source.copy(&cx)))));
    parts.push(&cx, write_type(&cx, f.body.copy(&cx)));
    form_text(&cx, parts)
}

forall 'k.
fn brands_text(&cx: Domain!['k], labels: ArenaVec[Span['k], 'k]) -> Span['k] {
    let parts: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
    var i = 0usize;
    while i < labels.len(&cx) {
        parts.push(&cx, brand_atom(&cx, labels.at(&cx, i)));
        i = i + 1usize;
    }
    form_text(&cx, parts)
}

// `(name TYPE)` for each field or variant.
forall 'k.
fn members(&cx: Domain!['k], ms: ArenaVec[Member['k], 'k]) -> ArenaVec[Span['k], 'k] {
    let out: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
    var i = 0usize;
    while i < ms.len(&cx) {
        out.push(&cx, form_text(&cx, ArenaVec::two(&cx, write_atom(&cx, ms.at(&cx, i).name), write_type(&cx, ms.at(&cx, i).type))));
        i = i + 1usize;
    }
    out
}

// `(name TYPE)` for each parameter or local.
forall 'k.
fn bindings(&cx: Domain!['k], bs: ArenaVec[Binding['k], 'k]) -> ArenaVec[Span['k], 'k] {
    let out: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
    var i = 0usize;
    while i < bs.len(&cx) {
        out.push(&cx, form_text(&cx, ArenaVec::two(&cx, write_atom(&cx, bs.at(&cx, i).name), write_type(&cx, bs.at(&cx, i).type))));
        i = i + 1usize;
    }
    out
}

forall 'k.
fn write_ptypes(&cx: Domain!['k], ptypes: ArenaVec[Type['k], 'k], places: ArenaVec[usize, 'k]) -> Span['k] {
    let parts: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
    var i = 0usize;
    while i < ptypes.len(&cx) {
        let t = write_type(&cx, ptypes.at(&cx, i));
        parts.push(&cx, if places.contains(&cx, i) { form_text(&cx, ArenaVec::two(&cx, Span::from_static(&cx, "&"), t)) } else { t });
        i = i + 1usize;
    }
    form_text(&cx, parts)
}

// `forall (PARAM*) (PREMISE*)`, the start of a forall form; a Copy parameter has a `(Copy T)` premise.
forall 'k.
fn write_forall(&cx: Domain!['k], params: ArenaVec[Param['k], 'k], premises: ArenaVec[Premise['k], 'k]) -> Span['k] {
    let names: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
    let bounds: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
    var i = 0usize;
    while i < params.len(&cx) {
        let p = params.at(&cx, i);
        let unit = match p.kind {
            Brand => names.push(&cx, brand_atom(&cx, p.name)),
            Copy => {
                names.push(&cx, write_atom(&cx, p.name));
                bounds.push(&cx, form_text(&cx, ArenaVec::two(&cx, Span::from_static(&cx, "Copy"), write_atom(&cx, p.name))));
            },
            Any => names.push(&cx, write_atom(&cx, p.name)),
        };
        i = i + 1usize;
    }
    i = 0usize;
    while i < premises.len(&cx) {
        let parts = ArenaVec::one(&cx, write_atom(&cx, premises.at(&cx, i).trait_name));
        parts.append(&cx, write_types(&cx, premises.at(&cx, i).args));
        bounds.push(&cx, form_text(&cx, parts));
        i = i + 1usize;
    }
    Buffer!::new().push_static("forall ").push_bytes(&cx, form_text(&cx, names)).push_static(" ").push_bytes(&cx, form_text(&cx, bounds)).save(&cx)
}

// `name` or `(name T*)`: a callee, mapper, function-value name or edge target.
forall 'k.
fn applied_text(&cx: Domain!['k], name: Span['k], tys: ArenaVec[Type['k], 'k]) -> Span['k] {
    if tys.is_empty(&cx) {
        write_atom(&cx, name)
    } else {
        let parts = ArenaVec::one(&cx, write_atom(&cx, name));
        parts.append(&cx, write_types(&cx, tys));
        form_text(&cx, parts)
    }
}

forall 'k.
fn write_edge(&cx: Domain!['k], edge: Edge['k]) -> ArenaVec[Span['k], 'k] {
    let parts = ArenaVec::one(&cx, applied_text(&cx, edge.target, edge.tys));
    parts.append(&cx, atoms(&cx, edge.args));
    parts
}

forall 'k.
fn write_term(&cx: Domain!['k], term: Terminator['k]) -> Span['k] {
    match term {
        Ret(value, pos) => headed(&cx, "ret", ArenaVec::one(&cx, write_atom(&cx, value))),
        Unreachable(pos) => Span::from_static(&cx, "(unreachable)"),
        Jmp(edge, pos) => headed(&cx, "jmp", write_edge(&cx, edge)),
        Jnz(cond, then, other, pos) => {
            let parts = ArenaVec::two(&cx, write_atom(&cx, cond), form_text(&cx, write_edge(&cx, then)));
            parts.push(&cx, form_text(&cx, write_edge(&cx, other)));
            headed(&cx, "jnz", parts)
        },
        Switch(scrutinee, ty, arms, pos) => {
            let parts = ArenaVec::two(&cx, write_atom(&cx, scrutinee), write_type(&cx, ty));
            var i = 0usize;
            while i < arms.len(&cx) {
                let arm = arms.at(&cx, i);
                let edge = ArenaVec::one(&cx, write_atom(&cx, arm.variant));
                edge.append(&cx, write_edge(&cx, arm.edge));
                parts.push(&cx, form_text(&cx, edge));
                i = i + 1usize;
            }
            headed(&cx, "switch", parts)
        },
    }
}

forall 'k.
fn type_operand(&cx: Domain!['k], instr: Instr['k]) -> Span['k] {
    match instr.ty {
        Some(t) => write_type(&cx, t),
        None => cannot(&cx, instr.op.concat(&cx, Span::from_static(&cx, " without a type operand"))),
    }
}

forall 'k.
fn literal(&cx: Domain!['k], instr: Instr['k]) -> Span['k] {
    match instr.lit {
        Some(l) => write_atom(&cx, l),
        None => cannot(&cx, instr.op.concat(&cx, Span::from_static(&cx, " without a literal"))),
    }
}

forall 'k.
fn write_instr(&cx: Domain!['k], instr: Instr['k]) -> Span['k] {
    let op = instr.op;
    let args = atoms(&cx, instr.args);
    let operation = ArenaVec::one(&cx, op);
    if op.is(&cx, "const") {
        operation.push(&cx, type_operand(&cx, instr));
        operation.push(&cx, literal(&cx, instr));
    } else if op.is(&cx, "construct") {
        operation.push(&cx, type_operand(&cx, instr));
        operation.append(&cx, args);
    } else if op.is(&cx, "destruct") || op.is(&cx, "variant_tag") || op.is(&cx, "cast") || op.is(&cx, "int_cast")
        || op.is(&cx, "float_cast") || op.is(&cx, "to_ptr") {
        operation.push(&cx, args.at(&cx, 0usize));
        operation.push(&cx, type_operand(&cx, instr));
    } else if op.is(&cx, "construct_variant") {
        operation.push(&cx, type_operand(&cx, instr));
        operation.push(&cx, literal(&cx, instr));
        operation.push(&cx, args.at(&cx, 0usize));
    } else if op.is(&cx, "alloca") || op.is(&cx, "sizeof") {
        operation.push(&cx, type_operand(&cx, instr));
    } else if op.is(&cx, "pack") {
        operation.push(&cx, type_operand(&cx, instr));
        operation.push(&cx, form_text(&cx, write_types(&cx, instr.tys)));
        operation.push(&cx, args.at(&cx, 0usize));
    } else if op.is(&cx, "open") {
        operation.push(&cx, args.at(&cx, 0usize));
        operation.push(&cx, brands_text(&cx, instr.binders));
    } else if op.is(&cx, "call") || op.is(&cx, "fn") {
        operation.push(&cx, applied_text(&cx, instr.args.at(&cx, 0usize), instr.tys));
        operation.append(&cx, args.skip(&cx, 1usize));
    } else if op.is(&cx, "foreach") {
        operation.push(&cx, type_operand(&cx, instr));
        operation.push(&cx, args.at(&cx, 0usize));
        operation.push(&cx, applied_text(&cx, instr.args.at(&cx, 1usize), instr.tys));
        operation.append(&cx, args.skip(&cx, 2usize));
    } else if op.is(&cx, "trait_call") {
        operation.push(&cx, args.at(&cx, 0usize));
        operation.push(&cx, args.at(&cx, 1usize));
        operation.push(&cx, form_text(&cx, write_types(&cx, instr.tys)));
        operation.append(&cx, args.skip(&cx, 2usize));
    } else if C::atomic_kind(&cx, op).is_some() {
        operation.push(&cx, literal(&cx, instr));
        operation.append(&cx, args);
    } else {
        operation.append(&cx, args);
    }
    let lhs = if instr.lhs.len(&cx) == 1usize { write_atom(&cx, instr.lhs.at(&cx, 0usize)) } else { form_text(&cx, atoms(&cx, instr.lhs)) };
    let t = headed(&cx, "=", ArenaVec::two(&cx, lhs, form_text(&cx, operation)));
    if instr.is_unsafe { headed(&cx, "unsafe", ArenaVec::one(&cx, t)) } else { t }
}

// Appends `suffix` to the last line.
forall 'k.
fn close(&cx: Domain!['k], lines: ArenaVec[Span['k], 'k], suffix: Slice[u8, 'static]) {
    lines.set(&cx, lines.len(&cx) - 1usize, lines.at(&cx, lines.len(&cx) - 1usize).concat(&cx, Span::from_static(&cx, suffix)));
}

forall 'k.
fn indented(&cx: Domain!['k], indent: Span['k], line: Span['k]) -> Span['k] {
    indent.concat(&cx, line)
}

// The block's lines: its header, then its clauses, instructions and terminator, indented further.
forall 'k.
fn write_block(&cx: Domain!['k], block: Block['k], indent: Span['k]) -> ArenaVec[Span['k], 'k] {
    let header = ArenaVec::one(&cx, write_atom(&cx, block.label));
    if !block.brands.is_empty(&cx) {
        header.push(&cx, brands_text(&cx, block.brands));
    }
    header.push(&cx, form_text(&cx, bindings(&cx, block.params)));
    let inner = indent.concat(&cx, Span::from_static(&cx, "  "));
    let lines = ArenaVec::one(&cx, indent.concat(&cx, Span::from_static(&cx, "(")).concat(&cx, header.join(&cx, " ")));
    if !block.empty.is_empty(&cx) {
        lines.push(&cx, indented(&cx, inner, headed(&cx, "empty", atoms(&cx, block.empty))));
    }
    var i = 0usize;
    while i < block.known.len(&cx) {
        let k = block.known.at(&cx, i);
        lines.push(&cx, indented(&cx, inner, headed(&cx, "known", ArenaVec::two(&cx, write_atom(&cx, k.path), write_atom(&cx, k.variant)))));
        i = i + 1usize;
    }
    i = 0usize;
    while i < block.opened.len(&cx) {
        let o = block.opened.at(&cx, i);
        lines.push(&cx, indented(&cx, inner, headed(&cx, "opened", ArenaVec::two(&cx, write_atom(&cx, o.path), brands_text(&cx, o.brands)))));
        i = i + 1usize;
    }
    i = 0usize;
    while i < block.instrs.len(&cx) {
        lines.push(&cx, indented(&cx, inner, write_instr(&cx, block.instrs.at(&cx, i))));
        i = i + 1usize;
    }
    lines.push(&cx, indented(&cx, inner, write_term(&cx, block.term)));
    close(&cx, lines, ")");
    lines
}

// `(HEAD... NAME RET (PTYPES) (locals ...)? BLOCK+)`, forall-wrapped from RET on when generic.
forall 'k.
fn write_fun(&cx: Domain!['k], fun: Fun['k], head: ArenaVec[Span['k], 'k], indent: Span['k]) -> ArenaVec[Span['k], 'k] {
    let generic = !fun.params.is_empty(&cx) || !fun.premises.is_empty(&cx);
    let first = head.clone(&cx);
    first.push(&cx, write_atom(&cx, fun.name));
    if generic {
        first.push(&cx, Span::from_static(&cx, "(").concat(&cx, write_forall(&cx, fun.params, fun.premises)));
    }
    first.push(&cx, write_type(&cx, fun.ret));
    first.push(&cx, form_text(&cx, write_types(&cx, fun.ptypes)));
    let lines = ArenaVec::one(&cx, indent.concat(&cx, Span::from_static(&cx, "(")).concat(&cx, first.join(&cx, " ")));
    let inner = indent.concat(&cx, Span::from_static(&cx, "  "));
    if !fun.locals.is_empty(&cx) {
        lines.push(&cx, indented(&cx, inner, headed(&cx, "locals", bindings(&cx, fun.locals))));
    }
    var i = 0usize;
    while i < fun.blocks.len(&cx) {
        lines.append(&cx, write_block(&cx, fun.blocks.at(&cx, i), inner));
        i = i + 1usize;
    }
    close(&cx, lines, if generic { "))" } else { ")" });
    lines
}

forall 'k.
fn write_module(&cx: Domain!['k], home: ModuleId['k]) -> Span['k] {
    let parts = ArenaVec::two(&cx, Span::from_static(&cx, "module"), Buffer!::new().push_usize(home.package).save(&cx));
    parts.append(&cx, atoms(&cx, home.path));
    form_text(&cx, parts)
}

// The `(in MODULE POLICY?)` clause, if the declaration has a module.
forall 'k.
fn in_clause(&cx: Domain!['k], home: Option[ModuleId['k]], policy: Option[Span['k]]) -> ArenaVec[Span['k], 'k] {
    match home {
        None => ArenaVec::new(&cx),
        Some(m) => {
            let parts = ArenaVec::two(&cx, Span::from_static(&cx, "in"), write_module(&cx, m));
            let unit = match policy {
                Some(p) => parts.push(&cx, p),
                None => (),
            };
            ArenaVec::one(&cx, form_text(&cx, parts))
        },
    }
}

// A function's `(unsafe)` or `(in MODULE unsafe?)` clause.
forall 'k.
fn fun_clause(&cx: Domain!['k], home: Option[ModuleId['k]], is_unsafe: bool) -> ArenaVec[Span['k], 'k] {
    match home {
        None => if is_unsafe { ArenaVec::one(&cx, Span::from_static(&cx, "(unsafe)")) } else { ArenaVec::new(&cx) },
        Some(m) => in_clause(&cx, home, if is_unsafe { Option::Some.(Span::from_static(&cx, "unsafe")) } else { Option::None }),
    }
}

forall 'k.
fn same_module(&cx: Domain!['k], a: Option[ModuleId['k]], b: Option[ModuleId['k]]) -> bool {
    match a {
        None => b.is_none(),
        Some(x) => match b {
            Some(y) => x.package == y.package && x.path.eq(&cx, y.path),
            None => false,
        },
    }
}

forall 'k.
fn write_type_decl(&cx: Domain!['k], decl: TypeDecl['k]) -> Span['k] {
    var policy = Option::None;
    let unit = match decl.exposure {
        Some(e) => {
            let owner = match e.mode {
                Owner => true,
                Within => false,
            };
            if decl.home.is_none() || owner && !same_module(&cx, Option::Some.(e.home), decl.home) {
                cannot(&cx, Span::from_static(&cx, "the exposure of ").concat(&cx, decl.name));
            }
            policy = Option::Some.(if owner { Span::from_static(&cx, "abstract") } else { headed(&cx, "exposed", ArenaVec::one(&cx, write_module(&cx, e.home))) });
        },
        None => (),
    };
    var body = write_type(&cx, decl.body);
    if !decl.params.is_empty(&cx) || !decl.premises.is_empty(&cx) {
        body = Buffer!::new().push_static("(").push_bytes(&cx, write_forall(&cx, decl.params, decl.premises)).push_static(" ").push_bytes(&cx, body).push_static(")").save(&cx);
    }
    let parts = in_clause(&cx, decl.home, policy);
    parts.push(&cx, write_atom(&cx, decl.name));
    parts.push(&cx, body);
    headed(&cx, "type", parts)
}

forall 'k.
fn write_extern(&cx: Domain!['k], ext: Extern['k]) -> Span['k] {
    let parts = ArenaVec::two(&cx, Span::from_static(&cx, "fun"), write_atom(&cx, ext.name));
    parts.push(&cx, write_type(&cx, ext.ret));
    parts.push(&cx, form_text(&cx, write_types(&cx, ext.ptypes)));
    headed(&cx, "extern", parts)
}

forall 'k.
fn write_data(&cx: Domain!['k], data: Data['k]) -> Span['k] {
    let parts = in_clause(&cx, data.home, Option::None);
    parts.push(&cx, write_atom(&cx, data.name));
    parts.push(&cx, write_type(&cx, data.ty));
    parts.push(&cx, write_form(&cx, data.init));
    headed(&cx, "data", parts)
}

forall 'k.
fn write_trait(&cx: Domain!['k], tr: Trait['k]) -> ArenaVec[Span['k], 'k] {
    let params: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
    var i = 0usize;
    while i < tr.params.len(&cx) {
        let kind = if tr.param_kinds.is_empty(&cx) { Kind::Any } else { tr.param_kinds.at(&cx, i) };
        let unit = match kind {
            Brand => params.push(&cx, brand_atom(&cx, tr.params.at(&cx, i))),
            Copy => cannot(&cx, Span::from_static(&cx, "the Copy parameter of trait ").concat(&cx, tr.name)),
            Any => params.push(&cx, write_atom(&cx, tr.params.at(&cx, i))),
        };
        i = i + 1usize;
    }
    let first = ArenaVec::one(&cx, Span::from_static(&cx, "trait"));
    first.append(&cx, in_clause(&cx, tr.home, Option::None));
    first.push(&cx, write_atom(&cx, tr.name));
    first.push(&cx, form_text(&cx, params));
    let lines = ArenaVec::one(&cx, Span::from_static(&cx, "(").concat(&cx, first.join(&cx, " ")));
    i = 0usize;
    while i < tr.methods.len(&cx) {
        let m = tr.methods.at(&cx, i);
        let parts: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
        if m.is_unsafe {
            parts.push(&cx, Span::from_static(&cx, "(unsafe)"));
        }
        parts.push(&cx, write_atom(&cx, m.name));
        parts.push(&cx, write_type(&cx, m.ret));
        parts.push(&cx, write_ptypes(&cx, m.ptypes, m.places));
        lines.push(&cx, Span::from_static(&cx, "  ").concat(&cx, form_text(&cx, parts)));
        i = i + 1usize;
    }
    close(&cx, lines, ")");
    lines
}

forall 'k.
fn write_instance(&cx: Domain!['k], inst: Instance['k]) -> ArenaVec[Span['k], 'k] {
    var head = form_text(&cx, write_types(&cx, inst.head));
    if !inst.params.is_empty(&cx) || !inst.premises.is_empty(&cx) {
        head = Buffer!::new().push_static("(").push_bytes(&cx, write_forall(&cx, inst.params, inst.premises)).push_static(" ").push_bytes(&cx, head).push_static(")").save(&cx);
    }
    let first = ArenaVec::one(&cx, Span::from_static(&cx, "instance"));
    first.append(&cx, in_clause(&cx, inst.home, Option::None));
    first.push(&cx, write_atom(&cx, inst.trait_name));
    first.push(&cx, head);
    let lines = ArenaVec::one(&cx, Span::from_static(&cx, "(").concat(&cx, first.join(&cx, " ")));
    var i = 0usize;
    while i < inst.methods.len(&cx) {
        let method = inst.methods.at(&cx, i);
        if !same_module(&cx, method.home, inst.home) {
            cannot(&cx, Buffer!::new().push_static("the method ").push_bytes(&cx, method.name).push_static(" of an instance of ").push_bytes(&cx, inst.trait_name).push_static(" from another module").save(&cx));
        }
        let method_head = ArenaVec::one(&cx, Span::from_static(&cx, "fun"));
        if method.is_unsafe {
            method_head.push(&cx, Span::from_static(&cx, "(unsafe)"));
        }
        lines.append(&cx, write_fun(&cx, method, method_head, Span::from_static(&cx, "  ")));
        i = i + 1usize;
    }
    close(&cx, lines, ")");
    lines
}

// The program as KURS text that `parse_program` reads back into the same program.
forall 'k.
fn write_program(&cx: Domain!['k], program: Program['k]) -> Span['k] {
    let lines: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
    let types = program.types.values(&cx);
    var i = 0usize;
    while i < types.len(&cx) {
        lines.push(&cx, write_type_decl(&cx, types.at(&cx, i)));
        i = i + 1usize;
    }
    let funs = program.funs.values(&cx);
    i = 0usize;
    while i < funs.len(&cx) {
        let fun = funs.at(&cx, i);
        let head = ArenaVec::one(&cx, Span::from_static(&cx, "fun"));
        head.append(&cx, fun_clause(&cx, fun.home, fun.is_unsafe));
        lines.append(&cx, write_fun(&cx, fun, head, Span::from_static(&cx, "")));
        i = i + 1usize;
    }
    let externs = program.externs.values(&cx);
    i = 0usize;
    while i < externs.len(&cx) {
        lines.push(&cx, write_extern(&cx, externs.at(&cx, i)));
        i = i + 1usize;
    }
    let datas = program.datas.values(&cx);
    i = 0usize;
    while i < datas.len(&cx) {
        lines.push(&cx, write_data(&cx, datas.at(&cx, i)));
        i = i + 1usize;
    }
    let traits = program.traits.values(&cx);
    i = 0usize;
    while i < traits.len(&cx) {
        lines.append(&cx, write_trait(&cx, traits.at(&cx, i)));
        i = i + 1usize;
    }
    let instances = program.instances.values(&cx);
    i = 0usize;
    while i < instances.len(&cx) {
        var j = 0usize;
        while j < instances.at(&cx, i).len(&cx) {
            lines.append(&cx, write_instance(&cx, instances.at(&cx, i).at(&cx, j)));
            j = j + 1usize;
        }
        i = i + 1usize;
    }
    var out = Buffer!::new();
    i = 0usize;
    while i < lines.len(&cx) {
        out = out.push_bytes(&cx, lines.at(&cx, i)).push_byte(b'\n');
        i = i + 1usize;
    }
    out.save(&cx)
}
