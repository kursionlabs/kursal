// Frontend SSA promotion for roots whose types contain nongeneric brands.
//
// Place planning establishes which complete contents reach each edge. This pass threads those
// contents explicitly; it does not relax core local formation. Projected products are decomposed
// and rebuilt; lends use a generic value adapter. A switch on an enum among the contents switches on
// its value: each arm's block, entered by that arm alone, holds the variant's payload where its
// header knows the variant, and the enum is rebuilt where a whole value is needed. Opened root views
// require a further representation extension.

use std::collections::arena_vec::ArenaVec;
use std::collections::arena_map::{ArenaMap, ArenaSet};
use std::mem::Ref;
use std::raw::Span;
use std::alloc::arena::Domain!;
use std::bytes::buffer::Buffer!;
use package::check::checker::{ancestor_in, overlap};
use package::kurs::core::{Binding, Block, Edge, Fun, Instr, Kind, Param, Premise, Terminator, Type};
use package::kurs::core as C;
use package::resolve::resolver::Resolver;
use package::syntax::ast::Pos;
use package::types::ops::{Fresh, Types, free_brands, subst};
use std::option::Option;
use std::slice::Slice;

// The promotion of one function's branded roots.
forall 'k.
exposed struct Promotion {
    fun: Fun['k],
    types: Types['k],
    r: Resolver['k],
    counter: Fresh['k],
    params: ArenaVec[Param['k], 'k],
    premises: ArenaVec[Premise['k], 'k],
    value_types: ArenaMap[Span['k], Type['k], 'k],
    roots: ArenaMap[Span['k], Type['k], 'k],
    kinds: ArenaMap[Span['k], Kind, 'k],
    // SSA names in use
    taken: ArenaSet[Span['k], 'k],
    serial: Ref[u64, 'k],
    helpers: ArenaVec[Fun['k], 'k],
    // an exposed product path -> its components' paths and types
    shapes: ArenaMap[Span['k], ArenaVec[Binding['k], 'k], 'k],
    path_types: ArenaMap[Span['k], Type['k], 'k],
    // enum paths among the contents, whose variants' payloads are exposed
    sums: ArenaSet[Span['k], 'k],
    // block -> enum path known to hold a variant -> the variant
    refined: ArenaMap[Span['k], ArenaMap[Span['k], Span['k], 'k], 'k],
    // an arm's block -> (enum path switched on, its variant)
    arms: ArenaMap[Span['k], (Span['k], Span['k]), 'k],
    // an arm's block -> (payload path, the parameter holding it)
    payloads: ArenaMap[Span['k], (Span['k], Span['k]), 'k],
}

// One block being rewritten: the SSA value holding each leaf path, the loads replaced by those
// values, the new instructions, the brands open so far, and the enum paths known to hold a variant
// whose payload stands for them.
forall 'k.
exposed struct Rewrite {
    contents: ArenaMap[Span['k], Span['k], 'k],
    known: ArenaMap[Span['k], Span['k], 'k],
    aliases: ArenaMap[Span['k], Span['k], 'k],
    instructions: ArenaVec[Instr['k], 'k],
    brands: ArenaVec[Span['k], 'k],
}

forall 'k.
fn instr(&cx: Domain!['k], lhs: ArenaVec[Span['k], 'k], op: Slice[u8, 'static], args: ArenaVec[Span['k], 'k], ty: Option[Type['k]], pos: Pos) -> Instr['k] {
    Instr.{ lhs, op: Span::from_static(&cx, op), args, ty, tys: ArenaVec::new(&cx), lit: Option::None, is_unsafe: false, binders: ArenaVec::new(&cx), pos }
}

forall 'k.
fn root_of(&cx: Domain!['k], path: Span['k]) -> Span['k] {
    match path.find(&cx, Span::from_static(&cx, "."), 0usize) {
        Option::Some(at) => path.slice(0usize, at),
        Option::None => path,
    }
}

forall 'k.
fn last_segment(&cx: Domain!['k], path: Span['k]) -> Span['k] {
    match path.rfind_byte(&cx, b'.') {
        Option::Some(at) => path.skip(at + 1usize),
        Option::None => path,
    }
}

forall 'k.
fn child_of(&cx: Domain!['k], path: Span['k], label: Span['k]) -> Span['k] {
    Buffer!::new().push_bytes(&cx, path).push_static(".").push_bytes(&cx, label).save(&cx)
}

// Whether `path` lies under `parent`: `parent` and a `.` begin it.
forall 'k.
fn under(&cx: Domain!['k], path: Span['k], parent: Span['k]) -> bool {
    path.len() > parent.len() && path.starts_with(&cx, parent) && path.byte_or_zero(&cx, parent.len()) == b'.'
}

forall 'k.
fn parent_of(&cx: Domain!['k], path: Span['k]) -> Span['k] {
    match path.rfind_byte(&cx, b'.') {
        Option::Some(at) => path.slice(0usize, at),
        Option::None => path,
    }
}

forall 'k.
fn lends(&cx: Domain!['k], arg: Span['k]) -> bool {
    arg.starts_with(&cx, Span::from_static(&cx, "&")) && !arg.starts_with(&cx, Span::from_static(&cx, "&*"))
}

forall 'k.
impl Promotion['k] {
    fn fresh(self, &cx: Domain!['k]) -> Span['k] {
        var name = Span::from_static(&cx, "");
        var going = true;
        while going {
            name = Buffer!::new().push_static("%#contents").push_u64(self.serial.copy(&cx)).save(&cx);
            self.serial.set(&cx, self.serial.copy(&cx) + 1u64);
            going = self.taken.contains(&cx, name);
        }
        self.taken.insert(&cx, name);
        name
    }

    fn restricted(self, &cx: Domain!['k], path: Span['k]) -> bool {
        self.roots.contains(&cx, root_of(&cx, path))
    }

    fn unsupported(self, &cx: Domain!['k], path: Span['k]) -> ! {
        self.r.fail(&cx, Buffer!::new().push_static("frontend limitation: locally branded value ").push_bytes(&cx, path)
            .push_static(" requires structural SSA lowering; pass it by value to a generic function").save(&cx), self.fun.pos)
    }

    fn expose(self, &cx: Domain!['k], path: Span['k]) {
        if self.path_types.contains(&cx, path) {
            return;
        }
        let parent = parent_of(&cx, path);
        self.expose(&cx, parent);
        if !self.shapes.contains(&cx, parent) {
            let fields: ArenaVec[Binding['k], 'k] = ArenaVec::new(&cx);
            let shape = self.types.shape(&cx, self.path_types.at(&cx, parent), self.fun.home);
            match shape {
                Type::Enum(variants) => {
                    let label = last_segment(&cx, path);
                    var k = 0usize;
                    while k < variants.len(&cx) {
                        if variants.at(&cx, k).name.eq(&cx, label) {
                            self.sums.insert(&cx, parent);
                            // A later variant of the same name wins, as Python's dict does.
                            self.path_types.insert(&cx, path, variants.at(&cx, k).type);
                        }
                        k = k + 1usize;
                    }
                    if self.path_types.contains(&cx, path) {
                        return;
                    }
                },
                _ => (),
            };
            match shape {
                Type::Tuple(elems) => {
                    var k = 0usize;
                    while k < elems.len(&cx) {
                        fields.push(&cx, Binding.{ name: Buffer!::new().push_usize(k).save(&cx), type: elems.at(&cx, k) });
                        k = k + 1usize;
                    }
                },
                Type::Struct(members) => {
                    var k = 0usize;
                    while k < members.len(&cx) {
                        fields.push(&cx, Binding.{ name: members.at(&cx, k).name, type: members.at(&cx, k).type });
                        k = k + 1usize;
                    }
                },
                _ => self.unsupported(&cx, path),
            };
            let children: ArenaVec[Binding['k], 'k] = ArenaVec::new(&cx);
            var k = 0usize;
            while k < fields.len(&cx) {
                let child = Buffer!::new().push_bytes(&cx, parent).push_static(".").push_bytes(&cx, fields.at(&cx, k).name).save(&cx);
                children.push(&cx, Binding.{ name: child, type: fields.at(&cx, k).type });
                self.path_types.insert(&cx, child, fields.at(&cx, k).type);
                k = k + 1usize;
            }
            self.shapes.insert(&cx, parent, children);
        }
        if !self.path_types.contains(&cx, path) {
            self.unsupported(&cx, path);
        }
    }

    fn is_sum(self, &cx: Domain!['k], path: Span['k]) -> bool {
        match self.types.shape(&cx, self.path_types.at(&cx, path), self.fun.home) {
            Type::Enum(_variants) => true,
            _ => false,
        }
    }

    // A path the validation names in a block header: exposed, and recorded as refined when the header
    // knows its variant.
    fn header_path(self, &cx: Domain!['k], block: Block['k], path: Span['k]) {
        if !self.restricted(&cx, path) {
            return;
        }
        var k = 0usize;
        while k < block.opened.len(&cx) {
            if block.opened.at(&cx, k).path.eq(&cx, path) {
                self.unsupported(&cx, path);
            }
            k = k + 1usize;
        }
        self.expose(&cx, path);
        let refined = self.refined.at(&cx, block.label);
        k = 0usize;
        while k < block.known.len(&cx) {
            if block.known.at(&cx, k).path.eq(&cx, path) {
                let variant = block.known.at(&cx, k).variant;
                var nested = false;
                var q = 0usize;
                while q < refined.positions(&cx) {
                    match refined.key_at(&cx, q) {
                        Option::Some(other) => if under(&cx, path, other) {
                            nested = true;
                        },
                        Option::None => (),
                    };
                    q = q + 1usize;
                }
                if !self.is_sum(&cx, path) || nested {
                    self.unsupported(&cx, path);
                }
                refined.insert(&cx, path, variant);
                self.expose(&cx, child_of(&cx, path, variant));
            }
            k = k + 1usize;
        }
    }

    // Checks every use of a branded root before anything changes; opened roots need their own
    // representation.
    fn validate(self, &cx: Domain!['k]) {
        let entries: ArenaMap[Span['k], usize, 'k] = ArenaMap::new(&cx);
        var c = 0usize;
        while c < self.fun.blocks.len(&cx) {
            match self.fun.blocks.at(&cx, c).term {
                Terminator::Jmp(e, _p) => {
                    entries.insert(&cx, e.target, entries.get_or(&cx, e.target, 0usize) + 1usize);
                },
                Terminator::Jnz(_c, a, other, _p) => {
                    entries.insert(&cx, a.target, entries.get_or(&cx, a.target, 0usize) + 1usize);
                    entries.insert(&cx, other.target, entries.get_or(&cx, other.target, 0usize) + 1usize);
                },
                Terminator::Switch(_s, _t, arms, _p) => {
                    var k = 0usize;
                    while k < arms.len(&cx) {
                        let target = arms.at(&cx, k).edge.target;
                        entries.insert(&cx, target, entries.get_or(&cx, target, 0usize) + 1usize);
                        k = k + 1usize;
                    }
                },
                _ => (),
            };
            c = c + 1usize;
        }
        var b = 0usize;
        while b < self.fun.blocks.len(&cx) {
            let block = self.fun.blocks.at(&cx, b);
            self.refined.insert(&cx, block.label, ArenaMap::new(&cx));
            var i = 0usize;
            while i < block.empty.len(&cx) {
                self.header_path(&cx, block, block.empty.at(&cx, i));
                i = i + 1usize;
            }
            i = 0usize;
            while i < block.known.len(&cx) {
                self.header_path(&cx, block, block.known.at(&cx, i).path);
                i = i + 1usize;
            }
            i = 0usize;
            while i < block.opened.len(&cx) {
                self.header_path(&cx, block, block.opened.at(&cx, i).path);
                i = i + 1usize;
            }
            i = 0usize;
            while i < block.instrs.len(&cx) {
                let ins = block.instrs.at(&cx, i);
                var k = 0usize;
                while k < ins.args.len(&cx) {
                    let arg = ins.args.at(&cx, k);
                    if self.restricted(&cx, arg) {
                        let path_operand = k == 0usize && (ins.op.is(&cx, "load") || ins.op.is(&cx, "store") || ins.op.is(&cx, "destruct"));
                        if !(path_operand || ins.op.is(&cx, "call") || ins.op.is(&cx, "trait_call")) {
                            self.unsupported(&cx, arg);
                        }
                        self.expose(&cx, arg);
                    }
                    k = k + 1usize;
                }
                i = i + 1usize;
            }
            match block.term {
                Terminator::Switch(s, _t, arms, _p) => if self.restricted(&cx, s) {
                    self.expose(&cx, s);
                    if !self.is_sum(&cx, s) {
                        self.unsupported(&cx, s);
                    }
                    var k = 0usize;
                    while k < arms.len(&cx) {
                        let target = arms.at(&cx, k).edge.target;
                        if entries.get_or(&cx, target, 0usize) != 1usize || target.eq(&cx, block.label) {
                            self.unsupported(&cx, s);
                        }
                        self.arms.insert(&cx, target, (s, arms.at(&cx, k).variant));
                        k = k + 1usize;
                    }
                },
                _ => (),
            };
            b = b + 1usize;
        }
    }

    fn under_sum(self, &cx: Domain!['k], path: Span['k]) -> bool {
        var k = 0usize;
        while k < self.sums.positions(&cx) {
            match self.sums.key_at(&cx, k) {
                Option::Some(q) => if under(&cx, path, q) {
                    return true;
                },
                Option::None => (),
            };
            k = k + 1usize;
        }
        false
    }

    // Puts `path` among the contents whole, building it from its parts or its variant's payload.
    fn materialize(self, &cx: Domain!['k], w: Rewrite['k], path: Span['k]) {
        if !w.contents.contains(&cx, path) {
            let made = self.extract(&cx, w, path, false);
            w.contents.insert(&cx, path, made);
        }
    }

    fn read(self, &cx: Domain!['k], w: Rewrite['k], path: Span['k]) -> Span['k] {
        match w.contents.get(&cx, path) {
            Option::Some(v) => v,
            Option::None => self.r.fail(&cx, Buffer!::new().push_static("locally branded value ").push_bytes(&cx, path).push_static(" is unavailable").save(&cx), self.fun.pos),
        }
    }

    fn install(self, &cx: Domain!['k], w: Rewrite['k], path: Span['k], operand: Span['k]) {
        match self.shapes.get(&cx, path) {
            Option::Some(children) => {
                let names: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
                var k = 0usize;
                while k < children.len(&cx) {
                    names.push(&cx, self.fresh(&cx));
                    k = k + 1usize;
                }
                w.instructions.push(&cx, instr(&cx, names, "destruct", ArenaVec::one(&cx, operand), Option::Some.(self.path_types.at(&cx, path)), self.fun.pos));
                k = 0usize;
                while k < children.len(&cx) {
                    self.install(&cx, w, children.at(&cx, k).name, names.at(&cx, k));
                    k = k + 1usize;
                }
            },
            Option::None => { w.contents.insert(&cx, path, operand); },
        }
    }

    fn extract(self, &cx: Domain!['k], w: Rewrite['k], path: Span['k], copy: bool) -> Span['k] {
        match self.shapes.get(&cx, path) {
            Option::Some(children) => {
                let names: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
                var k = 0usize;
                while k < children.len(&cx) {
                    names.push(&cx, self.extract(&cx, w, children.at(&cx, k).name, copy));
                    k = k + 1usize;
                }
                let name = self.fresh(&cx);
                w.instructions.push(&cx, instr(&cx, ArenaVec::one(&cx, name), "construct", names, Option::Some.(self.path_types.at(&cx, path)), self.fun.pos));
                name
            },
            Option::None => {
                if !w.contents.contains(&cx, path) && w.known.contains(&cx, path) {
                    let variant = w.known.at(&cx, path);
                    let inner = self.extract(&cx, w, child_of(&cx, path, variant), copy);
                    let name = self.fresh(&cx);
                    w.instructions.push(&cx, Instr.{ lhs: ArenaVec::one(&cx, name), op: Span::from_static(&cx, "construct_variant"),
                        args: ArenaVec::one(&cx, inner), ty: Option::Some.(self.path_types.at(&cx, path)), tys: ArenaVec::new(&cx),
                        lit: Option::Some.(variant), is_unsafe: false, binders: ArenaVec::new(&cx), pos: self.fun.pos });
                    if !copy {
                        w.known.remove(&cx, path);
                    }
                    return name;
                }
                let name = self.read(&cx, w, path);
                if copy {
                    let copied = self.fresh(&cx);
                    w.instructions.push(&cx, instr(&cx, ArenaVec::one(&cx, copied), "copy", ArenaVec::one(&cx, name), Option::None, self.fun.pos));
                    return copied;
                }
                w.contents.remove(&cx, path);
                name
            },
        }
    }

    fn value(self, &cx: Domain!['k], w: Rewrite['k], name: Span['k]) -> Span['k] {
        if name.starts_with(&cx, Span::from_static(&cx, "&*")) {
            let inner = name.skip(2usize);
            return Buffer!::new().push_static("&*").push_bytes(&cx, w.aliases.get_or(&cx, inner, inner)).save(&cx);
        }
        w.aliases.get_or(&cx, name, name)
    }

    fn param_types(self, &cx: Domain!['k], ins: Instr['k], indirect: bool) -> ArenaVec[Type['k], 'k] {
        let program = self.types.program;
        let callee = ins.args.at(&cx, 0usize);
        let (names, types) = if ins.op.is(&cx, "trait_call") {
            let t = program.traits.at(&cx, callee);
            var found: Option[C::Method['k]] = Option::None;
            var m = 0usize;
            while found.is_none() && m < t.methods.len(&cx) {
                if t.methods.at(&cx, m).name.eq(&cx, ins.args.at(&cx, 1usize)) {
                    found = Option::Some.(t.methods.at(&cx, m));
                }
                m = m + 1usize;
            }
            let method = match found {
                Option::Some(x) => x,
                Option::None => self.r.fail(&cx, Span::from_static(&cx, "internal error: an unknown trait method"), ins.pos),
            };
            (t.params, method.ptypes)
        } else if indirect {
            match self.value_types.at(&cx, callee) {
                Type::Fn(f) => {
                    let names: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
                    var k = 0usize;
                    while k < f.quantified.len(&cx) {
                        names.push(&cx, f.quantified.at(&cx, k).name);
                        k = k + 1usize;
                    }
                    (names, f.params)
                },
                _ => self.r.fail(&cx, Span::from_static(&cx, "internal error: an indirect callee is not a function"), ins.pos),
            }
        } else {
            match program.externs.get(&cx, callee) {
                Option::Some(x) => {
                    return match x.ptypes {
                        Option::Some(ts) => ts,
                        Option::None => ArenaVec::new(&cx),
                    };
                },
                Option::None => (),
            };
            let target = program.funs.at(&cx, callee);
            let names: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
            var k = 0usize;
            while k < target.params.len(&cx) {
                names.push(&cx, target.params.at(&cx, k).name);
                k = k + 1usize;
            }
            (names, target.ptypes)
        };
        let sub: ArenaMap[Span['k], Type['k], 'k] = ArenaMap::new(&cx);
        var k = 0usize;
        while k < names.len(&cx) && k < ins.tys.len(&cx) {
            sub.insert(&cx, names.at(&cx, k), ins.tys.at(&cx, k));
            k = k + 1usize;
        }
        let out: ArenaVec[Type['k], 'k] = ArenaVec::new(&cx);
        k = 0usize;
        while k < types.len(&cx) {
            out.push(&cx, subst(&cx, types.at(&cx, k), sub, self.counter));
            k = k + 1usize;
        }
        out
    }

    // A call lending a branded place: a generic helper takes the place's contents by value, lends
    // them to the callee from its own slot, and hands them back with the result.
    fn adapt_call(self, &cx: Domain!['k], w: Rewrite['k], ins: Instr['k]) {
        let offset = if ins.op.is(&cx, "trait_call") { 2usize } else { 1usize };
        let operands = ins.args.skip(&cx, offset);
        let borrowed: ArenaVec[usize, 'k] = ArenaVec::new(&cx);
        let paths: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
        var k = 0usize;
        while k < operands.len(&cx) {
            let p = operands.at(&cx, k);
            if self.restricted(&cx, p) {
                borrowed.push(&cx, k);
            }
            if lends(&cx, p) {
                paths.push(&cx, p);
            }
            k = k + 1usize;
        }
        k = 0usize;
        while k < paths.len(&cx) {
            var j = k + 1usize;
            while j < paths.len(&cx) {
                if overlap(&cx, paths.at(&cx, k), paths.at(&cx, j)) {
                    self.r.fail(&cx, Span::from_static(&cx, "lent places overlap"), ins.pos);
                }
                j = j + 1usize;
            }
            k = k + 1usize;
        }
        let indirect = ins.op.is(&cx, "call") && ins.args.at(&cx, 0usize).starts_with(&cx, Span::from_static(&cx, "%"));
        let ptypes = self.param_types(&cx, ins, indirect);
        let result = self.value_types.at(&cx, ins.lhs.at(&cx, 0usize));
        let generic = self.params.clone(&cx);
        k = 0usize;
        while k < w.brands.len(&cx) {
            generic.push(&cx, Param.{ name: w.brands.at(&cx, k), kind: Kind::Brand });
            k = k + 1usize;
        }
        var name = Buffer!::new().push_bytes(&cx, self.fun.name).push_static("#lend").push_bytes(&cx, self.fresh(&cx).skip(1usize)).save(&cx);
        while self.types.program.funs.contains(&cx, name) {
            name = Buffer!::new().push_bytes(&cx, name).push_static("_").save(&cx);
        }
        let argument_names: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
        k = 0usize;
        while k < operands.len(&cx) {
            let p = operands.at(&cx, k);
            argument_names.push(&cx, Buffer!::new().push_static(if p.starts_with(&cx, Span::from_static(&cx, "&")) && !self.restricted(&cx, p) { "&a" } else { "%a" }).push_usize(k).save(&cx));
            k = k + 1usize;
        }
        let bindings: ArenaVec[Binding['k], 'k] = ArenaVec::new(&cx);
        k = 0usize;
        while k < argument_names.len(&cx) && k < ptypes.len(&cx) {
            bindings.push(&cx, Binding.{ name: argument_names.at(&cx, k), type: ptypes.at(&cx, k) });
            k = k + 1usize;
        }
        let actuals: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
        k = 0usize;
        while k < operands.len(&cx) {
            let p = operands.at(&cx, k);
            actuals.push(&cx, if self.restricted(&cx, p) { self.extract(&cx, w, p, false) } else { p });
            k = k + 1usize;
        }
        var head = ins.args.slice(&cx, 0usize, offset);
        if indirect {
            bindings.insert(&cx, 0usize, Binding.{ name: Span::from_static(&cx, "%callee"), type: self.value_types.at(&cx, ins.args.at(&cx, 0usize)) });
            actuals.insert(&cx, 0usize, ins.args.at(&cx, 0usize));
            head = ArenaVec::one(&cx, Span::from_static(&cx, "%callee"));
        }
        let locals: ArenaVec[Binding['k], 'k] = ArenaVec::new(&cx);
        let body: ArenaVec[Instr['k], 'k] = ArenaVec::new(&cx);
        let forwarded = argument_names.clone(&cx);
        k = 0usize;
        while k < borrowed.len(&cx) {
            let b = borrowed.at(&cx, k);
            let slot = Buffer!::new().push_static("&slot").push_usize(b).save(&cx);
            locals.push(&cx, Binding.{ name: slot, type: ptypes.at(&cx, b) });
            body.push(&cx, instr(&cx, ArenaVec::one(&cx, Buffer!::new().push_static("%unit").push_usize(b).save(&cx)), "store", ArenaVec::two(&cx, slot, argument_names.at(&cx, b)), Option::None, ins.pos));
            forwarded.set(&cx, b, slot);
            k = k + 1usize;
        }
        let call_args = head.clone(&cx);
        call_args.append(&cx, forwarded);
        body.push(&cx, Instr.{ lhs: ArenaVec::one(&cx, Span::from_static(&cx, "%result")), op: ins.op, args: call_args, ty: Option::None, tys: ins.tys,
            lit: Option::None, is_unsafe: ins.is_unsafe, binders: ArenaVec::new(&cx), pos: ins.pos });
        let never = match result {
            Type::Never => true,
            _ => false,
        };
        let (ret, term) = if never {
            (result, Terminator::Unreachable.(ins.pos))
        } else {
            let restored: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
            let elems: ArenaVec[Type['k], 'k] = ArenaVec::new(&cx);
            k = 0usize;
            while k < borrowed.len(&cx) {
                let b = borrowed.at(&cx, k);
                let n = Buffer!::new().push_static("%restored").push_usize(b).save(&cx);
                restored.push(&cx, n);
                elems.push(&cx, ptypes.at(&cx, b));
                body.push(&cx, instr(&cx, ArenaVec::one(&cx, n), "load", ArenaVec::one(&cx, Buffer!::new().push_static("&slot").push_usize(b).save(&cx)), Option::None, ins.pos));
                k = k + 1usize;
            }
            elems.push(&cx, result);
            let ret = Type::Tuple.(elems);
            restored.push(&cx, Span::from_static(&cx, "%result"));
            body.push(&cx, instr(&cx, ArenaVec::one(&cx, Span::from_static(&cx, "%out")), "construct", restored, Option::Some.(ret), ins.pos));
            (ret, Terminator::Ret.(Span::from_static(&cx, "%out"), ins.pos))
        };
        let ptys: ArenaVec[Type['k], 'k] = ArenaVec::new(&cx);
        k = 0usize;
        while k < bindings.len(&cx) {
            ptys.push(&cx, bindings.at(&cx, k).type);
            k = k + 1usize;
        }
        let entry = Block.{ label: Span::from_static(&cx, "entry"), params: bindings, instrs: body, term, brands: ArenaVec::new(&cx), empty: ArenaVec::new(&cx),
            known: ArenaVec::new(&cx), opened: ArenaVec::new(&cx), pos: Pos.{ line: 0u32, col: 0u32 } };
        self.helpers.push(&cx, Fun.{ name, params: generic, premises: self.premises, ret, ptypes: ptys, blocks: ArenaVec::one(&cx, entry), locals,
            is_unsafe: self.fun.is_unsafe || ins.is_unsafe, home: self.fun.home, pos: ins.pos });
        let tys: ArenaVec[Type['k], 'k] = ArenaVec::new(&cx);
        k = 0usize;
        while k < generic.len(&cx) {
            let p = generic.at(&cx, k);
            tys.push(&cx, if C::same_kind(p.kind, Kind::Brand) { Type::Skolem.(p.name) } else { Type::Named.(p.name, ArenaVec::new(&cx)) });
            k = k + 1usize;
        }
        let call_args = ArenaVec::one(&cx, name);
        call_args.append(&cx, actuals);
        if never {
            w.instructions.push(&cx, Instr.{ lhs: ins.lhs, op: Span::from_static(&cx, "call"), args: call_args, ty: Option::None, tys, lit: Option::None,
                is_unsafe: ins.is_unsafe, binders: ArenaVec::new(&cx), pos: ins.pos });
            return;
        }
        let output = self.fresh(&cx);
        w.instructions.push(&cx, Instr.{ lhs: ArenaVec::one(&cx, output), op: Span::from_static(&cx, "call"), args: call_args, ty: Option::None, tys, lit: Option::None,
            is_unsafe: ins.is_unsafe, binders: ArenaVec::new(&cx), pos: ins.pos });
        let replacements: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
        k = 0usize;
        while k < borrowed.len(&cx) {
            replacements.push(&cx, self.fresh(&cx));
            k = k + 1usize;
        }
        let lhs = replacements.clone(&cx);
        lhs.append(&cx, ins.lhs);
        w.instructions.push(&cx, instr(&cx, lhs, "destruct", ArenaVec::one(&cx, output), Option::Some.(ret), ins.pos));
        k = 0usize;
        while k < borrowed.len(&cx) {
            self.install(&cx, w, operands.at(&cx, borrowed.at(&cx, k)), replacements.at(&cx, k));
            k = k + 1usize;
        }
    }

    fn edge(self, &cx: Domain!['k], w: Rewrite['k], incoming: ArenaMap[Span['k], ArenaMap[Span['k], Span['k], 'k], 'k], e: Edge['k]) {
        let needed = incoming.at(&cx, e.target);
        var m = 0usize;
        while m < needed.positions(&cx) {
            match needed.key_at(&cx, m) {
                Option::Some(p) => self.materialize(&cx, w, p),
                Option::None => (),
            };
            m = m + 1usize;
        }
        var k = 0usize;
        while k < e.args.len(&cx) {
            e.args.set(&cx, k, self.value(&cx, w, e.args.at(&cx, k)));
            k = k + 1usize;
        }
        let wanted = incoming.at(&cx, e.target);
        k = 0usize;
        while k < wanted.positions(&cx) {
            match wanted.key_at(&cx, k) {
                Option::Some(p) => e.args.push(&cx, self.read(&cx, w, p)),
                Option::None => (),
            };
            k = k + 1usize;
        }
    }

    fn rewrite(self, &cx: Domain!['k], b: usize, incoming: ArenaMap[Span['k], ArenaMap[Span['k], Span['k], 'k], 'k]) {
        let block = self.fun.blocks.at(&cx, b);
        let w = Rewrite.{ contents: incoming.at(&cx, block.label).clone(&cx), known: self.refined.at(&cx, block.label).clone(&cx), aliases: ArenaMap::new(&cx),
            instructions: ArenaVec::new(&cx), brands: block.brands.clone(&cx) };
        match self.payloads.get(&cx, block.label) {
            Option::Some(found) => {
                let (path, name) = found;
                self.install(&cx, w, path, name);
            },
            Option::None => (),
        };
        var i = 0usize;
        while i < block.instrs.len(&cx) {
            let ins = block.instrs.at(&cx, i);
            var k = 0usize;
            while k < ins.args.len(&cx) {
                ins.args.set(&cx, k, self.value(&cx, w, ins.args.at(&cx, k)));
                k = k + 1usize;
            }
            if ins.op.is(&cx, "open") {
                w.brands.append(&cx, ins.binders);
            }
            let first = if ins.args.is_empty(&cx) { Span::from_static(&cx, "") } else { ins.args.at(&cx, 0usize) };
            if ins.op.is(&cx, "store") && self.restricted(&cx, first) {
                w.known.remove(&cx, first);
                self.install(&cx, w, first, ins.args.at(&cx, 1usize));
                w.instructions.push(&cx, instr(&cx, ins.lhs, "construct", ArenaVec::new(&cx), Option::Some.(C::unit(&cx)), ins.pos));
            } else if (ins.op.is(&cx, "load") || ins.op.is(&cx, "destruct")) && self.restricted(&cx, first) {
                let operand = self.extract(&cx, w, first, self.types.is_copy(&cx, self.path_types.at(&cx, first), self.kinds));
                if ins.op.is(&cx, "destruct") {
                    let { args: _old, ..rest } = ins;
                    w.instructions.push(&cx, Instr.{ args: ArenaVec::one(&cx, operand), ..rest });
                } else {
                    w.aliases.insert(&cx, ins.lhs.at(&cx, 0usize), operand);
                    self.value_types.insert(&cx, operand, self.path_types.at(&cx, first));
                }
            } else if (ins.op.is(&cx, "call") || ins.op.is(&cx, "trait_call")) && self.any_restricted(&cx, ins.args) {
                self.adapt_call(&cx, w, ins);
            } else {
                w.instructions.push(&cx, ins);
            }
            i = i + 1usize;
        }
        let term = match block.term {
            Terminator::Ret(v, p) => Terminator::Ret.(self.value(&cx, w, v), p),
            Terminator::Jmp(e, p) => {
                self.edge(&cx, w, incoming, e);
                Terminator::Jmp.(e, p)
            },
            Terminator::Jnz(c, a, other, p) => {
                let cond = self.value(&cx, w, c);
                self.edge(&cx, w, incoming, a);
                self.edge(&cx, w, incoming, other);
                Terminator::Jnz.(cond, a, other, p)
            },
            Terminator::Switch(s, t, arms, p) => {
                // The enum moves into the switch, and each arm's block holds its payload.
                let scrutinee = if self.restricted(&cx, s) { self.extract(&cx, w, s, false) } else { self.value(&cx, w, s) };
                var k = 0usize;
                while k < arms.len(&cx) {
                    self.edge(&cx, w, incoming, arms.at(&cx, k).edge);
                    k = k + 1usize;
                }
                Terminator::Switch.(scrutinee, t, arms, p)
            },
            Terminator::Unreachable(p) => Terminator::Unreachable.(p),
        };
        block.instrs.clear(&cx);
        block.instrs.append(&cx, w.instructions);
        let empty: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
        i = 0usize;
        while i < block.empty.len(&cx) {
            if !self.restricted(&cx, block.empty.at(&cx, i)) {
                empty.push(&cx, block.empty.at(&cx, i));
            }
            i = i + 1usize;
        }
        let known: ArenaVec[C::Known['k], 'k] = ArenaVec::new(&cx);
        i = 0usize;
        while i < block.known.len(&cx) {
            if !self.restricted(&cx, block.known.at(&cx, i).path) {
                known.push(&cx, block.known.at(&cx, i));
            }
            i = i + 1usize;
        }
        let { term: _t, empty: _e, known: _k, ..rest } = block;
        self.fun.blocks.set(&cx, b, Block.{ term, empty, known, ..rest });
    }

    fn any_restricted(self, &cx: Domain!['k], args: ArenaVec[Span['k], 'k]) -> bool {
        var k = 0usize;
        while k < args.len(&cx) {
            if self.restricted(&cx, args.at(&cx, k)) {
                return true;
            }
            k = k + 1usize;
        }
        false
    }
}

// Promotes `fun`'s roots whose types mention brands other than its parameters' (`params`, an
// instance's first) to SSA values, in place, and returns the lending helpers this needs.
// `value_types` holds the types of `fun`'s SSA values.
forall 'k.
fn promote_locals(&cx: Domain!['k], fun: Fun['k], types: Types['k], params: ArenaVec[Param['k], 'k], premises: ArenaVec[Premise['k], 'k], value_types: ArenaMap[Span['k], Type['k], 'k],
                  r: Resolver['k], counter: Fresh['k]) -> ArenaVec[Fun['k], 'k] {
    let allowed: ArenaSet[Span['k], 'k] = ArenaSet::new(&cx);
    let kinds: ArenaMap[Span['k], Kind, 'k] = ArenaMap::new(&cx);
    var i = 0usize;
    while i < params.len(&cx) {
        if C::same_kind(params.at(&cx, i).kind, Kind::Brand) {
            allowed.insert(&cx, params.at(&cx, i).name);
        }
        kinds.insert(&cx, params.at(&cx, i).name, params.at(&cx, i).kind);
        i = i + 1usize;
    }
    let roots: ArenaMap[Span['k], Type['k], 'k] = ArenaMap::new(&cx);
    i = 0usize;
    while i < fun.locals.len(&cx) {
        let brands = free_brands(&cx, fun.locals.at(&cx, i).type).keys(&cx);
        var k = 0usize;
        var outside = false;
        while k < brands.len(&cx) {
            outside = outside || !allowed.contains(&cx, brands.at(&cx, k));
            k = k + 1usize;
        }
        if outside {
            roots.insert(&cx, fun.locals.at(&cx, i).name, fun.locals.at(&cx, i).type);
        }
        i = i + 1usize;
    }
    if roots.is_empty(&cx) {
        return ArenaVec::new(&cx);
    }
    let taken: ArenaSet[Span['k], 'k] = ArenaSet::new(&cx);
    i = 0usize;
    while i < fun.blocks.len(&cx) {
        let block = fun.blocks.at(&cx, i);
        var k = 0usize;
        while k < block.params.len(&cx) {
            taken.insert(&cx, block.params.at(&cx, k).name);
            k = k + 1usize;
        }
        k = 0usize;
        while k < block.instrs.len(&cx) {
            let lhs = block.instrs.at(&cx, k).lhs;
            var j = 0usize;
            while j < lhs.len(&cx) {
                taken.insert(&cx, lhs.at(&cx, j));
                j = j + 1usize;
            }
            k = k + 1usize;
        }
        i = i + 1usize;
    }
    let p = Promotion.{ fun, types, r, counter, params, premises, value_types, roots, kinds, taken, serial: Ref::new(&cx, 0u64),
        helpers: ArenaVec::new(&cx), shapes: ArenaMap::new(&cx), path_types: roots.clone(&cx), sums: ArenaSet::new(&cx),
        refined: ArenaMap::new(&cx), arms: ArenaMap::new(&cx), payloads: ArenaMap::new(&cx) };
    p.validate(&cx);
    // the leaf paths: those not decomposed further
    let leaves: ArenaMap[Span['k], Type['k], 'k] = ArenaMap::new(&cx);
    let paths = p.path_types.keys(&cx);
    i = 0usize;
    while i < paths.len(&cx) {
        if !p.shapes.contains(&cx, paths.at(&cx, i)) && !p.under_sum(&cx, paths.at(&cx, i)) {
            leaves.insert(&cx, paths.at(&cx, i), p.path_types.at(&cx, paths.at(&cx, i)));
        }
        i = i + 1usize;
    }
    // the SSA parameter that brings each leaf's contents into each block
    let incoming: ArenaMap[Span['k], ArenaMap[Span['k], Span['k], 'k], 'k] = ArenaMap::new(&cx);
    i = 0usize;
    while i < fun.blocks.len(&cx) {
        let block = fun.blocks.at(&cx, i);
        // the leaves the block holds: an enum known to hold a variant by its payload
        let held = leaves.clone(&cx);
        let refined = p.refined.at(&cx, block.label);
        var r = 0usize;
        while r < refined.positions(&cx) {
            match refined.key_at(&cx, r) {
                Option::Some(q) => if held.contains(&cx, q) {
                    held.remove(&cx, q);
                    let payload = child_of(&cx, q, refined.at(&cx, q));
                    held.insert(&cx, payload, p.path_types.at(&cx, payload));
                },
                Option::None => (),
            };
            r = r + 1usize;
        }
        let leaf_paths = held.keys(&cx);
        let contents: ArenaMap[Span['k], Span['k], 'k] = ArenaMap::new(&cx);
        if i > 0usize {
            let empty: ArenaSet[Span['k], 'k] = ArenaSet::new(&cx);
            empty.insert_all(&cx, block.empty);
            var k = 0usize;
            while k < leaf_paths.len(&cx) {
                let leaf = leaf_paths.at(&cx, k);
                if !ancestor_in(&cx, empty, leaf) {
                    let v = p.fresh(&cx);
                    contents.insert(&cx, leaf, v);
                }
                k = k + 1usize;
            }
        }
        match p.arms.get(&cx, block.label) {
            Option::Some(arm) => {
                let (q, variant) = arm;
                let knows = match refined.get(&cx, q) {
                    Option::Some(v) => v.eq(&cx, variant),
                    Option::None => false,
                };
                if !knows {
                    p.unsupported(&cx, q);
                }
                let payload = child_of(&cx, q, variant);
                let name = match contents.remove(&cx, payload) {
                    Option::Some(v) => v,
                    Option::None => p.fresh(&cx),
                };
                p.payloads.insert(&cx, block.label, (payload, name));
                block.params.insert(&cx, 0usize, Binding.{ name, type: p.path_types.at(&cx, payload) });
            },
            Option::None => (),
        };
        var t = 0usize;
        while t < contents.positions(&cx) {
            match contents.key_at(&cx, t) {
                Option::Some(leaf) => block.params.push(&cx, Binding.{ name: contents.at(&cx, leaf), type: held.at(&cx, leaf) }),
                Option::None => (),
            };
            t = t + 1usize;
        }
        incoming.insert(&cx, block.label, contents);
        i = i + 1usize;
    }
    i = 0usize;
    while i < fun.blocks.len(&cx) {
        p.rewrite(&cx, i, incoming);
        i = i + 1usize;
    }
    let kept: ArenaVec[Binding['k], 'k] = ArenaVec::new(&cx);
    i = 0usize;
    while i < fun.locals.len(&cx) {
        if !roots.contains(&cx, fun.locals.at(&cx, i).name) {
            kept.push(&cx, fun.locals.at(&cx, i));
        }
        i = i + 1usize;
    }
    fun.locals.clear(&cx);
    fun.locals.append(&cx, kept);
    p.helpers
}
