// Lowering: inferred surface to KURS.
//
// Ordinary local variables start in places, with loads and stores, and explicit CFG contracts
// computed by forward dataflow (`placeflow`). A final frontend pass (`promote`) promotes roots whose
// contents mention nongeneric brands to SSA block arguments, decomposing projected products and
// generating generic value adapters for lending. Only function-generic brands may remain in core
// local declarations.
//
// `lower` first infers every function body in the resolved, signature-built graph. `FnLower` reads
// what inference found, by syntax node id: local uses and binders have matching ids, calls have
// targets, and closures have captures. Core types and call substitutions have their solved
// metavariables replaced. Annotations conditional on syntax (such as a struct spread's id) are read
// only for that form; lookup-only paths and folded constant subexpressions need no type.
//
// The result is a core program, ready for core checking before C emission.

use std::collections::arena_vec::ArenaVec;
use std::collections::arena_map::{ArenaMap, ArenaSet};
use std::mem::Ref;
use std::raw::Span;
use std::arena::{Domain!, ref_in, seed};
use std::buffer::Buffer!;
use package::check::checker::{checked_only, contains, function_types, is_never, overlap, pointer_cast_fits};
use package::kurs::core::{Block, Data, Edge, Extern, FnType, Fun, Instance, Instr, Kind, ModuleId, Param, Program, Terminator, Type};
use package::kurs::core as C;
use package::infer::inference::{Callee, Capture, Results, infer, pointer_params};
use package::types::literals::valid_literal;
use package::lower::placeflow::PlaceFlow;
use package::lower::promote::promote_locals;
use package::resolve::resolver::{NameRef, Named, Resolver, listed};
use package::kurs::sexpr::{Form, FormKind};
use package::sigs::signatures::{ConstValue, Sig, Signatures, binop_name, const_type, int_text};
use package::syntax::ast as S;
use package::syntax::ast::{Expr, Pattern, Pos, Statement, expr_id, expr_pos, no_pos};
use package::types::ops::{Fresh, Types, apart, brand_name, children, equal, foreach_item, free_brands, mapped_component, mapped_operand, mentions_brand, subst, surface};
use std::collections::hashmap::OwnedMap!;
use std::option::Option;
use std::slice::Slice;

// `e` as written, when it is a name and fields, `x` or `x.a.0`.
forall 'k.
fn written_place(&cx: Domain!['k], e: Expr['k]) -> Option[Span['k]] {
    match e {
        Path(p) => if p.segments.len(&cx) == 1usize && p.segments.at(&cx, 0usize).args.is_empty(&cx) {
            Option::Some.(p.segments.at(&cx, 0usize).name)
        } else {
            Option::None
        },
        Field(f) => match written_place(&cx, f.value.copy(&cx)) {
            Some(inner) => Option::Some.(Buffer!::new().push_bytes(&cx, inner).push_static(".").push_bytes(&cx, f.name).save(&cx)),
            None => Option::None,
        },
        _ => Option::None,
    }
}

// An operation that needs unsafe, as the source writes it: a read, a write, a volatile access or an
// atomic one through a raw pointer, or a call of `alloca`, `static_brand` or `fence`. A cast is not
// here: `expr_cast` says which casts need unsafe where the cast is written.
forall 'k.
fn unsafe_written(&cx: Domain!['k], op: Span['k]) -> Slice[u8, 'static] {
    if op.is(&cx, "ptr_load") {
        "reading through a raw pointer"
    } else if op.is(&cx, "ptr_store") {
        "writing through a raw pointer"
    } else if op.is(&cx, "ptr_load_volatile") {
        "a volatile read through a raw pointer"
    } else if op.is(&cx, "ptr_store_volatile") {
        "a volatile write through a raw pointer"
    } else if op.is(&cx, "alloca") {
        "calling alloca"
    } else if op.is(&cx, "static_brand") {
        "calling static_brand"
    } else if op.is(&cx, "fence") {
        "calling fence"
    } else {
        "an atomic access through a raw pointer"
    }
}

// An `Ordering` variant's core spelling.
forall 'k.
fn ordering_name(&cx: Domain!['k], variant: Span['k]) -> Option[Slice[u8, 'static]] {
    if variant.is(&cx, "Relaxed") {
        Option::Some.("relaxed")
    } else if variant.is(&cx, "Acquire") {
        Option::Some.("acquire")
    } else if variant.is(&cx, "Release") {
        Option::Some.("release")
    } else if variant.is(&cx, "AcqRel") {
        Option::Some.("acq_rel")
    } else if variant.is(&cx, "SeqCst") {
        Option::Some.("seq_cst")
    } else {
        Option::None
    }
}

forall 'k.
fn lends(&cx: Domain!['k], arg: Span['k]) -> bool {
    arg.starts_with(&cx, Span::from_static(&cx, "&")) && !arg.starts_with(&cx, Span::from_static(&cx, "&*"))
}

forall 'k.
fn is_unit(&cx: Domain!['k], t: Type['k]) -> bool {
    C::same(&cx, t, C::unit(&cx))
}

forall 'k.
fn id_text(&cx: Domain!['k], id: u32) -> Span['k] {
    Buffer!::new().push_u64(id as u64).save(&cx)
}

// ---------------------------------------------------------- match coverage --

// An integer of any primitive type: its sign and magnitude, zero never negative.
exposed struct Int {
    negative: bool,
    magnitude: u64,
}

forall 'k.
fn int_of(l: S::Lit['k]) -> Int {
    Int.{ negative: l.negative && l.int != 0u64, magnitude: l.int }
}

fn int_le(a: Int, b: Int) -> bool {
    if a.negative != b.negative {
        a.negative
    } else if a.negative {
        a.magnitude >= b.magnitude
    } else {
        a.magnitude <= b.magnitude
    }
}

fn int_eq(a: Int, b: Int) -> bool {
    a.negative == b.negative && a.magnitude == b.magnitude
}

forall 'k.
fn int_spelled(&cx: Domain!['k], a: Int) -> Span['k] {
    if a.negative {
        Buffer!::new().push_static("-").push_u64(a.magnitude).save(&cx)
    } else {
        Buffer!::new().push_u64(a.magnitude).save(&cx)
    }
}

// What a match arm covers: enum variant names, or integer ranges; nothing for the wildcard.
forall 'k.
exposed enum CoverItem {
    Variant(Span['k]),
    Range(Int, Int),
}

// ------------------------------------------------------------ the program --

// A source binding: a variable and the place that holds it, or a `..rest` bundle, whose fields are
// the ids of bindings.
forall 'k.
exposed struct Binding {
    name: Span['k],
    ty: Type['k],
    path: Option[Span['k]],
    fields: Option[ArenaMap[Span['k], Span['k], 'k]],
}

// A block under construction.
forall 'k.
exposed struct BlockB {
    label: Span['k],
    params: ArenaVec[C::Binding['k], 'k],
    instrs: ArenaVec[Instr['k], 'k],
    term: Ref[Option[Terminator['k]], 'k],
    brands: ArenaVec[Span['k], 'k],
}

// The program-wide state.
forall 'k.
exposed struct Lowering {
    r: Resolver['k],
    sigs: Signatures['k],
    results: Results['k],
    program: Program['k],
    types: Types['k],
    counter: Fresh['k],
    // string bytes -> the data holding them
    datas: ArenaMap[Span['k], Span['k], 'k],
    closures: Ref[u64, 'k],
    // a function with branded locals (by `fun_key`) -> the types of its SSA values, for promotion
    value_types: ArenaMap[usize, ArenaMap[Span['k], Type['k], 'k], 'k],
    // a function (by `fun_key`) -> where its paths meet in the source (`FnLower::sites`)
    sites: ArenaMap[usize, ArenaMap[Span['k], Span['k], 'k], 'k],
}

// `fun` with each package binder of a type it writes that would shadow a brand of `fun` renamed
// (`apart`).
forall 'k.
fn set_apart(&cx: Domain!['k], fun: Fun['k], outer: ArenaVec[Param['k], 'k], counter: Fresh['k]) -> Fun['k] {
    let scope: ArenaSet[Span['k], 'k] = ArenaSet::new(&cx);
    scope.insert(&cx, Span::from_static(&cx, "static"));
    let params = outer.concat(&cx, fun.params);
    var i = 0usize;
    while i < params.len(&cx) {
        if C::same_kind(params.at(&cx, i).kind, Kind::Brand) {
            scope.insert(&cx, params.at(&cx, i).name);
        }
        i = i + 1usize;
    }
    i = 0usize;
    while i < fun.blocks.len(&cx) {
        let block = fun.blocks.at(&cx, i);
        scope.insert_all(&cx, block.brands);
        var j = 0usize;
        while j < block.instrs.len(&cx) {
            scope.insert_all(&cx, block.instrs.at(&cx, j).binders);
            j = j + 1usize;
        }
        i = i + 1usize;
    }
    i = 0usize;
    while i < fun.ptypes.len(&cx) {
        fun.ptypes.set(&cx, i, apart(&cx, fun.ptypes.at(&cx, i), scope, counter));
        i = i + 1usize;
    }
    let ret = apart(&cx, fun.ret, scope, counter);
    i = 0usize;
    while i < fun.locals.len(&cx) {
        let local = fun.locals.at(&cx, i);
        fun.locals.set(&cx, i, C::Binding.{ name: local.name, ty: apart(&cx, local.ty, scope, counter) });
        i = i + 1usize;
    }
    i = 0usize;
    while i < fun.blocks.len(&cx) {
        let block = fun.blocks.at(&cx, i);
        var j = 0usize;
        while j < block.params.len(&cx) {
            let param = block.params.at(&cx, j);
            block.params.set(&cx, j, C::Binding.{ name: param.name, ty: apart(&cx, param.ty, scope, counter) });
            j = j + 1usize;
        }
        j = 0usize;
        while j < block.instrs.len(&cx) {
            let { ty, tys, ..rest } = block.instrs.at(&cx, j);
            let ty = match ty {
                Some(t) => Option::Some.(apart(&cx, t, scope, counter)),
                None => Option::None,
            };
            let written: ArenaVec[Type['k], 'k] = ArenaVec::new(&cx);
            var t = 0usize;
            while t < tys.len(&cx) {
                written.push(&cx, apart(&cx, tys.at(&cx, t), scope, counter));
                t = t + 1usize;
            }
            block.instrs.set(&cx, j, Instr.{ ty, tys: written, ..rest });
            j = j + 1usize;
        }
        let unit = match block.term {
            Switch(scrutinee, ty, arms, pos) => {
                let { term: _t, ..rest } = block;
                fun.blocks.set(&cx, i, Block.{ term: Terminator::Switch.(scrutinee, apart(&cx, ty, scope, counter), arms, pos), ..rest });
            },
            _ => (),
        };
        i = i + 1usize;
    }
    let { ret: _r, ..rest } = fun;
    Fun.{ ret, ..rest }
}

// A function's identity, as long as it lives: its block sequence's.
forall 'k.
fn fun_key(fun: Fun['k]) -> usize {
    fun.blocks.address()
}

forall 'k.
impl Lowering['k] {
    fn library_name(self, &cx: Domain!['k], name: Slice[u8, 'static], home: ModuleId['k]) -> Span['k] {
        self.sigs.name(&cx, self.sigs.library(&cx, home, Span::from_static(&cx, name)))
    }

    fn library_sig(self, &cx: Domain!['k], name: Slice[u8, 'static], home: ModuleId['k]) -> Sig['k] {
        self.sigs.sigs.at(&cx, self.sigs.library(&cx, home, Span::from_static(&cx, name)).id)
    }

    // The core's rules for an extern's signature (`Checker::foreign_signature`), at the source: it takes
    // no type or brand parameter and no place parameter, which foreign code cannot lend back, a
    // parameter has a memory form, the result holds nothing only checked code makes and no layout the
    // compiler chooses and is zero-size only if it is Copy, and every function type in it is an
    // `unsafe fn` type, whose parameters and result foreign code makes or takes as it does an extern's.
    // Each error is at the parameter or the result type it is about.
    fn foreign_signature(self, &cx: Domain!['k], node: S::Extern['k], sig: Sig['k]) {
        let name = node.name;
        if !sig.params.is_empty(&cx) {
            self.foreign_fail(&cx, name, " takes no type or brand parameters", no_pos());
        }
        var p = 0usize;
        while p < node.params.len(&cx) {
            let param = node.params.at(&cx, p);
            if param.lend {
                self.foreign_fail(&cx, name, " takes a place parameter; foreign code takes values", param.pos);
            }
            p = p + 1usize;
        }
        p = 0usize;
        while p < sig.ptypes.len(&cx) {
            if self.types.zero_size(&cx, sig.ptypes.at(&cx, p)) {
                self.foreign_fail(&cx, name, " takes a zero-size type, which has no memory form", node.params.at(&cx, p).pos);
            }
            p = p + 1usize;
        }
        if !is_never(sig.ret) && contains(&cx, self.types, sig.ret, |&cx, t: Type['k]| checked_only(t)) {
            self.foreign_fail(&cx, name, " cannot return a package, a brand witness, a safe function value, a transform or Never, which only checked code makes", node.ret_pos);
        }
        if self.types.chosen_layout(&cx, sig.ret) {
            self.foreign_fail(&cx, name, " cannot return an enum or a NonNull, whose layout the compiler chooses", node.ret_pos);
        }
        if !is_never(sig.ret) && self.types.zero_size(&cx, sig.ret) && !self.types.is_copy(&cx, sig.ret, ArenaMap::new(&cx)) {
            self.foreign_fail(&cx, name, " returns a zero-size linear type, which foreign code would make from nothing", node.ret_pos);
        }
        // Each part of the signature, a parameter's type or the result, with where it is written.
        let parts: ArenaVec[(Type['k], Pos), 'k] = ArenaVec::new(&cx);
        p = 0usize;
        while p < sig.ptypes.len(&cx) {
            parts.push(&cx, (sig.ptypes.at(&cx, p), node.params.at(&cx, p).pos));
            p = p + 1usize;
        }
        parts.push(&cx, (sig.ret, node.ret_pos));
        var q = 0usize;
        while q < parts.len(&cx) {
            let (part, pos) = parts.at(&cx, q);
            if function_types(&cx, self.types, part).any(&cx, |&cx, f: FnType['k]| !f.is_unsafe) {
                self.foreign_fail(&cx, name, " has a safe function type in its signature; foreign code makes and calls only unsafe fn values", pos);
            }
            q = q + 1usize;
        }
        q = 0usize;
        while q < parts.len(&cx) {
            let (part, pos) = parts.at(&cx, q);
            let functions = function_types(&cx, self.types, part);
            var f = 0usize;
            while f < functions.len(&cx) {
                let fun = functions.at(&cx, f);
                var k = 0usize;
                while k <= fun.params.len(&cx) {
                    let t = if k < fun.params.len(&cx) { fun.params.at(&cx, k) } else { fun.ret.copy(&cx) };
                    if k < fun.params.len(&cx) && self.types.zero_size(&cx, t) {
                        self.foreign_fail(&cx, name, " has an unsafe fn type in its signature that takes a zero-size type, which has no memory form", pos);
                    }
                    if contains(&cx, self.types, t, |&cx, u: Type['k]| checked_only(u)) {
                        self.foreign_fail(&cx, name, " has an unsafe fn type in its signature that takes or returns a package, a brand witness, a safe function value, a transform or Never, which only checked code makes", pos);
                    }
                    if self.types.chosen_layout(&cx, t) {
                        self.foreign_fail(&cx, name, " has an unsafe fn type in its signature that takes or returns an enum or a NonNull, whose layout the compiler chooses", pos);
                    }
                    k = k + 1usize;
                }
                let result = fun.ret.copy(&cx);
                if self.types.zero_size(&cx, result) && !self.types.is_copy(&cx, result, ArenaMap::new(&cx)) {
                    self.foreign_fail(&cx, name, " has an unsafe fn type in its signature that returns a zero-size linear type, which C's void would make vanish", pos);
                }
                f = f + 1usize;
            }
            q = q + 1usize;
        }
    }

    fn foreign_fail(self, &cx: Domain!['k], name: Span['k], message: Slice[u8, 'static], pos: Pos) -> ! {
        self.r.fail(&cx, Buffer!::new().push_static("extern ").push_bytes(&cx, name).push_static(message).save(&cx), pos)
    }

    fn run(self, &cx: Domain!['k]) -> Program['k] {
        let program = self.program;
        let sigs = self.sigs.sigs.values(&cx);
        var i = 0usize;
        while i < sigs.len(&cx) {
            let sig = sigs.at(&cx, i);
            match sig.decl {
                Some(decl) => match decl.node {
                    Extern(x) => if decl.kind.is(&cx, "extern") {
                        self.r.locate(&cx, decl.home, x.pos);
                        self.foreign_signature(&cx, x, sig);
                        self.r.unlocate(&cx);
                        program.externs.insert(&cx, x.name, Extern.{ name: x.name, ret: sig.ret, ptypes: sig.ptypes, pos: no_pos() });
                    },
                    Fn(node) => if node.body.is_some() {
                        self.r.locate(&cx, decl.home, node.pos);
                        let fun = FnLower::new(&cx, self, sig, Mode::Plain.(node), sig.name, node.pos).run(&cx);
                        self.r.unlocate(&cx);
                        program.funs.insert(&cx, sig.name, fun);
                    },
                    _ => (),
                },
                None => (),
            };
            i = i + 1usize;
        }
        i = 0usize;
        while i < self.sigs.instances.len(&cx) {
            let (inst, item, home) = self.sigs.instances.at(&cx, i);
            let methods: ArenaVec[Fun['k], 'k] = ArenaVec::new(&cx);
            var k = 0usize;
            while k < inst.methods.len(&cx) && k < item.methods.len(&cx) {
                let sig = inst.methods.at(&cx, k);
                let node = item.methods.at(&cx, k);
                self.r.locate(&cx, home, node.pos);
                let fun = FnLower::new(&cx, self, sig, Mode::Plain.(node), node.name, node.pos).run(&cx);
                self.r.unlocate(&cx);
                let { params: _p, premises: _q, ..rest } = fun;
                methods.push(&cx, Fun.{ params: sig.params.skip(&cx, inst.params.len(&cx)), premises: sig.premises.skip(&cx, inst.premises.len(&cx)), ..rest });
                k = k + 1usize;
            }
            let lowered = Instance.{ trait_name: inst.trait_name, params: inst.params, premises: inst.premises, head: inst.head, methods,
                home: Option::Some.(inst.home), pos: inst.pos };
            match program.instances.get(&cx, inst.trait_name) {
                Some(list) => list.push(&cx, lowered),
                None => { program.instances.insert(&cx, inst.trait_name, ArenaVec::one(&cx, lowered)); },
            };
            i = i + 1usize;
        }
        let flow = PlaceFlow::new(&cx, program, self.r, self.counter);
        // functions' formation errors are located in their files
        flow.checker.formation.reporter.set(&cx, Option::Some.(self.r));
        let funs = program.funs.values(&cx);
        i = 0usize;
        while i < funs.len(&cx) {
            let fun = self.plan(&cx, flow, funs.at(&cx, i), ArenaVec::new(&cx), ArenaVec::new(&cx));
            program.funs.insert(&cx, fun.name, fun);
            i = i + 1usize;
        }
        let groups = program.instances.values(&cx);
        i = 0usize;
        while i < groups.len(&cx) {
            let insts = groups.at(&cx, i);
            var k = 0usize;
            while k < insts.len(&cx) {
                let inst = insts.at(&cx, k);
                var m = 0usize;
                while m < inst.methods.len(&cx) {
                    inst.methods.set(&cx, m, self.plan(&cx, flow, inst.methods.at(&cx, m), inst.params, inst.premises));
                    m = m + 1usize;
                }
                k = k + 1usize;
            }
            i = i + 1usize;
        }
        program
    }

    // Plans `fun`'s place contracts, promotes its branded roots and sets its package binders apart:
    // the function that results. An instance method's `outer` parameters and premises are its
    // instance's.
    fn plan(self, &cx: Domain!['k], flow: PlaceFlow['k], fun: Fun['k], outer: ArenaVec[Param['k], 'k], outer_premises: ArenaVec[C::Premise['k], 'k]) -> Fun['k] {
        let located = match fun.home {
            Some(home) => {
                self.r.locate(&cx, home, fun.pos);
                true
            },
            None => false,
        };
        let key = fun_key(fun);
        flow.plan(&cx, fun, outer, self.sites.get_or(&cx, key, ArenaMap::new(&cx)));
        self.sites.remove(&cx, key);
        let params = outer.clone(&cx);
        params.append(&cx, fun.params);
        let premises = outer_premises.clone(&cx);
        premises.append(&cx, fun.premises);
        let value_types = self.value_types.get_or(&cx, key, ArenaMap::new(&cx));
        self.value_types.remove(&cx, key);
        let helpers = promote_locals(&cx, fun, self.types, params, premises, value_types, self.r, self.counter);
        var i = 0usize;
        while i < helpers.len(&cx) {
            let helper = set_apart(&cx, helpers.at(&cx, i), ArenaVec::new(&cx), self.counter);
            self.program.funs.insert(&cx, helper.name, helper);
            flow.checker.formation.function(&cx, helper, ArenaVec::new(&cx), ArenaVec::new(&cx));
            i = i + 1usize;
        }
        let fun = set_apart(&cx, fun, outer, self.counter);
        flow.checker.formation.function(&cx, fun, outer, outer_premises);
        if located {
            self.r.unlocate(&cx);
        }
        fun
    }

    // A static byte array holding `bytes` and a zero byte after them, so that it has an element even
    // for the empty string: its name and the length of `bytes`.
    fn data(self, &cx: Domain!['k], bytes: Span['k]) -> (Span['k], usize) {
        match self.datas.get(&cx, bytes) {
            Some(label) => return (label, bytes.len()),
            None => (),
        };
        let label = Buffer!::new().push_static("string#").push_usize(self.datas.len(&cx)).save(&cx);
        let item = Form.{ kind: FormKind::Str, text: bytes, items: ArenaVec::new(&cx), pos: no_pos() };
        let zero = Form.{ kind: FormKind::Atom, text: Span::from_static(&cx, "0"), items: ArenaVec::new(&cx), pos: no_pos() };
        let init = Form.{ kind: FormKind::List, text: Span::from_static(&cx, ""), items: ArenaVec::two(&cx, item, zero), pos: no_pos() };
        self.datas.insert(&cx, bytes, label);
        self.program.datas.insert(&cx, label, Data.{ name: label, ty: Type::Array.(ref_in(&cx, C::prim(&cx, "u8")), bytes.len() as u64 + 1u64), init, home: Option::None });
        (label, bytes.len())
    }
}

// --------------------------------------------------------- one function --

// What is being lowered: a function's body, a closure's (with its environment's type) or a foreach
// body's, the last two lifted out of the function containing them.
forall 'k.
exposed enum Mode {
    Plain(S::Fn['k]),
    Closure(S::Closure['k], Type['k]),
    Mapper(S::Foreach['k]),
}

// An operand to evaluate: an expression, a binding to read, or a place path or value already known.
forall 'k.
exposed enum Item {
    Expr(Expr['k]),
    Bind(Binding['k]),
    Path(Span['k]),
}

// What one arm of a branch evaluates.
forall 'k.
exposed enum ArmBody {
    Value(Expr['k]),
    Unit,
    Constant(Span['k]),
    // a constant the C compiler folds
    Folded(ConstValue['k]),
    // a match arm, its block, and the place a lent match switches on
    Case(S::Arm['k], BlockB['k], Option[Span['k]]),
}

// An instruction to emit: its operation, result type and arguments; the node it comes from, whose
// `unsafe` discharges it and whose position it takes; and its other parts.
forall 'k.
exposed struct Op {
    name: Span['k],
    rty: Type['k],
    args: ArenaVec[Span['k], 'k],
    node: Option[(u32, Pos)],
    discharged: bool,
    ty: Option[Type['k]],
    tys: ArenaVec[Type['k], 'k],
    lit: Option[Span['k]],
    binders: ArenaVec[Span['k], 'k],
    pos: Pos,
}

forall 'k.
impl Op['k] {
    fn new(&cx: Domain!['k], name: Slice[u8, 'static], rty: Type['k], args: ArenaVec[Span['k], 'k]) -> Op['k] {
        Op.{ name: Span::from_static(&cx, name), rty, args, node: Option::None, discharged: false, ty: Option::None, tys: ArenaVec::new(&cx),
            lit: Option::None, binders: ArenaVec::new(&cx), pos: no_pos() }
    }

    fn named(&cx: Domain!['k], name: Span['k], rty: Type['k], args: ArenaVec[Span['k], 'k]) -> Op['k] {
        let { name: _n, ..rest } = Op::new(&cx, "", rty, args);
        Op.{ name, ..rest }
    }

    fn typed(self, t: Type['k]) -> Op['k] {
        let { ty: _t, ..rest } = self;
        Op.{ ty: Option::Some.(t), ..rest }
    }

    fn with_tys(self, tys: ArenaVec[Type['k], 'k]) -> Op['k] {
        let { tys: _t, ..rest } = self;
        Op.{ tys, ..rest }
    }

    fn literal(self, lit: Span['k]) -> Op['k] {
        let { lit: _l, ..rest } = self;
        Op.{ lit: Option::Some.(lit), ..rest }
    }

    fn maybe_literal(self, lit: Option[Span['k]]) -> Op['k] {
        let { lit: _l, ..rest } = self;
        Op.{ lit, ..rest }
    }

    fn from_node(self, id: u32, pos: Pos) -> Op['k] {
        let { node: _n, ..rest } = self;
        Op.{ node: Option::Some.((id, pos)), ..rest }
    }

    fn discharge(self, yes: bool) -> Op['k] {
        let { discharged: _d, ..rest } = self;
        Op.{ discharged: yes, ..rest }
    }

    fn opening(self, binders: ArenaVec[Span['k], 'k]) -> Op['k] {
        let { binders: _b, ..rest } = self;
        Op.{ binders, ..rest }
    }

    fn located(self, pos: Pos) -> Op['k] {
        let { pos: _p, ..rest } = self;
        Op.{ pos, ..rest }
    }
}

// Translates one function, appending instructions to the current block. `cur` is none before the
// entry and after a terminator. `start` selects an open block; `terminate` closes it. Expression
// rules return a value name on paths that continue, including a constructed unit value for unit
// expressions; they return none when no path continues, leaving `cur` none.
forall 'k.
exposed struct FnLower {
    lowering: Lowering['k],
    sig: Sig['k],
    name: Span['k],
    home: ModuleId['k],
    node_pos: Pos,
    mode: Mode['k],
    kinds: ArenaMap[Span['k], Kind, 'k],
    // whether each type asked about is Copy
    copies: ArenaMap[Type['k], bool, 'k],
    blocks: ArenaVec[BlockB['k], 'k],
    cur: Ref[Option[BlockB['k]], 'k],
    vty: ArenaMap[Span['k], Type['k], 'k],
    bindings: ArenaMap[Span['k], Binding['k], 'k],
    locals: ArenaVec[C::Binding['k], 'k],
    open_brands: Ref[ArenaVec[Span['k], 'k], 'k],
    brand_map: Ref[ArenaMap[Span['k], Type['k], 'k], 'k],
    unsafe_nodes: ArenaSet[u32, 'k],
    lend_frames: ArenaVec[ArenaVec[Span['k], 'k], 'k],
    n: Ref[u64, 'k],
    at: Ref[Pos, 'k],
    // where paths meet, for place-flow messages: a block's label, or `source>target` for one edge, ->
    // where in the source
    sites: ArenaMap[Span['k], Span['k], 'k],
}

forall 'k.
impl FnLower['k] {
    fn new(&cx: Domain!['k], lowering: Lowering['k], sig: Sig['k], mode: Mode['k], name: Span['k], node_pos: Pos) -> FnLower['k] {
        let kinds: ArenaMap[Span['k], Kind, 'k] = ArenaMap::new(&cx);
        var i = 0usize;
        while i < sig.params.len(&cx) {
            kinds.insert(&cx, sig.params.at(&cx, i).name, sig.params.at(&cx, i).kind);
            i = i + 1usize;
        }
        let home = match sig.home {
            Some(m) => m,
            None => lowering.r.fail(&cx, Span::from_static(&cx, "internal error: a function without a module"), node_pos),
        };
        FnLower.{
            lowering, sig, name, home, node_pos, mode, kinds, copies: ArenaMap::new(&cx), blocks: ArenaVec::new(&cx), cur: ref_in(&cx, Option::None), vty: ArenaMap::new(&cx),
            bindings: ArenaMap::new(&cx), locals: ArenaVec::new(&cx), open_brands: ref_in(&cx, ArenaVec::new(&cx)), brand_map: ref_in(&cx, ArenaMap::new(&cx)),
            unsafe_nodes: ArenaSet::new(&cx), lend_frames: ArenaVec::new(&cx), n: ref_in(&cx, 0u64), at: ref_in(&cx, no_pos()),
            sites: ArenaMap::new(&cx),
        }
    }

    // ---- machinery
    fn fail(self, &cx: Domain!['k], message: Span['k], pos: Pos) -> ! {
        self.lowering.r.fail(&cx, message, pos)
    }

    fn fails(self, &cx: Domain!['k], message: Slice[u8, 'static], pos: Pos) -> ! {
        self.lowering.r.fail(&cx, Span::from_static(&cx, message), pos)
    }

    fn results(self) -> Results['k] {
        self.lowering.results
    }

    fn type_of(self, &cx: Domain!['k], id: u32) -> Type['k] {
        match self.lowering.results.types.get(&cx, id) {
            Some(t) => t,
            None => self.fails(&cx, "internal error: a node without a type", self.at.copy(&cx)),
        }
    }

    fn binder(self, &cx: Domain!['k], id: u32) -> Span['k] {
        id_text(&cx, self.lowering.results.binders.at(&cx, id))
    }

    fn current(self, &cx: Domain!['k]) -> BlockB['k] {
        match self.cur.copy(&cx) {
            Some(b) => b,
            None => self.fails(&cx, "internal error: no current block", self.at.copy(&cx)),
        }
    }

    fn live(self, &cx: Domain!['k]) -> bool {
        self.cur.copy(&cx).is_some()
    }

    fn fresh(self, &cx: Domain!['k], hint: Slice[u8, 'static]) -> Span['k] {
        self.n.set(&cx, self.n.copy(&cx) + 1u64);
        Buffer!::new().push_static("%").push_static(hint).push_u64(self.n.copy(&cx)).save(&cx)
    }

    fn lifted(self) -> bool {
        match self.mode {
            Plain(_f) => false,
            _ => true,
        }
    }

    // A lifted body's types may mention only the brands it may name: those of its function's
    // parameters, and those opened in it so far.
    fn substitute_type(self, &cx: Domain!['k], ty: Type['k]) -> Type['k] {
        let mapping = self.brand_map.copy(&cx);
        let t = if mapping.is_empty(&cx) { ty } else { subst(&cx, ty, mapping, self.lowering.counter) };
        if self.lifted() {
            self.check_closed(&cx, t, self.open_brands.copy(&cx));
        }
        t
    }

    fn substitute_all(self, &cx: Domain!['k], ts: ArenaVec[Type['k], 'k]) -> ArenaVec[Type['k], 'k] {
        let out: ArenaVec[Type['k], 'k] = ArenaVec::new(&cx);
        var i = 0usize;
        while i < ts.len(&cx) {
            out.push(&cx, self.substitute_type(&cx, ts.at(&cx, i)));
            i = i + 1usize;
        }
        out
    }

    fn copy(self, &cx: Domain!['k], ty: Type['k]) -> bool {
        match self.copies.get(&cx, ty) {
            Some(answer) => answer,
            None => {
                let answer = self.lowering.types.is_copy(&cx, ty, self.kinds);
                self.copies.insert(&cx, ty, answer);
                answer
            },
        }
    }

    fn authorized(self, &cx: Domain!['k], id: u32) -> bool {
        self.unsafe_nodes.contains(&cx, id)
    }

    fn emit(self, &cx: Domain!['k], o: Op['k]) -> Span['k] {
        let pos = if o.pos.line != 0u32 {
            o.pos
        } else {
            match o.node {
                Some(node) => {
                    let (_id, p) = node;
                    p
                },
                None => self.at.copy(&cx),
            }
        };
        if o.name.is(&cx, "const") {
            match o.ty {
                Some(t) => match t {
                    Prim(prim) => match o.lit {
                        Some(lit) => if !valid_literal(&cx, t, lit) {
                            self.fail(&cx, Buffer!::new().push_static("literal ").push_bytes(&cx, lit).push_static(" does not fit ").push_bytes(&cx, prim).save(&cx),
                                if pos.line != 0u32 { pos } else { self.at.copy(&cx) });
                        },
                        None => (),
                    },
                    _ => (),
                },
                None => (),
            };
        }
        let name = self.fresh(&cx, "v");
        if o.name.is(&cx, "call") || o.name.is(&cx, "trait_call") {
            var f = 0usize;
            while f < self.lend_frames.len(&cx) {
                let frame = self.lend_frames.at(&cx, f);
                var k = 0usize;
                while k < o.args.len(&cx) {
                    if lends(&cx, o.args.at(&cx, k)) {
                        frame.push(&cx, o.args.at(&cx, k));
                    }
                    k = k + 1usize;
                }
                f = f + 1usize;
            }
        }
        let marked = match o.node {
            Some(node) => {
                let (id, _p) = node;
                self.unsafe_nodes.contains(&cx, id)
            },
            None => false,
        };
        let discharged = o.discharged || marked;
        if C::is_unsafe_op(&cx, o.name) && !discharged {
            self.fail(&cx, Buffer!::new().push_static(unsafe_written(&cx, o.name)).push_static(" needs unsafe").save(&cx), pos);
        }
        if C::is_unsafe_op(&cx, o.name) {
            self.memory_operation(&cx, o, pos);
        }
        self.current(&cx).instrs.push(&cx, Instr.{ lhs: ArenaVec::one(&cx, name), op: o.name, args: o.args, ty: o.ty, tys: o.tys, lit: o.lit,
            is_unsafe: discharged, binders: o.binders, pos });
        self.vty.insert(&cx, name, o.rty);
        name
    }

    // The core's rules for an unsafe operation on memory, which an `unsafe` marker does not lift: a
    // read through a pointer does not produce a value that holds Never; a cast does not conjure what
    // only a checked operation makes, nor reinterpret a layout the compiler chooses, nor take or
    // produce a zero-size type, which has no representation to reinterpret, nor convert a pointer but
    // to or from a pointer or an integer; an atomic operation works on an integer, a bool or a
    // pointer. A load, store or `alloca` is never at a zero-size type, which has no memory to touch:
    // it needs `Sized` of the type, so `Sized[T]` at a type parameter `T`, as nothing is checked at an
    // instantiation.
    fn memory_operation(self, &cx: Domain!['k], o: Op['k], pos: Pos) {
        let target = if o.args.is_empty(&cx) { Option::None } else { self.vty.get(&cx, o.args.at(&cx, 0usize)) };
        let pointee = match target {
            Some(t) => match t {
                Ptr(inner) => Option::Some.(inner.copy(&cx)),
                _ => Option::None,
            },
            None => Option::None,
        };
        let op = o.name;
        let load = op.is(&cx, "ptr_load") || op.is(&cx, "ptr_load_volatile");
        let accessed = if op.is(&cx, "alloca") {
            o.ty
        } else if load || op.is(&cx, "ptr_store") || op.is(&cx, "ptr_store_volatile") {
            pointee
        } else {
            Option::None
        };
        match accessed {
            Some(inner) => {
                if load && contains(&cx, self.lowering.types, inner, |&cx, t: Type['k]| is_never(t)) {
                    self.fail(&cx, Span::from_static(&cx, "an unsafe read cannot produce a value that holds Never"), pos);
                }
                self.raw_access(&cx, inner, pos);
                return;
            },
            None => (),
        };
        if op.is(&cx, "cast") {
            match target {
                Some(from) => match o.ty {
                    Some(to) => self.cast_operation(&cx, from, to, pos),
                    None => (),
                },
                None => (),
            };
        } else {
            match C::atomic_kind(&cx, op) {
                Some(kind) => match pointee {
                    Some(inner) => self.atomic_operation(&cx, kind, inner, pos),
                    None => (),
                },
                None => (),
            };
        }
    }

    // A raw read, write, `alloca` or lend of a raw pointer's target is at a `Sized` type, never a
    // zero-size one (`Checker::raw_access`).
    fn raw_access(self, &cx: Domain!['k], ty: Type['k], pos: Pos) {
        if !self.lowering.types.sized_available(&cx, ty, self.sig.premises) {
            if self.lowering.types.closed(&cx, ty) {
                self.fail(&cx, Span::from_static(&cx, "a raw read, write or alloca at a zero-size type"), pos);
            }
            let written = surface(&cx, ArenaVec::one(&cx, ty), ArenaVec::new(&cx), ArenaMap::new(&cx)).show(&cx, ty);
            self.fail(&cx, Buffer!::new().push_static("a raw read, write or alloca at ").push_bytes(&cx, written)
                .push_static(" needs Sized[").push_bytes(&cx, written).push_static("]").save(&cx), pos);
        }
    }

    fn cast_operation(self, &cx: Domain!['k], from: Type['k], to: Type['k], pos: Pos) {
        let types = self.lowering.types;
        if contains(&cx, types, from, |&cx, t: Type['k]| self.uncastable(&cx, t))
            || contains(&cx, types, to, |&cx, t: Type['k]| self.uncastable(&cx, t)) {
            self.fail(&cx, Span::from_static(&cx, "an unsafe cast cannot produce or take apart a package, a brand witness, a function value, a transform, a value of a type parameter or Never"), pos);
        }
        if types.zero_size(&cx, from) || types.zero_size(&cx, to) {
            self.fail(&cx, Span::from_static(&cx, "a zero-size type has no memory form"), pos);
        }
        if is_non_null(from) || is_non_null(to) {
            if !(is_pointer(from) && is_pointer(to)) {
                self.fail(&cx, Span::from_static(&cx, "an unsafe cast converts a NonNull only to or from a pointer"), pos);
            }
        } else if types.chosen_layout(&cx, from) || types.chosen_layout(&cx, to) {
            self.fail(&cx, Span::from_static(&cx, "an unsafe cast cannot reinterpret an enum or a NonNull, whose layout the compiler chooses"), pos);
        } else if !pointer_cast_fits(&cx, types, from, to) {
            self.fail(&cx, Span::from_static(&cx, "an unsafe cast converts a pointer only to or from a pointer or an integer"), pos);
        }
    }

    fn atomic_operation(self, &cx: Domain!['k], kind: Span['k], inner: Type['k], pos: Pos) {
        let integer = match inner {
            Prim(name) => C::is_integer(&cx, name),
            _ => false,
        };
        if kind.starts_with(&cx, Span::from_static(&cx, "fetch_")) && !integer {
            self.fail(&cx, Buffer!::new().push_static("atomic ").push_bytes(&cx, kind).push_static(" works on a pointer to an integer").save(&cx), pos);
        }
        let pointer = match inner {
            Ptr(_x) => true,
            _ => false,
        };
        if !(integer || C::same(&cx, inner, C::bool_type(&cx)) || pointer) {
            self.fail(&cx, Buffer!::new().push_static("atomic ").push_bytes(&cx, kind).push_static(" works on a pointer to an integer, a bool or a pointer").save(&cx), pos);
        }
    }

    // What no unsafe cast may conjure in a value: a package, a brand witness, a function value, a
    // transform, a value of a type parameter, or Never.
    fn uncastable(self, &cx: Domain!['k], ty: Type['k]) -> bool {
        match ty {
            Exists(_binders, _body) => true,
            Brand(_brand) => true,
            Fn(_f) => true,
            Foreach(_f) => true,
            Never => true,
            Named(name, args) => args.is_empty(&cx) && self.kinds.contains(&cx, name),
            _ => false,
        }
    }

    fn unit(self, &cx: Domain!['k]) -> Span['k] {
        self.emit(&cx, Op::new(&cx, "construct", C::unit(&cx), ArenaVec::new(&cx)).typed(C::unit(&cx)))
    }

    fn constant(self, &cx: Domain!['k], ty: Type['k], lit: Span['k]) -> Span['k] {
        self.emit(&cx, Op::new(&cx, "const", ty, ArenaVec::new(&cx)).typed(ty).literal(lit))
    }

    fn destruct(self, &cx: Domain!['k], value: Span['k], ty: Type['k]) -> ArenaVec[C::Binding['k], 'k] {
        let comps = self.lowering.types.fields(&cx, ty, Option::None);
        let names: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
        let out: ArenaVec[C::Binding['k], 'k] = ArenaVec::new(&cx);
        var i = 0usize;
        while i < comps.len(&cx) {
            let n = self.fresh(&cx, "c");
            names.push(&cx, n);
            out.push(&cx, C::Binding.{ name: n, ty: comps.at(&cx, i) });
            i = i + 1usize;
        }
        self.current(&cx).instrs.push(&cx, Instr.{ lhs: names, op: Span::from_static(&cx, "destruct"), args: ArenaVec::one(&cx, value), ty: Option::Some.(ty), tys: ArenaVec::new(&cx),
            lit: Option::None, is_unsafe: false, binders: ArenaVec::new(&cx), pos: self.at.copy(&cx) });
        i = 0usize;
        while i < comps.len(&cx) {
            self.vty.insert(&cx, names.at(&cx, i), comps.at(&cx, i));
            i = i + 1usize;
        }
        out
    }

    fn block_named(self, &cx: Domain!['k], label: Span['k], params: ArenaVec[C::Binding['k], 'k]) -> BlockB['k] {
        let block = BlockB.{ label, params, instrs: ArenaVec::new(&cx), term: ref_in(&cx, Option::None), brands: self.open_brands.copy(&cx).clone(&cx) };
        self.blocks.push(&cx, block);
        block
    }

    fn new_block(self, &cx: Domain!['k], params: ArenaVec[C::Binding['k], 'k], hint: Slice[u8, 'static]) -> BlockB['k] {
        self.n.set(&cx, self.n.copy(&cx) + 1u64);
        self.block_named(&cx, Buffer!::new().push_static(hint).push_u64(self.n.copy(&cx)).save(&cx), params)
    }

    fn start(self, &cx: Domain!['k], block: BlockB['k]) {
        self.cur.set(&cx, Option::Some.(block));
        var i = 0usize;
        while i < block.params.len(&cx) {
            self.vty.insert(&cx, block.params.at(&cx, i).name, block.params.at(&cx, i).ty);
            i = i + 1usize;
        }
        self.open_brands.set(&cx, block.brands.clone(&cx));
    }

    fn terminate(self, &cx: Domain!['k], term: Terminator['k]) {
        self.current(&cx).term.set(&cx, Option::Some.(term));
        self.cur.set(&cx, Option::None);
    }

    fn edge(self, &cx: Domain!['k], block: BlockB['k], extra: ArenaVec[Span['k], 'k]) -> Edge['k] {
        let tys: ArenaVec[Type['k], 'k] = ArenaVec::new(&cx);
        var i = 0usize;
        while i < block.brands.len(&cx) {
            tys.push(&cx, Type::Skolem.(block.brands.at(&cx, i)));
            i = i + 1usize;
        }
        Edge.{ target: block.label, args: extra, tys }
    }

    fn jump(self, &cx: Domain!['k], block: BlockB['k], extra: ArenaVec[Span['k], 'k]) {
        self.terminate(&cx, Terminator::Jmp.(self.edge(&cx, block, extra), self.at.copy(&cx)));
    }

    fn local_ref(self, &cx: Domain!['k], p: S::Path['k]) -> bool {
        match self.lowering.r.refs.get(&cx, p.id) {
            Some(r) => match r {
                Local(_n) => true,
                _ => false,
            },
            None => false,
        }
    }

    fn temporary(self, &cx: Domain!['k], ty: Type['k]) -> Span['k] {
        let root = Buffer!::new().push_static("&#tmp").push_usize(self.locals.len(&cx)).save(&cx);
        self.locals.push(&cx, C::Binding.{ name: root, ty: ty });
        root
    }

    fn value(self, &cx: Domain!['k], item: Item['k]) -> Option[Span['k]] {
        match item {
            Bind(b) => Option::Some.(self.read(&cx, b)),
            Path(t) => Option::Some.(t),
            Expr(e) => self.expr(&cx, e),
        }
    }

    // Evaluates strictly left to right. Items are expressions, bindings to read, or already resolved
    // place paths. A value preceding another operand waits in a temporary place, then is reloaded
    // in the final block. Calls (`call`) interpret explicit lends. A plain read of a place that the
    // same group lends is rejected, whatever its type: the program states the order with a binding
    // before the expression.
    fn operands(self, &cx: Domain!['k], items: ArenaVec[Item['k], 'k], call: Option[S::Call['k]]) -> Option[ArenaVec[Span['k], 'k]] {
        let (reads, lent) = self.operand_group(&cx, items);
        self.operand_values(&cx, items, reads, lent, call, Option::None)
    }

    // The start of an operand group: the places its items read plainly, and its frame of lends, which
    // is pushed until `operand_values` ends the group.
    fn operand_group(self, &cx: Domain!['k], items: ArenaVec[Item['k], 'k]) -> (ArenaVec[Span['k], 'k], ArenaVec[Span['k], 'k]) {
        let reads: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
        var i = 0usize;
        while i < items.len(&cx) {
            match items.at(&cx, i) {
                Bind(b) => match b.path {
                    Some(p) => reads.push(&cx, p),
                    None => (),
                },
                Expr(e) => {
                    let place = match e {
                        Path(_p) => true,
                        Field(_f) => true,
                        Index(_x) => true,
                        _ => false,
                    };
                    if place {
                        let path = self.place_path(&cx, e);
                        let unit = self.substitute_type(&cx, self.type_of(&cx, expr_id(e)));
                        match path {
                            Some(p) => reads.push(&cx, p),
                            None => (),
                        };
                    }
                },
                Path(_t) => (),
            };
            i = i + 1usize;
        }
        let lent: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
        self.lend_frames.push(&cx, lent);
        (reads, lent)
    }

    // The values of the group `operand_group` started, in order; `first`, if given, is the first
    // item's, evaluated already.
    fn operand_values(self, &cx: Domain!['k], items: ArenaVec[Item['k], 'k], reads: ArenaVec[Span['k], 'k], lent: ArenaVec[Span['k], 'k], call: Option[S::Call['k]], first: Option[Span['k]]) -> Option[ArenaVec[Span['k], 'k]] {
        let values: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
        let saved: ArenaVec[(usize, Span['k], Span['k], Type['k]), 'k] = ArenaVec::new(&cx);
        var i = 0usize;
        while i < items.len(&cx) {
            let item = items.at(&cx, i);
            let v = if i == 0usize && first.is_some() {
                first
            } else {
                match call {
                    Some(c) => self.operand(&cx, item, c),
                    None => self.value(&cx, item),
                }
            };
            let v = match v {
                Some(v) => v,
                None => {
                    let unit = self.lend_frames.pop(&cx);
                    return Option::None;
                },
            };
            values.push(&cx, v);
            let raw = v.starts_with(&cx, Span::from_static(&cx, "&*"));
            let name = if raw { v.skip(2usize) } else { v };
            if !name.starts_with(&cx, Span::from_static(&cx, "&")) && i + 1usize < items.len(&cx) {
                let ty = self.vty.at(&cx, name);
                let root = self.temporary(&cx, ty);
                let origin = match item {
                    Expr(e) => expr_pos(e),
                    _ => self.at.copy(&cx),
                };
                let unit = self.emit(&cx, Op::new(&cx, "store", C::unit(&cx), ArenaVec::two(&cx, root, name)).located(origin));
                saved.push(&cx, (i, if raw { Span::from_static(&cx, "&*") } else { Span::from_static(&cx, "") }, root, ty));
            }
            i = i + 1usize;
        }
        i = 0usize;
        while i < saved.len(&cx) {
            let (k, raw, root, ty) = saved.at(&cx, i);
            values.set(&cx, k, Buffer!::new().push_bytes(&cx, raw).push_bytes(&cx, self.emit(&cx, Op::new(&cx, "load", ty, ArenaVec::one(&cx, root)))).save(&cx));
            i = i + 1usize;
        }
        i = 0usize;
        while i < values.len(&cx) {
            if lends(&cx, values.at(&cx, i)) {
                lent.push(&cx, values.at(&cx, i));
            }
            i = i + 1usize;
        }
        i = 0usize;
        while i < reads.len(&cx) {
            var k = 0usize;
            while k < lent.len(&cx) {
                if overlap(&cx, reads.at(&cx, i), lent.at(&cx, k)) {
                    self.fails(&cx, "a plain read overlaps a lend in the same operand group; bind the value before the expression", self.at.copy(&cx));
                }
                k = k + 1usize;
            }
            i = i + 1usize;
        }
        let unit = self.lend_frames.pop(&cx);
        Option::Some.(values)
    }

    fn exprs(&cx: Domain!['k], es: ArenaVec[Expr['k], 'k]) -> ArenaVec[Item['k], 'k] {
        let out: ArenaVec[Item['k], 'k] = ArenaVec::new(&cx);
        var i = 0usize;
        while i < es.len(&cx) {
            out.push(&cx, Item::Expr.(es.at(&cx, i)));
            i = i + 1usize;
        }
        out
    }

    fn run_arm(self, &cx: Domain!['k], body: ArmBody['k]) -> Option[Span['k]] {
        match body {
            Value(e) => self.expr(&cx, e),
            Unit => Option::Some.(self.unit(&cx)),
            Constant(lit) => Option::Some.(self.constant(&cx, C::bool_type(&cx), lit)),
            Folded(value) => Option::Some.(self.constant_value(&cx, value)),
            Case(arm, block, place) => {
                let case = arm.cases.at(&cx, 0usize);
                let variant = match case.kind {
                    Variant => case.binders.is_some(),
                    _ => false,
                };
                let binds = arm.cases.len(&cx) == 1usize && variant;
                if binds {
                    let payload = match place {
                        Some(p) => p,
                        None => block.params.at(&cx, 0usize).name,
                    };
                    self.bind_payload(&cx, case, payload, place.is_some());
                }
                let saved = self.save_scope(&cx);
                let v = self.expr(&cx, arm.body);
                self.restore_scope(&cx, saved);
                v
            },
        }
    }

    // `line:col` of the current position.
    fn here(self, &cx: Domain!['k]) -> Span['k] {
        let at = self.at.copy(&cx);
        Buffer!::new().push_u64(at.line as u64).push_static(":").push_u64(at.col as u64).save(&cx)
    }

    // The edges into a loop's `head`: the one from the current block starts the loop, the others repeat it.
    fn loop_sites(self, &cx: Domain!['k], head: BlockB['k]) {
        let at = self.here(&cx);
        let entry = Buffer!::new().push_bytes(&cx, self.current(&cx).label).push_static(">").push_bytes(&cx, head.label).save(&cx);
        self.sites.insert(&cx, entry, Buffer!::new().push_static("where the loop at ").push_bytes(&cx, at).push_static(" starts, but not when it repeats").save(&cx));
        self.sites.insert(&cx, head.label, Buffer!::new().push_static("when the loop at ").push_bytes(&cx, at).push_static(" repeats, but not where it starts").save(&cx));
    }

    // Runs each arm in its block; the arms that finish meet in a join block taking their results, the
    // end of the `what` at the current position.
    fn arms(self, &cx: Domain!['k], blocks: ArenaVec[BlockB['k], 'k], bodies: ArenaVec[ArmBody['k], 'k], ty: Type['k], what: Slice[u8, 'static]) -> Option[Span['k]] {
        let outer = self.open_brands.copy(&cx).clone(&cx);
        let mapping = self.brand_map.copy(&cx).clone(&cx);
        let ends: ArenaVec[(BlockB['k], Span['k]), 'k] = ArenaVec::new(&cx);
        var i = 0usize;
        while i < blocks.len(&cx) {
            self.start(&cx, blocks.at(&cx, i));
            let result = self.run_arm(&cx, bodies.at(&cx, i));
            match self.cur.copy(&cx) {
                Some(b) => match result {
                    Some(v) => ends.push(&cx, (b, v)),
                    None => self.fails(&cx, "internal error: an arm continues without a value", self.at.copy(&cx)),
                },
                None => (),
            };
            self.open_brands.set(&cx, outer.clone(&cx));
            self.brand_map.set(&cx, mapping.clone(&cx));
            i = i + 1usize;
        }
        if ends.is_empty(&cx) {
            self.cur.set(&cx, Option::None);
            return Option::None;
        }
        let r = self.fresh(&cx, "r");
        let join = self.new_block(&cx, ArenaVec::one(&cx, C::Binding.{ name: r, ty: self.substitute_type(&cx, ty) }), "join");
        self.sites.insert(&cx, join.label, Buffer!::new().push_static("on some paths to the end of the `").push_static(what).push_static("` at ").push_bytes(&cx, self.here(&cx)).save(&cx));
        i = 0usize;
        while i < ends.len(&cx) {
            let (block, result) = ends.at(&cx, i);
            self.cur.set(&cx, Option::Some.(block));
            self.jump(&cx, join, ArenaVec::one(&cx, result));
            i = i + 1usize;
        }
        self.start(&cx, join);
        Option::Some.(r)
    }

    // The brands open and their renaming, to restore when a lexical scope ends.
    fn save_scope(self, &cx: Domain!['k]) -> (ArenaVec[Span['k], 'k], ArenaMap[Span['k], Type['k], 'k]) {
        (self.open_brands.copy(&cx).clone(&cx), self.brand_map.copy(&cx).clone(&cx))
    }

    // The brands a scope opened go out of scope with it.
    fn restore_scope(self, &cx: Domain!['k], saved: (ArenaVec[Span['k], 'k], ArenaMap[Span['k], Type['k], 'k])) {
        let (brands, mapping) = saved;
        self.brand_map.set(&cx, mapping);
        if self.live(&cx) {
            self.open_brands.set(&cx, brands);
        }
    }

    // ---- bindings
    // Binds a variable: a new root of the function, holding `value`.
    fn declare(self, &cx: Domain!['k], bid: Span['k], name: Span['k], ty: Type['k], value: Span['k]) {
        let ty = self.substitute_type(&cx, ty);
        let root = Buffer!::new().push_static("&").push_bytes(&cx, name).push_static("#").push_bytes(&cx, bid).save(&cx);
        self.locals.push(&cx, C::Binding.{ name: root, ty: ty });
        self.bindings.insert(&cx, bid, Binding.{ name, ty: ty, path: Option::Some.(root), fields: Option::None });
        let unit = self.emit(&cx, Op::new(&cx, "store", C::unit(&cx), ArenaVec::two(&cx, root, value)));
    }

    fn read(self, &cx: Domain!['k], binding: Binding['k]) -> Span['k] {
        match binding.path {
            Some(path) => self.emit(&cx, Op::new(&cx, "load", binding.ty, ArenaVec::one(&cx, path))),
            None => self.fail(&cx, Buffer!::new().push_bytes(&cx, binding.name).push_static(" is a ..rest bundle, not a value").save(&cx), self.at.copy(&cx)),
        }
    }

    fn local(self, &cx: Domain!['k], id: u32) -> Binding['k] {
        self.bindings.at(&cx, self.binder(&cx, id))
    }

    // The place path `e` names, or none if it is not rooted at a place.
    fn place_path(self, &cx: Domain!['k], e: Expr['k]) -> Option[Span['k]] {
        match e {
            Path(p) => if self.local_ref(&cx, p) { self.local(&cx, p.id).path } else { Option::None },
            Field(f) => match self.place_path(&cx, f.value.copy(&cx)) {
                Some(base) => Option::Some.(Buffer!::new().push_bytes(&cx, base).push_static(".").push_bytes(&cx, f.name).save(&cx)),
                None => Option::None,
            },
            Index(x) => match self.place_path(&cx, x.value.copy(&cx)) {
                Some(base) => Option::Some.(Buffer!::new().push_bytes(&cx, base).push_static(".").push_usize(x.index).save(&cx)),
                None => Option::None,
            },
            _ => Option::None,
        }
    }

    // ---- the function
    fn start_entry(self, &cx: Domain!['k], params: ArenaVec[C::Binding['k], 'k]) {
        self.n.set(&cx, self.n.copy(&cx) + 1u64);
        self.start(&cx, self.block_named(&cx, Span::from_static(&cx, "entry"), params));
    }

    // Lent parameters are roots already; value parameters start in local places. An offset skips
    // raw parameters such as a closure environment. Explicit sources keep the SSA names generated
    // functions use.
    fn parameters(self, &cx: Domain!['k], ids: ArenaVec[u32, 'k], offset: usize, sources: ArenaVec[Span['k], 'k]) {
        let sig = self.sig;
        var k = offset;
        while k < sig.pnames.len(&cx) && k < sig.ptypes.len(&cx) && k - offset < ids.len(&cx) {
            let name = sig.pnames.at(&cx, k);
            let ty = sig.ptypes.at(&cx, k);
            let bid = id_text(&cx, ids.at(&cx, k - offset));
            let place = sig.places.contains(&cx, k);
            let source = if !sources.is_empty(&cx) {
                sources.at(&cx, k - offset)
            } else {
                Buffer!::new().push_static(if place { "&" } else { "%a_" }).push_bytes(&cx, name).save(&cx)
            };
            self.current(&cx).params.push(&cx, C::Binding.{ name: source, ty: ty });
            if place {
                self.bindings.insert(&cx, bid, Binding.{ name, ty: ty, path: Option::Some.(source), fields: Option::None });
            } else {
                self.vty.insert(&cx, source, ty);
                self.declare(&cx, bid, name, ty, source);
            }
            k = k + 1usize;
        }
    }

    fn run(self, &cx: Domain!['k]) -> Fun['k] {
        match self.mode {
            Plain(node) => {
                self.start_entry(&cx, ArenaVec::new(&cx));
                self.parameters(&cx, self.results().param_ids.get_or(&cx, node.id, ArenaVec::new(&cx)), 0usize, ArenaVec::new(&cx));
                match node.body {
                    Some(body) => self.finish_body(&cx, Expr::Block.(body)),
                    None => self.fails(&cx, "internal error: a function without a body", node.pos),
                }
            },
            Closure(e, env_ty) => {
                self.start_entry(&cx, ArenaVec::one(&cx, C::Binding.{ name: Span::from_static(&cx, "%env"), ty: env_ty }));
                self.parameters(&cx, self.results().param_ids.get_or(&cx, e.id, ArenaVec::new(&cx)), 1usize, ArenaVec::new(&cx));
                let captures = self.results().captures.get_or(&cx, e.id, ArenaVec::new(&cx));
                let parts = self.destruct(&cx, Span::from_static(&cx, "%env"), env_ty);
                var i = 0usize;
                while i < captures.len(&cx) && i < parts.len(&cx) {
                    let capture = captures.at(&cx, i);
                    self.declare(&cx, id_text(&cx, capture.binder), capture.name, parts.at(&cx, i).ty, parts.at(&cx, i).name);
                    i = i + 1usize;
                }
                self.finish_body(&cx, e.body.copy(&cx))
            },
            Mapper(e) => {
                self.start_entry(&cx, ArenaVec::new(&cx));
                let captures = self.results().captures.get_or(&cx, e.id, ArenaVec::new(&cx));
                let ids = ArenaVec::one(&cx, self.results().binders.at(&cx, e.id));
                let sources = ArenaVec::one(&cx, Span::from_static(&cx, "%item"));
                var i = 0usize;
                while i < captures.len(&cx) {
                    ids.push(&cx, captures.at(&cx, i).binder);
                    sources.push(&cx, Buffer!::new().push_static("%a_").push_bytes(&cx, captures.at(&cx, i).name).save(&cx));
                    i = i + 1usize;
                }
                self.parameters(&cx, ids, 0usize, sources);
                self.finish_body(&cx, Expr::Block.(e.body))
            },
        }
    }

    fn finish_body(self, &cx: Domain!['k], body: Expr['k]) -> Fun['k] {
        let value = self.expr(&cx, body);
        if self.live(&cx) {
            // A body's value is its tail's; a block with none ends, and drops what it holds, at its `}`.
            let result_pos = match body {
                Block(b) => match b.tail {
                    Some(t) => expr_pos(t.copy(&cx)),
                    None => b.end,
                },
                _ => expr_pos(body),
            };
            match value {
                Some(v) => self.terminate(&cx, Terminator::Ret.(v, result_pos)),
                None => self.fails(&cx, "internal error: a body continues without a value", result_pos),
            };
        }
        self.finish(&cx)
    }

    fn finish(self, &cx: Domain!['k]) -> Fun['k] {
        let sig = self.sig;
        let blocks: ArenaVec[Block['k], 'k] = ArenaVec::new(&cx);
        var i = 0usize;
        while i < self.blocks.len(&cx) {
            let b = self.blocks.at(&cx, i);
            let term = match b.term.copy(&cx) {
                Some(t) => t,
                None => self.fails(&cx, "internal error: an unterminated block", self.node_pos),
            };
            blocks.push(&cx, Block.{ label: b.label, params: b.params, instrs: b.instrs, term, brands: b.brands, empty: ArenaVec::new(&cx),
                known: ArenaVec::new(&cx), opened: ArenaVec::new(&cx), pos: no_pos() });
            i = i + 1usize;
        }
        let fun = Fun.{ name: self.name, params: sig.params, premises: sig.premises, ret: sig.ret, ptypes: sig.ptypes, blocks,
            locals: self.locals, is_unsafe: sig.is_unsafe, home: Option::Some.(self.home), pos: self.node_pos };
        let brands: ArenaSet[Span['k], 'k] = ArenaSet::new(&cx);
        i = 0usize;
        while i < sig.params.len(&cx) {
            if C::same_kind(sig.params.at(&cx, i).kind, Kind::Brand) {
                brands.insert(&cx, sig.params.at(&cx, i).name);
            }
            i = i + 1usize;
        }
        var branded = false;
        i = 0usize;
        while !branded && i < self.locals.len(&cx) {
            let free = free_brands(&cx, self.locals.at(&cx, i).ty).keys(&cx);
            var k = 0usize;
            while k < free.len(&cx) {
                branded = branded || !brands.contains(&cx, free.at(&cx, k));
                k = k + 1usize;
            }
            i = i + 1usize;
        }
        if branded {
            self.lowering.value_types.insert(&cx, fun_key(fun), self.vty.clone(&cx));
        }
        self.lowering.sites.insert(&cx, fun_key(fun), self.sites);
        fun
    }

    // The enclosing function's own parameters, as the type arguments that instantiate a lifted
    // function.
    fn identity_args(self, &cx: Domain!['k]) -> ArenaVec[Type['k], 'k] {
        let out: ArenaVec[Type['k], 'k] = ArenaVec::new(&cx);
        var i = 0usize;
        while i < self.sig.params.len(&cx) {
            let p = self.sig.params.at(&cx, i);
            out.push(&cx, if C::same_kind(p.kind, Kind::Brand) { Type::Skolem.(p.name) } else { Type::Named.(p.name, ArenaVec::new(&cx)) });
            i = i + 1usize;
        }
        out
    }

    // A lifted type may mention function parameters and brands opened inside that body.
    fn check_closed(self, &cx: Domain!['k], ty: Type['k], local_brands: ArenaVec[Span['k], 'k]) {
        if !mentions_brand(&cx, ty) {
            return;
        }
        let brands = free_brands(&cx, ty).keys(&cx);
        var least: Option[Span['k]] = Option::None;
        var i = 0usize;
        while i < brands.len(&cx) {
            let b = brands.at(&cx, i);
            let parameter = match self.kinds.get(&cx, b) {
                Some(k) => C::same_kind(k, Kind::Brand),
                None => false,
            };
            let allowed = b.is(&cx, "static") || local_brands.contains(&cx, b) || parameter;
            if !allowed {
                least = match least {
                    Some(l) => if b.cmp(&cx, l).is_lt() { Option::Some.(b) } else { Option::Some.(l) },
                    None => Option::Some.(b),
                };
            }
            i = i + 1usize;
        }
        match least {
            Some(b) => self.fail(&cx, Buffer!::new().push_static("a closure or foreach body cannot mention the block-local brand ").push_bytes(&cx, brand_name(&cx, b)).save(&cx), self.at.copy(&cx)),
            None => (),
        };
    }

    // ---- expressions
    // The expression's value in the current block, or none if control cannot continue.
    fn expr(self, &cx: Domain!['k], e: Expr['k]) -> Option[Span['k]] {
        if !self.live(&cx) {
            return Option::None;
        }
        let previous = self.at.copy(&cx);
        self.at.set(&cx, expr_pos(e));
        let v = self.lower_expr(&cx, e);
        self.at.set(&cx, previous);
        v
    }

    fn lower_expr(self, &cx: Domain!['k], e: Expr['k]) -> Option[Span['k]] {
        match e {
            Lit(l) => Option::Some.(self.expr_lit(&cx, l)),
            FStr(f) => self.expr_fstring(&cx, f),
            Path(p) => self.expr_path(&cx, p),
            Tuple(n) => self.expr_tuple(&cx, n.id, n.value),
            Array(a) => self.expr_tuple(&cx, a.id, a.elems),
            StructLit(s) => self.expr_struct_lit(&cx, s),
            Block(b) => self.expr_block(&cx, b),
            If(x) => self.expr_if(&cx, x),
            Match(m) => self.expr_match(&cx, m),
            Closure(c) => self.expr_closure(&cx, c),
            Return(n) => self.expr_return(&cx, n.value),
            Pack(p) => self.expr_pack(&cx, p),
            Foreach(f) => self.expr_foreach(&cx, f),
            Binop(b) => self.expr_binop(&cx, b),
            Unary(u) => self.expr_unary(&cx, u),
            Cast(c) => self.expr_cast(&cx, c),
            UnsafeStore(s) => match self.operands(&cx, ArenaVec::two(&cx, Item::Expr.(s.pointer.copy(&cx)), Item::Expr.(s.value.copy(&cx))), Option::None) {
                Some(vals) => Option::Some.(self.emit(&cx, Op::new(&cx, "ptr_store", C::unit(&cx), vals).from_node(s.id, s.pos))),
                None => Option::None,
            },
            Field(f) => self.expr_field(&cx, e, f.id),
            Index(x) => self.expr_field(&cx, e, x.id),
            Call(c) => self.expr_call(&cx, c),
            Try(n) => self.expr_try(&cx, n.id, n.value.copy(&cx)),
            While(w) => self.expr_while(&cx, w),
            For(f) => self.expr_for(&cx, f),
        }
    }

    fn expr_lit(self, &cx: Domain!['k], l: S::Lit['k]) -> Span['k] {
        let ty = self.substitute_type(&cx, self.type_of(&cx, l.id));
        match l.kind {
            Str => self.string(&cx, l.text),
            Bool => self.constant(&cx, ty, Span::from_static(&cx, if l.int != 0u64 { "true" } else { "false" })),
            Float => self.constant(&cx, ty, l.text),
            Int => self.constant(&cx, ty, Buffer!::new().push_u64(l.int).save(&cx)),
        }
    }

    // A string literal: a `Slice[u8, 'static]` over static bytes.
    fn string(self, &cx: Domain!['k], bytes: Span['k]) -> Span['k] {
        let (data, n) = self.lowering.data(&cx, bytes);
        let u8_type = C::prim(&cx, "u8");
        let fixed = Type::Skolem.(Span::from_static(&cx, "static"));
        let d = self.emit(&cx, Op::new(&cx, "data", C::ptr(&cx, Type::Array.(ref_in(&cx, u8_type), n as u64 + 1u64)), ArenaVec::one(&cx, data)));
        let p = self.emit(&cx, Op::new(&cx, "cast", C::ptr(&cx, u8_type), ArenaVec::one(&cx, d)).typed(C::ptr(&cx, u8_type)).discharge(true));
        let brand = self.emit(&cx, Op::new(&cx, "static_brand", Type::Brand.(ref_in(&cx, fixed)), ArenaVec::new(&cx)).discharge(true));
        let length = self.constant(&cx, C::usize_type(&cx), Buffer!::new().push_usize(n).save(&cx));
        let sig = self.lowering.library_sig(&cx, "Slice::from_raw_parts", self.home);
        let slice_ty = Type::Named.(self.lowering.library_name(&cx, "Slice", self.home), ArenaVec::two(&cx, u8_type, fixed));
        let args = ArenaVec::one(&cx, sig.name);
        args.push(&cx, p);
        args.push(&cx, length);
        args.push(&cx, brand);
        self.emit(&cx, Op::new(&cx, "call", slice_ty, args).with_tys(ArenaVec::two(&cx, u8_type, fixed)).discharge(true))
    }

    fn expr_tuple(self, &cx: Domain!['k], id: u32, elems: ArenaVec[Expr['k], 'k]) -> Option[Span['k]] {
        let vals = match self.operands(&cx, FnLower::exprs(&cx, elems), Option::None) {
            Some(v) => v,
            None => return Option::None,
        };
        let ty = self.substitute_type(&cx, self.type_of(&cx, id));
        Option::Some.(self.emit(&cx, Op::new(&cx, "construct", ty, vals).typed(ty)))
    }

    fn expr_block(self, &cx: Domain!['k], b: S::Block['k]) -> Option[Span['k]] {
        let saved = self.save_scope(&cx);
        var i = 0usize;
        while self.live(&cx) && i < b.stmts.len(&cx) {
            self.stmt(&cx, b.stmts.at(&cx, i));
            i = i + 1usize;
        }
        let v = if !self.live(&cx) {
            Option::None
        } else {
            match b.tail {
                Some(t) => self.expr(&cx, t.copy(&cx)),
                None => Option::Some.(self.unit(&cx)),
            }
        };
        self.restore_scope(&cx, saved);
        v
    }

    fn expr_path(self, &cx: Domain!['k], p: S::Path['k]) -> Option[Span['k]] {
        if self.local_ref(&cx, p) {
            return Option::Some.(self.read(&cx, self.local(&cx, p.id)));
        }
        match self.results().folded.get(&cx, p.id) {
            Some(value) => return Option::Some.(self.constant_value(&cx, value)),
            None => (),
        };
        match self.results().calls.get(&cx, p.id) {
            Some(call) => match call {
                Fn(f) => {
                    let ty = self.substitute_type(&cx, self.type_of(&cx, p.id));
                    return Option::Some.(self.emit(&cx, Op::new(&cx, "fn", ty, ArenaVec::one(&cx, f.call_name())).with_tys(self.substitute_all(&cx, f.targs(&cx)))));
                },
                Variant(name) => return self.variant(&cx, name, self.type_of(&cx, p.id), Option::None),
                _ => (),
            },
            None => (),
        };
        let names = p.names(&cx);
        var message = Buffer!::new().push_static("cannot lower the path ");
        var i = 0usize;
        while i < names.len(&cx) {
            if i > 0usize {
                message = message.push_static("::");
            }
            message = message.push_bytes(&cx, names.at(&cx, i));
            i = i + 1usize;
        }
        self.fail(&cx, message.save(&cx), p.pos)
    }

    fn constant_value(self, &cx: Domain!['k], value: ConstValue['k]) -> Span['k] {
        match value {
            Str(t, _ty) => self.string(&cx, t),
            Int(v, ty) => match ty {
                Prim(name) => self.constant(&cx, ty, int_text(&cx, v, name)),
                _ => self.constant(&cx, ty, Buffer!::new().push_u64(v).save(&cx)),
            },
            Bool(b) => self.constant(&cx, C::bool_type(&cx), Span::from_static(&cx, if b { "true" } else { "false" })),
            Float(digits, ty) => self.constant(&cx, ty, digits),
            Op(name, operands, ty) => self.operation(&cx, name, operands, ty),
        }
    }

    // A constant operation the C compiler folds, as the instructions that compute it.
    fn operation(self, &cx: Domain!['k], name: Span['k], operands: ArenaVec[ConstValue['k], 'k], ty: Type['k]) -> Span['k] {
        if name.is(&cx, "and") || name.is(&cx, "or") {
            let c = self.constant_value(&cx, operands.at(&cx, 0usize));
            let right = ArmBody::Folded.(operands.at(&cx, 1usize));
            let result = if name.is(&cx, "and") {
                self.branch(&cx, c, right, ArmBody::Constant.(Span::from_static(&cx, "false")), C::bool_type(&cx), "&&")
            } else {
                self.branch(&cx, c, ArmBody::Constant.(Span::from_static(&cx, "true")), right, C::bool_type(&cx), "||")
            };
            return match result {
                Some(r) => r,
                None => self.fails(&cx, "internal error: a constant operation without a value", no_pos()),
            };
        }
        let args: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
        var i = 0usize;
        while i < operands.len(&cx) {
            args.push(&cx, self.constant_value(&cx, operands.at(&cx, i)));
            i = i + 1usize;
        }
        if name.is(&cx, "neg") {
            self.negate(&cx, args.at(&cx, 0usize), ty, no_pos())
        } else if name.is(&cx, "not") {
            self.complement(&cx, args.at(&cx, 0usize), ty, no_pos())
        } else if name.is(&cx, "int_cast") || name.is(&cx, "float_cast") {
            self.emit(&cx, Op::named(&cx, name, ty, args).typed(ty))
        } else {
            self.emit(&cx, Op::named(&cx, name, ty, args))
        }
    }

    fn expr_binop(self, &cx: Domain!['k], b: S::Binop['k]) -> Option[Span['k]] {
        // A chain `a + b - c ...` or `a && b || c ...` nests to the left, and is lowered by a loop over
        // its links rather than by recursion.
        let short = is_short_circuit(&cx, b.op);
        let chain: ArenaVec[S::Binop['k], 'k] = ArenaVec::one(&cx, b);
        var going = true;
        while going {
            going = match chain.at(&cx, chain.len(&cx) - 1usize).left.copy(&cx) {
                Binop(l) => if is_short_circuit(&cx, l.op) == short {
                    chain.push(&cx, l);
                    true
                } else {
                    false
                },
                _ => false,
            };
        }
        if short {
            var c = self.expr(&cx, chain.at(&cx, chain.len(&cx) - 1usize).left.copy(&cx));
            var depth = chain.len(&cx);
            while depth > 0usize {
                depth = depth - 1usize;
                let link = chain.at(&cx, depth);
                c = match c {
                    Some(v) => {
                        self.at.set(&cx, link.pos);
                        self.short_circuit(&cx, link, v)
                    },
                    None => return Option::None,
                };
            }
            return c;
        }
        // Each link's operand group starts outermost first, as each starts before its left operand.
        let groups: ArenaVec[(ArenaVec[Span['k], 'k], ArenaVec[Span['k], 'k]), 'k] = ArenaVec::new(&cx);
        var k = 0usize;
        while k < chain.len(&cx) {
            let link = chain.at(&cx, k);
            self.at.set(&cx, link.pos);
            groups.push(&cx, self.operand_group(&cx, link_items(&cx, link)));
            k = k + 1usize;
        }
        var value = Option::None;
        var depth = chain.len(&cx);
        while depth > 0usize {
            depth = depth - 1usize;
            let link = chain.at(&cx, depth);
            self.at.set(&cx, link.pos);
            let (reads, lent) = groups.at(&cx, depth);
            value = match self.operand_values(&cx, link_items(&cx, link), reads, lent, Option::None, value) {
                Some(vals) => Option::Some.(self.emit(&cx, Op::new(&cx, binop_name(&cx, link.op), self.substitute_type(&cx, self.type_of(&cx, link.id)), vals))),
                None => {
                    var outer = 0usize;
                    while outer < depth {
                        let unit = self.lend_frames.pop(&cx);
                        outer = outer + 1usize;
                    }
                    return Option::None;
                },
            };
        }
        value
    }

    // `&&` or `||` once its left operand is `c`.
    fn short_circuit(self, &cx: Domain!['k], b: S::Binop['k], c: Span['k]) -> Option[Span['k]] {
        let right = ArmBody::Value.(b.right.copy(&cx));
        if b.op.is(&cx, "&&") {
            return self.branch(&cx, c, right, ArmBody::Constant.(Span::from_static(&cx, "false")), C::bool_type(&cx), "&&");
        }
        self.branch(&cx, c, ArmBody::Constant.(Span::from_static(&cx, "true")), right, C::bool_type(&cx), "||")
    }

    fn expr_unary(self, &cx: Domain!['k], u: S::Unary['k]) -> Option[Span['k]] {
        let op = u.op;
        if op.is(&cx, "unsafe") {
            var node = u.operand.copy(&cx);
            var going = true;
            while going {
                node = match node {
                    Try(t) => t.value.copy(&cx),
                    Unary(inner) => if inner.op.is(&cx, "&") {
                        inner.operand.copy(&cx)
                    } else {
                        going = false;
                        node
                    },
                    _ => {
                        going = false;
                        node
                    },
                };
            }
            self.unsafe_nodes.insert(&cx, expr_id(node));
            return self.expr(&cx, u.operand.copy(&cx));
        }
        if op.is(&cx, "&") {
            return self.expr(&cx, u.operand.copy(&cx));
        }
        if op.is(&cx, "*") {
            return match self.expr(&cx, u.operand.copy(&cx)) {
                Some(p) => Option::Some.(self.emit(&cx, Op::new(&cx, "ptr_load", self.substitute_type(&cx, self.type_of(&cx, u.id)), ArenaVec::one(&cx, p))
                    .from_node(u.id, u.pos))),
                None => Option::None,
            };
        }
        let ty = self.substitute_type(&cx, self.type_of(&cx, u.id));
        if op.is(&cx, "-") {
            match u.operand.copy(&cx) {
                Lit(l) => match l.kind {
                    Int => return Option::Some.(self.constant(&cx, ty, Buffer!::new().push_static("-").push_u64(l.int).save(&cx))),
                    Float => return Option::Some.(self.constant(&cx, ty, Buffer!::new().push_static("-").push_bytes(&cx, l.text).save(&cx))),
                    _ => (),
                },
                _ => (),
            };
        }
        let v = match self.expr(&cx, u.operand.copy(&cx)) {
            Some(v) => v,
            None => return Option::None,
        };
        Option::Some.(if op.is(&cx, "-") { self.negate(&cx, v, ty, u.pos) } else { self.complement(&cx, v, ty, u.pos) })
    }

    fn unary_prim(self, &cx: Domain!['k], ty: Type['k], pos: Pos) -> Span['k] {
        match self.lowering.types.shape(&cx, ty, Option::None) {
            Prim(name) => name,
            _ => self.fails(&cx, "internal error: a unary operator on a non-primitive", pos),
        }
    }

    fn negate(self, &cx: Domain!['k], v: Span['k], ty: Type['k], pos: Pos) -> Span['k] {
        if C::is_float(&cx, self.unary_prim(&cx, ty, pos)) {
            let minus = self.constant(&cx, ty, Span::from_static(&cx, "-1.0"));
            return self.emit(&cx, Op::new(&cx, "mul", ty, ArenaVec::two(&cx, v, minus)));
        }
        let zero = self.constant(&cx, ty, Span::from_static(&cx, "0"));
        self.emit(&cx, Op::new(&cx, "sub", ty, ArenaVec::two(&cx, zero, v)))
    }

    // `!v`: a bool's negation, or an integer's bits flipped.
    fn complement(self, &cx: Domain!['k], v: Span['k], ty: Type['k], pos: Pos) -> Span['k] {
        let prim = self.unary_prim(&cx, ty, pos);
        if prim.is(&cx, "bool") {
            let f = self.constant(&cx, ty, Span::from_static(&cx, "false"));
            return self.emit(&cx, Op::new(&cx, "eq", ty, ArenaVec::two(&cx, v, f)));
        }
        let bits = C::integer_bits(&cx, prim);
        let mask = if prim.starts_with(&cx, Span::from_static(&cx, "i")) {
            self.constant(&cx, ty, Span::from_static(&cx, "-1"))
        } else if C::is_pointer_sized(&cx, prim) {
            // All ones at the target's width, `0 - 1`, which the C compiler folds.
            let zero = self.constant(&cx, ty, Span::from_static(&cx, "0"));
            let one = self.constant(&cx, ty, Span::from_static(&cx, "1"));
            self.emit(&cx, Op::new(&cx, "sub", ty, ArenaVec::two(&cx, zero, one)))
        } else if bits == 64u32 {
            self.constant(&cx, ty, Buffer!::new().push_u64(18446744073709551615u64).save(&cx))
        } else {
            self.constant(&cx, ty, Buffer!::new().push_u64((1u64 << (bits as u64)) - 1u64).save(&cx))
        };
        self.emit(&cx, Op::new(&cx, "bit_xor", ty, ArenaVec::two(&cx, v, mask)))
    }

    fn expr_cast(self, &cx: Domain!['k], c: S::Cast['k]) -> Option[Span['k]] {
        let v = match self.expr(&cx, c.value.copy(&cx)) {
            Some(v) => v,
            None => return Option::None,
        };
        let src = self.vty.at(&cx, v);
        let dst = self.substitute_type(&cx, self.type_of(&cx, c.id));
        // A number to a number is a conversion by value, which needs no `unsafe`.
        let conversion = match src {
            Prim(a) => match dst {
                Prim(b) => if C::is_integer(&cx, a) && C::is_integer(&cx, b) {
                    Option::Some.("int_cast")
                } else if (C::is_integer(&cx, a) || C::is_float(&cx, a)) && (C::is_integer(&cx, b) || C::is_float(&cx, b)) {
                    Option::Some.("float_cast")
                } else {
                    Option::None
                },
                _ => Option::None,
            },
            _ => Option::None,
        };
        match conversion {
            Some(op) => return Option::Some.(self.emit(&cx, Op::new(&cx, op, dst, ArenaVec::one(&cx, v)).typed(dst))),
            None => (),
        }
        // Forgetting that a pointer is not null is safe.
        let forgets = match src {
            NonNull(a) => match dst {
                Ptr(b) => equal(&cx, a.copy(&cx), b.copy(&cx)),
                _ => false,
            },
            _ => false,
        };
        if forgets {
            return Option::Some.(self.emit(&cx, Op::new(&cx, "to_ptr", dst, ArenaVec::one(&cx, v)).typed(dst)));
        }
        // `emit` holds a cast to the core's rules for it (`memory_operation`); a package is opened or
        // packed.
        let package = match src {
            Exists(_b, _t) => true,
            _ => match dst {
                Exists(_b, _t) => true,
                _ => false,
            },
        };
        if package {
            self.fails(&cx, "a cast cannot consume or produce an outer existential package; use opening or packing", c.pos);
        }
        if !self.authorized(&cx, c.id) {
            self.fails(&cx, "a safe `as` converts only between number types and from a NonNull to its pointer; any other cast reinterprets bits and needs unsafe", c.pos);
        }
        Option::Some.(self.emit(&cx, Op::new(&cx, "cast", dst, ArenaVec::one(&cx, v)).typed(dst).from_node(c.id, c.pos)))
    }

    fn expr_field(self, &cx: Domain!['k], e: Expr['k], id: u32) -> Option[Span['k]] {
        match self.place_path(&cx, e) {
            Some(path) => Option::Some.(self.emit(&cx, Op::new(&cx, "load", self.substitute_type(&cx, self.type_of(&cx, id)), ArenaVec::one(&cx, path)))),
            None => self.project(&cx, e),
        }
    }

    // Reads a field of a value that is not a place: takes the value apart, once per step.
    fn project(self, &cx: Domain!['k], e: Expr['k]) -> Option[Span['k]] {
        let steps: ArenaVec[(Option[Span['k]], usize), 'k] = ArenaVec::new(&cx);
        var base = e;
        var going = true;
        while going {
            base = match base {
                Field(f) => {
                    steps.push(&cx, (Option::Some.(f.name), 0usize));
                    f.value.copy(&cx)
                },
                Index(x) => {
                    steps.push(&cx, (Option::None, x.index));
                    x.value.copy(&cx)
                },
                _ => {
                    going = false;
                    base
                },
            };
        }
        var v = match self.expr(&cx, base) {
            Some(v) => v,
            None => return Option::None,
        };
        var ty = self.vty.at(&cx, v);
        var i = steps.len(&cx);
        while i > 0usize {
            i = i - 1usize;
            let (name, index) = steps.at(&cx, i);
            let selected = match name {
                Some(field) => self.field_index(&cx, ty, field),
                None => index,
            };
            let parts = self.destruct(&cx, v, ty);
            var k = 0usize;
            while k < parts.len(&cx) {
                if k != selected && !self.copy(&cx, parts.at(&cx, k).ty) {
                    self.fails(&cx, "a projection cannot discard a linear sibling; destructure the value explicitly", expr_pos(e));
                }
                k = k + 1usize;
            }
            v = parts.at(&cx, selected).name;
            ty = parts.at(&cx, selected).ty;
        }
        Option::Some.(v)
    }

    fn field_index(self, &cx: Domain!['k], ty: Type['k], field: Span['k]) -> usize {
        match self.lowering.types.shape(&cx, ty, Option::None) {
            Struct(fields) => {
                var i = 0usize;
                while i < fields.len(&cx) {
                    if fields.at(&cx, i).name.eq(&cx, field) {
                        return i;
                    }
                    i = i + 1usize;
                }
                self.fails(&cx, "internal error: no such field", self.at.copy(&cx))
            },
            _ => self.fails(&cx, "internal error: a field of a non-struct", self.at.copy(&cx)),
        }
    }

    // ---- constructors
    fn expr_struct_lit(self, &cx: Domain!['k], s: S::StructLit['k]) -> Option[Span['k]] {
        let ty = self.substitute_type(&cx, self.type_of(&cx, s.id));
        let shape = match self.lowering.types.shape(&cx, ty, Option::None) {
            Struct(fields) => fields,
            _ => self.fails(&cx, "internal error: a struct literal of a non-struct", s.pos),
        };
        let names: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
        let items: ArenaVec[Item['k], 'k] = ArenaVec::new(&cx);
        var i = 0usize;
        while i < s.fields.len(&cx) {
            let f = s.fields.at(&cx, i);
            names.push(&cx, f.name);
            items.push(&cx, match f.value {
                Some(v) => Item::Expr.(v),
                None => Item::Bind.(self.bindings.at(&cx, id_text(&cx, self.results().field_ids.at(&cx, s.id).at(&cx, f.name)))),
            });
            i = i + 1usize;
        }
        if s.spread.is_some() {
            let rest = self.bindings.at(&cx, id_text(&cx, self.results().spread_ids.at(&cx, s.id)));
            let fields = match rest.fields {
                Some(f) => f,
                None => self.fails(&cx, "internal error: a spread of a non-bundle", s.pos),
            };
            i = 0usize;
            while i < shape.len(&cx) {
                let name = shape.at(&cx, i).name;
                if !names.contains(&cx, name) {
                    names.push(&cx, name);
                    items.push(&cx, Item::Bind.(self.bindings.at(&cx, fields.at(&cx, name))));
                }
                i = i + 1usize;
            }
        }
        let results = match self.operands(&cx, items, Option::None) {
            Some(r) => r,
            None => return Option::None,
        };
        let values: ArenaMap[Span['k], Span['k], 'k] = ArenaMap::new(&cx);
        i = 0usize;
        while i < names.len(&cx) {
            values.insert(&cx, names.at(&cx, i), results.at(&cx, i));
            i = i + 1usize;
        }
        let ordered: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
        i = 0usize;
        while i < shape.len(&cx) {
            ordered.push(&cx, values.at(&cx, shape.at(&cx, i).name));
            i = i + 1usize;
        }
        Option::Some.(self.emit(&cx, Op::new(&cx, "construct", ty, ordered).typed(ty)))
    }

    fn variant(self, &cx: Domain!['k], name: Span['k], ty: Type['k], args: Option[ArenaVec[Expr['k], 'k]]) -> Option[Span['k]] {
        let enum_ty = self.substitute_type(&cx, ty);
        let variants = match self.lowering.types.shape(&cx, enum_ty, Option::None) {
            Enum(vs) => vs,
            _ => self.fails(&cx, "internal error: a variant of a non-enum", self.at.copy(&cx)),
        };
        var payload_ty = C::unit(&cx);
        var i = 0usize;
        while i < variants.len(&cx) {
            if variants.at(&cx, i).name.eq(&cx, name) {
                payload_ty = variants.at(&cx, i).ty;
            }
            i = i + 1usize;
        }
        let given = match args {
            Some(a) => a,
            None => ArenaVec::new(&cx),
        };
        let payload = if given.is_empty(&cx) {
            if !is_unit(&cx, payload_ty) {
                self.fail(&cx, Buffer!::new().push_static("variant ").push_bytes(&cx, name).push_static(" used as a function value").save(&cx), self.at.copy(&cx));
            }
            Option::Some.(self.emit(&cx, Op::new(&cx, "construct", C::unit(&cx), ArenaVec::new(&cx)).typed(C::unit(&cx))))
        } else if given.len(&cx) == 1usize {
            self.expr(&cx, given.at(&cx, 0usize))
        } else {
            match self.operands(&cx, FnLower::exprs(&cx, given), Option::None) {
                Some(vals) => Option::Some.(self.emit(&cx, Op::new(&cx, "construct", payload_ty, vals).typed(payload_ty))),
                None => Option::None,
            }
        };
        match payload {
            Some(p) => Option::Some.(self.emit(&cx, Op::new(&cx, "construct_variant", enum_ty, ArenaVec::one(&cx, p)).typed(enum_ty).literal(name))),
            None => Option::None,
        }
    }

    // ---- calls
    fn expr_call(self, &cx: Domain!['k], c: S::Call['k]) -> Option[Span['k]] {
        let call = match self.results().calls.get(&cx, c.id) {
            Some(call) => call,
            None => self.fails(&cx, "internal error: an unresolved call", c.pos),
        };
        let items: ArenaVec[Item['k], 'k] = ArenaVec::new(&cx);
        let receiver = match call {
            Variant(name) => return self.variant(&cx, name, self.type_of(&cx, c.id), Option::Some.(c.args)),
            Tuple => {
                let vals = self.operands(&cx, FnLower::exprs(&cx, c.args), Option::None);
                let ty = self.substitute_type(&cx, self.type_of(&cx, c.id));
                return match vals {
                    Some(v) => Option::Some.(self.emit(&cx, Op::new(&cx, "construct", ty, v).typed(ty))),
                    None => Option::None,
                };
            },
            TypedBuiltin(name, target) => {
                let rty = self.substitute_type(&cx, self.type_of(&cx, c.id));
                return Option::Some.(self.emit(&cx, Op::named(&cx, name, rty, ArenaVec::new(&cx)).typed(self.substitute_type(&cx, target)).from_node(c.id, c.pos)));
            },
            Builtin(name) => return self.builtin(&cx, c, name),
            Pointer(name, recv) => return self.pointer_method(&cx, c, name, recv),
            FStringWrite(f, context) => return match context {
                Some(place) => self.fstring_reading(&cx, f, c.args.at(&cx, 1usize), place),
                None => match self.expr(&cx, c.args.at(&cx, 0usize)) {
                    Some(out) => self.fstring(&cx, f, out),
                    None => Option::None,
                },
            },
            Value => {
                items.push(&cx, Item::Expr.(c.callee.copy(&cx)));
                Option::None
            },
            Closure => {
                items.push(&cx, Item::Expr.(c.callee.copy(&cx)));
                Option::None
            },
            Fn(f) => f.receiver,
            Trait(t) => t.receiver,
        };
        match receiver {
            Some(r) => if r.lend {
                match self.place_path(&cx, r.value) {
                    Some(path) => items.push(&cx, Item::Path.(path)),
                    None => self.fails(&cx, "a lent receiver is not a place", c.pos),
                };
            } else {
                items.push(&cx, Item::Expr.(r.value));
            },
            None => (),
        };
        items.append(&cx, FnLower::exprs(&cx, c.args));
        let operands = match self.operands(&cx, items, Option::Some.(c)) {
            Some(o) => o,
            None => return Option::None,
        };
        let by_value = match call {
            Value => true,
            Closure => true,
            _ => false,
        };
        var callee_value = Span::from_static(&cx, "");
        if by_value {
            callee_value = operands.remove(&cx, 0usize);
        }
        match call {
            Closure => {
                // a closure is {env, code}: the code takes the environment first
                let parts = self.destruct(&cx, callee_value, self.vty.at(&cx, callee_value));
                callee_value = parts.at(&cx, 1usize).name;
                operands.insert(&cx, 0usize, parts.at(&cx, 0usize).name);
            },
            _ => (),
        };
        let rty = self.substitute_type(&cx, self.type_of(&cx, c.id));
        let (target, targs, requires_unsafe) = match call {
            Trait(t) => {
                var needs = false;
                let methods = self.lowering.sigs.traits.at(&cx, t.trait_name).methods;
                var i = 0usize;
                while i < methods.len(&cx) {
                    if methods.at(&cx, i).name.eq(&cx, t.method) {
                        needs = methods.at(&cx, i).is_unsafe;
                        i = methods.len(&cx);
                    } else {
                        i = i + 1usize;
                    }
                }
                (ArenaVec::two(&cx, t.trait_name, t.method), t.targs, needs)
            },
            Fn(f) => (ArenaVec::one(&cx, f.call_name()), f.targs(&cx), f.sig.is_unsafe),
            _ => (ArenaVec::one(&cx, callee_value), ArenaVec::new(&cx), self.fn_unsafe(&cx, callee_value)),
        };
        if requires_unsafe && !self.authorized(&cx, c.id) {
            self.fails(&cx, "calling an unsafe function needs unsafe", c.pos);
        }
        // A raw lend's explicit authorization discharges the core call instruction, but must not
        // authorize an independently unsafe callee in the surface.
        var raw_lend = false;
        var i = 0usize;
        while i < operands.len(&cx) {
            raw_lend = raw_lend || operands.at(&cx, i).starts_with(&cx, Span::from_static(&cx, "&*"));
            i = i + 1usize;
        }
        let args = target.clone(&cx);
        args.append(&cx, operands);
        let is_trait = match call {
            Trait(_t) => true,
            _ => false,
        };
        let result = self.emit(&cx, Op::new(&cx, if is_trait { "trait_call" } else { "call" }, rty, args).with_tys(self.substitute_all(&cx, targs))
            .from_node(c.id, c.pos).discharge(raw_lend));
        match rty {
            Never => {
                self.terminate(&cx, Terminator::Unreachable.(self.at.copy(&cx)));
                Option::None
            },
            _ => Option::Some.(result),
        }
    }

    fn fn_unsafe(self, &cx: Domain!['k], callee: Span['k]) -> bool {
        match self.vty.at(&cx, callee) {
            Fn(f) => f.is_unsafe,
            _ => self.fails(&cx, "internal error: a called value is not a function", self.at.copy(&cx)),
        }
    }

    // A call argument: a value, a lent place's path, or a raw pointer's target.
    fn operand(self, &cx: Domain!['k], item: Item['k], c: S::Call['k]) -> Option[Span['k]] {
        let arg = match item {
            Expr(e) => e,
            _ => return self.value(&cx, item),
        };
        var node = arg;
        var explicit = false;
        match node {
            Unary(u) => if u.op.is(&cx, "unsafe") {
                explicit = true;
                node = u.operand.copy(&cx);
            },
            _ => (),
        };
        match node {
            Unary(u) => if u.op.is(&cx, "&") {
                let target = u.operand.copy(&cx);
                match target {
                    Unary(deref) => if deref.op.is(&cx, "*") {
                        let p = self.expr(&cx, deref.operand.copy(&cx));
                        return match p {
                            Some(p) => {
                                if !(explicit || self.authorized(&cx, c.id)) {
                                    self.fails(&cx, "lending a raw pointer's target needs unsafe", expr_pos(arg));
                                }
                                let unit = match self.vty.get(&cx, p) {
                                    Some(t) => match t {
                                        Ptr(inner) => {
                                            if contains(&cx, self.lowering.types, inner.copy(&cx), |&cx, t: Type['k]| is_never(t)) {
                                                self.fails(&cx, "an unsafe lend of a pointer's target cannot lend a value that holds Never", expr_pos(arg));
                                            }
                                            self.raw_access(&cx, inner.copy(&cx), expr_pos(arg));
                                        },
                                        _ => (),
                                    },
                                    None => (),
                                };
                                Option::Some.(Buffer!::new().push_static("&*").push_bytes(&cx, p).save(&cx))
                            },
                            None => Option::None,
                        };
                    },
                    _ => (),
                };
                match self.place_path(&cx, target) {
                    Some(path) => return Option::Some.(path),
                    None => (),
                };
            },
            _ => (),
        };
        // `&x.m().n`: the & lends the receiver of the first call, not the argument
        self.expr(&cx, arg)
    }

    fn builtin(self, &cx: Domain!['k], c: S::Call['k], name: Span['k]) -> Option[Span['k]] {
        let rty = self.substitute_type(&cx, self.type_of(&cx, c.id));
        if name.is(&cx, "fresh") {
            return Option::Some.(self.emit(&cx, Op::new(&cx, "fresh", rty, ArenaVec::new(&cx))));
        }
        if name.is(&cx, "static_brand") {
            return Option::Some.(self.emit(&cx, Op::new(&cx, "static_brand", rty, ArenaVec::new(&cx)).from_node(c.id, c.pos)));
        }
        if name.is(&cx, "trap") {
            let unit = self.emit(&cx, Op::new(&cx, "trap", Type::Never, ArenaVec::new(&cx)).from_node(c.id, c.pos));
            self.terminate(&cx, Terminator::Unreachable.(self.at.copy(&cx)));
            return Option::None;
        }
        if name.is(&cx, "enum_variant") {
            let arg = c.args.at(&cx, 0usize);
            match arg {
                Unary(u) => if u.op.is(&cx, "&") {
                    let path = match self.place_path(&cx, u.operand.copy(&cx)) {
                        Some(p) => p,
                        None => self.fails(&cx, "enum_variant(&x) needs a local", c.pos),
                    };
                    return Option::Some.(self.emit(&cx, Op::new(&cx, "variant_tag", C::u32_type(&cx), ArenaVec::one(&cx, path)).typed(self.substitute_type(&cx, self.type_of(&cx, u.id)))));
                },
                _ => (),
            };
            let v = match self.expr(&cx, arg) {
                Some(v) => v,
                None => return Option::None,
            };
            let tag = self.emit(&cx, Op::new(&cx, "variant_tag", C::u32_type(&cx), ArenaVec::one(&cx, v)).typed(self.vty.at(&cx, v)));
            return Option::Some.(self.emit(&cx, Op::new(&cx, "construct", rty, ArenaVec::two(&cx, v, tag)).typed(rty)));
        }
        if name.is(&cx, "fence") {
            let order = self.atomic_ordering(&cx, Span::from_static(&cx, "fence"), c.args);
            return Option::Some.(self.emit(&cx, Op::new(&cx, "fence", C::unit(&cx), ArenaVec::new(&cx)).literal(order).from_node(c.id, c.pos)));
        }
        let operands = match self.operands(&cx, FnLower::exprs(&cx, c.args), Option::None) {
            Some(o) => o,
            None => return Option::None,
        };
        if name.is(&cx, "load_volatile") {
            return Option::Some.(self.emit(&cx, Op::new(&cx, "ptr_load_volatile", rty, operands).from_node(c.id, c.pos)));
        }
        Option::Some.(self.emit(&cx, Op::new(&cx, "ptr_store_volatile", C::unit(&cx), operands).from_node(c.id, c.pos)))
    }

    fn ordering(self, &cx: Domain!['k], e: Expr['k]) -> Span['k] {
        match e {
            Path(p) => match self.lowering.r.refs.get(&cx, p.id) {
                Some(r) => match r {
                    Variant(_d, name) => match ordering_name(&cx, name) {
                        Some(o) => return Span::from_static(&cx, o),
                        None => (),
                    },
                    _ => (),
                },
                None => (),
            },
            _ => (),
        };
        self.fails(&cx, "a memory ordering is written as an Ordering variant", expr_pos(e))
    }

    fn pointer_method(self, &cx: Domain!['k], c: S::Call['k], name: Span['k], receiver: Expr['k]) -> Option[Span['k]] {
        let params = pointer_params(&cx, name);
        let items = ArenaVec::one(&cx, Item::Expr.(receiver));
        let order_args: ArenaVec[Expr['k], 'k] = ArenaVec::new(&cx);
        var i = 0usize;
        while i < c.args.len(&cx) && i < params.len() {
            if params.byte_or_zero(&cx, i) == b'O' {
                order_args.push(&cx, c.args.at(&cx, i));
            } else {
                items.push(&cx, Item::Expr.(c.args.at(&cx, i)));
            }
            i = i + 1usize;
        }
        let kind = if name.starts_with(&cx, Span::from_static(&cx, "atomic_")) { name.skip(7usize) } else { name };
        let orders = if order_args.is_empty(&cx) { Option::None } else { Option::Some.(self.atomic_ordering(&cx, kind, order_args)) };
        let operands = match self.operands(&cx, items, Option::None) {
            Some(o) => o,
            None => return Option::None,
        };
        let op = if name.is(&cx, "load") || name.is(&cx, "store") || name.is(&cx, "load_volatile") || name.is(&cx, "store_volatile") {
            Buffer!::new().push_static("ptr_").push_bytes(&cx, name).save(&cx)
        } else {
            Buffer!::new().push_static("ptr_atomic_").push_bytes(&cx, kind).save(&cx)
        };
        let rty = self.substitute_type(&cx, self.type_of(&cx, c.id));
        Option::Some.(self.emit(&cx, Op::named(&cx, op, rty, operands).maybe_literal(orders)
            .from_node(c.id, c.pos)))
    }

    fn atomic_ordering(self, &cx: Domain!['k], kind: Span['k], args: ArenaVec[Expr['k], 'k]) -> Span['k] {
        let orders: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
        var i = 0usize;
        while i < args.len(&cx) {
            orders.push(&cx, self.ordering(&cx, args.at(&cx, i)));
            i = i + 1usize;
        }
        let order = orders.at(&cx, 0usize);
        if kind.is(&cx, "compare_exchange") {
            let failure = orders.at(&cx, 1usize);
            let allowed = failure.is(&cx, "relaxed")
                || failure.is(&cx, "acquire") && (order.is(&cx, "acquire") || order.is(&cx, "acq_rel") || order.is(&cx, "seq_cst"))
                || failure.is(&cx, "seq_cst") && order.is(&cx, "seq_cst");
            if !allowed {
                self.fail(&cx, Buffer!::new().push_static("compare_exchange failure ordering ").push_bytes(&cx, failure).push_static(" is invalid for success ordering ")
                    .push_bytes(&cx, order).save(&cx), expr_pos(args.at(&cx, 1usize)));
            }
        } else if kind.is(&cx, "load") && (order.is(&cx, "release") || order.is(&cx, "acq_rel"))
            || kind.is(&cx, "store") && (order.is(&cx, "acquire") || order.is(&cx, "acq_rel"))
            || kind.is(&cx, "fence") && order.is(&cx, "relaxed") {
            self.fail(&cx, Buffer!::new().push_static("atomic ").push_bytes(&cx, kind).push_static(" does not support ordering ").push_bytes(&cx, order).save(&cx), expr_pos(args.at(&cx, 0usize)));
        }
        var out = Buffer!::new();
        i = 0usize;
        while i < orders.len(&cx) {
            if i > 0usize {
                out = out.push_static("/");
            }
            out = out.push_bytes(&cx, orders.at(&cx, i));
            i = i + 1usize;
        }
        out.save(&cx)
    }

    // ---- control flow
    fn branch(self, &cx: Domain!['k], cond: Span['k], then: ArmBody['k], other: ArmBody['k], ty: Type['k], what: Slice[u8, 'static]) -> Option[Span['k]] {
        let a = self.new_block(&cx, ArenaVec::new(&cx), "b");
        let b = self.new_block(&cx, ArenaVec::new(&cx), "b");
        self.terminate(&cx, Terminator::Jnz.(cond, self.edge(&cx, a, ArenaVec::new(&cx)), self.edge(&cx, b, ArenaVec::new(&cx)), self.at.copy(&cx)));
        self.arms(&cx, ArenaVec::two(&cx, a, b), ArenaVec::two(&cx, then, other), ty, what)
    }

    fn expr_if(self, &cx: Domain!['k], x: S::If['k]) -> Option[Span['k]] {
        let c = match self.expr(&cx, x.cond.copy(&cx)) {
            Some(c) => c,
            None => return Option::None,
        };
        let other = match x.other {
            Some(o) => ArmBody::Value.(o.copy(&cx)),
            None => ArmBody::Unit,
        };
        self.branch(&cx, c, ArmBody::Value.(Expr::Block.(x.then)), other, self.type_of(&cx, x.id), "if")
    }

    fn expr_return(self, &cx: Domain!['k], value: Option[Ref[Expr['k], 'k]]) -> Option[Span['k]] {
        let v = match value {
            Some(e) => self.expr(&cx, e.copy(&cx)),
            None => Option::Some.(self.unit(&cx)),
        };
        if self.live(&cx) {
            match v {
                Some(v) => self.terminate(&cx, Terminator::Ret.(v, self.at.copy(&cx))),
                None => (),
            };
        }
        Option::None
    }

    fn expr_while(self, &cx: Domain!['k], w: S::While['k]) -> Option[Span['k]] {
        let head = self.new_block(&cx, ArenaVec::new(&cx), "while");
        self.loop_sites(&cx, head);
        self.jump(&cx, head, ArenaVec::new(&cx));
        self.start(&cx, head);
        let c = match self.expr(&cx, w.cond.copy(&cx)) {
            Some(c) => c,
            None => return Option::None,
        };
        let body = self.new_block(&cx, ArenaVec::new(&cx), "b");
        let exit = self.new_block(&cx, ArenaVec::new(&cx), "after");
        self.terminate(&cx, Terminator::Jnz.(c, self.edge(&cx, body, ArenaVec::new(&cx)), self.edge(&cx, exit, ArenaVec::new(&cx)), self.at.copy(&cx)));
        self.start(&cx, body);
        let unit = self.expr(&cx, Expr::Block.(w.body));
        if self.live(&cx) {
            self.jump(&cx, head, ArenaVec::new(&cx));
        }
        self.start(&cx, exit);
        Option::Some.(self.unit(&cx))
    }

    fn expr_for(self, &cx: Domain!['k], f: S::For['k]) -> Option[Span['k]] {
        let path = match f.iterator.copy(&cx) {
            Unary(u) => self.place_path(&cx, u.operand.copy(&cx)),
            _ => Option::None,
        };
        let path = match path {
            Some(p) => p,
            None => self.fails(&cx, "a for loop's iterator is not a place", f.pos),
        };
        let call = self.results().next_calls.at(&cx, f.id);
        let iterator_ty = self.substitute_type(&cx, call.targs.at(&cx, 0usize));
        let item = self.substitute_type(&cx, call.targs.at(&cx, 1usize));
        let option = self.substitute_type(&cx, self.results().options.at(&cx, f.id));
        let head = self.new_block(&cx, ArenaVec::new(&cx), "for");
        self.loop_sites(&cx, head);
        self.jump(&cx, head, ArenaVec::new(&cx));
        self.start(&cx, head);
        let args = ArenaVec::two(&cx, call.trait_name, call.method);
        args.push(&cx, path);
        let step = self.emit(&cx, Op::new(&cx, "trait_call", option, args).with_tys(ArenaVec::two(&cx, iterator_ty, item)));
        let item_ty = self.substitute_type(&cx, item);
        let item_name = self.fresh(&cx, "item");
        let some = self.new_block(&cx, ArenaVec::one(&cx, C::Binding.{ name: item_name, ty: item_ty }), "some");
        let unit_name = self.fresh(&cx, "unit");
        let none = self.new_block(&cx, ArenaVec::one(&cx, C::Binding.{ name: unit_name, ty: C::unit(&cx) }), "none");
        let arms = ArenaVec::two(&cx, C::Arm.{ variant: Span::from_static(&cx, "Some"), edge: self.edge(&cx, some, ArenaVec::new(&cx)) }, C::Arm.{ variant: Span::from_static(&cx, "None"), edge: self.edge(&cx, none, ArenaVec::new(&cx)) });
        self.terminate(&cx, Terminator::Switch.(step, option, arms, self.at.copy(&cx)));
        self.start(&cx, some);
        let saved = self.save_scope(&cx);
        self.declare(&cx, self.binder(&cx, f.id), f.name, item_ty, item_name);
        let unit = self.expr(&cx, Expr::Block.(f.body));
        self.restore_scope(&cx, saved);
        if self.live(&cx) {
            self.jump(&cx, head, ArenaVec::new(&cx));
        }
        self.start(&cx, none);
        Option::Some.(self.unit(&cx))
    }

    fn discard_pattern(self, &cx: Domain!['k], ty: Type['k]) {
        if !self.copy(&cx, ty) {
            self.fails(&cx, "a pattern cannot discard a linear value", self.at.copy(&cx));
        }
    }

    // One core arm per variant. A value arm covering several variants, or none by name, gets one
    // block per variant that takes the payload and jumps on; the coverage check discarded it.
    fn enum_switch(self, &cx: Domain!['k], s: Span['k], ty: Type['k], variants: ArenaVec[C::Member['k], 'k], covers: ArenaVec[ArenaVec[CoverItem['k], 'k], 'k], blocks: ArenaVec[BlockB['k], 'k], place: bool) {
        let arms: ArenaVec[C::Arm['k], 'k] = ArenaVec::new(&cx);
        let hops: ArenaVec[(BlockB['k], BlockB['k]), 'k] = ArenaVec::new(&cx);
        var i = 0usize;
        while i < covers.len(&cx) {
            let cover = covers.at(&cx, i);
            let block = blocks.at(&cx, i);
            var k = 0usize;
            while k < cover.len(&cx) {
                let variant = match cover.at(&cx, k) {
                    Variant(v) => v,
                    Range(_a, _b) => self.fails(&cx, "internal error: a range in an enum match", self.at.copy(&cx)),
                };
                if place || !block.params.is_empty(&cx) {
                    arms.push(&cx, C::Arm.{ variant, edge: self.edge(&cx, block, ArenaVec::new(&cx)) });
                } else {
                    let pay = self.fresh(&cx, "pay");
                    let hop = self.new_block(&cx, ArenaVec::one(&cx, C::Binding.{ name: pay, ty: member_type(&cx, variants, variant) }), "b");
                    arms.push(&cx, C::Arm.{ variant, edge: self.edge(&cx, hop, ArenaVec::new(&cx)) });
                    hops.push(&cx, (hop, block));
                }
                k = k + 1usize;
            }
            i = i + 1usize;
        }
        self.terminate(&cx, Terminator::Switch.(s, ty, arms, self.at.copy(&cx)));
        i = 0usize;
        while i < hops.len(&cx) {
            let (hop, block) = hops.at(&cx, i);
            self.start(&cx, hop);
            self.jump(&cx, block, ArenaVec::new(&cx));
            i = i + 1usize;
        }
    }

    fn compare(self, &cx: Domain!['k], s: Span['k], ty: Type['k], op: Slice[u8, 'static], bound: Int) -> Span['k] {
        let value = self.emit(&cx, Op::new(&cx, "load", ty, ArenaVec::one(&cx, s)));
        let limit = self.constant(&cx, ty, int_spelled(&cx, bound));
        self.emit(&cx, Op::new(&cx, op, C::bool_type(&cx), ArenaVec::two(&cx, value, limit)))
    }

    // An integer match as comparisons in arm order: each range is tested, and a miss goes on to the
    // next test; the wildcard arm takes what is left. The tests run in several blocks, so a
    // scrutinee value is kept in a temporary place and loaded by each.
    fn integer_tests(self, &cx: Domain!['k], scrutinee: Span['k], ty: Type['k], covers: ArenaVec[ArenaVec[CoverItem['k], 'k], 'k], blocks: ArenaVec[BlockB['k], 'k]) {
        var s = scrutinee;
        if !s.starts_with(&cx, Span::from_static(&cx, "&")) {
            let root = self.temporary(&cx, ty);
            let unit = self.emit(&cx, Op::new(&cx, "store", C::unit(&cx), ArenaVec::two(&cx, root, s)));
            s = root;
        }
        var i = 0usize;
        while i < covers.len(&cx) {
            let cover = covers.at(&cx, i);
            let block = blocks.at(&cx, i);
            if cover.is_empty(&cx) {
                self.jump(&cx, block, ArenaVec::new(&cx));
                return;
            }
            var k = 0usize;
            while k < cover.len(&cx) {
                let (lo, hi) = match cover.at(&cx, k) {
                    Range(lo, hi) => (lo, hi),
                    Variant(_v) => self.fails(&cx, "internal error: a variant in an integer match", self.at.copy(&cx)),
                };
                let miss = self.new_block(&cx, ArenaVec::new(&cx), "b");
                if int_eq(lo, hi) {
                    let test = self.compare(&cx, s, ty, "eq", lo);
                    self.terminate(&cx, Terminator::Jnz.(test, self.edge(&cx, block, ArenaVec::new(&cx)), self.edge(&cx, miss, ArenaVec::new(&cx)), self.at.copy(&cx)));
                } else {
                    let upper = self.new_block(&cx, ArenaVec::new(&cx), "b");
                    let low_test = self.compare(&cx, s, ty, "ge", lo);
                    self.terminate(&cx, Terminator::Jnz.(low_test, self.edge(&cx, upper, ArenaVec::new(&cx)), self.edge(&cx, miss, ArenaVec::new(&cx)), self.at.copy(&cx)));
                    self.start(&cx, upper);
                    let high_test = self.compare(&cx, s, ty, "le", hi);
                    self.terminate(&cx, Terminator::Jnz.(high_test, self.edge(&cx, block, ArenaVec::new(&cx)), self.edge(&cx, miss, ArenaVec::new(&cx)), self.at.copy(&cx)));
                }
                self.start(&cx, miss);
                k = k + 1usize;
            }
            i = i + 1usize;
        }
    }

    // Checks that the arms partition the scrutinee's values; returns each arm's cover with its
    // wildcard resolved: an integer arm's ranges, or an enum arm's variants.
    fn match_coverage(self, &cx: Domain!['k], m: S::Match['k], lent: bool, shape: Type['k], covers: ArenaVec[ArenaVec[CoverItem['k], 'k], 'k]) -> ArenaVec[ArenaVec[CoverItem['k], 'k], 'k] {
        let integer = match shape {
            Prim(name) => if C::is_integer(&cx, name) { Option::Some.(name) } else { Option::None },
            _ => Option::None,
        };
        match integer {
            Some(name) => {
                if covers.is_empty(&cx) || !covers.at(&cx, covers.len(&cx) - 1usize).is_empty(&cx) {
                    self.fails(&cx, "an integer match must end with a wildcard", m.pos);
                }
                let bits = C::literal_bits(&cx, name);
                let signed = name.starts_with(&cx, Span::from_static(&cx, "i"));
                let top = if bits == 64u32 { 18446744073709551615u64 } else { (1u64 << (bits as u64)) - 1u64 };
                let half = 1u64 << ((bits - 1u32) as u64);
                let low = if signed { Int.{ negative: true, magnitude: half } } else { Int.{ negative: false, magnitude: 0u64 } };
                let high = if signed { Int.{ negative: false, magnitude: half - 1u64 } } else { Int.{ negative: false, magnitude: top } };
                let spans: ArenaVec[(Int, Int), 'k] = ArenaVec::new(&cx);
                var k = 0usize;
                while k < covers.len(&cx) {
                    let cover = covers.at(&cx, k);
                    if cover.is_empty(&cx) && k + 1usize != covers.len(&cx) {
                        self.fails(&cx, "a match wildcard must come last", m.pos);
                    }
                    var j = 0usize;
                    while j < cover.len(&cx) {
                        let (lo, hi) = match cover.at(&cx, j) {
                            Range(lo, hi) => (lo, hi),
                            Variant(_v) => self.fails(&cx, "internal error: a variant in an integer match", m.pos),
                        };
                        var bad = !(int_le(low, lo) && int_le(lo, hi) && int_le(hi, high));
                        var s = 0usize;
                        while !bad && s < spans.len(&cx) {
                            let (l, h) = spans.at(&cx, s);
                            bad = int_le(lo, h) && int_le(l, hi);
                            s = s + 1usize;
                        }
                        if bad {
                            self.fails(&cx, "match ranges must fit the integer type and not overlap", m.pos);
                        }
                        spans.push(&cx, (lo, hi));
                        j = j + 1usize;
                    }
                    k = k + 1usize;
                }
                return covers;
            },
            None => (),
        };
        let variants = match shape {
            Enum(vs) => vs,
            _ => self.fails(&cx, "a match requires an integer or enum scrutinee", m.pos),
        };
        // The variants covered so far, freed once every arm is read.
        var seen = OwnedMap!::new[Span['k], bool](seed(&cx));
        let resolved: ArenaVec[ArenaVec[CoverItem['k], 'k], 'k] = ArenaVec::new(&cx);
        var k = 0usize;
        while k < covers.len(&cx) {
            let cover = covers.at(&cx, k);
            if cover.is_empty(&cx) && k + 1usize != covers.len(&cx) {
                self.fails(&cx, "a match wildcard must come last", m.pos);
            }
            let names: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
            var j = 0usize;
            while j < cover.len(&cx) {
                match cover.at(&cx, j) {
                    Variant(v) => names.push(&cx, v),
                    Range(_a, _b) => (),
                };
                j = j + 1usize;
            }
            if names.is_empty(&cx) {
                j = 0usize;
                while j < variants.len(&cx) {
                    match &seen.get_in(&cx, variants.at(&cx, j).name) {
                        None => names.push(&cx, variants.at(&cx, j).name),
                        Some(covered) => (),
                    };
                    j = j + 1usize;
                }
            }
            j = 0usize;
            while j < names.len(&cx) {
                let name = names.at(&cx, j);
                let repeated = match &seen.insert_in(&cx, name, true) {
                    None => false,
                    Some(covered) => true,
                };
                if !has_member(&cx, variants, name) || repeated {
                    self.fails(&cx, "match variants must not repeat", m.pos);
                }
                j = j + 1usize;
            }
            let arm = m.arms.at(&cx, k);
            let binds = arm.cases.len(&cx) == 1usize && arm.cases.at(&cx, 0usize).binders.is_some();
            if !lent && !binds {
                j = 0usize;
                while j < names.len(&cx) {
                    self.discard_pattern(&cx, member_type(&cx, variants, names.at(&cx, j)));
                    j = j + 1usize;
                }
            }
            let items: ArenaVec[CoverItem['k], 'k] = ArenaVec::new(&cx);
            j = 0usize;
            while j < names.len(&cx) {
                items.push(&cx, CoverItem::Variant.(names.at(&cx, j)));
                j = j + 1usize;
            }
            resolved.push(&cx, items);
            k = k + 1usize;
        }
        let missing: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
        var v = 0usize;
        while v < variants.len(&cx) {
            let name = variants.at(&cx, v).name;
            let covered = &seen.contains_in(&cx, name);
            if !covered {
                missing.push(&cx, name);
            }
            v = v + 1usize;
        }
        seen.destroy();
        if !missing.is_empty(&cx) {
            self.fail(&cx, Buffer!::new().push_static("a match must cover every enum variant; it misses ").push_bytes(&cx, listed(&cx, missing)).save(&cx), m.pos);
        }
        resolved
    }

    fn expr_match(self, &cx: Domain!['k], m: S::Match['k]) -> Option[Span['k]] {
        let lent = self.results().lent.get_or(&cx, m.id, false);
        let scrutinee = if lent {
            match m.scrutinee.copy(&cx) {
                Unary(u) => u.operand.copy(&cx),
                _ => self.fails(&cx, "internal error: a lent match without &", m.pos),
            }
        } else {
            m.scrutinee.copy(&cx)
        };
        let place = if lent { self.place_path(&cx, scrutinee) } else { Option::None };
        if lent && place.is_none() {
            self.fails(&cx, "match & needs a place", m.pos);
        }
        let s = match place {
            Some(p) => p,
            None => match self.expr(&cx, m.scrutinee.copy(&cx)) {
                Some(v) => v,
                None => return Option::None,
            },
        };
        let sty = self.substitute_type(&cx, self.type_of(&cx, expr_id(scrutinee)));
        match sty {
            Named(name, _args) => if self.kinds.contains(&cx, name) {
                self.fails(&cx, "a match requires an integer or enum scrutinee; an abstract type has no known matchable shape", m.pos);
            },
            _ => (),
        };
        let shape = self.lowering.types.shape(&cx, sty, Option::None);
        let covers: ArenaVec[ArenaVec[CoverItem['k], 'k], 'k] = ArenaVec::new(&cx);
        let blocks: ArenaVec[BlockB['k], 'k] = ArenaVec::new(&cx);
        var i = 0usize;
        while i < m.arms.len(&cx) {
            let arm = m.arms.at(&cx, i);
            let variant = match arm.cases.at(&cx, 0usize).kind {
                Variant => true,
                _ => false,
            };
            let single = arm.cases.len(&cx) == 1usize && variant;
            let payload: ArenaVec[C::Binding['k], 'k] = ArenaVec::new(&cx);
            if place.is_none() && single {
                let pay = self.fresh(&cx, "pay");
                payload.push(&cx, C::Binding.{ name: pay, ty: self.substitute_type(&cx, self.type_of(&cx, arm.cases.at(&cx, 0usize).id)) });
            }
            blocks.push(&cx, self.new_block(&cx, payload, "b"));
            let cover: ArenaVec[CoverItem['k], 'k] = ArenaVec::new(&cx);
            var k = 0usize;
            while k < arm.cases.len(&cx) {
                let case = arm.cases.at(&cx, k);
                match case.kind {
                    Variant => cover.push(&cx, CoverItem::Variant.(self.case_variant(&cx, case))),
                    Value => match case.low {
                        Some(low) => match case.high {
                            Some(high) => cover.push(&cx, CoverItem::Range.(int_of(low), int_of(high))),
                            None => (),
                        },
                        None => (),
                    },
                    Wild => (),
                };
                k = k + 1usize;
            }
            covers.push(&cx, cover);
            i = i + 1usize;
        }
        let covers = self.match_coverage(&cx, m, lent, shape, covers);
        match shape {
            Enum(variants) => self.enum_switch(&cx, s, sty, variants, covers, blocks, place.is_some()),
            _ => self.integer_tests(&cx, s, sty, covers, blocks),
        };
        let bodies: ArenaVec[ArmBody['k], 'k] = ArenaVec::new(&cx);
        i = 0usize;
        while i < m.arms.len(&cx) {
            bodies.push(&cx, ArmBody::Case.(m.arms.at(&cx, i), blocks.at(&cx, i), place));
            i = i + 1usize;
        }
        self.arms(&cx, blocks, bodies, self.type_of(&cx, m.id), "match")
    }

    fn case_variant(self, &cx: Domain!['k], case: S::Case['k]) -> Span['k] {
        match self.results().case_labels.get(&cx, case.id) {
            Some(name) => name,
            None => self.fails(&cx, "internal error: a variant case inference did not label", case.pos),
        }
    }

    // Binds the whole payload or its components, by value or by place alias.
    fn bind_payload(self, &cx: Domain!['k], case: S::Case['k], payload: Span['k], lent: bool) {
        let ty = self.substitute_type(&cx, self.type_of(&cx, case.id));
        let binders = match case.binders {
            Some(b) => b,
            None => ArenaVec::new(&cx),
        };
        let ids = self.results().case_binders.get_or(&cx, case.id, ArenaVec::new(&cx));
        let whole = binders.len(&cx) == 1usize;
        let types = if whole { ArenaVec::one(&cx, ty) } else { self.lowering.types.fields(&cx, ty, Option::None) };
        let sources: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
        if lent {
            let path = Buffer!::new().push_bytes(&cx, payload).push_static(".").push_bytes(&cx, self.case_variant(&cx, case)).save(&cx);
            if whole {
                sources.push(&cx, path);
            } else {
                var k = 0usize;
                while k < types.len(&cx) {
                    sources.push(&cx, Buffer!::new().push_bytes(&cx, path).push_static(".").push_usize(k).save(&cx));
                    k = k + 1usize;
                }
            }
        } else if whole {
            sources.push(&cx, payload);
        } else {
            let parts = self.destruct(&cx, payload, ty);
            var k = 0usize;
            while k < parts.len(&cx) {
                sources.push(&cx, parts.at(&cx, k).name);
                k = k + 1usize;
            }
        }
        var i = 0usize;
        while i < ids.len(&cx) && i < binders.len(&cx) && i < types.len(&cx) && i < sources.len(&cx) {
            let t = types.at(&cx, i);
            match ids.at(&cx, i) {
                Some(bid) => if lent {
                    self.bindings.insert(&cx, id_text(&cx, bid), Binding.{ name: binders.at(&cx, i), ty: t, path: Option::Some.(sources.at(&cx, i)), fields: Option::None });
                } else {
                    self.declare(&cx, id_text(&cx, bid), binders.at(&cx, i), t, sources.at(&cx, i));
                },
                None => if !lent {
                    self.discard_pattern(&cx, t);
                },
            };
            i = i + 1usize;
        }
    }

    fn expr_try(self, &cx: Domain!['k], id: u32, value: Expr['k]) -> Option[Span['k]] {
        let v = match self.expr(&cx, value) {
            Some(v) => v,
            None => return Option::None,
        };
        let enum_ty = self.vty.at(&cx, v);
        let result = self.results().try_kinds.get_or(&cx, id, Span::from_static(&cx, "")).is(&cx, "result");
        let ok = Span::from_static(&cx, if result { "Ok" } else { "Some" });
        let err = Span::from_static(&cx, if result { "Err" } else { "None" });
        let variants = match self.lowering.types.shape(&cx, enum_ty, Option::None) {
            Enum(vs) => vs,
            _ => self.fails(&cx, "internal error: `?` on a non-enum", self.at.copy(&cx)),
        };
        let ok_name = self.fresh(&cx, "ok");
        let ok_block = self.new_block(&cx, ArenaVec::one(&cx, C::Binding.{ name: ok_name, ty: member_type(&cx, variants, ok) }), "b");
        let err_name = self.fresh(&cx, "err");
        let err_block = self.new_block(&cx, ArenaVec::one(&cx, C::Binding.{ name: err_name, ty: member_type(&cx, variants, err) }), "b");
        let arms = ArenaVec::two(&cx, C::Arm.{ variant: ok, edge: self.edge(&cx, ok_block, ArenaVec::new(&cx)) }, C::Arm.{ variant: err, edge: self.edge(&cx, err_block, ArenaVec::new(&cx)) });
        self.terminate(&cx, Terminator::Switch.(v, enum_ty, arms, self.at.copy(&cx)));
        self.start(&cx, err_block);
        let ret = self.substitute_type(&cx, self.sig.ret);
        let failure = self.emit(&cx, Op::new(&cx, "construct_variant", ret, ArenaVec::one(&cx, err_name)).typed(ret).literal(err));
        self.terminate(&cx, Terminator::Ret.(failure, self.at.copy(&cx)));
        self.start(&cx, ok_block);
        Option::Some.(ok_name)
    }

    // ---- closures, foreach, f-strings
    fn capture_items(self, &cx: Domain!['k], captures: ArenaVec[Capture['k], 'k]) -> ArenaVec[Item['k], 'k] {
        let items: ArenaVec[Item['k], 'k] = ArenaVec::new(&cx);
        var i = 0usize;
        while i < captures.len(&cx) {
            items.push(&cx, Item::Bind.(self.bindings.at(&cx, id_text(&cx, captures.at(&cx, i).binder))));
            i = i + 1usize;
        }
        items
    }

    fn next_lifted(self, &cx: Domain!['k], kind: Slice[u8, 'static]) -> Span['k] {
        let n = self.lowering.closures.copy(&cx);
        self.lowering.closures.set(&cx, n + 1u64);
        Buffer!::new().push_bytes(&cx, self.name).push_static("#").push_static(kind).push_u64(n).save(&cx)
    }

    fn expr_closure(self, &cx: Domain!['k], c: S::Closure['k]) -> Option[Span['k]] {
        let ty = self.substitute_type(&cx, self.type_of(&cx, c.id));
        self.check_closed(&cx, ty, ArenaVec::new(&cx));
        let (env_ty, code_ty) = match ty {
            Struct(fields) => (fields.at(&cx, 0usize).ty, fields.at(&cx, 1usize).ty),
            _ => self.fails(&cx, "internal error: a closure type is not a struct", c.pos),
        };
        let captures = self.results().captures.get_or(&cx, c.id, ArenaVec::new(&cx));
        let vals = match self.operands(&cx, self.capture_items(&cx, captures), Option::None) {
            Some(v) => v,
            None => return Option::None,
        };
        let env = self.emit(&cx, Op::new(&cx, "construct", env_ty, vals).typed(env_ty));
        let code = match code_ty {
            Fn(f) => f,
            _ => self.fails(&cx, "internal error: a closure's code is not a function", c.pos),
        };
        let name = self.next_lifted(&cx, "closure");
        let places: ArenaVec[usize, 'k] = ArenaVec::new(&cx);
        let pnames = ArenaVec::one(&cx, Span::from_static(&cx, "env"));
        var i = 0usize;
        while i < c.params.len(&cx) {
            if c.params.at(&cx, i).lend {
                places.push(&cx, i + 1usize);
            }
            pnames.push(&cx, c.params.at(&cx, i).name);
            i = i + 1usize;
        }
        let sig = Sig.{ name, decl: Option::None, params: self.sig.params, premises: self.sig.premises, pnames, ptypes: code.params,
            places, ret: code.ret.copy(&cx), is_unsafe: false, home: self.sig.home };
        self.lift(&cx, sig, Mode::Closure.(c, env_ty), c.pos);
        let code_value = self.emit(&cx, Op::new(&cx, "fn", code_ty, ArenaVec::one(&cx, name)).with_tys(self.identity_args(&cx)));
        Option::Some.(self.emit(&cx, Op::new(&cx, "construct", ty, ArenaVec::two(&cx, env, code_value)).typed(ty)))
    }

    // Lowers a closure or foreach body to a function of its own.
    fn lift(self, &cx: Domain!['k], sig: Sig['k], mode: Mode['k], pos: Pos) {
        let inner = FnLower::new(&cx, self.lowering, sig, mode, sig.name, pos);
        let fun = inner.run(&cx);
        self.lowering.program.funs.insert(&cx, sig.name, fun);
    }

    fn expr_foreach(self, &cx: Domain!['k], f: S::Foreach['k]) -> Option[Span['k]] {
        let ty = self.substitute_type(&cx, self.type_of(&cx, f.id));
        self.check_closed(&cx, ty, ArenaVec::new(&cx));
        let captures = self.results().captures.get_or(&cx, f.id, ArenaVec::new(&cx));
        let items = ArenaVec::one(&cx, Item::Expr.(f.source.copy(&cx)));
        items.append(&cx, self.capture_items(&cx, captures));
        let vals = match self.operands(&cx, items, Option::None) {
            Some(v) => v,
            None => return Option::None,
        };
        let each = match ty {
            Foreach(x) => x,
            _ => self.fails(&cx, "internal error: a foreach type is not a foreach", f.pos),
        };
        // A mapped value (the map form) holds its components.
        let mapped = mapped_operand(self.vty.at(&cx, vals.at(&cx, 0usize)));
        let item = match mapped {
            Some(o) => mapped_component(&cx, o, C::named(each.binder, ArenaVec::new(&cx)), self.lowering.counter),
            None => foreach_item(&cx, each),
        };
        let name = self.next_lifted(&cx, "foreach");
        let params = ArenaVec::one(&cx, Param.{ name: each.binder, kind: Kind::Any });
        params.append(&cx, self.sig.params);
        let pnames = ArenaVec::one(&cx, f.name);
        let ptypes = ArenaVec::one(&cx, item);
        var i = 0usize;
        while i < captures.len(&cx) {
            pnames.push(&cx, captures.at(&cx, i).name);
            ptypes.push(&cx, self.bindings.at(&cx, id_text(&cx, captures.at(&cx, i).binder)).ty);
            i = i + 1usize;
        }
        let sig = Sig.{ name, decl: Option::None, params, premises: self.sig.premises, pnames, ptypes, places: ArenaVec::new(&cx),
            ret: each.body.copy(&cx), is_unsafe: false, home: self.sig.home };
        self.lift(&cx, sig, Mode::Mapper.(f), f.pos);
        let args = ArenaVec::two(&cx, vals.at(&cx, 0usize), name);
        args.append(&cx, vals.skip(&cx, 1usize));
        Option::Some.(self.emit(&cx, Op::new(&cx, "foreach", ty, args).typed(ty).with_tys(self.identity_args(&cx)).from_node(f.id, f.pos)))
    }

    fn expr_fstring(self, &cx: Domain!['k], f: S::FStr['k]) -> Option[Span['k]] {
        let sig = self.lowering.library_sig(&cx, "Buffer!::new", self.home);
        let writer = self.emit(&cx, Op::new(&cx, "call", self.substitute_type(&cx, self.type_of(&cx, f.id)), ArenaVec::one(&cx, sig.name)));
        self.fstring(&cx, f, writer)
    }

    // Writes each piece into the writer: text through `Writer::write_static`, `{expr}` through
    // `Format::format`, which hands the value back (`{&x}` stores it again).
    fn fstring(self, &cx: Domain!['k], f: S::FStr['k], start: Span['k]) -> Option[Span['k]] {
        var writer = start;
        let wty = self.vty.at(&cx, writer);
        let writer_trait = self.lowering.library_name(&cx, "Writer", self.home);
        let format = self.lowering.library_name(&cx, "Format", self.home);
        var i = 0usize;
        while i < f.parts.len(&cx) {
            match f.parts.at(&cx, i) {
                Text(t) => if !t.is_empty() {
                    let s = self.string(&cx, t);
                    let args = ArenaVec::two(&cx, writer_trait, Span::from_static(&cx, "write_static"));
                    args.push(&cx, writer);
                    args.push(&cx, s);
                    writer = self.emit(&cx, Op::new(&cx, "trait_call", wty, args).with_tys(ArenaVec::one(&cx, wty)));
                },
                Expr(part) => {
                    let (lend, operand) = match part {
                        Unary(u) => if u.op.is(&cx, "&") { (true, u.operand.copy(&cx)) } else { (false, part) },
                        _ => (false, part),
                    };
                    let values = match self.operands(&cx, ArenaVec::two(&cx, Item::Path.(writer), Item::Expr.(operand)), Option::None) {
                        Some(v) => v,
                        None => return Option::None,
                    };
                    writer = values.at(&cx, 0usize);
                    let v = values.at(&cx, 1usize);
                    let vty = self.vty.at(&cx, v);
                    if !lend && !self.copy(&cx, vty) {
                        match written_place(&cx, part) {
                            Some(place) => self.fail(&cx, Buffer!::new().push_static("{").push_bytes(&cx, place).push_static("} in an f-string drops a linear value; lend it with {&")
                                .push_bytes(&cx, place).push_static("}").save(&cx), expr_pos(part)),
                            None => self.fails(&cx, "a value in an f-string is formatted and dropped, and this one is linear; bind it to a var and lend that", expr_pos(part)),
                        }
                    }
                    let pair = Type::Tuple.(ArenaVec::two(&cx, vty, wty));
                    let args = ArenaVec::two(&cx, format, Span::from_static(&cx, "format"));
                    args.push(&cx, v);
                    args.push(&cx, writer);
                    let both = self.emit(&cx, Op::new(&cx, "trait_call", pair, args).with_tys(ArenaVec::two(&cx, vty, wty)));
                    let parts = self.destruct(&cx, both, pair);
                    writer = parts.at(&cx, 1usize).name;
                    if lend {
                        self.put_back(&cx, operand, parts.at(&cx, 0usize).name);
                    }
                },
            };
            i = i + 1usize;
        }
        Option::Some.(writer)
    }

    // `f"...".write(&cx, out)`: the capability moved out of the place `cx` and the writer `out` are
    // wrapped in `ReadingWriter![W, C]::new(out, cx)`, each segment is written through it, and
    // `finish` hands back the writer, which is the result, and the capability, which goes back into
    // `cx`.
    fn fstring_reading(self, &cx: Domain!['k], f: S::FStr['k], out_expr: Expr['k], place: Expr['k]) -> Option[Span['k]] {
        let values = match self.operands(&cx, ArenaVec::two(&cx, Item::Expr.(out_expr), Item::Expr.(place)), Option::None) {
            Some(v) => v,
            None => return Option::None,
        };
        let out = values.at(&cx, 0usize);
        let context = values.at(&cx, 1usize);
        let wty = self.vty.at(&cx, out);
        let cty = self.vty.at(&cx, context);
        let tys = ArenaVec::two(&cx, wty, cty);
        let reading = C::named(self.lowering.library_name(&cx, "ReadingWriter!", self.home), tys);
        let new = self.lowering.library_sig(&cx, "ReadingWriter!::new", self.home);
        let args = ArenaVec::two(&cx, new.name, out);
        args.push(&cx, context);
        let writer = match self.fstring(&cx, f, self.emit(&cx, Op::new(&cx, "call", reading, args).with_tys(tys))) {
            Some(w) => w,
            None => return Option::None,
        };
        let finish = self.lowering.library_sig(&cx, "ReadingWriter!::finish", self.home);
        let pair = Type::Tuple.(tys);
        let both = self.emit(&cx, Op::new(&cx, "call", pair, ArenaVec::two(&cx, finish.name, writer)).with_tys(tys));
        let parts = self.destruct(&cx, both, pair);
        self.put_back(&cx, place, parts.at(&cx, 1usize).name);
        Option::Some.(parts.at(&cx, 0usize).name)
    }

    // Stores `value` in the place it was moved out of: a lent `{&x}`'s or a written f-string's context.
    fn put_back(self, &cx: Domain!['k], place: Expr['k], value: Span['k]) {
        let path = match self.place_path(&cx, place) {
            Some(p) => p,
            None => self.fails(&cx, "{&x} in an f-string needs a local or a place", self.at.copy(&cx)),
        };
        let unit = self.emit(&cx, Op::new(&cx, "store", C::unit(&cx), ArenaVec::two(&cx, path, value)));
    }

    // ---- brands
    fn expr_pack(self, &cx: Domain!['k], p: S::Pack['k]) -> Option[Span['k]] {
        let v = match self.expr(&cx, p.value.copy(&cx)) {
            Some(v) => v,
            None => return Option::None,
        };
        let witnesses = self.substitute_all(&cx, self.results().witnesses.get_or(&cx, p.id, ArenaVec::new(&cx)));
        let ty = self.substitute_type(&cx, self.type_of(&cx, p.id));
        Option::Some.(self.emit(&cx, Op::new(&cx, "pack", ty, ArenaVec::one(&cx, v)).typed(ty).with_tys(witnesses)))
    }

    // ---- statements
    fn stmt(self, &cx: Domain!['k], s: Statement['k]) {
        let previous = self.at.copy(&cx);
        let pos = match s {
            Let(l) => l.pos,
            Assign(a) => a.pos,
            Expr(n) => n.pos,
            Const(c) => c.pos,
        };
        self.at.set(&cx, pos);
        match s {
            Let(l) => self.let_stmt(&cx, l),
            Const(c) => {
                let value = self.results().folded.at(&cx, c.id);
                let ty = match const_type(&cx, value) {
                    Some(t) => t,
                    None => self.fails(&cx, "internal error: an untyped constant", c.pos),
                };
                self.declare(&cx, self.binder(&cx, c.id), c.name, ty, self.constant_value(&cx, value));
            },
            Assign(a) => self.assign(&cx, a),
            Expr(n) => match self.expr(&cx, n.value) {
                Some(value) => if !self.copy(&cx, self.vty.at(&cx, value)) {
                    self.fails(&cx, "cannot discard a linear expression result; bind or consume it", expr_pos(n.value));
                },
                None => (),
            },
        };
        self.at.set(&cx, previous);
    }

    fn let_stmt(self, &cx: Domain!['k], l: S::Let['k]) {
        var v = match self.expr(&cx, l.value) {
            Some(v) => v,
            None => return,
        };
        if !l.brands.is_empty(&cx) {
            let (binders, body) = match self.lowering.types.shape(&cx, self.vty.at(&cx, v), Option::None) {
                Exists(binders, body) => (binders, body.copy(&cx)),
                _ => self.fails(&cx, "internal error: opening a non-package", l.pos),
            };
            let opened = self.results().opened.get_or(&cx, l.id, ArenaVec::new(&cx));
            let actual: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
            var i = 0usize;
            while i < opened.len(&cx) {
                actual.push(&cx, Buffer!::new().push_bytes(&cx, opened.at(&cx, i)).push_static("#").push_bytes(&cx, self.fresh(&cx, "").skip(1usize)).save(&cx));
                i = i + 1usize;
            }
            let sub: ArenaMap[Span['k], Type['k], 'k] = ArenaMap::new(&cx);
            i = 0usize;
            while i < binders.len(&cx) && i < actual.len(&cx) {
                sub.insert(&cx, binders.at(&cx, i), Type::Skolem.(actual.at(&cx, i)));
                i = i + 1usize;
            }
            let payload = subst(&cx, body, sub, self.lowering.counter);
            v = self.emit(&cx, Op::new(&cx, "open", payload, ArenaVec::one(&cx, v)).opening(actual));
            i = 0usize;
            while i < opened.len(&cx) && i < actual.len(&cx) {
                self.brand_map.copy(&cx).insert(&cx, opened.at(&cx, i), Type::Skolem.(actual.at(&cx, i)));
                i = i + 1usize;
            }
            self.open_brands.copy(&cx).append(&cx, actual);
        }
        self.pattern(&cx, l.pattern, v);
    }

    fn pattern(self, &cx: Domain!['k], p: Pattern['k], value: Span['k]) {
        match p {
            Bind(n) => self.declare(&cx, self.binder(&cx, n.id), n.value, self.type_of(&cx, n.id), value),
            Wild(_id) => self.discard_pattern(&cx, self.vty.at(&cx, value)),
            Tuple(n) => self.elements(&cx, n.value, value),
            Array(n) => self.elements(&cx, n.value, value),
            Struct(ps) => {
                let ty = self.vty.at(&cx, value);
                let comps = self.destruct(&cx, value, ty);
                let fields = match self.lowering.types.shape(&cx, ty, Option::None) {
                    Struct(fields) => fields,
                    _ => self.fails(&cx, "internal error: a struct pattern on a non-struct", self.at.copy(&cx)),
                };
                let named: ArenaMap[Span['k], Pattern['k], 'k] = ArenaMap::new(&cx);
                var i = 0usize;
                while i < ps.fields.len(&cx) {
                    named.insert(&cx, ps.fields.at(&cx, i).name, ps.fields.at(&cx, i).pattern);
                    i = i + 1usize;
                }
                let rest: ArenaMap[Span['k], Span['k], 'k] = ArenaMap::new(&cx);
                let rest_id = self.results().rest_ids.get(&cx, ps.id);
                i = 0usize;
                while i < fields.len(&cx) && i < comps.len(&cx) {
                    let name = fields.at(&cx, i).name;
                    let c = comps.at(&cx, i);
                    match named.get(&cx, name) {
                        Some(sub) => self.pattern(&cx, sub, c.name),
                        None => match ps.rest {
                            Some(_r) => {
                                let bid = Buffer!::new().push_bytes(&cx, id_text(&cx, match rest_id {
                                    Some(id) => id,
                                    None => self.fails(&cx, "internal error: a rest pattern without an id", self.at.copy(&cx)),
                                })).push_static("_").push_bytes(&cx, name).save(&cx);
                                rest.insert(&cx, name, bid);
                                self.declare(&cx, bid, name, c.ty, c.name);
                            },
                            None => self.discard_pattern(&cx, c.ty),
                        },
                    };
                    i = i + 1usize;
                }
                match ps.rest {
                    Some(r) => match rest_id {
                        Some(id) => { self.bindings.insert(&cx, id_text(&cx, id), Binding.{ name: r, ty: C::unit(&cx), path: Option::None, fields: Option::Some.(rest) }); },
                        None => (),
                    },
                    None => (),
                };
            },
        }
    }

    fn elements(self, &cx: Domain!['k], elems: ArenaVec[Pattern['k], 'k], value: Span['k]) {
        let parts = self.destruct(&cx, value, self.vty.at(&cx, value));
        var i = 0usize;
        while i < elems.len(&cx) && i < parts.len(&cx) {
            self.pattern(&cx, elems.at(&cx, i), parts.at(&cx, i).name);
            i = i + 1usize;
        }
    }

    fn assign(self, &cx: Domain!['k], a: S::Assign['k]) {
        let v = match self.expr(&cx, a.value) {
            Some(v) => v,
            None => return,
        };
        let path = match a.target {
            Path(p) => self.local(&cx, p.id).path,
            _ => self.place_path(&cx, a.target),
        };
        match path {
            Some(p) => {
                let unit = self.emit(&cx, Op::new(&cx, "store", C::unit(&cx), ArenaVec::two(&cx, p, v)));
            },
            None => self.fails(&cx, "assignment through a field needs a place", a.pos),
        };
    }
}

forall 'k.
fn is_short_circuit(&cx: Domain!['k], op: Span['k]) -> bool {
    op.is(&cx, "&&") || op.is(&cx, "||")
}

// A link of a chain of binary operators: its two operands.
forall 'k.
fn link_items(&cx: Domain!['k], b: S::Binop['k]) -> ArenaVec[Item['k], 'k] {
    ArenaVec::two(&cx, Item::Expr.(b.left.copy(&cx)), Item::Expr.(b.right.copy(&cx)))
}

forall 'k.
fn member_type(&cx: Domain!['k], members: ArenaVec[C::Member['k], 'k], name: Span['k]) -> Type['k] {
    var i = 0usize;
    while i < members.len(&cx) {
        if members.at(&cx, i).name.eq(&cx, name) {
            return members.at(&cx, i).ty;
        }
        i = i + 1usize;
    }
    C::unit(&cx)
}

forall 'k.
fn has_member(&cx: Domain!['k], members: ArenaVec[C::Member['k], 'k], name: Span['k]) -> bool {
    var i = 0usize;
    while i < members.len(&cx) {
        if members.at(&cx, i).name.eq(&cx, name) {
            return true;
        }
        i = i + 1usize;
    }
    false
}

// The core program for a resolved, signature-built package graph: every body inferred, lowered,
// its place contracts planned and its branded roots promoted.
forall 'k.
fn lower(&cx: Domain!['k], r: Resolver['k], sigs: Signatures['k], counter: Fresh['k]) -> Program['k] {
    lower_inferred(&cx, r, sigs, infer(&cx, r, sigs, counter).out, counter)
}

// Lower bodies whose types have already been inferred. Kept separate so `build --times` can
// measure inference and lowering independently without doing either work twice.
forall 'k.
fn lower_inferred(&cx: Domain!['k], r: Resolver['k], sigs: Signatures['k], results: Results['k], counter: Fresh['k]) -> Program['k] {
    let program = Program.{ types: sigs.types, funs: ArenaMap::new(&cx), externs: ArenaMap::new(&cx), datas: ArenaMap::new(&cx), traits: sigs.traits, instances: ArenaMap::new(&cx) };
    let lowering = Lowering.{ r, sigs, results, program, types: Types::new(&cx, program, counter), counter, datas: ArenaMap::new(&cx),
        closures: ref_in(&cx, 0u64), value_types: ArenaMap::new(&cx), sites: ArenaMap::new(&cx) };
    lowering.run(&cx)
}

forall 'k.
fn is_non_null(t: Type['k]) -> bool {
    match t {
        NonNull(_inner) => true,
        _ => false,
    }
}

// A pointer, raw or `NonNull`.
forall 'k.
fn is_pointer(t: Type['k]) -> bool {
    match t {
        Ptr(_inner) => true,
        NonNull(_inner) => true,
        _ => false,
    }
}
