// Lowering: inferred surface to KURS.
//
// Ordinary local variables start in places, with loads and stores, and explicit CFG contracts
// computed by forward dataflow (`placeflow`). A final frontend pass (`promote`) promotes roots whose
// contents mention nongeneric brands to SSA block arguments, decomposing projected products and
// generating generic value adapters for lending. Only function-generic brands may remain in core
// local declarations.
//
// `lower` first infers every function body in the resolved, signature-built graph. `FnLower` reads
// what inference found, by syntax node id: local uses and binders have matching ids, calls have
// targets, and closures have captures. Core types and call substitutions have their solved
// metavariables replaced. Annotations conditional on syntax (such as a struct spread's id) are read
// only for that form; lookup-only paths and folded constant subexpressions need no type.
//
// The result is a core program, ready for core checking before C emission.

use package::support::base::{Cell, Cx, Map, Out, Seq, Set, Text, text};
use package::check::checker::overlap;
use package::kurs::core::{Block, Data, Edge, Extern, Fun, Instance, Instr, Kind, ModuleId, Param, Program, Terminator, Type};
use package::kurs::core as C;
use package::infer::inference::{Callee, Capture, Results, infer, pointer_params};
use package::types::literals::valid_literal;
use package::lower::placeflow::PlaceFlow;
use package::lower::promote::promote_locals;
use package::resolve::resolver::{NameRef, Named, Resolver};
use package::kurs::sexpr::{Form, FormKind};
use package::sigs::signatures::{ConstValue, Sig, Signatures, const_type, int_text};
use package::syntax::ast as S;
use package::syntax::ast::{Expr, Pattern, Pos, Statement, expr_id, expr_pos, no_pos};
use package::types::ops::{Fresh, Types, foreach_binders, foreach_item, free_brands, mentions_brand, subst};
use std::option::Option;
use std::slice::Slice;

forall 'k.
fn binop_name(&cx: Cx!['k], op: Text['k]) -> Slice[u8, 'static] {
    if op.is(&cx, "+") { "add" } else if op.is(&cx, "-") { "sub" } else if op.is(&cx, "*") { "mul" } else if op.is(&cx, "/") { "div" }
    else if op.is(&cx, "%") { "mod" } else if op.is(&cx, "&") { "bit_and" } else if op.is(&cx, "|") { "bit_or" }
    else if op.is(&cx, "^") { "bit_xor" } else if op.is(&cx, "<<") { "shl" } else if op.is(&cx, ">>") { "shr" }
    else if op.is(&cx, "==") { "eq" } else if op.is(&cx, "!=") { "ne" } else if op.is(&cx, "<") { "lt" } else if op.is(&cx, "<=") { "le" }
    else if op.is(&cx, ">") { "gt" } else { "ge" }
}

// An `Ordering` variant's core spelling.
forall 'k.
fn ordering_name(&cx: Cx!['k], variant: Text['k]) -> Option[Slice[u8, 'static]] {
    if variant.is(&cx, "Relaxed") {
        Option::Some.("relaxed")
    } else if variant.is(&cx, "Acquire") {
        Option::Some.("acquire")
    } else if variant.is(&cx, "Release") {
        Option::Some.("release")
    } else if variant.is(&cx, "AcqRel") {
        Option::Some.("acq_rel")
    } else if variant.is(&cx, "SeqCst") {
        Option::Some.("seq_cst")
    } else {
        Option::None
    }
}

forall 'k.
fn lends(&cx: Cx!['k], arg: Text['k]) -> bool {
    arg.starts_with(&cx, text(&cx, "&")) && !arg.starts_with(&cx, text(&cx, "&*"))
}

forall 'k.
fn is_unit(&cx: Cx!['k], t: Type['k]) -> bool {
    C::same(&cx, t, C::unit(&cx))
}

forall 'k.
fn id_text(&cx: Cx!['k], id: u32) -> Text['k] {
    Out::new(&cx).u64(&cx, id as u64).done(&cx)
}

// ---------------------------------------------------------- match coverage --

// An integer of any primitive type: its sign and magnitude, zero never negative.
exposed struct Int {
    negative: bool,
    magnitude: u64,
}

forall 'k.
fn int_of(l: S::Lit['k]) -> Int {
    Int.{ negative: l.negative && l.int != 0u64, magnitude: l.int }
}

fn int_le(a: Int, b: Int) -> bool {
    if a.negative != b.negative {
        a.negative
    } else if a.negative {
        a.magnitude >= b.magnitude
    } else {
        a.magnitude <= b.magnitude
    }
}

fn int_eq(a: Int, b: Int) -> bool {
    a.negative == b.negative && a.magnitude == b.magnitude
}

forall 'k.
fn int_spelled(&cx: Cx!['k], a: Int) -> Text['k] {
    if a.negative {
        Out::new(&cx).put(&cx, "-").u64(&cx, a.magnitude).done(&cx)
    } else {
        Out::new(&cx).u64(&cx, a.magnitude).done(&cx)
    }
}

// What a match arm covers: enum variant names, or integer ranges; nothing for the wildcard.
forall 'k.
exposed enum CoverItem {
    Variant(Text['k]),
    Range(Int, Int),
}

// ------------------------------------------------------------ the program --

// A source binding: a variable and the place that holds it, or a `..rest` bundle, whose fields are
// the ids of bindings.
forall 'k.
exposed struct Binding {
    name: Text['k],
    type: Type['k],
    path: Option[Text['k]],
    fields: Option[Map[Text['k], Text['k], 'k]],
}

// A block under construction.
forall 'k.
exposed struct BlockB {
    label: Text['k],
    params: Seq[C::Binding['k], 'k],
    instrs: Seq[Instr['k], 'k],
    term: Cell[Option[Terminator['k]], 'k],
    brands: Seq[Text['k], 'k],
}

// The program-wide state.
forall 'k.
exposed struct Lowering {
    r: Resolver['k],
    sigs: Signatures['k],
    results: Results['k],
    program: Program['k],
    types: Types['k],
    counter: Fresh['k],
    // string bytes -> the data holding them
    datas: Map[Text['k], Text['k], 'k],
    closures: Cell[u64, 'k],
    // a function with branded locals (by `fun_key`) -> the types of its SSA values, for promotion
    value_types: Map[usize, Map[Text['k], Type['k], 'k], 'k],
}

// A function's identity, as long as it lives: its block sequence's.
forall 'k.
fn fun_key(fun: Fun['k]) -> usize {
    fun.blocks.address()
}

forall 'k.
impl Lowering['k] {
    fn library_name(self, &cx: Cx!['k], name: Slice[u8, 'static], home: ModuleId['k]) -> Text['k] {
        self.sigs.name(&cx, self.sigs.library(&cx, home, text(&cx, name)))
    }

    fn library_sig(self, &cx: Cx!['k], name: Slice[u8, 'static], home: ModuleId['k]) -> Sig['k] {
        self.sigs.sigs.at(&cx, self.sigs.library(&cx, home, text(&cx, name)).id)
    }

    fn run(self, &cx: Cx!['k]) -> Program['k] {
        let program = self.program;
        let sigs = self.sigs.sigs.values(&cx);
        var i = 0usize;
        while i < sigs.len(&cx) {
            let sig = sigs.get(&cx, i);
            match sig.decl {
                Option::Some(decl) => match decl.node {
                    Named::Extern(x) => if decl.kind.is(&cx, "extern") {
                        program.externs.set(&cx, x.name, Extern.{ name: x.name, ret: Option::Some.(sig.ret), ptypes: Option::Some.(sig.ptypes), pos: no_pos() });
                    },
                    Named::Fn(node) => if node.body.is_some() {
                        self.r.locate(&cx, decl.home, node.pos);
                        let fun = FnLower::new(&cx, self, sig, Mode::Plain.(node), sig.name, node.pos).run(&cx);
                        self.r.unlocate(&cx);
                        program.funs.set(&cx, sig.name, fun);
                    },
                    _ => (),
                },
                Option::None => (),
            };
            i = i + 1usize;
        }
        i = 0usize;
        while i < self.sigs.instances.len(&cx) {
            let (inst, item, home) = self.sigs.instances.get(&cx, i);
            let methods: Seq[Fun['k], 'k] = Seq::new(&cx);
            var k = 0usize;
            while k < inst.methods.len(&cx) && k < item.methods.len(&cx) {
                let sig = inst.methods.get(&cx, k);
                let node = item.methods.get(&cx, k);
                self.r.locate(&cx, home, node.pos);
                let fun = FnLower::new(&cx, self, sig, Mode::Plain.(node), node.name, node.pos).run(&cx);
                self.r.unlocate(&cx);
                let { params: _p, premises: _q, ..rest } = fun;
                methods.push(&cx, Fun.{ params: sig.params.from(&cx, inst.params.len(&cx)), premises: sig.premises.from(&cx, inst.premises.len(&cx)), ..rest });
                k = k + 1usize;
            }
            let lowered = Instance.{ trait_name: inst.trait_name, params: inst.params, premises: inst.premises, head: inst.head, methods,
                home: Option::Some.(inst.home), pos: inst.pos };
            match program.instances.get(&cx, inst.trait_name) {
                Option::Some(list) => list.push(&cx, lowered),
                Option::None => program.instances.set(&cx, inst.trait_name, Seq::one(&cx, lowered)),
            };
            i = i + 1usize;
        }
        let flow = PlaceFlow::new(&cx, program, self.r, self.counter);
        // functions' formation errors are located in their files
        flow.checker.formation.reporter.set(&cx, Option::Some.(self.r));
        let funs = program.funs.values(&cx);
        i = 0usize;
        while i < funs.len(&cx) {
            self.plan(&cx, flow, funs.get(&cx, i), Seq::new(&cx), Seq::new(&cx));
            i = i + 1usize;
        }
        let groups = program.instances.values(&cx);
        i = 0usize;
        while i < groups.len(&cx) {
            let insts = groups.get(&cx, i);
            var k = 0usize;
            while k < insts.len(&cx) {
                let inst = insts.get(&cx, k);
                var m = 0usize;
                while m < inst.methods.len(&cx) {
                    self.plan(&cx, flow, inst.methods.get(&cx, m), inst.params, inst.premises);
                    m = m + 1usize;
                }
                k = k + 1usize;
            }
            i = i + 1usize;
        }
        program
    }

    // Plans `fun`'s place contracts and promotes its branded roots; an instance method's `outer`
    // parameters and premises are its instance's.
    fn plan(self, &cx: Cx!['k], flow: PlaceFlow['k], fun: Fun['k], outer: Seq[Param['k], 'k], outer_premises: Seq[C::Premise['k], 'k]) {
        let located = match fun.home {
            Option::Some(home) => {
                self.r.locate(&cx, home, fun.pos);
                true
            },
            Option::None => false,
        };
        flow.plan(&cx, fun, outer);
        let params = outer.copy(&cx);
        params.append(&cx, fun.params);
        let premises = outer_premises.copy(&cx);
        premises.append(&cx, fun.premises);
        let key = fun_key(fun);
        let value_types = self.value_types.get_or(&cx, key, Map::new(&cx));
        self.value_types.remove(&cx, key);
        let helpers = promote_locals(&cx, fun, self.types, params, premises, value_types, self.r, self.counter);
        var i = 0usize;
        while i < helpers.len(&cx) {
            let helper = helpers.get(&cx, i);
            self.program.funs.set(&cx, helper.name, helper);
            flow.checker.formation.function(&cx, helper, Seq::new(&cx), Seq::new(&cx));
            i = i + 1usize;
        }
        flow.checker.formation.function(&cx, fun, outer, outer_premises);
        if located {
            self.r.unlocate(&cx);
        }
    }

    // A static byte array holding `bytes`: its name and length.
    fn data(self, &cx: Cx!['k], bytes: Text['k]) -> (Text['k], usize) {
        match self.datas.get(&cx, bytes) {
            Option::Some(label) => return (label, bytes.len()),
            Option::None => (),
        };
        let label = Out::new(&cx).put(&cx, "string#").usize(&cx, self.datas.len(&cx)).done(&cx);
        let item = Form.{ kind: FormKind::Str, text: bytes, items: Seq::new(&cx), pos: no_pos() };
        let init = Form.{ kind: FormKind::List, text: text(&cx, ""), items: Seq::one(&cx, item), pos: no_pos() };
        self.datas.set(&cx, bytes, label);
        self.program.datas.set(&cx, label, Data.{ name: label, ty: Type::Array.(Cell::new(&cx, C::prim(&cx, "u8")), bytes.len() as u64), init, home: Option::None });
        (label, bytes.len())
    }
}

// --------------------------------------------------------- one function --

// What is being lowered: a function's body, a closure's (with its environment's type) or a foreach
// body's, the last two lifted out of the function containing them.
forall 'k.
exposed enum Mode {
    Plain(S::Fn['k]),
    Closure(S::Closure['k], Type['k]),
    Mapper(S::Foreach['k]),
}

// An operand to evaluate: an expression, a binding to read, or a place path or value already known.
forall 'k.
exposed enum Item {
    Expr(Expr['k]),
    Bind(Binding['k]),
    Path(Text['k]),
}

// What one arm of a branch evaluates.
forall 'k.
exposed enum ArmBody {
    Value(Expr['k]),
    Unit,
    Constant(Text['k]),
    // a match arm, its block, and the place a lent match switches on
    Case(S::Arm['k], BlockB['k], Option[Text['k]]),
}

// An instruction to emit: its operation, result type and arguments; the node it comes from, whose
// `unsafe` discharges it and whose position it takes; and its other parts.
forall 'k.
exposed struct Op {
    name: Text['k],
    rty: Type['k],
    args: Seq[Text['k], 'k],
    node: Option[(u32, Pos)],
    discharged: bool,
    ty: Option[Type['k]],
    tys: Seq[Type['k], 'k],
    lit: Option[Text['k]],
    binders: Seq[Text['k], 'k],
    pos: Pos,
}

forall 'k.
impl Op['k] {
    fn new(&cx: Cx!['k], name: Slice[u8, 'static], rty: Type['k], args: Seq[Text['k], 'k]) -> Op['k] {
        Op.{ name: text(&cx, name), rty, args, node: Option::None, discharged: false, ty: Option::None, tys: Seq::new(&cx),
            lit: Option::None, binders: Seq::new(&cx), pos: no_pos() }
    }

    fn named(&cx: Cx!['k], name: Text['k], rty: Type['k], args: Seq[Text['k], 'k]) -> Op['k] {
        let { name: _n, ..rest } = Op::new(&cx, "", rty, args);
        Op.{ name, ..rest }
    }

    fn typed(self, t: Type['k]) -> Op['k] {
        let { ty: _t, ..rest } = self;
        Op.{ ty: Option::Some.(t), ..rest }
    }

    fn with_tys(self, tys: Seq[Type['k], 'k]) -> Op['k] {
        let { tys: _t, ..rest } = self;
        Op.{ tys, ..rest }
    }

    fn literal(self, lit: Text['k]) -> Op['k] {
        let { lit: _l, ..rest } = self;
        Op.{ lit: Option::Some.(lit), ..rest }
    }

    fn maybe_literal(self, lit: Option[Text['k]]) -> Op['k] {
        let { lit: _l, ..rest } = self;
        Op.{ lit, ..rest }
    }

    fn from_node(self, id: u32, pos: Pos) -> Op['k] {
        let { node: _n, ..rest } = self;
        Op.{ node: Option::Some.((id, pos)), ..rest }
    }

    fn discharge(self, yes: bool) -> Op['k] {
        let { discharged: _d, ..rest } = self;
        Op.{ discharged: yes, ..rest }
    }

    fn opening(self, binders: Seq[Text['k], 'k]) -> Op['k] {
        let { binders: _b, ..rest } = self;
        Op.{ binders, ..rest }
    }

    fn located(self, pos: Pos) -> Op['k] {
        let { pos: _p, ..rest } = self;
        Op.{ pos, ..rest }
    }
}

// Translates one function, appending instructions to the current block. `cur` is none before the
// entry and after a terminator. `start` selects an open block; `terminate` closes it. Expression
// rules return a value name on paths that continue, including a constructed unit value for unit
// expressions; they return none when no path continues, leaving `cur` none.
forall 'k.
exposed struct FnLower {
    lowering: Lowering['k],
    sig: Sig['k],
    name: Text['k],
    home: ModuleId['k],
    node_pos: Pos,
    mode: Mode['k],
    kinds: Map[Text['k], Kind, 'k],
    // whether each type asked about is Copy
    copies: Map[Type['k], bool, 'k],
    blocks: Seq[BlockB['k], 'k],
    cur: Cell[Option[BlockB['k]], 'k],
    vty: Map[Text['k], Type['k], 'k],
    bindings: Map[Text['k], Binding['k], 'k],
    locals: Seq[C::Binding['k], 'k],
    open_brands: Cell[Seq[Text['k], 'k], 'k],
    brand_map: Cell[Map[Text['k], Type['k], 'k], 'k],
    unsafe_nodes: Set[u32, 'k],
    // inside an unsafe function's lifted closures every operation is discharged
    discharge_all: bool,
    lend_frames: Seq[Seq[Text['k], 'k], 'k],
    n: Cell[u64, 'k],
    at: Cell[Pos, 'k],
}

forall 'k.
impl FnLower['k] {
    fn new(&cx: Cx!['k], lowering: Lowering['k], sig: Sig['k], mode: Mode['k], name: Text['k], node_pos: Pos) -> FnLower['k] {
        let kinds: Map[Text['k], Kind, 'k] = Map::new(&cx);
        var i = 0usize;
        while i < sig.params.len(&cx) {
            kinds.set(&cx, sig.params.get(&cx, i).name, sig.params.get(&cx, i).kind);
            i = i + 1usize;
        }
        let home = match sig.home {
            Option::Some(m) => m,
            Option::None => lowering.r.fail(&cx, text(&cx, "internal error: a function without a module"), node_pos),
        };
        FnLower.{
            lowering, sig, name, home, node_pos, mode, kinds, copies: Map::new(&cx), blocks: Seq::new(&cx), cur: Cell::new(&cx, Option::None), vty: Map::new(&cx),
            bindings: Map::new(&cx), locals: Seq::new(&cx), open_brands: Cell::new(&cx, Seq::new(&cx)), brand_map: Cell::new(&cx, Map::new(&cx)),
            unsafe_nodes: Set::new(&cx), discharge_all: false, lend_frames: Seq::new(&cx), n: Cell::new(&cx, 0u64), at: Cell::new(&cx, no_pos()),
        }
    }

    // ---- machinery
    fn fail(self, &cx: Cx!['k], message: Text['k], pos: Pos) -> ! {
        self.lowering.r.fail(&cx, message, pos)
    }

    fn fails(self, &cx: Cx!['k], message: Slice[u8, 'static], pos: Pos) -> ! {
        self.lowering.r.fail(&cx, text(&cx, message), pos)
    }

    fn results(self) -> Results['k] {
        self.lowering.results
    }

    fn type_of(self, &cx: Cx!['k], id: u32) -> Type['k] {
        match self.lowering.results.types.get(&cx, id) {
            Option::Some(t) => t,
            Option::None => self.fails(&cx, "internal error: a node without a type", self.at.get(&cx)),
        }
    }

    fn binder(self, &cx: Cx!['k], id: u32) -> Text['k] {
        id_text(&cx, self.lowering.results.binders.at(&cx, id))
    }

    fn current(self, &cx: Cx!['k]) -> BlockB['k] {
        match self.cur.get(&cx) {
            Option::Some(b) => b,
            Option::None => self.fails(&cx, "internal error: no current block", self.at.get(&cx)),
        }
    }

    fn live(self, &cx: Cx!['k]) -> bool {
        self.cur.get(&cx).is_some()
    }

    fn fresh(self, &cx: Cx!['k], hint: Slice[u8, 'static]) -> Text['k] {
        self.n.set(&cx, self.n.get(&cx) + 1u64);
        Out::new(&cx).put(&cx, "%").put(&cx, hint).u64(&cx, self.n.get(&cx)).done(&cx)
    }

    fn lifted(self) -> bool {
        match self.mode {
            Mode::Plain(_f) => false,
            _ => true,
        }
    }

    // A lifted body's types may mention only the brands it may name: those of its function's
    // parameters, and those opened in it so far.
    fn substitute_type(self, &cx: Cx!['k], ty: Type['k]) -> Type['k] {
        let mapping = self.brand_map.get(&cx);
        let t = if mapping.is_empty(&cx) { ty } else { subst(&cx, ty, mapping, self.lowering.counter) };
        if self.lifted() {
            self.check_closed(&cx, t, self.open_brands.get(&cx));
        }
        t
    }

    fn substitute_all(self, &cx: Cx!['k], ts: Seq[Type['k], 'k]) -> Seq[Type['k], 'k] {
        let out: Seq[Type['k], 'k] = Seq::new(&cx);
        var i = 0usize;
        while i < ts.len(&cx) {
            out.push(&cx, self.substitute_type(&cx, ts.get(&cx, i)));
            i = i + 1usize;
        }
        out
    }

    fn copy(self, &cx: Cx!['k], ty: Type['k]) -> bool {
        match self.copies.get(&cx, ty) {
            Option::Some(answer) => answer,
            Option::None => {
                let answer = self.lowering.types.is_copy(&cx, ty, self.kinds);
                self.copies.set(&cx, ty, answer);
                answer
            },
        }
    }

    fn authorized(self, &cx: Cx!['k], id: u32) -> bool {
        self.sig.is_unsafe || self.discharge_all || self.unsafe_nodes.has(&cx, id)
    }

    fn emit(self, &cx: Cx!['k], o: Op['k]) -> Text['k] {
        let pos = if o.pos.line != 0u32 {
            o.pos
        } else {
            match o.node {
                Option::Some(node) => {
                    let (_id, p) = node;
                    p
                },
                Option::None => self.at.get(&cx),
            }
        };
        if o.name.is(&cx, "const") {
            match o.ty {
                Option::Some(t) => match t {
                    Type::Prim(prim) => match o.lit {
                        Option::Some(lit) => if !valid_literal(&cx, t, lit) {
                            self.fail(&cx, Out::new(&cx).put(&cx, "literal ").add(&cx, lit).put(&cx, " does not fit ").add(&cx, prim).done(&cx),
                                if pos.line != 0u32 { pos } else { self.at.get(&cx) });
                        },
                        Option::None => (),
                    },
                    _ => (),
                },
                Option::None => (),
            };
        }
        let name = self.fresh(&cx, "v");
        if o.name.is(&cx, "call") || o.name.is(&cx, "trait_call") {
            var f = 0usize;
            while f < self.lend_frames.len(&cx) {
                let frame = self.lend_frames.get(&cx, f);
                var k = 0usize;
                while k < o.args.len(&cx) {
                    if lends(&cx, o.args.get(&cx, k)) {
                        frame.push(&cx, o.args.get(&cx, k));
                    }
                    k = k + 1usize;
                }
                f = f + 1usize;
            }
        }
        let marked = match o.node {
            Option::Some(node) => {
                let (id, _p) = node;
                self.unsafe_nodes.has(&cx, id)
            },
            Option::None => false,
        };
        let discharged = o.discharged || self.discharge_all || marked;
        if (o.name.starts_with(&cx, text(&cx, "builtin::unsafe::")) || o.name.is(&cx, "alloca")) && !(discharged || self.sig.is_unsafe) {
            self.fail(&cx, Out::new(&cx).add(&cx, o.name).put(&cx, " requires unsafe authorization").done(&cx), pos);
        }
        self.current(&cx).instrs.push(&cx, Instr.{ lhs: Seq::one(&cx, name), op: o.name, args: o.args, ty: o.ty, tys: o.tys, lit: o.lit,
            is_unsafe: discharged, binders: o.binders, pos });
        self.vty.set(&cx, name, o.rty);
        name
    }

    fn unit(self, &cx: Cx!['k]) -> Text['k] {
        self.emit(&cx, Op::new(&cx, "construct", C::unit(&cx), Seq::new(&cx)).typed(C::unit(&cx)))
    }

    fn constant(self, &cx: Cx!['k], ty: Type['k], lit: Text['k]) -> Text['k] {
        self.emit(&cx, Op::new(&cx, "const", ty, Seq::new(&cx)).typed(ty).literal(lit))
    }

    fn destruct(self, &cx: Cx!['k], value: Text['k], ty: Type['k]) -> Seq[C::Binding['k], 'k] {
        let comps = self.lowering.types.fields(&cx, ty, Option::None);
        let names: Seq[Text['k], 'k] = Seq::new(&cx);
        let out: Seq[C::Binding['k], 'k] = Seq::new(&cx);
        var i = 0usize;
        while i < comps.len(&cx) {
            let n = self.fresh(&cx, "c");
            names.push(&cx, n);
            out.push(&cx, C::Binding.{ name: n, type: comps.get(&cx, i) });
            i = i + 1usize;
        }
        self.current(&cx).instrs.push(&cx, Instr.{ lhs: names, op: text(&cx, "destruct"), args: Seq::one(&cx, value), ty: Option::Some.(ty), tys: Seq::new(&cx),
            lit: Option::None, is_unsafe: false, binders: Seq::new(&cx), pos: self.at.get(&cx) });
        i = 0usize;
        while i < comps.len(&cx) {
            self.vty.set(&cx, names.get(&cx, i), comps.get(&cx, i));
            i = i + 1usize;
        }
        out
    }

    fn block_named(self, &cx: Cx!['k], label: Text['k], params: Seq[C::Binding['k], 'k]) -> BlockB['k] {
        let block = BlockB.{ label, params, instrs: Seq::new(&cx), term: Cell::new(&cx, Option::None), brands: self.open_brands.get(&cx).copy(&cx) };
        self.blocks.push(&cx, block);
        block
    }

    fn new_block(self, &cx: Cx!['k], params: Seq[C::Binding['k], 'k], hint: Slice[u8, 'static]) -> BlockB['k] {
        self.n.set(&cx, self.n.get(&cx) + 1u64);
        self.block_named(&cx, Out::new(&cx).put(&cx, hint).u64(&cx, self.n.get(&cx)).done(&cx), params)
    }

    fn start(self, &cx: Cx!['k], block: BlockB['k]) {
        self.cur.set(&cx, Option::Some.(block));
        var i = 0usize;
        while i < block.params.len(&cx) {
            self.vty.set(&cx, block.params.get(&cx, i).name, block.params.get(&cx, i).type);
            i = i + 1usize;
        }
        self.open_brands.set(&cx, block.brands.copy(&cx));
    }

    fn terminate(self, &cx: Cx!['k], term: Terminator['k]) {
        self.current(&cx).term.set(&cx, Option::Some.(term));
        self.cur.set(&cx, Option::None);
    }

    fn edge(self, &cx: Cx!['k], block: BlockB['k], extra: Seq[Text['k], 'k]) -> Edge['k] {
        let tys: Seq[Type['k], 'k] = Seq::new(&cx);
        var i = 0usize;
        while i < block.brands.len(&cx) {
            tys.push(&cx, Type::Skolem.(block.brands.get(&cx, i)));
            i = i + 1usize;
        }
        Edge.{ target: block.label, args: extra, tys }
    }

    fn jump(self, &cx: Cx!['k], block: BlockB['k], extra: Seq[Text['k], 'k]) {
        self.terminate(&cx, Terminator::Jmp.(self.edge(&cx, block, extra), self.at.get(&cx)));
    }

    fn local_ref(self, &cx: Cx!['k], p: S::Path['k]) -> bool {
        match self.lowering.r.refs.get(&cx, p.id) {
            Option::Some(r) => match r {
                NameRef::Local(_n) => true,
                _ => false,
            },
            Option::None => false,
        }
    }

    fn temporary(self, &cx: Cx!['k], ty: Type['k]) -> Text['k] {
        let root = Out::new(&cx).put(&cx, "&#tmp").usize(&cx, self.locals.len(&cx)).done(&cx);
        self.locals.push(&cx, C::Binding.{ name: root, type: ty });
        root
    }

    fn value(self, &cx: Cx!['k], item: Item['k]) -> Option[Text['k]] {
        match item {
            Item::Bind(b) => Option::Some.(self.read(&cx, b)),
            Item::Path(t) => Option::Some.(t),
            Item::Expr(e) => self.expr(&cx, e),
        }
    }

    // Evaluates strictly left to right. Items are expressions, bindings to read, or already resolved
    // place paths. A value preceding another operand waits in a temporary place, then is reloaded
    // in the final block. Calls (`call`) interpret explicit lends. A plain read of a place that the
    // same group lends is rejected, whatever its type: the program states the order with a binding
    // before the expression.
    fn operands(self, &cx: Cx!['k], items: Seq[Item['k], 'k], call: Option[S::Call['k]]) -> Option[Seq[Text['k], 'k]] {
        let reads: Seq[Text['k], 'k] = Seq::new(&cx);
        var i = 0usize;
        while i < items.len(&cx) {
            match items.get(&cx, i) {
                Item::Bind(b) => match b.path {
                    Option::Some(p) => reads.push(&cx, p),
                    Option::None => (),
                },
                Item::Expr(e) => {
                    let place = match e {
                        Expr::Path(_p) => true,
                        Expr::Field(_f) => true,
                        Expr::Index(_x) => true,
                        _ => false,
                    };
                    if place {
                        let path = self.place_path(&cx, e);
                        let unit = self.substitute_type(&cx, self.type_of(&cx, expr_id(e)));
                        match path {
                            Option::Some(p) => reads.push(&cx, p),
                            Option::None => (),
                        };
                    }
                },
                Item::Path(_t) => (),
            };
            i = i + 1usize;
        }
        let lent: Seq[Text['k], 'k] = Seq::new(&cx);
        self.lend_frames.push(&cx, lent);
        let values: Seq[Text['k], 'k] = Seq::new(&cx);
        let saved: Seq[(usize, Text['k], Text['k], Type['k]), 'k] = Seq::new(&cx);
        i = 0usize;
        while i < items.len(&cx) {
            let item = items.get(&cx, i);
            let v = match call {
                Option::Some(c) => self.operand(&cx, item, c),
                Option::None => self.value(&cx, item),
            };
            let v = match v {
                Option::Some(v) => v,
                Option::None => {
                    let unit = self.lend_frames.pop(&cx);
                    return Option::None;
                },
            };
            values.push(&cx, v);
            let raw = v.starts_with(&cx, text(&cx, "&*"));
            let name = if raw { v.from(2usize) } else { v };
            if !name.starts_with(&cx, text(&cx, "&")) && i + 1usize < items.len(&cx) {
                let ty = self.vty.at(&cx, name);
                let root = self.temporary(&cx, ty);
                let origin = match item {
                    Item::Expr(e) => expr_pos(e),
                    _ => self.at.get(&cx),
                };
                let unit = self.emit(&cx, Op::new(&cx, "store", C::unit(&cx), Seq::two(&cx, root, name)).located(origin));
                saved.push(&cx, (i, if raw { text(&cx, "&*") } else { text(&cx, "") }, root, ty));
            }
            i = i + 1usize;
        }
        i = 0usize;
        while i < saved.len(&cx) {
            let (k, raw, root, ty) = saved.get(&cx, i);
            values.set(&cx, k, Out::new(&cx).add(&cx, raw).add(&cx, self.emit(&cx, Op::new(&cx, "load", ty, Seq::one(&cx, root)))).done(&cx));
            i = i + 1usize;
        }
        i = 0usize;
        while i < values.len(&cx) {
            if lends(&cx, values.get(&cx, i)) {
                lent.push(&cx, values.get(&cx, i));
            }
            i = i + 1usize;
        }
        i = 0usize;
        while i < reads.len(&cx) {
            var k = 0usize;
            while k < lent.len(&cx) {
                if overlap(&cx, reads.get(&cx, i), lent.get(&cx, k)) {
                    self.fails(&cx, "a plain read overlaps a lend in the same operand group; bind the value before the expression", self.at.get(&cx));
                }
                k = k + 1usize;
            }
            i = i + 1usize;
        }
        let unit = self.lend_frames.pop(&cx);
        Option::Some.(values)
    }

    fn exprs(&cx: Cx!['k], es: Seq[Expr['k], 'k]) -> Seq[Item['k], 'k] {
        let out: Seq[Item['k], 'k] = Seq::new(&cx);
        var i = 0usize;
        while i < es.len(&cx) {
            out.push(&cx, Item::Expr.(es.get(&cx, i)));
            i = i + 1usize;
        }
        out
    }

    fn run_arm(self, &cx: Cx!['k], body: ArmBody['k]) -> Option[Text['k]] {
        match body {
            ArmBody::Value(e) => self.expr(&cx, e),
            ArmBody::Unit => Option::Some.(self.unit(&cx)),
            ArmBody::Constant(lit) => Option::Some.(self.constant(&cx, C::bool_type(&cx), lit)),
            ArmBody::Case(arm, block, place) => {
                let case = arm.cases.get(&cx, 0usize);
                let variant = match case.kind {
                    S::CaseKind::Variant => case.binders.is_some(),
                    _ => false,
                };
                let binds = arm.cases.len(&cx) == 1usize && variant;
                if binds {
                    let payload = match place {
                        Option::Some(p) => p,
                        Option::None => block.params.get(&cx, 0usize).name,
                    };
                    self.bind_payload(&cx, case, payload, place.is_some());
                }
                let saved = self.save_scope(&cx);
                let v = self.expr(&cx, arm.body);
                self.restore_scope(&cx, saved);
                v
            },
        }
    }

    // Runs each arm in its block; the arms that finish meet in a join block taking their results.
    fn arms(self, &cx: Cx!['k], blocks: Seq[BlockB['k], 'k], bodies: Seq[ArmBody['k], 'k], ty: Type['k]) -> Option[Text['k]] {
        let outer = self.open_brands.get(&cx).copy(&cx);
        let mapping = self.brand_map.get(&cx).copy(&cx);
        let ends: Seq[(BlockB['k], Text['k]), 'k] = Seq::new(&cx);
        var i = 0usize;
        while i < blocks.len(&cx) {
            self.start(&cx, blocks.get(&cx, i));
            let result = self.run_arm(&cx, bodies.get(&cx, i));
            match self.cur.get(&cx) {
                Option::Some(b) => match result {
                    Option::Some(v) => ends.push(&cx, (b, v)),
                    Option::None => self.fails(&cx, "internal error: an arm continues without a value", self.at.get(&cx)),
                },
                Option::None => (),
            };
            self.open_brands.set(&cx, outer.copy(&cx));
            self.brand_map.set(&cx, mapping.copy(&cx));
            i = i + 1usize;
        }
        if ends.is_empty(&cx) {
            self.cur.set(&cx, Option::None);
            return Option::None;
        }
        let r = self.fresh(&cx, "r");
        let join = self.new_block(&cx, Seq::one(&cx, C::Binding.{ name: r, type: self.substitute_type(&cx, ty) }), "join");
        i = 0usize;
        while i < ends.len(&cx) {
            let (block, result) = ends.get(&cx, i);
            self.cur.set(&cx, Option::Some.(block));
            self.jump(&cx, join, Seq::one(&cx, result));
            i = i + 1usize;
        }
        self.start(&cx, join);
        Option::Some.(r)
    }

    // The brands open and their renaming, to restore when a lexical scope ends.
    fn save_scope(self, &cx: Cx!['k]) -> (Seq[Text['k], 'k], Map[Text['k], Type['k], 'k]) {
        (self.open_brands.get(&cx).copy(&cx), self.brand_map.get(&cx).copy(&cx))
    }

    // The brands a scope opened go out of scope with it.
    fn restore_scope(self, &cx: Cx!['k], saved: (Seq[Text['k], 'k], Map[Text['k], Type['k], 'k])) {
        let (brands, mapping) = saved;
        self.brand_map.set(&cx, mapping);
        if self.live(&cx) {
            self.open_brands.set(&cx, brands);
        }
    }

    // ---- bindings
    // Binds a variable: a new root of the function, holding `value`.
    fn declare(self, &cx: Cx!['k], bid: Text['k], name: Text['k], ty: Type['k], value: Text['k]) {
        let ty = self.substitute_type(&cx, ty);
        let root = Out::new(&cx).put(&cx, "&").add(&cx, name).put(&cx, "#").add(&cx, bid).done(&cx);
        self.locals.push(&cx, C::Binding.{ name: root, type: ty });
        self.bindings.set(&cx, bid, Binding.{ name, type: ty, path: Option::Some.(root), fields: Option::None });
        let unit = self.emit(&cx, Op::new(&cx, "store", C::unit(&cx), Seq::two(&cx, root, value)));
    }

    fn read(self, &cx: Cx!['k], binding: Binding['k]) -> Text['k] {
        match binding.path {
            Option::Some(path) => self.emit(&cx, Op::new(&cx, "load", binding.type, Seq::one(&cx, path))),
            Option::None => self.fail(&cx, Out::new(&cx).add(&cx, binding.name).put(&cx, " is a ..rest bundle, not a value").done(&cx), self.at.get(&cx)),
        }
    }

    fn local(self, &cx: Cx!['k], id: u32) -> Binding['k] {
        self.bindings.at(&cx, self.binder(&cx, id))
    }

    // The place path `e` names, or none if it is not rooted at a place.
    fn place_path(self, &cx: Cx!['k], e: Expr['k]) -> Option[Text['k]] {
        match e {
            Expr::Path(p) => if self.local_ref(&cx, p) { self.local(&cx, p.id).path } else { Option::None },
            Expr::Field(f) => match self.place_path(&cx, f.value.get(&cx)) {
                Option::Some(base) => Option::Some.(Out::new(&cx).add(&cx, base).put(&cx, ".").add(&cx, f.name).done(&cx)),
                Option::None => Option::None,
            },
            Expr::Index(x) => match self.place_path(&cx, x.value.get(&cx)) {
                Option::Some(base) => Option::Some.(Out::new(&cx).add(&cx, base).put(&cx, ".").usize(&cx, x.index).done(&cx)),
                Option::None => Option::None,
            },
            _ => Option::None,
        }
    }

    // ---- the function
    fn start_entry(self, &cx: Cx!['k], params: Seq[C::Binding['k], 'k]) {
        self.n.set(&cx, self.n.get(&cx) + 1u64);
        self.start(&cx, self.block_named(&cx, text(&cx, "entry"), params));
    }

    // Lent parameters are roots already; value parameters start in local places. An offset skips
    // raw parameters such as a closure environment. Explicit sources keep the SSA names generated
    // functions use.
    fn parameters(self, &cx: Cx!['k], ids: Seq[u32, 'k], offset: usize, sources: Seq[Text['k], 'k]) {
        let sig = self.sig;
        var k = offset;
        while k < sig.pnames.len(&cx) && k < sig.ptypes.len(&cx) && k - offset < ids.len(&cx) {
            let name = sig.pnames.get(&cx, k);
            let ty = sig.ptypes.get(&cx, k);
            let bid = id_text(&cx, ids.get(&cx, k - offset));
            let place = sig.places.has(&cx, k);
            let source = if !sources.is_empty(&cx) {
                sources.get(&cx, k - offset)
            } else {
                Out::new(&cx).put(&cx, if place { "&" } else { "%a_" }).add(&cx, name).done(&cx)
            };
            self.current(&cx).params.push(&cx, C::Binding.{ name: source, type: ty });
            if place {
                self.bindings.set(&cx, bid, Binding.{ name, type: ty, path: Option::Some.(source), fields: Option::None });
            } else {
                self.vty.set(&cx, source, ty);
                self.declare(&cx, bid, name, ty, source);
            }
            k = k + 1usize;
        }
    }

    fn run(self, &cx: Cx!['k]) -> Fun['k] {
        match self.mode {
            Mode::Plain(node) => {
                self.start_entry(&cx, Seq::new(&cx));
                self.parameters(&cx, self.results().param_ids.get_or(&cx, node.id, Seq::new(&cx)), 0usize, Seq::new(&cx));
                match node.body {
                    Option::Some(body) => self.finish_body(&cx, Expr::Block.(body)),
                    Option::None => self.fails(&cx, "internal error: a function without a body", node.pos),
                }
            },
            Mode::Closure(e, env_ty) => {
                self.start_entry(&cx, Seq::one(&cx, C::Binding.{ name: text(&cx, "%env"), type: env_ty }));
                self.parameters(&cx, self.results().param_ids.get_or(&cx, e.id, Seq::new(&cx)), 1usize, Seq::new(&cx));
                let captures = self.results().captures.get_or(&cx, e.id, Seq::new(&cx));
                let parts = self.destruct(&cx, text(&cx, "%env"), env_ty);
                var i = 0usize;
                while i < captures.len(&cx) && i < parts.len(&cx) {
                    let capture = captures.get(&cx, i);
                    self.declare(&cx, id_text(&cx, capture.binder), capture.name, parts.get(&cx, i).type, parts.get(&cx, i).name);
                    i = i + 1usize;
                }
                self.finish_body(&cx, e.body.get(&cx))
            },
            Mode::Mapper(e) => {
                self.start_entry(&cx, Seq::new(&cx));
                let captures = self.results().captures.get_or(&cx, e.id, Seq::new(&cx));
                let ids = Seq::one(&cx, self.results().binders.at(&cx, e.id));
                let sources = Seq::one(&cx, text(&cx, "%item"));
                var i = 0usize;
                while i < captures.len(&cx) {
                    ids.push(&cx, captures.get(&cx, i).binder);
                    sources.push(&cx, Out::new(&cx).put(&cx, "%a_").add(&cx, captures.get(&cx, i).name).done(&cx));
                    i = i + 1usize;
                }
                self.parameters(&cx, ids, 0usize, sources);
                self.finish_body(&cx, Expr::Block.(e.body))
            },
        }
    }

    fn finish_body(self, &cx: Cx!['k], body: Expr['k]) -> Fun['k] {
        let value = self.expr(&cx, body);
        if self.live(&cx) {
            let result_pos = match body {
                Expr::Block(b) => match b.tail {
                    Option::Some(t) => expr_pos(t.get(&cx)),
                    Option::None => b.pos,
                },
                _ => expr_pos(body),
            };
            match value {
                Option::Some(v) => self.terminate(&cx, Terminator::Ret.(v, result_pos)),
                Option::None => self.fails(&cx, "internal error: a body continues without a value", result_pos),
            };
        }
        self.finish(&cx)
    }

    fn finish(self, &cx: Cx!['k]) -> Fun['k] {
        let sig = self.sig;
        let blocks: Seq[Block['k], 'k] = Seq::new(&cx);
        var i = 0usize;
        while i < self.blocks.len(&cx) {
            let b = self.blocks.get(&cx, i);
            let term = match b.term.get(&cx) {
                Option::Some(t) => t,
                Option::None => self.fails(&cx, "internal error: an unterminated block", self.node_pos),
            };
            blocks.push(&cx, Block.{ label: b.label, params: b.params, instrs: b.instrs, term, brands: b.brands, empty: Seq::new(&cx),
                known: Seq::new(&cx), opened: Seq::new(&cx), pos: no_pos() });
            i = i + 1usize;
        }
        let fun = Fun.{ name: self.name, params: sig.params, premises: sig.premises, ret: sig.ret, ptypes: sig.ptypes, blocks,
            locals: self.locals, is_unsafe: sig.is_unsafe, home: Option::Some.(self.home), pos: self.node_pos };
        let brands: Set[Text['k], 'k] = Set::new(&cx);
        i = 0usize;
        while i < sig.params.len(&cx) {
            if C::same_kind(sig.params.get(&cx, i).kind, Kind::Brand) {
                brands.add(&cx, sig.params.get(&cx, i).name);
            }
            i = i + 1usize;
        }
        var branded = false;
        i = 0usize;
        while !branded && i < self.locals.len(&cx) {
            let free = free_brands(&cx, self.locals.get(&cx, i).type).items(&cx);
            var k = 0usize;
            while k < free.len(&cx) {
                branded = branded || !brands.has(&cx, free.get(&cx, k));
                k = k + 1usize;
            }
            i = i + 1usize;
        }
        if branded {
            self.lowering.value_types.set(&cx, fun_key(fun), self.vty.copy(&cx));
        }
        fun
    }

    // The enclosing function's own parameters, as the type arguments that instantiate a lifted
    // function.
    fn identity_args(self, &cx: Cx!['k]) -> Seq[Type['k], 'k] {
        let out: Seq[Type['k], 'k] = Seq::new(&cx);
        var i = 0usize;
        while i < self.sig.params.len(&cx) {
            let p = self.sig.params.get(&cx, i);
            out.push(&cx, if C::same_kind(p.kind, Kind::Brand) { Type::Skolem.(p.name) } else { Type::Named.(p.name, Seq::new(&cx)) });
            i = i + 1usize;
        }
        out
    }

    // A lifted type may mention function parameters and brands opened inside that body.
    fn check_closed(self, &cx: Cx!['k], ty: Type['k], local_brands: Seq[Text['k], 'k]) {
        if !mentions_brand(&cx, ty) {
            return;
        }
        let brands = free_brands(&cx, ty).items(&cx);
        var least: Option[Text['k]] = Option::None;
        var i = 0usize;
        while i < brands.len(&cx) {
            let b = brands.get(&cx, i);
            let parameter = match self.kinds.get(&cx, b) {
                Option::Some(k) => C::same_kind(k, Kind::Brand),
                Option::None => false,
            };
            let allowed = b.is(&cx, "static") || local_brands.has(&cx, b) || parameter;
            if !allowed {
                least = match least {
                    Option::Some(l) => if b.compare(&cx, l) < 0 { Option::Some.(b) } else { Option::Some.(l) },
                    Option::None => Option::Some.(b),
                };
            }
            i = i + 1usize;
        }
        match least {
            Option::Some(b) => self.fail(&cx, Out::new(&cx).put(&cx, "a closure or foreach body cannot mention the block-local brand ").add(&cx, b).done(&cx), self.at.get(&cx)),
            Option::None => (),
        };
    }

    // ---- expressions
    // The expression's value in the current block, or none if control cannot continue.
    fn expr(self, &cx: Cx!['k], e: Expr['k]) -> Option[Text['k]] {
        if !self.live(&cx) {
            return Option::None;
        }
        let previous = self.at.get(&cx);
        self.at.set(&cx, expr_pos(e));
        let v = self.lower_expr(&cx, e);
        self.at.set(&cx, previous);
        v
    }

    fn lower_expr(self, &cx: Cx!['k], e: Expr['k]) -> Option[Text['k]] {
        match e {
            Expr::Lit(l) => Option::Some.(self.expr_lit(&cx, l)),
            Expr::FStr(f) => self.expr_fstring(&cx, f),
            Expr::Path(p) => self.expr_path(&cx, p),
            Expr::Tuple(n) => self.expr_tuple(&cx, n.id, n.value),
            Expr::Array(a) => self.expr_tuple(&cx, a.id, a.elems),
            Expr::Sizeof(n) => Option::Some.(self.emit(&cx, Op::new(&cx, "builtin::sizeof", C::usize_type(&cx), Seq::new(&cx))
                .typed(self.substitute_type(&cx, self.results().targets.at(&cx, n.id))))),
            Expr::StructLit(s) => self.expr_struct_lit(&cx, s),
            Expr::Block(b) => self.expr_block(&cx, b),
            Expr::If(x) => self.expr_if(&cx, x),
            Expr::Match(m) => self.expr_match(&cx, m),
            Expr::Closure(c) => self.expr_closure(&cx, c),
            Expr::Return(n) => self.expr_return(&cx, n.value),
            Expr::Pack(p) => self.expr_pack(&cx, p),
            Expr::Foreach(f) => self.expr_foreach(&cx, f),
            Expr::Binop(b) => self.expr_binop(&cx, b),
            Expr::Unary(u) => self.expr_unary(&cx, u),
            Expr::Cast(c) => self.expr_cast(&cx, c),
            Expr::UnsafeStore(s) => match self.operands(&cx, Seq::two(&cx, Item::Expr.(s.pointer.get(&cx)), Item::Expr.(s.value.get(&cx))), Option::None) {
                Option::Some(vals) => Option::Some.(self.emit(&cx, Op::new(&cx, "builtin::unsafe::store", C::unit(&cx), vals).from_node(s.id, s.pos))),
                Option::None => Option::None,
            },
            Expr::Field(f) => self.expr_field(&cx, e, f.id),
            Expr::Index(x) => self.expr_field(&cx, e, x.id),
            Expr::Call(c) => self.expr_call(&cx, c),
            Expr::Try(n) => self.expr_try(&cx, n.id, n.value.get(&cx)),
            Expr::While(w) => self.expr_while(&cx, w),
            Expr::For(f) => self.expr_for(&cx, f),
        }
    }

    fn expr_lit(self, &cx: Cx!['k], l: S::Lit['k]) -> Text['k] {
        let ty = self.substitute_type(&cx, self.type_of(&cx, l.id));
        match l.kind {
            S::LitKind::Str => self.string(&cx, l.text),
            S::LitKind::Bool => self.constant(&cx, ty, text(&cx, if l.int != 0u64 { "true" } else { "false" })),
            S::LitKind::Float => self.constant(&cx, ty, l.text),
            S::LitKind::Int => self.constant(&cx, ty, Out::new(&cx).u64(&cx, l.int).done(&cx)),
        }
    }

    // A string literal: a `Slice[u8, 'static]` over static bytes.
    fn string(self, &cx: Cx!['k], bytes: Text['k]) -> Text['k] {
        let (data, n) = self.lowering.data(&cx, bytes);
        let u8_type = C::prim(&cx, "u8");
        let fixed = Type::Skolem.(text(&cx, "static"));
        let d = self.emit(&cx, Op::new(&cx, "data", C::ptr(&cx, Type::Array.(Cell::new(&cx, u8_type), n as u64)), Seq::one(&cx, data)));
        let p = self.emit(&cx, Op::new(&cx, "builtin::unsafe::cast", C::ptr(&cx, u8_type), Seq::one(&cx, d)).typed(C::ptr(&cx, u8_type)).discharge(true));
        let brand = self.emit(&cx, Op::new(&cx, "builtin::unsafe::static_brand", Type::Brand.(Cell::new(&cx, fixed)), Seq::new(&cx)).discharge(true));
        let length = self.constant(&cx, C::usize_type(&cx), Out::new(&cx).usize(&cx, n).done(&cx));
        let sig = self.lowering.library_sig(&cx, "Slice::from_raw_parts", self.home);
        let slice_ty = Type::Named.(self.lowering.library_name(&cx, "Slice", self.home), Seq::two(&cx, u8_type, fixed));
        let args = Seq::one(&cx, sig.name);
        args.push(&cx, p);
        args.push(&cx, length);
        args.push(&cx, brand);
        self.emit(&cx, Op::new(&cx, "call", slice_ty, args).with_tys(Seq::two(&cx, u8_type, fixed)).discharge(true))
    }

    fn expr_tuple(self, &cx: Cx!['k], id: u32, elems: Seq[Expr['k], 'k]) -> Option[Text['k]] {
        let vals = match self.operands(&cx, FnLower::exprs(&cx, elems), Option::None) {
            Option::Some(v) => v,
            Option::None => return Option::None,
        };
        let ty = self.substitute_type(&cx, self.type_of(&cx, id));
        Option::Some.(self.emit(&cx, Op::new(&cx, "construct", ty, vals).typed(ty)))
    }

    fn expr_block(self, &cx: Cx!['k], b: S::Block['k]) -> Option[Text['k]] {
        let saved = self.save_scope(&cx);
        var i = 0usize;
        while self.live(&cx) && i < b.stmts.len(&cx) {
            self.stmt(&cx, b.stmts.get(&cx, i));
            i = i + 1usize;
        }
        let v = if !self.live(&cx) {
            Option::None
        } else {
            match b.tail {
                Option::Some(t) => self.expr(&cx, t.get(&cx)),
                Option::None => Option::Some.(self.unit(&cx)),
            }
        };
        self.restore_scope(&cx, saved);
        v
    }

    fn expr_path(self, &cx: Cx!['k], p: S::Path['k]) -> Option[Text['k]] {
        if self.local_ref(&cx, p) {
            return Option::Some.(self.read(&cx, self.local(&cx, p.id)));
        }
        match self.results().folded.get(&cx, p.id) {
            Option::Some(value) => return Option::Some.(self.constant_value(&cx, value)),
            Option::None => (),
        };
        match self.results().calls.get(&cx, p.id) {
            Option::Some(call) => match call {
                Callee::Fn(f) => {
                    let ty = self.substitute_type(&cx, self.type_of(&cx, p.id));
                    return Option::Some.(self.emit(&cx, Op::new(&cx, "fn", ty, Seq::one(&cx, f.call_name())).with_tys(self.substitute_all(&cx, f.targs(&cx)))));
                },
                Callee::Variant(name) => return self.variant(&cx, name, self.type_of(&cx, p.id), Option::None),
                _ => (),
            },
            Option::None => (),
        };
        let names = p.names(&cx);
        let joined = Out::new(&cx);
        var i = 0usize;
        while i < names.len(&cx) {
            if i > 0usize {
                let unit = joined.put(&cx, "::");
            }
            let unit = joined.add(&cx, names.get(&cx, i));
            i = i + 1usize;
        }
        self.fail(&cx, Out::new(&cx).put(&cx, "cannot lower the path ").add(&cx, joined.done(&cx)).done(&cx), p.pos)
    }

    fn constant_value(self, &cx: Cx!['k], value: ConstValue['k]) -> Text['k] {
        match value {
            ConstValue::Str(t, _ty) => self.string(&cx, t),
            ConstValue::Int(v, ty) => match ty {
                Type::Prim(name) => self.constant(&cx, ty, int_text(&cx, v, name)),
                _ => self.constant(&cx, ty, Out::new(&cx).u64(&cx, v).done(&cx)),
            },
            ConstValue::Bool(b) => self.constant(&cx, C::bool_type(&cx), text(&cx, if b { "true" } else { "false" })),
            ConstValue::Float(digits, ty) => self.constant(&cx, ty, digits),
        }
    }

    fn expr_binop(self, &cx: Cx!['k], b: S::Binop['k]) -> Option[Text['k]] {
        if b.op.is(&cx, "&&") || b.op.is(&cx, "||") {
            let c = match self.expr(&cx, b.left.get(&cx)) {
                Option::Some(c) => c,
                Option::None => return Option::None,
            };
            let right = ArmBody::Value.(b.right.get(&cx));
            if b.op.is(&cx, "&&") {
                return self.branch(&cx, c, right, ArmBody::Constant.(text(&cx, "false")), C::bool_type(&cx));
            }
            return self.branch(&cx, c, ArmBody::Constant.(text(&cx, "true")), right, C::bool_type(&cx));
        }
        match self.operands(&cx, Seq::two(&cx, Item::Expr.(b.left.get(&cx)), Item::Expr.(b.right.get(&cx))), Option::None) {
            Option::Some(vals) => Option::Some.(self.emit(&cx, Op::new(&cx, binop_name(&cx, b.op), self.substitute_type(&cx, self.type_of(&cx, b.id)), vals))),
            Option::None => Option::None,
        }
    }

    fn expr_unary(self, &cx: Cx!['k], u: S::Unary['k]) -> Option[Text['k]] {
        let op = u.op;
        if op.is(&cx, "unsafe") {
            var node = u.operand.get(&cx);
            var going = true;
            while going {
                node = match node {
                    Expr::Try(t) => t.value.get(&cx),
                    Expr::Unary(inner) => if inner.op.is(&cx, "&") {
                        inner.operand.get(&cx)
                    } else {
                        going = false;
                        node
                    },
                    _ => {
                        going = false;
                        node
                    },
                };
            }
            self.unsafe_nodes.add(&cx, expr_id(node));
            return self.expr(&cx, u.operand.get(&cx));
        }
        if op.is(&cx, "&") {
            return self.expr(&cx, u.operand.get(&cx));
        }
        if op.is(&cx, "*") {
            return match self.expr(&cx, u.operand.get(&cx)) {
                Option::Some(p) => Option::Some.(self.emit(&cx, Op::new(&cx, "builtin::unsafe::deref", self.substitute_type(&cx, self.type_of(&cx, u.id)), Seq::one(&cx, p))
                    .from_node(u.id, u.pos))),
                Option::None => Option::None,
            };
        }
        let ty = self.substitute_type(&cx, self.type_of(&cx, u.id));
        if op.is(&cx, "-") {
            match u.operand.get(&cx) {
                Expr::Lit(l) => match l.kind {
                    S::LitKind::Int => return Option::Some.(self.constant(&cx, ty, Out::new(&cx).put(&cx, "-").u64(&cx, l.int).done(&cx))),
                    S::LitKind::Float => return Option::Some.(self.constant(&cx, ty, Out::new(&cx).put(&cx, "-").add(&cx, l.text).done(&cx))),
                    _ => (),
                },
                _ => (),
            };
        }
        let v = match self.expr(&cx, u.operand.get(&cx)) {
            Option::Some(v) => v,
            Option::None => return Option::None,
        };
        let prim = match self.lowering.types.shape(&cx, ty, Option::None) {
            Type::Prim(name) => name,
            _ => self.fails(&cx, "internal error: a unary operator on a non-primitive", u.pos),
        };
        if op.is(&cx, "-") {
            if C::is_float(&cx, prim) {
                let minus = self.constant(&cx, ty, text(&cx, "-1.0"));
                return Option::Some.(self.emit(&cx, Op::new(&cx, "mul", ty, Seq::two(&cx, v, minus))));
            }
            let zero = self.constant(&cx, ty, text(&cx, "0"));
            return Option::Some.(self.emit(&cx, Op::new(&cx, "sub", ty, Seq::two(&cx, zero, v))));
        }
        if prim.is(&cx, "bool") {
            let f = self.constant(&cx, ty, text(&cx, "false"));
            return Option::Some.(self.emit(&cx, Op::new(&cx, "eq", ty, Seq::two(&cx, v, f))));
        }
        let bits = C::integer_bits(&cx, prim);
        let ones = if prim.starts_with(&cx, text(&cx, "i")) {
            text(&cx, "-1")
        } else if bits == 64u32 {
            Out::new(&cx).u64(&cx, 18446744073709551615u64).done(&cx)
        } else {
            Out::new(&cx).u64(&cx, (1u64 << (bits as u64)) - 1u64).done(&cx)
        };
        let mask = self.constant(&cx, ty, ones);
        Option::Some.(self.emit(&cx, Op::new(&cx, "bit_xor", ty, Seq::two(&cx, v, mask))))
    }

    fn expr_cast(self, &cx: Cx!['k], c: S::Cast['k]) -> Option[Text['k]] {
        let v = match self.expr(&cx, c.value.get(&cx)) {
            Option::Some(v) => v,
            Option::None => return Option::None,
        };
        let src = self.vty.at(&cx, v);
        let dst = self.substitute_type(&cx, self.type_of(&cx, c.id));
        let integers = match src {
            Type::Prim(a) => match dst {
                Type::Prim(b) => C::is_integer(&cx, a) && C::is_integer(&cx, b),
                _ => false,
            },
            _ => false,
        };
        if integers {
            return Option::Some.(self.emit(&cx, Op::new(&cx, "builtin::int_cast", dst, Seq::one(&cx, v)).typed(dst)));
        }
        // Casts do not inspect nominal layout or unfold abstract type parameters. Those
        // representation obligations belong to the unsafe C boundary.
        let package = match src {
            Type::Exists(_b, _t) => true,
            _ => match dst {
                Type::Exists(_b, _t) => true,
                _ => false,
            },
        };
        if package {
            self.fails(&cx, "a cast cannot consume or produce an outer existential package; use opening or packing", c.pos);
        }
        Option::Some.(self.emit(&cx, Op::new(&cx, "builtin::unsafe::cast", dst, Seq::one(&cx, v)).typed(dst).from_node(c.id, c.pos)))
    }

    fn expr_field(self, &cx: Cx!['k], e: Expr['k], id: u32) -> Option[Text['k]] {
        match self.place_path(&cx, e) {
            Option::Some(path) => Option::Some.(self.emit(&cx, Op::new(&cx, "load", self.substitute_type(&cx, self.type_of(&cx, id)), Seq::one(&cx, path)))),
            Option::None => self.project(&cx, e),
        }
    }

    // Reads a field of a value that is not a place: takes the value apart, once per step.
    fn project(self, &cx: Cx!['k], e: Expr['k]) -> Option[Text['k]] {
        let steps: Seq[(Option[Text['k]], usize), 'k] = Seq::new(&cx);
        var base = e;
        var going = true;
        while going {
            base = match base {
                Expr::Field(f) => {
                    steps.push(&cx, (Option::Some.(f.name), 0usize));
                    f.value.get(&cx)
                },
                Expr::Index(x) => {
                    steps.push(&cx, (Option::None, x.index));
                    x.value.get(&cx)
                },
                _ => {
                    going = false;
                    base
                },
            };
        }
        var v = match self.expr(&cx, base) {
            Option::Some(v) => v,
            Option::None => return Option::None,
        };
        var ty = self.vty.at(&cx, v);
        var i = steps.len(&cx);
        while i > 0usize {
            i = i - 1usize;
            let (name, index) = steps.get(&cx, i);
            let selected = match name {
                Option::Some(field) => self.field_index(&cx, ty, field),
                Option::None => index,
            };
            let parts = self.destruct(&cx, v, ty);
            var k = 0usize;
            while k < parts.len(&cx) {
                if k != selected && !self.copy(&cx, parts.get(&cx, k).type) {
                    self.fails(&cx, "a projection cannot discard a linear sibling; destructure the value explicitly", expr_pos(e));
                }
                k = k + 1usize;
            }
            v = parts.get(&cx, selected).name;
            ty = parts.get(&cx, selected).type;
        }
        Option::Some.(v)
    }

    fn field_index(self, &cx: Cx!['k], ty: Type['k], field: Text['k]) -> usize {
        match self.lowering.types.shape(&cx, ty, Option::None) {
            Type::Struct(fields) => {
                var i = 0usize;
                while i < fields.len(&cx) {
                    if fields.get(&cx, i).name.eq(&cx, field) {
                        return i;
                    }
                    i = i + 1usize;
                }
                self.fails(&cx, "internal error: no such field", self.at.get(&cx))
            },
            _ => self.fails(&cx, "internal error: a field of a non-struct", self.at.get(&cx)),
        }
    }

    // ---- constructors
    fn expr_struct_lit(self, &cx: Cx!['k], s: S::StructLit['k]) -> Option[Text['k]] {
        let ty = self.substitute_type(&cx, self.type_of(&cx, s.id));
        let shape = match self.lowering.types.shape(&cx, ty, Option::None) {
            Type::Struct(fields) => fields,
            _ => self.fails(&cx, "internal error: a struct literal of a non-struct", s.pos),
        };
        let names: Seq[Text['k], 'k] = Seq::new(&cx);
        let items: Seq[Item['k], 'k] = Seq::new(&cx);
        var i = 0usize;
        while i < s.fields.len(&cx) {
            let f = s.fields.get(&cx, i);
            names.push(&cx, f.name);
            items.push(&cx, match f.value {
                Option::Some(v) => Item::Expr.(v),
                Option::None => Item::Bind.(self.bindings.at(&cx, id_text(&cx, self.results().field_ids.at(&cx, s.id).at(&cx, f.name)))),
            });
            i = i + 1usize;
        }
        if s.spread.is_some() {
            let rest = self.bindings.at(&cx, id_text(&cx, self.results().spread_ids.at(&cx, s.id)));
            let fields = match rest.fields {
                Option::Some(f) => f,
                Option::None => self.fails(&cx, "internal error: a spread of a non-bundle", s.pos),
            };
            i = 0usize;
            while i < shape.len(&cx) {
                let name = shape.get(&cx, i).name;
                if !names.has(&cx, name) {
                    names.push(&cx, name);
                    items.push(&cx, Item::Bind.(self.bindings.at(&cx, fields.at(&cx, name))));
                }
                i = i + 1usize;
            }
        }
        let results = match self.operands(&cx, items, Option::None) {
            Option::Some(r) => r,
            Option::None => return Option::None,
        };
        let values: Map[Text['k], Text['k], 'k] = Map::new(&cx);
        i = 0usize;
        while i < names.len(&cx) {
            values.set(&cx, names.get(&cx, i), results.get(&cx, i));
            i = i + 1usize;
        }
        let ordered: Seq[Text['k], 'k] = Seq::new(&cx);
        i = 0usize;
        while i < shape.len(&cx) {
            ordered.push(&cx, values.at(&cx, shape.get(&cx, i).name));
            i = i + 1usize;
        }
        Option::Some.(self.emit(&cx, Op::new(&cx, "construct", ty, ordered).typed(ty)))
    }

    fn variant(self, &cx: Cx!['k], name: Text['k], ty: Type['k], args: Option[Seq[Expr['k], 'k]]) -> Option[Text['k]] {
        let enum_ty = self.substitute_type(&cx, ty);
        let variants = match self.lowering.types.shape(&cx, enum_ty, Option::None) {
            Type::Enum(vs) => vs,
            _ => self.fails(&cx, "internal error: a variant of a non-enum", self.at.get(&cx)),
        };
        var payload_ty = C::unit(&cx);
        var i = 0usize;
        while i < variants.len(&cx) {
            if variants.get(&cx, i).name.eq(&cx, name) {
                payload_ty = variants.get(&cx, i).type;
            }
            i = i + 1usize;
        }
        let given = match args {
            Option::Some(a) => a,
            Option::None => Seq::new(&cx),
        };
        let payload = if given.is_empty(&cx) {
            if !is_unit(&cx, payload_ty) {
                self.fail(&cx, Out::new(&cx).put(&cx, "variant ").add(&cx, name).put(&cx, " used as a function value").done(&cx), self.at.get(&cx));
            }
            Option::Some.(self.emit(&cx, Op::new(&cx, "construct", C::unit(&cx), Seq::new(&cx)).typed(C::unit(&cx))))
        } else if given.len(&cx) == 1usize {
            self.expr(&cx, given.get(&cx, 0usize))
        } else {
            match self.operands(&cx, FnLower::exprs(&cx, given), Option::None) {
                Option::Some(vals) => Option::Some.(self.emit(&cx, Op::new(&cx, "construct", payload_ty, vals).typed(payload_ty))),
                Option::None => Option::None,
            }
        };
        match payload {
            Option::Some(p) => Option::Some.(self.emit(&cx, Op::new(&cx, "construct_variant", enum_ty, Seq::one(&cx, p)).typed(enum_ty).literal(name))),
            Option::None => Option::None,
        }
    }

    // ---- calls
    fn expr_call(self, &cx: Cx!['k], c: S::Call['k]) -> Option[Text['k]] {
        let call = match self.results().calls.get(&cx, c.id) {
            Option::Some(call) => call,
            Option::None => self.fails(&cx, "internal error: an unresolved call", c.pos),
        };
        let items: Seq[Item['k], 'k] = Seq::new(&cx);
        let receiver = match call {
            Callee::Variant(name) => return self.variant(&cx, name, self.type_of(&cx, c.id), Option::Some.(c.args)),
            Callee::Tuple => {
                let vals = self.operands(&cx, FnLower::exprs(&cx, c.args), Option::None);
                let ty = self.substitute_type(&cx, self.type_of(&cx, c.id));
                return match vals {
                    Option::Some(v) => Option::Some.(self.emit(&cx, Op::new(&cx, "construct", ty, v).typed(ty))),
                    Option::None => Option::None,
                };
            },
            Callee::Alloca(target) => {
                let rty = self.substitute_type(&cx, self.type_of(&cx, c.id));
                return Option::Some.(self.emit(&cx, Op::new(&cx, "alloca", rty, Seq::new(&cx)).typed(self.substitute_type(&cx, target)).from_node(c.id, c.pos)));
            },
            Callee::Builtin(name) => return self.builtin(&cx, c, name),
            Callee::Pointer(name, recv) => return self.pointer_method(&cx, c, name, recv),
            Callee::FStringWrite(f) => return match self.expr(&cx, c.args.get(&cx, 0usize)) {
                Option::Some(out) => self.fstring(&cx, f, out),
                Option::None => Option::None,
            },
            Callee::Value(_sub) => {
                items.push(&cx, Item::Expr.(c.callee.get(&cx)));
                Option::None
            },
            Callee::Closure => {
                items.push(&cx, Item::Expr.(c.callee.get(&cx)));
                Option::None
            },
            Callee::Fn(f) => f.receiver,
            Callee::Trait(t) => t.receiver,
        };
        match receiver {
            Option::Some(r) => if r.lend {
                match self.place_path(&cx, r.value) {
                    Option::Some(path) => items.push(&cx, Item::Path.(path)),
                    Option::None => self.fails(&cx, "a lent receiver is not a place", c.pos),
                };
            } else {
                items.push(&cx, Item::Expr.(r.value));
            },
            Option::None => (),
        };
        items.append(&cx, FnLower::exprs(&cx, c.args));
        let operands = match self.operands(&cx, items, Option::Some.(c)) {
            Option::Some(o) => o,
            Option::None => return Option::None,
        };
        let by_value = match call {
            Callee::Value(_sub) => true,
            Callee::Closure => true,
            _ => false,
        };
        var callee_value = text(&cx, "");
        if by_value {
            callee_value = operands.remove(&cx, 0usize);
        }
        match call {
            Callee::Closure => {
                // a closure is {env, code}: the code takes the environment first
                let parts = self.destruct(&cx, callee_value, self.vty.at(&cx, callee_value));
                callee_value = parts.get(&cx, 1usize).name;
                operands.insert(&cx, 0usize, parts.get(&cx, 0usize).name);
            },
            _ => (),
        };
        let rty = self.substitute_type(&cx, self.type_of(&cx, c.id));
        let (target, targs, requires_unsafe) = match call {
            Callee::Trait(t) => {
                var needs = false;
                let methods = self.lowering.sigs.traits.at(&cx, t.trait_name).methods;
                var i = 0usize;
                while i < methods.len(&cx) {
                    if methods.get(&cx, i).name.eq(&cx, t.method) {
                        needs = methods.get(&cx, i).is_unsafe;
                        i = methods.len(&cx);
                    } else {
                        i = i + 1usize;
                    }
                }
                (Seq::two(&cx, t.trait_name, t.method), t.targs, needs)
            },
            Callee::Fn(f) => (Seq::one(&cx, f.call_name()), f.targs(&cx), f.sig.is_unsafe),
            Callee::Value(sub) => (Seq::one(&cx, callee_value), sub.values(&cx), self.fn_unsafe(&cx, callee_value)),
            _ => (Seq::one(&cx, callee_value), Seq::new(&cx), self.fn_unsafe(&cx, callee_value)),
        };
        if requires_unsafe && !self.authorized(&cx, c.id) {
            self.fails(&cx, "calling an unsafe function requires unsafe authorization", c.pos);
        }
        // A raw lend's explicit authorization discharges the core call instruction, but must not
        // authorize an independently unsafe callee in the surface.
        var raw_lend = false;
        var i = 0usize;
        while i < operands.len(&cx) {
            raw_lend = raw_lend || operands.get(&cx, i).starts_with(&cx, text(&cx, "&*"));
            i = i + 1usize;
        }
        let args = target.copy(&cx);
        args.append(&cx, operands);
        let is_trait = match call {
            Callee::Trait(_t) => true,
            _ => false,
        };
        let result = self.emit(&cx, Op::new(&cx, if is_trait { "trait_call" } else { "call" }, rty, args).with_tys(self.substitute_all(&cx, targs))
            .from_node(c.id, c.pos).discharge(raw_lend));
        match rty {
            Type::Never => {
                self.terminate(&cx, Terminator::Unreachable.(self.at.get(&cx)));
                Option::None
            },
            _ => Option::Some.(result),
        }
    }

    fn fn_unsafe(self, &cx: Cx!['k], callee: Text['k]) -> bool {
        match self.vty.at(&cx, callee) {
            Type::Fn(f) => f.is_unsafe,
            _ => self.fails(&cx, "internal error: a called value is not a function", self.at.get(&cx)),
        }
    }

    // A call argument: a value, a lent place's path, or a raw pointer's target.
    fn operand(self, &cx: Cx!['k], item: Item['k], c: S::Call['k]) -> Option[Text['k]] {
        let arg = match item {
            Item::Expr(e) => e,
            _ => return self.value(&cx, item),
        };
        var node = arg;
        var explicit = false;
        match node {
            Expr::Unary(u) => if u.op.is(&cx, "unsafe") {
                explicit = true;
                node = u.operand.get(&cx);
            },
            _ => (),
        };
        match node {
            Expr::Unary(u) => if u.op.is(&cx, "&") {
                let target = u.operand.get(&cx);
                match target {
                    Expr::Unary(deref) => if deref.op.is(&cx, "*") {
                        let p = self.expr(&cx, deref.operand.get(&cx));
                        return match p {
                            Option::Some(p) => {
                                if !(explicit || self.authorized(&cx, c.id)) {
                                    self.fails(&cx, "lending a raw pointer target requires unsafe authorization", expr_pos(arg));
                                }
                                Option::Some.(Out::new(&cx).put(&cx, "&*").add(&cx, p).done(&cx))
                            },
                            Option::None => Option::None,
                        };
                    },
                    _ => (),
                };
                match self.place_path(&cx, target) {
                    Option::Some(path) => return Option::Some.(path),
                    Option::None => (),
                };
            },
            _ => (),
        };
        // `&x.m().n`: the & lends the receiver of the first call, not the argument
        self.expr(&cx, arg)
    }

    fn builtin(self, &cx: Cx!['k], c: S::Call['k], name: Text['k]) -> Option[Text['k]] {
        let rty = self.substitute_type(&cx, self.type_of(&cx, c.id));
        if name.is(&cx, "fresh") {
            return Option::Some.(self.emit(&cx, Op::new(&cx, "builtin::fresh", rty, Seq::new(&cx))));
        }
        if name.is(&cx, "static_brand") {
            return Option::Some.(self.emit(&cx, Op::new(&cx, "builtin::unsafe::static_brand", rty, Seq::new(&cx)).from_node(c.id, c.pos)));
        }
        if name.is(&cx, "enum_variant") {
            let arg = c.args.get(&cx, 0usize);
            match arg {
                Expr::Unary(u) => if u.op.is(&cx, "&") {
                    let path = match self.place_path(&cx, u.operand.get(&cx)) {
                        Option::Some(p) => p,
                        Option::None => self.fails(&cx, "enum_variant(&x) needs a local", c.pos),
                    };
                    return Option::Some.(self.emit(&cx, Op::new(&cx, "variant_tag", C::u32_type(&cx), Seq::one(&cx, path)).typed(self.substitute_type(&cx, self.type_of(&cx, u.id)))));
                },
                _ => (),
            };
            let v = match self.expr(&cx, arg) {
                Option::Some(v) => v,
                Option::None => return Option::None,
            };
            let tag = self.emit(&cx, Op::new(&cx, "variant_tag", C::u32_type(&cx), Seq::one(&cx, v)).typed(self.vty.at(&cx, v)));
            return Option::Some.(self.emit(&cx, Op::new(&cx, "construct", rty, Seq::two(&cx, v, tag)).typed(rty)));
        }
        if name.is(&cx, "fence") {
            let order = self.atomic_ordering(&cx, text(&cx, "fence"), c.args);
            return Option::Some.(self.emit(&cx, Op::new(&cx, "builtin::unsafe::atomic_fence", C::unit(&cx), Seq::new(&cx)).literal(order).from_node(c.id, c.pos)));
        }
        let operands = match self.operands(&cx, FnLower::exprs(&cx, c.args), Option::None) {
            Option::Some(o) => o,
            Option::None => return Option::None,
        };
        if name.is(&cx, "load_volatile") {
            return Option::Some.(self.emit(&cx, Op::new(&cx, "builtin::unsafe::load_volatile", rty, operands).from_node(c.id, c.pos)));
        }
        Option::Some.(self.emit(&cx, Op::new(&cx, "builtin::unsafe::store_volatile", C::unit(&cx), operands).from_node(c.id, c.pos)))
    }

    fn ordering(self, &cx: Cx!['k], e: Expr['k]) -> Text['k] {
        match e {
            Expr::Path(p) => match self.lowering.r.refs.get(&cx, p.id) {
                Option::Some(r) => match r {
                    NameRef::Variant(_d, name) => match ordering_name(&cx, name) {
                        Option::Some(o) => return text(&cx, o),
                        Option::None => (),
                    },
                    _ => (),
                },
                Option::None => (),
            },
            _ => (),
        };
        self.fails(&cx, "a memory ordering is written as an Ordering variant", expr_pos(e))
    }

    fn pointer_method(self, &cx: Cx!['k], c: S::Call['k], name: Text['k], receiver: Expr['k]) -> Option[Text['k]] {
        let params = pointer_params(&cx, name);
        let items = Seq::one(&cx, Item::Expr.(receiver));
        let order_args: Seq[Expr['k], 'k] = Seq::new(&cx);
        var i = 0usize;
        while i < c.args.len(&cx) && i < params.len() {
            if params.byte(&cx, i) == b'O' {
                order_args.push(&cx, c.args.get(&cx, i));
            } else {
                items.push(&cx, Item::Expr.(c.args.get(&cx, i)));
            }
            i = i + 1usize;
        }
        let kind = if name.starts_with(&cx, text(&cx, "atomic_")) { name.from(7usize) } else { name };
        let orders = if order_args.is_empty(&cx) { Option::None } else { Option::Some.(self.atomic_ordering(&cx, kind, order_args)) };
        let operands = match self.operands(&cx, items, Option::None) {
            Option::Some(o) => o,
            Option::None => return Option::None,
        };
        let op = if name.is(&cx, "load") {
            text(&cx, "deref")
        } else if name.is(&cx, "compare_exchange") {
            text(&cx, "atomic_compare_exchange")
        } else if name.starts_with(&cx, text(&cx, "store")) || name.starts_with(&cx, text(&cx, "load_")) || name.starts_with(&cx, text(&cx, "atomic_")) {
            name
        } else {
            Out::new(&cx).put(&cx, "atomic_").add(&cx, name).done(&cx)
        };
        let rty = self.substitute_type(&cx, self.type_of(&cx, c.id));
        Option::Some.(self.emit(&cx, Op::named(&cx, Out::new(&cx).put(&cx, "builtin::unsafe::").add(&cx, op).done(&cx), rty, operands).maybe_literal(orders)
            .from_node(c.id, c.pos)))
    }

    fn atomic_ordering(self, &cx: Cx!['k], kind: Text['k], args: Seq[Expr['k], 'k]) -> Text['k] {
        let orders: Seq[Text['k], 'k] = Seq::new(&cx);
        var i = 0usize;
        while i < args.len(&cx) {
            orders.push(&cx, self.ordering(&cx, args.get(&cx, i)));
            i = i + 1usize;
        }
        let order = orders.get(&cx, 0usize);
        if kind.is(&cx, "compare_exchange") {
            let failure = orders.get(&cx, 1usize);
            let allowed = failure.is(&cx, "relaxed")
                || failure.is(&cx, "acquire") && (order.is(&cx, "acquire") || order.is(&cx, "acq_rel") || order.is(&cx, "seq_cst"))
                || failure.is(&cx, "seq_cst") && order.is(&cx, "seq_cst");
            if !allowed {
                self.fail(&cx, Out::new(&cx).put(&cx, "compare_exchange failure ordering ").add(&cx, failure).put(&cx, " is invalid for success ordering ")
                    .add(&cx, order).done(&cx), expr_pos(args.get(&cx, 1usize)));
            }
        } else if kind.is(&cx, "load") && (order.is(&cx, "release") || order.is(&cx, "acq_rel"))
            || kind.is(&cx, "store") && (order.is(&cx, "acquire") || order.is(&cx, "acq_rel"))
            || kind.is(&cx, "fence") && order.is(&cx, "relaxed") {
            self.fail(&cx, Out::new(&cx).put(&cx, "atomic ").add(&cx, kind).put(&cx, " does not support ordering ").add(&cx, order).done(&cx), expr_pos(args.get(&cx, 0usize)));
        }
        let out = Out::new(&cx);
        i = 0usize;
        while i < orders.len(&cx) {
            if i > 0usize {
                let unit = out.put(&cx, "/");
            }
            let unit = out.add(&cx, orders.get(&cx, i));
            i = i + 1usize;
        }
        out.done(&cx)
    }

    // ---- control flow
    fn branch(self, &cx: Cx!['k], cond: Text['k], then: ArmBody['k], other: ArmBody['k], ty: Type['k]) -> Option[Text['k]] {
        let a = self.new_block(&cx, Seq::new(&cx), "b");
        let b = self.new_block(&cx, Seq::new(&cx), "b");
        self.terminate(&cx, Terminator::Jnz.(cond, self.edge(&cx, a, Seq::new(&cx)), self.edge(&cx, b, Seq::new(&cx)), self.at.get(&cx)));
        self.arms(&cx, Seq::two(&cx, a, b), Seq::two(&cx, then, other), ty)
    }

    fn expr_if(self, &cx: Cx!['k], x: S::If['k]) -> Option[Text['k]] {
        let c = match self.expr(&cx, x.cond.get(&cx)) {
            Option::Some(c) => c,
            Option::None => return Option::None,
        };
        let other = match x.other {
            Option::Some(o) => ArmBody::Value.(o.get(&cx)),
            Option::None => ArmBody::Unit,
        };
        self.branch(&cx, c, ArmBody::Value.(Expr::Block.(x.then)), other, self.type_of(&cx, x.id))
    }

    fn expr_return(self, &cx: Cx!['k], value: Option[Cell[Expr['k], 'k]]) -> Option[Text['k]] {
        let v = match value {
            Option::Some(e) => self.expr(&cx, e.get(&cx)),
            Option::None => Option::Some.(self.unit(&cx)),
        };
        if self.live(&cx) {
            match v {
                Option::Some(v) => self.terminate(&cx, Terminator::Ret.(v, self.at.get(&cx))),
                Option::None => (),
            };
        }
        Option::None
    }

    fn expr_while(self, &cx: Cx!['k], w: S::While['k]) -> Option[Text['k]] {
        let head = self.new_block(&cx, Seq::new(&cx), "while");
        self.jump(&cx, head, Seq::new(&cx));
        self.start(&cx, head);
        let c = match self.expr(&cx, w.cond.get(&cx)) {
            Option::Some(c) => c,
            Option::None => return Option::None,
        };
        let body = self.new_block(&cx, Seq::new(&cx), "b");
        let exit = self.new_block(&cx, Seq::new(&cx), "after");
        self.terminate(&cx, Terminator::Jnz.(c, self.edge(&cx, body, Seq::new(&cx)), self.edge(&cx, exit, Seq::new(&cx)), self.at.get(&cx)));
        self.start(&cx, body);
        let unit = self.expr(&cx, Expr::Block.(w.body));
        if self.live(&cx) {
            self.jump(&cx, head, Seq::new(&cx));
        }
        self.start(&cx, exit);
        Option::Some.(self.unit(&cx))
    }

    fn expr_for(self, &cx: Cx!['k], f: S::For['k]) -> Option[Text['k]] {
        let path = match f.iterator.get(&cx) {
            Expr::Unary(u) => self.place_path(&cx, u.operand.get(&cx)),
            _ => Option::None,
        };
        let path = match path {
            Option::Some(p) => p,
            Option::None => self.fails(&cx, "a for loop's iterator is not a place", f.pos),
        };
        let call = self.results().next_calls.at(&cx, f.id);
        let iterator_ty = self.substitute_type(&cx, call.targs.get(&cx, 0usize));
        let item = self.substitute_type(&cx, call.targs.get(&cx, 1usize));
        let option = self.substitute_type(&cx, self.results().options.at(&cx, f.id));
        let head = self.new_block(&cx, Seq::new(&cx), "for");
        self.jump(&cx, head, Seq::new(&cx));
        self.start(&cx, head);
        let args = Seq::two(&cx, call.trait_name, call.method);
        args.push(&cx, path);
        let step = self.emit(&cx, Op::new(&cx, "trait_call", option, args).with_tys(Seq::two(&cx, iterator_ty, item)));
        let item_ty = self.substitute_type(&cx, item);
        let item_name = self.fresh(&cx, "item");
        let some = self.new_block(&cx, Seq::one(&cx, C::Binding.{ name: item_name, type: item_ty }), "some");
        let unit_name = self.fresh(&cx, "unit");
        let none = self.new_block(&cx, Seq::one(&cx, C::Binding.{ name: unit_name, type: C::unit(&cx) }), "none");
        let arms = Seq::two(&cx, C::Arm.{ variant: text(&cx, "Some"), edge: self.edge(&cx, some, Seq::new(&cx)) }, C::Arm.{ variant: text(&cx, "None"), edge: self.edge(&cx, none, Seq::new(&cx)) });
        self.terminate(&cx, Terminator::Switch.(step, option, arms, self.at.get(&cx)));
        self.start(&cx, some);
        let saved = self.save_scope(&cx);
        self.declare(&cx, self.binder(&cx, f.id), f.name, item_ty, item_name);
        let unit = self.expr(&cx, Expr::Block.(f.body));
        self.restore_scope(&cx, saved);
        if self.live(&cx) {
            self.jump(&cx, head, Seq::new(&cx));
        }
        self.start(&cx, none);
        Option::Some.(self.unit(&cx))
    }

    fn discard_pattern(self, &cx: Cx!['k], ty: Type['k]) {
        if !self.copy(&cx, ty) {
            self.fails(&cx, "a pattern cannot discard a linear value", self.at.get(&cx));
        }
    }

    // One core arm per variant. A value arm covering several variants, or none by name, gets one
    // block per variant that takes the payload and jumps on; the coverage check discarded it.
    fn enum_switch(self, &cx: Cx!['k], s: Text['k], ty: Type['k], variants: Seq[C::Member['k], 'k], covers: Seq[Seq[CoverItem['k], 'k], 'k], blocks: Seq[BlockB['k], 'k], place: bool) {
        let arms: Seq[C::Arm['k], 'k] = Seq::new(&cx);
        let hops: Seq[(BlockB['k], BlockB['k]), 'k] = Seq::new(&cx);
        var i = 0usize;
        while i < covers.len(&cx) {
            let cover = covers.get(&cx, i);
            let block = blocks.get(&cx, i);
            var k = 0usize;
            while k < cover.len(&cx) {
                let variant = match cover.get(&cx, k) {
                    CoverItem::Variant(v) => v,
                    CoverItem::Range(_a, _b) => self.fails(&cx, "internal error: a range in an enum match", self.at.get(&cx)),
                };
                if place || !block.params.is_empty(&cx) {
                    arms.push(&cx, C::Arm.{ variant, edge: self.edge(&cx, block, Seq::new(&cx)) });
                } else {
                    let pay = self.fresh(&cx, "pay");
                    let hop = self.new_block(&cx, Seq::one(&cx, C::Binding.{ name: pay, type: member_type(&cx, variants, variant) }), "b");
                    arms.push(&cx, C::Arm.{ variant, edge: self.edge(&cx, hop, Seq::new(&cx)) });
                    hops.push(&cx, (hop, block));
                }
                k = k + 1usize;
            }
            i = i + 1usize;
        }
        self.terminate(&cx, Terminator::Switch.(s, ty, arms, self.at.get(&cx)));
        i = 0usize;
        while i < hops.len(&cx) {
            let (hop, block) = hops.get(&cx, i);
            self.start(&cx, hop);
            self.jump(&cx, block, Seq::new(&cx));
            i = i + 1usize;
        }
    }

    fn compare(self, &cx: Cx!['k], s: Text['k], ty: Type['k], op: Slice[u8, 'static], bound: Int) -> Text['k] {
        let value = self.emit(&cx, Op::new(&cx, "load", ty, Seq::one(&cx, s)));
        let limit = self.constant(&cx, ty, int_spelled(&cx, bound));
        self.emit(&cx, Op::new(&cx, op, C::bool_type(&cx), Seq::two(&cx, value, limit)))
    }

    // An integer match as comparisons in arm order: each range is tested, and a miss goes on to the
    // next test; the wildcard arm takes what is left. The tests run in several blocks, so a
    // scrutinee value is kept in a temporary place and loaded by each.
    fn integer_tests(self, &cx: Cx!['k], scrutinee: Text['k], ty: Type['k], covers: Seq[Seq[CoverItem['k], 'k], 'k], blocks: Seq[BlockB['k], 'k]) {
        var s = scrutinee;
        if !s.starts_with(&cx, text(&cx, "&")) {
            let root = self.temporary(&cx, ty);
            let unit = self.emit(&cx, Op::new(&cx, "store", C::unit(&cx), Seq::two(&cx, root, s)));
            s = root;
        }
        var i = 0usize;
        while i < covers.len(&cx) {
            let cover = covers.get(&cx, i);
            let block = blocks.get(&cx, i);
            if cover.is_empty(&cx) {
                self.jump(&cx, block, Seq::new(&cx));
                return;
            }
            var k = 0usize;
            while k < cover.len(&cx) {
                let (lo, hi) = match cover.get(&cx, k) {
                    CoverItem::Range(lo, hi) => (lo, hi),
                    CoverItem::Variant(_v) => self.fails(&cx, "internal error: a variant in an integer match", self.at.get(&cx)),
                };
                let miss = self.new_block(&cx, Seq::new(&cx), "b");
                if int_eq(lo, hi) {
                    let test = self.compare(&cx, s, ty, "eq", lo);
                    self.terminate(&cx, Terminator::Jnz.(test, self.edge(&cx, block, Seq::new(&cx)), self.edge(&cx, miss, Seq::new(&cx)), self.at.get(&cx)));
                } else {
                    let upper = self.new_block(&cx, Seq::new(&cx), "b");
                    let low_test = self.compare(&cx, s, ty, "ge", lo);
                    self.terminate(&cx, Terminator::Jnz.(low_test, self.edge(&cx, upper, Seq::new(&cx)), self.edge(&cx, miss, Seq::new(&cx)), self.at.get(&cx)));
                    self.start(&cx, upper);
                    let high_test = self.compare(&cx, s, ty, "le", hi);
                    self.terminate(&cx, Terminator::Jnz.(high_test, self.edge(&cx, block, Seq::new(&cx)), self.edge(&cx, miss, Seq::new(&cx)), self.at.get(&cx)));
                }
                self.start(&cx, miss);
                k = k + 1usize;
            }
            i = i + 1usize;
        }
    }

    // Checks that the arms partition the scrutinee's values; returns each arm's cover with its
    // wildcard resolved: an integer arm's ranges, or an enum arm's variants.
    fn match_coverage(self, &cx: Cx!['k], m: S::Match['k], lent: bool, shape: Type['k], covers: Seq[Seq[CoverItem['k], 'k], 'k]) -> Seq[Seq[CoverItem['k], 'k], 'k] {
        let integer = match shape {
            Type::Prim(name) => if C::is_integer(&cx, name) { Option::Some.(name) } else { Option::None },
            _ => Option::None,
        };
        match integer {
            Option::Some(name) => {
                if covers.is_empty(&cx) || !covers.last(&cx).is_empty(&cx) {
                    self.fails(&cx, "an integer match must end with a wildcard", m.pos);
                }
                let bits = C::integer_bits(&cx, name);
                let signed = name.starts_with(&cx, text(&cx, "i"));
                let top = if bits == 64u32 { 18446744073709551615u64 } else { (1u64 << (bits as u64)) - 1u64 };
                let half = 1u64 << ((bits - 1u32) as u64);
                let low = if signed { Int.{ negative: true, magnitude: half } } else { Int.{ negative: false, magnitude: 0u64 } };
                let high = if signed { Int.{ negative: false, magnitude: half - 1u64 } } else { Int.{ negative: false, magnitude: top } };
                let spans: Seq[(Int, Int), 'k] = Seq::new(&cx);
                var k = 0usize;
                while k < covers.len(&cx) {
                    let cover = covers.get(&cx, k);
                    if cover.is_empty(&cx) && k + 1usize != covers.len(&cx) {
                        self.fails(&cx, "a match wildcard must come last", m.pos);
                    }
                    var j = 0usize;
                    while j < cover.len(&cx) {
                        let (lo, hi) = match cover.get(&cx, j) {
                            CoverItem::Range(lo, hi) => (lo, hi),
                            CoverItem::Variant(_v) => self.fails(&cx, "internal error: a variant in an integer match", m.pos),
                        };
                        var bad = !(int_le(low, lo) && int_le(lo, hi) && int_le(hi, high));
                        var s = 0usize;
                        while !bad && s < spans.len(&cx) {
                            let (l, h) = spans.get(&cx, s);
                            bad = int_le(lo, h) && int_le(l, hi);
                            s = s + 1usize;
                        }
                        if bad {
                            self.fails(&cx, "match ranges must fit the integer type and not overlap", m.pos);
                        }
                        spans.push(&cx, (lo, hi));
                        j = j + 1usize;
                    }
                    k = k + 1usize;
                }
                return covers;
            },
            Option::None => (),
        };
        let variants = match shape {
            Type::Enum(vs) => vs,
            _ => self.fails(&cx, "a match requires an integer or enum scrutinee", m.pos),
        };
        let seen: Set[Text['k], 'k] = Set::new(&cx);
        let resolved: Seq[Seq[CoverItem['k], 'k], 'k] = Seq::new(&cx);
        var k = 0usize;
        while k < covers.len(&cx) {
            let cover = covers.get(&cx, k);
            if cover.is_empty(&cx) && k + 1usize != covers.len(&cx) {
                self.fails(&cx, "a match wildcard must come last", m.pos);
            }
            let names: Seq[Text['k], 'k] = Seq::new(&cx);
            var j = 0usize;
            while j < cover.len(&cx) {
                match cover.get(&cx, j) {
                    CoverItem::Variant(v) => names.push(&cx, v),
                    CoverItem::Range(_a, _b) => (),
                };
                j = j + 1usize;
            }
            if names.is_empty(&cx) {
                j = 0usize;
                while j < variants.len(&cx) {
                    if !seen.has(&cx, variants.get(&cx, j).name) {
                        names.push(&cx, variants.get(&cx, j).name);
                    }
                    j = j + 1usize;
                }
            }
            j = 0usize;
            while j < names.len(&cx) {
                let name = names.get(&cx, j);
                if !has_member(&cx, variants, name) || seen.has(&cx, name) {
                    self.fails(&cx, "match variants must not repeat", m.pos);
                }
                seen.add(&cx, name);
                j = j + 1usize;
            }
            let arm = m.arms.get(&cx, k);
            let binds = arm.cases.len(&cx) == 1usize && arm.cases.get(&cx, 0usize).binders.is_some();
            if !lent && !binds {
                j = 0usize;
                while j < names.len(&cx) {
                    self.discard_pattern(&cx, member_type(&cx, variants, names.get(&cx, j)));
                    j = j + 1usize;
                }
            }
            let items: Seq[CoverItem['k], 'k] = Seq::new(&cx);
            j = 0usize;
            while j < names.len(&cx) {
                items.push(&cx, CoverItem::Variant.(names.get(&cx, j)));
                j = j + 1usize;
            }
            resolved.push(&cx, items);
            k = k + 1usize;
        }
        if seen.len(&cx) != variants.len(&cx) {
            self.fails(&cx, "a match must cover every enum variant", m.pos);
        }
        resolved
    }

    fn expr_match(self, &cx: Cx!['k], m: S::Match['k]) -> Option[Text['k]] {
        let lent = self.results().lent.get_or(&cx, m.id, false);
        let scrutinee = if lent {
            match m.scrutinee.get(&cx) {
                Expr::Unary(u) => u.operand.get(&cx),
                _ => self.fails(&cx, "internal error: a lent match without &", m.pos),
            }
        } else {
            m.scrutinee.get(&cx)
        };
        let place = if lent { self.place_path(&cx, scrutinee) } else { Option::None };
        if lent && place.is_none() {
            self.fails(&cx, "match & needs a place", m.pos);
        }
        let s = match place {
            Option::Some(p) => p,
            Option::None => match self.expr(&cx, m.scrutinee.get(&cx)) {
                Option::Some(v) => v,
                Option::None => return Option::None,
            },
        };
        let sty = self.substitute_type(&cx, self.type_of(&cx, expr_id(scrutinee)));
        match sty {
            Type::Named(name, _args) => if self.kinds.has(&cx, name) {
                self.fails(&cx, "a match requires an integer or enum scrutinee; an abstract type has no known matchable shape", m.pos);
            },
            _ => (),
        };
        let shape = self.lowering.types.shape(&cx, sty, Option::None);
        let covers: Seq[Seq[CoverItem['k], 'k], 'k] = Seq::new(&cx);
        let blocks: Seq[BlockB['k], 'k] = Seq::new(&cx);
        var i = 0usize;
        while i < m.arms.len(&cx) {
            let arm = m.arms.get(&cx, i);
            let variant = match arm.cases.get(&cx, 0usize).kind {
                S::CaseKind::Variant => true,
                _ => false,
            };
            let single = arm.cases.len(&cx) == 1usize && variant;
            let payload: Seq[C::Binding['k], 'k] = Seq::new(&cx);
            if place.is_none() && single {
                let pay = self.fresh(&cx, "pay");
                payload.push(&cx, C::Binding.{ name: pay, type: self.substitute_type(&cx, self.type_of(&cx, arm.cases.get(&cx, 0usize).id)) });
            }
            blocks.push(&cx, self.new_block(&cx, payload, "b"));
            let cover: Seq[CoverItem['k], 'k] = Seq::new(&cx);
            var k = 0usize;
            while k < arm.cases.len(&cx) {
                let case = arm.cases.get(&cx, k);
                match case.kind {
                    S::CaseKind::Variant => cover.push(&cx, CoverItem::Variant.(self.case_variant(&cx, case))),
                    S::CaseKind::Value => match case.low {
                        Option::Some(low) => match case.high {
                            Option::Some(high) => cover.push(&cx, CoverItem::Range.(int_of(low), int_of(high))),
                            Option::None => (),
                        },
                        Option::None => (),
                    },
                    S::CaseKind::Wild => (),
                };
                k = k + 1usize;
            }
            covers.push(&cx, cover);
            i = i + 1usize;
        }
        let covers = self.match_coverage(&cx, m, lent, shape, covers);
        match shape {
            Type::Enum(variants) => self.enum_switch(&cx, s, sty, variants, covers, blocks, place.is_some()),
            _ => self.integer_tests(&cx, s, sty, covers, blocks),
        };
        let bodies: Seq[ArmBody['k], 'k] = Seq::new(&cx);
        i = 0usize;
        while i < m.arms.len(&cx) {
            bodies.push(&cx, ArmBody::Case.(m.arms.get(&cx, i), blocks.get(&cx, i), place));
            i = i + 1usize;
        }
        self.arms(&cx, blocks, bodies, self.type_of(&cx, m.id))
    }

    fn case_variant(self, &cx: Cx!['k], case: S::Case['k]) -> Text['k] {
        match case.path {
            Option::Some(p) => match self.lowering.r.refs.get(&cx, p.id) {
                Option::Some(r) => match r {
                    NameRef::Variant(_d, name) => name,
                    _ => self.fails(&cx, "internal error: a variant case that names no variant", case.pos),
                },
                Option::None => self.fails(&cx, "internal error: an unresolved variant case", case.pos),
            },
            Option::None => self.fails(&cx, "internal error: a variant case without a path", case.pos),
        }
    }

    // Binds the whole payload or its components, by value or by place alias.
    fn bind_payload(self, &cx: Cx!['k], case: S::Case['k], payload: Text['k], lent: bool) {
        let ty = self.substitute_type(&cx, self.type_of(&cx, case.id));
        let binders = match case.binders {
            Option::Some(b) => b,
            Option::None => Seq::new(&cx),
        };
        let ids = self.results().case_binders.get_or(&cx, case.id, Seq::new(&cx));
        let whole = binders.len(&cx) == 1usize;
        let types = if whole { Seq::one(&cx, ty) } else { self.lowering.types.fields(&cx, ty, Option::None) };
        let sources: Seq[Text['k], 'k] = Seq::new(&cx);
        if lent {
            let path = Out::new(&cx).add(&cx, payload).put(&cx, ".").add(&cx, self.case_variant(&cx, case)).done(&cx);
            if whole {
                sources.push(&cx, path);
            } else {
                var k = 0usize;
                while k < types.len(&cx) {
                    sources.push(&cx, Out::new(&cx).add(&cx, path).put(&cx, ".").usize(&cx, k).done(&cx));
                    k = k + 1usize;
                }
            }
        } else if whole {
            sources.push(&cx, payload);
        } else {
            let parts = self.destruct(&cx, payload, ty);
            var k = 0usize;
            while k < parts.len(&cx) {
                sources.push(&cx, parts.get(&cx, k).name);
                k = k + 1usize;
            }
        }
        var i = 0usize;
        while i < ids.len(&cx) && i < binders.len(&cx) && i < types.len(&cx) && i < sources.len(&cx) {
            let t = types.get(&cx, i);
            match ids.get(&cx, i) {
                Option::Some(bid) => if lent {
                    self.bindings.set(&cx, id_text(&cx, bid), Binding.{ name: binders.get(&cx, i), type: t, path: Option::Some.(sources.get(&cx, i)), fields: Option::None });
                } else {
                    self.declare(&cx, id_text(&cx, bid), binders.get(&cx, i), t, sources.get(&cx, i));
                },
                Option::None => if !lent {
                    self.discard_pattern(&cx, t);
                },
            };
            i = i + 1usize;
        }
    }

    fn expr_try(self, &cx: Cx!['k], id: u32, value: Expr['k]) -> Option[Text['k]] {
        let v = match self.expr(&cx, value) {
            Option::Some(v) => v,
            Option::None => return Option::None,
        };
        let enum_ty = self.vty.at(&cx, v);
        let result = self.results().try_kinds.get_or(&cx, id, text(&cx, "")).is(&cx, "result");
        let ok = text(&cx, if result { "Ok" } else { "Some" });
        let err = text(&cx, if result { "Err" } else { "None" });
        let variants = match self.lowering.types.shape(&cx, enum_ty, Option::None) {
            Type::Enum(vs) => vs,
            _ => self.fails(&cx, "internal error: `?` on a non-enum", self.at.get(&cx)),
        };
        let ok_name = self.fresh(&cx, "ok");
        let ok_block = self.new_block(&cx, Seq::one(&cx, C::Binding.{ name: ok_name, type: member_type(&cx, variants, ok) }), "b");
        let err_name = self.fresh(&cx, "err");
        let err_block = self.new_block(&cx, Seq::one(&cx, C::Binding.{ name: err_name, type: member_type(&cx, variants, err) }), "b");
        let arms = Seq::two(&cx, C::Arm.{ variant: ok, edge: self.edge(&cx, ok_block, Seq::new(&cx)) }, C::Arm.{ variant: err, edge: self.edge(&cx, err_block, Seq::new(&cx)) });
        self.terminate(&cx, Terminator::Switch.(v, enum_ty, arms, self.at.get(&cx)));
        self.start(&cx, err_block);
        let ret = self.substitute_type(&cx, self.sig.ret);
        let failure = self.emit(&cx, Op::new(&cx, "construct_variant", ret, Seq::one(&cx, err_name)).typed(ret).literal(err));
        self.terminate(&cx, Terminator::Ret.(failure, self.at.get(&cx)));
        self.start(&cx, ok_block);
        Option::Some.(ok_name)
    }

    // ---- closures, foreach, f-strings
    fn capture_items(self, &cx: Cx!['k], captures: Seq[Capture['k], 'k]) -> Seq[Item['k], 'k] {
        let items: Seq[Item['k], 'k] = Seq::new(&cx);
        var i = 0usize;
        while i < captures.len(&cx) {
            items.push(&cx, Item::Bind.(self.bindings.at(&cx, id_text(&cx, captures.get(&cx, i).binder))));
            i = i + 1usize;
        }
        items
    }

    fn next_lifted(self, &cx: Cx!['k], kind: Slice[u8, 'static]) -> Text['k] {
        let n = self.lowering.closures.get(&cx);
        self.lowering.closures.set(&cx, n + 1u64);
        Out::new(&cx).add(&cx, self.name).put(&cx, "#").put(&cx, kind).u64(&cx, n).done(&cx)
    }

    fn expr_closure(self, &cx: Cx!['k], c: S::Closure['k]) -> Option[Text['k]] {
        let ty = self.substitute_type(&cx, self.type_of(&cx, c.id));
        self.check_closed(&cx, ty, Seq::new(&cx));
        let (env_ty, code_ty) = match ty {
            Type::Struct(fields) => (fields.get(&cx, 0usize).type, fields.get(&cx, 1usize).type),
            _ => self.fails(&cx, "internal error: a closure type is not a struct", c.pos),
        };
        let captures = self.results().captures.get_or(&cx, c.id, Seq::new(&cx));
        let vals = match self.operands(&cx, self.capture_items(&cx, captures), Option::None) {
            Option::Some(v) => v,
            Option::None => return Option::None,
        };
        let env = self.emit(&cx, Op::new(&cx, "construct", env_ty, vals).typed(env_ty));
        let code = match code_ty {
            Type::Fn(f) => f,
            _ => self.fails(&cx, "internal error: a closure's code is not a function", c.pos),
        };
        let name = self.next_lifted(&cx, "closure");
        let places: Seq[usize, 'k] = Seq::new(&cx);
        let pnames = Seq::one(&cx, text(&cx, "env"));
        var i = 0usize;
        while i < c.params.len(&cx) {
            if c.params.get(&cx, i).lend {
                places.push(&cx, i + 1usize);
            }
            pnames.push(&cx, c.params.get(&cx, i).name);
            i = i + 1usize;
        }
        let sig = Sig.{ name, decl: Option::None, params: self.sig.params, premises: self.sig.premises, pnames, ptypes: code.params,
            places, ret: code.ret.get(&cx), is_unsafe: false, home: self.sig.home };
        self.lift(&cx, sig, Mode::Closure.(c, env_ty), c.pos);
        let code_value = self.emit(&cx, Op::new(&cx, "fn", code_ty, Seq::one(&cx, name)).with_tys(self.identity_args(&cx)));
        Option::Some.(self.emit(&cx, Op::new(&cx, "construct", ty, Seq::two(&cx, env, code_value)).typed(ty)))
    }

    // Lowers a closure or foreach body to a function of its own.
    fn lift(self, &cx: Cx!['k], sig: Sig['k], mode: Mode['k], pos: Pos) {
        let inner = FnLower::new(&cx, self.lowering, sig, mode, sig.name, pos);
        let { discharge_all: _d, ..rest } = inner;
        let inner = FnLower.{ discharge_all: self.discharge_all || self.sig.is_unsafe, ..rest };
        let fun = inner.run(&cx);
        self.lowering.program.funs.set(&cx, sig.name, fun);
    }

    fn expr_foreach(self, &cx: Cx!['k], f: S::Foreach['k]) -> Option[Text['k]] {
        let ty = self.substitute_type(&cx, self.type_of(&cx, f.id));
        self.check_closed(&cx, ty, Seq::new(&cx));
        let captures = self.results().captures.get_or(&cx, f.id, Seq::new(&cx));
        let items = Seq::one(&cx, Item::Expr.(f.source.get(&cx)));
        items.append(&cx, self.capture_items(&cx, captures));
        let vals = match self.operands(&cx, items, Option::None) {
            Option::Some(v) => v,
            Option::None => return Option::None,
        };
        let each = match ty {
            Type::Foreach(x) => x,
            _ => self.fails(&cx, "internal error: a foreach type is not a foreach", f.pos),
        };
        let name = self.next_lifted(&cx, "foreach");
        let params: Seq[Param['k], 'k] = Seq::new(&cx);
        let binders = foreach_binders(&cx, each);
        var i = 0usize;
        while i < binders.len(&cx) {
            params.push(&cx, Param.{ name: binders.get(&cx, i), kind: Kind::Any });
            i = i + 1usize;
        }
        params.append(&cx, self.sig.params);
        let pnames = Seq::one(&cx, f.name);
        let ptypes = Seq::one(&cx, foreach_item(&cx, each));
        i = 0usize;
        while i < captures.len(&cx) {
            pnames.push(&cx, captures.get(&cx, i).name);
            ptypes.push(&cx, self.bindings.at(&cx, id_text(&cx, captures.get(&cx, i).binder)).type);
            i = i + 1usize;
        }
        let sig = Sig.{ name, decl: Option::None, params, premises: self.sig.premises, pnames, ptypes, places: Seq::new(&cx),
            ret: each.body.get(&cx), is_unsafe: false, home: self.sig.home };
        self.lift(&cx, sig, Mode::Mapper.(f), f.pos);
        let args = Seq::two(&cx, vals.get(&cx, 0usize), name);
        args.append(&cx, vals.from(&cx, 1usize));
        Option::Some.(self.emit(&cx, Op::new(&cx, "foreach", ty, args).typed(ty).with_tys(self.identity_args(&cx)).from_node(f.id, f.pos)))
    }

    fn expr_fstring(self, &cx: Cx!['k], f: S::FStr['k]) -> Option[Text['k]] {
        let sig = self.lowering.library_sig(&cx, "Buffer::new", self.home);
        let writer = self.emit(&cx, Op::new(&cx, "call", self.substitute_type(&cx, self.type_of(&cx, f.id)), Seq::one(&cx, sig.name)));
        self.fstring(&cx, f, writer)
    }

    // Writes each piece into the writer: text through `Writable::write_static`, `{expr}` through
    // `Format::format`, which hands the value back (`{&x}` stores it again).
    fn fstring(self, &cx: Cx!['k], f: S::FStr['k], start: Text['k]) -> Option[Text['k]] {
        var writer = start;
        let wty = self.vty.at(&cx, writer);
        let writable = self.lowering.library_name(&cx, "Writable", self.home);
        let format = self.lowering.library_name(&cx, "Format", self.home);
        var i = 0usize;
        while i < f.parts.len(&cx) {
            match f.parts.get(&cx, i) {
                S::Piece::Text(t) => if !t.is_empty() {
                    let s = self.string(&cx, t);
                    let args = Seq::two(&cx, writable, text(&cx, "write_static"));
                    args.push(&cx, writer);
                    args.push(&cx, s);
                    writer = self.emit(&cx, Op::new(&cx, "trait_call", wty, args).with_tys(Seq::one(&cx, wty)));
                },
                S::Piece::Expr(part) => {
                    let (lend, operand) = match part {
                        Expr::Unary(u) => if u.op.is(&cx, "&") { (true, u.operand.get(&cx)) } else { (false, part) },
                        _ => (false, part),
                    };
                    let values = match self.operands(&cx, Seq::two(&cx, Item::Path.(writer), Item::Expr.(operand)), Option::None) {
                        Option::Some(v) => v,
                        Option::None => return Option::None,
                    };
                    writer = values.get(&cx, 0usize);
                    let v = values.get(&cx, 1usize);
                    let vty = self.vty.at(&cx, v);
                    let pair = Type::Tuple.(Seq::two(&cx, vty, wty));
                    let args = Seq::two(&cx, format, text(&cx, "format"));
                    args.push(&cx, v);
                    args.push(&cx, writer);
                    let both = self.emit(&cx, Op::new(&cx, "trait_call", pair, args).with_tys(Seq::two(&cx, vty, wty)));
                    let parts = self.destruct(&cx, both, pair);
                    writer = parts.get(&cx, 1usize).name;
                    if lend {
                        let path = match self.place_path(&cx, operand) {
                            Option::Some(p) => p,
                            Option::None => self.fails(&cx, "{&x} in an f-string needs a local or a place", self.at.get(&cx)),
                        };
                        let unit = self.emit(&cx, Op::new(&cx, "store", C::unit(&cx), Seq::two(&cx, path, parts.get(&cx, 0usize).name)));
                    }
                },
            };
            i = i + 1usize;
        }
        Option::Some.(writer)
    }

    // ---- brands
    fn expr_pack(self, &cx: Cx!['k], p: S::Pack['k]) -> Option[Text['k]] {
        let v = match self.expr(&cx, p.value.get(&cx)) {
            Option::Some(v) => v,
            Option::None => return Option::None,
        };
        let witnesses = self.substitute_all(&cx, self.results().witnesses.get_or(&cx, p.id, Seq::new(&cx)));
        let ty = self.substitute_type(&cx, self.type_of(&cx, p.id));
        Option::Some.(self.emit(&cx, Op::new(&cx, "pack", ty, Seq::one(&cx, v)).typed(ty).with_tys(witnesses)))
    }

    // ---- statements
    fn stmt(self, &cx: Cx!['k], s: Statement['k]) {
        let previous = self.at.get(&cx);
        let pos = match s {
            Statement::Let(l) => l.pos,
            Statement::Var(v) => v.pos,
            Statement::Assign(a) => a.pos,
            Statement::Expr(n) => n.pos,
            Statement::Const(c) => c.pos,
        };
        self.at.set(&cx, pos);
        match s {
            Statement::Let(l) => self.let_stmt(&cx, l),
            Statement::Var(v) => match self.expr(&cx, v.value) {
                Option::Some(value) => self.declare(&cx, self.binder(&cx, v.id), v.name, self.vty.at(&cx, value), value),
                Option::None => (),
            },
            Statement::Const(c) => {
                let value = self.results().folded.at(&cx, c.id);
                let ty = match const_type(&cx, value) {
                    Option::Some(t) => t,
                    Option::None => self.fails(&cx, "internal error: an untyped constant", c.pos),
                };
                self.declare(&cx, self.binder(&cx, c.id), c.name, ty, self.constant_value(&cx, value));
            },
            Statement::Assign(a) => self.assign(&cx, a),
            Statement::Expr(n) => match self.expr(&cx, n.value) {
                Option::Some(value) => if !self.copy(&cx, self.vty.at(&cx, value)) {
                    self.fails(&cx, "cannot discard a linear expression result; bind or consume it", expr_pos(n.value));
                },
                Option::None => (),
            },
        };
        self.at.set(&cx, previous);
    }

    fn let_stmt(self, &cx: Cx!['k], l: S::Let['k]) {
        var v = match self.expr(&cx, l.value) {
            Option::Some(v) => v,
            Option::None => return,
        };
        if !l.brands.is_empty(&cx) {
            let (binders, body) = match self.lowering.types.shape(&cx, self.vty.at(&cx, v), Option::None) {
                Type::Exists(binders, body) => (binders, body.get(&cx)),
                _ => self.fails(&cx, "internal error: opening a non-package", l.pos),
            };
            let opened = self.results().opened.get_or(&cx, l.id, Seq::new(&cx));
            let actual: Seq[Text['k], 'k] = Seq::new(&cx);
            var i = 0usize;
            while i < opened.len(&cx) {
                actual.push(&cx, Out::new(&cx).add(&cx, opened.get(&cx, i)).put(&cx, "#").add(&cx, self.fresh(&cx, "").from(1usize)).done(&cx));
                i = i + 1usize;
            }
            let sub: Map[Text['k], Type['k], 'k] = Map::new(&cx);
            i = 0usize;
            while i < binders.len(&cx) && i < actual.len(&cx) {
                sub.set(&cx, binders.get(&cx, i), Type::Skolem.(actual.get(&cx, i)));
                i = i + 1usize;
            }
            let payload = subst(&cx, body, sub, self.lowering.counter);
            v = self.emit(&cx, Op::new(&cx, "open", payload, Seq::one(&cx, v)).opening(actual));
            i = 0usize;
            while i < opened.len(&cx) && i < actual.len(&cx) {
                self.brand_map.get(&cx).set(&cx, opened.get(&cx, i), Type::Skolem.(actual.get(&cx, i)));
                i = i + 1usize;
            }
            self.open_brands.get(&cx).append(&cx, actual);
        }
        self.pattern(&cx, l.pattern, v);
    }

    fn pattern(self, &cx: Cx!['k], p: Pattern['k], value: Text['k]) {
        match p {
            Pattern::Bind(n) => self.declare(&cx, self.binder(&cx, n.id), n.value, self.type_of(&cx, n.id), value),
            Pattern::Wild(_id) => self.discard_pattern(&cx, self.vty.at(&cx, value)),
            Pattern::Tuple(n) => self.elements(&cx, n.value, value),
            Pattern::Array(n) => self.elements(&cx, n.value, value),
            Pattern::Struct(ps) => {
                let ty = self.vty.at(&cx, value);
                let comps = self.destruct(&cx, value, ty);
                let fields = match self.lowering.types.shape(&cx, ty, Option::None) {
                    Type::Struct(fields) => fields,
                    _ => self.fails(&cx, "internal error: a struct pattern on a non-struct", self.at.get(&cx)),
                };
                let named: Map[Text['k], Pattern['k], 'k] = Map::new(&cx);
                var i = 0usize;
                while i < ps.fields.len(&cx) {
                    named.set(&cx, ps.fields.get(&cx, i).name, ps.fields.get(&cx, i).pattern);
                    i = i + 1usize;
                }
                let rest: Map[Text['k], Text['k], 'k] = Map::new(&cx);
                let rest_id = self.results().rest_ids.get(&cx, ps.id);
                i = 0usize;
                while i < fields.len(&cx) && i < comps.len(&cx) {
                    let name = fields.get(&cx, i).name;
                    let c = comps.get(&cx, i);
                    match named.get(&cx, name) {
                        Option::Some(sub) => self.pattern(&cx, sub, c.name),
                        Option::None => match ps.rest {
                            Option::Some(_r) => {
                                let bid = Out::new(&cx).add(&cx, id_text(&cx, match rest_id {
                                    Option::Some(id) => id,
                                    Option::None => self.fails(&cx, "internal error: a rest pattern without an id", self.at.get(&cx)),
                                })).put(&cx, "_").add(&cx, name).done(&cx);
                                rest.set(&cx, name, bid);
                                self.declare(&cx, bid, name, c.type, c.name);
                            },
                            Option::None => self.discard_pattern(&cx, c.type),
                        },
                    };
                    i = i + 1usize;
                }
                match ps.rest {
                    Option::Some(r) => match rest_id {
                        Option::Some(id) => self.bindings.set(&cx, id_text(&cx, id), Binding.{ name: r, type: C::unit(&cx), path: Option::None, fields: Option::Some.(rest) }),
                        Option::None => (),
                    },
                    Option::None => (),
                };
            },
        }
    }

    fn elements(self, &cx: Cx!['k], elems: Seq[Pattern['k], 'k], value: Text['k]) {
        let parts = self.destruct(&cx, value, self.vty.at(&cx, value));
        var i = 0usize;
        while i < elems.len(&cx) && i < parts.len(&cx) {
            self.pattern(&cx, elems.get(&cx, i), parts.get(&cx, i).name);
            i = i + 1usize;
        }
    }

    fn assign(self, &cx: Cx!['k], a: S::Assign['k]) {
        let v = match self.expr(&cx, a.value) {
            Option::Some(v) => v,
            Option::None => return,
        };
        let path = match a.target {
            Expr::Path(p) => self.local(&cx, p.id).path,
            _ => self.place_path(&cx, a.target),
        };
        match path {
            Option::Some(p) => {
                let unit = self.emit(&cx, Op::new(&cx, "store", C::unit(&cx), Seq::two(&cx, p, v)));
            },
            Option::None => self.fails(&cx, "assignment through a field needs a place", a.pos),
        };
    }
}

forall 'k.
fn member_type(&cx: Cx!['k], members: Seq[C::Member['k], 'k], name: Text['k]) -> Type['k] {
    var i = 0usize;
    while i < members.len(&cx) {
        if members.get(&cx, i).name.eq(&cx, name) {
            return members.get(&cx, i).type;
        }
        i = i + 1usize;
    }
    C::unit(&cx)
}

forall 'k.
fn has_member(&cx: Cx!['k], members: Seq[C::Member['k], 'k], name: Text['k]) -> bool {
    var i = 0usize;
    while i < members.len(&cx) {
        if members.get(&cx, i).name.eq(&cx, name) {
            return true;
        }
        i = i + 1usize;
    }
    false
}

// The core program for a resolved, signature-built package graph: every body inferred, lowered,
// its place contracts planned and its branded roots promoted.
forall 'k.
fn lower(&cx: Cx!['k], r: Resolver['k], sigs: Signatures['k], counter: Fresh['k]) -> Program['k] {
    let inf = infer(&cx, r, sigs, counter);
    let program = Program.{ types: sigs.types, funs: Map::new(&cx), externs: Map::new(&cx), datas: Map::new(&cx), traits: sigs.traits, instances: Map::new(&cx) };
    let lowering = Lowering.{ r, sigs, results: inf.out, program, types: Types::new(&cx, program, counter), counter, datas: Map::new(&cx),
        closures: Cell::new(&cx, 0u64), value_types: Map::new(&cx) };
    lowering.run(&cx)
}
