// Infer block place contracts after surface expressions have been lowered.
//
// This pass follows the finished control-flow graph. It is separate from the syntax-directed
// translation rules in `lower` and reuses the core checker's path typing and place-state helpers to
// compute candidate block contracts. Planning assumes the graph structure supplied by lowering; it
// does not validate instructions or prove the contracts. A subsequent replay of the finalized
// headers reports named-place ownership errors. This does not check SSA accounting or all contract
// obligations: the lowered program must still pass `check_program` before C is made from it.
//
// Each block's declared place state (`empty`, `known`, `opened`) comes from a forward dataflow over
// the finished graph, tracking the place effects of instructions: a block assumes empty whatever any
// incoming edge leaves empty. Known variants and opened views are retained only when incoming edges
// agree after brand renaming. This intersection is only a candidate: dropping an incoming view does
// not close it, and exact edge checking will reject that predecessor unless lowering explicitly
// closes it first.

use std::collections::arena_vec::ArenaVec;
use std::collections::arena_map::{ArenaMap, ArenaSet};
use std::mem::Ref;
use std::raw::Span;
use std::alloc::arena::Domain!;
use std::bytes::buffer::Buffer!;
use package::check::checker::{Checker, Places, overlap, prefix, root_of, strict_ancestor_in};
use package::kurs::core::{Block, Edge, Fun, Kind, Known, Opened, Param, Program, Terminator, Type};
use package::kurs::core as C;
use package::resolve::resolver::Resolver;
use package::syntax::ast::Pos;
use package::types::ops::{Fresh, free_brands};
use package::support::base::fail;
use std::collections::hashmap::OwnedMap!;
use std::collections::vec::{OwnedVec!, Popped!};
use std::option::{Option, Result};
use std::slice::Slice;

// A place's root and its fields, from the first `.`, without the `&` a local's name starts with.
forall 'k.
fn place_parts(&cx: Domain!['k], path: Span['k]) -> (Span['k], Span['k]) {
    let stripped = if path.starts_with(&cx, Span::from_static(&cx, "&")) { path.skip(1usize) } else { path };
    match stripped.find_byte(&cx, b'.', 0usize) {
        Option::Some(at) => (stripped.take(at), stripped.skip(at)),
        Option::None => (stripped, Span::from_static(&cx, "")),
    }
}

// How a message names the place `path`: its variable and fields, or a temporary expression result.
forall 'k.
fn place_name(&cx: Domain!['k], path: Span['k]) -> Span['k] {
    let (root, fields) = place_parts(&cx, path);
    let name = if root.starts_with(&cx, Span::from_static(&cx, "#tmp")) {
        Span::from_static(&cx, "temporary expression result")
    } else {
        match root.find_byte(&cx, b'#', 0usize) {
            Option::Some(at) => root.take(at),
            Option::None => root,
        }
    };
    Buffer!::new().push_bytes(&cx, name).push_bytes(&cx, fields).save(&cx)
}

// How a message names the function `name`: a closure or foreach body lifted out of a function by
// that function's name.
forall 'k.
fn function_name(&cx: Domain!['k], name: Span['k]) -> Span['k] {
    var end = name.len();
    let unit = match name.find(&cx, Span::from_static(&cx, "#closure"), 0usize) {
        Option::Some(at) => { end = at; },
        Option::None => (),
    };
    let unit = match name.find(&cx, Span::from_static(&cx, "#foreach"), 0usize) {
        Option::Some(at) => if at < end { end = at; },
        Option::None => (),
    };
    name.take(end)
}

// The state of planning one function.
forall 'k.
exposed struct Plan {
    fun: Fun['k],
    // block label -> its index
    index: ArenaMap[Span['k], usize, 'k],
    // the brands every block may mention
    global: ArenaSet[Span['k], 'k],
    // each local's free brands, and whether it is Copy once that is asked
    local_brands: ArenaVec[ArenaSet[Span['k], 'k], 'k],
    local_copy: ArenaVec[Option[bool], 'k],
    // the locals whose types mention brands other than `global`
    branded: ArenaVec[usize, 'k],
    // the state each block starts in, so far
    header: ArenaMap[Span['k], Places['k], 'k],
    // block index -> its place in the reverse postorder the walk follows, for a block the entry
    // reaches; and, by that place, whether the block's header changed since it last ran
    rank: ArenaVec[usize, 'k],
    dirty: ArenaVec[bool, 'k],
}

forall 'k.
exposed struct PlaceFlow {
    checker: Checker['k],
    r: Resolver['k],
    // the first store into each place path, for diagnostics
    origins: Ref[ArenaMap[Span['k], Pos, 'k], 'k],
    // The state a block is simulated in, loaded from the state it starts in, and the state of an
    // edge that knows a switched place's variant: scratch, reused for every block and function.
    working: Places['k],
    arm: Places['k],
}

// A state with nothing in it.
forall 'k.
fn no_places(&cx: Domain!['k]) -> Places['k] {
    Places::new(ArenaSet::new(&cx), ArenaMap::new(&cx), ArenaMap::new(&cx))
}

// How many keys each of a state's maps holds and has held: what any change to it changes, but
// for a value replaced under a key it holds.
forall 'k.
fn extent(&cx: Domain!['k], p: Places['k]) -> (usize, usize, usize, usize, usize, usize) {
    (p.empty.len(&cx), p.empty.positions(&cx), p.known.len(&cx), p.known.positions(&cx), p.opened.len(&cx), p.opened.positions(&cx))
}

forall 'k.
fn term_pos(t: Terminator['k]) -> Pos {
    match t {
        Terminator::Ret(_v, p) => p,
        Terminator::Jmp(_e, p) => p,
        Terminator::Jnz(_c, _a, _b, p) => p,
        Terminator::Switch(_s, _t, _arms, p) => p,
        Terminator::Unreachable(p) => p,
    }
}

// How many edges leave a block.
forall 'k.
fn edge_count(&cx: Domain!['k], block: Block['k]) -> usize {
    match block.term {
        Terminator::Jmp(_e, _p) => 1usize,
        Terminator::Jnz(_c, _a, _b, _p) => 2usize,
        Terminator::Switch(_s, _t, arms, _p) => arms.len(&cx),
        _ => 0usize,
    }
}

// A block's outgoing edge `i`, with the variant it makes known of a switched place.
forall 'k.
fn edge_at(&cx: Domain!['k], block: Block['k], i: usize) -> (Edge['k], Option[(Span['k], Span['k])]) {
    match block.term {
        Terminator::Jmp(e, _p) => (e, Option::None),
        Terminator::Jnz(_c, a, b, _p) => (if i == 0usize { a } else { b }, Option::None),
        Terminator::Switch(scrutinee, _t, arms, _p) => {
            let arm = arms.at(&cx, i);
            let place = scrutinee.starts_with(&cx, Span::from_static(&cx, "&"));
            (arm.edge, if place { Option::Some.((scrutinee, arm.variant)) } else { Option::None })
        },
        _ => fail(&cx, Span::from_static(&cx, "internal error: an edge of a block that has none")),
    }
}

forall 'k.
fn texts_equal(&cx: Domain!['k], a: ArenaVec[Span['k], 'k], b: ArenaVec[Span['k], 'k]) -> bool {
    a.eq(&cx, b)
}

// `a` and `b` hold the same paths, variants and views.
forall 'k.
fn same_places(&cx: Domain!['k], a: Places['k], b: Places['k]) -> bool {
    if a.empty.len(&cx) != b.empty.len(&cx) || a.known.len(&cx) != b.known.len(&cx) || a.opened.len(&cx) != b.opened.len(&cx) {
        return false;
    }
    var i = 0usize;
    while i < a.empty.positions(&cx) {
        match a.empty.key_at(&cx, i) {
            Option::Some(p) => if !b.empty.contains(&cx, p) {
                return false;
            },
            Option::None => (),
        };
        i = i + 1usize;
    }
    i = 0usize;
    while i < a.known.positions(&cx) {
        match a.known.key_at(&cx, i) {
            Option::Some(p) => match b.known.get(&cx, p) {
                Option::Some(v) => if !v.eq(&cx, a.known.at(&cx, p)) {
                    return false;
                },
                Option::None => return false,
            },
            Option::None => (),
        };
        i = i + 1usize;
    }
    i = 0usize;
    while i < a.opened.positions(&cx) {
        match a.opened.key_at(&cx, i) {
            Option::Some(p) => match b.opened.get(&cx, p) {
                Option::Some(v) => if !texts_equal(&cx, v, a.opened.at(&cx, p)) {
                    return false;
                },
                Option::None => return false,
            },
            Option::None => (),
        };
        i = i + 1usize;
    }
    true
}

// Removes from `empty` every path at or below `path`.
forall 'k.
fn clear_below(&cx: Domain!['k], empty: ArenaSet[Span['k], 'k], path: Span['k]) {
    var i = 0usize;
    while i < empty.positions(&cx) {
        match empty.key_at(&cx, i) {
            Option::Some(z) => if prefix(&cx, path, z) {
                empty.remove(&cx, z);
            },
            Option::None => (),
        };
        i = i + 1usize;
    }
}

// Keeps only the outermost paths of `empty`. Removing a path that has an ancestor leaves the
// outermost ancestor, so the paths left over answer the same.
forall 'k.
fn outermost(&cx: Domain!['k], empty: ArenaSet[Span['k], 'k]) {
    var i = 0usize;
    while i < empty.positions(&cx) {
        match empty.key_at(&cx, i) {
            Option::Some(p) => if strict_ancestor_in(&cx, empty, p) {
                empty.remove(&cx, p);
            },
            Option::None => (),
        };
        i = i + 1usize;
    }
}

// `empty` holds only outermost paths.
forall 'k.
fn is_outermost(&cx: Domain!['k], empty: ArenaSet[Span['k], 'k]) -> bool {
    var i = 0usize;
    while i < empty.positions(&cx) {
        match empty.key_at(&cx, i) {
            Option::Some(p) => if strict_ancestor_in(&cx, empty, p) {
                return false;
            },
            Option::None => (),
        };
        i = i + 1usize;
    }
    true
}

// The blocks the entry of `plan`'s function reaches, by index, in reverse postorder of a
// depth-first walk that takes each block's edges in order.
forall 'k.
fn reverse_postorder(&cx: Domain!['k], plan: Plan['k]) -> ArenaVec[usize, 'k] {
    let fun = plan.fun;
    let post: ArenaVec[usize, 'k] = ArenaVec::new(&cx);
    // The walk's path, each block on it with the edge it takes next, and the blocks it has seen:
    // its own, freed when it ends.
    var path = OwnedVec!::new[(usize, usize)]().push((0usize, 0usize));
    var seen = OwnedMap!::new[usize, bool]();
    let fresh = &seen.insert(0usize, true);
    var going = true;
    while going {
        match &path.pop() {
            Popped!::Item(top) => {
                let (b, e) = top;
                let block = fun.blocks.at(&cx, b);
                if e < edge_count(&cx, block) {
                    path = path.push((b, e + 1usize));
                    let (edge, _known) = edge_at(&cx, block, e);
                    let t = plan.index.at(&cx, edge.target);
                    match &seen.insert(t, true) {
                        Option::None => {
                            path = path.push((t, 0usize));
                        },
                        Option::Some(old) => (),
                    };
                } else {
                    post.push(&cx, b);
                }
            },
            Popped!::Empty => {
                going = false;
            },
        };
    }
    path.free();
    seen.free();
    post.reverse(&cx);
    post
}

forall 'k.
fn locals_empty(&cx: Domain!['k], fun: Fun['k]) -> Places['k] {
    let empty: ArenaSet[Span['k], 'k] = ArenaSet::new(&cx);
    var i = 0usize;
    while i < fun.locals.len(&cx) {
        empty.insert(&cx, fun.locals.at(&cx, i).name);
        i = i + 1usize;
    }
    Places::new(empty, ArenaMap::new(&cx), ArenaMap::new(&cx))
}

// Merging `incoming` into the header `state` would leave it as it is: `incoming` empties no other
// path, agrees on every known variant and view and knows no other, and `state` empties only
// outermost paths.
forall 'k.
fn adds_nothing(&cx: Domain!['k], state: Places['k], incoming: Places['k]) -> bool {
    if incoming.known.len(&cx) != state.known.len(&cx) || !subset(&cx, incoming.empty, state.empty) {
        return false;
    }
    var k = 0usize;
    while k < state.known.positions(&cx) {
        match state.known.key_at(&cx, k) {
            Option::Some(p) => match incoming.known.get(&cx, p) {
                Option::Some(v) => if !v.eq(&cx, state.known.at(&cx, p)) {
                    return false;
                },
                Option::None => return false,
            },
            Option::None => (),
        };
        k = k + 1usize;
    }
    k = 0usize;
    while k < state.opened.positions(&cx) {
        match state.opened.key_at(&cx, k) {
            Option::Some(p) => match incoming.opened.get(&cx, p) {
                Option::Some(v) => if !texts_equal(&cx, v, state.opened.at(&cx, p)) {
                    return false;
                },
                Option::None => return false,
            },
            Option::None => (),
        };
        k = k + 1usize;
    }
    is_outermost(&cx, state.empty)
}

forall 'k.
fn subset(&cx: Domain!['k], a: ArenaSet[Span['k], 'k], b: ArenaSet[Span['k], 'k]) -> bool {
    var i = 0usize;
    while i < a.positions(&cx) {
        match a.key_at(&cx, i) {
            Option::Some(x) => if !b.contains(&cx, x) {
                return false;
            },
            Option::None => (),
        };
        i = i + 1usize;
    }
    true
}

forall 'k.
impl PlaceFlow['k] {
    fn new(&cx: Domain!['k], program: Program['k], r: Resolver['k], counter: Fresh['k]) -> PlaceFlow['k] {
        PlaceFlow.{ checker: Checker::new(&cx, program, counter), r, origins: Ref::new(&cx, ArenaMap::new(&cx)), working: no_places(&cx), arm: no_places(&cx) }
    }

    fn places(self, &cx: Domain!['k]) -> Places['k] {
        self.checker.places.copy(&cx)
    }

    fn fun(self, &cx: Domain!['k]) -> Fun['k] {
        self.checker.fun(&cx)
    }

    // Plans the contracts of `fun`'s blocks, an instance method's with the instance's parameters
    // `outer`, then reports its ownership errors.
    fn plan(self, &cx: Domain!['k], fun: Fun['k], outer: ArenaVec[Param['k], 'k]) {
        let c = self.checker;
        let params = outer.clone(&cx);
        params.append(&cx, fun.params);
        c.current.set(&cx, Option::Some.(fun));
        c.params.set(&cx, params);
        c.location.set(&cx, fun.name);
        let kinds: ArenaMap[Span['k], Kind, 'k] = ArenaMap::new(&cx);
        var i = 0usize;
        while i < params.len(&cx) {
            kinds.insert(&cx, params.at(&cx, i).name, params.at(&cx, i).kind);
            i = i + 1usize;
        }
        c.kinds.set(&cx, kinds);
        c.home.set(&cx, fun.home);
        let roots: ArenaMap[Span['k], Type['k], 'k] = ArenaMap::new(&cx);
        i = 0usize;
        while i < fun.locals.len(&cx) {
            roots.insert(&cx, fun.locals.at(&cx, i).name, fun.locals.at(&cx, i).type);
            i = i + 1usize;
        }
        let entry = fun.blocks.at(&cx, 0usize);
        i = 0usize;
        while i < entry.params.len(&cx) {
            if entry.params.at(&cx, i).name.starts_with(&cx, Span::from_static(&cx, "&")) {
                roots.insert(&cx, entry.params.at(&cx, i).name, entry.params.at(&cx, i).type);
            }
            i = i + 1usize;
        }
        c.roots.set(&cx, roots);
        let index: ArenaMap[Span['k], usize, 'k] = ArenaMap::new(&cx);
        i = 0usize;
        while i < fun.blocks.len(&cx) {
            index.insert(&cx, fun.blocks.at(&cx, i).label, i);
            i = i + 1usize;
        }
        let global: ArenaSet[Span['k], 'k] = ArenaSet::new(&cx);
        i = 0usize;
        while i < params.len(&cx) {
            if C::same_kind(params.at(&cx, i).kind, Kind::Brand) {
                global.insert(&cx, params.at(&cx, i).name);
            }
            i = i + 1usize;
        }
        global.insert(&cx, Span::from_static(&cx, "static"));
        let local_brands: ArenaVec[ArenaSet[Span['k], 'k], 'k] = ArenaVec::new(&cx);
        let local_copy: ArenaVec[Option[bool], 'k] = ArenaVec::new(&cx);
        let branded: ArenaVec[usize, 'k] = ArenaVec::new(&cx);
        i = 0usize;
        while i < fun.locals.len(&cx) {
            let brands = free_brands(&cx, fun.locals.at(&cx, i).type);
            local_brands.push(&cx, brands);
            local_copy.push(&cx, Option::None);
            // A local whose brands are all global keeps them across every edge.
            if !subset(&cx, brands, global) {
                branded.push(&cx, i);
            }
            i = i + 1usize;
        }
        let header: ArenaMap[Span['k], Places['k], 'k] = ArenaMap::new(&cx);
        header.insert(&cx, entry.label, locals_empty(&cx, fun));
        let rank = ArenaVec::filled(&cx, fun.blocks.len(&cx), 0usize);
        let plan = Plan.{ fun, index, global, local_brands, local_copy, branded, header, rank, dirty: ArenaVec::new(&cx) };
        c.places.set(&cx, Places::new(ArenaSet::new(&cx), ArenaMap::new(&cx), ArenaMap::new(&cx)));
        // The walk takes the first block, in reverse postorder, whose header changed since it last
        // ran: a block runs once every edge into it from earlier in that order has brought its
        // state, and again only around a loop.
        let order = reverse_postorder(&cx, plan);
        i = 0usize;
        while i < order.len(&cx) {
            rank.set(&cx, order.at(&cx, i), i);
            plan.dirty.push(&cx, i == 0usize);
            i = i + 1usize;
        }
        var at = 0usize;
        while at < order.len(&cx) {
            if plan.dirty.at(&cx, at) {
                plan.dirty.set(&cx, at, false);
                let block = fun.blocks.at(&cx, order.at(&cx, at));
                let places = header.at(&cx, block.label);
                // The block runs in the scratch state; it leaves in a state of its own only when it
                // changed what it started in.
                self.working.load(&cx, places);
                c.places.set(&cx, self.working);
                let changed = self.simulate(&cx, block, false);
                let leaving = if changed { self.working.copy(&cx) } else { places };
                let earliest = self.leave(&cx, plan, block, leaving);
                if earliest < at {
                    at = earliest;
                }
            } else {
                at = at + 1usize;
            }
        }
        i = 1usize;
        while i < fun.blocks.len(&cx) {
            let block = fun.blocks.at(&cx, i);
            match header.get(&cx, block.label) {
                Option::Some(state) => {
                    let empty = state.empty.keys(&cx);
                    empty.sort_by(&cx, |&cx, a, b| a.cmp(&cx, b));
                    let known: ArenaVec[Known['k], 'k] = ArenaVec::new(&cx);
                    var k = 0usize;
                    while k < state.known.positions(&cx) {
                        match state.known.key_at(&cx, k) {
                            Option::Some(p) => known.push(&cx, Known.{ path: p, variant: state.known.at(&cx, p) }),
                            Option::None => (),
                        };
                        k = k + 1usize;
                    }
                    known.sort_by(&cx, |&cx, a, b| a.path.cmp(&cx, b.path));
                    let opened: ArenaVec[Opened['k], 'k] = ArenaVec::new(&cx);
                    k = 0usize;
                    while k < state.opened.positions(&cx) {
                        match state.opened.key_at(&cx, k) {
                            Option::Some(p) => opened.push(&cx, Opened.{ path: p, brands: state.opened.at(&cx, p) }),
                            Option::None => (),
                        };
                        k = k + 1usize;
                    }
                    opened.sort_by(&cx, |&cx, a, b| a.path.cmp(&cx, b.path));
                    let { empty: _e, known: _k, opened: _o, ..rest } = block;
                    fun.blocks.set(&cx, i, Block.{ empty, known, opened, ..rest });
                },
                Option::None => (),
            };
            i = i + 1usize;
        }
        self.diagnose_places(&cx, fun, header);
    }

    // Merges `incoming` into the header of block `b`; whether the header changed. The header is
    // shared, like every state sent: the block runs in a copy.
    fn arrive(self, &cx: Domain!['k], plan: Plan['k], b: usize, incoming: Places['k]) -> bool {
        let label = plan.fun.blocks.at(&cx, b).label;
        let state = match plan.header.get(&cx, label) {
            Option::None => {
                plan.header.insert(&cx, label, incoming);
                return true;
            },
            Option::Some(state) => state,
        };
        if adds_nothing(&cx, state, incoming) {
            return false;
        }
        let empty = state.empty.clone(&cx);
        var k = 0usize;
        while k < incoming.empty.positions(&cx) {
            match incoming.empty.key_at(&cx, k) {
                Option::Some(p) => { empty.insert(&cx, p); },
                Option::None => (),
            };
            k = k + 1usize;
        }
        let known: ArenaMap[Span['k], Span['k], 'k] = ArenaMap::new(&cx);
        k = 0usize;
        while k < state.known.positions(&cx) {
            match state.known.key_at(&cx, k) {
                Option::Some(p) => match incoming.known.get(&cx, p) {
                    Option::Some(v) => if v.eq(&cx, state.known.at(&cx, p)) {
                        known.insert(&cx, p, v);
                    },
                    Option::None => (),
                },
                Option::None => (),
            };
            k = k + 1usize;
        }
        let merged = Places::new(empty, known, state.opened.clone(&cx));
        let agreed: ArenaMap[Span['k], ArenaVec[Span['k], 'k], 'k] = ArenaMap::new(&cx);
        k = 0usize;
        while k < state.opened.positions(&cx) {
            match state.opened.key_at(&cx, k) {
                Option::Some(p) => match incoming.opened.get(&cx, p) {
                    Option::Some(v) => if texts_equal(&cx, v, state.opened.at(&cx, p)) {
                        agreed.insert(&cx, p, v);
                    },
                    Option::None => (),
                },
                Option::None => (),
            };
            k = k + 1usize;
        }
        merged.keep_opened(&cx, agreed);
        self.abstract_variants(&cx, merged, state, incoming);
        if same_places(&cx, merged, state) {
            return false;
        }
        plan.header.insert(&cx, label, merged);
        true
    }

    // Brings `out` to block `t` along an edge: marks `t` to run again when its header changes. The
    // earliest place in the walk's order this marked, or `earliest` if none is earlier.
    fn send(self, &cx: Domain!['k], plan: Plan['k], t: usize, out: Places['k], earliest: usize) -> usize {
        if !self.arrive(&cx, plan, t, out) {
            return earliest;
        }
        let r = plan.rank.at(&cx, t);
        plan.dirty.set(&cx, r, true);
        if r < earliest { r } else { earliest }
    }

    // Sends the state `places` that `block` ends in along each of its edges. States are shared, and
    // never changed once sent: an edge that changes what it sends sends a copy. The earliest place
    // in the walk's order of a block whose header this changed, or the order's length if none.
    fn leave(self, &cx: Domain!['k], plan: Plan['k], block: Block['k], places: Places['k]) -> usize {
        let fun = plan.fun;
        var earliest = plan.dirty.len(&cx);
        let edge_total = edge_count(&cx, block);
        var e = 0usize;
        while e < edge_total {
            let (edge, arm_known) = edge_at(&cx, block, e);
            let t = plan.index.at(&cx, edge.target);
            let target = fun.blocks.at(&cx, t);
            // Existing edge entailment permits forgetting Copy contents. A dead local brand need not
            // survive in an unreadable slot.
            let forgotten: ArenaSet[Span['k], 'k] = ArenaSet::new(&cx);
            if !plan.branded.is_empty(&cx) {
                let kept = plan.global.clone(&cx);
                var k = 0usize;
                while k < target.brands.len(&cx) && k < edge.tys.len(&cx) {
                    match edge.tys.at(&cx, k) {
                        Type::Skolem(label) => if label.eq(&cx, target.brands.at(&cx, k)) {
                            kept.insert(&cx, label);
                        },
                        _ => (),
                    };
                    k = k + 1usize;
                }
                k = 0usize;
                while k < plan.branded.len(&cx) {
                    let l = plan.branded.at(&cx, k);
                    if !subset(&cx, plan.local_brands.at(&cx, l), kept) && self.local_is_copy(&cx, plan, l) {
                        forgotten.insert(&cx, fun.locals.at(&cx, l).name);
                    }
                    k = k + 1usize;
                }
            }
            if arm_known.is_none() && forgotten.is_empty(&cx) && places.opened.is_empty(&cx) {
                earliest = self.send(&cx, plan, t, places, earliest);
            } else {
                let out = places.copy(&cx);
                match arm_known {
                    Option::Some(pair) => {
                        let (path, variant) = pair;
                        out.known.insert(&cx, path, variant);
                    },
                    Option::None => (),
                };
                // A root with a view opened at or below it keeps its contents.
                var o = 0usize;
                while !forgotten.is_empty(&cx) && o < out.opened.positions(&cx) {
                    match out.opened.key_at(&cx, o) {
                        Option::Some(p) => {
                            forgotten.remove(&cx, root_of(&cx, p));
                        },
                        Option::None => (),
                    };
                    o = o + 1usize;
                }
                if !forgotten.is_empty(&cx) {
                    out.forget_roots(&cx, forgotten);
                }
                if !out.opened.is_empty(&cx) {
                    self.rename_views(&cx, out, target, edge);
                }
                earliest = self.send(&cx, plan, t, out, earliest);
            }
            e = e + 1usize;
        }
        earliest
    }

    // Renames `out`'s views into the brands of the block an edge enters, and keeps those whose
    // brands are in scope there.
    fn rename_views(self, &cx: Domain!['k], out: Places['k], target: Block['k], edge: Edge['k]) {
        let rename: ArenaMap[Span['k], Span['k], 'k] = ArenaMap::new(&cx);
        let available = self.global_brands(&cx);
        var k = 0usize;
        while k < target.brands.len(&cx) {
            let brand = target.brands.at(&cx, k);
            available.insert(&cx, brand);
            if k < edge.tys.len(&cx) {
                match edge.tys.at(&cx, k) {
                    Type::Skolem(label) => { rename.insert(&cx, label, brand); },
                    _ => (),
                };
            }
            k = k + 1usize;
        }
        let opened: ArenaMap[Span['k], ArenaVec[Span['k], 'k], 'k] = ArenaMap::new(&cx);
        k = 0usize;
        while k < out.opened.positions(&cx) {
            match out.opened.key_at(&cx, k) {
                Option::Some(p) => {
                    let brands = out.opened.at(&cx, p);
                    let renamed: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
                    var all = true;
                    var j = 0usize;
                    while j < brands.len(&cx) {
                        let brand = rename.get_or(&cx, brands.at(&cx, j), brands.at(&cx, j));
                        renamed.push(&cx, brand);
                        all = all && available.contains(&cx, brand);
                        j = j + 1usize;
                    }
                    if all {
                        opened.insert(&cx, p, renamed);
                    }
                },
                Option::None => (),
            };
            k = k + 1usize;
        }
        out.keep_opened(&cx, opened);
    }

    // The brand parameters of the function being planned, and `static`.
    fn global_brands(self, &cx: Domain!['k]) -> ArenaSet[Span['k], 'k] {
        let out: ArenaSet[Span['k], 'k] = ArenaSet::new(&cx);
        let params = self.checker.params.copy(&cx);
        var i = 0usize;
        while i < params.len(&cx) {
            if C::same_kind(params.at(&cx, i).kind, Kind::Brand) {
                out.insert(&cx, params.at(&cx, i).name);
            }
            i = i + 1usize;
        }
        out.insert(&cx, Span::from_static(&cx, "static"));
        out
    }

    fn local_is_copy(self, &cx: Domain!['k], plan: Plan['k], l: usize) -> bool {
        match plan.local_copy.at(&cx, l) {
            Option::Some(b) => b,
            Option::None => {
                let b = self.checker.copy_type(&cx, plan.fun.locals.at(&cx, l).type);
                plan.local_copy.set(&cx, l, Option::Some.(b));
                b
            },
        }
    }

    // Stops with `message` about the place `path`: the message reads `before`, the variable's name,
    // then `after`.
    fn ownership_error(self, &cx: Domain!['k], path: Span['k], before: Slice[u8, 'static], after: Span['k], pos: Pos, origin: bool) -> ! {
        let (root, _fields) = place_parts(&cx, path);
        let fun = self.fun(&cx);
        var at = pos;
        if root.starts_with(&cx, Span::from_static(&cx, "#tmp")) || origin {
            at = match self.origins.copy(&cx).get(&cx, Buffer!::new().push_static("&").push_bytes(&cx, root).save(&cx)) {
                Option::Some(p) => p,
                Option::None => Pos.{ line: 0u32, col: 0u32 },
            };
            if at.line == 0u32 {
                at = fun.pos;
            }
            if at.line == 0u32 {
                at = pos;
            }
        }
        self.r.fail(&cx, Buffer!::new().push_bytes(&cx, function_name(&cx, fun.name)).push_static(": ").push_static(before).push_bytes(&cx, place_name(&cx, path)).push_bytes(&cx, after).save(&cx), at)
    }

    // Replays the finalized headers for source diagnostics, without checking SSA. Do not diagnose
    // while the fixed point is evolving: a provisional header can still change. This reuses the
    // checker's path and state helpers, but none of its instruction, edge or function validators.
    fn diagnose_places(self, &cx: Domain!['k], fun: Fun['k], header: ArenaMap[Span['k], Places['k], 'k]) {
        let c = self.checker;
        let index: ArenaMap[Span['k], usize, 'k] = ArenaMap::new(&cx);
        var i = 0usize;
        while i < fun.blocks.len(&cx) {
            index.insert(&cx, fun.blocks.at(&cx, i).label, i);
            i = i + 1usize;
        }
        let origins: ArenaMap[Span['k], Pos, 'k] = ArenaMap::new(&cx);
        i = 0usize;
        while i < fun.blocks.len(&cx) {
            let instrs = fun.blocks.at(&cx, i).instrs;
            var k = 0usize;
            while k < instrs.len(&cx) {
                let instr = instrs.at(&cx, k);
                if instr.op.is(&cx, "store") && !origins.contains(&cx, instr.args.at(&cx, 0usize)) {
                    origins.insert(&cx, instr.args.at(&cx, 0usize), instr.pos);
                }
                k = k + 1usize;
            }
            i = i + 1usize;
        }
        self.origins.set(&cx, origins);
        let flow = self;
        let parameters: ArenaSet[Span['k], 'k] = ArenaSet::new(&cx);
        let entry = fun.blocks.at(&cx, 0usize);
        i = 0usize;
        while i < entry.params.len(&cx) {
            if entry.params.at(&cx, i).name.starts_with(&cx, Span::from_static(&cx, "&")) {
                parameters.insert(&cx, entry.params.at(&cx, i).name);
            }
            i = i + 1usize;
        }
        let roots = c.roots.copy(&cx);
        i = 0usize;
        while i < fun.blocks.len(&cx) {
            let block = fun.blocks.at(&cx, i);
            // the blocks reached: the entry, and those with a header
            let reached = if i == 0usize { Option::Some.(locals_empty(&cx, fun)) } else { header.get(&cx, block.label) };
            if reached.is_some() {
                match reached {
                    Option::Some(places) => self.working.load(&cx, places),
                    Option::None => (),
                };
                c.places.set(&cx, self.working);
                let changed = flow.simulate(&cx, block, true);
                match block.term {
                    Terminator::Ret(_v, pos) => {
                        var k = 0usize;
                        while k < roots.positions(&cx) {
                            match roots.key_at(&cx, k) {
                                Option::Some(root) => {
                                    if parameters.contains(&cx, root) {
                                        if !flow.places(&cx).full(&cx, root) {
                                            flow.ownership_error(&cx, root, "lent value '", Span::from_static(&cx, "' must be restored before return"), pos, false);
                                        }
                                    } else {
                                        match c.discardable(&cx, root, roots.at(&cx, root)) {
                                            Result::Ok(free) => if !free {
                                                flow.ownership_error(&cx, root, "linear value '", Span::from_static(&cx, "' is not consumed before return"), pos, true);
                                            },
                                            Result::Err(_m) => (),
                                        };
                                    }
                                },
                                Option::None => (),
                            };
                            k = k + 1usize;
                        }
                    },
                    _ => (),
                };
                let edge_total = edge_count(&cx, block);
                var e = 0usize;
                while e < edge_total {
                    let (edge, known) = edge_at(&cx, block, e);
                    let saved = flow.places(&cx);
                    match known {
                        Option::Some(pair) => {
                            let (path, variant) = pair;
                            self.arm.load(&cx, saved);
                            self.arm.known.insert(&cx, path, variant);
                            c.places.set(&cx, self.arm);
                        },
                        Option::None => (),
                    };
                    let target = fun.blocks.at(&cx, index.at(&cx, edge.target));
                    let empty = c.empty_to_check(&cx, target);
                    let whole = empty.address() == target.empty.address();
                    let rest: ArenaVec[Span['k], 'k] = if whole { ArenaVec::new(&cx) } else { empty };
                    var k = 0usize;
                    while k < empty.len(&cx) {
                        let path = empty.at(&cx, k);
                        let (result, always) = c.empty_discardable(&cx, path);
                        match result {
                            Result::Ok(free) => if !free {
                                flow.ownership_error(&cx, path, "linear value '",
                                    Buffer!::new().push_static("' remains live on some paths to ").push_bytes(&cx, edge.target).save(&cx), term_pos(block.term), false);
                            },
                            Result::Err(_m) => (),
                        };
                        if whole && !always {
                            rest.push(&cx, path);
                        }
                        k = k + 1usize;
                    }
                    c.checked_empty(&cx, target, empty, rest);
                    c.places.set(&cx, saved);
                    e = e + 1usize;
                }
            }
            i = i + 1usize;
        }
    }

    // Forget a lost variant's payload only if both states can discard it. Keep live linear contents
    // and opened views for the core to diagnose: intersecting knowledge must never silently consume
    // or close them.
    fn abstract_variants(self, &cx: Domain!['k], merged: Places['k], left: Places['k], right: Places['k]) {
        if left.known.is_empty(&cx) && right.known.is_empty(&cx) {
            outermost(&cx, merged.empty);
            return;
        }
        let c = self.checker;
        let lost: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
        let states = ArenaVec::two(&cx, left, right);
        var s = 0usize;
        while s < states.len(&cx) {
            let known = states.at(&cx, s).known;
            var k = 0usize;
            while k < known.positions(&cx) {
                match known.key_at(&cx, k) {
                    Option::Some(p) => if !merged.known.contains(&cx, p) && !lost.contains(&cx, p) {
                        lost.push(&cx, p);
                    },
                    Option::None => (),
                };
                k = k + 1usize;
            }
            s = s + 1usize;
        }
        lost.sort_by(&cx, |&cx, a, b| a.cmp(&cx, b));
        let saved = c.places.copy(&cx);
        var i = 0usize;
        while i < lost.len(&cx) {
            let path = lost.at(&cx, i);
            var below = false;
            var k = 0usize;
            while !below && k < merged.empty.positions(&cx) {
                match merged.empty.key_at(&cx, k) {
                    Option::Some(p) => {
                        below = prefix(&cx, path, p) && !path.eq(&cx, p);
                    },
                    Option::None => (),
                };
                k = k + 1usize;
            }
            var viewed = false;
            s = 0usize;
            while below && !viewed && s < states.len(&cx) {
                let opened = states.at(&cx, s).opened;
                k = 0usize;
                while !viewed && k < opened.positions(&cx) {
                    match opened.key_at(&cx, k) {
                        Option::Some(p) => {
                            viewed = prefix(&cx, path, p);
                        },
                        Option::None => (),
                    };
                    k = k + 1usize;
                }
                s = s + 1usize;
            }
            if below && !viewed {
                var discardable = true;
                s = 0usize;
                while s < states.len(&cx) {
                    c.places.set(&cx, states.at(&cx, s));
                    if discardable {
                        discardable = match c.storage_discardable(&cx, path) {
                            Result::Ok(free) => free,
                            Result::Err(_m) => false,
                        };
                    }
                    s = s + 1usize;
                }
                if discardable {
                    clear_below(&cx, merged.empty, path);
                    merged.empty.insert(&cx, path);
                    merged.forget(&cx, path, true);
                }
            }
            i = i + 1usize;
        }
        outermost(&cx, merged.empty);
        c.places.set(&cx, saved);
    }

    // A path through an enum's payload, such as a binder of `match &e`, is used only where the enum is
    // known to hold that variant: not after a store into the enum or one of its ancestors.
    fn variant_known(self, &cx: Domain!['k], path: Span['k], pos: Pos) {
        match self.checker.place_storage(&cx, path) {
            Result::Err(message) => if Span::from_static(&cx, message).is(&cx, "known") {
                self.ownership_error(&cx, path, "'", Span::from_static(&cx, "' is used after its enum was assigned; match it again"), pos, false);
            },
            Result::Ok(_t) => (),
        };
    }

    // The places one call lends are apart: none overlaps another, and beside whole locals a call lends
    // at most two parts of places, which part at a field of a struct or tuple reached through structs
    // and tuples only.
    fn lent_apart(self, &cx: Domain!['k], paths: ArenaVec[Span['k], 'k], pos: Pos) {
        var i = 0usize;
        while i < paths.len(&cx) {
            var j = i + 1usize;
            while j < paths.len(&cx) {
                if overlap(&cx, paths.at(&cx, i), paths.at(&cx, j)) {
                    self.ownership_error(&cx, paths.at(&cx, j), "'", Span::from_static(&cx, "' overlaps another place the same call lends"), pos, false);
                }
                j = j + 1usize;
            }
            i = i + 1usize;
        }
        let nested: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
        i = 0usize;
        while i < paths.len(&cx) {
            if paths.at(&cx, i).contains(&cx, Span::from_static(&cx, ".")) {
                nested.push(&cx, paths.at(&cx, i));
            }
            i = i + 1usize;
        }
        if nested.len(&cx) > 2usize {
            self.ownership_error(&cx, nested.at(&cx, 2usize), "a call lends at most two parts of places; '", Span::from_static(&cx, "' is a third"), pos, false);
        }
        if nested.len(&cx) == 2usize {
            match self.checker.parts_at_product(&cx, nested) {
                Result::Ok(apart) => if !apart {
                    self.ownership_error(&cx, nested.at(&cx, 0usize), "'", Span::from_static(&cx, "' and another part of a place are lent by one call, but they do not part at a struct or tuple field reached through no enum"), pos, false);
                },
                Result::Err(_m) => (),
            };
        }
    }

    // Tracks moves, stores, lends and package views without checking SSA values. A load needs its
    // path's type to decide whether it moves linear contents; if that query fails, the place state is
    // left unchanged for this instruction. Unknown roots, unrefined enum projections and invalid
    // opened views are diagnosed by the core checker, which checks every instruction and requires
    // each edge to satisfy its target's contract. Whether the state may have changed: a key added
    // or removed, or a view opened.
    fn simulate(self, &cx: Domain!['k], block: Block['k], diagnose: bool) -> bool {
        let c = self.checker;
        let before = extent(&cx, c.places.copy(&cx));
        var opened = false;
        var i = 0usize;
        while i < block.instrs.len(&cx) {
            let instr = block.instrs.at(&cx, i);
            let op = instr.op;
            let first = if instr.args.is_empty(&cx) { Span::from_static(&cx, "") } else { instr.args.at(&cx, 0usize) };
            let place = first.starts_with(&cx, Span::from_static(&cx, "&"));
            let places = c.places.copy(&cx);
            if op.is(&cx, "load") || op.is(&cx, "destruct") && place {
                if diagnose && !places.full(&cx, first) {
                    self.ownership_error(&cx, first, "value '", Span::from_static(&cx, "' has been moved or is only partially available"), instr.pos, false);
                }
                if diagnose {
                    self.variant_known(&cx, first, instr.pos);
                }
                match c.place_type(&cx, first) {
                    Result::Ok(t) => if !c.copy_type(&cx, t) {
                        places.empty.insert(&cx, first);
                        places.forget(&cx, first, true);
                    },
                    Result::Err(_m) => (),
                };
            } else if op.is(&cx, "store") {
                var known = true;
                if diagnose {
                    self.variant_known(&cx, first, instr.pos);
                    known = match c.storage_discardable(&cx, first) {
                        Result::Ok(free) => {
                            if !free {
                                self.ownership_error(&cx, first, "cannot overwrite live linear value '", Span::from_static(&cx, "'"), instr.pos, false);
                            }
                            true
                        },
                        Result::Err(_m) => false,
                    };
                }
                if known {
                    clear_below(&cx, places.empty, first);
                    places.forget(&cx, first, true);
                }
            } else if op.is(&cx, "variant_tag") && place {
                if diagnose && !places.full(&cx, first) {
                    self.ownership_error(&cx, first, "enum value '", Span::from_static(&cx, "' has been moved or is only partially available; its tag is unavailable"), instr.pos, false);
                }
                if diagnose {
                    self.variant_known(&cx, first, instr.pos);
                }
            } else if op.is(&cx, "call") || op.is(&cx, "trait_call") {
                let lent: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
                var k = 0usize;
                while k < instr.args.len(&cx) {
                    let arg = instr.args.at(&cx, k);
                    if arg.starts_with(&cx, Span::from_static(&cx, "&")) && !arg.starts_with(&cx, Span::from_static(&cx, "&*")) {
                        lent.push(&cx, arg);
                    }
                    k = k + 1usize;
                }
                if diagnose {
                    k = 0usize;
                    while k < lent.len(&cx) {
                        let arg = lent.at(&cx, k);
                        if !places.full(&cx, arg) {
                            self.ownership_error(&cx, arg, "value '", Span::from_static(&cx, "' has been moved and cannot be lent"), instr.pos, false);
                        }
                        self.variant_known(&cx, arg, instr.pos);
                        k = k + 1usize;
                    }
                    self.lent_apart(&cx, lent, instr.pos);
                }
                k = 0usize;
                while k < lent.len(&cx) {
                    places.forget(&cx, lent.at(&cx, k), true);
                    k = k + 1usize;
                }
            } else if op.is(&cx, "open") && place {
                places.opened.insert(&cx, first, instr.binders);
                opened = true;
            } else if op.is(&cx, "pack") && place {
                places.forget(&cx, first, false);
            }
            i = i + 1usize;
        }
        let after = extent(&cx, c.places.copy(&cx));
        let (a, b, k, l, o, p) = before;
        let (a2, b2, k2, l2, o2, p2) = after;
        opened || a != a2 || b != b2 || k != k2 || l != l2 || o != o2 || p != p2
    }
}
