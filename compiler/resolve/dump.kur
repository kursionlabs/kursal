// A canonical text form of a resolved program, for comparing `resolve` with the reference
// resolver: the packages, each module's scope, and then, module by module, every node that names
// something, in the order the fields of the reference's `syntax.py` dataclasses list them (the
// order `syntax::dump` prints them in).

use package::support::base::{Cx, Map, Out, Seq, Text, text};
use package::kurs::core::ModuleId;
use package::resolve::resolver::{Decl, NameRef, Resolver, Scope, joined};
use package::syntax::ast as S;
use package::syntax::ast::{Expr, Pattern, Statement, Type};
use std::option::Option;

forall 'k.
fn module_text(&cx: Cx!['k], m: ModuleId['k]) -> Text['k] {
    Out::new(&cx).usize(&cx, m.package).put(&cx, ":").add(&cx, joined(&cx, m.path)).done(&cx)
}

forall 'k.
fn decl_text(&cx: Cx!['k], d: Decl['k]) -> Text['k] {
    Out::new(&cx).add(&cx, d.kind).put(&cx, " ").add(&cx, module_text(&cx, d.home)).put(&cx, ":").add(&cx, d.name).done(&cx)
}

forall 'k.
fn ref_text(&cx: Cx!['k], r: NameRef['k]) -> Text['k] {
    match r {
        NameRef::Decl(d) => text(&cx, "decl ").concat(&cx, decl_text(&cx, d)),
        NameRef::Variant(d, name) => Out::new(&cx).put(&cx, "variant ").add(&cx, decl_text(&cx, d)).put(&cx, " ").add(&cx, name).done(&cx),
        NameRef::TraitMethod(d, name) => Out::new(&cx).put(&cx, "trait_method ").add(&cx, decl_text(&cx, d)).put(&cx, " ").add(&cx, name).done(&cx),
        NameRef::Assoc(param, name) => Out::new(&cx).put(&cx, "assoc ").add(&cx, param).put(&cx, " ").add(&cx, name).done(&cx),
        NameRef::Param(name) => text(&cx, "param ").concat(&cx, name),
        NameRef::Prim(name) => text(&cx, "prim ").concat(&cx, name),
        NameRef::Builtin(name) => text(&cx, "builtin ").concat(&cx, name),
        NameRef::Local(name) => text(&cx, "local ").concat(&cx, name),
    }
}

forall 'k.
fn text_before(&cx: Cx!['k], a: Text['k], b: Text['k]) -> bool {
    a.compare(&cx, b) < 0
}

forall 'k.
fn program(&cx: Cx!['k], r: Resolver['k]) -> Text['k] {
    let out = Out::new(&cx);
    var p = 0usize;
    while p < r.packages.len(&cx) {
        let package = r.packages.get(&cx, p);
        let unit = out.put(&cx, "package ").usize(&cx, package.id).put(&cx, " ").add(&cx, package.name.get(&cx)).put(&cx, "\n");
        let unit = out.put(&cx, "  source_root ").add(&cx, package.source_root.get(&cx)).put(&cx, "\n");
        let unit = match package.entry.get(&cx) {
            Option::Some(e) => out.put(&cx, "  entry ").add(&cx, joined(&cx, e)).put(&cx, "\n"),
            Option::None => out.put(&cx, "  entry _\n"),
        };
        let unit = match package.entry_decl.get(&cx) {
            Option::Some(d) => out.put(&cx, "  entry_decl ").add(&cx, decl_text(&cx, d)).put(&cx, "\n"),
            Option::None => out.put(&cx, "  entry_decl _\n"),
        };
        let aliases = package.deps.keys(&cx);
        var i = 0usize;
        while i < aliases.len(&cx) {
            let unit = out.put(&cx, "  dep ").add(&cx, aliases.get(&cx, i)).put(&cx, " ").usize(&cx, package.deps.at(&cx, aliases.get(&cx, i))).put(&cx, "\n");
            i = i + 1usize;
        }
        let modules = package.files.keys(&cx);
        i = 0usize;
        while i < modules.len(&cx) {
            let unit = out.put(&cx, "  file ").add(&cx, module_text(&cx, modules.get(&cx, i))).put(&cx, " ").add(&cx, package.files.at(&cx, modules.get(&cx, i))).put(&cx, "\n");
            i = i + 1usize;
        }
        p = p + 1usize;
    }
    let scopes = r.scopes.values(&cx);
    var s = 0usize;
    while s < scopes.len(&cx) {
        scope(&cx, out, scopes.get(&cx, s));
        s = s + 1usize;
    }
    s = 0usize;
    while s < scopes.len(&cx) {
        let unit = out.put(&cx, "refs ").add(&cx, module_text(&cx, scopes.get(&cx, s).home)).put(&cx, "\n");
        let w = Walk.{ refs: r.refs, out };
        let items = scopes.get(&cx, s).items;
        var i = 0usize;
        while i < items.len(&cx) {
            w.item(&cx, items.get(&cx, i));
            i = i + 1usize;
        }
        s = s + 1usize;
    }
    out.done(&cx)
}

forall 'k.
fn scope(&cx: Cx!['k], out: Out['k], sc: Scope['k]) {
    let unit = out.put(&cx, "scope ").add(&cx, module_text(&cx, sc.home)).put(&cx, "\n");
    let names = sc.decls.keys(&cx);
    var i = 0usize;
    while i < names.len(&cx) {
        let unit = out.put(&cx, "  decl ").add(&cx, names.get(&cx, i)).put(&cx, " ").add(&cx, decl_text(&cx, sc.decls.at(&cx, names.get(&cx, i)))).put(&cx, "\n");
        i = i + 1usize;
    }
    let aliases = sc.imports.keys(&cx);
    i = 0usize;
    while i < aliases.len(&cx) {
        let unit = out.put(&cx, "  import ").add(&cx, aliases.get(&cx, i)).put(&cx, " ").add(&cx, joined(&cx, sc.imports.at(&cx, aliases.get(&cx, i)))).put(&cx, "\n");
        i = i + 1usize;
    }
    i = 0usize;
    while i < sc.globs.len(&cx) {
        let unit = out.put(&cx, "  glob ").add(&cx, joined(&cx, sc.globs.get(&cx, i))).put(&cx, "\n");
        i = i + 1usize;
    }
    let exports = sc.exports.items(&cx);
    exports.sort(&cx, text_before);
    i = 0usize;
    while i < exports.len(&cx) {
        let unit = out.put(&cx, "  export ").add(&cx, exports.get(&cx, i)).put(&cx, "\n");
        i = i + 1usize;
    }
}

// The references of the syntax tree, in field order.
forall 'k.
exposed struct Walk {
    refs: Map[u32, NameRef['k], 'k],
    out: Out['k],
}

forall 'k.
impl Walk['k] {
    fn note(self, &cx: Cx!['k], id: u32, label: Text['k]) {
        let unit = match self.refs.get(&cx, id) {
            Option::Some(r) => self.out.put(&cx, "  ").add(&cx, label).put(&cx, " -> ").add(&cx, ref_text(&cx, r)).put(&cx, "\n"),
            Option::None => self.out,
        };
    }

    fn types(self, &cx: Cx!['k], ts: Seq[Type['k], 'k]) {
        var i = 0usize;
        while i < ts.len(&cx) {
            self.type(&cx, ts.get(&cx, i));
            i = i + 1usize;
        }
    }

    fn opt_type(self, &cx: Cx!['k], t: Option[Type['k]]) {
        let unit = match t {
            Option::Some(v) => self.type(&cx, v),
            Option::None => (),
        };
    }

    fn type(self, &cx: Cx!['k], t: Type['k]) {
        match t {
            Type::Name(n) => {
                self.note(&cx, n.id, text(&cx, "TName ").concat(&cx, joined(&cx, n.path)));
                self.types(&cx, n.args);
            },
            Type::Ptr(inner) => self.type(&cx, inner.get(&cx)),
            Type::Tuple(elems) => self.types(&cx, elems),
            Type::Array(elem, length) => {
                self.type(&cx, elem.get(&cx));
                self.expr(&cx, length.get(&cx));
            },
            Type::Fn(f) => {
                self.slots(&cx, f.params);
                self.type(&cx, f.ret.get(&cx));
            },
            Type::Closure(c) => {
                let unit = match c.env {
                    Option::Some(env) => self.type(&cx, env.get(&cx)),
                    Option::None => (),
                };
                self.slots(&cx, c.params);
                self.type(&cx, c.ret.get(&cx));
            },
            Type::Exists(brands, body) => self.type(&cx, body.get(&cx)),
            Type::Foreach(f) => {
                self.type(&cx, f.source.get(&cx));
                self.type(&cx, f.body.get(&cx));
            },
            Type::Forall(params, body) => self.type(&cx, body.get(&cx)),
            _ => (),
        }
    }

    fn slots(self, &cx: Cx!['k], ss: Seq[S::Slot['k], 'k]) {
        var i = 0usize;
        while i < ss.len(&cx) {
            self.type(&cx, ss.get(&cx, i).type);
            i = i + 1usize;
        }
    }

    fn exprs(self, &cx: Cx!['k], es: Seq[Expr['k], 'k]) {
        var i = 0usize;
        while i < es.len(&cx) {
            self.expr(&cx, es.get(&cx, i));
            i = i + 1usize;
        }
    }

    fn path(self, &cx: Cx!['k], p: S::Path['k]) {
        self.note(&cx, p.id, text(&cx, "Path ").concat(&cx, joined(&cx, p.names(&cx))));
        var i = 0usize;
        while i < p.segments.len(&cx) {
            self.types(&cx, p.segments.get(&cx, i).args);
            i = i + 1usize;
        }
    }

    fn block(self, &cx: Cx!['k], b: S::Block['k]) {
        var i = 0usize;
        while i < b.stmts.len(&cx) {
            self.statement(&cx, b.stmts.get(&cx, i));
            i = i + 1usize;
        }
        let unit = match b.tail {
            Option::Some(t) => self.expr(&cx, t.get(&cx)),
            Option::None => (),
        };
    }

    fn expr(self, &cx: Cx!['k], e: Expr['k]) {
        match e {
            Expr::FStr(f) => {
                var i = 0usize;
                while i < f.parts.len(&cx) {
                    let unit = match f.parts.get(&cx, i) {
                        S::Piece::Expr(x) => self.expr(&cx, x),
                        S::Piece::Text(t) => (),
                    };
                    i = i + 1usize;
                }
            },
            Expr::Path(p) => self.path(&cx, p),
            Expr::Tuple(n) => self.exprs(&cx, n.value),
            Expr::Array(a) => self.exprs(&cx, a.elems),
            Expr::Sizeof(n) => self.type(&cx, n.value),
            Expr::StructLit(s) => {
                self.path(&cx, s.path);
                var i = 0usize;
                while i < s.fields.len(&cx) {
                    let unit = match s.fields.get(&cx, i).value {
                        Option::Some(v) => self.expr(&cx, v),
                        Option::None => (),
                    };
                    i = i + 1usize;
                }
            },
            Expr::Block(b) => self.block(&cx, b),
            Expr::If(n) => {
                self.expr(&cx, n.cond.get(&cx));
                self.block(&cx, n.then);
                let unit = match n.other {
                    Option::Some(o) => self.expr(&cx, o.get(&cx)),
                    Option::None => (),
                };
            },
            Expr::Match(m) => {
                self.expr(&cx, m.scrutinee.get(&cx));
                var i = 0usize;
                while i < m.arms.len(&cx) {
                    let arm = m.arms.get(&cx, i);
                    var k = 0usize;
                    while k < arm.cases.len(&cx) {
                        let unit = match arm.cases.get(&cx, k).path {
                            Option::Some(p) => self.path(&cx, p),
                            Option::None => (),
                        };
                        k = k + 1usize;
                    }
                    self.expr(&cx, arm.body);
                    i = i + 1usize;
                }
            },
            Expr::Closure(c) => {
                var i = 0usize;
                while i < c.params.len(&cx) {
                    self.opt_type(&cx, c.params.get(&cx, i).type);
                    i = i + 1usize;
                }
                self.opt_type(&cx, c.ret);
                self.expr(&cx, c.body.get(&cx));
            },
            Expr::Return(n) => {
                let unit = match n.value {
                    Option::Some(v) => self.expr(&cx, v.get(&cx)),
                    Option::None => (),
                };
            },
            Expr::Pack(p) => self.expr(&cx, p.value.get(&cx)),
            Expr::Foreach(f) => {
                self.expr(&cx, f.source.get(&cx));
                self.block(&cx, f.body);
            },
            Expr::Binop(b) => {
                self.expr(&cx, b.left.get(&cx));
                self.expr(&cx, b.right.get(&cx));
            },
            Expr::Unary(u) => self.expr(&cx, u.operand.get(&cx)),
            Expr::Cast(c) => {
                self.expr(&cx, c.value.get(&cx));
                self.type(&cx, c.type);
            },
            Expr::UnsafeStore(s) => {
                self.expr(&cx, s.pointer.get(&cx));
                self.expr(&cx, s.value.get(&cx));
            },
            Expr::Field(f) => self.expr(&cx, f.value.get(&cx)),
            Expr::Index(x) => self.expr(&cx, x.value.get(&cx)),
            Expr::Call(c) => {
                self.expr(&cx, c.callee.get(&cx));
                self.exprs(&cx, c.args);
            },
            Expr::Try(n) => self.expr(&cx, n.value.get(&cx)),
            Expr::While(w) => {
                self.expr(&cx, w.cond.get(&cx));
                self.block(&cx, w.body);
            },
            Expr::For(f) => {
                self.expr(&cx, f.iterator.get(&cx));
                self.block(&cx, f.body);
            },
            Expr::Lit(l) => (),
        }
    }

    fn statement(self, &cx: Cx!['k], s: Statement['k]) {
        match s {
            Statement::Let(l) => {
                self.opt_type(&cx, l.type);
                self.expr(&cx, l.value);
            },
            Statement::Var(v) => {
                self.opt_type(&cx, v.type);
                self.expr(&cx, v.value);
            },
            Statement::Assign(a) => {
                self.expr(&cx, a.target);
                self.expr(&cx, a.value);
            },
            Statement::Expr(n) => self.expr(&cx, n.value),
            Statement::Const(c) => self.const_decl(&cx, c),
        }
    }

    fn quantifier(self, &cx: Cx!['k], q: Option[S::Forall['k]]) {
        let unit = match q {
            Option::Some(f) => {
                var i = 0usize;
                while i < f.premises.len(&cx) {
                    let args = f.premises.get(&cx, i).args;
                    self.note(&cx, args.id, text(&cx, "TypeArgs"));
                    self.types(&cx, args.args);
                    i = i + 1usize;
                }
            },
            Option::None => (),
        };
    }

    fn params(self, &cx: Cx!['k], ps: Seq[S::Param['k], 'k]) {
        var i = 0usize;
        while i < ps.len(&cx) {
            self.opt_type(&cx, ps.get(&cx, i).type);
            i = i + 1usize;
        }
    }

    fn function(self, &cx: Cx!['k], f: S::Fn['k]) {
        self.params(&cx, f.params);
        self.opt_type(&cx, f.ret);
        let unit = match f.body {
            Option::Some(b) => self.block(&cx, b),
            Option::None => (),
        };
        self.quantifier(&cx, f.quantifier);
    }

    fn const_decl(self, &cx: Cx!['k], c: S::Const['k]) {
        self.type(&cx, c.type);
        self.expr(&cx, c.value);
        self.quantifier(&cx, c.quantifier);
    }

    fn item(self, &cx: Cx!['k], it: S::Item['k]) {
        match it {
            S::Item::Use(u) => self.quantifier(&cx, u.quantifier),
            S::Item::Module(m) => (),
            S::Item::Struct(s) => {
                var i = 0usize;
                while i < s.fields.len(&cx) {
                    self.type(&cx, s.fields.get(&cx, i).type);
                    i = i + 1usize;
                }
                self.quantifier(&cx, s.quantifier);
            },
            S::Item::Tuple(t) => {
                self.types(&cx, t.elems);
                self.quantifier(&cx, t.quantifier);
            },
            S::Item::Enum(e) => {
                var i = 0usize;
                while i < e.variants.len(&cx) {
                    self.types(&cx, e.variants.get(&cx, i).payload);
                    i = i + 1usize;
                }
                self.quantifier(&cx, e.quantifier);
            },
            S::Item::Fn(f) => self.function(&cx, f),
            S::Item::Extern(x) => {
                self.params(&cx, x.params);
                self.opt_type(&cx, x.ret);
                self.quantifier(&cx, x.quantifier);
            },
            S::Item::Const(c) => self.const_decl(&cx, c),
            S::Item::Impl(m) => {
                self.type(&cx, m.type);
                var i = 0usize;
                while i < m.items.len(&cx) {
                    let unit = match m.items.get(&cx, i) {
                        S::Member::Fn(f) => self.function(&cx, f),
                        S::Member::Const(c) => self.const_decl(&cx, c),
                    };
                    i = i + 1usize;
                }
                self.quantifier(&cx, m.quantifier);
            },
            S::Item::Trait(t) => {
                var i = 0usize;
                while i < t.methods.len(&cx) {
                    self.function(&cx, t.methods.get(&cx, i));
                    i = i + 1usize;
                }
                self.quantifier(&cx, t.quantifier);
            },
            S::Item::Instance(n) => {
                self.type(&cx, n.type);
                var i = 0usize;
                while i < n.methods.len(&cx) {
                    self.function(&cx, n.methods.get(&cx, i));
                    i = i + 1usize;
                }
                self.quantifier(&cx, n.quantifier);
            },
        }
    }
}
