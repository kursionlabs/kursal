// A canonical text form of a resolved program, for comparing `resolve` with the reference
// resolver: the packages, each module's scope, and then, module by module, every node that names
// something, in the order the fields of the reference's `syntax.py` dataclasses list them (the
// order `syntax::dump` prints them in).

use std::collections::arena_vec::ArenaVec;
use std::collections::arena_map::ArenaMap;
use std::raw::Span;
use std::arena::Domain!;
use std::buffer::Buffer!;
use package::kurs::core::ModuleId;
use package::resolve::resolver::{Decl, NameRef, Resolver, Scope};
use package::syntax::ast as S;
use package::syntax::ast::{Expr, Pattern, Statement, Type};
use std::option::Option;

forall 'k.
fn module_text(&cx: Domain!['k], m: ModuleId['k]) -> Span['k] {
    Buffer!::new().push_usize(m.package).push_static(":").push_bytes(&cx, m.path.join(&cx, "::")).save(&cx)
}

forall 'k.
fn decl_text(&cx: Domain!['k], d: Decl['k]) -> Span['k] {
    Buffer!::new().push_bytes(&cx, d.kind).push_static(" ").push_bytes(&cx, module_text(&cx, d.home)).push_static(":").push_bytes(&cx, d.name).save(&cx)
}

forall 'k.
fn ref_text(&cx: Domain!['k], r: NameRef['k]) -> Span['k] {
    match r {
        NameRef::Decl(d) => Span::from_static(&cx, "decl ").concat(&cx, decl_text(&cx, d)),
        NameRef::Variant(d, name) => Buffer!::new().push_static("variant ").push_bytes(&cx, decl_text(&cx, d)).push_static(" ").push_bytes(&cx, name).save(&cx),
        NameRef::TraitMethod(d, name) => Buffer!::new().push_static("trait_method ").push_bytes(&cx, decl_text(&cx, d)).push_static(" ").push_bytes(&cx, name).save(&cx),
        NameRef::Assoc(param, name) => Buffer!::new().push_static("assoc ").push_bytes(&cx, param).push_static(" ").push_bytes(&cx, name).save(&cx),
        NameRef::Param(name) => Span::from_static(&cx, "param ").concat(&cx, name),
        NameRef::Prim(name) => Span::from_static(&cx, "prim ").concat(&cx, name),
        NameRef::Builtin(name) => Span::from_static(&cx, "builtin ").concat(&cx, name),
        NameRef::Local(name) => Span::from_static(&cx, "local ").concat(&cx, name),
    }
}

forall 'k.
fn program(&cx: Domain!['k], r: Resolver['k]) -> Span['k] {
    var out = Buffer!::new();
    var p = 0usize;
    while p < r.packages.len(&cx) {
        let package = r.packages.at(&cx, p);
        out = out.push_static("package ").push_usize(package.id).push_static(" ").push_bytes(&cx, package.name.copy(&cx)).push_static("\n");
        out = out.push_static("  source_root ").push_bytes(&cx, package.source_root.copy(&cx)).push_static("\n");
        out = match package.entry.copy(&cx) {
            Option::Some(e) => out.push_static("  entry ").push_bytes(&cx, e.join(&cx, "::")).push_static("\n"),
            Option::None => out.push_static("  entry _\n"),
        };
        out = match package.entry_decl.copy(&cx) {
            Option::Some(d) => out.push_static("  entry_decl ").push_bytes(&cx, decl_text(&cx, d)).push_static("\n"),
            Option::None => out.push_static("  entry_decl _\n"),
        };
        let aliases = package.deps.keys(&cx);
        var i = 0usize;
        while i < aliases.len(&cx) {
            out = out.push_static("  dep ").push_bytes(&cx, aliases.at(&cx, i)).push_static(" ").push_usize(package.deps.at(&cx, aliases.at(&cx, i))).push_static("\n");
            i = i + 1usize;
        }
        let modules = package.files.keys(&cx);
        i = 0usize;
        while i < modules.len(&cx) {
            out = out.push_static("  file ").push_bytes(&cx, module_text(&cx, modules.at(&cx, i))).push_static(" ").push_bytes(&cx, package.files.at(&cx, modules.at(&cx, i))).push_static("\n");
            i = i + 1usize;
        }
        p = p + 1usize;
    }
    let scopes = r.scopes.values(&cx);
    var s = 0usize;
    while s < scopes.len(&cx) {
        scope(&cx, &out, scopes.at(&cx, s));
        s = s + 1usize;
    }
    s = 0usize;
    while s < scopes.len(&cx) {
        out = out.push_static("refs ").push_bytes(&cx, module_text(&cx, scopes.at(&cx, s).home)).push_static("\n");
        let w = Walk.{ refs: r.refs };
        let items = scopes.at(&cx, s).items;
        var i = 0usize;
        while i < items.len(&cx) {
            w.item(&cx, &out, items.at(&cx, i));
            i = i + 1usize;
        }
        s = s + 1usize;
    }
    out.save(&cx)
}

forall 'k.
fn scope(&cx: Domain!['k], &out: Buffer!, sc: Scope['k]) {
    out = out.push_static("scope ").push_bytes(&cx, module_text(&cx, sc.home)).push_static("\n");
    let names = sc.decls.keys(&cx);
    var i = 0usize;
    while i < names.len(&cx) {
        out = out.push_static("  decl ").push_bytes(&cx, names.at(&cx, i)).push_static(" ").push_bytes(&cx, decl_text(&cx, sc.decls.at(&cx, names.at(&cx, i)))).push_static("\n");
        i = i + 1usize;
    }
    let aliases = sc.imports.keys(&cx);
    i = 0usize;
    while i < aliases.len(&cx) {
        out = out.push_static("  import ").push_bytes(&cx, aliases.at(&cx, i)).push_static(" ").push_bytes(&cx, sc.imports.at(&cx, aliases.at(&cx, i)).join(&cx, "::")).push_static("\n");
        i = i + 1usize;
    }
    i = 0usize;
    while i < sc.globs.len(&cx) {
        out = out.push_static("  glob ").push_bytes(&cx, sc.globs.at(&cx, i).join(&cx, "::")).push_static("\n");
        i = i + 1usize;
    }
    let exports = sc.exports.keys(&cx);
    exports.sort_by(&cx, |&cx, a, b| a.cmp(&cx, b));
    i = 0usize;
    while i < exports.len(&cx) {
        out = out.push_static("  export ").push_bytes(&cx, exports.at(&cx, i)).push_static("\n");
        i = i + 1usize;
    }
}

// The references of the syntax tree, in field order.
forall 'k.
exposed struct Walk {
    refs: ArenaMap[u32, NameRef['k], 'k],
}

forall 'k.
impl Walk['k] {
    fn note(self, &cx: Domain!['k], &out: Buffer!, id: u32, label: Span['k]) {
        match self.refs.get(&cx, id) {
            Option::Some(r) => {
                out = out.push_static("  ").push_bytes(&cx, label).push_static(" -> ").push_bytes(&cx, ref_text(&cx, r)).push_static("\n");
            },
            Option::None => (),
        }
    }

    fn types(self, &cx: Domain!['k], &out: Buffer!, ts: ArenaVec[Type['k], 'k]) {
        var i = 0usize;
        while i < ts.len(&cx) {
            self.type(&cx, &out, ts.at(&cx, i));
            i = i + 1usize;
        }
    }

    fn opt_type(self, &cx: Domain!['k], &out: Buffer!, t: Option[Type['k]]) {
        let unit = match t {
            Option::Some(v) => self.type(&cx, &out, v),
            Option::None => (),
        };
    }

    fn type(self, &cx: Domain!['k], &out: Buffer!, t: Type['k]) {
        match t {
            Type::Name(n) => {
                self.note(&cx, &out, n.id, Span::from_static(&cx, "TName ").concat(&cx, n.path.join(&cx, "::")));
                self.types(&cx, &out, n.args);
            },
            Type::Ptr(inner) => self.type(&cx, &out, inner.copy(&cx)),
            Type::Tuple(elems) => self.types(&cx, &out, elems),
            Type::Array(elem, length) => {
                self.type(&cx, &out, elem.copy(&cx));
                self.expr(&cx, &out, length.copy(&cx));
            },
            Type::Fn(f) => {
                self.slots(&cx, &out, f.params);
                self.type(&cx, &out, f.ret.copy(&cx));
            },
            Type::Closure(c) => {
                let unit = match c.env {
                    Option::Some(env) => self.type(&cx, &out, env.copy(&cx)),
                    Option::None => (),
                };
                self.slots(&cx, &out, c.params);
                self.type(&cx, &out, c.ret.copy(&cx));
            },
            Type::Exists(brands, body) => self.type(&cx, &out, body.copy(&cx)),
            Type::Foreach(f) => {
                self.type(&cx, &out, f.source.copy(&cx));
                self.type(&cx, &out, f.body.copy(&cx));
            },
            _ => (),
        }
    }

    fn slots(self, &cx: Domain!['k], &out: Buffer!, ss: ArenaVec[S::Slot['k], 'k]) {
        var i = 0usize;
        while i < ss.len(&cx) {
            self.type(&cx, &out, ss.at(&cx, i).type);
            i = i + 1usize;
        }
    }

    fn exprs(self, &cx: Domain!['k], &out: Buffer!, es: ArenaVec[Expr['k], 'k]) {
        var i = 0usize;
        while i < es.len(&cx) {
            self.expr(&cx, &out, es.at(&cx, i));
            i = i + 1usize;
        }
    }

    fn path(self, &cx: Domain!['k], &out: Buffer!, p: S::Path['k]) {
        self.note(&cx, &out, p.id, Span::from_static(&cx, "Path ").concat(&cx, p.names(&cx).join(&cx, "::")));
        var i = 0usize;
        while i < p.segments.len(&cx) {
            self.types(&cx, &out, p.segments.at(&cx, i).args);
            i = i + 1usize;
        }
    }

    fn block(self, &cx: Domain!['k], &out: Buffer!, b: S::Block['k]) {
        var i = 0usize;
        while i < b.stmts.len(&cx) {
            self.statement(&cx, &out, b.stmts.at(&cx, i));
            i = i + 1usize;
        }
        let unit = match b.tail {
            Option::Some(t) => self.expr(&cx, &out, t.copy(&cx)),
            Option::None => (),
        };
    }

    fn expr(self, &cx: Domain!['k], &out: Buffer!, e: Expr['k]) {
        match e {
            Expr::FStr(f) => {
                var i = 0usize;
                while i < f.parts.len(&cx) {
                    let unit = match f.parts.at(&cx, i) {
                        S::Piece::Expr(x) => self.expr(&cx, &out, x),
                        S::Piece::Text(t) => (),
                    };
                    i = i + 1usize;
                }
            },
            Expr::Path(p) => self.path(&cx, &out, p),
            Expr::Tuple(n) => self.exprs(&cx, &out, n.value),
            Expr::Array(a) => self.exprs(&cx, &out, a.elems),
            Expr::StructLit(s) => {
                self.path(&cx, &out, s.path);
                var i = 0usize;
                while i < s.fields.len(&cx) {
                    let unit = match s.fields.at(&cx, i).value {
                        Option::Some(v) => self.expr(&cx, &out, v),
                        Option::None => (),
                    };
                    i = i + 1usize;
                }
            },
            Expr::Block(b) => self.block(&cx, &out, b),
            Expr::If(n) => {
                self.expr(&cx, &out, n.cond.copy(&cx));
                self.block(&cx, &out, n.then);
                let unit = match n.other {
                    Option::Some(o) => self.expr(&cx, &out, o.copy(&cx)),
                    Option::None => (),
                };
            },
            Expr::Match(m) => {
                self.expr(&cx, &out, m.scrutinee.copy(&cx));
                var i = 0usize;
                while i < m.arms.len(&cx) {
                    let arm = m.arms.at(&cx, i);
                    var k = 0usize;
                    while k < arm.cases.len(&cx) {
                        let unit = match arm.cases.at(&cx, k).path {
                            Option::Some(p) => self.path(&cx, &out, p),
                            Option::None => (),
                        };
                        k = k + 1usize;
                    }
                    self.expr(&cx, &out, arm.body);
                    i = i + 1usize;
                }
            },
            Expr::Closure(c) => {
                var i = 0usize;
                while i < c.params.len(&cx) {
                    self.opt_type(&cx, &out, c.params.at(&cx, i).type);
                    i = i + 1usize;
                }
                self.opt_type(&cx, &out, c.ret);
                self.expr(&cx, &out, c.body.copy(&cx));
            },
            Expr::Return(n) => {
                let unit = match n.value {
                    Option::Some(v) => self.expr(&cx, &out, v.copy(&cx)),
                    Option::None => (),
                };
            },
            Expr::Pack(p) => self.expr(&cx, &out, p.value.copy(&cx)),
            Expr::Foreach(f) => {
                self.expr(&cx, &out, f.source.copy(&cx));
                self.block(&cx, &out, f.body);
            },
            Expr::Binop(b) => {
                self.expr(&cx, &out, b.left.copy(&cx));
                self.expr(&cx, &out, b.right.copy(&cx));
            },
            Expr::Unary(u) => self.expr(&cx, &out, u.operand.copy(&cx)),
            Expr::Cast(c) => {
                self.expr(&cx, &out, c.value.copy(&cx));
                self.type(&cx, &out, c.type);
            },
            Expr::UnsafeStore(s) => {
                self.expr(&cx, &out, s.pointer.copy(&cx));
                self.expr(&cx, &out, s.value.copy(&cx));
            },
            Expr::Field(f) => self.expr(&cx, &out, f.value.copy(&cx)),
            Expr::Index(x) => self.expr(&cx, &out, x.value.copy(&cx)),
            Expr::Call(c) => {
                self.expr(&cx, &out, c.callee.copy(&cx));
                self.exprs(&cx, &out, c.args);
            },
            Expr::Try(n) => self.expr(&cx, &out, n.value.copy(&cx)),
            Expr::While(w) => {
                self.expr(&cx, &out, w.cond.copy(&cx));
                self.block(&cx, &out, w.body);
            },
            Expr::For(f) => {
                self.expr(&cx, &out, f.iterator.copy(&cx));
                self.block(&cx, &out, f.body);
            },
            Expr::Lit(l) => (),
        }
    }

    fn statement(self, &cx: Domain!['k], &out: Buffer!, s: Statement['k]) {
        match s {
            Statement::Let(l) => {
                self.opt_type(&cx, &out, l.type);
                self.expr(&cx, &out, l.value);
            },
            Statement::Var(v) => {
                self.opt_type(&cx, &out, v.type);
                self.expr(&cx, &out, v.value);
            },
            Statement::Assign(a) => {
                self.expr(&cx, &out, a.target);
                self.expr(&cx, &out, a.value);
            },
            Statement::Expr(n) => self.expr(&cx, &out, n.value),
            Statement::Const(c) => self.const_decl(&cx, &out, c),
        }
    }

    fn quantifier(self, &cx: Domain!['k], &out: Buffer!, q: Option[S::Forall['k]]) {
        let unit = match q {
            Option::Some(f) => {
                var i = 0usize;
                while i < f.premises.len(&cx) {
                    let args = f.premises.at(&cx, i).args;
                    self.note(&cx, &out, args.id, Span::from_static(&cx, "TypeArgs"));
                    self.types(&cx, &out, args.args);
                    i = i + 1usize;
                }
            },
            Option::None => (),
        };
    }

    fn params(self, &cx: Domain!['k], &out: Buffer!, ps: ArenaVec[S::Param['k], 'k]) {
        var i = 0usize;
        while i < ps.len(&cx) {
            self.opt_type(&cx, &out, ps.at(&cx, i).type);
            i = i + 1usize;
        }
    }

    fn function(self, &cx: Domain!['k], &out: Buffer!, f: S::Fn['k]) {
        self.params(&cx, &out, f.params);
        self.opt_type(&cx, &out, f.ret);
        let unit = match f.body {
            Option::Some(b) => self.block(&cx, &out, b),
            Option::None => (),
        };
        self.quantifier(&cx, &out, f.quantifier);
    }

    fn const_decl(self, &cx: Domain!['k], &out: Buffer!, c: S::Const['k]) {
        self.type(&cx, &out, c.type);
        self.expr(&cx, &out, c.value);
        self.quantifier(&cx, &out, c.quantifier);
    }

    fn item(self, &cx: Domain!['k], &out: Buffer!, it: S::Item['k]) {
        match it {
            S::Item::Use(u) => self.quantifier(&cx, &out, u.quantifier),
            S::Item::Module(m) => (),
            S::Item::Struct(s) => {
                var i = 0usize;
                while i < s.fields.len(&cx) {
                    self.type(&cx, &out, s.fields.at(&cx, i).type);
                    i = i + 1usize;
                }
                self.quantifier(&cx, &out, s.quantifier);
            },
            S::Item::Tuple(t) => {
                self.types(&cx, &out, t.elems);
                self.quantifier(&cx, &out, t.quantifier);
            },
            S::Item::Enum(e) => {
                var i = 0usize;
                while i < e.variants.len(&cx) {
                    self.types(&cx, &out, e.variants.at(&cx, i).payload);
                    i = i + 1usize;
                }
                self.quantifier(&cx, &out, e.quantifier);
            },
            S::Item::Fn(f) => self.function(&cx, &out, f),
            S::Item::Extern(x) => {
                self.params(&cx, &out, x.params);
                self.opt_type(&cx, &out, x.ret);
                self.quantifier(&cx, &out, x.quantifier);
            },
            S::Item::Const(c) => self.const_decl(&cx, &out, c),
            S::Item::Impl(m) => {
                self.type(&cx, &out, m.type);
                var i = 0usize;
                while i < m.items.len(&cx) {
                    let unit = match m.items.at(&cx, i) {
                        S::Member::Fn(f) => self.function(&cx, &out, f),
                        S::Member::Const(c) => self.const_decl(&cx, &out, c),
                    };
                    i = i + 1usize;
                }
                self.quantifier(&cx, &out, m.quantifier);
            },
            S::Item::Trait(t) => {
                var i = 0usize;
                while i < t.methods.len(&cx) {
                    self.function(&cx, &out, t.methods.at(&cx, i));
                    i = i + 1usize;
                }
                self.quantifier(&cx, &out, t.quantifier);
            },
            S::Item::Instance(n) => {
                self.type(&cx, &out, n.type);
                var i = 0usize;
                while i < n.methods.len(&cx) {
                    self.function(&cx, &out, n.methods.at(&cx, i));
                    i = i + 1usize;
                }
                self.quantifier(&cx, &out, n.quantifier);
            },
        }
    }
}
