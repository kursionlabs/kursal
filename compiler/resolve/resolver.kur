// Packages and names: load the package graph, assign each source file its module, and resolve
// every type and value path to what it names.
//
// What a path names is kept in `Resolver.refs`, keyed by the id of the node that spells it: a
// type name (`TName`), an expression or case path (`Path`), or a premise's type arguments
// (`TypeArgs`, naming the premise's trait).
//   NameRef::Decl(d)               a declaration (struct, enum, tuple, fn, extern, trait, const, method)
//   NameRef::Variant(d, name)      an enum variant
//   NameRef::TraitMethod(d, name)  a trait's method, `Trait::method`
//   NameRef::Assoc(param, name)    a member of a type parameter, found by inference
//   NameRef::Param(name)           a type parameter in scope
//   NameRef::Local(name)           a local value
//   NameRef::Prim(name)            a primitive type
//   NameRef::Builtin(name)         a name the compiler gives meaning: `Copy`, `Exposed`, `Never`, and
//                                  what `builtin::name` names in package core (`Brand`, `fresh`, ...)

use package::support::base::fail;
use std::hash::key_eq;
use std::collections::arena_vec::ArenaVec;
use std::collections::arena_map::{ArenaMap, ArenaSet};
use std::mem::Ref;
use std::raw::Span;
use std::arena::Domain!;
use std::buffer::Buffer!;
use package::kurs::core::ModuleId;
use package::syntax::parser::parse;
use package::syntax::ast as S;
use package::syntax::ast::{Expr, Pattern, Pos, Statement, Type, no_pos};
use std::env::variable;
use std::fs::{canonicalize, path_exists, read_dir, read_to_arena};
use std::cmp::Order;
use std::hash::{HashIn, HashState};
use std::option::{Option, Result};
use std::slice::{Slice, hash_bytes};
use toml::parser::parse as parse_toml;
use toml::value::{TomlValue, line_column};

// Whether `name` is one of the space-separated `names`.
forall 'k.
fn among(&cx: Domain!['k], name: Span['k], names: Slice[u8, 'static]) -> bool {
    Span::from_static(&cx, names).split(&cx, Span::from_static(&cx, " ")).contains(&cx, name)
}

forall 'k.
fn is_prim(&cx: Domain!['k], name: Span['k]) -> bool {
    among(&cx, name, "i8 i16 i32 i64 isize u8 u16 u32 u64 usize f32 f64 bool")
}

// Always in scope, like the primitives: the type `Never` and the traits.
forall 'k.
fn is_builtin_trait(&cx: Domain!['k], name: Span['k]) -> bool {
    among(&cx, name, "Copy Exposed")
}

// What `builtin::name` names. Only package `core` writes such a path, and it exports each builtin
// from the module it belongs to (`export builtin::NonNull;` in core::ptr); everyone else imports it
// from there.
forall 'k.
fn is_builtin_type(&cx: Domain!['k], name: Span['k]) -> bool {
    among(&cx, name, "Brand NonNull")
}

forall 'k.
fn is_builtin_value(&cx: Domain!['k], name: Span['k]) -> bool {
    among(&cx, name, "fresh static_brand sizeof alloca enum_variant fence load_volatile store_volatile trap")
}

// The builtin types an impl may give methods, as it may a primitive: `impl NonNull[T]` in core::ptr.
forall 'k.
fn is_owned_builtin(&cx: Domain!['k], name: Span['k]) -> bool {
    name.is(&cx, "NonNull")
}

// The standard library's directory: `$KURSAL_LIB`, else `lib` beside the directory that holds the
// compiler's binary (an installation's `bin/kursal` and `lib/`).
forall 'k.
fn lib_dir(&cx: Domain!['k]) -> Span['k] {
    let configured = match variable(&cx, Span::from_static(&cx, "KURSAL_LIB")) {
        Option::Some(v) => v.save(&cx),
        Option::None => Span::from_static(&cx, ""),
    };
    if !configured.is_empty() {
        clean(&cx, configured)
    } else {
        match real_path(&cx, Span::from_static(&cx, "/proc/self/exe")) {
            Option::Some(exe) => join(&cx, parent(&cx, parent(&cx, exe)), Span::from_static(&cx, "lib")),
            Option::None => fail(&cx, Span::from_static(&cx, "set KURSAL_LIB to the standard library's directory")),
        }
    }
}

// ------------------------------------------------------------------ paths --

// `path` as Python's `Path` spells it: no repeated, trailing or `.` separators.
forall 'k.
fn clean(&cx: Domain!['k], path: Span['k]) -> Span['k] {
    let parts = path.split(&cx, Span::from_static(&cx, "/"));
    var out = Buffer!::new();
    if path.starts_with(&cx, Span::from_static(&cx, "/")) {
        out = out.push_static("/");
    }
    var first = true;
    var i = 0usize;
    while i < parts.len(&cx) {
        let part = parts.at(&cx, i);
        if !part.is_empty() && !part.is(&cx, ".") {
            if !first {
                out = out.push_static("/");
            }
            out = out.push_bytes(&cx, part);
            first = false;
        }
        i = i + 1usize;
    }
    let n = &out.len();
    if n == 0usize {
        out.destroy();
        Span::from_static(&cx, ".")
    } else {
        out.save(&cx)
    }
}

// `a / b`: `b` when it is absolute.
forall 'k.
fn join(&cx: Domain!['k], a: Span['k], b: Span['k]) -> Span['k] {
    if b.starts_with(&cx, Span::from_static(&cx, "/")) || a.is_empty() || a.is(&cx, ".") {
        b
    } else if a.ends_with(&cx, Span::from_static(&cx, "/")) {
        a.concat(&cx, b)
    } else {
        Buffer!::new().push_bytes(&cx, a).push_static("/").push_bytes(&cx, b).save(&cx)
    }
}

forall 'k.
fn parent(&cx: Domain!['k], path: Span['k]) -> Span['k] {
    match path.rfind_byte(&cx, b'/') {
        Option::Some(at) => if at == 0usize { Span::from_static(&cx, "/") } else { path.slice(0usize, at) },
        Option::None => Span::from_static(&cx, "."),
    }
}

// The last component.
forall 'k.
fn base_name(&cx: Domain!['k], path: Span['k]) -> Span['k] {
    match path.rfind_byte(&cx, b'/') {
        Option::Some(at) => path.skip(at + 1usize),
        Option::None => path,
    }
}

// The last component's extension, with its dot: `Path.suffix`.
forall 'k.
fn suffix(&cx: Domain!['k], path: Span['k]) -> Span['k] {
    let name = base_name(&cx, path);
    match name.rfind_byte(&cx, b'.') {
        Option::Some(at) => if at > 0usize && at + 1usize < name.len() { name.skip(at) } else { Span::from_static(&cx, "") },
        Option::None => Span::from_static(&cx, ""),
    }
}

// The last component without its extension: `Path.stem`.
forall 'k.
fn stem(&cx: Domain!['k], path: Span['k]) -> Span['k] {
    let name = base_name(&cx, path);
    name.slice(0usize, name.len() - suffix(&cx, name).len())
}

// The absolute path with no symbolic links that `path` names, if it exists.
forall 'k.
fn real_path(&cx: Domain!['k], path: Span['k]) -> Option[Span['k]] {
    match canonicalize(&cx, path) {
        Result::Ok(r) => Option::Some.(r.save(&cx)),
        Result::Err(e) => Option::None,
    }
}

// The absolute path with no symbolic links that `path` names, existing or not: `Path.resolve()`.
// The longest existing prefix has its links resolved; the rest is appended, with `..` removing the
// component before it.
forall 'k.
fn resolved(&cx: Domain!['k], path: Span['k]) -> Span['k] {
    if path.starts_with(&cx, Span::from_static(&cx, "/")) {
        resolve_absolute(&cx, path)
    } else {
        let cwd = match real_path(&cx, Span::from_static(&cx, ".")) {
            Option::Some(c) => c,
            Option::None => fail(&cx, Span::from_static(&cx, "cannot find the current directory")),
        };
        resolve_absolute(&cx, join(&cx, cwd, path))
    }
}

forall 'k.
fn resolve_absolute(&cx: Domain!['k], path: Span['k]) -> Span['k] {
    match real_path(&cx, path) {
        Option::Some(r) => r,
        Option::None => {
            if path.is(&cx, "/") {
                path
            } else {
                let base = resolve_absolute(&cx, parent(&cx, path));
                let name = base_name(&cx, path);
                if name.is_empty() || name.is(&cx, ".") {
                    base
                } else if name.is(&cx, "..") {
                    parent(&cx, base)
                } else {
                    let joined = join(&cx, base, name);
                    match real_path(&cx, joined) {
                        Option::Some(r) => r,
                        Option::None => joined,
                    }
                }
            }
        },
    }
}

// ------------------------------------------------------------- messages --

// `names` as a message lists them: `a`, `a and b`, `a, b and c`.
forall 'k.
fn listed(&cx: Domain!['k], names: ArenaVec[Span['k], 'k]) -> Span['k] {
    var out = Buffer!::new();
    var i = 0usize;
    while i < names.len(&cx) {
        if i > 0usize {
            out = out.push_static(if i + 1usize == names.len(&cx) { " and " } else { ", " });
        }
        out = out.push_bytes(&cx, names.at(&cx, i));
        i = i + 1usize;
    }
    out.save(&cx)
}

// ------------------------------------------------------------ the graph --

// A declaration: compared by its `id`, unique in the program.
forall 'k.
exposed struct Decl {
    id: u32,
    // struct enum tuple fn extern trait const method
    kind: Span['k],
    home: ModuleId['k],
    // a method's name is `Target::method`
    name: Span['k],
    node: Named['k],
    // a method's or associated const's impl
    impl_block: Option[S::Impl['k]],
}

forall 'k.
instance HashIn[Decl['k], Domain!['k]] {
    fn hash_in(&cx: Domain!['k], key: Decl['k], state: HashState) -> HashState {
        state.write_u64(key.id as u64)
    }

    fn eq_in(&cx: Domain!['k], a: Decl['k], b: Decl['k]) -> bool {
        let equal = a.id == b.id;
        equal
    }
}

// The item a declaration declares.
forall 'k.
exposed enum Named {
    Struct(S::StructDecl['k]),
    Enum(S::EnumDecl['k]),
    Tuple(S::TupleDecl['k]),
    Fn(S::Fn['k]),
    Extern(S::Extern['k]),
    Trait(S::TraitDecl['k]),
    Const(S::Const['k]),
}

forall 'k.
fn named_pos(n: Named['k]) -> Pos {
    match n {
        Named::Struct(x) => x.pos,
        Named::Enum(x) => x.pos,
        Named::Tuple(x) => x.pos,
        Named::Fn(x) => x.pos,
        Named::Extern(x) => x.pos,
        Named::Trait(x) => x.pos,
        Named::Const(x) => x.pos,
    }
}

// Where a declaration writes its name: a type declaration's name, else where it starts.
forall 'k.
fn name_pos(n: Named['k]) -> Pos {
    match n {
        Named::Struct(x) => x.name_pos,
        Named::Enum(x) => x.name_pos,
        Named::Tuple(x) => x.name_pos,
        _ => named_pos(n),
    }
}

forall 'k.
fn item_pos(item: S::Item['k]) -> Pos {
    match item {
        S::Item::Use(x) => x.pos,
        S::Item::Module(x) => x.pos,
        S::Item::Struct(x) => x.pos,
        S::Item::Tuple(x) => x.pos,
        S::Item::Enum(x) => x.pos,
        S::Item::Fn(x) => x.pos,
        S::Item::Extern(x) => x.pos,
        S::Item::Const(x) => x.pos,
        S::Item::Impl(x) => x.pos,
        S::Item::Trait(x) => x.pos,
        S::Item::Instance(x) => x.pos,
    }
}

forall 'k.
exposed struct Package {
    id: usize,
    name: Ref[Span['k], 'k],
    // its directory
    root: Span['k],
    source_root: Ref[Span['k], 'k],
    // alias -> package id
    deps: ArenaMap[Span['k], usize, 'k],
    // C compiler arguments, after source files; a build uses these from every package.
    link_flags: ArenaVec[Span['k], 'k],
    // Absolute paths to C sources declared relative to this package.
    c_sources: ArenaVec[Span['k], 'k],
    // an executable's entry path
    entry: Ref[Option[ArenaVec[Span['k], 'k]], 'k],
    // module -> source path
    files: ArenaMap[ModuleId['k], Span['k], 'k],
    entry_decl: Ref[Option[Decl['k]], 'k],
    // its kur.toml, or its one .kur file
    manifest: Span['k],
}

// One module's namespace.
forall 'k.
exposed struct Scope {
    home: ModuleId['k],
    decls: ArenaMap[Span['k], Decl['k], 'k],
    // alias -> path
    imports: ArenaMap[Span['k], ArenaVec[Span['k], 'k], 'k],
    // alias -> where its `use` names it
    import_pos: ArenaMap[Span['k], Pos, 'k],
    globs: ArenaVec[ArenaVec[Span['k], 'k], 'k],
    exports: ArenaSet[Span['k], 'k],
    items: ArenaVec[S::Item['k], 'k],
}

// What a path names.
forall 'k.
exposed enum Target {
    Decl(Decl['k]),
    Module(ModuleId['k]),
    Variant(Decl['k], Span['k]),
    TraitMethod(Decl['k], Span['k]),
    Builtin(Span['k]),
}

// What a resolved node names; see the top of this file.
forall 'k.
exposed enum NameRef {
    Decl(Decl['k]),
    Variant(Decl['k], Span['k]),
    TraitMethod(Decl['k], Span['k]),
    Assoc(Span['k], Span['k]),
    Param(Span['k]),
    Prim(Span['k]),
    Builtin(Span['k]),
    Local(Span['k]),
}

// A name's other spelling: without the `!` of a linear type's name, or with it.
forall 'k.
fn other_spelling(&cx: Domain!['k], name: Span['k]) -> Span['k] {
    if name.ends_with(&cx, Span::from_static(&cx, "!")) {
        name.slice(0usize, name.len() - 1usize)
    } else {
        name.concat(&cx, Span::from_static(&cx, "!"))
    }
}

// The end of the message for a name that names nothing, when its other spelling `other` names
// something.
forall 'k.
fn respelled(&cx: Domain!['k], out: Buffer!, other: Span['k]) -> Buffer! {
    if other.ends_with(&cx, Span::from_static(&cx, "!")) {
        out.push_static("; the linear type is ").push_bytes(&cx, other)
    } else {
        out.push_static("; ").push_bytes(&cx, other).push_static(" is not a linear type")
    }
}

// A resolution error, before its file is known; a `pos` on line 0 is no position.
forall 'k.
exposed struct Problem {
    message: Span['k],
    pos: Pos,
}

// What a method or associated const is attached to: a type declaration, a primitive type or a
// builtin type (`NonNull`), by name, or nothing, for a blanket impl whose methods are found by method
// calls only.
forall 'k.
exposed enum Owner {
    Decl(Decl['k]),
    Prim(Span['k]),
    Blanket,
}

forall 'k.
instance HashIn[Owner['k], Domain!['k]] {
    fn hash_in(&cx: Domain!['k], key: Owner['k], state: HashState) -> HashState {
        match key {
            Owner::Decl(d) => state.write_u64(1u64).write_u64(d.id as u64),
            Owner::Prim(name) => hash_bytes(&cx, name, state.write_u64(2u64)),
            Owner::Blanket => state.write_u64(3u64),
        }
    }

    fn eq_in(&cx: Domain!['k], a: Owner['k], b: Owner['k]) -> bool {
        let equal = {
            match a {
                Owner::Decl(x) => match b {
                    Owner::Decl(y) => x.id == y.id,
                    _ => false,
                },
                Owner::Prim(x) => match b {
                    Owner::Prim(y) => x.eq(&cx, y),
                    _ => false,
                },
                Owner::Blanket => match b {
                    Owner::Blanket => true,
                    _ => false,
                },
            }
        };
        equal
    }
}

// A file and a position errors inside it are reported at when they have none of their own, and
// where its errors sort (`Reported.rank`).
forall 'k.
exposed struct Location {
    file: Span['k],
    pos: Pos,
    rank: usize,
}

// A resolution error as printed, and where it sorts in source order: by its `rank`, 0 for a
// manifest's and 1 more than its module's place among the modules for a source file's, then by its
// position, then in the order it was found.
forall 'k.
exposed struct Reported {
    text: Span['k],
    rank: usize,
    line: u32,
    col: u32,
    seq: usize,
}

// Resolution, and then signatures, report at most this many errors, in source order, and how many
// more they found.
const ERROR_LIMIT: usize = 20;

forall 'k.
fn source_order(a: Reported['k], b: Reported['k]) -> Order {
    if a.rank != b.rank {
        if a.rank < b.rank { Order::Less } else { Order::Greater }
    } else if a.line != b.line {
        if a.line < b.line { Order::Less } else { Order::Greater }
    } else if a.col != b.col {
        if a.col < b.col { Order::Less } else { Order::Greater }
    } else if a.seq < b.seq {
        Order::Less
    } else if a.seq > b.seq {
        Order::Greater
    } else {
        Order::Equal
    }
}

// An error as `KursError` prints it: `line:col: message`, or the message alone.
forall 'k.
fn error_text(&cx: Domain!['k], message: Span['k], pos: Pos) -> Span['k] {
    if pos.line == 0u32 {
        message
    } else {
        Buffer!::new().push_u64(pos.line as u64).push_static(":").push_u64(pos.col as u64).push_static(": ").push_bytes(&cx, message).save(&cx)
    }
}

// The error `message` at `pos`, printed as `full`, naming `file` and, when it has no position of
// its own, the position `at` of the item it is in. Returns the new printed form and position.
forall 'k.
fn located(&cx: Domain!['k], full: Span['k], message: Span['k], pos: Pos, file: Span['k], at: Pos) -> (Span['k], Pos) {
    if full.starts_with(&cx, file) {
        (full, pos)
    } else {
        let at_pos = if pos.line != 0u32 { pos } else { at };
        let prefix = if at_pos.line != 0u32 {
            Buffer!::new().push_bytes(&cx, file).push_static(":").push_u64(at_pos.line as u64).push_static(":").push_u64(at_pos.col as u64).save(&cx)
        } else {
            file
        };
        (Buffer!::new().push_bytes(&cx, prefix).push_static(": ").push_bytes(&cx, message).save(&cx), at_pos)
    }
}

// The package graph rooted at a package directory, its kur.toml, or one .kur file. A single file
// depends on the standard library `std` when one is installed (KURSAL_LIB). `ids` numbers the
// syntax nodes.
forall 'k.
fn load(&cx: Domain!['k], path: Span['k], ids: Ref[u32, 'k]) -> ArenaVec[Package['k], 'k] {
    let path = resolved(&cx, path);
    let packages: ArenaVec[Package['k], 'k] = ArenaVec::new(&cx);
    let by_dir: ArenaMap[Span['k], usize, 'k] = ArenaMap::new(&cx);
    if suffix(&cx, path).is(&cx, ".kur") {
        let items = parse(&cx, read_source(&cx, path), path, ids);
        var main = false;
        var i = 0usize;
        while i < items.len(&cx) {
            let unit = match items.at(&cx, i) {
                S::Item::Fn(f) => {
                    if f.name.is(&cx, "main") {
                        main = true;
                    }
                },
                _ => (),
            };
            i = i + 1usize;
        }
        let std: ArenaMap[Span['k], Span['k], 'k] = ArenaMap::new(&cx);
        let lib = lib_dir(&cx);
        if exists_or_fail(&cx, join(&cx, join(&cx, lib, Span::from_static(&cx, "std")), Span::from_static(&cx, "kur.toml"))) {
            std.insert(&cx, Span::from_static(&cx, "std"), join(&cx, lib, Span::from_static(&cx, "std")));
        }
        let entry = if main { Option::Some.(ArenaVec::one(&cx, Span::from_static(&cx, "main"))) } else { Option::None };
        let unit = add(&cx, packages, by_dir, path, Option::Some.(stem(&cx, path)), Option::Some.(parent(&cx, path)), Option::Some.(std), entry);
        packages.at(&cx, 0usize).files.insert(&cx, ModuleId::root(&cx, 0usize), path);
    } else {
        let manifest = if suffix(&cx, path).is(&cx, ".toml") { path } else { join(&cx, path, Span::from_static(&cx, "kur.toml")) };
        let unit = add(&cx, packages, by_dir, manifest, Option::None, Option::None, Option::None, Option::None);
    }
    var p = 0usize;
    while p < packages.len(&cx) {
        let package = packages.at(&cx, p);
        if package.files.is_empty(&cx) {
            let found = discover(&cx, package);
            let modules = found.keys(&cx);
            var k = 0usize;
            while k < modules.len(&cx) {
                package.files.insert(&cx, modules.at(&cx, k), found.at(&cx, modules.at(&cx, k)));
                k = k + 1usize;
            }
            if !package.files.contains(&cx, ModuleId::root(&cx, package.id)) {
                fail(&cx, Buffer!::new().push_static("package ").push_bytes(&cx, package.name.copy(&cx)).push_static(" has no lib.kur in ").push_bytes(&cx, package.source_root.copy(&cx)).save(&cx));
            }
        }
        p = p + 1usize;
    }
    check_acyclic(&cx, packages);
    packages
}

forall 'k.
fn read_source(&cx: Domain!['k], path: Span['k]) -> Span['k] {
    match read_to_arena(&cx, path) {
        Result::Ok(s) => s,
        Result::Err(e) => fail(&cx, Buffer!::new().push_static("cannot read ").push_bytes(&cx, path).save(&cx)),
    }
}

// The package of `manifest` (a kur.toml, or a single .kur file), added with its dependencies
// unless its directory's manifest was added already.
forall 'k.
fn add(&cx: Domain!['k], packages: ArenaVec[Package['k], 'k], by_dir: ArenaMap[Span['k], usize, 'k], manifest: Span['k], name: Option[Span['k]], source_root: Option[Span['k]],
       deps: Option[ArenaMap[Span['k], Span['k], 'k]], entry: Option[ArenaVec[Span['k], 'k]]) -> usize {
    let root = parent(&cx, manifest);
    let is_toml = suffix(&cx, manifest).is(&cx, ".toml");
    if is_toml {
        let unit = match by_dir.get(&cx, root) {
            Option::Some(id) => return id,
            Option::None => (),
        };
    }
    let package = Package.{
        id: packages.len(&cx),
        name: Ref::new(&cx, match name { Option::Some(n) => n, Option::None => base_name(&cx, root) }),
        root,
        source_root: Ref::new(&cx, match source_root { Option::Some(s) => s, Option::None => root }),
        deps: ArenaMap::new(&cx),
        link_flags: ArenaVec::new(&cx),
        c_sources: ArenaVec::new(&cx),
        entry: Ref::new(&cx, entry),
        files: ArenaMap::new(&cx),
        entry_decl: Ref::new(&cx, Option::None),
        manifest,
    };
    packages.push(&cx, package);
    var deps: ArenaMap[Span['k], Span['k], 'k] = match deps {
        Option::Some(d) => d,
        Option::None => ArenaMap::new(&cx),
    };
    if is_toml {
        by_dir.insert(&cx, root, package.id);
        let config = manifest_table(&cx, manifest);
        let info = table(&cx, config.get_or(&cx, Span::from_static(&cx, "package"), TomlValue::Table.(ArenaMap::new(&cx))), in_manifest(&cx, manifest, Span::from_static(&cx, "package")));
        let unknown: ArenaSet[Span['k], 'k] = ArenaSet::new(&cx);
        let config_keys = config.keys(&cx);
        var i = 0usize;
        while i < config_keys.len(&cx) {
            let key = config_keys.at(&cx, i);
            if !key.is(&cx, "package") && !key.is(&cx, "dependencies") {
                unknown.insert(&cx, key);
            }
            i = i + 1usize;
        }
        let info_keys = info.keys(&cx);
        i = 0usize;
        while i < info_keys.len(&cx) {
            let key = info_keys.at(&cx, i);
            if !among(&cx, key, "name kind source_root entry link_flags c_sources") {
                unknown.insert(&cx, key);
            }
            i = i + 1usize;
        }
        if unknown.len(&cx) > 0usize {
            let names = unknown.keys(&cx);
            names.sort_by(&cx, |&cx, a, b| a.cmp(&cx, b));
            fail(&cx, Buffer!::new().push_bytes(&cx, manifest).push_static(if names.len(&cx) > 1usize { ": unknown manifest keys " } else { ": unknown manifest key " })
                .push_bytes(&cx, listed(&cx, names)).save(&cx));
        }
        package.name.set(&cx, string(&cx, info, manifest, "name", Option::None));
        package.source_root.set(&cx, resolved(&cx, join(&cx, root, string(&cx, info, manifest, "source_root", Option::Some.(Span::from_static(&cx, "src"))))));
        let flags = strings(&cx, info, manifest, "link_flags");
        var f = 0usize;
        while f < flags.len(&cx) {
            package.link_flags.push(&cx, flags.at(&cx, f));
            f = f + 1usize;
        }
        let sources = strings(&cx, info, manifest, "c_sources");
        f = 0usize;
        while f < sources.len(&cx) {
            package.c_sources.push(&cx, resolved(&cx, join(&cx, root, sources.at(&cx, f))));
            f = f + 1usize;
        }
        let kind = string(&cx, info, manifest, "kind", Option::Some.(Span::from_static(&cx, "library")));
        if !kind.is(&cx, "library") && !kind.is(&cx, "executable") {
            fail(&cx, Buffer!::new().push_bytes(&cx, manifest).push_static(": manifest kind must be \"library\" or \"executable\"").save(&cx));
        }
        if kind.is(&cx, "executable") {
            let parts = string(&cx, info, manifest, "entry", Option::None).split(&cx, Span::from_static(&cx, "::"));
            let path: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
            var k = 0usize;
            while k < parts.len(&cx) {
                if !parts.at(&cx, k).is(&cx, "package") {
                    path.push(&cx, parts.at(&cx, k));
                }
                k = k + 1usize;
            }
            package.entry.set(&cx, Option::Some.(path));
        }
        deps = ArenaMap::new(&cx);
        let specs = table(&cx, config.get_or(&cx, Span::from_static(&cx, "dependencies"), TomlValue::Table.(ArenaMap::new(&cx))), in_manifest(&cx, manifest, Span::from_static(&cx, "dependencies")));
        let aliases = specs.keys(&cx);
        var k = 0usize;
        while k < aliases.len(&cx) {
            let alias = aliases.at(&cx, k);
            deps.insert(&cx, alias, resolved(&cx, join(&cx, root, string(&cx, table(&cx, specs.at(&cx, alias), in_manifest(&cx, manifest, alias)), manifest, "path", Option::None))));
            k = k + 1usize;
        }
    }
    let aliases = deps.keys(&cx);
    var k = 0usize;
    while k < aliases.len(&cx) {
        let target = deps.at(&cx, aliases.at(&cx, k));
        let manifest_path = if suffix(&cx, target).is(&cx, ".toml") { target } else { join(&cx, target, Span::from_static(&cx, "kur.toml")) };
        package.deps.insert(&cx, aliases.at(&cx, k), add(&cx, packages, by_dir, manifest_path, Option::None, Option::None, Option::None, Option::None));
        k = k + 1usize;
    }
    package.id
}

// The table of the manifest at `path`, read by the standard library's `toml`. A manifest that is not
// TOML is an error on the line where reading it stopped.
forall 'k.
fn manifest_table(&cx: Domain!['k], path: Span['k]) -> ArenaMap[Span['k], TomlValue['k], 'k] {
    let source = read_source(&cx, path);
    match parse_toml(&cx, source) {
        Result::Ok(t) => t,
        Result::Err(e) => {
            let (line, column) = line_column(&cx, source, e.offset);
            fail(&cx, Buffer!::new().push_bytes(&cx, path).push_static(":").push_usize(line).push_static(": invalid manifest").save(&cx))
        },
    }
}

forall 'k.
fn table(&cx: Domain!['k], value: TomlValue['k], at_pos: Span['k]) -> ArenaMap[Span['k], TomlValue['k], 'k] {
    match value.as_table() {
        Option::Some(t) => t,
        Option::None => fail(&cx, Buffer!::new().push_bytes(&cx, at_pos).push_static(": expected a table").save(&cx)),
    }
}

// `MANIFEST: where`, for an error in the manifest.
forall 'k.
fn in_manifest(&cx: Domain!['k], manifest: Span['k], at_pos: Span['k]) -> Span['k] {
    Buffer!::new().push_bytes(&cx, manifest).push_static(": ").push_bytes(&cx, at_pos).save(&cx)
}

// The string `t`, a table of `manifest`, holds at `key`, else `default`.
forall 'k.
fn string(&cx: Domain!['k], t: ArenaMap[Span['k], TomlValue['k], 'k], manifest: Span['k], key: Slice[u8, 'static], default: Option[Span['k]]) -> Span['k] {
    let value = match t.get(&cx, Span::from_static(&cx, key)) {
        Option::Some(v) => v.as_string(),
        Option::None => default,
    };
    match value {
        Option::Some(s) => s,
        Option::None => fail(&cx, Buffer!::new().push_bytes(&cx, manifest).push_static(": manifest ").push_static(key).push_static(" must be a string").save(&cx)),
    }
}

// An optional array of command arguments or source paths in a manifest.
forall 'k.
fn strings(&cx: Domain!['k], t: ArenaMap[Span['k], TomlValue['k], 'k], manifest: Span['k], key: Slice[u8, 'static]) -> ArenaVec[Span['k], 'k] {
    let values = match t.get(&cx, Span::from_static(&cx, key)) {
        Option::Some(value) => match value.as_array() {
            Option::Some(items) => items,
            Option::None => fail(&cx, Buffer!::new().push_bytes(&cx, manifest).push_static(": manifest ")
                .push_static(key).push_static(" must be an array of nonempty strings without NUL").save(&cx)),
        },
        Option::None => ArenaVec::new(&cx),
    };
    let out: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
    var i = 0usize;
    while i < values.len(&cx) {
        let value = match values.at(&cx, i).as_string() {
            Option::Some(s) => s,
            Option::None => fail(&cx, Buffer!::new().push_bytes(&cx, manifest).push_static(": manifest ")
                .push_static(key).push_static(" must be an array of nonempty strings without NUL").save(&cx)),
        };
        if value.is_empty() || !value.find_byte(&cx, 0u8, 0usize).is_none() {
            fail(&cx, Buffer!::new().push_bytes(&cx, manifest).push_static(": manifest ")
                .push_static(key).push_static(" must be an array of nonempty strings without NUL").save(&cx));
        }
        out.push(&cx, value);
        i = i + 1usize;
    }
    out
}

// Whether `path` names anything. An error other than its absence stops resolution: the file may be
// there.
forall 'k.
fn exists_or_fail(&cx: Domain!['k], path: Span['k]) -> bool {
    match path_exists(&cx, path) {
        Result::Ok(found) => found,
        Result::Err(e) => fail(&cx, Buffer!::new().push_static("cannot read ").push_bytes(&cx, path).push_static(" (error ")
            .push_i64(e.errno as i64).push_static(")").save(&cx)),
    }
}

// Each .kur file under the source root, by the module its path assigns.
forall 'k.
fn discover(&cx: Domain!['k], package: Package['k]) -> ArenaMap[ModuleId['k], Span['k], 'k] {
    let files: ArenaMap[ModuleId['k], Span['k], 'k] = ArenaMap::new(&cx);
    walk(&cx, package, package.source_root.copy(&cx), ArenaVec::new(&cx), files);
    files
}

// The files of directory `here`, at `rel` under the source root, then its subdirectories in order;
// a subdirectory with its own kur.toml is another package.
forall 'k.
fn walk(&cx: Domain!['k], package: Package['k], here: Span['k], rel: ArenaVec[Span['k], 'k], files: ArenaMap[ModuleId['k], Span['k], 'k]) {
    let dirs: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
    let names: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
    match read_dir(&cx, here) {
        Result::Ok(directory) => {
            var directory = directory;
            // Asked only of a directory that could be listed, as the reference's `os.walk` asks.
            if !rel.is_empty(&cx) && exists_or_fail(&cx, join(&cx, here, Span::from_static(&cx, "kur.toml"))) {
                let closed = directory.close();
                return;
            }
            var going = true;
            while going {
                match &directory.next() {
                    Result::Ok(next) => match next {
                        Option::Some(entry) => {
                            let { name, is_directory } = entry;
                            if is_directory {
                                dirs.push(&cx, name.save(&cx));
                            } else {
                                names.push(&cx, name.save(&cx));
                            }
                        },
                        Option::None => {
                            going = false;
                        },
                    },
                    Result::Err(e) => {
                        going = false;
                    },
                }
            }
            let closed = directory.close();
        },
        Result::Err(e) => (),
    }
    var i = 0usize;
    dirs.sort_by(&cx, |&cx, a, b| a.cmp(&cx, b));
    names.sort_by(&cx, |&cx, a, b| a.cmp(&cx, b));
    i = 0usize;
    while i < names.len(&cx) {
        let name = names.at(&cx, i);
        if name.ends_with(&cx, Span::from_static(&cx, ".kur")) {
            let path = rel.clone(&cx);
            let module_name = stem(&cx, name);
            if !module_name.is(&cx, "lib") {
                path.push(&cx, module_name);
            }
            let home = ModuleId.{ package: package.id, path };
            if files.contains(&cx, home) {
                fail(&cx, Buffer!::new().push_static("two files define module ").push_bytes(&cx, path.join(&cx, "::")).push_static(" of ").push_bytes(&cx, package.name.copy(&cx)).save(&cx));
            }
            files.insert(&cx, home, join(&cx, here, name));
        }
        i = i + 1usize;
    }
    i = 0usize;
    while i < dirs.len(&cx) {
        let sub = rel.clone(&cx);
        sub.push(&cx, dirs.at(&cx, i));
        walk(&cx, package, join(&cx, here, dirs.at(&cx, i)), sub, files);
        i = i + 1usize;
    }
}

forall 'k.
fn check_acyclic(&cx: Domain!['k], packages: ArenaVec[Package['k], 'k]) {
    let state: ArenaMap[usize, u32, 'k] = ArenaMap::new(&cx);
    var p = 0usize;
    while p < packages.len(&cx) {
        visit(&cx, packages, state, p);
        p = p + 1usize;
    }
}

forall 'k.
fn visit(&cx: Domain!['k], packages: ArenaVec[Package['k], 'k], state: ArenaMap[usize, u32, 'k], package_id: usize) {
    let s = state.get_or(&cx, package_id, 0u32);
    if s == 1u32 {
        fail(&cx, Buffer!::new().push_static("dependency cycle through package ").push_bytes(&cx, packages.at(&cx, package_id).name.copy(&cx)).save(&cx));
    }
    if s == 0u32 {
        state.insert(&cx, package_id, 1u32);
        let deps = packages.at(&cx, package_id).deps.values(&cx);
        var i = 0usize;
        while i < deps.len(&cx) {
            visit(&cx, packages, state, deps.at(&cx, i));
            i = i + 1usize;
        }
        state.insert(&cx, package_id, 2u32);
    }
}

// ------------------------------------------------------------ namespaces --

// A lookup: `("path", module, path)`, `("import", module, [alias])` or `("export", module, [name])`.
forall 'k.
fn lookup_key(&cx: Domain!['k], kind: Slice[u8, 'static], home: ModuleId['k], names: ArenaVec[Span['k], 'k]) -> (Span['k], ModuleId['k], ArenaVec[Span['k], 'k]) {
    (Span::from_static(&cx, kind), home, names)
}

forall 'k.
fn only_core(&cx: Domain!['k]) -> Span['k] {
    Span::from_static(&cx, "only package core names builtins; import them from core")
}

forall 'k.
fn problem(message: Span['k]) -> Result[Target['k], Problem['k]] {
    Result::Err.(Problem.{ message, pos: no_pos() })
}

forall 'k.
exposed struct Resolver {
    packages: ArenaVec[Package['k], 'k],
    scopes: ArenaMap[ModuleId['k], Scope['k], 'k],
    children: ArenaMap[ModuleId['k], ArenaMap[Span['k], ModuleId['k], 'k], 'k],
    instances: ArenaVec[(ModuleId['k], S::InstanceDecl['k]), 'k],
    // (owner, member) -> declarations
    attached: ArenaMap[(Owner['k], Span['k]), ArenaVec[Decl['k], 'k], 'k],
    cache: ArenaMap[(Span['k], ModuleId['k], ArenaVec[Span['k], 'k]), Target['k], 'k],
    active: ArenaSet[(Span['k], ModuleId['k], ArenaVec[Span['k], 'k]), 'k],
    // the glob imports being resolved, by module and path
    expanding: ArenaSet[(ModuleId['k], ArenaVec[Span['k], 'k]), 'k],
    // the names being looked up through a module's glob imports
    searching: ArenaSet[(ModuleId['k], Span['k]), 'k],
    // node id -> what it names
    refs: ArenaMap[u32, NameRef['k], 'k],
    // The files and positions errors are reported in, innermost last.
    locations: ArenaVec[Location['k], 'k],
    decl_ids: Ref[u32, 'k],
    // the errors reported so far, and their texts
    errors: ArenaVec[Reported['k], 'k],
    reported: ArenaSet[Span['k], 'k],
    // module -> its place among the modules
    order: ArenaMap[ModuleId['k], usize, 'k],
}

forall 'k.
impl Resolver['k] {
    fn new(&cx: Domain!['k], packages: ArenaVec[Package['k], 'k], ids: Ref[u32, 'k]) -> Resolver['k] {
        let r = Resolver.{
            packages,
            scopes: ArenaMap::new(&cx),
            children: ArenaMap::new(&cx),
            instances: ArenaVec::new(&cx),
            attached: ArenaMap::new(&cx),
            cache: ArenaMap::new(&cx),
            active: ArenaSet::new(&cx),
            expanding: ArenaSet::new(&cx),
            searching: ArenaSet::new(&cx),
            refs: ArenaMap::new(&cx),
            locations: ArenaVec::new(&cx),
            decl_ids: Ref::new(&cx, 0u32),
            errors: ArenaVec::new(&cx),
            reported: ArenaSet::new(&cx),
            order: ArenaMap::new(&cx),
        };
        var p = 0usize;
        while p < packages.len(&cx) {
            let package = packages.at(&cx, p);
            let unit = r.children_of(&cx, ModuleId::root(&cx, package.id));
            let modules = package.files.keys(&cx);
            var i = 0usize;
            while i < modules.len(&cx) {
                let home = modules.at(&cx, i);
                let file = package.files.at(&cx, home);
                r.order.insert(&cx, home, r.order.len(&cx));
                r.collect(&cx, home, parse(&cx, read_source(&cx, file), file, ids));
                var k = 0usize;
                while k < home.path.len(&cx) {
                    let parent = ModuleId.{ package: home.package, path: home.path.slice(&cx, 0usize, k) };
                    let name = home.path.at(&cx, k);
                    r.children_of(&cx, parent).insert(&cx, name, parent.child(&cx, name));
                    let unit = r.children_of(&cx, parent.child(&cx, name));
                    k = k + 1usize;
                }
                i = i + 1usize;
            }
            p = p + 1usize;
        }
        let scopes = r.scopes.values(&cx);
        var s = 0usize;
        while s < scopes.len(&cx) {
            r.attach(&cx, scopes.at(&cx, s));
            s = s + 1usize;
        }
        r
    }

    // `children.setdefault(module, {})`.
    fn children_of(self, &cx: Domain!['k], home: ModuleId['k]) -> ArenaMap[Span['k], ModuleId['k], 'k] {
        match self.children.get(&cx, home) {
            Option::Some(c) => c,
            Option::None => {
                let c: ArenaMap[Span['k], ModuleId['k], 'k] = ArenaMap::new(&cx);
                self.children.insert(&cx, home, c);
                c
            },
        }
    }

    fn new_decl(self, &cx: Domain!['k], kind: Slice[u8, 'static], home: ModuleId['k], name: Span['k], node: Named['k], impl_block: Option[S::Impl['k]]) -> Decl['k] {
        let id = self.decl_ids.copy(&cx);
        self.decl_ids.set(&cx, id + 1u32);
        Decl.{ id, kind: Span::from_static(&cx, kind), home, name, node, impl_block }
    }

    fn collect(self, &cx: Domain!['k], home: ModuleId['k], items: ArenaVec[S::Item['k], 'k]) {
        let scope = Scope.{ home, decls: ArenaMap::new(&cx), imports: ArenaMap::new(&cx), import_pos: ArenaMap::new(&cx), globs: ArenaVec::new(&cx), exports: ArenaSet::new(&cx), items };
        self.scopes.insert(&cx, home, scope);
        var i = 0usize;
        while i < items.len(&cx) {
            self.locate(&cx, home, item_pos(items.at(&cx, i)));
            let unit = match items.at(&cx, i) {
                S::Item::Module(m) => self.report(&cx, Span::from_static(&cx, "package sources do not declare `module`"), m.pos),
                S::Item::Use(u) => self.use_tree(&cx, scope, ArenaVec::new(&cx), u.tree, u.is_export),
                S::Item::Instance(n) => self.instances.push(&cx, (home, n)),
                S::Item::Struct(x) => { let declared = self.declare(&cx, scope, self.new_decl(&cx, "struct", home, x.name, Named::Struct.(x), Option::None)); },
                S::Item::Enum(x) => { let declared = self.declare(&cx, scope, self.new_decl(&cx, "enum", home, x.name, Named::Enum.(x), Option::None)); },
                S::Item::Tuple(x) => { let declared = self.declare(&cx, scope, self.new_decl(&cx, "tuple", home, x.name, Named::Tuple.(x), Option::None)); },
                S::Item::Fn(x) => { let declared = self.declare(&cx, scope, self.new_decl(&cx, "fn", home, x.name, Named::Fn.(x), Option::None)); },
                S::Item::Extern(x) => { let declared = self.declare(&cx, scope, self.new_decl(&cx, "extern", home, x.name, Named::Extern.(x), Option::None)); },
                S::Item::Trait(x) => { let declared = self.declare(&cx, scope, self.new_decl(&cx, "trait", home, x.name, Named::Trait.(x), Option::None)); },
                S::Item::Const(x) => { let declared = self.declare(&cx, scope, self.new_decl(&cx, "const", home, x.name, Named::Const.(x), Option::None)); },
                S::Item::Impl(x) => (),
            };
            self.unlocate(&cx);
            i = i + 1usize;
        }
    }

    // Declares `decl` in `scope`, unless its name is taken, which is reported; whether it did.
    fn declare(self, &cx: Domain!['k], scope: Scope['k], decl: Decl['k]) -> bool {
        if scope.decls.contains(&cx, decl.name) || scope.imports.contains(&cx, decl.name) {
            self.report(&cx, Buffer!::new().push_static("duplicate name ").push_bytes(&cx, decl.name).save(&cx), named_pos(decl.node));
            return false;
        }
        scope.decls.insert(&cx, decl.name, decl);
        true
    }

    // The names a `use` tree imports; its errors are at where the tree starts.
    fn use_tree(self, &cx: Domain!['k], scope: Scope['k], prefix: ArenaVec[Span['k], 'k], tree: S::UseTree['k], exported: bool) {
        let path = prefix.clone(&cx);
        path.append(&cx, tree.path);
        if path.at(&cx, 0usize).is(&cx, "builtin") && !self.in_core(&cx, scope.home) {
            self.report(&cx, only_core(&cx), tree.pos);
            return;
        }
        if tree.star {
            scope.globs.push(&cx, path);
        } else if !tree.children.is_empty(&cx) {
            var i = 0usize;
            while i < tree.children.len(&cx) {
                self.use_tree(&cx, scope, path, tree.children.at(&cx, i), exported);
                i = i + 1usize;
            }
        } else {
            let last = path.at(&cx, path.len(&cx) - 1usize);
            let name = match tree.alias {
                Option::Some(a) => {
                    let linear = last.ends_with(&cx, Span::from_static(&cx, "!"));
                    // still imported under the alias, so that its uses report nothing more
                    if a.ends_with(&cx, Span::from_static(&cx, "!")) != linear {
                        self.report(&cx, Buffer!::new().push_static("the alias ").push_bytes(&cx, a).push_static(" of ").push_bytes(&cx, last)
                            .push_static(if linear { " must end with !" } else { " must not end with !" }).save(&cx), tree.pos);
                    }
                    a
                },
                Option::None => last,
            };
            // `export name;` publishes an existing name
            if exported && path.len(&cx) == 1usize && path.at(&cx, 0usize).eq(&cx, name) {
                scope.exports.insert(&cx, name);
                return;
            }
            if name.is(&cx, "package") || name.is(&cx, "builtin") || is_builtin_trait(&cx, name) {
                self.report(&cx, Buffer!::new().push_bytes(&cx, name).push_static(" is compiler-sealed").save(&cx), tree.pos);
                return;
            }
            if scope.imports.contains(&cx, name) || scope.decls.contains(&cx, name) {
                self.report(&cx, Buffer!::new().push_static("duplicate import ").push_bytes(&cx, name).save(&cx), tree.pos);
                return;
            }
            scope.imports.insert(&cx, name, path);
            scope.import_pos.insert(&cx, name, tree.pos);
            if exported {
                scope.exports.insert(&cx, name);
            }
        }
    }

    // Methods and associated consts are declared by their impl's module and attached to the impl's
    // target type for `Target::name` lookup.
    fn attach(self, &cx: Domain!['k], scope: Scope['k]) {
        var i = 0usize;
        while i < scope.items.len(&cx) {
            let unit = match scope.items.at(&cx, i) {
                S::Item::Impl(m) => {
                    self.locate(&cx, scope.home, m.pos);
                    self.attach_impl(&cx, scope, m);
                    self.unlocate(&cx);
                },
                _ => (),
            };
            i = i + 1usize;
        }
    }

    fn attach_impl(self, &cx: Domain!['k], scope: Scope['k], item: S::Impl['k]) {
        let target = match item.type {
            Type::Name(n) => n,
            _ => {
                self.report(&cx, Span::from_static(&cx, "an impl target must be a named type"), item.pos);
                return;
            },
        };
        let spelled = target.path.at(&cx, target.path.len(&cx) - 1usize);
        let params = match item.quantifier {
            Option::Some(f) => f.params,
            Option::None => ArenaVec::new(&cx),
        };
        let alone = target.path.at(&cx, 0usize);
        let owner = if target.path.len(&cx) == 1usize && is_prim(&cx, alone) {
            Owner::Prim.(target.path.at(&cx, 0usize))
        } else if target.path.len(&cx) == 1usize && params.contains(&cx, target.path.at(&cx, 0usize)) {
            // a blanket impl: its methods are found by method calls only
            Owner::Blanket
        } else {
            self.impl_owner(&cx, scope.home, target)
        };
        var k = 0usize;
        while k < item.items.len(&cx) {
            let decl = match item.items.at(&cx, k) {
                S::Member::Fn(f) => self.new_decl(&cx, "method", scope.home, Buffer!::new().push_bytes(&cx, spelled).push_static("::").push_bytes(&cx, f.name).save(&cx), Named::Fn.(f), Option::Some.(item)),
                S::Member::Const(c) => self.new_decl(&cx, "const", scope.home, Buffer!::new().push_bytes(&cx, spelled).push_static("::").push_bytes(&cx, c.name).save(&cx), Named::Const.(c), Option::Some.(item)),
            };
            let member = match item.items.at(&cx, k) {
                S::Member::Fn(f) => f.name,
                S::Member::Const(c) => c.name,
            };
            if self.declare(&cx, scope, decl) {
                let key = (owner, member);
                match self.attached.get(&cx, key) {
                    Option::Some(found) => found.push(&cx, decl),
                    Option::None => { self.attached.insert(&cx, key, ArenaVec::one(&cx, decl)); },
                }
            }
            k = k + 1usize;
        }
    }

    // What `impl target` gives methods. When `target` names nothing but its other spelling names a
    // type, the error is reported and the methods go to that type, so that their uses report nothing
    // more.
    fn impl_owner(self, &cx: Domain!['k], home: ModuleId['k], target: S::TName['k]) -> Owner['k] {
        match self.lookup(&cx, home, target.path, target.pos) {
            Result::Ok(found) => match found {
                Target::Builtin(name) => if is_owned_builtin(&cx, name) {
                    Owner::Prim.(name)
                } else {
                    self.report(&cx, Span::from_static(&cx, "an impl target must name a type declaration"), target.pos);
                    Owner::Blanket
                },
                Target::Decl(d) => Owner::Decl.(d),
                _ => {
                    self.report(&cx, Span::from_static(&cx, "an impl target must name a type declaration"), target.pos);
                    Owner::Blanket
                },
            },
            Result::Err(e) => {
                self.report(&cx, e.message, e.pos);
                let n = target.path.len(&cx);
                let other = target.path.slice(&cx, 0usize, n - 1usize);
                other.push(&cx, other_spelling(&cx, target.path.at(&cx, n - 1usize)));
                match self.lookup(&cx, home, other, no_pos()) {
                    Result::Ok(found) => match found {
                        Target::Decl(d) => Owner::Decl.(d),
                        _ => Owner::Blanket,
                    },
                    Result::Err(_e) => Owner::Blanket,
                }
            },
        }
    }

    // ---- errors
    fn file(self, &cx: Domain!['k], home: ModuleId['k]) -> Span['k] {
        self.packages.at(&cx, home.package).files.at(&cx, home)
    }

    // Errors from here until `unlocate` are inside `module`'s file and, when they have no
    // position, at `pos`.
    fn locate(self, &cx: Domain!['k], home: ModuleId['k], pos: Pos) {
        self.locations.push(&cx, Location.{ file: self.file(&cx, home), pos, rank: self.order.get_or(&cx, home, 0usize) + 1usize });
    }

    // Errors from here until `unlocate` are in the manifest `file`.
    fn locate_manifest(self, &cx: Domain!['k], file: Span['k]) {
        self.locations.push(&cx, Location.{ file, pos: no_pos(), rank: 0usize });
    }

    fn unlocate(self, &cx: Domain!['k]) {
        let unit = self.locations.pop(&cx);
    }

    // `message` at `pos` (none on line 0) as printed, naming the files it is located in, and where it
    // is.
    fn located_error(self, &cx: Domain!['k], message: Span['k], pos: Pos) -> (Span['k], Pos) {
        var full = error_text(&cx, message, pos);
        var at = pos;
        var i = self.locations.len(&cx);
        while i > 0usize {
            i = i - 1usize;
            let l = self.locations.at(&cx, i);
            let (f, p) = located(&cx, full, message, at, l.file, l.pos);
            full = f;
            at = p;
        }
        (full, at)
    }

    // Stops with `message` at `pos` (none on line 0), naming the files it is located in.
    fn fail(self, &cx: Domain!['k], message: Span['k], pos: Pos) -> ! {
        let (full, at) = self.located_error(&cx, message, pos);
        fail(&cx, full)
    }

    // Keeps `message` at `pos` for `stop`, located as `fail` locates it. An error reported twice is
    // kept once.
    fn report(self, &cx: Domain!['k], message: Span['k], pos: Pos) {
        let (full, at) = self.located_error(&cx, message, pos);
        if !self.reported.contains(&cx, full) {
            self.reported.insert(&cx, full);
            let rank = if self.locations.is_empty(&cx) { 0usize } else { self.locations.at(&cx, self.locations.len(&cx) - 1usize).rank };
            self.errors.push(&cx, Reported.{ text: full, rank, line: at.line, col: at.col, seq: self.errors.len(&cx) });
        }
    }

    // Stops with the errors reported, in source order: the first `ERROR_LIMIT`, and how many more
    // there are.
    fn stop(self, &cx: Domain!['k]) {
        let n = self.errors.len(&cx);
        if n == 0usize {
            return;
        }
        let sorted = self.errors.clone(&cx);
        sorted.sort_by(&cx, |&cx, a, b| source_order(a, b));
        var out = Buffer!::new();
        var i = 0usize;
        while i < n && i < ERROR_LIMIT {
            out = out.push_static(if i > 0usize { "\n" } else { "" }).push_bytes(&cx, sorted.at(&cx, i).text);
            i = i + 1usize;
        }
        if n > ERROR_LIMIT {
            out = out.push_static("\nand ").push_usize(n - ERROR_LIMIT).push_static(if n - ERROR_LIMIT > 1usize { " more errors" } else { " more error" });
        }
        fail(&cx, out.save(&cx))
    }

    // ---- path lookup
    // What `path` names from `module`, or why it names nothing; an error without a position gets
    // `pos`.
    fn lookup(self, &cx: Domain!['k], home: ModuleId['k], path: ArenaVec[Span['k], 'k], pos: Pos) -> Result[Target['k], Problem['k]] {
        match self.solve(&cx, lookup_key(&cx, "path", home, path)) {
            Result::Ok(t) => Result::Ok.(t),
            Result::Err(e) => if e.pos.line == 0u32 && pos.line != 0u32 {
                Result::Err.(Problem.{ message: e.message, pos })
            } else {
                Result::Err.(e)
            },
        }
    }

    // What `path` names from `module`, stopping if it names nothing.
    fn need(self, &cx: Domain!['k], home: ModuleId['k], path: ArenaVec[Span['k], 'k], pos: Pos) -> Target['k] {
        match self.lookup(&cx, home, path, pos) {
            Result::Ok(t) => t,
            Result::Err(e) => self.fail(&cx, e.message, e.pos),
        }
    }

    fn solve(self, &cx: Domain!['k], key: (Span['k], ModuleId['k], ArenaVec[Span['k], 'k])) -> Result[Target['k], Problem['k]] {
        let unit = match self.cache.get(&cx, key) {
            Option::Some(t) => return Result::Ok.(t),
            Option::None => (),
        };
        let (kind, home, names) = key;
        if self.active.contains(&cx, key) {
            return problem(Buffer!::new().push_static("import cycle at ").push_bytes(&cx, names.join(&cx, "::")).save(&cx));
        }
        self.active.insert(&cx, key);
        let value = if kind.is(&cx, "import") {
            self.resolve_path(&cx, home, self.scopes.at(&cx, home).imports.at(&cx, names.at(&cx, 0usize)), Option::Some.(names.at(&cx, 0usize)), true)
        } else {
            self.resolve_path(&cx, home, names, Option::None, true)
        };
        self.active.remove(&cx, key);
        match value {
            Result::Ok(t) => {
                self.cache.insert(&cx, key, t);
                Result::Ok.(t)
            },
            Result::Err(e) => Result::Err.(e),
        }
    }

    // What `path` names from `home`; with `hint`, a first name that names nothing is reported with what
    // its other spelling names (`respelled`).
    fn resolve_path(self, &cx: Domain!['k], home: ModuleId['k], path: ArenaVec[Span['k], 'k], importing: Option[Span['k]], hint: bool) -> Result[Target['k], Problem['k]] {
        let first = path.at(&cx, 0usize);
        let rest = path.skip(&cx, 1usize);
        let scope = self.scopes.at(&cx, home);
        let not_importing = match importing {
            Option::Some(name) => !name.eq(&cx, first),
            Option::None => true,
        };
        if first.is(&cx, "builtin") {
            return self.builtin(&cx, home, path);
        }
        var target = if first.is(&cx, "package") {
            Target::Module.(ModuleId::root(&cx, home.package))
        } else if scope.decls.contains(&cx, first) {
            Target::Decl.(scope.decls.at(&cx, first))
        } else if scope.imports.contains(&cx, first) && not_importing {
            match self.solve(&cx, lookup_key(&cx, "import", home, ArenaVec::one(&cx, first))) {
                Result::Ok(t) => t,
                Result::Err(e) => {
                    let misspelled = if hint { self.misspelled_import(&cx, home, first) } else { Span::from_static(&cx, "") };
                    if misspelled.is_empty() {
                        return Result::Err.(e);
                    }
                    return Result::Err.(Problem.{ message: e.message.concat(&cx, misspelled), pos: e.pos });
                },
            }
        } else {
            match self.root_member(&cx, home, first) {
                Option::Some(t) => t,
                Option::None => match self.glob(&cx, home, first) {
                    Result::Ok(found) => match found {
                        Option::Some(t) => t,
                        Option::None => {
                            var message = Buffer!::new().push_static("unknown name ").push_bytes(&cx, path.join(&cx, "::"));
                            if hint {
                                message = self.unknown_hint(&cx, message, home, first, importing);
                            }
                            return problem(message.save(&cx));
                        },
                    },
                    Result::Err(e) => return Result::Err.(e),
                },
            }
        };
        var k = 0usize;
        while k < rest.len(&cx) {
            target = match target {
                Target::Decl(d) => return self.associated(&cx, d, rest.skip(&cx, k).join(&cx, "::")),
                Target::Builtin(name) => if is_owned_builtin(&cx, name) {
                    return self.attached_to(&cx, name, rest.skip(&cx, k).join(&cx, "::"));
                } else {
                    return problem(Buffer!::new().push_bytes(&cx, path.slice(&cx, 0usize, k + 1usize).join(&cx, "::")).push_static(" is not a module").save(&cx));
                },
                Target::Module(m) => match self.member(&cx, home, m, rest.at(&cx, k), true) {
                    Result::Ok(t) => t,
                    Result::Err(e) => return Result::Err.(e),
                },
                _ => return problem(Buffer!::new().push_bytes(&cx, path.slice(&cx, 0usize, k + 1usize).join(&cx, "::")).push_static(" is not a module").save(&cx)),
            };
            k = k + 1usize;
        }
        Result::Ok.(target)
    }

    // For a first name that names nothing in `home`, `out` followed by what its other spelling names
    // there, or, when that is an import that names nothing, by what the import names respelled
    // (`misspelled_import`).
    fn unknown_hint(self, &cx: Domain!['k], out: Buffer!, home: ModuleId['k], name: Span['k], importing: Option[Span['k]]) -> Buffer! {
        let other = other_spelling(&cx, name);
        let scope = self.scopes.at(&cx, home);
        let not_importing = match importing {
            Option::Some(i) => !i.eq(&cx, other),
            Option::None => true,
        };
        if scope.imports.contains(&cx, other) && not_importing {
            let misspelled = self.misspelled_import(&cx, home, other);
            if !misspelled.is_empty() {
                let imported = scope.imports.at(&cx, other);
                return respelled(&cx, out, other_spelling(&cx, imported.at(&cx, imported.len(&cx) - 1usize))).push_bytes(&cx, misspelled);
            }
        }
        match self.resolve_path(&cx, home, ArenaVec::one(&cx, other), Option::None, false) {
            Result::Ok(_t) => respelled(&cx, out, other),
            Result::Err(_e) => out,
        }
    }

    // For an import that names nothing: where its `use` names it, when the import's last name
    // respelled, with or without the `!` of a linear type, names something; else nothing.
    fn misspelled_import(self, &cx: Domain!['k], home: ModuleId['k], alias: Span['k]) -> Span['k] {
        let scope = self.scopes.at(&cx, home);
        let path = scope.imports.at(&cx, alias);
        let n = path.len(&cx);
        let other = path.slice(&cx, 0usize, n - 1usize);
        other.push(&cx, other_spelling(&cx, path.at(&cx, n - 1usize)));
        match self.resolve_path(&cx, home, other, Option::Some.(alias), false) {
            Result::Ok(_t) => {
                let at = scope.import_pos.at(&cx, alias);
                Buffer!::new().push_static(", imported as ").push_bytes(&cx, path.at(&cx, n - 1usize)).push_static(" at ").push_bytes(&cx, self.file(&cx, home))
                    .push_static(":").push_u64(at.line as u64).push_static(":").push_u64(at.col as u64).save(&cx)
            },
            Result::Err(_e) => Span::from_static(&cx, ""),
        }
    }

    // `builtin::name`, which only package core writes.
    fn builtin(self, &cx: Domain!['k], home: ModuleId['k], path: ArenaVec[Span['k], 'k]) -> Result[Target['k], Problem['k]] {
        if !self.in_core(&cx, home) {
            return problem(only_core(&cx));
        }
        let name = if path.len(&cx) == 2usize { path.at(&cx, 1usize) } else { Span::from_static(&cx, "") };
        if !is_builtin_type(&cx, name) && !is_builtin_value(&cx, name) {
            return problem(Buffer!::new().push_static("unknown builtin ").push_bytes(&cx, path.join(&cx, "::")).save(&cx));
        }
        Result::Ok.(Target::Builtin.(name))
    }

    fn in_core(self, &cx: Domain!['k], home: ModuleId['k]) -> bool {
        self.packages.at(&cx, home.package).name.copy(&cx).is(&cx, "core")
    }

    // `Owner::name` of a primitive or builtin type: a method or const an impl of it declares.
    fn attached_to(self, &cx: Domain!['k], owner: Span['k], name: Span['k]) -> Result[Target['k], Problem['k]] {
        let found = self.attached.get_or(&cx, (Owner::Prim.(owner), name), ArenaVec::new(&cx));
        if found.is_empty(&cx) {
            return problem(Buffer!::new().push_static("unknown ").push_bytes(&cx, owner).push_static("::").push_bytes(&cx, name).save(&cx));
        }
        Result::Ok.(Target::Decl.(found.at(&cx, 0usize)))
    }

    fn root_member(self, &cx: Domain!['k], home: ModuleId['k], name: Span['k]) -> Option[Target['k]] {
        let package = self.packages.at(&cx, home.package);
        let root = ModuleId::root(&cx, home.package);
        if package.deps.contains(&cx, name) {
            return Option::Some.(Target::Module.(ModuleId::root(&cx, package.deps.at(&cx, name))));
        }
        let children = self.children.at(&cx, root);
        if children.contains(&cx, name) {
            return Option::Some.(Target::Module.(children.at(&cx, name)));
        }
        match self.scopes.get(&cx, root) {
            Option::Some(scope) => match scope.decls.get(&cx, name) {
                Option::Some(d) => Option::Some.(Target::Decl.(d)),
                Option::None => Option::None,
            },
            Option::None => Option::None,
        }
    }

    // `name` through the module's glob imports, in order. Globs that lead back to a search already
    // under way for `name` in `home` offer nothing more there.
    fn glob(self, &cx: Domain!['k], home: ModuleId['k], name: Span['k]) -> Result[Option[Target['k]], Problem['k]] {
        if self.searching.contains(&cx, (home, name)) {
            return Result::Ok.(Option::None);
        }
        self.searching.insert(&cx, (home, name));
        let found = self.globbed(&cx, home, name);
        self.searching.remove(&cx, (home, name));
        found
    }

    // A glob whose own path is being resolved offers nothing more: its path's first name is unknown
    // in the module itself.
    fn globbed(self, &cx: Domain!['k], home: ModuleId['k], name: Span['k]) -> Result[Option[Target['k]], Problem['k]] {
        let globs = self.scopes.at(&cx, home).globs;
        var i = 0usize;
        while i < globs.len(&cx) {
            let path = globs.at(&cx, i);
            if !self.expanding.contains(&cx, (home, path)) {
                self.expanding.insert(&cx, (home, path));
                let found = self.resolve_path(&cx, home, path, Option::None, true);
                self.expanding.remove(&cx, (home, path));
                let source = match found {
                    Result::Ok(t) => t,
                    Result::Err(e) => return Result::Err.(e),
                };
                let unit = match source {
                    Target::Module(m) => match self.member(&cx, home, m, name, false) {
                        Result::Ok(t) => return Result::Ok.(Option::Some.(t)),
                        Result::Err(e) => (),
                    },
                    _ => return Result::Err.(Problem.{ message: Buffer!::new().push_bytes(&cx, path.join(&cx, "::")).push_static(" is not a module").save(&cx), pos: no_pos() }),
                };
            }
            i = i + 1usize;
        }
        Result::Ok.(Option::None)
    }

    // `module::name`, seen from `caller`: its own declarations; within one package also its
    // children and imports; across packages only exports. With `hint`, as `resolve_path`.
    fn member(self, &cx: Domain!['k], caller: ModuleId['k], home: ModuleId['k], name: Span['k], hint: bool) -> Result[Target['k], Problem['k]] {
        let scope = self.scopes.get(&cx, home);
        let unit = match scope {
            Option::Some(s) => match s.decls.get(&cx, name) {
                Option::Some(d) => return Result::Ok.(Target::Decl.(d)),
                Option::None => (),
            },
            Option::None => (),
        };
        if caller.package == home.package {
            let unit = match self.children.get(&cx, home) {
                Option::Some(c) => match c.get(&cx, name) {
                    Option::Some(m) => return Result::Ok.(Target::Module.(m)),
                    Option::None => (),
                },
                Option::None => (),
            };
            let unit = match scope {
                Option::Some(s) => {
                    if s.imports.contains(&cx, name) {
                        return self.solve(&cx, lookup_key(&cx, "import", home, ArenaVec::one(&cx, name)));
                    }
                    let unit = match self.glob(&cx, home, name) {
                        Result::Ok(found) => match found {
                            Option::Some(t) => return Result::Ok.(t),
                            Option::None => (),
                        },
                        Result::Err(e) => return Result::Err.(e),
                    };
                },
                Option::None => (),
            };
        } else {
            let unit = match scope {
                Option::Some(s) => {
                    if s.exports.contains(&cx, name) {
                        return self.solve(&cx, lookup_key(&cx, "export", home, ArenaVec::one(&cx, name)));
                    }
                },
                Option::None => (),
            };
        }
        let owner = if home.path.is_empty(&cx) { self.packages.at(&cx, home.package).name.copy(&cx) } else { home.path.join(&cx, "::") };
        var message = Buffer!::new().push_static("unknown or private member ").push_bytes(&cx, name).push_static(" of ").push_bytes(&cx, owner);
        if hint {
            let other = other_spelling(&cx, name);
            let unit = match self.member(&cx, caller, home, other, false) {
                Result::Ok(_t) => {
                    message = respelled(&cx, message, other);
                },
                Result::Err(_e) => (),
            };
        }
        problem(message.save(&cx))
    }

    // `Owner::name`: an enum variant, or a method or const attached to `Owner`.
    fn associated(self, &cx: Domain!['k], owner: Decl['k], name: Span['k]) -> Result[Target['k], Problem['k]] {
        let unit = match owner.node {
            Named::Enum(e) => {
                var i = 0usize;
                while i < e.variants.len(&cx) {
                    if e.variants.at(&cx, i).name.eq(&cx, name) {
                        return Result::Ok.(Target::Variant.(owner, name));
                    }
                    i = i + 1usize;
                }
            },
            Named::Trait(t) => {
                var i = 0usize;
                while i < t.methods.len(&cx) {
                    if t.methods.at(&cx, i).name.eq(&cx, name) {
                        return Result::Ok.(Target::TraitMethod.(owner, name));
                    }
                    i = i + 1usize;
                }
            },
            _ => (),
        };
        let found = self.attached.get_or(&cx, (Owner::Decl.(owner), name), ArenaVec::new(&cx));
        var own: ArenaVec[Decl['k], 'k] = ArenaVec::new(&cx);
        var i = 0usize;
        while i < found.len(&cx) {
            if key_eq(&cx, found.at(&cx, i).home, owner.home) {
                own.push(&cx, found.at(&cx, i));
            }
            i = i + 1usize;
        }
        if own.is_empty(&cx) {
            own = found;
        }
        if own.len(&cx) != 1usize {
            return problem(Buffer!::new().push_static(if own.is_empty(&cx) { "unknown" } else { "ambiguous" }).push_static(" associated name ").push_bytes(&cx, owner.name).push_static("::").push_bytes(&cx, name).save(&cx));
        }
        Result::Ok.(Target::Decl.(own.at(&cx, 0usize)))
    }

    // A library item the compiler itself refers to (Slice for string literals, Buffer and Format
    // for f-strings, Ordering for atomics): through a direct dependency on its home library, else
    // through std, else in the module's own package.
    fn library(self, &cx: Domain!['k], home: ModuleId['k], library_name: Span['k], path: ArenaVec[Span['k], 'k], std_path: ArenaVec[Span['k], 'k]) -> Target['k] {
        let deps = self.packages.at(&cx, home.package).deps;
        let root = if deps.contains(&cx, library_name) { library_name } else if deps.contains(&cx, Span::from_static(&cx, "std")) { Span::from_static(&cx, "std") } else { Span::from_static(&cx, "package") };
        let full: ArenaVec[Span['k], 'k] = ArenaVec::one(&cx, root);
        full.append(&cx, if root.is(&cx, "std") { std_path } else { path });
        self.need(&cx, home, full, no_pos())
    }
}

// ---------------------------------------------------------- references --

// `names` with `more` added, as a new sequence: the sets of names in scope.
forall 'k.
fn with(&cx: Domain!['k], names: ArenaVec[Span['k], 'k], more: ArenaVec[Span['k], 'k]) -> ArenaVec[Span['k], 'k] {
    let out = names.clone(&cx);
    out.append(&cx, more);
    out
}

forall 'k.
fn with_one(&cx: Domain!['k], names: ArenaVec[Span['k], 'k], name: Span['k]) -> ArenaVec[Span['k], 'k] {
    let out = names.clone(&cx);
    out.push(&cx, name);
    out
}

forall 'k.
fn quantifier_of(item: S::Item['k]) -> Option[S::Forall['k]] {
    match item {
        S::Item::Use(x) => x.quantifier,
        S::Item::Module(x) => Option::None,
        S::Item::Struct(x) => x.quantifier,
        S::Item::Tuple(x) => x.quantifier,
        S::Item::Enum(x) => x.quantifier,
        S::Item::Fn(x) => x.quantifier,
        S::Item::Extern(x) => x.quantifier,
        S::Item::Const(x) => x.quantifier,
        S::Item::Impl(x) => x.quantifier,
        S::Item::Trait(x) => x.quantifier,
        S::Item::Instance(x) => x.quantifier,
    }
}

// The type parameters a quantifier binds, without its brands.
forall 'k.
fn forall_params(&cx: Domain!['k], quantifier: Option[S::Forall['k]]) -> ArenaVec[Span['k], 'k] {
    let out: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
    let unit = match quantifier {
        Option::Some(f) => {
            let all = with(&cx, f.params, f.determined);
            var i = 0usize;
            while i < all.len(&cx) {
                if !all.at(&cx, i).starts_with(&cx, Span::from_static(&cx, "'")) {
                    out.push(&cx, all.at(&cx, i));
                }
                i = i + 1usize;
            }
        },
        Option::None => (),
    };
    out
}

// Resolve every path in every item of every module.
forall 'k.
exposed struct Names {
    r: Resolver['k],
    home: Ref[ModuleId['k], 'k],
}

forall 'k.
impl Names['k] {
    fn new(&cx: Domain!['k], r: Resolver['k]) -> Names['k] {
        Names.{ r, home: Ref::new(&cx, ModuleId::root(&cx, 0usize)) }
    }

    fn run(self, &cx: Domain!['k]) -> Resolver['k] {
        let modules = self.r.scopes.keys(&cx);
        var m = 0usize;
        while m < modules.len(&cx) {
            let home = modules.at(&cx, m);
            self.home.set(&cx, home);
            let items = self.r.scopes.at(&cx, home).items;
            var i = 0usize;
            while i < items.len(&cx) {
                let item = items.at(&cx, i);
                self.r.locate(&cx, home, item_pos(item));
                self.item(&cx, item, ArenaVec::new(&cx));
                self.r.unlocate(&cx);
                i = i + 1usize;
            }
            m = m + 1usize;
        }
        self.r.stop(&cx);
        self.r
    }

    fn set(self, &cx: Domain!['k], id: u32, r: NameRef['k]) {
        self.r.refs.insert(&cx, id, r);
    }

    fn premises(self, &cx: Domain!['k], quantifier: Option[S::Forall['k]], types: ArenaVec[Span['k], 'k]) {
        let unit = match quantifier {
            Option::Some(f) => {
                var i = 0usize;
                while i < f.premises.len(&cx) {
                    let premise = f.premises.at(&cx, i);
                    let trait_path = premise.trait_path;
                    if trait_path.len(&cx) == 1usize && is_builtin_trait(&cx, trait_path.at(&cx, 0usize)) {
                        self.set(&cx, premise.args.id, NameRef::Builtin.(trait_path.at(&cx, 0usize)));
                    } else {
                        match self.decl(&cx, trait_path, "trait", premise.pos) {
                            Option::Some(d) => self.set(&cx, premise.args.id, NameRef::Decl.(d)),
                            Option::None => (),
                        }
                    }
                    var k = 0usize;
                    while k < premise.args.args.len(&cx) {
                        self.type(&cx, premise.args.args.at(&cx, k), types, false);
                        k = k + 1usize;
                    }
                    i = i + 1usize;
                }
            },
            Option::None => (),
        };
    }

    fn item(self, &cx: Domain!['k], item: S::Item['k], types: ArenaVec[Span['k], 'k]) {
        let unit = match item {
            S::Item::Use(x) => return,
            S::Item::Module(x) => return,
            _ => (),
        };
        let quantifier = quantifier_of(item);
        let types = with(&cx, types, forall_params(&cx, quantifier));
        self.premises(&cx, quantifier, types);
        match item {
            S::Item::Struct(s) => {
                var i = 0usize;
                while i < s.fields.len(&cx) {
                    self.type(&cx, s.fields.at(&cx, i).type, types, false);
                    i = i + 1usize;
                }
            },
            S::Item::Tuple(t) => self.types(&cx, t.elems, types),
            S::Item::Enum(e) => {
                var i = 0usize;
                while i < e.variants.len(&cx) {
                    self.types(&cx, e.variants.at(&cx, i).payload, types);
                    i = i + 1usize;
                }
            },
            S::Item::Fn(f) => self.function(&cx, f, types),
            S::Item::Extern(x) => {
                var i = 0usize;
                while i < x.params.len(&cx) {
                    let unit = match x.params.at(&cx, i).type {
                        Option::Some(t) => self.type(&cx, t, types, false),
                        Option::None => (),
                    };
                    i = i + 1usize;
                }
                let unit = match x.ret {
                    Option::Some(t) => self.type(&cx, t, types, false),
                    Option::None => (),
                };
            },
            S::Item::Const(c) => {
                self.type(&cx, c.type, types, false);
                self.expr(&cx, c.value, types, ArenaVec::new(&cx));
            },
            S::Item::Impl(m) => {
                self.type(&cx, m.type, types, false);
                var i = 0usize;
                while i < m.items.len(&cx) {
                    let unit = match m.items.at(&cx, i) {
                        S::Member::Fn(f) => self.item(&cx, S::Item::Fn.(f), types),
                        S::Member::Const(c) => self.item(&cx, S::Item::Const.(c), types),
                    };
                    i = i + 1usize;
                }
            },
            S::Item::Trait(t) => {
                let trait_types = if t.quantifier.is_none() { with_one(&cx, types, Span::from_static(&cx, "Self")) } else { types };
                var i = 0usize;
                while i < t.methods.len(&cx) {
                    self.function(&cx, t.methods.at(&cx, i), trait_types);
                    i = i + 1usize;
                }
            },
            S::Item::Instance(n) => {
                self.type(&cx, n.type, types, true);
                var i = 0usize;
                while i < n.methods.len(&cx) {
                    self.item(&cx, S::Item::Fn.(n.methods.at(&cx, i)), types);
                    i = i + 1usize;
                }
            },
            _ => (),
        }
    }

    fn function(self, &cx: Domain!['k], f: S::Fn['k], types: ArenaVec[Span['k], 'k]) {
        let types = with(&cx, types, forall_params(&cx, f.quantifier));
        self.premises(&cx, f.quantifier, types);
        let names: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
        var i = 0usize;
        while i < f.params.len(&cx) {
            let p = f.params.at(&cx, i);
            let unit = match p.type {
                Option::Some(t) => self.type(&cx, t, types, false),
                Option::None => (),
            };
            names.push(&cx, p.name);
            i = i + 1usize;
        }
        let unit = match f.ret {
            Option::Some(t) => self.type(&cx, t, types, false),
            Option::None => (),
        };
        let unit = match f.body {
            Option::Some(b) => self.block(&cx, b, types, names),
            Option::None => (),
        };
    }

    // What `path`, written at `pos`, names; or nothing, when it names nothing, which is reported.
    fn seek(self, &cx: Domain!['k], path: ArenaVec[Span['k], 'k], pos: Pos) -> Option[Target['k]] {
        match self.r.lookup(&cx, self.home.copy(&cx), path, pos) {
            Result::Ok(t) => Option::Some.(t),
            Result::Err(e) => {
                self.r.report(&cx, e.message, e.pos);
                Option::None
            },
        }
    }

    // The declaration `path`, written at `pos`, names, of `kind` unless it is empty; or nothing, when
    // it names none, which is reported.
    fn decl(self, &cx: Domain!['k], path: ArenaVec[Span['k], 'k], kind: Slice[u8, 'static], pos: Pos) -> Option[Decl['k]] {
        match self.seek(&cx, path, pos) {
            Option::Some(target) => self.decl_of(&cx, path, target, kind, pos),
            Option::None => Option::None,
        }
    }

    // `target`, which `path` names, when it is a declaration of `kind` (any kind when it is empty);
    // otherwise that is reported.
    fn decl_of(self, &cx: Domain!['k], path: ArenaVec[Span['k], 'k], target: Target['k], kind: Slice[u8, 'static], pos: Pos) -> Option[Decl['k]] {
        let k = Span::from_static(&cx, kind);
        match target {
            Target::Decl(d) => if k.is_empty() || d.kind.eq(&cx, k) {
                return Option::Some.(d);
            },
            _ => (),
        }
        let what = if k.is_empty() { Span::from_static(&cx, "declaration") } else { k };
        self.r.report(&cx, Buffer!::new().push_bytes(&cx, path.join(&cx, "::")).push_static(" is not a ").push_bytes(&cx, what).save(&cx), pos);
        Option::None
    }

    // ---- types
    fn types(self, &cx: Domain!['k], ts: ArenaVec[Type['k], 'k], types: ArenaVec[Span['k], 'k]) {
        var i = 0usize;
        while i < ts.len(&cx) {
            self.type(&cx, ts.at(&cx, i), types, false);
            i = i + 1usize;
        }
    }

    fn type(self, &cx: Domain!['k], t: Type['k], types: ArenaVec[Span['k], 'k], is_trait: bool) {
        match t {
            Type::Name(n) => {
                let path = n.path;
                let single = path.len(&cx) == 1usize;
                let name = path.at(&cx, 0usize);
                if single && types.contains(&cx, name) {
                    self.set(&cx, n.id, NameRef::Param.(name));
                } else if single && is_prim(&cx, name) {
                    self.set(&cx, n.id, NameRef::Prim.(name));
                } else if single && name.is(&cx, "Never") {
                    self.set(&cx, n.id, NameRef::Builtin.(name));
                } else {
                    match self.seek(&cx, path, n.pos) {
                        Option::Some(target) => self.named_type(&cx, n, target, is_trait),
                        Option::None => (),
                    }
                }
                self.types(&cx, n.args, types);
            },
            Type::Ptr(inner) => self.type(&cx, inner.copy(&cx), types, false),
            Type::Tuple(elems) => self.types(&cx, elems, types),
            Type::Array(elem, length) => {
                self.type(&cx, elem.copy(&cx), types, false);
                self.expr(&cx, length.copy(&cx), types, ArenaVec::new(&cx));
            },
            Type::Fn(f) => {
                self.slots(&cx, f.params, types);
                self.type(&cx, f.ret.copy(&cx), types, false);
            },
            Type::Closure(c) => {
                self.slots(&cx, c.params, types);
                self.type(&cx, c.ret.copy(&cx), types, false);
                let unit = match c.env {
                    Option::Some(env) => self.type(&cx, env.copy(&cx), types, false),
                    Option::None => (),
                };
            },
            Type::Exists(brands, body) => self.type(&cx, body.copy(&cx), types, false),
            Type::Foreach(f) => {
                self.type(&cx, f.source.copy(&cx), types, false);
                let bound = types.clone(&cx);
                bound.append(&cx, f.binders(&cx));
                self.type(&cx, f.body.copy(&cx), bound, false);
            },
            Type::Forall(params, body) => {
                let bound: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
                var i = 0usize;
                while i < params.len(&cx) {
                    if !params.at(&cx, i).starts_with(&cx, Span::from_static(&cx, "'")) {
                        bound.push(&cx, params.at(&cx, i));
                    }
                    i = i + 1usize;
                }
                self.type(&cx, body.copy(&cx), with(&cx, types, bound), false);
            },
            _ => (),
        }
    }

    fn slots(self, &cx: Domain!['k], slots: ArenaVec[S::Slot['k], 'k], types: ArenaVec[Span['k], 'k]) {
        var i = 0usize;
        while i < slots.len(&cx) {
            self.type(&cx, slots.at(&cx, i).type, types, false);
            i = i + 1usize;
        }
    }

    // The type, or with `is_trait` the trait, `n` writes: `target`, what its path names, unless that is
    // not one, which is reported.
    fn named_type(self, &cx: Domain!['k], n: S::TName['k], target: Target['k], is_trait: bool) {
        let not_a_type = Buffer!::new().push_bytes(&cx, n.path.join(&cx, "::")).push_static(" is not a type").save(&cx);
        match target {
            Target::Builtin(name) => if !is_trait {
                if is_builtin_type(&cx, name) {
                    self.set(&cx, n.id, NameRef::Builtin.(name));
                } else {
                    self.r.report(&cx, not_a_type, n.pos);
                }
                return;
            },
            _ => (),
        }
        match self.decl_of(&cx, n.path, target, if is_trait { "trait" } else { "" }, n.pos) {
            Option::Some(d) => if is_trait || d.kind.is(&cx, "struct") || d.kind.is(&cx, "enum") || d.kind.is(&cx, "tuple") {
                self.set(&cx, n.id, NameRef::Decl.(d));
            } else {
                self.r.report(&cx, not_a_type, n.pos);
            },
            Option::None => (),
        }
    }

    // ---- expressions
    // Resolve `e`; `values` are the locals in scope.
    fn expr(self, &cx: Domain!['k], e: Expr['k], types: ArenaVec[Span['k], 'k], values: ArenaVec[Span['k], 'k]) {
        match e {
            Expr::Path(p) => self.path(&cx, p, types, values),
            Expr::Block(b) => self.block(&cx, b, types, values),
            Expr::StructLit(s) => {
                let names = s.path.names(&cx);
                match self.decl(&cx, names, "struct", s.pos) {
                    Option::Some(d) => self.set(&cx, s.path.id, NameRef::Decl.(d)),
                    Option::None => (),
                }
                self.segment_args(&cx, s.path, types);
                var i = 0usize;
                while i < s.fields.len(&cx) {
                    let unit = match s.fields.at(&cx, i).value {
                        Option::Some(v) => self.expr(&cx, v, types, values),
                        Option::None => (),
                    };
                    i = i + 1usize;
                }
                i = 0usize;
                while i < s.fields.len(&cx) {
                    let f = s.fields.at(&cx, i);
                    if f.value.is_none() && !values.contains(&cx, f.name) {
                        self.r.report(&cx, Buffer!::new().push_static("unknown local ").push_bytes(&cx, f.name).save(&cx), s.pos);
                    }
                    i = i + 1usize;
                }
            },
            Expr::Match(m) => {
                self.expr(&cx, m.scrutinee.copy(&cx), types, values);
                var i = 0usize;
                while i < m.arms.len(&cx) {
                    let arm = m.arms.at(&cx, i);
                    let bound: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
                    var k = 0usize;
                    while k < arm.cases.len(&cx) {
                        let case = arm.cases.at(&cx, k);
                        let unit = match case.kind {
                            S::CaseKind::Variant => {
                                let path = match case.path {
                                    Option::Some(p) => p,
                                    Option::None => self.r.fail(&cx, Span::from_static(&cx, "internal error: a variant case without a path"), no_pos()),
                                };
                                self.variant(&cx, path);
                                self.segment_args(&cx, path, types);
                                let unit = match case.binders {
                                    Option::Some(bs) => {
                                        var b = 0usize;
                                        while b < bs.len(&cx) {
                                            if !bs.at(&cx, b).is(&cx, "_") && !bs.at(&cx, b).is_empty() {
                                                bound.push(&cx, bs.at(&cx, b));
                                            }
                                            b = b + 1usize;
                                        }
                                    },
                                    Option::None => (),
                                };
                            },
                            _ => (),
                        };
                        k = k + 1usize;
                    }
                    self.expr(&cx, arm.body, types, with(&cx, values, bound));
                    i = i + 1usize;
                }
            },
            Expr::Closure(c) => {
                let names: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
                var i = 0usize;
                while i < c.params.len(&cx) {
                    let p = c.params.at(&cx, i);
                    let unit = match p.type {
                        Option::Some(t) => self.type(&cx, t, types, false),
                        Option::None => (),
                    };
                    names.push(&cx, p.name);
                    i = i + 1usize;
                }
                let unit = match c.ret {
                    Option::Some(t) => self.type(&cx, t, types, false),
                    Option::None => (),
                };
                self.expr(&cx, c.body.copy(&cx), types, with(&cx, values, names));
            },
            Expr::Foreach(f) => {
                self.expr(&cx, f.source.copy(&cx), types, values);
                let inner = match f.binder {
                    Option::Some(b) => with_one(&cx, types, b),
                    Option::None => types,
                };
                self.block(&cx, f.body, inner, with_one(&cx, values, f.name));
            },
            Expr::Cast(c) => {
                self.expr(&cx, c.value.copy(&cx), types, values);
                self.type(&cx, c.type, types, false);
            },
            Expr::While(w) => {
                self.expr(&cx, w.cond.copy(&cx), types, values);
                self.block(&cx, w.body, types, values);
            },
            Expr::For(f) => {
                self.expr(&cx, f.iterator.copy(&cx), types, values);
                self.block(&cx, f.body, types, with_one(&cx, values, f.name));
            },
            Expr::Lit(l) => (),
            _ => {
                let parts = children(&cx, e);
                var i = 0usize;
                while i < parts.len(&cx) {
                    self.expr(&cx, parts.at(&cx, i), types, values);
                    i = i + 1usize;
                }
            },
        }
    }

    fn block(self, &cx: Domain!['k], b: S::Block['k], types: ArenaVec[Span['k], 'k], values: ArenaVec[Span['k], 'k]) {
        var values = values;
        var i = 0usize;
        while i < b.stmts.len(&cx) {
            values = self.stmt(&cx, b.stmts.at(&cx, i), types, values);
            i = i + 1usize;
        }
        let unit = match b.tail {
            Option::Some(t) => self.expr(&cx, t.copy(&cx), types, values),
            Option::None => (),
        };
    }

    fn stmt(self, &cx: Domain!['k], s: Statement['k], types: ArenaVec[Span['k], 'k], values: ArenaVec[Span['k], 'k]) -> ArenaVec[Span['k], 'k] {
        match s {
            Statement::Let(l) => {
                self.expr(&cx, l.value, types, values);
                let unit = match l.type {
                    Option::Some(t) => self.type(&cx, t, types, false),
                    Option::None => (),
                };
                with(&cx, values, bound(&cx, l.pattern))
            },
            Statement::Var(v) => {
                self.expr(&cx, v.value, types, values);
                let unit = match v.type {
                    Option::Some(t) => self.type(&cx, t, types, false),
                    Option::None => (),
                };
                with_one(&cx, values, v.name)
            },
            Statement::Const(c) => {
                self.type(&cx, c.type, types, false);
                self.expr(&cx, c.value, types, values);
                with_one(&cx, values, c.name)
            },
            Statement::Assign(a) => {
                self.expr(&cx, a.target, types, values);
                self.expr(&cx, a.value, types, values);
                values
            },
            Statement::Expr(n) => {
                self.expr(&cx, n.value, types, values);
                values
            },
        }
    }

    fn segment_args(self, &cx: Domain!['k], p: S::Path['k], types: ArenaVec[Span['k], 'k]) {
        var i = 0usize;
        while i < p.segments.len(&cx) {
            self.types(&cx, p.segments.at(&cx, i).args, types);
            i = i + 1usize;
        }
    }

    fn path(self, &cx: Domain!['k], p: S::Path['k], types: ArenaVec[Span['k], 'k], values: ArenaVec[Span['k], 'k]) {
        let names = p.names(&cx);
        self.segment_args(&cx, p, types);
        let first = names.at(&cx, 0usize);
        if names.len(&cx) == 1usize && values.contains(&cx, first) {
            self.set(&cx, p.id, NameRef::Local.(first));
        } else if names.len(&cx) == 2usize && is_prim(&cx, first) {
            let found = self.r.attached.get_or(&cx, (Owner::Prim.(first), names.at(&cx, 1usize)), ArenaVec::new(&cx));
            if found.is_empty(&cx) {
                self.r.report(&cx, Buffer!::new().push_static("unknown ").push_bytes(&cx, first).push_static("::").push_bytes(&cx, names.at(&cx, 1usize)).save(&cx), p.pos);
            } else {
                self.set(&cx, p.id, NameRef::Decl.(found.at(&cx, 0usize)));
            }
        } else if names.len(&cx) == 2usize && types.contains(&cx, first) {
            // a member of a type parameter, found by inference
            self.set(&cx, p.id, NameRef::Assoc.(first, names.at(&cx, 1usize)));
        } else {
            match self.seek(&cx, names, p.pos) {
                Option::Some(target) => match target {
                    Target::Module(m) => self.r.report(&cx, Buffer!::new().push_bytes(&cx, names.join(&cx, "::")).push_static(" is a module, not a value").save(&cx), p.pos),
                    Target::Decl(d) => self.set(&cx, p.id, NameRef::Decl.(d)),
                    Target::Variant(d, v) => self.set(&cx, p.id, NameRef::Variant.(d, v)),
                    Target::TraitMethod(d, m) => self.set(&cx, p.id, NameRef::TraitMethod.(d, m)),
                    Target::Builtin(name) => self.set(&cx, p.id, NameRef::Builtin.(name)),
                },
                Option::None => (),
            }
        }
    }

    fn variant(self, &cx: Domain!['k], path: S::Path['k]) {
        match self.seek(&cx, path.names(&cx), path.pos) {
            Option::Some(target) => match target {
                Target::Variant(d, v) => self.set(&cx, path.id, NameRef::Variant.(d, v)),
                _ => self.r.report(&cx, Buffer!::new().push_bytes(&cx, path.names(&cx).join(&cx, "::")).push_static(" is not an enum variant").save(&cx), path.pos),
            },
            Option::None => (),
        }
    }
}

forall 'k.
fn bound(&cx: Domain!['k], pattern: Pattern['k]) -> ArenaVec[Span['k], 'k] {
    let out: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
    let unit = match pattern {
        Pattern::Bind(n) => out.push(&cx, n.value),
        Pattern::Tuple(n) => bound_all(&cx, out, n.value),
        Pattern::Array(n) => bound_all(&cx, out, n.value),
        Pattern::Struct(s) => {
            var i = 0usize;
            while i < s.fields.len(&cx) {
                out.append(&cx, bound(&cx, s.fields.at(&cx, i).pattern));
                i = i + 1usize;
            }
            let unit = match s.rest {
                Option::Some(r) => out.push(&cx, r),
                Option::None => (),
            };
        },
        Pattern::Wild(id) => (),
    };
    out
}

forall 'k.
fn bound_all(&cx: Domain!['k], out: ArenaVec[Span['k], 'k], patterns: ArenaVec[Pattern['k], 'k]) {
    var i = 0usize;
    while i < patterns.len(&cx) {
        out.append(&cx, bound(&cx, patterns.at(&cx, i)));
        i = i + 1usize;
    }
}

// The subexpressions of the expression forms with no binding structure.
forall 'k.
fn children(&cx: Domain!['k], e: Expr['k]) -> ArenaVec[Expr['k], 'k] {
    let out: ArenaVec[Expr['k], 'k] = ArenaVec::new(&cx);
    let unit = match e {
        Expr::Tuple(n) => out.append(&cx, n.value),
        Expr::Array(a) => out.append(&cx, a.elems),
        Expr::FStr(f) => {
            var i = 0usize;
            while i < f.parts.len(&cx) {
                let unit = match f.parts.at(&cx, i) {
                    S::Piece::Expr(x) => out.push(&cx, x),
                    S::Piece::Text(t) => (),
                };
                i = i + 1usize;
            }
        },
        Expr::If(n) => {
            out.push(&cx, n.cond.copy(&cx));
            out.push(&cx, Expr::Block.(n.then));
            let unit = match n.other {
                Option::Some(o) => out.push(&cx, o.copy(&cx)),
                Option::None => (),
            };
        },
        Expr::Return(n) => {
            let unit = match n.value {
                Option::Some(v) => out.push(&cx, v.copy(&cx)),
                Option::None => (),
            };
        },
        Expr::Pack(p) => out.push(&cx, p.value.copy(&cx)),
        Expr::Binop(b) => {
            out.push(&cx, b.left.copy(&cx));
            out.push(&cx, b.right.copy(&cx));
        },
        Expr::Unary(u) => out.push(&cx, u.operand.copy(&cx)),
        Expr::UnsafeStore(s) => {
            out.push(&cx, s.pointer.copy(&cx));
            out.push(&cx, s.value.copy(&cx));
        },
        Expr::Field(f) => out.push(&cx, f.value.copy(&cx)),
        Expr::Index(x) => out.push(&cx, x.value.copy(&cx)),
        Expr::Try(n) => out.push(&cx, n.value.copy(&cx)),
        Expr::Call(c) => {
            out.push(&cx, c.callee.copy(&cx));
            out.append(&cx, c.args);
        },
        _ => fail(&cx, Span::from_static(&cx, "no resolution rule for this expression")),
    };
    out
}

// The resolved package graph rooted at `path`.
forall 'k.
fn resolve(&cx: Domain!['k], path: Span['k]) -> Resolver['k] {
    let ids = Ref::new(&cx, 0u32);
    let resolver = Resolver::new(&cx, load(&cx, path, ids), ids);
    if !resolver.packages.is_empty(&cx) {
        let package = resolver.packages.at(&cx, 0usize);
        let unit = match package.entry.copy(&cx) {
            Option::Some(entry) => {
                if !entry.is_empty(&cx) {
                    resolver.locate_manifest(&cx, package.manifest);
                    let not_entry = Span::from_static(&cx, "an executable's entry must be a function of its own package");
                    match resolver.lookup(&cx, ModuleId::root(&cx, package.id), entry, no_pos()) {
                        Result::Ok(target) => match target {
                            Target::Decl(d) => if !d.kind.is(&cx, "fn") || d.home.package != package.id {
                                resolver.report(&cx, not_entry, no_pos());
                            } else {
                                package.entry_decl.set(&cx, Option::Some.(d));
                            },
                            _ => resolver.report(&cx, not_entry, no_pos()),
                        },
                        Result::Err(e) => resolver.report(&cx, e.message, e.pos),
                    }
                    resolver.unlocate(&cx);
                }
            },
            Option::None => (),
        };
    }
    Names::new(&cx, resolver).run(&cx)
}
