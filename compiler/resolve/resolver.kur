// Packages and names: load the package graph, assign each source file its module, and resolve
// every type and value path to what it names.
//
// What a path names is kept in `Resolver.refs`, keyed by the id of the node that spells it: a
// type name (`TName`), an expression or case path (`Path`), or a premise's type arguments
// (`TypeArgs`, naming the premise's trait).
//   NameRef::Decl(d)               a declaration (struct, enum, tuple, fn, extern, trait, const, method)
//   NameRef::Variant(d, name)      an enum variant
//   NameRef::TraitMethod(d, name)  a trait's method, `Trait::method`
//   NameRef::Assoc(param, name)    a member of a type parameter, found by inference
//   NameRef::Param(name)           a type parameter in scope
//   NameRef::Local(name)           a local value
//   NameRef::Prim(name)            a primitive type
//   NameRef::Builtin(name)         a name the compiler gives meaning: `Copy`, `Exposed`, `Sized`, `Never`, and
//                                  what `builtin::name` names in package core (`Brand`, `fresh`, ...)

use package::support::base::fail;
use std::hash::key_eq;
use std::collections::arena_vec::ArenaVec;
use std::collections::arena_map::{ArenaMap, ArenaSet};
use std::mem::Ref;
use std::str::Str;
use std::arena::{Domain!, concat, ref_in};
use std::buffer::Buffer!;
use std::fmt::Writer;
use package::kurs::core::ModuleId;
use package::syntax::parser::parse;
use package::syntax::ast as S;
use package::syntax::ast::{Expr, Pattern, Pos, Statement, Type, no_pos};
use std::env::variable;
use std::fs::{canonicalize, path_exists, read_dir, read_to_arena};
use std::cmp::Order;
use std::hash::{HashIn, HashState};
use std::option::{Option, Result};
use std::slice::hash_bytes;
use std::utf8::validate;
use toml::parser::parse as parse_toml;
use toml::value::{TomlValue, line_column};

// Whether `name` is one of the space-separated `names`.
forall 'k.
fn among(&cx: Domain!['k], name: Str['k], names: Str['static]) -> bool {
    ArenaVec::split(&cx, Str::from_static(&cx, names), Str::from_static(&cx, " ")).contains(&cx, name)
}

forall 'k.
fn is_prim(&cx: Domain!['k], name: Str['k]) -> bool {
    among(&cx, name, "i8 i16 i32 i64 isize u8 u16 u32 u64 usize f32 f64 bool")
}

// Always in scope, like the primitives: the type `Never` and the traits.
forall 'k.
fn is_builtin_trait(&cx: Domain!['k], name: Str['k]) -> bool {
    among(&cx, name, "Copy Exposed Sized")
}

// What `builtin::name` names. Only package `core` writes such a path, and it exports each builtin
// from the module it belongs to (`export builtin::NonNull;` in core::ptr); everyone else imports it
// from there.
forall 'k.
fn is_builtin_type(&cx: Domain!['k], name: Str['k]) -> bool {
    among(&cx, name, "Brand NonNull")
}

forall 'k.
fn is_builtin_value(&cx: Domain!['k], name: Str['k]) -> bool {
    among(&cx, name, "fresh static_brand sizeof alloca enum_variant fence load_volatile store_volatile trap")
}

// The builtin types an impl may give methods, as it may a primitive: `impl NonNull[T]` in core::ptr.
forall 'k.
fn is_owned_builtin(&cx: Domain!['k], name: Str['k]) -> bool {
    name.is(&cx, "NonNull")
}

// The standard library's directory: `$KURSAL_LIB`, else `lib` beside the directory that holds the
// compiler's binary (an installation's `bin/kursal` and `lib/`).
forall 'k.
fn lib_dir(&cx: Domain!['k]) -> Str['k] {
    let configured = match variable(&cx, Str::from_static(&cx, "KURSAL_LIB")) {
        Some(v) => v.save(&cx),
        None => Str::from_static(&cx, ""),
    };
    if !configured.is_empty() {
        clean(&cx, configured)
    } else {
        match real_path(&cx, Str::from_static(&cx, "/proc/self/exe")) {
            Some(exe) => join(&cx, parent(&cx, parent(&cx, exe)), Str::from_static(&cx, "lib")),
            None => fail(&cx, Str::from_static(&cx, "set KURSAL_LIB to the standard library's directory")),
        }
    }
}

// ------------------------------------------------------------------ paths --

// `path` as Python's `Path` spells it: no repeated, trailing or `.` separators.
forall 'k.
fn clean(&cx: Domain!['k], path: Str['k]) -> Str['k] {
    let parts = ArenaVec::split(&cx, path, Str::from_static(&cx, "/"));
    var out = Buffer!::new();
    if path.starts_with(&cx, Str::from_static(&cx, "/")) {
        out = out.put("/");
    }
    var first = true;
    var i = 0usize;
    while i < parts.len(&cx) {
        let part = parts.at(&cx, i);
        if !part.is_empty() && !part.is(&cx, ".") {
            if !first {
                out = out.put("/");
            }
            out = out.write(&cx, part);
            first = false;
        }
        i = i + 1usize;
    }
    let n = &out.len();
    if n == 0usize {
        out.destroy();
        Str::from_static(&cx, ".")
    } else {
        out.save(&cx)
    }
}

// `a / b`: `b` when it is absolute.
forall 'k.
fn join(&cx: Domain!['k], a: Str['k], b: Str['k]) -> Str['k] {
    if b.starts_with(&cx, Str::from_static(&cx, "/")) || a.is_empty() || a.is(&cx, ".") {
        b
    } else if a.ends_with(&cx, Str::from_static(&cx, "/")) {
        concat(&cx, a, b)
    } else {
        f"{a}/{b}".write(&cx, Buffer!::new()).save(&cx)
    }
}

forall 'k.
fn parent(&cx: Domain!['k], path: Str['k]) -> Str['k] {
    match path.rfind_byte(&cx, b'/') {
        Some(at) => if at == 0usize { Str::from_static(&cx, "/") } else { path.slice(0usize, at) },
        None => Str::from_static(&cx, "."),
    }
}

// The last component.
forall 'k.
fn base_name(&cx: Domain!['k], path: Str['k]) -> Str['k] {
    match path.rfind_byte(&cx, b'/') {
        Some(at) => path.skip(at + 1usize),
        None => path,
    }
}

// The last component's extension, with its dot: `Path.suffix`.
forall 'k.
fn suffix(&cx: Domain!['k], path: Str['k]) -> Str['k] {
    let name = base_name(&cx, path);
    match name.rfind_byte(&cx, b'.') {
        Some(at) => if at > 0usize && at + 1usize < name.len() { name.skip(at) } else { Str::from_static(&cx, "") },
        None => Str::from_static(&cx, ""),
    }
}

// The last component without its extension: `Path.stem`.
forall 'k.
fn stem(&cx: Domain!['k], path: Str['k]) -> Str['k] {
    let name = base_name(&cx, path);
    name.slice(0usize, name.len() - suffix(&cx, name).len())
}

// The absolute path with no symbolic links that `path` names, if it exists.
forall 'k.
fn real_path(&cx: Domain!['k], path: Str['k]) -> Option[Str['k]] {
    match canonicalize(&cx, path) {
        Ok(r) => Option::Some.(r.save(&cx)),
        Err(e) => Option::None,
    }
}

// The absolute path with no symbolic links that `path` names, existing or not: `Path.resolve()`.
// The longest existing prefix has its links resolved; the rest is appended, with `..` removing the
// component before it.
forall 'k.
fn resolved(&cx: Domain!['k], path: Str['k]) -> Str['k] {
    if path.starts_with(&cx, Str::from_static(&cx, "/")) {
        resolve_absolute(&cx, path)
    } else {
        let cwd = match real_path(&cx, Str::from_static(&cx, ".")) {
            Some(c) => c,
            None => fail(&cx, Str::from_static(&cx, "cannot find the current directory")),
        };
        resolve_absolute(&cx, join(&cx, cwd, path))
    }
}

forall 'k.
fn resolve_absolute(&cx: Domain!['k], path: Str['k]) -> Str['k] {
    match real_path(&cx, path) {
        Some(r) => r,
        None => {
            if path.is(&cx, "/") {
                path
            } else {
                let base = resolve_absolute(&cx, parent(&cx, path));
                let name = base_name(&cx, path);
                if name.is_empty() || name.is(&cx, ".") {
                    base
                } else if name.is(&cx, "..") {
                    parent(&cx, base)
                } else {
                    let joined = join(&cx, base, name);
                    match real_path(&cx, joined) {
                        Some(r) => r,
                        None => joined,
                    }
                }
            }
        },
    }
}

// ------------------------------------------------------------- messages --

// `names` as a message lists them: `a`, `a and b`, `a, b and c`.
forall 'k.
fn listed(&cx: Domain!['k], names: ArenaVec[Str['k], 'k]) -> Str['k] {
    var out = Buffer!::new();
    var i = 0usize;
    while i < names.len(&cx) {
        if i > 0usize {
            out = out.put(if i + 1usize == names.len(&cx) { " and " } else { ", " });
        }
        out = out.write(&cx, names.at(&cx, i));
        i = i + 1usize;
    }
    out.save(&cx)
}

// ------------------------------------------------------------ the graph --

// A declaration: compared by its `id`, unique in the program.
forall 'k.
exposed struct Decl {
    id: u32,
    // struct enum tuple alias fn extern trait const method
    kind: Str['k],
    home: ModuleId['k],
    // a method's name is `Target::method`
    name: Str['k],
    node: Named['k],
    // a method's or associated const's impl
    impl_block: Option[S::Impl['k]],
}

forall 'k.
instance HashIn[Decl['k], Domain!['k]] {
    fn hash_in(&cx: Domain!['k], key: Decl['k], state: HashState) -> HashState {
        state.write_u64(key.id as u64)
    }

    fn eq_in(&cx: Domain!['k], a: Decl['k], b: Decl['k]) -> bool {
        let equal = a.id == b.id;
        equal
    }
}

// The item a declaration declares.
forall 'k.
exposed enum Named {
    Struct(S::StructDecl['k]),
    Enum(S::EnumDecl['k]),
    Tuple(S::TupleDecl['k]),
    Alias(S::TypeAlias['k]),
    Fn(S::Fn['k]),
    Extern(S::Extern['k]),
    Trait(S::TraitDecl['k]),
    Const(S::Const['k]),
}

forall 'k.
fn named_pos(n: Named['k]) -> Pos {
    match n {
        Struct(x) => x.pos,
        Enum(x) => x.pos,
        Tuple(x) => x.pos,
        Alias(x) => x.pos,
        Fn(x) => x.pos,
        Extern(x) => x.pos,
        Trait(x) => x.pos,
        Const(x) => x.pos,
    }
}

// Where a declaration writes its name: a type declaration's name, else where it starts.
forall 'k.
fn name_pos(n: Named['k]) -> Pos {
    match n {
        Struct(x) => x.name_pos,
        Enum(x) => x.name_pos,
        Tuple(x) => x.name_pos,
        Alias(x) => x.name_pos,
        _ => named_pos(n),
    }
}

forall 'k.
fn item_pos(item: S::Item['k]) -> Pos {
    match item {
        Use(x) => x.pos,
        Struct(x) => x.pos,
        Tuple(x) => x.pos,
        Enum(x) => x.pos,
        Alias(x) => x.pos,
        Fn(x) => x.pos,
        Extern(x) => x.pos,
        Const(x) => x.pos,
        Impl(x) => x.pos,
        Trait(x) => x.pos,
        Instance(x) => x.pos,
    }
}

forall 'k.
exposed struct Package {
    id: usize,
    name: Ref[Str['k], 'k],
    // its directory
    root: Str['k],
    source_root: Ref[Str['k], 'k],
    // alias -> package id
    deps: ArenaMap[Str['k], usize, 'k],
    // C compiler arguments, after source files; a build uses these from every package.
    link_flags: ArenaVec[Str['k], 'k],
    // Absolute paths to C sources declared relative to this package.
    c_sources: ArenaVec[Str['k], 'k],
    // an executable's entry path
    entry: Ref[Option[ArenaVec[Str['k], 'k]], 'k],
    // module -> source path
    files: ArenaMap[ModuleId['k], Str['k], 'k],
    entry_decl: Ref[Option[Decl['k]], 'k],
    // its kur.toml, or its one .kur file
    manifest: Str['k],
}

// One module's namespace.
forall 'k.
exposed struct Scope {
    home: ModuleId['k],
    decls: ArenaMap[Str['k], Decl['k], 'k],
    // alias -> path
    imports: ArenaMap[Str['k], ArenaVec[Str['k], 'k], 'k],
    // alias -> where its `use` names it
    import_pos: ArenaMap[Str['k], Pos, 'k],
    globs: ArenaVec[ArenaVec[Str['k], 'k], 'k],
    exports: ArenaSet[Str['k], 'k],
    items: ArenaVec[S::Item['k], 'k],
}

// What a path names.
forall 'k.
exposed enum Target {
    Decl(Decl['k]),
    Module(ModuleId['k]),
    Variant(Decl['k], Str['k]),
    TraitMethod(Decl['k], Str['k]),
    Builtin(Str['k]),
}

// What a resolved node names; see the top of this file.
forall 'k.
exposed enum NameRef {
    Decl(Decl['k]),
    Variant(Decl['k], Str['k]),
    TraitMethod(Decl['k], Str['k]),
    Assoc(Str['k], Str['k]),
    Param(Str['k]),
    Prim(Str['k]),
    Builtin(Str['k]),
    Local(Str['k]),
}

// A name's other spelling: without the `!` of a linear type's name, or with it.
forall 'k.
fn other_spelling(&cx: Domain!['k], name: Str['k]) -> Str['k] {
    if name.ends_with(&cx, Str::from_static(&cx, "!")) {
        name.slice(0usize, name.len() - 1usize)
    } else {
        concat(&cx, name, Str::from_static(&cx, "!"))
    }
}

// The end of the message for a name that names nothing, when its other spelling `other` names
// something.
forall 'k.
fn respelled(&cx: Domain!['k], out: Buffer!, other: Str['k]) -> Buffer! {
    if other.ends_with(&cx, Str::from_static(&cx, "!")) {
        out.put("; the linear type is ").write(&cx, other)
    } else {
        out.put("; ").write(&cx, other).put(" is not a linear type")
    }
}

// A resolution error, before its file is known; a `pos` on line 0 is no position.
forall 'k.
exposed struct Problem {
    message: Str['k],
    pos: Pos,
}

// What a method or associated const is attached to: a type declaration, a primitive type or a
// builtin type (`NonNull`), by name, or nothing, for a blanket impl whose methods are found by method
// calls only.
forall 'k.
exposed enum Owner {
    Decl(Decl['k]),
    Prim(Str['k]),
    Blanket,
}

forall 'k.
instance HashIn[Owner['k], Domain!['k]] {
    fn hash_in(&cx: Domain!['k], key: Owner['k], state: HashState) -> HashState {
        match key {
            Decl(d) => state.write_u64(1u64).write_u64(d.id as u64),
            Prim(name) => hash_bytes(&cx, name, state.write_u64(2u64)),
            Blanket => state.write_u64(3u64),
        }
    }

    fn eq_in(&cx: Domain!['k], a: Owner['k], b: Owner['k]) -> bool {
        let equal = {
            match a {
                Decl(x) => match b {
                    Decl(y) => x.id == y.id,
                    _ => false,
                },
                Prim(x) => match b {
                    Prim(y) => x.eq(&cx, y),
                    _ => false,
                },
                Blanket => match b {
                    Blanket => true,
                    _ => false,
                },
            }
        };
        equal
    }
}

// A file and a position errors inside it are reported at when they have none of their own, and
// where its errors sort (`Reported.rank`).
forall 'k.
exposed struct Location {
    file: Str['k],
    pos: Pos,
    rank: usize,
}

// A resolution error as printed, and where it sorts in source order: by its `rank`, 0 for a
// manifest's and 1 more than its module's place among the modules for a source file's, then by its
// position, then in the order it was found.
forall 'k.
exposed struct Reported {
    text: Str['k],
    rank: usize,
    line: u32,
    col: u32,
    seq: usize,
}

// Resolution, and then signatures, report at most this many errors, in source order, and how many
// more they found.
const ERROR_LIMIT: usize = 20;

forall 'k.
fn source_order(a: Reported['k], b: Reported['k]) -> Order {
    if a.rank != b.rank {
        if a.rank < b.rank { Order::Less } else { Order::Greater }
    } else if a.line != b.line {
        if a.line < b.line { Order::Less } else { Order::Greater }
    } else if a.col != b.col {
        if a.col < b.col { Order::Less } else { Order::Greater }
    } else if a.seq < b.seq {
        Order::Less
    } else if a.seq > b.seq {
        Order::Greater
    } else {
        Order::Equal
    }
}

// An error as `KursError` prints it: `line:col: message`, or the message alone.
forall 'k.
fn error_text(&cx: Domain!['k], message: Str['k], pos: Pos) -> Str['k] {
    if pos.line == 0u32 {
        message
    } else {
        f"{pos.line}:{pos.col}: {message}".write(&cx, Buffer!::new()).save(&cx)
    }
}

// The error `message` at `pos`, printed as `full`, naming `file` and, when it has no position of
// its own, the position `at` of the item it is in. Returns the new printed form and position.
forall 'k.
fn located(&cx: Domain!['k], full: Str['k], message: Str['k], pos: Pos, file: Str['k], at: Pos) -> (Str['k], Pos) {
    if full.starts_with(&cx, file) {
        (full, pos)
    } else {
        let at_pos = if pos.line != 0u32 { pos } else { at };
        let prefix = if at_pos.line != 0u32 {
            f"{file}:{at_pos.line}:{at_pos.col}".write(&cx, Buffer!::new()).save(&cx)
        } else {
            file
        };
        (f"{prefix}: {message}".write(&cx, Buffer!::new()).save(&cx), at_pos)
    }
}

// The package graph rooted at a package directory, its kur.toml, or one .kur file. A single file
// depends on the standard library `std` when one is installed (KURSAL_LIB). `ids` numbers the
// syntax nodes.
forall 'k.
fn load(&cx: Domain!['k], path: Str['k], ids: Ref[u32, 'k]) -> ArenaVec[Package['k], 'k] {
    let path = resolved(&cx, path);
    let packages: ArenaVec[Package['k], 'k] = ArenaVec::new(&cx);
    let by_dir: ArenaMap[Str['k], usize, 'k] = ArenaMap::new(&cx);
    if suffix(&cx, path).is(&cx, ".kur") {
        let items = parse(&cx, read_source(&cx, path), path, ids);
        var main = false;
        var i = 0usize;
        while i < items.len(&cx) {
            let unit = match items.at(&cx, i) {
                Fn(f) => {
                    if f.name.is(&cx, "main") {
                        main = true;
                    }
                },
                _ => (),
            };
            i = i + 1usize;
        }
        let std: ArenaMap[Str['k], Str['k], 'k] = ArenaMap::new(&cx);
        let lib = lib_dir(&cx);
        if exists_or_fail(&cx, join(&cx, join(&cx, lib, Str::from_static(&cx, "std")), Str::from_static(&cx, "kur.toml"))) {
            std.insert(&cx, Str::from_static(&cx, "std"), join(&cx, lib, Str::from_static(&cx, "std")));
        }
        let entry = if main { Option::Some.(ArenaVec::one(&cx, Str::from_static(&cx, "main"))) } else { Option::None };
        let unit = add(&cx, packages, by_dir, path, Option::Some.(stem(&cx, path)), Option::Some.(parent(&cx, path)), Option::Some.(std), entry);
        packages.at(&cx, 0usize).files.insert(&cx, ModuleId::root(&cx, 0usize), path);
    } else {
        let manifest = if suffix(&cx, path).is(&cx, ".toml") { path } else { join(&cx, path, Str::from_static(&cx, "kur.toml")) };
        let unit = add(&cx, packages, by_dir, manifest, Option::None, Option::None, Option::None, Option::None);
    }
    var p = 0usize;
    while p < packages.len(&cx) {
        let package = packages.at(&cx, p);
        if package.files.is_empty(&cx) {
            let found = discover(&cx, package);
            let modules = found.keys(&cx);
            var k = 0usize;
            while k < modules.len(&cx) {
                package.files.insert(&cx, modules.at(&cx, k), found.at(&cx, modules.at(&cx, k)));
                k = k + 1usize;
            }
            if !package.files.contains(&cx, ModuleId::root(&cx, package.id)) {
                fail(&cx, Buffer!::new().put("package ").write(&cx, package.name.copy(&cx)).put(" has no lib.kur in ").write(&cx, package.source_root.copy(&cx)).save(&cx));
            }
        }
        p = p + 1usize;
    }
    check_acyclic(&cx, packages);
    packages
}

// The text of the file at `path`, which must be UTF-8.
forall 'k.
fn read_source(&cx: Domain!['k], path: Str['k]) -> Str['k] {
    let text = match read_to_arena(&cx, path) {
        Ok(s) => s,
        Err(e) => fail(&cx, Buffer!::new().put("cannot read ").write(&cx, path).save(&cx)),
    };
    if !validate(&cx, text) {
        fail(&cx, Buffer!::new().write(&cx, path).put(" is not valid UTF-8").save(&cx));
    }
    text
}

// The package of `manifest` (a kur.toml, or a single .kur file), added with its dependencies
// unless its directory's manifest was added already.
forall 'k.
fn add(&cx: Domain!['k], packages: ArenaVec[Package['k], 'k], by_dir: ArenaMap[Str['k], usize, 'k], manifest: Str['k], name: Option[Str['k]], source_root: Option[Str['k]],
       deps: Option[ArenaMap[Str['k], Str['k], 'k]], entry: Option[ArenaVec[Str['k], 'k]]) -> usize {
    let root = parent(&cx, manifest);
    let is_toml = suffix(&cx, manifest).is(&cx, ".toml");
    if is_toml {
        let unit = match by_dir.get(&cx, root) {
            Some(id) => return id,
            None => (),
        };
    }
    let package = Package.{
        id: packages.len(&cx),
        name: ref_in(&cx, match name { Some(n) => n, None => base_name(&cx, root) }),
        root,
        source_root: ref_in(&cx, match source_root { Some(s) => s, None => root }),
        deps: ArenaMap::new(&cx),
        link_flags: ArenaVec::new(&cx),
        c_sources: ArenaVec::new(&cx),
        entry: ref_in(&cx, entry),
        files: ArenaMap::new(&cx),
        entry_decl: ref_in(&cx, Option::None),
        manifest,
    };
    packages.push(&cx, package);
    var deps: ArenaMap[Str['k], Str['k], 'k] = match deps {
        Some(d) => d,
        None => ArenaMap::new(&cx),
    };
    if is_toml {
        by_dir.insert(&cx, root, package.id);
        let config = manifest_table(&cx, manifest);
        let info = table(&cx, config.get_or(&cx, Str::from_static(&cx, "package"), TomlValue::Table.(ArenaMap::new(&cx))), in_manifest(&cx, manifest, Str::from_static(&cx, "package")));
        let deps_table = table(&cx, config.get_or(&cx, Str::from_static(&cx, "dependencies"), TomlValue::Table.(ArenaMap::new(&cx))), in_manifest(&cx, manifest, Str::from_static(&cx, "dependencies")));
        let aliases = deps_table.keys(&cx);
        let specs: ArenaVec[ArenaMap[Str['k], TomlValue['k], 'k], 'k] = ArenaVec::new(&cx);
        var k = 0usize;
        while k < aliases.len(&cx) {
            specs.push(&cx, table(&cx, deps_table.at(&cx, aliases.at(&cx, k)), in_manifest(&cx, manifest, aliases.at(&cx, k))));
            k = k + 1usize;
        }
        let unknown: ArenaSet[Str['k], 'k] = ArenaSet::new(&cx);
        let config_keys = config.keys(&cx);
        var i = 0usize;
        while i < config_keys.len(&cx) {
            let key = config_keys.at(&cx, i);
            if !key.is(&cx, "package") && !key.is(&cx, "dependencies") {
                unknown.insert(&cx, key);
            }
            i = i + 1usize;
        }
        let info_keys = info.keys(&cx);
        i = 0usize;
        while i < info_keys.len(&cx) {
            let key = info_keys.at(&cx, i);
            if !among(&cx, key, "name kind source_root entry link_flags c_sources") {
                unknown.insert(&cx, key);
            }
            i = i + 1usize;
        }
        k = 0usize;
        while k < specs.len(&cx) {
            let spec_keys = specs.at(&cx, k).keys(&cx);
            i = 0usize;
            while i < spec_keys.len(&cx) {
                if !spec_keys.at(&cx, i).is(&cx, "path") {
                    unknown.insert(&cx, spec_keys.at(&cx, i));
                }
                i = i + 1usize;
            }
            k = k + 1usize;
        }
        if unknown.len(&cx) > 0usize {
            let names = unknown.keys(&cx);
            names.sort_by(&cx, |&cx, a, b| a.cmp(&cx, b));
            fail(&cx, Buffer!::new().write(&cx, manifest).put(if names.len(&cx) > 1usize { ": unknown manifest keys " } else { ": unknown manifest key " })
                .write(&cx, listed(&cx, names)).save(&cx));
        }
        package.name.set(&cx, string(&cx, info, manifest, "name", Option::None));
        package.source_root.set(&cx, resolved(&cx, join(&cx, root, string(&cx, info, manifest, "source_root", Option::Some.(Str::from_static(&cx, "src"))))));
        let flags = strings(&cx, info, manifest, "link_flags");
        var f = 0usize;
        while f < flags.len(&cx) {
            package.link_flags.push(&cx, flags.at(&cx, f));
            f = f + 1usize;
        }
        let sources = strings(&cx, info, manifest, "c_sources");
        f = 0usize;
        while f < sources.len(&cx) {
            package.c_sources.push(&cx, resolved(&cx, join(&cx, root, sources.at(&cx, f))));
            f = f + 1usize;
        }
        let kind = string(&cx, info, manifest, "kind", Option::Some.(Str::from_static(&cx, "library")));
        if !kind.is(&cx, "library") && !kind.is(&cx, "executable") {
            fail(&cx, Buffer!::new().write(&cx, manifest).put(": manifest kind must be \"library\" or \"executable\"").save(&cx));
        }
        if kind.is(&cx, "executable") {
            let parts = ArenaVec::split(&cx, string(&cx, info, manifest, "entry", Option::None), Str::from_static(&cx, "::"));
            let path: ArenaVec[Str['k], 'k] = ArenaVec::new(&cx);
            var k = 0usize;
            while k < parts.len(&cx) {
                if !parts.at(&cx, k).is(&cx, "package") {
                    path.push(&cx, parts.at(&cx, k));
                }
                k = k + 1usize;
            }
            package.entry.set(&cx, Option::Some.(path));
        } else if info.contains(&cx, Str::from_static(&cx, "entry")) {
            fail(&cx, Buffer!::new().write(&cx, manifest).put(": manifest entry is only for kind \"executable\"").save(&cx));
        }
        deps = ArenaMap::new(&cx);
        k = 0usize;
        while k < aliases.len(&cx) {
            deps.insert(&cx, aliases.at(&cx, k), resolved(&cx, join(&cx, root, string(&cx, specs.at(&cx, k), manifest, "path", Option::None))));
            k = k + 1usize;
        }
    }
    let aliases = deps.keys(&cx);
    var k = 0usize;
    while k < aliases.len(&cx) {
        let target = deps.at(&cx, aliases.at(&cx, k));
        let manifest_path = if suffix(&cx, target).is(&cx, ".toml") { target } else { join(&cx, target, Str::from_static(&cx, "kur.toml")) };
        package.deps.insert(&cx, aliases.at(&cx, k), add(&cx, packages, by_dir, manifest_path, Option::None, Option::None, Option::None, Option::None));
        k = k + 1usize;
    }
    package.id
}

// The table of the manifest at `path`, read by the standard library's `toml`. A manifest that is not
// TOML is an error on the line where reading it stopped.
forall 'k.
fn manifest_table(&cx: Domain!['k], path: Str['k]) -> ArenaMap[Str['k], TomlValue['k], 'k] {
    let source = read_source(&cx, path);
    match parse_toml(&cx, source) {
        Ok(t) => t,
        Err(e) => {
            let (line, column) = line_column(&cx, source, e.offset);
            fail(&cx, f"{path}:{line}: invalid manifest".write(&cx, Buffer!::new()).save(&cx))
        },
    }
}

forall 'k.
fn table(&cx: Domain!['k], value: TomlValue['k], at_pos: Str['k]) -> ArenaMap[Str['k], TomlValue['k], 'k] {
    match value.as_table() {
        Some(t) => t,
        None => fail(&cx, Buffer!::new().write(&cx, at_pos).put(": expected a table").save(&cx)),
    }
}

// `MANIFEST: where`, for an error in the manifest.
forall 'k.
fn in_manifest(&cx: Domain!['k], manifest: Str['k], at_pos: Str['k]) -> Str['k] {
    f"{manifest}: {at_pos}".write(&cx, Buffer!::new()).save(&cx)
}

// The string `t`, a table of `manifest`, holds at `key`, else `default`.
forall 'k.
fn string(&cx: Domain!['k], t: ArenaMap[Str['k], TomlValue['k], 'k], manifest: Str['k], key: Str['static], default: Option[Str['k]]) -> Str['k] {
    let value = match t.get(&cx, Str::from_static(&cx, key)) {
        Some(v) => v.as_string(),
        None => default,
    };
    match value {
        Some(s) => s,
        None => fail(&cx, f"{manifest}: manifest {key} must be a string".write(&cx, Buffer!::new()).save(&cx)),
    }
}

// An optional array of command arguments or source paths in a manifest.
forall 'k.
fn strings(&cx: Domain!['k], t: ArenaMap[Str['k], TomlValue['k], 'k], manifest: Str['k], key: Str['static]) -> ArenaVec[Str['k], 'k] {
    let values = match t.get(&cx, Str::from_static(&cx, key)) {
        Some(value) => match value.as_array() {
            Some(items) => items,
            None => fail(&cx, f"{manifest}: manifest {key} must be an array of nonempty strings without NUL".write(&cx, Buffer!::new()).save(&cx)),
        },
        None => ArenaVec::new(&cx),
    };
    let out: ArenaVec[Str['k], 'k] = ArenaVec::new(&cx);
    var i = 0usize;
    while i < values.len(&cx) {
        let value = match values.at(&cx, i).as_string() {
            Some(s) => s,
            None => fail(&cx, f"{manifest}: manifest {key} must be an array of nonempty strings without NUL".write(&cx, Buffer!::new()).save(&cx)),
        };
        if value.is_empty() || !value.find_byte(&cx, 0u8, 0usize).is_none() {
            fail(&cx, f"{manifest}: manifest {key} must be an array of nonempty strings without NUL".write(&cx, Buffer!::new()).save(&cx));
        }
        out.push(&cx, value);
        i = i + 1usize;
    }
    out
}

// Whether `path` names anything. An error other than its absence stops resolution: the file may be
// there.
forall 'k.
fn exists_or_fail(&cx: Domain!['k], path: Str['k]) -> bool {
    match path_exists(&cx, path) {
        Ok(found) => found,
        Err(e) => fail(&cx, f"cannot read {path} (error {e.errno})".write(&cx, Buffer!::new()).save(&cx)),
    }
}

// Each .kur file under the source root, by the module its path assigns.
forall 'k.
fn discover(&cx: Domain!['k], package: Package['k]) -> ArenaMap[ModuleId['k], Str['k], 'k] {
    let files: ArenaMap[ModuleId['k], Str['k], 'k] = ArenaMap::new(&cx);
    walk(&cx, package, package.source_root.copy(&cx), ArenaVec::new(&cx), files);
    files
}

// The files of directory `here`, at `rel` under the source root, then its subdirectories in order;
// a subdirectory with its own kur.toml is another package.
forall 'k.
fn walk(&cx: Domain!['k], package: Package['k], here: Str['k], rel: ArenaVec[Str['k], 'k], files: ArenaMap[ModuleId['k], Str['k], 'k]) {
    let dirs: ArenaVec[Str['k], 'k] = ArenaVec::new(&cx);
    let names: ArenaVec[Str['k], 'k] = ArenaVec::new(&cx);
    match read_dir(&cx, here) {
        Ok(directory) => {
            var directory = directory;
            // Asked only of a directory that could be listed, as the reference's `os.walk` asks.
            if !rel.is_empty(&cx) && exists_or_fail(&cx, join(&cx, here, Str::from_static(&cx, "kur.toml"))) {
                let closed = directory.close();
                return;
            }
            var going = true;
            while going {
                match &directory.next() {
                    Ok(next) => match next {
                        Some(entry) => {
                            let { name, is_directory } = entry;
                            if is_directory {
                                dirs.push(&cx, name.save(&cx));
                            } else {
                                names.push(&cx, name.save(&cx));
                            }
                        },
                        None => {
                            going = false;
                        },
                    },
                    Err(e) => {
                        going = false;
                    },
                }
            }
            let closed = directory.close();
        },
        Err(e) => (),
    }
    var i = 0usize;
    dirs.sort_by(&cx, |&cx, a, b| a.cmp(&cx, b));
    names.sort_by(&cx, |&cx, a, b| a.cmp(&cx, b));
    i = 0usize;
    while i < names.len(&cx) {
        let name = names.at(&cx, i);
        if name.ends_with(&cx, Str::from_static(&cx, ".kur")) {
            let path = rel.clone(&cx);
            let module_name = stem(&cx, name);
            if !module_name.is(&cx, "lib") {
                path.push(&cx, module_name);
            }
            let home = ModuleId.{ package: package.id, path };
            if files.contains(&cx, home) {
                fail(&cx, Buffer!::new().put("two files define module ").write(&cx, path.join(&cx, "::")).put(" of ").write(&cx, package.name.copy(&cx)).save(&cx));
            }
            files.insert(&cx, home, join(&cx, here, name));
        }
        i = i + 1usize;
    }
    i = 0usize;
    while i < dirs.len(&cx) {
        let sub = rel.clone(&cx);
        sub.push(&cx, dirs.at(&cx, i));
        walk(&cx, package, join(&cx, here, dirs.at(&cx, i)), sub, files);
        i = i + 1usize;
    }
}

forall 'k.
fn check_acyclic(&cx: Domain!['k], packages: ArenaVec[Package['k], 'k]) {
    let state: ArenaMap[usize, u32, 'k] = ArenaMap::new(&cx);
    var p = 0usize;
    while p < packages.len(&cx) {
        visit(&cx, packages, state, p);
        p = p + 1usize;
    }
}

forall 'k.
fn visit(&cx: Domain!['k], packages: ArenaVec[Package['k], 'k], state: ArenaMap[usize, u32, 'k], package_id: usize) {
    let s = state.get_or(&cx, package_id, 0u32);
    if s == 1u32 {
        fail(&cx, Buffer!::new().put("dependency cycle through package ").write(&cx, packages.at(&cx, package_id).name.copy(&cx)).save(&cx));
    }
    if s == 0u32 {
        state.insert(&cx, package_id, 1u32);
        let deps = packages.at(&cx, package_id).deps.values(&cx);
        var i = 0usize;
        while i < deps.len(&cx) {
            visit(&cx, packages, state, deps.at(&cx, i));
            i = i + 1usize;
        }
        state.insert(&cx, package_id, 2u32);
    }
}

// ------------------------------------------------------------ namespaces --

// A lookup: `("path", module, path)`, `("import", module, [alias])` or `("export", module, [name])`.
forall 'k.
fn lookup_key(&cx: Domain!['k], kind: Str['static], home: ModuleId['k], names: ArenaVec[Str['k], 'k]) -> (Str['k], ModuleId['k], ArenaVec[Str['k], 'k]) {
    (Str::from_static(&cx, kind), home, names)
}

forall 'k.
fn only_core(&cx: Domain!['k]) -> Str['k] {
    Str::from_static(&cx, "only package core names builtins; import them from core")
}

// The error for a type alias written where a value, a constructor or a namespace belongs.
forall 'k.
fn alias_names_a_type(&cx: Domain!['k], alias: Decl['k]) -> Str['k] {
    f"{alias.name} is a type alias; it stands only where a type is written".write(&cx, Buffer!::new()).save(&cx)
}

forall 'k.
fn problem(message: Str['k]) -> Result[Target['k], Problem['k]] {
    Result::Err.(Problem.{ message, pos: no_pos() })
}

forall 'k.
exposed struct Resolver {
    packages: ArenaVec[Package['k], 'k],
    scopes: ArenaMap[ModuleId['k], Scope['k], 'k],
    children: ArenaMap[ModuleId['k], ArenaMap[Str['k], ModuleId['k], 'k], 'k],
    instances: ArenaVec[(ModuleId['k], S::InstanceDecl['k]), 'k],
    // (owner, member) -> declarations
    attached: ArenaMap[(Owner['k], Str['k]), ArenaVec[Decl['k], 'k], 'k],
    cache: ArenaMap[(Str['k], ModuleId['k], ArenaVec[Str['k], 'k]), Target['k], 'k],
    active: ArenaSet[(Str['k], ModuleId['k], ArenaVec[Str['k], 'k]), 'k],
    // the glob imports being resolved, by module and path
    expanding: ArenaSet[(ModuleId['k], ArenaVec[Str['k], 'k]), 'k],
    // the names being looked up through a module's glob imports
    searching: ArenaSet[(ModuleId['k], Str['k]), 'k],
    // node id -> what it names
    refs: ArenaMap[u32, NameRef['k], 'k],
    // The files and positions errors are reported in, innermost last.
    locations: ArenaVec[Location['k], 'k],
    decl_ids: Ref[u32, 'k],
    // After parsing, the exclusive upper bound on syntax node IDs.
    node_ids: Ref[u32, 'k],
    // the errors reported so far, and their texts
    errors: ArenaVec[Reported['k], 'k],
    reported: ArenaSet[Str['k], 'k],
    // module -> its place among the modules
    order: ArenaMap[ModuleId['k], usize, 'k],
}

forall 'k.
impl Resolver['k] {
    fn new(&cx: Domain!['k], packages: ArenaVec[Package['k], 'k], ids: Ref[u32, 'k]) -> Resolver['k] {
        let r = Resolver.{
            packages,
            scopes: ArenaMap::new(&cx),
            children: ArenaMap::new(&cx),
            instances: ArenaVec::new(&cx),
            attached: ArenaMap::new(&cx),
            cache: ArenaMap::new(&cx),
            active: ArenaSet::new(&cx),
            expanding: ArenaSet::new(&cx),
            searching: ArenaSet::new(&cx),
            refs: ArenaMap::new(&cx),
            locations: ArenaVec::new(&cx),
            decl_ids: ref_in(&cx, 0u32),
            node_ids: ids,
            errors: ArenaVec::new(&cx),
            reported: ArenaSet::new(&cx),
            order: ArenaMap::new(&cx),
        };
        var p = 0usize;
        while p < packages.len(&cx) {
            let package = packages.at(&cx, p);
            let unit = r.children_of(&cx, ModuleId::root(&cx, package.id));
            let modules = package.files.keys(&cx);
            var i = 0usize;
            while i < modules.len(&cx) {
                let home = modules.at(&cx, i);
                let file = package.files.at(&cx, home);
                r.order.insert(&cx, home, r.order.len(&cx));
                r.collect(&cx, home, parse(&cx, read_source(&cx, file), file, ids));
                var k = 0usize;
                while k < home.path.len(&cx) {
                    let parent = ModuleId.{ package: home.package, path: home.path.slice(&cx, 0usize, k) };
                    let name = home.path.at(&cx, k);
                    r.children_of(&cx, parent).insert(&cx, name, parent.child(&cx, name));
                    let unit = r.children_of(&cx, parent.child(&cx, name));
                    k = k + 1usize;
                }
                i = i + 1usize;
            }
            p = p + 1usize;
        }
        let scopes = r.scopes.values(&cx);
        var s = 0usize;
        while s < scopes.len(&cx) {
            r.attach(&cx, scopes.at(&cx, s));
            s = s + 1usize;
        }
        r
    }

    // `children.setdefault(module, {})`.
    fn children_of(self, &cx: Domain!['k], home: ModuleId['k]) -> ArenaMap[Str['k], ModuleId['k], 'k] {
        match self.children.get(&cx, home) {
            Some(c) => c,
            None => {
                let c: ArenaMap[Str['k], ModuleId['k], 'k] = ArenaMap::new(&cx);
                self.children.insert(&cx, home, c);
                c
            },
        }
    }

    fn new_decl(self, &cx: Domain!['k], kind: Str['static], home: ModuleId['k], name: Str['k], node: Named['k], impl_block: Option[S::Impl['k]]) -> Decl['k] {
        let id = self.decl_ids.copy(&cx);
        self.decl_ids.set(&cx, id + 1u32);
        Decl.{ id, kind: Str::from_static(&cx, kind), home, name, node, impl_block }
    }

    fn collect(self, &cx: Domain!['k], home: ModuleId['k], items: ArenaVec[S::Item['k], 'k]) {
        let scope = Scope.{ home, decls: ArenaMap::new(&cx), imports: ArenaMap::new(&cx), import_pos: ArenaMap::new(&cx), globs: ArenaVec::new(&cx), exports: ArenaSet::new(&cx), items };
        self.scopes.insert(&cx, home, scope);
        var i = 0usize;
        while i < items.len(&cx) {
            self.locate(&cx, home, item_pos(items.at(&cx, i)));
            let unit = match items.at(&cx, i) {
                Use(u) => self.use_tree(&cx, scope, ArenaVec::new(&cx), u.tree, u.is_export),
                Instance(n) => self.instances.push(&cx, (home, n)),
                Struct(x) => { let declared = self.declare(&cx, scope, self.new_decl(&cx, "struct", home, x.name, Named::Struct.(x), Option::None)); },
                Enum(x) => { let declared = self.declare(&cx, scope, self.new_decl(&cx, "enum", home, x.name, Named::Enum.(x), Option::None)); },
                Tuple(x) => { let declared = self.declare(&cx, scope, self.new_decl(&cx, "tuple", home, x.name, Named::Tuple.(x), Option::None)); },
                Alias(x) => { let declared = self.declare(&cx, scope, self.new_decl(&cx, "alias", home, x.name, Named::Alias.(x), Option::None)); },
                Fn(x) => { let declared = self.declare(&cx, scope, self.new_decl(&cx, "fn", home, x.name, Named::Fn.(x), Option::None)); },
                Extern(x) => { let declared = self.declare(&cx, scope, self.new_decl(&cx, "extern", home, x.name, Named::Extern.(x), Option::None)); },
                Trait(x) => { let declared = self.declare(&cx, scope, self.new_decl(&cx, "trait", home, x.name, Named::Trait.(x), Option::None)); },
                Const(x) => { let declared = self.declare(&cx, scope, self.new_decl(&cx, "const", home, x.name, Named::Const.(x), Option::None)); },
                Impl(x) => (),
            };
            self.unlocate(&cx);
            i = i + 1usize;
        }
    }

    // Declares `decl` in `scope`, unless its name is taken, which is reported; whether it did.
    fn declare(self, &cx: Domain!['k], scope: Scope['k], decl: Decl['k]) -> bool {
        if scope.decls.contains(&cx, decl.name) || scope.imports.contains(&cx, decl.name) {
            self.report(&cx, f"duplicate name {decl.name}".write(&cx, Buffer!::new()).save(&cx), named_pos(decl.node));
            return false;
        }
        scope.decls.insert(&cx, decl.name, decl);
        true
    }

    // The names a `use` tree imports; its errors are at where the tree starts.
    fn use_tree(self, &cx: Domain!['k], scope: Scope['k], prefix: ArenaVec[Str['k], 'k], tree: S::UseTree['k], exported: bool) {
        let path = prefix.clone(&cx);
        path.append(&cx, tree.path);
        if path.at(&cx, 0usize).is(&cx, "builtin") && !self.in_core(&cx, scope.home) {
            self.report(&cx, only_core(&cx), tree.pos);
            return;
        }
        if tree.star {
            scope.globs.push(&cx, path);
        } else if !tree.children.is_empty(&cx) {
            var i = 0usize;
            while i < tree.children.len(&cx) {
                self.use_tree(&cx, scope, path, tree.children.at(&cx, i), exported);
                i = i + 1usize;
            }
        } else {
            let last = path.at(&cx, path.len(&cx) - 1usize);
            let name = match tree.alias {
                Some(a) => {
                    let linear = last.ends_with(&cx, Str::from_static(&cx, "!"));
                    // still imported under the alias, so that its uses report nothing more
                    if a.ends_with(&cx, Str::from_static(&cx, "!")) != linear {
                        self.report(&cx, Buffer!::new().put("the alias ").write(&cx, a).put(" of ").write(&cx, last)
                            .put(if linear { " must end with !" } else { " must not end with !" }).save(&cx), tree.pos);
                    }
                    a
                },
                None => last,
            };
            // `export name;` publishes an existing name
            if exported && path.len(&cx) == 1usize && path.at(&cx, 0usize).eq(&cx, name) {
                scope.exports.insert(&cx, name);
                return;
            }
            if name.is(&cx, "package") || name.is(&cx, "builtin") || is_builtin_trait(&cx, name) {
                self.report(&cx, Buffer!::new().write(&cx, name).put(" is compiler-sealed").save(&cx), tree.pos);
                return;
            }
            if scope.imports.contains(&cx, name) || scope.decls.contains(&cx, name) {
                self.report(&cx, Buffer!::new().put("duplicate import ").write(&cx, name).save(&cx), tree.pos);
                return;
            }
            scope.imports.insert(&cx, name, path);
            scope.import_pos.insert(&cx, name, tree.pos);
            if exported {
                scope.exports.insert(&cx, name);
            }
        }
    }

    // Methods and associated consts are declared by their impl's module and attached to the impl's
    // target type for `Target::name` lookup.
    fn attach(self, &cx: Domain!['k], scope: Scope['k]) {
        var i = 0usize;
        while i < scope.items.len(&cx) {
            let unit = match scope.items.at(&cx, i) {
                Impl(m) => {
                    self.locate(&cx, scope.home, m.pos);
                    self.attach_impl(&cx, scope, m);
                    self.unlocate(&cx);
                },
                _ => (),
            };
            i = i + 1usize;
        }
    }

    fn attach_impl(self, &cx: Domain!['k], scope: Scope['k], item: S::Impl['k]) {
        let target = match item.ty {
            Name(n) => n,
            _ => {
                self.report(&cx, Str::from_static(&cx, "an impl target must be a named type"), item.pos);
                return;
            },
        };
        var spelled = target.path.at(&cx, target.path.len(&cx) - 1usize);
        let params = match item.quantifier {
            Some(f) => f.params,
            None => ArenaVec::new(&cx),
        };
        let alone = target.path.at(&cx, 0usize);
        var owner = if target.path.len(&cx) == 1usize && is_prim(&cx, alone) {
            Owner::Prim.(target.path.at(&cx, 0usize))
        } else if target.path.len(&cx) == 1usize && params.contains(&cx, target.path.at(&cx, 0usize)) {
            // a blanket impl: its methods are found by method calls only
            Owner::Blanket
        } else {
            self.impl_owner(&cx, scope.home, target)
        };
        let unit = match owner {
            Decl(d) => if d.kind.is(&cx, "alias") {
                match self.aliased(&cx, d, target.pos) {
                    Some(o) => {
                        owner = o;
                        spelled = match o {
                            Decl(e) => e.name,
                            Prim(name) => name,
                            Blanket => spelled,
                        };
                    },
                    None => return,
                }
            },
            _ => (),
        };
        self.impl_home(&cx, scope.home, owner, target);
        var k = 0usize;
        while k < item.items.len(&cx) {
            let decl = match item.items.at(&cx, k) {
                Fn(f) => self.new_decl(&cx, "method", scope.home, f"{spelled}::{f.name}".write(&cx, Buffer!::new()).save(&cx), Named::Fn.(f), Option::Some.(item)),
                Const(c) => self.new_decl(&cx, "const", scope.home, f"{spelled}::{c.name}".write(&cx, Buffer!::new()).save(&cx), Named::Const.(c), Option::Some.(item)),
            };
            let member = match item.items.at(&cx, k) {
                Fn(f) => f.name,
                Const(c) => c.name,
            };
            if self.declare(&cx, scope, decl) {
                let key = (owner, member);
                match self.attached.get(&cx, key) {
                    Some(found) => found.push(&cx, decl),
                    None => { self.attached.insert(&cx, key, ArenaVec::one(&cx, decl)); },
                }
            }
            k = k + 1usize;
        }
    }

    // What an impl written through the type alias `alias`, at `pos`, gives methods: the type
    // declaration, or the primitive or builtin type, that the alias stands for. Nothing when an alias on
    // the way refers to itself, which is reported where it is declared, or when it stands for no such
    // type, which is reported at `pos`.
    fn aliased(self, &cx: Domain!['k], alias: Decl['k], pos: Pos) -> Option[Owner['k]] {
        let seen: ArenaSet[u32, 'k] = ArenaSet::new(&cx);
        var found = Target::Decl.(alias);
        var going = true;
        while going {
            going = false;
            let unit = match found {
                Decl(d) => match d.node {
                    Alias(a) => {
                        if seen.contains(&cx, d.id) {
                            return Option::None;
                        }
                        seen.insert(&cx, d.id);
                        let body = match a.body {
                            Name(n) => n,
                            _ => {
                                self.report(&cx, Str::from_static(&cx, "an impl target must be a named type"), pos);
                                return Option::None;
                            },
                        };
                        let first = body.path.at(&cx, 0usize);
                        let params = match a.quantifier {
                            Some(f) => f.params,
                            None => ArenaVec::new(&cx),
                        };
                        if body.path.len(&cx) == 1usize && params.contains(&cx, first) {
                            self.report(&cx, Str::from_static(&cx, "an impl target must name a type declaration"), pos);
                            return Option::None;
                        }
                        if body.path.len(&cx) == 1usize && is_prim(&cx, first) {
                            return Option::Some.(Owner::Prim.(first));
                        }
                        match self.lookup(&cx, d.home, body.path, no_pos()) {
                            Ok(t) => {
                                found = t;
                                going = true;
                            },
                            Err(_e) => {
                                self.report(&cx, Str::from_static(&cx, "an impl target must name a type declaration"), pos);
                                return Option::None;
                            },
                        }
                    },
                    _ => (),
                },
                _ => (),
            };
        }
        match found {
            Builtin(name) => if is_owned_builtin(&cx, name) {
                return Option::Some.(Owner::Prim.(name));
            },
            Decl(d) => if d.kind.is(&cx, "struct") || d.kind.is(&cx, "enum") || d.kind.is(&cx, "tuple") {
                return Option::Some.(Owner::Decl.(d));
            },
            _ => (),
        }
        self.report(&cx, Str::from_static(&cx, "an impl target must name a type declaration"), pos);
        Option::None
    }

    // An inherent impl is in the package that declares its type, and one of a primitive or builtin
    // type is in core: no other package adds a method to a type, which could clash with the type's own.
    fn impl_home(self, &cx: Domain!['k], home: ModuleId['k], owner: Owner['k], target: S::TName['k]) {
        match owner {
            Prim(name) => if !self.in_core(&cx, home) {
                self.report(&cx, f"an inherent impl of {name} belongs in core".write(&cx, Buffer!::new()).save(&cx), target.pos);
            },
            Decl(d) => if d.home.package != home.package {
                self.report(&cx, f"an inherent impl of {d.name} belongs in the package that declares it".write(&cx, Buffer!::new()).save(&cx), target.pos);
            },
            Blanket => (),
        }
    }

    // What `impl target` gives methods. When `target` names nothing but its other spelling names a
    // type, the error is reported and the methods go to that type, so that their uses report nothing
    // more.
    fn impl_owner(self, &cx: Domain!['k], home: ModuleId['k], target: S::TName['k]) -> Owner['k] {
        match self.lookup(&cx, home, target.path, target.pos) {
            Ok(found) => match found {
                Builtin(name) => if is_owned_builtin(&cx, name) {
                    Owner::Prim.(name)
                } else {
                    self.report(&cx, Str::from_static(&cx, "an impl target must name a type declaration"), target.pos);
                    Owner::Blanket
                },
                Decl(d) => Owner::Decl.(d),
                _ => {
                    self.report(&cx, Str::from_static(&cx, "an impl target must name a type declaration"), target.pos);
                    Owner::Blanket
                },
            },
            Err(e) => {
                self.report(&cx, e.message, e.pos);
                let n = target.path.len(&cx);
                let other = target.path.slice(&cx, 0usize, n - 1usize);
                other.push(&cx, other_spelling(&cx, target.path.at(&cx, n - 1usize)));
                match self.lookup(&cx, home, other, no_pos()) {
                    Ok(found) => match found {
                        Decl(d) => Owner::Decl.(d),
                        _ => Owner::Blanket,
                    },
                    Err(_e) => Owner::Blanket,
                }
            },
        }
    }

    // ---- errors
    fn file(self, &cx: Domain!['k], home: ModuleId['k]) -> Str['k] {
        self.packages.at(&cx, home.package).files.at(&cx, home)
    }

    // Errors from here until `unlocate` are inside `module`'s file and, when they have no
    // position, at `pos`.
    fn locate(self, &cx: Domain!['k], home: ModuleId['k], pos: Pos) {
        self.locations.push(&cx, Location.{ file: self.file(&cx, home), pos, rank: self.order.get_or(&cx, home, 0usize) + 1usize });
    }

    // Errors from here until `unlocate` are in the manifest `file`.
    fn locate_manifest(self, &cx: Domain!['k], file: Str['k]) {
        self.locations.push(&cx, Location.{ file, pos: no_pos(), rank: 0usize });
    }

    fn unlocate(self, &cx: Domain!['k]) {
        let unit = self.locations.pop(&cx);
    }

    // `message` at `pos` (none on line 0) as printed, naming the files it is located in, and where it
    // is.
    fn located_error(self, &cx: Domain!['k], message: Str['k], pos: Pos) -> (Str['k], Pos) {
        var full = error_text(&cx, message, pos);
        var at = pos;
        var i = self.locations.len(&cx);
        while i > 0usize {
            i = i - 1usize;
            let l = self.locations.at(&cx, i);
            let (f, p) = located(&cx, full, message, at, l.file, l.pos);
            full = f;
            at = p;
        }
        (full, at)
    }

    // Stops with `message` at `pos` (none on line 0), naming the files it is located in.
    fn fail(self, &cx: Domain!['k], message: Str['k], pos: Pos) -> ! {
        let (full, at) = self.located_error(&cx, message, pos);
        fail(&cx, full)
    }

    // Keeps `message` at `pos` for `stop`, located as `fail` locates it. An error reported twice is
    // kept once.
    fn report(self, &cx: Domain!['k], message: Str['k], pos: Pos) {
        let (full, at) = self.located_error(&cx, message, pos);
        if !self.reported.contains(&cx, full) {
            self.reported.insert(&cx, full);
            let rank = if self.locations.is_empty(&cx) { 0usize } else { self.locations.at(&cx, self.locations.len(&cx) - 1usize).rank };
            self.errors.push(&cx, Reported.{ text: full, rank, line: at.line, col: at.col, seq: self.errors.len(&cx) });
        }
    }

    // Stops with the errors reported, in source order: the first `ERROR_LIMIT`, and how many more
    // there are.
    fn stop(self, &cx: Domain!['k]) {
        let n = self.errors.len(&cx);
        if n == 0usize {
            return;
        }
        let sorted = self.errors.clone(&cx);
        sorted.sort_by(&cx, |&cx, a, b| source_order(a, b));
        var out = Buffer!::new();
        var i = 0usize;
        while i < n && i < ERROR_LIMIT {
            out = out.put(if i > 0usize { "\n" } else { "" }).write(&cx, sorted.at(&cx, i).text);
            i = i + 1usize;
        }
        if n > ERROR_LIMIT {
            out = out.put("\nand ").put(n - ERROR_LIMIT).put(if n - ERROR_LIMIT > 1usize { " more errors" } else { " more error" });
        }
        fail(&cx, out.save(&cx))
    }

    // ---- path lookup
    // What `path` names from `module`, or why it names nothing; an error without a position gets
    // `pos`.
    fn lookup(self, &cx: Domain!['k], home: ModuleId['k], path: ArenaVec[Str['k], 'k], pos: Pos) -> Result[Target['k], Problem['k]] {
        match self.solve(&cx, lookup_key(&cx, "path", home, path)) {
            Ok(t) => Result::Ok.(t),
            Err(e) => if e.pos.line == 0u32 && pos.line != 0u32 {
                Result::Err.(Problem.{ message: e.message, pos })
            } else {
                Result::Err.(e)
            },
        }
    }

    // What `path` names from `module`, stopping if it names nothing.
    fn need(self, &cx: Domain!['k], home: ModuleId['k], path: ArenaVec[Str['k], 'k], pos: Pos) -> Target['k] {
        match self.lookup(&cx, home, path, pos) {
            Ok(t) => t,
            Err(e) => self.fail(&cx, e.message, e.pos),
        }
    }

    fn solve(self, &cx: Domain!['k], key: (Str['k], ModuleId['k], ArenaVec[Str['k], 'k])) -> Result[Target['k], Problem['k]] {
        let unit = match self.cache.get(&cx, key) {
            Some(t) => return Result::Ok.(t),
            None => (),
        };
        let (kind, home, names) = key;
        if self.active.contains(&cx, key) {
            return problem(Buffer!::new().put("import cycle at ").write(&cx, names.join(&cx, "::")).save(&cx));
        }
        self.active.insert(&cx, key);
        let value = if kind.is(&cx, "import") {
            self.resolve_path(&cx, home, self.scopes.at(&cx, home).imports.at(&cx, names.at(&cx, 0usize)), Option::Some.(names.at(&cx, 0usize)), true)
        } else {
            self.resolve_path(&cx, home, names, Option::None, true)
        };
        self.active.remove(&cx, key);
        match value {
            Ok(t) => {
                self.cache.insert(&cx, key, t);
                Result::Ok.(t)
            },
            Err(e) => Result::Err.(e),
        }
    }

    // What `path` names from `home`; with `hint`, a first name that names nothing is reported with what
    // its other spelling names (`respelled`).
    fn resolve_path(self, &cx: Domain!['k], home: ModuleId['k], path: ArenaVec[Str['k], 'k], importing: Option[Str['k]], hint: bool) -> Result[Target['k], Problem['k]] {
        let first = path.at(&cx, 0usize);
        let rest = path.skip(&cx, 1usize);
        let scope = self.scopes.at(&cx, home);
        let not_importing = match importing {
            Some(name) => !name.eq(&cx, first),
            None => true,
        };
        if first.is(&cx, "builtin") {
            return self.builtin(&cx, home, path);
        }
        var target = if first.is(&cx, "package") {
            Target::Module.(ModuleId::root(&cx, home.package))
        } else if scope.decls.contains(&cx, first) {
            Target::Decl.(scope.decls.at(&cx, first))
        } else if scope.imports.contains(&cx, first) && not_importing {
            match self.solve(&cx, lookup_key(&cx, "import", home, ArenaVec::one(&cx, first))) {
                Ok(t) => t,
                Err(e) => {
                    let misspelled = if hint { self.misspelled_import(&cx, home, first) } else { Str::from_static(&cx, "") };
                    if misspelled.is_empty() {
                        return Result::Err.(e);
                    }
                    return Result::Err.(Problem.{ message: concat(&cx, e.message, misspelled), pos: e.pos });
                },
            }
        } else {
            match self.root_member(&cx, home, first) {
                Some(t) => t,
                None => match self.glob(&cx, home, first) {
                    Ok(found) => match found {
                        Some(t) => t,
                        None => {
                            var message = Buffer!::new().put("unknown name ").write(&cx, path.join(&cx, "::"));
                            if hint {
                                message = self.unknown_hint(&cx, message, home, first, importing);
                            }
                            return problem(message.save(&cx));
                        },
                    },
                    Err(e) => return Result::Err.(e),
                },
            }
        };
        var k = 0usize;
        while k < rest.len(&cx) {
            target = match target {
                Decl(d) => return self.associated(&cx, d, rest.skip(&cx, k).join(&cx, "::")),
                Builtin(name) => if is_owned_builtin(&cx, name) {
                    return self.attached_to(&cx, name, rest.skip(&cx, k).join(&cx, "::"));
                } else {
                    return problem(Buffer!::new().write(&cx, path.slice(&cx, 0usize, k + 1usize).join(&cx, "::")).put(" is not a module").save(&cx));
                },
                Module(m) => match self.member(&cx, home, m, rest.at(&cx, k), true) {
                    Ok(t) => t,
                    Err(e) => return Result::Err.(e),
                },
                _ => return problem(Buffer!::new().write(&cx, path.slice(&cx, 0usize, k + 1usize).join(&cx, "::")).put(" is not a module").save(&cx)),
            };
            k = k + 1usize;
        }
        Result::Ok.(target)
    }

    // For a first name that names nothing in `home`, `out` followed by what its other spelling names
    // there, or, when that is an import that names nothing, by what the import names respelled
    // (`misspelled_import`).
    fn unknown_hint(self, &cx: Domain!['k], out: Buffer!, home: ModuleId['k], name: Str['k], importing: Option[Str['k]]) -> Buffer! {
        let other = other_spelling(&cx, name);
        let scope = self.scopes.at(&cx, home);
        let not_importing = match importing {
            Some(i) => !i.eq(&cx, other),
            None => true,
        };
        if scope.imports.contains(&cx, other) && not_importing {
            let misspelled = self.misspelled_import(&cx, home, other);
            if !misspelled.is_empty() {
                let imported = scope.imports.at(&cx, other);
                return respelled(&cx, out, other_spelling(&cx, imported.at(&cx, imported.len(&cx) - 1usize))).write(&cx, misspelled);
            }
        }
        match self.resolve_path(&cx, home, ArenaVec::one(&cx, other), Option::None, false) {
            Ok(_t) => respelled(&cx, out, other),
            Err(_e) => out,
        }
    }

    // For an import that names nothing: where its `use` names it, when the import's last name
    // respelled, with or without the `!` of a linear type, names something; else nothing.
    fn misspelled_import(self, &cx: Domain!['k], home: ModuleId['k], alias: Str['k]) -> Str['k] {
        let scope = self.scopes.at(&cx, home);
        let path = scope.imports.at(&cx, alias);
        let n = path.len(&cx);
        let other = path.slice(&cx, 0usize, n - 1usize);
        other.push(&cx, other_spelling(&cx, path.at(&cx, n - 1usize)));
        match self.resolve_path(&cx, home, other, Option::Some.(alias), false) {
            Ok(_t) => {
                let at = scope.import_pos.at(&cx, alias);
                Buffer!::new().put(", imported as ").write(&cx, path.at(&cx, n - 1usize)).put(" at ").write(&cx, self.file(&cx, home))
                    .put(":").put(at.line).put(":").put(at.col).save(&cx)
            },
            Err(_e) => Str::from_static(&cx, ""),
        }
    }

    // `builtin::name`, which only package core writes.
    fn builtin(self, &cx: Domain!['k], home: ModuleId['k], path: ArenaVec[Str['k], 'k]) -> Result[Target['k], Problem['k]] {
        if !self.in_core(&cx, home) {
            return problem(only_core(&cx));
        }
        let name = if path.len(&cx) == 2usize { path.at(&cx, 1usize) } else { Str::from_static(&cx, "") };
        if !is_builtin_type(&cx, name) && !is_builtin_value(&cx, name) {
            return problem(Buffer!::new().put("unknown builtin ").write(&cx, path.join(&cx, "::")).save(&cx));
        }
        Result::Ok.(Target::Builtin.(name))
    }

    fn in_core(self, &cx: Domain!['k], home: ModuleId['k]) -> bool {
        self.packages.at(&cx, home.package).name.copy(&cx).is(&cx, "core")
    }

    // `Owner::name` of a primitive or builtin type: a method or const an impl of it declares.
    fn attached_to(self, &cx: Domain!['k], owner: Str['k], name: Str['k]) -> Result[Target['k], Problem['k]] {
        let found = self.attached.get_or(&cx, (Owner::Prim.(owner), name), ArenaVec::new(&cx));
        if found.is_empty(&cx) {
            return problem(f"unknown {owner}::{name}".write(&cx, Buffer!::new()).save(&cx));
        }
        Result::Ok.(Target::Decl.(found.at(&cx, 0usize)))
    }

    fn root_member(self, &cx: Domain!['k], home: ModuleId['k], name: Str['k]) -> Option[Target['k]] {
        let package = self.packages.at(&cx, home.package);
        let root = ModuleId::root(&cx, home.package);
        if package.deps.contains(&cx, name) {
            return Option::Some.(Target::Module.(ModuleId::root(&cx, package.deps.at(&cx, name))));
        }
        let children = self.children.at(&cx, root);
        if children.contains(&cx, name) {
            return Option::Some.(Target::Module.(children.at(&cx, name)));
        }
        match self.scopes.get(&cx, root) {
            Some(scope) => match scope.decls.get(&cx, name) {
                Some(d) => Option::Some.(Target::Decl.(d)),
                None => Option::None,
            },
            None => Option::None,
        }
    }

    // `name` through the module's glob imports, in order. Globs that lead back to a search already
    // under way for `name` in `home` offer nothing more there.
    fn glob(self, &cx: Domain!['k], home: ModuleId['k], name: Str['k]) -> Result[Option[Target['k]], Problem['k]] {
        if self.searching.contains(&cx, (home, name)) {
            return Result::Ok.(Option::None);
        }
        self.searching.insert(&cx, (home, name));
        let found = self.globbed(&cx, home, name);
        self.searching.remove(&cx, (home, name));
        found
    }

    // A glob whose own path is being resolved offers nothing more: its path's first name is unknown
    // in the module itself.
    fn globbed(self, &cx: Domain!['k], home: ModuleId['k], name: Str['k]) -> Result[Option[Target['k]], Problem['k]] {
        let globs = self.scopes.at(&cx, home).globs;
        var i = 0usize;
        while i < globs.len(&cx) {
            let path = globs.at(&cx, i);
            if !self.expanding.contains(&cx, (home, path)) {
                self.expanding.insert(&cx, (home, path));
                let found = self.resolve_path(&cx, home, path, Option::None, true);
                self.expanding.remove(&cx, (home, path));
                let source = match found {
                    Ok(t) => t,
                    Err(e) => return Result::Err.(e),
                };
                let unit = match source {
                    Module(m) => match self.member(&cx, home, m, name, false) {
                        Ok(t) => return Result::Ok.(Option::Some.(t)),
                        Err(e) => (),
                    },
                    _ => return Result::Err.(Problem.{ message: Buffer!::new().write(&cx, path.join(&cx, "::")).put(" is not a module").save(&cx), pos: no_pos() }),
                };
            }
            i = i + 1usize;
        }
        Result::Ok.(Option::None)
    }

    // `module::name`, seen from `caller`: its own declarations; within one package also its
    // children and imports; across packages only exports. With `hint`, as `resolve_path`.
    fn member(self, &cx: Domain!['k], caller: ModuleId['k], home: ModuleId['k], name: Str['k], hint: bool) -> Result[Target['k], Problem['k]] {
        let scope = self.scopes.get(&cx, home);
        let unit = match scope {
            Some(s) => match s.decls.get(&cx, name) {
                Some(d) => return Result::Ok.(Target::Decl.(d)),
                None => (),
            },
            None => (),
        };
        if caller.package == home.package {
            let unit = match self.children.get(&cx, home) {
                Some(c) => match c.get(&cx, name) {
                    Some(m) => return Result::Ok.(Target::Module.(m)),
                    None => (),
                },
                None => (),
            };
            let unit = match scope {
                Some(s) => {
                    if s.imports.contains(&cx, name) {
                        return self.solve(&cx, lookup_key(&cx, "import", home, ArenaVec::one(&cx, name)));
                    }
                    let unit = match self.glob(&cx, home, name) {
                        Ok(found) => match found {
                            Some(t) => return Result::Ok.(t),
                            None => (),
                        },
                        Err(e) => return Result::Err.(e),
                    };
                },
                None => (),
            };
        } else {
            let unit = match scope {
                Some(s) => {
                    if s.exports.contains(&cx, name) {
                        return self.solve(&cx, lookup_key(&cx, "export", home, ArenaVec::one(&cx, name)));
                    }
                },
                None => (),
            };
        }
        let owner = if home.path.is_empty(&cx) { self.packages.at(&cx, home.package).name.copy(&cx) } else { home.path.join(&cx, "::") };
        var message = Buffer!::new().put("unknown or private member ").write(&cx, name).put(" of ").write(&cx, owner);
        if hint {
            let other = other_spelling(&cx, name);
            let unit = match self.member(&cx, caller, home, other, false) {
                Ok(_t) => {
                    message = respelled(&cx, message, other);
                },
                Err(_e) => (),
            };
        }
        problem(message.save(&cx))
    }

    // `Owner::name`: an enum variant, or a method or const attached to `Owner`.
    fn associated(self, &cx: Domain!['k], owner: Decl['k], name: Str['k]) -> Result[Target['k], Problem['k]] {
        let unit = match owner.node {
            Alias(_a) => return problem(alias_names_a_type(&cx, owner)),
            Enum(e) => {
                var i = 0usize;
                while i < e.variants.len(&cx) {
                    if e.variants.at(&cx, i).name.eq(&cx, name) {
                        return Result::Ok.(Target::Variant.(owner, name));
                    }
                    i = i + 1usize;
                }
            },
            Trait(t) => {
                var i = 0usize;
                while i < t.methods.len(&cx) {
                    if t.methods.at(&cx, i).name.eq(&cx, name) {
                        return Result::Ok.(Target::TraitMethod.(owner, name));
                    }
                    i = i + 1usize;
                }
            },
            _ => (),
        };
        let found = self.attached.get_or(&cx, (Owner::Decl.(owner), name), ArenaVec::new(&cx));
        var own: ArenaVec[Decl['k], 'k] = ArenaVec::new(&cx);
        var i = 0usize;
        while i < found.len(&cx) {
            if key_eq(&cx, found.at(&cx, i).home, owner.home) {
                own.push(&cx, found.at(&cx, i));
            }
            i = i + 1usize;
        }
        if own.is_empty(&cx) {
            own = found;
        }
        if own.len(&cx) != 1usize {
            return problem(Buffer!::new().put(if own.is_empty(&cx) { "unknown" } else { "ambiguous" }).put(" associated name ").write(&cx, owner.name).put("::").write(&cx, name).save(&cx));
        }
        Result::Ok.(Target::Decl.(own.at(&cx, 0usize)))
    }

    // A library item the compiler itself refers to (Str for string literals, Buffer and Format
    // for f-strings, Ordering for atomics): through a direct dependency on its home library, else
    // through std, else in the module's own package.
    fn library(self, &cx: Domain!['k], home: ModuleId['k], library_name: Str['k], path: ArenaVec[Str['k], 'k], std_path: ArenaVec[Str['k], 'k]) -> Target['k] {
        let deps = self.packages.at(&cx, home.package).deps;
        let root = if deps.contains(&cx, library_name) { library_name } else if deps.contains(&cx, Str::from_static(&cx, "std")) { Str::from_static(&cx, "std") } else { Str::from_static(&cx, "package") };
        let full: ArenaVec[Str['k], 'k] = ArenaVec::one(&cx, root);
        full.append(&cx, if root.is(&cx, "std") { std_path } else { path });
        self.need(&cx, home, full, no_pos())
    }
}

// ---------------------------------------------------------- references --

// `names` with `more` added, as a new sequence: the sets of names in scope.
forall 'k.
fn with(&cx: Domain!['k], names: ArenaVec[Str['k], 'k], more: ArenaVec[Str['k], 'k]) -> ArenaVec[Str['k], 'k] {
    let out = names.clone(&cx);
    out.append(&cx, more);
    out
}

forall 'k.
fn with_one(&cx: Domain!['k], names: ArenaVec[Str['k], 'k], name: Str['k]) -> ArenaVec[Str['k], 'k] {
    let out = names.clone(&cx);
    out.push(&cx, name);
    out
}

forall 'k.
fn quantifier_of(item: S::Item['k]) -> Option[S::Forall['k]] {
    match item {
        Use(_x) => Option::None,
        Struct(x) => x.quantifier,
        Tuple(x) => x.quantifier,
        Enum(x) => x.quantifier,
        Alias(x) => x.quantifier,
        Fn(x) => x.quantifier,
        Extern(x) => x.quantifier,
        Const(_x) => Option::None,
        Impl(x) => x.quantifier,
        Trait(x) => x.quantifier,
        Instance(x) => x.quantifier,
    }
}

// The type parameters a quantifier binds, without its brands.
forall 'k.
fn forall_params(&cx: Domain!['k], quantifier: Option[S::Forall['k]]) -> ArenaVec[Str['k], 'k] {
    let out: ArenaVec[Str['k], 'k] = ArenaVec::new(&cx);
    let unit = match quantifier {
        Some(f) => {
            let all = with(&cx, f.params, f.determined);
            var i = 0usize;
            while i < all.len(&cx) {
                if !all.at(&cx, i).starts_with(&cx, Str::from_static(&cx, "'")) {
                    out.push(&cx, all.at(&cx, i));
                }
                i = i + 1usize;
            }
        },
        None => (),
    };
    out
}

// Resolve every path in every item of every module.
forall 'k.
exposed struct Names {
    r: Resolver['k],
    home: Ref[ModuleId['k], 'k],
}

forall 'k.
impl Names['k] {
    fn new(&cx: Domain!['k], r: Resolver['k]) -> Names['k] {
        Names.{ r, home: ref_in(&cx, ModuleId::root(&cx, 0usize)) }
    }

    fn run(self, &cx: Domain!['k]) -> Resolver['k] {
        let modules = self.r.scopes.keys(&cx);
        var m = 0usize;
        while m < modules.len(&cx) {
            let home = modules.at(&cx, m);
            self.home.set(&cx, home);
            let items = self.r.scopes.at(&cx, home).items;
            var i = 0usize;
            while i < items.len(&cx) {
                let item = items.at(&cx, i);
                self.r.locate(&cx, home, item_pos(item));
                self.item(&cx, item, ArenaVec::new(&cx));
                self.r.unlocate(&cx);
                i = i + 1usize;
            }
            m = m + 1usize;
        }
        self.r.stop(&cx);
        self.r
    }

    // Each name a `use` or `export` tree imports or publishes names something, used or not, and each
    // glob names a module; an error is at where its tree starts.
    fn use_tree(self, &cx: Domain!['k], tree: S::UseTree['k], prefix: ArenaVec[Str['k], 'k], exported: bool) {
        let home = self.home.copy(&cx);
        let path = prefix.clone(&cx);
        path.append(&cx, tree.path);
        var i = 0usize;
        while i < tree.children.len(&cx) {
            self.use_tree(&cx, tree.children.at(&cx, i), path, exported);
            i = i + 1usize;
        }
        if !tree.children.is_empty(&cx) {
            return;
        }
        let name = match tree.alias {
            Some(a) => a,
            None => path.at(&cx, path.len(&cx) - 1usize),
        };
        let recorded = match self.r.scopes.at(&cx, home).import_pos.get(&cx, name) {
            Some(p) => p.line == tree.pos.line && p.col == tree.pos.col,
            None => false,
        };
        if tree.star {
            match self.r.resolve_path(&cx, home, path, Option::None, true) {
                Ok(t) => match t {
                    Module(m) => (),
                    _ => self.r.report(&cx, Buffer!::new().write(&cx, path.join(&cx, "::")).put(" is not a module").save(&cx), tree.pos),
                },
                Err(e) => self.r.report(&cx, e.message, if e.pos.line != 0u32 { e.pos } else { tree.pos }),
            }
        } else if exported && path.len(&cx) == 1usize && path.at(&cx, 0usize).eq(&cx, name) {
            match self.r.solve(&cx, lookup_key(&cx, "export", home, path)) {
                Ok(t) => (),
                Err(e) => self.r.report(&cx, e.message, if e.pos.line != 0u32 { e.pos } else { tree.pos }),
            }
        } else if recorded {
            match self.r.solve(&cx, lookup_key(&cx, "import", home, ArenaVec::one(&cx, name))) {
                Ok(t) => (),
                Err(e) => self.r.report(&cx, e.message, if e.pos.line != 0u32 { e.pos } else { tree.pos }),
            }
        }
    }

    fn set(self, &cx: Domain!['k], id: u32, r: NameRef['k]) {
        self.r.refs.insert(&cx, id, r);
    }

    fn premises(self, &cx: Domain!['k], quantifier: Option[S::Forall['k]], types: ArenaVec[Str['k], 'k]) {
        let unit = match quantifier {
            Some(f) => {
                var i = 0usize;
                while i < f.premises.len(&cx) {
                    let premise = f.premises.at(&cx, i);
                    let trait_path = premise.trait_path;
                    if trait_path.len(&cx) == 1usize && is_builtin_trait(&cx, trait_path.at(&cx, 0usize)) {
                        self.set(&cx, premise.args.id, NameRef::Builtin.(trait_path.at(&cx, 0usize)));
                    } else {
                        match self.decl(&cx, trait_path, "trait", premise.pos) {
                            Some(d) => self.set(&cx, premise.args.id, NameRef::Decl.(d)),
                            None => (),
                        }
                    }
                    var k = 0usize;
                    while k < premise.args.args.len(&cx) {
                        self.ty(&cx, premise.args.args.at(&cx, k), types, false);
                        k = k + 1usize;
                    }
                    i = i + 1usize;
                }
            },
            None => (),
        };
    }

    fn item(self, &cx: Domain!['k], item: S::Item['k], types: ArenaVec[Str['k], 'k]) {
        let unit = match item {
            Use(x) => {
                self.use_tree(&cx, x.tree, ArenaVec::new(&cx), x.is_export);
                return;
            },
            _ => (),
        };
        let quantifier = quantifier_of(item);
        let types = with(&cx, types, forall_params(&cx, quantifier));
        self.premises(&cx, quantifier, types);
        match item {
            Struct(s) => {
                var i = 0usize;
                while i < s.fields.len(&cx) {
                    self.ty(&cx, s.fields.at(&cx, i).ty, types, false);
                    i = i + 1usize;
                }
            },
            Tuple(t) => self.types(&cx, t.elems, types),
            Enum(e) => {
                var i = 0usize;
                while i < e.variants.len(&cx) {
                    self.types(&cx, e.variants.at(&cx, i).payload, types);
                    i = i + 1usize;
                }
            },
            Fn(f) => self.function(&cx, f, types),
            Extern(x) => {
                var i = 0usize;
                while i < x.params.len(&cx) {
                    let unit = match x.params.at(&cx, i).ty {
                        Some(t) => self.ty(&cx, t, types, false),
                        None => (),
                    };
                    i = i + 1usize;
                }
                let unit = match x.ret {
                    Some(t) => self.ty(&cx, t, types, false),
                    None => (),
                };
            },
            Const(c) => {
                self.ty(&cx, c.ty, types, false);
                self.expr(&cx, c.value, types, ArenaVec::new(&cx));
            },
            Alias(a) => self.ty(&cx, a.body, types, false),
            Impl(m) => {
                self.ty(&cx, m.ty, types, false);
                var i = 0usize;
                while i < m.items.len(&cx) {
                    let unit = match m.items.at(&cx, i) {
                        Fn(f) => self.item(&cx, S::Item::Fn.(f), types),
                        Const(c) => self.item(&cx, S::Item::Const.(c), types),
                    };
                    i = i + 1usize;
                }
            },
            Trait(t) => {
                let trait_types = if t.quantifier.is_none() { with_one(&cx, types, Str::from_static(&cx, "Self")) } else { types };
                var i = 0usize;
                while i < t.methods.len(&cx) {
                    self.function(&cx, t.methods.at(&cx, i), trait_types);
                    i = i + 1usize;
                }
            },
            Instance(n) => {
                self.ty(&cx, n.ty, types, true);
                var i = 0usize;
                while i < n.methods.len(&cx) {
                    self.item(&cx, S::Item::Fn.(n.methods.at(&cx, i)), types);
                    i = i + 1usize;
                }
            },
            _ => (),
        }
    }

    fn function(self, &cx: Domain!['k], f: S::Fn['k], types: ArenaVec[Str['k], 'k]) {
        let types = with(&cx, types, forall_params(&cx, f.quantifier));
        self.premises(&cx, f.quantifier, types);
        let names: ArenaVec[Str['k], 'k] = ArenaVec::new(&cx);
        var i = 0usize;
        while i < f.params.len(&cx) {
            let p = f.params.at(&cx, i);
            let unit = match p.ty {
                Some(t) => self.ty(&cx, t, types, false),
                None => (),
            };
            names.push(&cx, p.name);
            i = i + 1usize;
        }
        let unit = match f.ret {
            Some(t) => self.ty(&cx, t, types, false),
            None => (),
        };
        let unit = match f.body {
            Some(b) => self.block(&cx, b, types, names),
            None => (),
        };
    }

    // What `path`, written at `pos`, names; or nothing, when it names nothing, which is reported.
    fn seek(self, &cx: Domain!['k], path: ArenaVec[Str['k], 'k], pos: Pos) -> Option[Target['k]] {
        match self.r.lookup(&cx, self.home.copy(&cx), path, pos) {
            Ok(t) => Option::Some.(t),
            Err(e) => {
                self.r.report(&cx, e.message, e.pos);
                Option::None
            },
        }
    }

    // The declaration `path`, written at `pos`, names, of `kind` unless it is empty; or nothing, when
    // it names none, which is reported.
    fn decl(self, &cx: Domain!['k], path: ArenaVec[Str['k], 'k], kind: Str['static], pos: Pos) -> Option[Decl['k]] {
        match self.seek(&cx, path, pos) {
            Some(target) => self.decl_of(&cx, path, target, kind, pos),
            None => Option::None,
        }
    }

    // `target`, which `path` names, when it is a declaration of `kind` (any kind when it is empty);
    // otherwise that is reported.
    fn decl_of(self, &cx: Domain!['k], path: ArenaVec[Str['k], 'k], target: Target['k], kind: Str['static], pos: Pos) -> Option[Decl['k]] {
        let k = Str::from_static(&cx, kind);
        match target {
            Decl(d) => if k.is_empty() || d.kind.eq(&cx, k) {
                return Option::Some.(d);
            } else if d.kind.is(&cx, "alias") {
                self.r.report(&cx, alias_names_a_type(&cx, d), pos);
                return Option::None;
            },
            _ => (),
        }
        let what = if k.is_empty() { Str::from_static(&cx, "declaration") } else { k };
        self.r.report(&cx, Buffer!::new().write(&cx, path.join(&cx, "::")).put(" is not a ").write(&cx, what).save(&cx), pos);
        Option::None
    }

    // ---- types
    fn types(self, &cx: Domain!['k], ts: ArenaVec[Type['k], 'k], types: ArenaVec[Str['k], 'k]) {
        var i = 0usize;
        while i < ts.len(&cx) {
            self.ty(&cx, ts.at(&cx, i), types, false);
            i = i + 1usize;
        }
    }

    fn ty(self, &cx: Domain!['k], t: Type['k], types: ArenaVec[Str['k], 'k], is_trait: bool) {
        match t {
            Name(n) => {
                let path = n.path;
                let single = path.len(&cx) == 1usize;
                let name = path.at(&cx, 0usize);
                if single && types.contains(&cx, name) {
                    self.set(&cx, n.id, NameRef::Param.(name));
                } else if single && is_prim(&cx, name) {
                    self.set(&cx, n.id, NameRef::Prim.(name));
                } else if single && name.is(&cx, "Never") {
                    self.set(&cx, n.id, NameRef::Builtin.(name));
                } else {
                    match self.seek(&cx, path, n.pos) {
                        Some(target) => self.named_type(&cx, n, target, is_trait),
                        None => (),
                    }
                }
                self.types(&cx, n.args, types);
            },
            Ptr(inner) => self.ty(&cx, inner.copy(&cx), types, false),
            Tuple(elems) => self.types(&cx, elems, types),
            Array(elem, length) => {
                self.ty(&cx, elem.copy(&cx), types, false);
                self.expr(&cx, length.copy(&cx), types, ArenaVec::new(&cx));
            },
            Fn(f) => {
                self.slots(&cx, f.params, types);
                self.ty(&cx, f.ret.copy(&cx), types, false);
            },
            Closure(c) => {
                self.slots(&cx, c.params, types);
                self.ty(&cx, c.ret.copy(&cx), types, false);
                let unit = match c.env {
                    Some(env) => self.ty(&cx, env.copy(&cx), types, false),
                    None => (),
                };
            },
            Exists(brands, _at, body) => self.ty(&cx, body.copy(&cx), types, false),
            Foreach(f) => {
                self.ty(&cx, f.source.copy(&cx), types, false);
                let bound = types.clone(&cx);
                bound.push(&cx, f.binder);
                self.ty(&cx, f.body.copy(&cx), bound, false);
            },
            _ => (),
        }
    }

    fn slots(self, &cx: Domain!['k], slots: ArenaVec[S::Slot['k], 'k], types: ArenaVec[Str['k], 'k]) {
        var i = 0usize;
        while i < slots.len(&cx) {
            self.ty(&cx, slots.at(&cx, i).ty, types, false);
            i = i + 1usize;
        }
    }

    // The type, or with `is_trait` the trait, `n` writes: `target`, what its path names, unless that is
    // not one, which is reported.
    fn named_type(self, &cx: Domain!['k], n: S::TName['k], target: Target['k], is_trait: bool) {
        let not_a_type = Buffer!::new().write(&cx, n.path.join(&cx, "::")).put(" is not a type").save(&cx);
        match target {
            Builtin(name) => if !is_trait {
                if is_builtin_type(&cx, name) {
                    self.set(&cx, n.id, NameRef::Builtin.(name));
                } else {
                    self.r.report(&cx, not_a_type, n.pos);
                }
                return;
            },
            _ => (),
        }
        match self.decl_of(&cx, n.path, target, if is_trait { "trait" } else { "" }, n.pos) {
            Some(d) => if is_trait || d.kind.is(&cx, "struct") || d.kind.is(&cx, "enum") || d.kind.is(&cx, "tuple") || d.kind.is(&cx, "alias") {
                self.set(&cx, n.id, NameRef::Decl.(d));
            } else {
                self.r.report(&cx, not_a_type, n.pos);
            },
            None => (),
        }
    }

    // ---- expressions
    // Resolve `e`; `values` are the locals in scope.
    fn expr(self, &cx: Domain!['k], e: Expr['k], types: ArenaVec[Str['k], 'k], values: ArenaVec[Str['k], 'k]) {
        match e {
            Path(p) => self.path(&cx, p, types, values),
            Block(b) => self.block(&cx, b, types, values),
            StructLit(s) => {
                let names = s.path.names(&cx);
                match self.decl(&cx, names, "struct", s.pos) {
                    Some(d) => self.set(&cx, s.path.id, NameRef::Decl.(d)),
                    None => (),
                }
                self.segment_args(&cx, s.path, types);
                var i = 0usize;
                while i < s.fields.len(&cx) {
                    let unit = match s.fields.at(&cx, i).value {
                        Some(v) => self.expr(&cx, v, types, values),
                        None => (),
                    };
                    i = i + 1usize;
                }
                i = 0usize;
                while i < s.fields.len(&cx) {
                    let f = s.fields.at(&cx, i);
                    if f.value.is_none() && !values.contains(&cx, f.name) {
                        self.r.report(&cx, Buffer!::new().put("unknown local ").write(&cx, f.name).save(&cx), s.pos);
                    }
                    i = i + 1usize;
                }
            },
            Match(m) => {
                self.expr(&cx, m.scrutinee.copy(&cx), types, values);
                var i = 0usize;
                while i < m.arms.len(&cx) {
                    let arm = m.arms.at(&cx, i);
                    let bound: ArenaVec[Str['k], 'k] = ArenaVec::new(&cx);
                    var k = 0usize;
                    while k < arm.cases.len(&cx) {
                        let case = arm.cases.at(&cx, k);
                        let unit = match case.kind {
                            Variant => {
                                let path = match case.path {
                                    Some(p) => p,
                                    None => self.r.fail(&cx, Str::from_static(&cx, "internal error: a variant case without a path"), no_pos()),
                                };
                                // A bare label names a variant of the scrutinee's sum, which inference knows.
                                if path.segments.len(&cx) == 1usize {
                                    if !path.segments.at(&cx, 0usize).args.is_empty(&cx) {
                                        self.r.report(&cx, Str::from_static(&cx, "a variant label takes no type arguments"), path.pos);
                                    }
                                } else {
                                    self.variant(&cx, path);
                                }
                                self.segment_args(&cx, path, types);
                                let unit = match case.binders {
                                    Some(bs) => {
                                        var b = 0usize;
                                        while b < bs.len(&cx) {
                                            if !bs.at(&cx, b).is(&cx, "_") && !bs.at(&cx, b).is_empty() {
                                                bound.push(&cx, bs.at(&cx, b));
                                            }
                                            b = b + 1usize;
                                        }
                                    },
                                    None => (),
                                };
                            },
                            _ => (),
                        };
                        k = k + 1usize;
                    }
                    self.expr(&cx, arm.body, types, with(&cx, values, bound));
                    i = i + 1usize;
                }
            },
            Closure(c) => {
                let names: ArenaVec[Str['k], 'k] = ArenaVec::new(&cx);
                var i = 0usize;
                while i < c.params.len(&cx) {
                    let p = c.params.at(&cx, i);
                    let unit = match p.ty {
                        Some(t) => self.ty(&cx, t, types, false),
                        None => (),
                    };
                    names.push(&cx, p.name);
                    i = i + 1usize;
                }
                let unit = match c.ret {
                    Some(t) => self.ty(&cx, t, types, false),
                    None => (),
                };
                self.expr(&cx, c.body.copy(&cx), types, with(&cx, values, names));
            },
            Foreach(f) => {
                self.expr(&cx, f.source.copy(&cx), types, values);
                let inner = match f.binder {
                    Some(b) => with_one(&cx, types, b),
                    None => types,
                };
                self.block(&cx, f.body, inner, with_one(&cx, values, f.name));
            },
            Cast(c) => {
                self.expr(&cx, c.value.copy(&cx), types, values);
                self.ty(&cx, c.ty, types, false);
            },
            While(w) => {
                self.expr(&cx, w.cond.copy(&cx), types, values);
                self.block(&cx, w.body, types, values);
            },
            For(f) => {
                self.expr(&cx, f.iterator.copy(&cx), types, values);
                self.block(&cx, f.body, types, with_one(&cx, values, f.name));
            },
            Call(c) => {
                let callee = c.callee.copy(&cx);
                self.expr(&cx, callee, types, values);
                var i = 0usize;
                while i < c.args.len(&cx) {
                    self.expr(&cx, c.args.at(&cx, i), types, values);
                    i = i + 1usize;
                }
                match callee {
                    Path(p) => self.construction(&cx, p, c.construct),
                    _ => (),
                }
            },
            Lit(l) => (),
            Binop(b) => {
                // A chain `a + b - c ...` nests to the left; a loop walks its links rather than recursion.
                let rights: ArenaVec[Expr['k], 'k] = ArenaVec::one(&cx, b.right.copy(&cx));
                var left = b.left.copy(&cx);
                var going = true;
                while going {
                    going = match left {
                        Binop(l) => {
                            rights.push(&cx, l.right.copy(&cx));
                            left = l.left.copy(&cx);
                            true
                        },
                        _ => false,
                    };
                }
                self.expr(&cx, left, types, values);
                var i = rights.len(&cx);
                while i > 0usize {
                    i = i - 1usize;
                    self.expr(&cx, rights.at(&cx, i), types, values);
                }
            },
            _ => {
                let parts = children(&cx, e);
                var i = 0usize;
                while i < parts.len(&cx) {
                    self.expr(&cx, parts.at(&cx, i), types, values);
                    i = i + 1usize;
                }
            },
        }
    }

    fn block(self, &cx: Domain!['k], b: S::Block['k], types: ArenaVec[Str['k], 'k], values: ArenaVec[Str['k], 'k]) {
        var values = values;
        var i = 0usize;
        while i < b.stmts.len(&cx) {
            values = self.stmt(&cx, b.stmts.at(&cx, i), types, values);
            i = i + 1usize;
        }
        let unit = match b.tail {
            Some(t) => self.expr(&cx, t.copy(&cx), types, values),
            None => (),
        };
    }

    fn stmt(self, &cx: Domain!['k], s: Statement['k], types: ArenaVec[Str['k], 'k], values: ArenaVec[Str['k], 'k]) -> ArenaVec[Str['k], 'k] {
        match s {
            Let(l) => {
                self.expr(&cx, l.value, types, values);
                let unit = match l.ty {
                    Some(t) => self.ty(&cx, t, types, false),
                    None => (),
                };
                with(&cx, values, bound(&cx, l.pattern))
            },
            Const(c) => {
                self.ty(&cx, c.ty, types, false);
                self.expr(&cx, c.value, types, values);
                with_one(&cx, values, c.name)
            },
            Assign(a) => {
                self.expr(&cx, a.target, types, values);
                self.expr(&cx, a.value, types, values);
                values
            },
            Expr(n) => {
                self.expr(&cx, n.value, types, values);
                values
            },
        }
    }

    fn segment_args(self, &cx: Domain!['k], p: S::Path['k], types: ArenaVec[Str['k], 'k]) {
        var i = 0usize;
        while i < p.segments.len(&cx) {
            self.types(&cx, p.segments.at(&cx, i).args, types);
            i = i + 1usize;
        }
    }

    fn path(self, &cx: Domain!['k], p: S::Path['k], types: ArenaVec[Str['k], 'k], values: ArenaVec[Str['k], 'k]) {
        let names = p.names(&cx);
        self.segment_args(&cx, p, types);
        let first = names.at(&cx, 0usize);
        if names.len(&cx) == 1usize && values.contains(&cx, first) {
            self.set(&cx, p.id, NameRef::Local.(first));
        } else if names.len(&cx) == 2usize && is_prim(&cx, first) {
            let found = self.r.attached.get_or(&cx, (Owner::Prim.(first), names.at(&cx, 1usize)), ArenaVec::new(&cx));
            if found.is_empty(&cx) {
                self.r.report(&cx, Buffer!::new().put("unknown ").write(&cx, first).put("::").write(&cx, names.at(&cx, 1usize)).save(&cx), p.pos);
            } else {
                self.set(&cx, p.id, NameRef::Decl.(found.at(&cx, 0usize)));
            }
        } else if names.len(&cx) == 2usize && types.contains(&cx, first) {
            // a member of a type parameter, found by inference
            self.set(&cx, p.id, NameRef::Assoc.(first, names.at(&cx, 1usize)));
        } else {
            match self.seek(&cx, names, p.pos) {
                Some(target) => match target {
                    Module(m) => self.r.report(&cx, Buffer!::new().write(&cx, names.join(&cx, "::")).put(" is a module, not a value").save(&cx), p.pos),
                    Decl(d) => if d.kind.is(&cx, "alias") {
                        self.r.report(&cx, alias_names_a_type(&cx, d), p.pos);
                    } else {
                        self.set(&cx, p.id, NameRef::Decl.(d));
                    },
                    Variant(d, v) => self.set(&cx, p.id, NameRef::Variant.(d, v)),
                    TraitMethod(d, m) => self.set(&cx, p.id, NameRef::TraitMethod.(d, m)),
                    Builtin(name) => self.set(&cx, p.id, NameRef::Builtin.(name)),
                },
                None => (),
            }
        }
    }

    // `Name.(args)` constructs a tuple or a variant, which a call `Name(args)` never does.
    fn construction(self, &cx: Domain!['k], callee: S::Path['k], construct: bool) {
        let constructor = match self.r.refs.get(&cx, callee.id) {
            Some(r) => match r {
                Variant(d, v) => true,
                Decl(d) => d.kind.is(&cx, "tuple"),
                _ => false,
            },
            None => return,
        };
        let name = callee.names(&cx).join(&cx, "::");
        if constructor && !construct {
            self.r.report(&cx, f"`{name}` is a constructor; write `{name}.(...)`".write(&cx, Buffer!::new()).save(&cx), callee.pos);
        } else if construct && !constructor {
            self.r.report(&cx, f"`{name}` is not a tuple or an enum variant; write `{name}(...)`".write(&cx, Buffer!::new()).save(&cx), callee.pos);
        }
    }

    fn variant(self, &cx: Domain!['k], path: S::Path['k]) {
        match self.seek(&cx, path.names(&cx), path.pos) {
            Some(target) => match target {
                Variant(d, v) => self.set(&cx, path.id, NameRef::Variant.(d, v)),
                _ => self.r.report(&cx, Buffer!::new().write(&cx, path.names(&cx).join(&cx, "::")).put(" is not an enum variant").save(&cx), path.pos),
            },
            None => (),
        }
    }
}

forall 'k.
fn bound(&cx: Domain!['k], pattern: Pattern['k]) -> ArenaVec[Str['k], 'k] {
    let out: ArenaVec[Str['k], 'k] = ArenaVec::new(&cx);
    let unit = match pattern {
        Bind(n) => out.push(&cx, n.value),
        Tuple(n) => bound_all(&cx, out, n.value),
        Array(n) => bound_all(&cx, out, n.value),
        Struct(s) => {
            var i = 0usize;
            while i < s.fields.len(&cx) {
                out.append(&cx, bound(&cx, s.fields.at(&cx, i).pattern));
                i = i + 1usize;
            }
            let unit = match s.rest {
                Some(r) => out.push(&cx, r),
                None => (),
            };
        },
        Wild(id) => (),
    };
    out
}

forall 'k.
fn bound_all(&cx: Domain!['k], out: ArenaVec[Str['k], 'k], patterns: ArenaVec[Pattern['k], 'k]) {
    var i = 0usize;
    while i < patterns.len(&cx) {
        out.append(&cx, bound(&cx, patterns.at(&cx, i)));
        i = i + 1usize;
    }
}

// The subexpressions of the expression forms with no binding structure, but for a binary operator,
// whose chains `expr` walks itself.
forall 'k.
fn children(&cx: Domain!['k], e: Expr['k]) -> ArenaVec[Expr['k], 'k] {
    let out: ArenaVec[Expr['k], 'k] = ArenaVec::new(&cx);
    let unit = match e {
        Tuple(n) => out.append(&cx, n.value),
        Array(a) => out.append(&cx, a.elems),
        FStr(f) => {
            var i = 0usize;
            while i < f.parts.len(&cx) {
                let unit = match f.parts.at(&cx, i) {
                    Expr(x) => out.push(&cx, x),
                    Text(t) => (),
                };
                i = i + 1usize;
            }
        },
        If(n) => {
            out.push(&cx, n.cond.copy(&cx));
            out.push(&cx, Expr::Block.(n.then));
            let unit = match n.other {
                Some(o) => out.push(&cx, o.copy(&cx)),
                None => (),
            };
        },
        Return(n) => {
            let unit = match n.value {
                Some(v) => out.push(&cx, v.copy(&cx)),
                None => (),
            };
        },
        Pack(p) => out.push(&cx, p.value.copy(&cx)),
        Unary(u) => out.push(&cx, u.operand.copy(&cx)),
        UnsafeStore(s) => {
            out.push(&cx, s.pointer.copy(&cx));
            out.push(&cx, s.value.copy(&cx));
        },
        Field(f) => out.push(&cx, f.value.copy(&cx)),
        Index(x) => out.push(&cx, x.value.copy(&cx)),
        Try(n) => out.push(&cx, n.value.copy(&cx)),
        _ => fail(&cx, Str::from_static(&cx, "internal error: an expression the walker takes apart itself")),
    };
    out
}

// The resolved package graph rooted at `path`.
forall 'k.
fn resolve(&cx: Domain!['k], path: Str['k]) -> Resolver['k] {
    let ids = ref_in(&cx, 0u32);
    let resolver = Resolver::new(&cx, load(&cx, path, ids), ids);
    if !resolver.packages.is_empty(&cx) {
        let package = resolver.packages.at(&cx, 0usize);
        let unit = match package.entry.copy(&cx) {
            Some(entry) => {
                if !entry.is_empty(&cx) {
                    resolver.locate_manifest(&cx, package.manifest);
                    let not_entry = Str::from_static(&cx, "an executable's entry must be a function of its own package");
                    match resolver.lookup(&cx, ModuleId::root(&cx, package.id), entry, no_pos()) {
                        Ok(target) => match target {
                            Decl(d) => if !d.kind.is(&cx, "fn") || d.home.package != package.id {
                                resolver.report(&cx, not_entry, no_pos());
                            } else {
                                package.entry_decl.set(&cx, Option::Some.(d));
                            },
                            _ => resolver.report(&cx, not_entry, no_pos()),
                        },
                        Err(e) => resolver.report(&cx, e.message, e.pos),
                    }
                    resolver.unlocate(&cx);
                }
            },
            None => (),
        };
    }
    Names::new(&cx, resolver).run(&cx)
}
