// Packages and names: load the package graph, assign each source file its module, and resolve
// every type and value path to what it names.
//
// What a path names is kept in `Resolver.refs`, keyed by the id of the node that spells it: a
// type name (`TName`), an expression or case path (`Path`), or a premise's type arguments
// (`TypeArgs`, naming the premise's trait).
//   NameRef::Decl(d)               a declaration (struct, enum, tuple, fn, extern, trait, const, method)
//   NameRef::Variant(d, name)      an enum variant
//   NameRef::TraitMethod(d, name)  a trait's method, `Trait::method`
//   NameRef::Assoc(param, name)    a member of a type parameter, found by inference
//   NameRef::Param(name)           a type parameter in scope
//   NameRef::Local(name)           a local value
//   NameRef::Prim(name)            a primitive type
//   NameRef::Builtin(name)         a compiler-sealed name: Brand, Copy, builtin::fresh, ...

use package::support::base::{Cell, Cx, Map, Out, Seq, Set, Text, combine, fail, key_hash, key_same, text};
use package::kurs::core::ModuleId;
use package::syntax::parser::parse;
use package::syntax::ast as S;
use package::syntax::ast::{Expr, Pattern, Pos, Statement, Type, no_pos};
use package::support::system::{environment, path_exists, list_directory, read, real_path};
use std::hash::{HashIn, HashState};
use std::option::{Option, Result};
use std::slice::Slice;

// Whether `name` is one of the space-separated `names`.
forall 'k.
fn among(&cx: Cx!['k], name: Text['k], names: Slice[u8, 'static]) -> bool {
    text(&cx, names).split(&cx, text(&cx, " ")).has(&cx, name)
}

forall 'k.
fn is_prim(&cx: Cx!['k], name: Text['k]) -> bool {
    among(&cx, name, "i8 i16 i32 i64 isize u8 u16 u32 u64 usize f32 f64 bool")
}

forall 'k.
fn is_builtin_type(&cx: Cx!['k], name: Text['k]) -> bool {
    among(&cx, name, "Brand Phantom Never")
}

forall 'k.
fn is_builtin_trait(&cx: Cx!['k], name: Text['k]) -> bool {
    among(&cx, name, "Copy Exposed")
}

// Builtin values, unless a declaration of the name is in scope.
forall 'k.
fn is_builtin_value(&cx: Cx!['k], name: Text['k]) -> bool {
    among(&cx, name, "alloca fence load_volatile store_volatile")
}

// The standard library's directory: `$KURSAL_LIB`, else `lib` beside the directory that holds the
// compiler's binary (an installation's `bin/kursal` and `lib/`).
forall 'k.
fn lib_dir(&cx: Cx!['k]) -> Text['k] {
    let configured = match environment(&cx, text(&cx, "KURSAL_LIB")) {
        Option::Some(v) => v,
        Option::None => text(&cx, ""),
    };
    if !configured.is_empty() {
        clean(&cx, configured)
    } else {
        match real_path(&cx, text(&cx, "/proc/self/exe")) {
            Option::Some(exe) => join(&cx, parent(&cx, parent(&cx, exe)), text(&cx, "lib")),
            Option::None => fail(&cx, text(&cx, "set KURSAL_LIB to the standard library's directory")),
        }
    }
}

// ------------------------------------------------------------------ paths --

// `path` as Python's `Path` spells it: no repeated, trailing or `.` separators.
forall 'k.
fn clean(&cx: Cx!['k], path: Text['k]) -> Text['k] {
    let parts = path.split(&cx, text(&cx, "/"));
    let out = Out::new(&cx);
    if path.starts_with(&cx, text(&cx, "/")) {
        let unit = out.put(&cx, "/");
    }
    var first = true;
    var i = 0usize;
    while i < parts.len(&cx) {
        let part = parts.get(&cx, i);
        if !part.is_empty() && !part.is(&cx, ".") {
            if !first {
                let unit = out.put(&cx, "/");
            }
            let unit = out.add(&cx, part);
            first = false;
        }
        i = i + 1usize;
    }
    if out.len(&cx) == 0usize { text(&cx, ".") } else { out.done(&cx) }
}

// `a / b`: `b` when it is absolute.
forall 'k.
fn join(&cx: Cx!['k], a: Text['k], b: Text['k]) -> Text['k] {
    if b.starts_with(&cx, text(&cx, "/")) || a.is_empty() || a.is(&cx, ".") {
        b
    } else if a.ends_with(&cx, text(&cx, "/")) {
        a.concat(&cx, b)
    } else {
        Out::new(&cx).add(&cx, a).put(&cx, "/").add(&cx, b).done(&cx)
    }
}

forall 'k.
fn parent(&cx: Cx!['k], path: Text['k]) -> Text['k] {
    match path.rfind_byte(&cx, b'/') {
        Option::Some(at) => if at == 0usize { text(&cx, "/") } else { path.slice(0usize, at) },
        Option::None => text(&cx, "."),
    }
}

// The last component.
forall 'k.
fn base_name(&cx: Cx!['k], path: Text['k]) -> Text['k] {
    match path.rfind_byte(&cx, b'/') {
        Option::Some(at) => path.from(at + 1usize),
        Option::None => path,
    }
}

// The last component's extension, with its dot: `Path.suffix`.
forall 'k.
fn suffix(&cx: Cx!['k], path: Text['k]) -> Text['k] {
    let name = base_name(&cx, path);
    match name.rfind_byte(&cx, b'.') {
        Option::Some(at) => if at > 0usize && at + 1usize < name.len() { name.from(at) } else { text(&cx, "") },
        Option::None => text(&cx, ""),
    }
}

// The last component without its extension: `Path.stem`.
forall 'k.
fn stem(&cx: Cx!['k], path: Text['k]) -> Text['k] {
    let name = base_name(&cx, path);
    name.slice(0usize, name.len() - suffix(&cx, name).len())
}

// The absolute path with no symbolic links that `path` names, existing or not: `Path.resolve()`.
// The longest existing prefix has its links resolved; the rest is appended, with `..` removing the
// component before it.
forall 'k.
fn resolved(&cx: Cx!['k], path: Text['k]) -> Text['k] {
    if path.starts_with(&cx, text(&cx, "/")) {
        resolve_absolute(&cx, path)
    } else {
        let cwd = match real_path(&cx, text(&cx, ".")) {
            Option::Some(c) => c,
            Option::None => fail(&cx, text(&cx, "cannot find the current directory")),
        };
        resolve_absolute(&cx, join(&cx, cwd, path))
    }
}

forall 'k.
fn resolve_absolute(&cx: Cx!['k], path: Text['k]) -> Text['k] {
    match real_path(&cx, path) {
        Option::Some(r) => r,
        Option::None => {
            if path.is(&cx, "/") {
                path
            } else {
                let base = resolve_absolute(&cx, parent(&cx, path));
                let name = base_name(&cx, path);
                if name.is_empty() || name.is(&cx, ".") {
                    base
                } else if name.is(&cx, "..") {
                    parent(&cx, base)
                } else {
                    let joined = join(&cx, base, name);
                    match real_path(&cx, joined) {
                        Option::Some(r) => r,
                        Option::None => joined,
                    }
                }
            }
        },
    }
}

// --------------------------------------------------------- Python's repr --

// A string as Python's `repr` writes it.
forall 'k.
fn repr(&cx: Cx!['k], t: Text['k]) -> Text['k] {
    let quote = if t.contains(&cx, text(&cx, "'")) && !t.contains(&cx, text(&cx, "\"")) { b'"' } else { b'\'' };
    let out = Out::new(&cx).byte(&cx, quote);
    var i = 0usize;
    while i < t.len() {
        let b = t.byte(&cx, i);
        if b == b'\\' || b == quote {
            let unit = out.byte(&cx, b'\\').byte(&cx, b);
        } else if b == b'\n' {
            let unit = out.put(&cx, "\\n");
        } else if b == b'\t' {
            let unit = out.put(&cx, "\\t");
        } else if b == b'\r' {
            let unit = out.put(&cx, "\\r");
        } else if b < 32u8 || b == 127u8 {
            let digits = text(&cx, "0123456789abcdef");
            let unit = out.put(&cx, "\\x").byte(&cx, digits.byte(&cx, (b / 16u8) as usize)).byte(&cx, digits.byte(&cx, (b % 16u8) as usize));
        } else {
            let unit = out.byte(&cx, b);
        }
        i = i + 1usize;
    }
    out.byte(&cx, quote).done(&cx)
}

// A tuple of strings as Python's `repr` writes it: `()`, `('a',)`, `('a', 'b')`.
forall 'k.
fn repr_tuple(&cx: Cx!['k], names: Seq[Text['k], 'k]) -> Text['k] {
    let out = Out::new(&cx).put(&cx, "(");
    var i = 0usize;
    while i < names.len(&cx) {
        if i > 0usize {
            let unit = out.put(&cx, ", ");
        }
        let unit = out.add(&cx, repr(&cx, names.get(&cx, i)));
        i = i + 1usize;
    }
    if names.len(&cx) == 1usize {
        let unit = out.put(&cx, ",");
    }
    out.put(&cx, ")").done(&cx)
}

forall 'k.
fn repr_module(&cx: Cx!['k], m: ModuleId['k]) -> Text['k] {
    Out::new(&cx).put(&cx, "ModuleId(package=").usize(&cx, m.package).put(&cx, ", path=").add(&cx, repr_tuple(&cx, m.path)).put(&cx, ")").done(&cx)
}

// `'::'.join(names)`.
forall 'k.
fn joined(&cx: Cx!['k], names: Seq[Text['k], 'k]) -> Text['k] {
    let out = Out::new(&cx);
    var i = 0usize;
    while i < names.len(&cx) {
        if i > 0usize {
            let unit = out.put(&cx, "::");
        }
        let unit = out.add(&cx, names.get(&cx, i));
        i = i + 1usize;
    }
    out.done(&cx)
}

forall 'k.
fn text_before(&cx: Cx!['k], a: Text['k], b: Text['k]) -> bool {
    a.compare(&cx, b) < 0
}

// ---------------------------------------------------------- the manifest --

// A manifest value: a string, a table in key order, or any other TOML value.
forall 'k.
exposed enum Toml {
    Str(Text['k]),
    Table(Map[Text['k], Toml['k], 'k]),
    Other,
}

// A reader for the TOML that manifests use: tables, dotted keys and headers, strings, inline
// tables, and other values (numbers, booleans, arrays, dates) read only as far as their extent.
forall 'k.
exposed struct TomlReader {
    src: Text['k],
    i: Cell[usize, 'k],
    file: Text['k],
}

forall 'k.
fn read_toml(&cx: Cx!['k], source: Text['k], file: Text['k]) -> Map[Text['k], Toml['k], 'k] {
    let r = TomlReader.{ src: source, i: Cell::new(&cx, 0usize), file };
    r.document(&cx)
}

forall 'k.
impl TomlReader['k] {
    fn at(self, &cx: Cx!['k]) -> u8 {
        self.src.byte(&cx, self.i.get(&cx))
    }

    fn done(self, &cx: Cx!['k]) -> bool {
        self.i.get(&cx) >= self.src.len()
    }

    fn advance(self, &cx: Cx!['k]) {
        self.i.set(&cx, self.i.get(&cx) + 1usize);
    }

    fn fail(self, &cx: Cx!['k]) -> ! {
        var line = 1usize;
        var k = 0usize;
        while k < self.i.get(&cx) && k < self.src.len() {
            if self.src.byte(&cx, k) == b'\n' {
                line = line + 1usize;
            }
            k = k + 1usize;
        }
        fail(&cx, Out::new(&cx).add(&cx, self.file).put(&cx, ":").usize(&cx, line).put(&cx, ": invalid manifest").done(&cx))
    }

    fn expect(self, &cx: Cx!['k], b: u8) {
        if self.done(&cx) || self.at(&cx) != b {
            self.fail(&cx);
        }
        self.advance(&cx);
    }

    // Spaces and tabs.
    fn blank(self, &cx: Cx!['k]) {
        while !self.done(&cx) && (self.at(&cx) == b' ' || self.at(&cx) == b'\t') {
            self.advance(&cx);
        }
    }

    // Spaces, newlines and comments.
    fn space(self, &cx: Cx!['k]) {
        var going = true;
        while going && !self.done(&cx) {
            let b = self.at(&cx);
            if b == b' ' || b == b'\t' || b == b'\n' || b == b'\r' {
                self.advance(&cx);
            } else if b == b'#' {
                self.comment(&cx);
            } else {
                going = false;
            }
        }
    }

    fn comment(self, &cx: Cx!['k]) {
        while !self.done(&cx) && self.at(&cx) != b'\n' {
            self.advance(&cx);
        }
    }

    // The rest of a line after a key-value pair or a header: blanks and a comment.
    fn line_end(self, &cx: Cx!['k]) {
        self.blank(&cx);
        if !self.done(&cx) && self.at(&cx) == b'#' {
            self.comment(&cx);
        }
        if !self.done(&cx) {
            if self.at(&cx) == b'\r' {
                self.advance(&cx);
            }
            self.expect(&cx, b'\n');
        }
    }

    fn document(self, &cx: Cx!['k]) -> Map[Text['k], Toml['k], 'k] {
        let root: Map[Text['k], Toml['k], 'k] = Map::new(&cx);
        var current = root;
        self.space(&cx);
        while !self.done(&cx) {
            if self.at(&cx) == b'[' {
                self.advance(&cx);
                if !self.done(&cx) && self.at(&cx) == b'[' {
                    self.fail(&cx);
                }
                self.blank(&cx);
                let keys = self.key(&cx);
                self.blank(&cx);
                self.expect(&cx, b']');
                self.line_end(&cx);
                current = self.descend(&cx, root, keys, keys.len(&cx));
            } else {
                let keys = self.key(&cx);
                self.blank(&cx);
                self.expect(&cx, b'=');
                self.blank(&cx);
                let value = self.value(&cx);
                self.line_end(&cx);
                self.define(&cx, current, keys, value);
            }
            self.space(&cx);
        }
        root
    }

    // The table `keys[..count]` names under `table`, made where missing.
    fn descend(self, &cx: Cx!['k], table: Map[Text['k], Toml['k], 'k], keys: Seq[Text['k], 'k], count: usize) -> Map[Text['k], Toml['k], 'k] {
        var t = table;
        var k = 0usize;
        while k < count {
            t = match t.get(&cx, keys.get(&cx, k)) {
                Option::Some(v) => match v {
                    Toml::Table(inner) => inner,
                    _ => self.fail(&cx),
                },
                Option::None => {
                    let inner: Map[Text['k], Toml['k], 'k] = Map::new(&cx);
                    t.set(&cx, keys.get(&cx, k), Toml::Table.(inner));
                    inner
                },
            };
            k = k + 1usize;
        }
        t
    }

    fn define(self, &cx: Cx!['k], table: Map[Text['k], Toml['k], 'k], keys: Seq[Text['k], 'k], value: Toml['k]) {
        let t = self.descend(&cx, table, keys, keys.len(&cx) - 1usize);
        if t.has(&cx, keys.last(&cx)) {
            self.fail(&cx);
        }
        t.set(&cx, keys.last(&cx), value);
    }

    // A dotted key.
    fn key(self, &cx: Cx!['k]) -> Seq[Text['k], 'k] {
        let keys: Seq[Text['k], 'k] = Seq::one(&cx, self.simple_key(&cx));
        self.blank(&cx);
        while !self.done(&cx) && self.at(&cx) == b'.' {
            self.advance(&cx);
            self.blank(&cx);
            keys.push(&cx, self.simple_key(&cx));
            self.blank(&cx);
        }
        keys
    }

    fn simple_key(self, &cx: Cx!['k]) -> Text['k] {
        if self.done(&cx) {
            self.fail(&cx);
        }
        let b = self.at(&cx);
        if b == b'"' || b == b'\'' {
            self.string(&cx)
        } else {
            let start = self.i.get(&cx);
            while !self.done(&cx) && is_bare(self.at(&cx)) {
                self.advance(&cx);
            }
            if self.i.get(&cx) == start {
                self.fail(&cx);
            }
            self.src.slice(start, self.i.get(&cx))
        }
    }

    fn value(self, &cx: Cx!['k]) -> Toml['k] {
        if self.done(&cx) {
            self.fail(&cx);
        }
        let b = self.at(&cx);
        if b == b'"' || b == b'\'' {
            Toml::Str.(self.string(&cx))
        } else if b == b'{' {
            self.advance(&cx);
            let table: Map[Text['k], Toml['k], 'k] = Map::new(&cx);
            self.blank(&cx);
            if !self.done(&cx) && self.at(&cx) == b'}' {
                self.advance(&cx);
            } else {
                var going = true;
                while going {
                    self.blank(&cx);
                    let keys = self.key(&cx);
                    self.blank(&cx);
                    self.expect(&cx, b'=');
                    self.blank(&cx);
                    let value = self.value(&cx);
                    self.define(&cx, table, keys, value);
                    self.blank(&cx);
                    if !self.done(&cx) && self.at(&cx) == b',' {
                        self.advance(&cx);
                    } else {
                        self.expect(&cx, b'}');
                        going = false;
                    }
                }
            }
            Toml::Table.(table)
        } else if b == b'[' {
            self.advance(&cx);
            self.space(&cx);
            while !self.done(&cx) && self.at(&cx) != b']' {
                let unit = self.value(&cx);
                self.space(&cx);
                if !self.done(&cx) && self.at(&cx) == b',' {
                    self.advance(&cx);
                    self.space(&cx);
                } else if self.done(&cx) || self.at(&cx) != b']' {
                    self.fail(&cx);
                }
            }
            self.expect(&cx, b']');
            Toml::Other
        } else {
            let start = self.i.get(&cx);
            while !self.done(&cx) && is_scalar(self.at(&cx)) {
                self.advance(&cx);
            }
            if self.i.get(&cx) == start {
                self.fail(&cx);
            }
            Toml::Other
        }
    }

    // A basic or literal string, on one line or several.
    fn string(self, &cx: Cx!['k]) -> Text['k] {
        let quote = self.at(&cx);
        let multi = self.src.slice(self.i.get(&cx), self.i.get(&cx) + 3usize).eq(&cx, Out::new(&cx).byte(&cx, quote).byte(&cx, quote).byte(&cx, quote).done(&cx));
        let out = Out::new(&cx);
        if multi {
            self.i.set(&cx, self.i.get(&cx) + 3usize);
            if !self.done(&cx) && self.at(&cx) == b'\n' {
                self.advance(&cx);
            } else if self.src.slice(self.i.get(&cx), self.i.get(&cx) + 2usize).is(&cx, "\r\n") {
                self.i.set(&cx, self.i.get(&cx) + 2usize);
            }
        } else {
            self.advance(&cx);
        }
        var going = true;
        while going {
            if self.done(&cx) {
                self.fail(&cx);
            }
            let b = self.at(&cx);
            if b == quote && (!multi || (self.src.byte(&cx, self.i.get(&cx) + 1usize) == quote && self.src.byte(&cx, self.i.get(&cx) + 2usize) == quote)) {
                let width = if multi { 3usize } else { 1usize };
                self.i.set(&cx, self.i.get(&cx) + width);
                going = false;
            } else if b == b'\n' && !multi {
                self.fail(&cx);
            } else if b == b'\\' && quote == b'"' {
                self.advance(&cx);
                self.escape(&cx, out, multi);
            } else {
                let unit = out.byte(&cx, b);
                self.advance(&cx);
            }
        }
        out.done(&cx)
    }

    fn escape(self, &cx: Cx!['k], out: Out['k], multi: bool) {
        if self.done(&cx) {
            self.fail(&cx);
        }
        let b = self.at(&cx);
        self.advance(&cx);
        if b == b'n' {
            let unit = out.byte(&cx, b'\n');
        } else if b == b't' {
            let unit = out.byte(&cx, b'\t');
        } else if b == b'r' {
            let unit = out.byte(&cx, b'\r');
        } else if b == b'b' {
            let unit = out.byte(&cx, 8u8);
        } else if b == b'f' {
            let unit = out.byte(&cx, 12u8);
        } else if b == b'"' || b == b'\\' {
            let unit = out.byte(&cx, b);
        } else if b == b'u' || b == b'U' {
            let count = if b == b'u' { 4usize } else { 8usize };
            var code = 0u32;
            var k = 0usize;
            while k < count {
                let d = self.at(&cx);
                let digit = if d >= b'0' && d <= b'9' {
                    (d - b'0') as u32
                } else if d >= b'a' && d <= b'f' {
                    (d - b'a') as u32 + 10u32
                } else if d >= b'A' && d <= b'F' {
                    (d - b'A') as u32 + 10u32
                } else {
                    self.fail(&cx)
                };
                code = code * 16u32 + digit;
                self.advance(&cx);
                k = k + 1usize;
            }
            utf8(&cx, out, code);
        } else if multi && (b == b'\n' || b == b' ' || b == b'\t' || b == b'\r') {
            // A line-ending backslash drops the whitespace after it.
            self.i.set(&cx, self.i.get(&cx) - 1usize);
            self.space(&cx);
        } else {
            self.fail(&cx);
        }
    }
}

fn is_bare(b: u8) -> bool {
    (b >= b'A' && b <= b'Z') || (b >= b'a' && b <= b'z') || (b >= b'0' && b <= b'9') || b == b'_' || b == b'-'
}

fn is_scalar(b: u8) -> bool {
    !(b == b' ' || b == b'\t' || b == b'\r' || b == b'\n' || b == b',' || b == b']' || b == b'}' || b == b'#')
}

forall 'k.
fn utf8(&cx: Cx!['k], out: Out['k], code: u32) {
    if code < 128u32 {
        let unit = out.byte(&cx, code as u8);
    } else if code < 2048u32 {
        let unit = out.byte(&cx, (192u32 | (code >> 6u32)) as u8).byte(&cx, (128u32 | (code & 63u32)) as u8);
    } else if code < 65536u32 {
        let unit = out.byte(&cx, (224u32 | (code >> 12u32)) as u8).byte(&cx, (128u32 | ((code >> 6u32) & 63u32)) as u8).byte(&cx, (128u32 | (code & 63u32)) as u8);
    } else {
        let unit = out.byte(&cx, (240u32 | (code >> 18u32)) as u8).byte(&cx, (128u32 | ((code >> 12u32) & 63u32)) as u8).byte(&cx, (128u32 | ((code >> 6u32) & 63u32)) as u8).byte(&cx, (128u32 | (code & 63u32)) as u8);
    }
}

// ------------------------------------------------------------ the graph --

// A declaration: compared by its `id`, unique in the program.
forall 'k.
exposed struct Decl {
    id: u32,
    // struct enum tuple fn extern trait const method
    kind: Text['k],
    home: ModuleId['k],
    // a method's name is `Target::method`
    name: Text['k],
    node: Named['k],
    // a method's or associated const's impl
    impl_block: Option[S::Impl['k]],
}

forall 'k.
instance HashIn[Decl['k], Cx!['k]] {
    fn hash_in(cap: Cx!['k], key: Decl['k], state: HashState) -> (Cx!['k], HashState) {
        var cx = cap;
        let h = key_hash(&cx, key.id);
        (cx, state.write_u64(h))
    }

    fn eq_in(cap: Cx!['k], a: Decl['k], b: Decl['k]) -> (Cx!['k], bool) {
        var cx = cap;
        let equal = a.id == b.id;
        (cx, equal)
    }
}

// The item a declaration declares.
forall 'k.
exposed enum Named {
    Struct(S::StructDecl['k]),
    Enum(S::EnumDecl['k]),
    Tuple(S::TupleDecl['k]),
    Fn(S::Fn['k]),
    Extern(S::Extern['k]),
    Trait(S::TraitDecl['k]),
    Const(S::Const['k]),
}

forall 'k.
fn named_pos(n: Named['k]) -> Pos {
    match n {
        Named::Struct(x) => x.pos,
        Named::Enum(x) => x.pos,
        Named::Tuple(x) => x.pos,
        Named::Fn(x) => x.pos,
        Named::Extern(x) => x.pos,
        Named::Trait(x) => x.pos,
        Named::Const(x) => x.pos,
    }
}

forall 'k.
fn item_pos(item: S::Item['k]) -> Pos {
    match item {
        S::Item::Use(x) => x.pos,
        S::Item::Module(x) => x.pos,
        S::Item::Struct(x) => x.pos,
        S::Item::Tuple(x) => x.pos,
        S::Item::Enum(x) => x.pos,
        S::Item::Fn(x) => x.pos,
        S::Item::Extern(x) => x.pos,
        S::Item::Const(x) => x.pos,
        S::Item::Impl(x) => x.pos,
        S::Item::Trait(x) => x.pos,
        S::Item::Instance(x) => x.pos,
    }
}

forall 'k.
exposed struct Package {
    id: usize,
    name: Cell[Text['k], 'k],
    // its directory
    root: Text['k],
    source_root: Cell[Text['k], 'k],
    // alias -> package id
    deps: Map[Text['k], usize, 'k],
    // an executable's entry path
    entry: Cell[Option[Seq[Text['k], 'k]], 'k],
    // module -> source path
    files: Map[ModuleId['k], Text['k], 'k],
    entry_decl: Cell[Option[Decl['k]], 'k],
}

// One module's namespace.
forall 'k.
exposed struct Scope {
    home: ModuleId['k],
    decls: Map[Text['k], Decl['k], 'k],
    // alias -> path
    imports: Map[Text['k], Seq[Text['k], 'k], 'k],
    globs: Seq[Seq[Text['k], 'k], 'k],
    exports: Set[Text['k], 'k],
    items: Seq[S::Item['k], 'k],
}

// What a path names.
forall 'k.
exposed enum Target {
    Decl(Decl['k]),
    Module(ModuleId['k]),
    Variant(Decl['k], Text['k]),
    TraitMethod(Decl['k], Text['k]),
}

// What a resolved node names; see the top of this file.
forall 'k.
exposed enum NameRef {
    Decl(Decl['k]),
    Variant(Decl['k], Text['k]),
    TraitMethod(Decl['k], Text['k]),
    Assoc(Text['k], Text['k]),
    Param(Text['k]),
    Prim(Text['k]),
    Builtin(Text['k]),
    Local(Text['k]),
}

// A resolution error, before its file is known; a `pos` on line 0 is no position.
forall 'k.
exposed struct Problem {
    message: Text['k],
    pos: Pos,
}

// What a method or associated const is attached to: a type declaration, a primitive type, or
// nothing, for a blanket impl whose methods are found by method calls only.
forall 'k.
exposed enum Owner {
    Decl(Decl['k]),
    Prim(Text['k]),
    Blanket,
}

forall 'k.
instance HashIn[Owner['k], Cx!['k]] {
    fn hash_in(cap: Cx!['k], key: Owner['k], state: HashState) -> (Cx!['k], HashState) {
        var cx = cap;
        let h = {
            match key {
                Owner::Decl(d) => combine(1u64, key_hash(&cx, d.id)),
                Owner::Prim(name) => combine(2u64, name.hash(&cx)),
                Owner::Blanket => 3u64,
            }
        };
        (cx, state.write_u64(h))
    }

    fn eq_in(cap: Cx!['k], a: Owner['k], b: Owner['k]) -> (Cx!['k], bool) {
        var cx = cap;
        let equal = {
            match a {
                Owner::Decl(x) => match b {
                    Owner::Decl(y) => x.id == y.id,
                    _ => false,
                },
                Owner::Prim(x) => match b {
                    Owner::Prim(y) => x.eq(&cx, y),
                    _ => false,
                },
                Owner::Blanket => match b {
                    Owner::Blanket => true,
                    _ => false,
                },
            }
        };
        (cx, equal)
    }
}

// A file and a position errors inside it are reported at when they have none of their own.
forall 'k.
exposed struct Location {
    file: Text['k],
    pos: Pos,
}

// An error as `KursError` prints it: `line:col: message`, or the message alone.
forall 'k.
fn error_text(&cx: Cx!['k], message: Text['k], pos: Pos) -> Text['k] {
    if pos.line == 0u32 {
        message
    } else {
        Out::new(&cx).u64(&cx, pos.line as u64).put(&cx, ":").u64(&cx, pos.col as u64).put(&cx, ": ").add(&cx, message).done(&cx)
    }
}

// The error `message` at `pos`, printed as `full`, naming `file` and, when it has no position of
// its own, the position `at` of the item it is in. Returns the new printed form and position.
forall 'k.
fn located(&cx: Cx!['k], full: Text['k], message: Text['k], pos: Pos, file: Text['k], at: Pos) -> (Text['k], Pos) {
    if full.starts_with(&cx, file) {
        (full, pos)
    } else {
        let at_pos = if pos.line != 0u32 { pos } else { at };
        let prefix = if at_pos.line != 0u32 {
            Out::new(&cx).add(&cx, file).put(&cx, ":").u64(&cx, at_pos.line as u64).put(&cx, ":").u64(&cx, at_pos.col as u64).done(&cx)
        } else {
            file
        };
        (Out::new(&cx).add(&cx, prefix).put(&cx, ": ").add(&cx, message).done(&cx), at_pos)
    }
}

// The package graph rooted at a package directory, its kur.toml, or one .kur file. A single file
// depends on the standard library `std` when one is installed (KURSAL_LIB). `ids` numbers the
// syntax nodes.
forall 'k.
fn load(&cx: Cx!['k], path: Text['k], ids: Cell[u32, 'k]) -> Seq[Package['k], 'k] {
    let path = resolved(&cx, path);
    let packages: Seq[Package['k], 'k] = Seq::new(&cx);
    let by_dir: Map[Text['k], usize, 'k] = Map::new(&cx);
    if suffix(&cx, path).is(&cx, ".kur") {
        let items = parse(&cx, read_source(&cx, path), path, ids);
        var main = false;
        var i = 0usize;
        while i < items.len(&cx) {
            let unit = match items.get(&cx, i) {
                S::Item::Fn(f) => {
                    if f.name.is(&cx, "main") {
                        main = true;
                    }
                },
                _ => (),
            };
            i = i + 1usize;
        }
        let std: Map[Text['k], Text['k], 'k] = Map::new(&cx);
        let lib = lib_dir(&cx);
        if path_exists(&cx, join(&cx, join(&cx, lib, text(&cx, "std")), text(&cx, "kur.toml"))) {
            std.set(&cx, text(&cx, "std"), join(&cx, lib, text(&cx, "std")));
        }
        let entry = if main { Option::Some.(Seq::one(&cx, text(&cx, "main"))) } else { Option::None };
        let unit = add(&cx, packages, by_dir, path, Option::Some.(stem(&cx, path)), Option::Some.(parent(&cx, path)), Option::Some.(std), entry);
        packages.get(&cx, 0usize).files.set(&cx, ModuleId::root(&cx, 0usize), path);
    } else {
        let manifest = if suffix(&cx, path).is(&cx, ".toml") { path } else { join(&cx, path, text(&cx, "kur.toml")) };
        let unit = add(&cx, packages, by_dir, manifest, Option::None, Option::None, Option::None, Option::None);
    }
    var p = 0usize;
    while p < packages.len(&cx) {
        let package = packages.get(&cx, p);
        if package.files.is_empty(&cx) {
            let found = discover(&cx, package);
            let modules = found.keys(&cx);
            var k = 0usize;
            while k < modules.len(&cx) {
                package.files.set(&cx, modules.get(&cx, k), found.at(&cx, modules.get(&cx, k)));
                k = k + 1usize;
            }
            if !package.files.has(&cx, ModuleId::root(&cx, package.id)) {
                fail(&cx, Out::new(&cx).put(&cx, "package ").add(&cx, package.name.get(&cx)).put(&cx, " has no lib.kur in ").add(&cx, package.source_root.get(&cx)).done(&cx));
            }
        }
        p = p + 1usize;
    }
    check_acyclic(&cx, packages);
    packages
}

forall 'k.
fn read_source(&cx: Cx!['k], path: Text['k]) -> Text['k] {
    match read(&cx, path) {
        Option::Some(s) => s,
        Option::None => fail(&cx, Out::new(&cx).put(&cx, "cannot read ").add(&cx, path).done(&cx)),
    }
}

// The package of `manifest` (a kur.toml, or a single .kur file), added with its dependencies
// unless its directory's manifest was added already.
forall 'k.
fn add(&cx: Cx!['k], packages: Seq[Package['k], 'k], by_dir: Map[Text['k], usize, 'k], manifest: Text['k], name: Option[Text['k]], source_root: Option[Text['k]],
       deps: Option[Map[Text['k], Text['k], 'k]], entry: Option[Seq[Text['k], 'k]]) -> usize {
    let root = parent(&cx, manifest);
    let is_toml = suffix(&cx, manifest).is(&cx, ".toml");
    if is_toml {
        let unit = match by_dir.get(&cx, root) {
            Option::Some(id) => return id,
            Option::None => (),
        };
    }
    let package = Package.{
        id: packages.len(&cx),
        name: Cell::new(&cx, match name { Option::Some(n) => n, Option::None => base_name(&cx, root) }),
        root,
        source_root: Cell::new(&cx, match source_root { Option::Some(s) => s, Option::None => root }),
        deps: Map::new(&cx),
        entry: Cell::new(&cx, entry),
        files: Map::new(&cx),
        entry_decl: Cell::new(&cx, Option::None),
    };
    packages.push(&cx, package);
    var deps: Map[Text['k], Text['k], 'k] = match deps {
        Option::Some(d) => d,
        Option::None => Map::new(&cx),
    };
    if is_toml {
        by_dir.set(&cx, root, package.id);
        let config = table(&cx, Toml::Table.(read_toml(&cx, read_source(&cx, manifest), manifest)), manifest);
        let info = table(&cx, config.get_or(&cx, text(&cx, "package"), Toml::Table.(Map::new(&cx))), text(&cx, "package"));
        let unknown: Set[Text['k], 'k] = Set::new(&cx);
        let config_keys = config.keys(&cx);
        var i = 0usize;
        while i < config_keys.len(&cx) {
            let key = config_keys.get(&cx, i);
            if !key.is(&cx, "package") && !key.is(&cx, "dependencies") {
                unknown.add(&cx, key);
            }
            i = i + 1usize;
        }
        let info_keys = info.keys(&cx);
        i = 0usize;
        while i < info_keys.len(&cx) {
            let key = info_keys.get(&cx, i);
            if !among(&cx, key, "name kind source_root entry") {
                unknown.add(&cx, key);
            }
            i = i + 1usize;
        }
        if unknown.len(&cx) > 0usize {
            let names = unknown.items(&cx);
            names.sort(&cx, text_before);
            let out = Out::new(&cx).add(&cx, manifest).put(&cx, ": unknown manifest keys [");
            var k = 0usize;
            while k < names.len(&cx) {
                let unit = out.put(&cx, if k > 0usize { ", " } else { "" }).add(&cx, repr(&cx, names.get(&cx, k)));
                k = k + 1usize;
            }
            fail(&cx, out.put(&cx, "]").done(&cx));
        }
        package.name.set(&cx, string(&cx, info, "name", Option::None));
        package.source_root.set(&cx, resolved(&cx, join(&cx, root, string(&cx, info, "source_root", Option::Some.(text(&cx, "src"))))));
        if string(&cx, info, "kind", Option::Some.(text(&cx, "library"))).is(&cx, "executable") {
            let parts = string(&cx, info, "entry", Option::None).split(&cx, text(&cx, "::"));
            let path: Seq[Text['k], 'k] = Seq::new(&cx);
            var k = 0usize;
            while k < parts.len(&cx) {
                if !parts.get(&cx, k).is(&cx, "package") {
                    path.push(&cx, parts.get(&cx, k));
                }
                k = k + 1usize;
            }
            package.entry.set(&cx, Option::Some.(path));
        }
        deps = Map::new(&cx);
        let specs = table(&cx, config.get_or(&cx, text(&cx, "dependencies"), Toml::Table.(Map::new(&cx))), text(&cx, "dependencies"));
        let aliases = specs.keys(&cx);
        var k = 0usize;
        while k < aliases.len(&cx) {
            let alias = aliases.get(&cx, k);
            deps.set(&cx, alias, resolved(&cx, join(&cx, root, string(&cx, table(&cx, specs.at(&cx, alias), alias), "path", Option::None))));
            k = k + 1usize;
        }
    }
    let aliases = deps.keys(&cx);
    var k = 0usize;
    while k < aliases.len(&cx) {
        let target = deps.at(&cx, aliases.get(&cx, k));
        let manifest_path = if suffix(&cx, target).is(&cx, ".toml") { target } else { join(&cx, target, text(&cx, "kur.toml")) };
        package.deps.set(&cx, aliases.get(&cx, k), add(&cx, packages, by_dir, manifest_path, Option::None, Option::None, Option::None, Option::None));
        k = k + 1usize;
    }
    package.id
}

forall 'k.
fn table(&cx: Cx!['k], value: Toml['k], at_pos: Text['k]) -> Map[Text['k], Toml['k], 'k] {
    match value {
        Toml::Table(t) => t,
        _ => fail(&cx, Out::new(&cx).add(&cx, at_pos).put(&cx, ": expected a table").done(&cx)),
    }
}

forall 'k.
fn string(&cx: Cx!['k], t: Map[Text['k], Toml['k], 'k], key: Slice[u8, 'static], default: Option[Text['k]]) -> Text['k] {
    let value = match t.get(&cx, text(&cx, key)) {
        Option::Some(v) => v,
        Option::None => match default {
            Option::Some(d) => Toml::Str.(d),
            Option::None => Toml::Other,
        },
    };
    match value {
        Toml::Str(s) => s,
        _ => fail(&cx, Out::new(&cx).put(&cx, "manifest ").add(&cx, repr(&cx, text(&cx, key))).put(&cx, " must be a string").done(&cx)),
    }
}

// Each .kur file under the source root, by the module its path assigns.
forall 'k.
fn discover(&cx: Cx!['k], package: Package['k]) -> Map[ModuleId['k], Text['k], 'k] {
    let files: Map[ModuleId['k], Text['k], 'k] = Map::new(&cx);
    walk(&cx, package, package.source_root.get(&cx), Seq::new(&cx), files);
    files
}

// The files of directory `here`, at `rel` under the source root, then its subdirectories in order;
// a subdirectory with its own kur.toml is another package.
forall 'k.
fn walk(&cx: Cx!['k], package: Package['k], here: Text['k], rel: Seq[Text['k], 'k], files: Map[ModuleId['k], Text['k], 'k]) {
    if !rel.is_empty(&cx) && path_exists(&cx, join(&cx, here, text(&cx, "kur.toml"))) {
        return;
    }
    let entries = list_directory(&cx, here);
    let dirs: Seq[Text['k], 'k] = Seq::new(&cx);
    let names: Seq[Text['k], 'k] = Seq::new(&cx);
    var i = 0usize;
    while i < entries.len(&cx) {
        let (name, is_directory) = entries.get(&cx, i);
        if is_directory {
            dirs.push(&cx, name);
        } else {
            names.push(&cx, name);
        }
        i = i + 1usize;
    }
    dirs.sort(&cx, text_before);
    names.sort(&cx, text_before);
    i = 0usize;
    while i < names.len(&cx) {
        let name = names.get(&cx, i);
        if name.ends_with(&cx, text(&cx, ".kur")) {
            let path = rel.copy(&cx);
            let module_name = stem(&cx, name);
            if !module_name.is(&cx, "lib") {
                path.push(&cx, module_name);
            }
            let home = ModuleId.{ package: package.id, path };
            if files.has(&cx, home) {
                fail(&cx, Out::new(&cx).put(&cx, "two files define module ").add(&cx, joined(&cx, path)).put(&cx, " of ").add(&cx, package.name.get(&cx)).done(&cx));
            }
            files.set(&cx, home, join(&cx, here, name));
        }
        i = i + 1usize;
    }
    i = 0usize;
    while i < dirs.len(&cx) {
        let sub = rel.copy(&cx);
        sub.push(&cx, dirs.get(&cx, i));
        walk(&cx, package, join(&cx, here, dirs.get(&cx, i)), sub, files);
        i = i + 1usize;
    }
}

forall 'k.
fn check_acyclic(&cx: Cx!['k], packages: Seq[Package['k], 'k]) {
    let state: Map[usize, u32, 'k] = Map::new(&cx);
    var p = 0usize;
    while p < packages.len(&cx) {
        visit(&cx, packages, state, p);
        p = p + 1usize;
    }
}

forall 'k.
fn visit(&cx: Cx!['k], packages: Seq[Package['k], 'k], state: Map[usize, u32, 'k], package_id: usize) {
    let s = state.get_or(&cx, package_id, 0u32);
    if s == 1u32 {
        fail(&cx, Out::new(&cx).put(&cx, "dependency cycle through package ").add(&cx, packages.get(&cx, package_id).name.get(&cx)).done(&cx));
    }
    if s == 0u32 {
        state.set(&cx, package_id, 1u32);
        let deps = packages.get(&cx, package_id).deps.values(&cx);
        var i = 0usize;
        while i < deps.len(&cx) {
            visit(&cx, packages, state, deps.get(&cx, i));
            i = i + 1usize;
        }
        state.set(&cx, package_id, 2u32);
    }
}

// ------------------------------------------------------------ namespaces --

// A lookup: `("path", module, path)`, `("import", module, [alias])` or `("export", module, [name])`.
forall 'k.
fn lookup_key(&cx: Cx!['k], kind: Slice[u8, 'static], home: ModuleId['k], names: Seq[Text['k], 'k]) -> (Text['k], ModuleId['k], Seq[Text['k], 'k]) {
    (text(&cx, kind), home, names)
}

forall 'k.
fn problem(message: Text['k]) -> Result[Target['k], Problem['k]] {
    Result::Err.(Problem.{ message, pos: no_pos() })
}

forall 'k.
exposed struct Resolver {
    packages: Seq[Package['k], 'k],
    scopes: Map[ModuleId['k], Scope['k], 'k],
    children: Map[ModuleId['k], Map[Text['k], ModuleId['k], 'k], 'k],
    instances: Seq[(ModuleId['k], S::InstanceDecl['k]), 'k],
    // (owner, member) -> declarations
    attached: Map[(Owner['k], Text['k]), Seq[Decl['k], 'k], 'k],
    cache: Map[(Text['k], ModuleId['k], Seq[Text['k], 'k]), Target['k], 'k],
    active: Set[(Text['k], ModuleId['k], Seq[Text['k], 'k]), 'k],
    // the glob imports being resolved, by module and path
    expanding: Set[(ModuleId['k], Seq[Text['k], 'k]), 'k],
    // node id -> what it names
    refs: Map[u32, NameRef['k], 'k],
    // The files and positions errors are reported in, innermost last.
    locations: Seq[Location['k], 'k],
    decl_ids: Cell[u32, 'k],
}

forall 'k.
impl Resolver['k] {
    fn new(&cx: Cx!['k], packages: Seq[Package['k], 'k], ids: Cell[u32, 'k]) -> Resolver['k] {
        let r = Resolver.{
            packages,
            scopes: Map::new(&cx),
            children: Map::new(&cx),
            instances: Seq::new(&cx),
            attached: Map::new(&cx),
            cache: Map::new(&cx),
            active: Set::new(&cx),
            expanding: Set::new(&cx),
            refs: Map::new(&cx),
            locations: Seq::new(&cx),
            decl_ids: Cell::new(&cx, 0u32),
        };
        var p = 0usize;
        while p < packages.len(&cx) {
            let package = packages.get(&cx, p);
            let unit = r.children_of(&cx, ModuleId::root(&cx, package.id));
            let modules = package.files.keys(&cx);
            var i = 0usize;
            while i < modules.len(&cx) {
                let home = modules.get(&cx, i);
                let file = package.files.at(&cx, home);
                r.collect(&cx, home, parse(&cx, read_source(&cx, file), file, ids));
                var k = 0usize;
                while k < home.path.len(&cx) {
                    let parent = ModuleId.{ package: home.package, path: home.path.slice(&cx, 0usize, k) };
                    let name = home.path.get(&cx, k);
                    r.children_of(&cx, parent).set(&cx, name, parent.child(&cx, name));
                    let unit = r.children_of(&cx, parent.child(&cx, name));
                    k = k + 1usize;
                }
                i = i + 1usize;
            }
            p = p + 1usize;
        }
        let scopes = r.scopes.values(&cx);
        var s = 0usize;
        while s < scopes.len(&cx) {
            r.attach(&cx, scopes.get(&cx, s));
            s = s + 1usize;
        }
        r
    }

    // `children.setdefault(module, {})`.
    fn children_of(self, &cx: Cx!['k], home: ModuleId['k]) -> Map[Text['k], ModuleId['k], 'k] {
        match self.children.get(&cx, home) {
            Option::Some(c) => c,
            Option::None => {
                let c: Map[Text['k], ModuleId['k], 'k] = Map::new(&cx);
                self.children.set(&cx, home, c);
                c
            },
        }
    }

    fn new_decl(self, &cx: Cx!['k], kind: Slice[u8, 'static], home: ModuleId['k], name: Text['k], node: Named['k], impl_block: Option[S::Impl['k]]) -> Decl['k] {
        let id = self.decl_ids.get(&cx);
        self.decl_ids.set(&cx, id + 1u32);
        Decl.{ id, kind: text(&cx, kind), home, name, node, impl_block }
    }

    fn collect(self, &cx: Cx!['k], home: ModuleId['k], items: Seq[S::Item['k], 'k]) {
        let scope = Scope.{ home, decls: Map::new(&cx), imports: Map::new(&cx), globs: Seq::new(&cx), exports: Set::new(&cx), items };
        self.scopes.set(&cx, home, scope);
        var i = 0usize;
        while i < items.len(&cx) {
            let unit = match items.get(&cx, i) {
                S::Item::Module(m) => self.fail(&cx, text(&cx, "package sources do not declare 'module'"), m.pos),
                S::Item::Use(u) => self.use_tree(&cx, scope, Seq::new(&cx), u.tree, u.is_export),
                S::Item::Instance(n) => self.instances.push(&cx, (home, n)),
                S::Item::Struct(x) => self.declare(&cx, scope, self.new_decl(&cx, "struct", home, x.name, Named::Struct.(x), Option::None)),
                S::Item::Enum(x) => self.declare(&cx, scope, self.new_decl(&cx, "enum", home, x.name, Named::Enum.(x), Option::None)),
                S::Item::Tuple(x) => self.declare(&cx, scope, self.new_decl(&cx, "tuple", home, x.name, Named::Tuple.(x), Option::None)),
                S::Item::Fn(x) => self.declare(&cx, scope, self.new_decl(&cx, "fn", home, x.name, Named::Fn.(x), Option::None)),
                S::Item::Extern(x) => self.declare(&cx, scope, self.new_decl(&cx, "extern", home, x.name, Named::Extern.(x), Option::None)),
                S::Item::Trait(x) => self.declare(&cx, scope, self.new_decl(&cx, "trait", home, x.name, Named::Trait.(x), Option::None)),
                S::Item::Const(x) => self.declare(&cx, scope, self.new_decl(&cx, "const", home, x.name, Named::Const.(x), Option::None)),
                S::Item::Impl(x) => (),
            };
            i = i + 1usize;
        }
    }

    fn declare(self, &cx: Cx!['k], scope: Scope['k], decl: Decl['k]) {
        if scope.decls.has(&cx, decl.name) || scope.imports.has(&cx, decl.name) {
            self.fail(&cx, Out::new(&cx).put(&cx, "duplicate name ").add(&cx, decl.name).done(&cx), named_pos(decl.node));
        }
        scope.decls.set(&cx, decl.name, decl);
    }

    fn use_tree(self, &cx: Cx!['k], scope: Scope['k], prefix: Seq[Text['k], 'k], tree: S::UseTree['k], exported: bool) {
        let path = prefix.copy(&cx);
        path.append(&cx, tree.path);
        if tree.star {
            scope.globs.push(&cx, path);
        } else if !tree.children.is_empty(&cx) {
            var i = 0usize;
            while i < tree.children.len(&cx) {
                self.use_tree(&cx, scope, path, tree.children.get(&cx, i), exported);
                i = i + 1usize;
            }
        } else {
            let name = match tree.alias {
                Option::Some(a) => a,
                Option::None => path.last(&cx),
            };
            // `export name;` publishes an existing name
            if exported && path.len(&cx) == 1usize && path.get(&cx, 0usize).eq(&cx, name) {
                scope.exports.add(&cx, name);
                return;
            }
            if name.is(&cx, "package") || name.is(&cx, "builtin") || is_builtin_trait(&cx, name) {
                self.fail(&cx, Out::new(&cx).put(&cx, "'").add(&cx, name).put(&cx, "' is compiler-sealed").done(&cx), no_pos());
            }
            if scope.imports.has(&cx, name) || scope.decls.has(&cx, name) {
                self.fail(&cx, Out::new(&cx).put(&cx, "duplicate import ").add(&cx, name).put(&cx, " in ").add(&cx, repr_module(&cx, scope.home)).done(&cx), no_pos());
            }
            scope.imports.set(&cx, name, path);
            if exported {
                scope.exports.add(&cx, name);
            }
        }
    }

    // Methods and associated consts are declared by their impl's module and attached to the impl's
    // target type for `Target::name` lookup.
    fn attach(self, &cx: Cx!['k], scope: Scope['k]) {
        var i = 0usize;
        while i < scope.items.len(&cx) {
            let unit = match scope.items.get(&cx, i) {
                S::Item::Impl(m) => self.attach_impl(&cx, scope, m),
                _ => (),
            };
            i = i + 1usize;
        }
    }

    fn attach_impl(self, &cx: Cx!['k], scope: Scope['k], item: S::Impl['k]) {
        let target = match item.type {
            Type::Name(n) => n,
            _ => self.fail(&cx, text(&cx, "an impl target must be a named type"), item.pos),
        };
        let spelled = target.path.last(&cx);
        let params = match item.quantifier {
            Option::Some(f) => f.params,
            Option::None => Seq::new(&cx),
        };
        let owner = if target.path.len(&cx) == 1usize && is_prim(&cx, target.path.get(&cx, 0usize)) {
            Owner::Prim.(target.path.get(&cx, 0usize))
        } else if target.path.len(&cx) == 1usize && params.has(&cx, target.path.get(&cx, 0usize)) {
            // a blanket impl: its methods are found by method calls only
            Owner::Blanket
        } else {
            match self.need(&cx, scope.home, target.path, item.pos) {
                Target::Decl(d) => Owner::Decl.(d),
                _ => self.fail(&cx, text(&cx, "an impl target must name a type declaration"), item.pos),
            }
        };
        var k = 0usize;
        while k < item.items.len(&cx) {
            let decl = match item.items.get(&cx, k) {
                S::Member::Fn(f) => self.new_decl(&cx, "method", scope.home, Out::new(&cx).add(&cx, spelled).put(&cx, "::").add(&cx, f.name).done(&cx), Named::Fn.(f), Option::Some.(item)),
                S::Member::Const(c) => self.new_decl(&cx, "const", scope.home, Out::new(&cx).add(&cx, spelled).put(&cx, "::").add(&cx, c.name).done(&cx), Named::Const.(c), Option::Some.(item)),
            };
            let member = match item.items.get(&cx, k) {
                S::Member::Fn(f) => f.name,
                S::Member::Const(c) => c.name,
            };
            self.declare(&cx, scope, decl);
            let key = (owner, member);
            match self.attached.get(&cx, key) {
                Option::Some(found) => found.push(&cx, decl),
                Option::None => self.attached.set(&cx, key, Seq::one(&cx, decl)),
            }
            k = k + 1usize;
        }
    }

    // ---- errors
    fn file(self, &cx: Cx!['k], home: ModuleId['k]) -> Text['k] {
        self.packages.get(&cx, home.package).files.at(&cx, home)
    }

    // Errors from here until `unlocate` are inside `module`'s file and, when they have no
    // position, at `pos`.
    fn locate(self, &cx: Cx!['k], home: ModuleId['k], pos: Pos) {
        self.locations.push(&cx, Location.{ file: self.file(&cx, home), pos });
    }

    fn unlocate(self, &cx: Cx!['k]) {
        let unit = self.locations.pop(&cx);
    }

    // Stops with `message` at `pos` (none on line 0), naming the files it is located in.
    fn fail(self, &cx: Cx!['k], message: Text['k], pos: Pos) -> ! {
        var full = error_text(&cx, message, pos);
        var at = pos;
        var i = self.locations.len(&cx);
        while i > 0usize {
            i = i - 1usize;
            let l = self.locations.get(&cx, i);
            let (f, p) = located(&cx, full, message, at, l.file, l.pos);
            full = f;
            at = p;
        }
        fail(&cx, full)
    }

    // ---- path lookup
    // What `path` names from `module`, or why it names nothing; an error without a position gets
    // `pos`.
    fn lookup(self, &cx: Cx!['k], home: ModuleId['k], path: Seq[Text['k], 'k], pos: Pos) -> Result[Target['k], Problem['k]] {
        match self.solve(&cx, lookup_key(&cx, "path", home, path)) {
            Result::Ok(t) => Result::Ok.(t),
            Result::Err(e) => if e.pos.line == 0u32 && pos.line != 0u32 {
                Result::Err.(Problem.{ message: e.message, pos })
            } else {
                Result::Err.(e)
            },
        }
    }

    // What `path` names from `module`, stopping if it names nothing.
    fn need(self, &cx: Cx!['k], home: ModuleId['k], path: Seq[Text['k], 'k], pos: Pos) -> Target['k] {
        match self.lookup(&cx, home, path, pos) {
            Result::Ok(t) => t,
            Result::Err(e) => self.fail(&cx, e.message, e.pos),
        }
    }

    fn solve(self, &cx: Cx!['k], key: (Text['k], ModuleId['k], Seq[Text['k], 'k])) -> Result[Target['k], Problem['k]] {
        let unit = match self.cache.get(&cx, key) {
            Option::Some(t) => return Result::Ok.(t),
            Option::None => (),
        };
        let (kind, home, names) = key;
        if self.active.has(&cx, key) {
            let at = if kind.is(&cx, "path") { repr_tuple(&cx, names) } else { names.get(&cx, 0usize) };
            return problem(Out::new(&cx).put(&cx, "import cycle at ").add(&cx, at).done(&cx));
        }
        self.active.add(&cx, key);
        let value = if kind.is(&cx, "import") {
            self.resolve_path(&cx, home, self.scopes.at(&cx, home).imports.at(&cx, names.get(&cx, 0usize)), Option::Some.(names.get(&cx, 0usize)))
        } else {
            self.resolve_path(&cx, home, names, Option::None)
        };
        self.active.remove(&cx, key);
        match value {
            Result::Ok(t) => {
                self.cache.set(&cx, key, t);
                Result::Ok.(t)
            },
            Result::Err(e) => Result::Err.(e),
        }
    }

    fn resolve_path(self, &cx: Cx!['k], home: ModuleId['k], path: Seq[Text['k], 'k], importing: Option[Text['k]]) -> Result[Target['k], Problem['k]] {
        let first = path.get(&cx, 0usize);
        let rest = path.from(&cx, 1usize);
        let scope = self.scopes.at(&cx, home);
        let not_importing = match importing {
            Option::Some(name) => !name.eq(&cx, first),
            Option::None => true,
        };
        var target = if first.is(&cx, "package") {
            Target::Module.(ModuleId::root(&cx, home.package))
        } else if scope.decls.has(&cx, first) {
            Target::Decl.(scope.decls.at(&cx, first))
        } else if scope.imports.has(&cx, first) && not_importing {
            match self.solve(&cx, lookup_key(&cx, "import", home, Seq::one(&cx, first))) {
                Result::Ok(t) => t,
                Result::Err(e) => return Result::Err.(e),
            }
        } else {
            match self.root_member(&cx, home, first) {
                Option::Some(t) => t,
                Option::None => match self.glob(&cx, home, first) {
                    Result::Ok(found) => match found {
                        Option::Some(t) => t,
                        Option::None => return problem(Out::new(&cx).put(&cx, "unknown name ").add(&cx, joined(&cx, path)).done(&cx)),
                    },
                    Result::Err(e) => return Result::Err.(e),
                },
            }
        };
        var k = 0usize;
        while k < rest.len(&cx) {
            target = match target {
                Target::Decl(d) => return self.associated(&cx, d, joined(&cx, rest.from(&cx, k))),
                Target::Module(m) => match self.member(&cx, home, m, rest.get(&cx, k)) {
                    Result::Ok(t) => t,
                    Result::Err(e) => return Result::Err.(e),
                },
                _ => return problem(Out::new(&cx).add(&cx, joined(&cx, path.slice(&cx, 0usize, k + 1usize))).put(&cx, " is not a module").done(&cx)),
            };
            k = k + 1usize;
        }
        Result::Ok.(target)
    }

    fn root_member(self, &cx: Cx!['k], home: ModuleId['k], name: Text['k]) -> Option[Target['k]] {
        let package = self.packages.get(&cx, home.package);
        let root = ModuleId::root(&cx, home.package);
        if package.deps.has(&cx, name) {
            return Option::Some.(Target::Module.(ModuleId::root(&cx, package.deps.at(&cx, name))));
        }
        let children = self.children.at(&cx, root);
        if children.has(&cx, name) {
            return Option::Some.(Target::Module.(children.at(&cx, name)));
        }
        match self.scopes.get(&cx, root) {
            Option::Some(scope) => match scope.decls.get(&cx, name) {
                Option::Some(d) => Option::Some.(Target::Decl.(d)),
                Option::None => Option::None,
            },
            Option::None => Option::None,
        }
    }

    // `name` through the module's glob imports, in order. A glob whose own path is being resolved
    // offers nothing more: its path's first name is unknown in the module itself.
    fn glob(self, &cx: Cx!['k], home: ModuleId['k], name: Text['k]) -> Result[Option[Target['k]], Problem['k]] {
        let globs = self.scopes.at(&cx, home).globs;
        var i = 0usize;
        while i < globs.len(&cx) {
            let path = globs.get(&cx, i);
            if !self.expanding.has(&cx, (home, path)) {
                self.expanding.add(&cx, (home, path));
                let found = self.resolve_path(&cx, home, path, Option::None);
                self.expanding.remove(&cx, (home, path));
                let source = match found {
                    Result::Ok(t) => t,
                    Result::Err(e) => return Result::Err.(e),
                };
                let unit = match source {
                    Target::Module(m) => match self.member(&cx, home, m, name) {
                        Result::Ok(t) => return Result::Ok.(Option::Some.(t)),
                        Result::Err(e) => (),
                    },
                    _ => return Result::Err.(Problem.{ message: Out::new(&cx).add(&cx, joined(&cx, path)).put(&cx, " is not a module").done(&cx), pos: no_pos() }),
                };
            }
            i = i + 1usize;
        }
        Result::Ok.(Option::None)
    }

    // `module::name`, seen from `caller`: its own declarations; within one package also its
    // children and imports; across packages only exports.
    fn member(self, &cx: Cx!['k], caller: ModuleId['k], home: ModuleId['k], name: Text['k]) -> Result[Target['k], Problem['k]] {
        let scope = self.scopes.get(&cx, home);
        let unit = match scope {
            Option::Some(s) => match s.decls.get(&cx, name) {
                Option::Some(d) => return Result::Ok.(Target::Decl.(d)),
                Option::None => (),
            },
            Option::None => (),
        };
        if caller.package == home.package {
            let unit = match self.children.get(&cx, home) {
                Option::Some(c) => match c.get(&cx, name) {
                    Option::Some(m) => return Result::Ok.(Target::Module.(m)),
                    Option::None => (),
                },
                Option::None => (),
            };
            let unit = match scope {
                Option::Some(s) => {
                    if s.imports.has(&cx, name) {
                        return self.solve(&cx, lookup_key(&cx, "import", home, Seq::one(&cx, name)));
                    }
                    let unit = match self.glob(&cx, home, name) {
                        Result::Ok(found) => match found {
                            Option::Some(t) => return Result::Ok.(t),
                            Option::None => (),
                        },
                        Result::Err(e) => return Result::Err.(e),
                    };
                },
                Option::None => (),
            };
        } else {
            let unit = match scope {
                Option::Some(s) => {
                    if s.exports.has(&cx, name) {
                        return self.solve(&cx, lookup_key(&cx, "export", home, Seq::one(&cx, name)));
                    }
                },
                Option::None => (),
            };
        }
        let owner = if home.path.is_empty(&cx) { self.packages.get(&cx, home.package).name.get(&cx) } else { joined(&cx, home.path) };
        problem(Out::new(&cx).put(&cx, "unknown or private member ").add(&cx, name).put(&cx, " of ").add(&cx, owner).done(&cx))
    }

    // `Owner::name`: an enum variant, or a method or const attached to `Owner`.
    fn associated(self, &cx: Cx!['k], owner: Decl['k], name: Text['k]) -> Result[Target['k], Problem['k]] {
        let unit = match owner.node {
            Named::Enum(e) => {
                var i = 0usize;
                while i < e.variants.len(&cx) {
                    if e.variants.get(&cx, i).name.eq(&cx, name) {
                        return Result::Ok.(Target::Variant.(owner, name));
                    }
                    i = i + 1usize;
                }
            },
            Named::Trait(t) => {
                var i = 0usize;
                while i < t.methods.len(&cx) {
                    if t.methods.get(&cx, i).name.eq(&cx, name) {
                        return Result::Ok.(Target::TraitMethod.(owner, name));
                    }
                    i = i + 1usize;
                }
            },
            _ => (),
        };
        let found = self.attached.get_or(&cx, (Owner::Decl.(owner), name), Seq::new(&cx));
        var own: Seq[Decl['k], 'k] = Seq::new(&cx);
        var i = 0usize;
        while i < found.len(&cx) {
            if key_same(&cx, found.get(&cx, i).home, owner.home) {
                own.push(&cx, found.get(&cx, i));
            }
            i = i + 1usize;
        }
        if own.is_empty(&cx) {
            own = found;
        }
        if own.len(&cx) != 1usize {
            return problem(Out::new(&cx).put(&cx, if own.is_empty(&cx) { "unknown" } else { "ambiguous" }).put(&cx, " associated name ").add(&cx, owner.name).put(&cx, "::").add(&cx, name).done(&cx));
        }
        Result::Ok.(Target::Decl.(own.get(&cx, 0usize)))
    }

    // A library item the compiler itself refers to (Slice for string literals, Buffer and Format
    // for f-strings, Ordering for atomics): through a direct dependency on its home library, else
    // through std, else in the module's own package.
    fn library(self, &cx: Cx!['k], home: ModuleId['k], library_name: Text['k], path: Seq[Text['k], 'k], std_path: Seq[Text['k], 'k]) -> Target['k] {
        let deps = self.packages.get(&cx, home.package).deps;
        let root = if deps.has(&cx, library_name) { library_name } else if deps.has(&cx, text(&cx, "std")) { text(&cx, "std") } else { text(&cx, "package") };
        let full: Seq[Text['k], 'k] = Seq::one(&cx, root);
        full.append(&cx, if root.is(&cx, "std") { std_path } else { path });
        self.need(&cx, home, full, no_pos())
    }
}

// ---------------------------------------------------------- references --

// `names` with `more` added, as a new sequence: the sets of names in scope.
forall 'k.
fn with(&cx: Cx!['k], names: Seq[Text['k], 'k], more: Seq[Text['k], 'k]) -> Seq[Text['k], 'k] {
    let out = names.copy(&cx);
    out.append(&cx, more);
    out
}

forall 'k.
fn with_one(&cx: Cx!['k], names: Seq[Text['k], 'k], name: Text['k]) -> Seq[Text['k], 'k] {
    let out = names.copy(&cx);
    out.push(&cx, name);
    out
}

forall 'k.
fn quantifier_of(item: S::Item['k]) -> Option[S::Forall['k]] {
    match item {
        S::Item::Use(x) => x.quantifier,
        S::Item::Module(x) => Option::None,
        S::Item::Struct(x) => x.quantifier,
        S::Item::Tuple(x) => x.quantifier,
        S::Item::Enum(x) => x.quantifier,
        S::Item::Fn(x) => x.quantifier,
        S::Item::Extern(x) => x.quantifier,
        S::Item::Const(x) => x.quantifier,
        S::Item::Impl(x) => x.quantifier,
        S::Item::Trait(x) => x.quantifier,
        S::Item::Instance(x) => x.quantifier,
    }
}

// The type parameters a quantifier binds, without its brands.
forall 'k.
fn forall_params(&cx: Cx!['k], quantifier: Option[S::Forall['k]]) -> Seq[Text['k], 'k] {
    let out: Seq[Text['k], 'k] = Seq::new(&cx);
    let unit = match quantifier {
        Option::Some(f) => {
            let all = with(&cx, f.params, f.determined);
            var i = 0usize;
            while i < all.len(&cx) {
                if !all.get(&cx, i).starts_with(&cx, text(&cx, "'")) {
                    out.push(&cx, all.get(&cx, i));
                }
                i = i + 1usize;
            }
        },
        Option::None => (),
    };
    out
}

// Resolve every path in every item of every module.
forall 'k.
exposed struct Names {
    r: Resolver['k],
    home: Cell[ModuleId['k], 'k],
}

forall 'k.
impl Names['k] {
    fn new(&cx: Cx!['k], r: Resolver['k]) -> Names['k] {
        Names.{ r, home: Cell::new(&cx, ModuleId::root(&cx, 0usize)) }
    }

    fn run(self, &cx: Cx!['k]) -> Resolver['k] {
        let modules = self.r.scopes.keys(&cx);
        var m = 0usize;
        while m < modules.len(&cx) {
            let home = modules.get(&cx, m);
            self.home.set(&cx, home);
            let items = self.r.scopes.at(&cx, home).items;
            var i = 0usize;
            while i < items.len(&cx) {
                let item = items.get(&cx, i);
                self.r.locate(&cx, home, item_pos(item));
                self.item(&cx, item, Seq::new(&cx));
                self.r.unlocate(&cx);
                i = i + 1usize;
            }
            m = m + 1usize;
        }
        self.r
    }

    fn set(self, &cx: Cx!['k], id: u32, r: NameRef['k]) {
        self.r.refs.set(&cx, id, r);
    }

    fn premises(self, &cx: Cx!['k], quantifier: Option[S::Forall['k]], types: Seq[Text['k], 'k]) {
        let unit = match quantifier {
            Option::Some(f) => {
                var i = 0usize;
                while i < f.premises.len(&cx) {
                    let premise = f.premises.get(&cx, i);
                    let trait_path = premise.trait_path;
                    let trait_ref = if trait_path.len(&cx) == 1usize && is_builtin_trait(&cx, trait_path.get(&cx, 0usize)) {
                        NameRef::Builtin.(trait_path.get(&cx, 0usize))
                    } else {
                        NameRef::Decl.(self.decl(&cx, trait_path, "trait", no_pos()))
                    };
                    var k = 0usize;
                    while k < premise.args.args.len(&cx) {
                        self.type(&cx, premise.args.args.get(&cx, k), types, false);
                        k = k + 1usize;
                    }
                    self.set(&cx, premise.args.id, trait_ref);
                    i = i + 1usize;
                }
            },
            Option::None => (),
        };
    }

    fn item(self, &cx: Cx!['k], item: S::Item['k], types: Seq[Text['k], 'k]) {
        let unit = match item {
            S::Item::Use(x) => return,
            S::Item::Module(x) => return,
            _ => (),
        };
        let quantifier = quantifier_of(item);
        let types = with(&cx, types, forall_params(&cx, quantifier));
        self.premises(&cx, quantifier, types);
        match item {
            S::Item::Struct(s) => {
                var i = 0usize;
                while i < s.fields.len(&cx) {
                    self.type(&cx, s.fields.get(&cx, i).type, types, false);
                    i = i + 1usize;
                }
            },
            S::Item::Tuple(t) => self.types(&cx, t.elems, types),
            S::Item::Enum(e) => {
                var i = 0usize;
                while i < e.variants.len(&cx) {
                    self.types(&cx, e.variants.get(&cx, i).payload, types);
                    i = i + 1usize;
                }
            },
            S::Item::Fn(f) => self.function(&cx, f, types),
            S::Item::Extern(x) => {
                var i = 0usize;
                while i < x.params.len(&cx) {
                    let unit = match x.params.get(&cx, i).type {
                        Option::Some(t) => self.type(&cx, t, types, false),
                        Option::None => (),
                    };
                    i = i + 1usize;
                }
                let unit = match x.ret {
                    Option::Some(t) => self.type(&cx, t, types, false),
                    Option::None => (),
                };
            },
            S::Item::Const(c) => {
                self.type(&cx, c.type, types, false);
                self.expr(&cx, c.value, types, Seq::new(&cx));
            },
            S::Item::Impl(m) => {
                self.type(&cx, m.type, types, false);
                var i = 0usize;
                while i < m.items.len(&cx) {
                    let unit = match m.items.get(&cx, i) {
                        S::Member::Fn(f) => self.item(&cx, S::Item::Fn.(f), types),
                        S::Member::Const(c) => self.item(&cx, S::Item::Const.(c), types),
                    };
                    i = i + 1usize;
                }
            },
            S::Item::Trait(t) => {
                let trait_types = if t.quantifier.is_none() { with_one(&cx, types, text(&cx, "Self")) } else { types };
                var i = 0usize;
                while i < t.methods.len(&cx) {
                    self.function(&cx, t.methods.get(&cx, i), trait_types);
                    i = i + 1usize;
                }
            },
            S::Item::Instance(n) => {
                self.type(&cx, n.type, types, true);
                var i = 0usize;
                while i < n.methods.len(&cx) {
                    self.item(&cx, S::Item::Fn.(n.methods.get(&cx, i)), types);
                    i = i + 1usize;
                }
            },
            _ => (),
        }
    }

    fn function(self, &cx: Cx!['k], f: S::Fn['k], types: Seq[Text['k], 'k]) {
        let types = with(&cx, types, forall_params(&cx, f.quantifier));
        self.premises(&cx, f.quantifier, types);
        let names: Seq[Text['k], 'k] = Seq::new(&cx);
        var i = 0usize;
        while i < f.params.len(&cx) {
            let p = f.params.get(&cx, i);
            let unit = match p.type {
                Option::Some(t) => self.type(&cx, t, types, false),
                Option::None => (),
            };
            names.push(&cx, p.name);
            i = i + 1usize;
        }
        let unit = match f.ret {
            Option::Some(t) => self.type(&cx, t, types, false),
            Option::None => (),
        };
        let unit = match f.body {
            Option::Some(b) => self.block(&cx, b, types, names),
            Option::None => (),
        };
    }

    // The declaration `path` names, of `kind` unless it is empty.
    fn decl(self, &cx: Cx!['k], path: Seq[Text['k], 'k], kind: Slice[u8, 'static], pos: Pos) -> Decl['k] {
        let target = self.r.need(&cx, self.home.get(&cx), path, pos);
        let k = text(&cx, kind);
        match target {
            Target::Decl(d) => if k.is_empty() || d.kind.eq(&cx, k) {
                d
            } else {
                self.not_a(&cx, path, k, pos)
            },
            _ => self.not_a(&cx, path, k, pos),
        }
    }

    fn not_a(self, &cx: Cx!['k], path: Seq[Text['k], 'k], kind: Text['k], pos: Pos) -> ! {
        let what = if kind.is_empty() { text(&cx, "declaration") } else { kind };
        self.r.fail(&cx, Out::new(&cx).add(&cx, joined(&cx, path)).put(&cx, " is not a ").add(&cx, what).done(&cx), pos)
    }

    // ---- types
    fn types(self, &cx: Cx!['k], ts: Seq[Type['k], 'k], types: Seq[Text['k], 'k]) {
        var i = 0usize;
        while i < ts.len(&cx) {
            self.type(&cx, ts.get(&cx, i), types, false);
            i = i + 1usize;
        }
    }

    fn type(self, &cx: Cx!['k], t: Type['k], types: Seq[Text['k], 'k], is_trait: bool) {
        match t {
            Type::Name(n) => {
                let path = n.path;
                let single = path.len(&cx) == 1usize;
                let name = path.get(&cx, 0usize);
                if single && types.has(&cx, name) {
                    self.set(&cx, n.id, NameRef::Param.(name));
                } else if single && is_prim(&cx, name) {
                    self.set(&cx, n.id, NameRef::Prim.(name));
                } else if single && is_builtin_type(&cx, name) && !self.declared(&cx, name) {
                    self.set(&cx, n.id, NameRef::Builtin.(name));
                } else if name.is(&cx, "builtin") {
                    if path.len(&cx) != 2usize {
                        self.r.fail(&cx, text(&cx, "a builtin type path has exactly two components"), no_pos());
                    }
                    self.set(&cx, n.id, NameRef::Builtin.(path.get(&cx, 1usize)));
                } else {
                    let d = self.decl(&cx, path, if is_trait { "trait" } else { "" }, no_pos());
                    self.set(&cx, n.id, NameRef::Decl.(d));
                    if !is_trait && !d.kind.is(&cx, "struct") && !d.kind.is(&cx, "enum") && !d.kind.is(&cx, "tuple") {
                        self.r.fail(&cx, Out::new(&cx).add(&cx, joined(&cx, path)).put(&cx, " is not a type").done(&cx), no_pos());
                    }
                }
                self.types(&cx, n.args, types);
            },
            Type::Ptr(inner) => self.type(&cx, inner.get(&cx), types, false),
            Type::Tuple(elems) => self.types(&cx, elems, types),
            Type::Array(elem, length) => {
                self.type(&cx, elem.get(&cx), types, false);
                self.expr(&cx, length.get(&cx), types, Seq::new(&cx));
            },
            Type::Fn(f) => {
                self.slots(&cx, f.params, types);
                self.type(&cx, f.ret.get(&cx), types, false);
            },
            Type::Closure(c) => {
                self.slots(&cx, c.params, types);
                self.type(&cx, c.ret.get(&cx), types, false);
                let unit = match c.env {
                    Option::Some(env) => self.type(&cx, env.get(&cx), types, false),
                    Option::None => (),
                };
            },
            Type::Exists(brands, body) => self.type(&cx, body.get(&cx), types, false),
            Type::Foreach(f) => {
                self.type(&cx, f.source.get(&cx), types, false);
                self.type(&cx, f.body.get(&cx), with_one(&cx, types, f.binder), false);
            },
            Type::Forall(params, body) => {
                let bound: Seq[Text['k], 'k] = Seq::new(&cx);
                var i = 0usize;
                while i < params.len(&cx) {
                    if !params.get(&cx, i).starts_with(&cx, text(&cx, "'")) {
                        bound.push(&cx, params.get(&cx, i));
                    }
                    i = i + 1usize;
                }
                self.type(&cx, body.get(&cx), with(&cx, types, bound), false);
            },
            _ => (),
        }
    }

    fn slots(self, &cx: Cx!['k], slots: Seq[S::Slot['k], 'k], types: Seq[Text['k], 'k]) {
        var i = 0usize;
        while i < slots.len(&cx) {
            self.type(&cx, slots.get(&cx, i).type, types, false);
            i = i + 1usize;
        }
    }

    fn visible(self, &cx: Cx!['k], name: Text['k]) -> bool {
        self.r.lookup(&cx, self.home.get(&cx), Seq::one(&cx, name), no_pos()).is_ok()
    }

    fn declared(self, &cx: Cx!['k], name: Text['k]) -> bool {
        let scope = self.r.scopes.at(&cx, self.home.get(&cx));
        scope.decls.has(&cx, name) || scope.imports.has(&cx, name)
    }

    // ---- expressions
    // Resolve `e`; `values` are the locals in scope.
    fn expr(self, &cx: Cx!['k], e: Expr['k], types: Seq[Text['k], 'k], values: Seq[Text['k], 'k]) {
        match e {
            Expr::Path(p) => self.path(&cx, p, types, values),
            Expr::Block(b) => self.block(&cx, b, types, values),
            Expr::StructLit(s) => {
                let names = s.path.names(&cx);
                if !names.get(&cx, 0usize).is(&cx, "builtin") {
                    self.set(&cx, s.path.id, NameRef::Decl.(self.decl(&cx, names, "struct", s.pos)));
                }
                self.segment_args(&cx, s.path, types);
                var i = 0usize;
                while i < s.fields.len(&cx) {
                    let unit = match s.fields.get(&cx, i).value {
                        Option::Some(v) => self.expr(&cx, v, types, values),
                        Option::None => (),
                    };
                    i = i + 1usize;
                }
                i = 0usize;
                while i < s.fields.len(&cx) {
                    let f = s.fields.get(&cx, i);
                    if f.value.is_none() && !values.has(&cx, f.name) {
                        self.r.fail(&cx, Out::new(&cx).put(&cx, "unknown local ").add(&cx, f.name).done(&cx), s.pos);
                    }
                    i = i + 1usize;
                }
            },
            Expr::Match(m) => {
                self.expr(&cx, m.scrutinee.get(&cx), types, values);
                var i = 0usize;
                while i < m.arms.len(&cx) {
                    let arm = m.arms.get(&cx, i);
                    let bound: Seq[Text['k], 'k] = Seq::new(&cx);
                    var k = 0usize;
                    while k < arm.cases.len(&cx) {
                        let case = arm.cases.get(&cx, k);
                        let unit = match case.kind {
                            S::CaseKind::Variant => {
                                let path = match case.path {
                                    Option::Some(p) => p,
                                    Option::None => self.r.fail(&cx, text(&cx, "internal error: a variant case without a path"), no_pos()),
                                };
                                self.variant(&cx, path);
                                self.segment_args(&cx, path, types);
                                let unit = match case.binders {
                                    Option::Some(bs) => {
                                        var b = 0usize;
                                        while b < bs.len(&cx) {
                                            if !bs.get(&cx, b).is(&cx, "_") && !bs.get(&cx, b).is_empty() {
                                                bound.push(&cx, bs.get(&cx, b));
                                            }
                                            b = b + 1usize;
                                        }
                                    },
                                    Option::None => (),
                                };
                            },
                            _ => (),
                        };
                        k = k + 1usize;
                    }
                    self.expr(&cx, arm.body, types, with(&cx, values, bound));
                    i = i + 1usize;
                }
            },
            Expr::Closure(c) => {
                let names: Seq[Text['k], 'k] = Seq::new(&cx);
                var i = 0usize;
                while i < c.params.len(&cx) {
                    let p = c.params.get(&cx, i);
                    let unit = match p.type {
                        Option::Some(t) => self.type(&cx, t, types, false),
                        Option::None => (),
                    };
                    names.push(&cx, p.name);
                    i = i + 1usize;
                }
                let unit = match c.ret {
                    Option::Some(t) => self.type(&cx, t, types, false),
                    Option::None => (),
                };
                self.expr(&cx, c.body.get(&cx), types, with(&cx, values, names));
            },
            Expr::Foreach(f) => {
                self.expr(&cx, f.source.get(&cx), types, values);
                let inner = match f.binder {
                    Option::Some(b) => with_one(&cx, types, b),
                    Option::None => types,
                };
                self.block(&cx, f.body, inner, with_one(&cx, values, f.name));
            },
            Expr::Cast(c) => {
                self.expr(&cx, c.value.get(&cx), types, values);
                self.type(&cx, c.type, types, false);
            },
            Expr::Sizeof(n) => self.type(&cx, n.value, types, false),
            Expr::While(w) => {
                self.expr(&cx, w.cond.get(&cx), types, values);
                self.block(&cx, w.body, types, values);
            },
            Expr::For(f) => {
                self.expr(&cx, f.iterator.get(&cx), types, values);
                self.block(&cx, f.body, types, with_one(&cx, values, f.name));
            },
            Expr::Lit(l) => (),
            _ => {
                let parts = children(&cx, e);
                var i = 0usize;
                while i < parts.len(&cx) {
                    self.expr(&cx, parts.get(&cx, i), types, values);
                    i = i + 1usize;
                }
            },
        }
    }

    fn block(self, &cx: Cx!['k], b: S::Block['k], types: Seq[Text['k], 'k], values: Seq[Text['k], 'k]) {
        var values = values;
        var i = 0usize;
        while i < b.stmts.len(&cx) {
            values = self.stmt(&cx, b.stmts.get(&cx, i), types, values);
            i = i + 1usize;
        }
        let unit = match b.tail {
            Option::Some(t) => self.expr(&cx, t.get(&cx), types, values),
            Option::None => (),
        };
    }

    fn stmt(self, &cx: Cx!['k], s: Statement['k], types: Seq[Text['k], 'k], values: Seq[Text['k], 'k]) -> Seq[Text['k], 'k] {
        match s {
            Statement::Let(l) => {
                self.expr(&cx, l.value, types, values);
                let unit = match l.type {
                    Option::Some(t) => self.type(&cx, t, types, false),
                    Option::None => (),
                };
                with(&cx, values, bound(&cx, l.pattern))
            },
            Statement::Var(v) => {
                self.expr(&cx, v.value, types, values);
                let unit = match v.type {
                    Option::Some(t) => self.type(&cx, t, types, false),
                    Option::None => (),
                };
                with_one(&cx, values, v.name)
            },
            Statement::Const(c) => {
                self.type(&cx, c.type, types, false);
                self.expr(&cx, c.value, types, values);
                with_one(&cx, values, c.name)
            },
            Statement::Assign(a) => {
                self.expr(&cx, a.target, types, values);
                self.expr(&cx, a.value, types, values);
                values
            },
            Statement::Expr(n) => {
                self.expr(&cx, n.value, types, values);
                values
            },
        }
    }

    fn segment_args(self, &cx: Cx!['k], p: S::Path['k], types: Seq[Text['k], 'k]) {
        var i = 0usize;
        while i < p.segments.len(&cx) {
            self.types(&cx, p.segments.get(&cx, i).args, types);
            i = i + 1usize;
        }
    }

    fn path(self, &cx: Cx!['k], p: S::Path['k], types: Seq[Text['k], 'k], values: Seq[Text['k], 'k]) {
        let names = p.names(&cx);
        self.segment_args(&cx, p, types);
        let first = names.get(&cx, 0usize);
        if names.len(&cx) == 1usize && values.has(&cx, first) {
            self.set(&cx, p.id, NameRef::Local.(first));
        } else if first.is(&cx, "builtin") {
            self.set(&cx, p.id, NameRef::Builtin.(joined(&cx, names.from(&cx, 1usize))));
        } else if names.len(&cx) == 1usize && is_builtin_value(&cx, first) && !self.visible(&cx, first) {
            self.set(&cx, p.id, NameRef::Builtin.(first));
        } else if names.len(&cx) == 2usize && is_prim(&cx, first) {
            let found = self.r.attached.get_or(&cx, (Owner::Prim.(first), names.get(&cx, 1usize)), Seq::new(&cx));
            if found.is_empty(&cx) {
                self.r.fail(&cx, Out::new(&cx).put(&cx, "unknown ").add(&cx, first).put(&cx, "::").add(&cx, names.get(&cx, 1usize)).done(&cx), p.pos);
            }
            self.set(&cx, p.id, NameRef::Decl.(found.get(&cx, 0usize)));
        } else if names.len(&cx) == 2usize && types.has(&cx, first) {
            // a member of a type parameter, found by inference
            self.set(&cx, p.id, NameRef::Assoc.(first, names.get(&cx, 1usize)));
        } else {
            let r = match self.r.need(&cx, self.home.get(&cx), names, p.pos) {
                Target::Module(m) => self.r.fail(&cx, Out::new(&cx).add(&cx, joined(&cx, names)).put(&cx, " is a module, not a value").done(&cx), p.pos),
                Target::Decl(d) => NameRef::Decl.(d),
                Target::Variant(d, v) => NameRef::Variant.(d, v),
                Target::TraitMethod(d, m) => NameRef::TraitMethod.(d, m),
            };
            self.set(&cx, p.id, r);
        }
    }

    fn variant(self, &cx: Cx!['k], path: S::Path['k]) {
        match self.r.need(&cx, self.home.get(&cx), path.names(&cx), path.pos) {
            Target::Variant(d, v) => self.set(&cx, path.id, NameRef::Variant.(d, v)),
            _ => self.r.fail(&cx, Out::new(&cx).add(&cx, joined(&cx, path.names(&cx))).put(&cx, " is not an enum variant").done(&cx), path.pos),
        }
    }
}

forall 'k.
fn bound(&cx: Cx!['k], pattern: Pattern['k]) -> Seq[Text['k], 'k] {
    let out: Seq[Text['k], 'k] = Seq::new(&cx);
    let unit = match pattern {
        Pattern::Bind(n) => out.push(&cx, n.value),
        Pattern::Tuple(n) => bound_all(&cx, out, n.value),
        Pattern::Array(n) => bound_all(&cx, out, n.value),
        Pattern::Struct(s) => {
            var i = 0usize;
            while i < s.fields.len(&cx) {
                out.append(&cx, bound(&cx, s.fields.get(&cx, i).pattern));
                i = i + 1usize;
            }
            let unit = match s.rest {
                Option::Some(r) => out.push(&cx, r),
                Option::None => (),
            };
        },
        Pattern::Wild(id) => (),
    };
    out
}

forall 'k.
fn bound_all(&cx: Cx!['k], out: Seq[Text['k], 'k], patterns: Seq[Pattern['k], 'k]) {
    var i = 0usize;
    while i < patterns.len(&cx) {
        out.append(&cx, bound(&cx, patterns.get(&cx, i)));
        i = i + 1usize;
    }
}

// The subexpressions of the expression forms with no binding structure.
forall 'k.
fn children(&cx: Cx!['k], e: Expr['k]) -> Seq[Expr['k], 'k] {
    let out: Seq[Expr['k], 'k] = Seq::new(&cx);
    let unit = match e {
        Expr::Tuple(n) => out.append(&cx, n.value),
        Expr::Array(a) => out.append(&cx, a.elems),
        Expr::FStr(f) => {
            var i = 0usize;
            while i < f.parts.len(&cx) {
                let unit = match f.parts.get(&cx, i) {
                    S::Piece::Expr(x) => out.push(&cx, x),
                    S::Piece::Text(t) => (),
                };
                i = i + 1usize;
            }
        },
        Expr::If(n) => {
            out.push(&cx, n.cond.get(&cx));
            out.push(&cx, Expr::Block.(n.then));
            let unit = match n.other {
                Option::Some(o) => out.push(&cx, o.get(&cx)),
                Option::None => (),
            };
        },
        Expr::Return(n) => {
            let unit = match n.value {
                Option::Some(v) => out.push(&cx, v.get(&cx)),
                Option::None => (),
            };
        },
        Expr::Pack(p) => out.push(&cx, p.value.get(&cx)),
        Expr::Binop(b) => {
            out.push(&cx, b.left.get(&cx));
            out.push(&cx, b.right.get(&cx));
        },
        Expr::Unary(u) => out.push(&cx, u.operand.get(&cx)),
        Expr::UnsafeStore(s) => {
            out.push(&cx, s.pointer.get(&cx));
            out.push(&cx, s.value.get(&cx));
        },
        Expr::Field(f) => out.push(&cx, f.value.get(&cx)),
        Expr::Index(x) => out.push(&cx, x.value.get(&cx)),
        Expr::Try(n) => out.push(&cx, n.value.get(&cx)),
        Expr::Call(c) => {
            out.push(&cx, c.callee.get(&cx));
            out.append(&cx, c.args);
        },
        _ => fail(&cx, text(&cx, "no resolution rule for this expression")),
    };
    out
}

// The resolved package graph rooted at `path`.
forall 'k.
fn resolve(&cx: Cx!['k], path: Text['k]) -> Resolver['k] {
    let ids = Cell::new(&cx, 0u32);
    let resolver = Resolver::new(&cx, load(&cx, path, ids), ids);
    if !resolver.packages.is_empty(&cx) {
        let package = resolver.packages.get(&cx, 0usize);
        let unit = match package.entry.get(&cx) {
            Option::Some(entry) => {
                if !entry.is_empty(&cx) {
                    let target = resolver.need(&cx, ModuleId::root(&cx, package.id), entry, no_pos());
                    let unit = match target {
                        Target::Decl(d) => {
                            if !d.kind.is(&cx, "fn") || d.home.package != package.id {
                                fail(&cx, text(&cx, "an executable's entry must be a function of its own package"));
                            }
                            package.entry_decl.set(&cx, Option::Some.(d));
                        },
                        _ => fail(&cx, text(&cx, "an executable's entry must be a function of its own package")),
                    };
                }
            },
            Option::None => (),
        };
    }
    Names::new(&cx, resolver).run(&cx)
}
