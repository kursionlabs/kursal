// Packages and names: load the package graph, assign each source file its module, and resolve
// every type and value path to what it names.
//
// What a path names is kept in `Resolver.refs`, keyed by the id of the node that spells it: a
// type name (`TName`), an expression or case path (`Path`), or a premise's type arguments
// (`TypeArgs`, naming the premise's trait).
//   NameRef::Decl(d)               a declaration (struct, enum, tuple, fn, extern, trait, const, method)
//   NameRef::Variant(d, name)      an enum variant
//   NameRef::TraitMethod(d, name)  a trait's method, `Trait::method`
//   NameRef::Assoc(param, name)    a member of a type parameter, found by inference
//   NameRef::Param(name)           a type parameter in scope
//   NameRef::Local(name)           a local value
//   NameRef::Prim(name)            a primitive type
//   NameRef::Builtin(name)         a compiler-sealed name: Brand, Copy, builtin::fresh, ...

use package::support::base::{Cell, Key, Map, Out, Seq, Set, Text, combine, fail, text};
use package::kurs::core::ModuleId;
use package::syntax::parser::parse;
use package::syntax::ast as S;
use package::syntax::ast::{Expr, Pattern, Pos, Statement, Type, no_pos};
use package::support::system::{environment, path_exists, list_directory, read, real_path};
use std::option::{Option, Result};
use std::slice::Slice;

// Whether `name` is one of the space-separated `names`.
fn among(name: Text, names: Slice[u8, 'static]) -> bool {
    text(names).split(text(" ")).has(name)
}

fn is_prim(name: Text) -> bool {
    among(name, "i8 i16 i32 i64 isize u8 u16 u32 u64 usize f32 f64 bool")
}

fn is_builtin_type(name: Text) -> bool {
    among(name, "Brand Phantom Never")
}

fn is_builtin_trait(name: Text) -> bool {
    among(name, "Copy Exposed")
}

// Builtin values, unless a declaration of the name is in scope.
fn is_builtin_value(name: Text) -> bool {
    among(name, "alloca fence load_volatile store_volatile")
}

// The standard library's directory: `$KURSAL_LIB`, else `lib` beside the directory that holds the
// compiler's binary (an installation's `bin/kursal` and `lib/`).
fn lib_dir() -> Text {
    let configured = match environment(text("KURSAL_LIB")) {
        Option::Some(v) => v,
        Option::None => text(""),
    };
    if !configured.is_empty() {
        clean(configured)
    } else {
        match real_path(text("/proc/self/exe")) {
            Option::Some(exe) => join(parent(parent(exe)), text("lib")),
            Option::None => fail(text("set KURSAL_LIB to the standard library's directory")),
        }
    }
}

// ------------------------------------------------------------------ paths --

// `path` as Python's `Path` spells it: no repeated, trailing or `.` separators.
fn clean(path: Text) -> Text {
    let parts = path.split(text("/"));
    let out = Out::new();
    if path.starts_with(text("/")) {
        let unit = out.put("/");
    }
    var first = true;
    var i = 0usize;
    while i < parts.len() {
        let part = parts.get(i);
        if !part.is_empty() && !part.is(".") {
            if !first {
                let unit = out.put("/");
            }
            let unit = out.add(part);
            first = false;
        }
        i = i + 1usize;
    }
    if out.len() == 0usize { text(".") } else { out.done() }
}

// `a / b`: `b` when it is absolute.
fn join(a: Text, b: Text) -> Text {
    if b.starts_with(text("/")) || a.is_empty() || a.is(".") {
        b
    } else if a.ends_with(text("/")) {
        a.concat(b)
    } else {
        Out::new().add(a).put("/").add(b).done()
    }
}

fn parent(path: Text) -> Text {
    match path.rfind_byte(b'/') {
        Option::Some(at) => if at == 0usize { text("/") } else { path.slice(0usize, at) },
        Option::None => text("."),
    }
}

// The last component.
fn base_name(path: Text) -> Text {
    match path.rfind_byte(b'/') {
        Option::Some(at) => path.from(at + 1usize),
        Option::None => path,
    }
}

// The last component's extension, with its dot: `Path.suffix`.
fn suffix(path: Text) -> Text {
    let name = base_name(path);
    match name.rfind_byte(b'.') {
        Option::Some(at) => if at > 0usize && at + 1usize < name.len { name.from(at) } else { text("") },
        Option::None => text(""),
    }
}

// The last component without its extension: `Path.stem`.
fn stem(path: Text) -> Text {
    let name = base_name(path);
    name.slice(0usize, name.len - suffix(name).len)
}

// The absolute path with no symbolic links that `path` names, existing or not: `Path.resolve()`.
// The longest existing prefix has its links resolved; the rest is appended, with `..` removing the
// component before it.
fn resolved(path: Text) -> Text {
    if path.starts_with(text("/")) {
        resolve_absolute(path)
    } else {
        let cwd = match real_path(text(".")) {
            Option::Some(c) => c,
            Option::None => fail(text("cannot find the current directory")),
        };
        resolve_absolute(join(cwd, path))
    }
}

fn resolve_absolute(path: Text) -> Text {
    match real_path(path) {
        Option::Some(r) => r,
        Option::None => {
            if path.is("/") {
                path
            } else {
                let base = resolve_absolute(parent(path));
                let name = base_name(path);
                if name.is_empty() || name.is(".") {
                    base
                } else if name.is("..") {
                    parent(base)
                } else {
                    let joined = join(base, name);
                    match real_path(joined) {
                        Option::Some(r) => r,
                        Option::None => joined,
                    }
                }
            }
        },
    }
}

// --------------------------------------------------------- Python's repr --

// A string as Python's `repr` writes it.
fn repr(t: Text) -> Text {
    let quote = if t.contains(text("'")) && !t.contains(text("\"")) { b'"' } else { b'\'' };
    let out = Out::new().byte(quote);
    var i = 0usize;
    while i < t.len {
        let b = t.byte(i);
        if b == b'\\' || b == quote {
            let unit = out.byte(b'\\').byte(b);
        } else if b == b'\n' {
            let unit = out.put("\\n");
        } else if b == b'\t' {
            let unit = out.put("\\t");
        } else if b == b'\r' {
            let unit = out.put("\\r");
        } else if b < 32u8 || b == 127u8 {
            let digits = text("0123456789abcdef");
            let unit = out.put("\\x").byte(digits.byte((b / 16u8) as usize)).byte(digits.byte((b % 16u8) as usize));
        } else {
            let unit = out.byte(b);
        }
        i = i + 1usize;
    }
    out.byte(quote).done()
}

// A tuple of strings as Python's `repr` writes it: `()`, `('a',)`, `('a', 'b')`.
fn repr_tuple(names: Seq[Text]) -> Text {
    let out = Out::new().put("(");
    var i = 0usize;
    while i < names.len() {
        if i > 0usize {
            let unit = out.put(", ");
        }
        let unit = out.add(repr(names.get(i)));
        i = i + 1usize;
    }
    if names.len() == 1usize {
        let unit = out.put(",");
    }
    out.put(")").done()
}

fn repr_module(m: ModuleId) -> Text {
    Out::new().put("ModuleId(package=").usize(m.package).put(", path=").add(repr_tuple(m.path)).put(")").done()
}

// `'::'.join(names)`.
fn joined(names: Seq[Text]) -> Text {
    let out = Out::new();
    var i = 0usize;
    while i < names.len() {
        if i > 0usize {
            let unit = out.put("::");
        }
        let unit = out.add(names.get(i));
        i = i + 1usize;
    }
    out.done()
}

fn text_before(a: Text, b: Text) -> bool {
    a.compare(b) < 0
}

// ---------------------------------------------------------- the manifest --

// A manifest value: a string, a table in key order, or any other TOML value.
exposed enum Toml {
    Str(Text),
    Table(Map[Text, Toml]),
    Other,
}

// A reader for the TOML that manifests use: tables, dotted keys and headers, strings, inline
// tables, and other values (numbers, booleans, arrays, dates) read only as far as their extent.
exposed struct TomlReader {
    src: Text,
    i: Cell[usize],
    file: Text,
}

fn read_toml(source: Text, file: Text) -> Map[Text, Toml] {
    let r = TomlReader.{ src: source, i: Cell::new(0usize), file };
    r.document()
}

impl TomlReader {
    fn at(self) -> u8 {
        self.src.byte(self.i.get())
    }

    fn done(self) -> bool {
        self.i.get() >= self.src.len
    }

    fn advance(self) {
        self.i.set(self.i.get() + 1usize);
    }

    fn fail(self) -> ! {
        var line = 1usize;
        var k = 0usize;
        while k < self.i.get() && k < self.src.len {
            if self.src.byte(k) == b'\n' {
                line = line + 1usize;
            }
            k = k + 1usize;
        }
        fail(Out::new().add(self.file).put(":").usize(line).put(": invalid manifest").done())
    }

    fn expect(self, b: u8) {
        if self.done() || self.at() != b {
            self.fail();
        }
        self.advance();
    }

    // Spaces and tabs.
    fn blank(self) {
        while !self.done() && (self.at() == b' ' || self.at() == b'\t') {
            self.advance();
        }
    }

    // Spaces, newlines and comments.
    fn space(self) {
        var going = true;
        while going && !self.done() {
            let b = self.at();
            if b == b' ' || b == b'\t' || b == b'\n' || b == b'\r' {
                self.advance();
            } else if b == b'#' {
                self.comment();
            } else {
                going = false;
            }
        }
    }

    fn comment(self) {
        while !self.done() && self.at() != b'\n' {
            self.advance();
        }
    }

    // The rest of a line after a key-value pair or a header: blanks and a comment.
    fn line_end(self) {
        self.blank();
        if !self.done() && self.at() == b'#' {
            self.comment();
        }
        if !self.done() {
            if self.at() == b'\r' {
                self.advance();
            }
            self.expect(b'\n');
        }
    }

    fn document(self) -> Map[Text, Toml] {
        let root: Map[Text, Toml] = Map::new();
        var current = root;
        self.space();
        while !self.done() {
            if self.at() == b'[' {
                self.advance();
                if !self.done() && self.at() == b'[' {
                    self.fail();
                }
                self.blank();
                let keys = self.key();
                self.blank();
                self.expect(b']');
                self.line_end();
                current = self.descend(root, keys, keys.len());
            } else {
                let keys = self.key();
                self.blank();
                self.expect(b'=');
                self.blank();
                let value = self.value();
                self.line_end();
                self.define(current, keys, value);
            }
            self.space();
        }
        root
    }

    // The table `keys[..count]` names under `table`, made where missing.
    fn descend(self, table: Map[Text, Toml], keys: Seq[Text], count: usize) -> Map[Text, Toml] {
        var t = table;
        var k = 0usize;
        while k < count {
            t = match t.get(keys.get(k)) {
                Option::Some(v) => match v {
                    Toml::Table(inner) => inner,
                    _ => self.fail(),
                },
                Option::None => {
                    let inner: Map[Text, Toml] = Map::new();
                    t.set(keys.get(k), Toml::Table.(inner));
                    inner
                },
            };
            k = k + 1usize;
        }
        t
    }

    fn define(self, table: Map[Text, Toml], keys: Seq[Text], value: Toml) {
        let t = self.descend(table, keys, keys.len() - 1usize);
        if t.has(keys.last()) {
            self.fail();
        }
        t.set(keys.last(), value);
    }

    // A dotted key.
    fn key(self) -> Seq[Text] {
        let keys: Seq[Text] = Seq::one(self.simple_key());
        self.blank();
        while !self.done() && self.at() == b'.' {
            self.advance();
            self.blank();
            keys.push(self.simple_key());
            self.blank();
        }
        keys
    }

    fn simple_key(self) -> Text {
        if self.done() {
            self.fail();
        }
        let b = self.at();
        if b == b'"' || b == b'\'' {
            self.string()
        } else {
            let start = self.i.get();
            while !self.done() && is_bare(self.at()) {
                self.advance();
            }
            if self.i.get() == start {
                self.fail();
            }
            self.src.slice(start, self.i.get())
        }
    }

    fn value(self) -> Toml {
        if self.done() {
            self.fail();
        }
        let b = self.at();
        if b == b'"' || b == b'\'' {
            Toml::Str.(self.string())
        } else if b == b'{' {
            self.advance();
            let table: Map[Text, Toml] = Map::new();
            self.blank();
            if !self.done() && self.at() == b'}' {
                self.advance();
            } else {
                var going = true;
                while going {
                    self.blank();
                    let keys = self.key();
                    self.blank();
                    self.expect(b'=');
                    self.blank();
                    let value = self.value();
                    self.define(table, keys, value);
                    self.blank();
                    if !self.done() && self.at() == b',' {
                        self.advance();
                    } else {
                        self.expect(b'}');
                        going = false;
                    }
                }
            }
            Toml::Table.(table)
        } else if b == b'[' {
            self.advance();
            self.space();
            while !self.done() && self.at() != b']' {
                let unit = self.value();
                self.space();
                if !self.done() && self.at() == b',' {
                    self.advance();
                    self.space();
                } else if self.done() || self.at() != b']' {
                    self.fail();
                }
            }
            self.expect(b']');
            Toml::Other
        } else {
            let start = self.i.get();
            while !self.done() && is_scalar(self.at()) {
                self.advance();
            }
            if self.i.get() == start {
                self.fail();
            }
            Toml::Other
        }
    }

    // A basic or literal string, on one line or several.
    fn string(self) -> Text {
        let quote = self.at();
        let multi = self.src.slice(self.i.get(), self.i.get() + 3usize).eq(Out::new().byte(quote).byte(quote).byte(quote).done());
        let out = Out::new();
        if multi {
            self.i.set(self.i.get() + 3usize);
            if !self.done() && self.at() == b'\n' {
                self.advance();
            } else if self.src.slice(self.i.get(), self.i.get() + 2usize).is("\r\n") {
                self.i.set(self.i.get() + 2usize);
            }
        } else {
            self.advance();
        }
        var going = true;
        while going {
            if self.done() {
                self.fail();
            }
            let b = self.at();
            if b == quote && (!multi || (self.src.byte(self.i.get() + 1usize) == quote && self.src.byte(self.i.get() + 2usize) == quote)) {
                let width = if multi { 3usize } else { 1usize };
                self.i.set(self.i.get() + width);
                going = false;
            } else if b == b'\n' && !multi {
                self.fail();
            } else if b == b'\\' && quote == b'"' {
                self.advance();
                self.escape(out, multi);
            } else {
                let unit = out.byte(b);
                self.advance();
            }
        }
        out.done()
    }

    fn escape(self, out: Out, multi: bool) {
        if self.done() {
            self.fail();
        }
        let b = self.at();
        self.advance();
        if b == b'n' {
            let unit = out.byte(b'\n');
        } else if b == b't' {
            let unit = out.byte(b'\t');
        } else if b == b'r' {
            let unit = out.byte(b'\r');
        } else if b == b'b' {
            let unit = out.byte(8u8);
        } else if b == b'f' {
            let unit = out.byte(12u8);
        } else if b == b'"' || b == b'\\' {
            let unit = out.byte(b);
        } else if b == b'u' || b == b'U' {
            let count = if b == b'u' { 4usize } else { 8usize };
            var code = 0u32;
            var k = 0usize;
            while k < count {
                let d = self.at();
                let digit = if d >= b'0' && d <= b'9' {
                    (d - b'0') as u32
                } else if d >= b'a' && d <= b'f' {
                    (d - b'a') as u32 + 10u32
                } else if d >= b'A' && d <= b'F' {
                    (d - b'A') as u32 + 10u32
                } else {
                    self.fail()
                };
                code = code * 16u32 + digit;
                self.advance();
                k = k + 1usize;
            }
            utf8(out, code);
        } else if multi && (b == b'\n' || b == b' ' || b == b'\t' || b == b'\r') {
            // A line-ending backslash drops the whitespace after it.
            self.i.set(self.i.get() - 1usize);
            self.space();
        } else {
            self.fail();
        }
    }
}

fn is_bare(b: u8) -> bool {
    (b >= b'A' && b <= b'Z') || (b >= b'a' && b <= b'z') || (b >= b'0' && b <= b'9') || b == b'_' || b == b'-'
}

fn is_scalar(b: u8) -> bool {
    !(b == b' ' || b == b'\t' || b == b'\r' || b == b'\n' || b == b',' || b == b']' || b == b'}' || b == b'#')
}

fn utf8(out: Out, code: u32) {
    if code < 128u32 {
        let unit = out.byte(code as u8);
    } else if code < 2048u32 {
        let unit = out.byte((192u32 | (code >> 6u32)) as u8).byte((128u32 | (code & 63u32)) as u8);
    } else if code < 65536u32 {
        let unit = out.byte((224u32 | (code >> 12u32)) as u8).byte((128u32 | ((code >> 6u32) & 63u32)) as u8).byte((128u32 | (code & 63u32)) as u8);
    } else {
        let unit = out.byte((240u32 | (code >> 18u32)) as u8).byte((128u32 | ((code >> 12u32) & 63u32)) as u8).byte((128u32 | ((code >> 6u32) & 63u32)) as u8).byte((128u32 | (code & 63u32)) as u8);
    }
}

// ------------------------------------------------------------ the graph --

// A declaration: compared by its `id`, unique in the program.
exposed struct Decl {
    id: u32,
    // struct enum tuple fn extern trait const method
    kind: Text,
    home: ModuleId,
    // a method's name is `Target::method`
    name: Text,
    node: Named,
    // a method's or associated const's impl
    impl_block: Option[S::Impl],
}

instance Key[Decl] {
    fn key_hash(key: Decl) -> u64 {
        Key::key_hash(key.id)
    }

    fn key_same(a: Decl, b: Decl) -> bool {
        a.id == b.id
    }
}

// The item a declaration declares.
exposed enum Named {
    Struct(S::StructDecl),
    Enum(S::EnumDecl),
    Tuple(S::TupleDecl),
    Fn(S::Fn),
    Extern(S::Extern),
    Trait(S::TraitDecl),
    Const(S::Const),
}

fn named_pos(n: Named) -> Pos {
    match n {
        Named::Struct(x) => x.pos,
        Named::Enum(x) => x.pos,
        Named::Tuple(x) => x.pos,
        Named::Fn(x) => x.pos,
        Named::Extern(x) => x.pos,
        Named::Trait(x) => x.pos,
        Named::Const(x) => x.pos,
    }
}

fn item_pos(item: S::Item) -> Pos {
    match item {
        S::Item::Use(x) => x.pos,
        S::Item::Module(x) => x.pos,
        S::Item::Struct(x) => x.pos,
        S::Item::Tuple(x) => x.pos,
        S::Item::Enum(x) => x.pos,
        S::Item::Fn(x) => x.pos,
        S::Item::Extern(x) => x.pos,
        S::Item::Const(x) => x.pos,
        S::Item::Impl(x) => x.pos,
        S::Item::Trait(x) => x.pos,
        S::Item::Instance(x) => x.pos,
    }
}

exposed struct Package {
    id: usize,
    name: Cell[Text],
    // its directory
    root: Text,
    source_root: Cell[Text],
    // alias -> package id
    deps: Map[Text, usize],
    // an executable's entry path
    entry: Cell[Option[Seq[Text]]],
    // module -> source path
    files: Map[ModuleId, Text],
    entry_decl: Cell[Option[Decl]],
}

// One module's namespace.
exposed struct Scope {
    home: ModuleId,
    decls: Map[Text, Decl],
    // alias -> path
    imports: Map[Text, Seq[Text]],
    globs: Seq[Seq[Text]],
    exports: Set[Text],
    items: Seq[S::Item],
}

// What a path names.
exposed enum Target {
    Decl(Decl),
    Module(ModuleId),
    Variant(Decl, Text),
    TraitMethod(Decl, Text),
}

// What a resolved node names; see the top of this file.
exposed enum NameRef {
    Decl(Decl),
    Variant(Decl, Text),
    TraitMethod(Decl, Text),
    Assoc(Text, Text),
    Param(Text),
    Prim(Text),
    Builtin(Text),
    Local(Text),
}

// A resolution error, before its file is known; a `pos` on line 0 is no position.
exposed struct Problem {
    message: Text,
    pos: Pos,
}

// What a method or associated const is attached to: a type declaration, a primitive type, or
// nothing, for a blanket impl whose methods are found by method calls only.
exposed enum Owner {
    Decl(Decl),
    Prim(Text),
    Blanket,
}

instance Key[Owner] {
    fn key_hash(key: Owner) -> u64 {
        match key {
            Owner::Decl(d) => combine(1u64, Key::key_hash(d.id)),
            Owner::Prim(name) => combine(2u64, name.hash()),
            Owner::Blanket => 3u64,
        }
    }

    fn key_same(a: Owner, b: Owner) -> bool {
        match a {
            Owner::Decl(x) => match b {
                Owner::Decl(y) => x.id == y.id,
                _ => false,
            },
            Owner::Prim(x) => match b {
                Owner::Prim(y) => x.eq(y),
                _ => false,
            },
            Owner::Blanket => match b {
                Owner::Blanket => true,
                _ => false,
            },
        }
    }
}

// A file and a position errors inside it are reported at when they have none of their own.
exposed struct Location {
    file: Text,
    pos: Pos,
}

// An error as `KursError` prints it: `line:col: message`, or the message alone.
fn error_text(message: Text, pos: Pos) -> Text {
    if pos.line == 0u32 {
        message
    } else {
        Out::new().u64(pos.line as u64).put(":").u64(pos.col as u64).put(": ").add(message).done()
    }
}

// The error `message` at `pos`, printed as `full`, naming `file` and, when it has no position of
// its own, the position `at` of the item it is in. Returns the new printed form and position.
fn located(full: Text, message: Text, pos: Pos, file: Text, at: Pos) -> (Text, Pos) {
    if full.starts_with(file) {
        (full, pos)
    } else {
        let at_pos = if pos.line != 0u32 { pos } else { at };
        let prefix = if at_pos.line != 0u32 {
            Out::new().add(file).put(":").u64(at_pos.line as u64).put(":").u64(at_pos.col as u64).done()
        } else {
            file
        };
        (Out::new().add(prefix).put(": ").add(message).done(), at_pos)
    }
}

// The package graph rooted at a package directory, its kur.toml, or one .kur file. A single file
// depends on the standard library `std` when one is installed (KURSAL_LIB). `ids` numbers the
// syntax nodes.
fn load(path: Text, ids: Cell[u32]) -> Seq[Package] {
    let path = resolved(path);
    let packages: Seq[Package] = Seq::new();
    let by_dir: Map[Text, usize] = Map::new();
    if suffix(path).is(".kur") {
        let items = parse(read_source(path), path, ids);
        var main = false;
        var i = 0usize;
        while i < items.len() {
            let unit = match items.get(i) {
                S::Item::Fn(f) => {
                    if f.name.is("main") {
                        main = true;
                    }
                },
                _ => (),
            };
            i = i + 1usize;
        }
        let std: Map[Text, Text] = Map::new();
        let lib = lib_dir();
        if path_exists(join(join(lib, text("std")), text("kur.toml"))) {
            std.set(text("std"), join(lib, text("std")));
        }
        let entry = if main { Option::Some.(Seq::one(text("main"))) } else { Option::None };
        let unit = add(packages, by_dir, path, Option::Some.(stem(path)), Option::Some.(parent(path)), Option::Some.(std), entry);
        packages.get(0usize).files.set(ModuleId::root(0usize), path);
    } else {
        let manifest = if suffix(path).is(".toml") { path } else { join(path, text("kur.toml")) };
        let unit = add(packages, by_dir, manifest, Option::None, Option::None, Option::None, Option::None);
    }
    var p = 0usize;
    while p < packages.len() {
        let package = packages.get(p);
        if package.files.is_empty() {
            let found = discover(package);
            let modules = found.keys();
            var k = 0usize;
            while k < modules.len() {
                package.files.set(modules.get(k), found.at(modules.get(k)));
                k = k + 1usize;
            }
            if !package.files.has(ModuleId::root(package.id)) {
                fail(Out::new().put("package ").add(package.name.get()).put(" has no lib.kur in ").add(package.source_root.get()).done());
            }
        }
        p = p + 1usize;
    }
    check_acyclic(packages);
    packages
}

fn read_source(path: Text) -> Text {
    match read(path) {
        Option::Some(s) => s,
        Option::None => fail(Out::new().put("cannot read ").add(path).done()),
    }
}

// The package of `manifest` (a kur.toml, or a single .kur file), added with its dependencies
// unless its directory's manifest was added already.
fn add(packages: Seq[Package], by_dir: Map[Text, usize], manifest: Text, name: Option[Text], source_root: Option[Text],
       deps: Option[Map[Text, Text]], entry: Option[Seq[Text]]) -> usize {
    let root = parent(manifest);
    let is_toml = suffix(manifest).is(".toml");
    if is_toml {
        let unit = match by_dir.get(root) {
            Option::Some(id) => return id,
            Option::None => (),
        };
    }
    let package = Package.{
        id: packages.len(),
        name: Cell::new(match name { Option::Some(n) => n, Option::None => base_name(root) }),
        root,
        source_root: Cell::new(match source_root { Option::Some(s) => s, Option::None => root }),
        deps: Map::new(),
        entry: Cell::new(entry),
        files: Map::new(),
        entry_decl: Cell::new(Option::None),
    };
    packages.push(package);
    var deps: Map[Text, Text] = match deps {
        Option::Some(d) => d,
        Option::None => Map::new(),
    };
    if is_toml {
        by_dir.set(root, package.id);
        let config = table(Toml::Table.(read_toml(read_source(manifest), manifest)), manifest);
        let info = table(config.get_or(text("package"), Toml::Table.(Map::new())), text("package"));
        let unknown: Set[Text] = Set::new();
        let config_keys = config.keys();
        var i = 0usize;
        while i < config_keys.len() {
            let key = config_keys.get(i);
            if !key.is("package") && !key.is("dependencies") {
                unknown.add(key);
            }
            i = i + 1usize;
        }
        let info_keys = info.keys();
        i = 0usize;
        while i < info_keys.len() {
            let key = info_keys.get(i);
            if !among(key, "name kind source_root entry") {
                unknown.add(key);
            }
            i = i + 1usize;
        }
        if unknown.len() > 0usize {
            let names = unknown.items();
            names.sort(text_before);
            let out = Out::new().add(manifest).put(": unknown manifest keys [");
            var k = 0usize;
            while k < names.len() {
                let unit = out.put(if k > 0usize { ", " } else { "" }).add(repr(names.get(k)));
                k = k + 1usize;
            }
            fail(out.put("]").done());
        }
        package.name.set(string(info, "name", Option::None));
        package.source_root.set(resolved(join(root, string(info, "source_root", Option::Some.(text("src"))))));
        if string(info, "kind", Option::Some.(text("library"))).is("executable") {
            let parts = string(info, "entry", Option::None).split(text("::"));
            let path: Seq[Text] = Seq::new();
            var k = 0usize;
            while k < parts.len() {
                if !parts.get(k).is("package") {
                    path.push(parts.get(k));
                }
                k = k + 1usize;
            }
            package.entry.set(Option::Some.(path));
        }
        deps = Map::new();
        let specs = table(config.get_or(text("dependencies"), Toml::Table.(Map::new())), text("dependencies"));
        let aliases = specs.keys();
        var k = 0usize;
        while k < aliases.len() {
            let alias = aliases.get(k);
            deps.set(alias, resolved(join(root, string(table(specs.at(alias), alias), "path", Option::None))));
            k = k + 1usize;
        }
    }
    let aliases = deps.keys();
    var k = 0usize;
    while k < aliases.len() {
        let target = deps.at(aliases.get(k));
        let manifest_path = if suffix(target).is(".toml") { target } else { join(target, text("kur.toml")) };
        package.deps.set(aliases.get(k), add(packages, by_dir, manifest_path, Option::None, Option::None, Option::None, Option::None));
        k = k + 1usize;
    }
    package.id
}

fn table(value: Toml, at_pos: Text) -> Map[Text, Toml] {
    match value {
        Toml::Table(t) => t,
        _ => fail(Out::new().add(at_pos).put(": expected a table").done()),
    }
}

fn string(t: Map[Text, Toml], key: Slice[u8, 'static], default: Option[Text]) -> Text {
    let value = match t.get(text(key)) {
        Option::Some(v) => v,
        Option::None => match default {
            Option::Some(d) => Toml::Str.(d),
            Option::None => Toml::Other,
        },
    };
    match value {
        Toml::Str(s) => s,
        _ => fail(Out::new().put("manifest ").add(repr(text(key))).put(" must be a string").done()),
    }
}

// Each .kur file under the source root, by the module its path assigns.
fn discover(package: Package) -> Map[ModuleId, Text] {
    let files: Map[ModuleId, Text] = Map::new();
    walk(package, package.source_root.get(), Seq::new(), files);
    files
}

// The files of directory `here`, at `rel` under the source root, then its subdirectories in order;
// a subdirectory with its own kur.toml is another package.
fn walk(package: Package, here: Text, rel: Seq[Text], files: Map[ModuleId, Text]) {
    if !rel.is_empty() && path_exists(join(here, text("kur.toml"))) {
        return;
    }
    let entries = list_directory(here);
    let dirs: Seq[Text] = Seq::new();
    let names: Seq[Text] = Seq::new();
    var i = 0usize;
    while i < entries.len() {
        let (name, is_directory) = entries.get(i);
        if is_directory {
            dirs.push(name);
        } else {
            names.push(name);
        }
        i = i + 1usize;
    }
    dirs.sort(text_before);
    names.sort(text_before);
    i = 0usize;
    while i < names.len() {
        let name = names.get(i);
        if name.ends_with(text(".kur")) {
            let path = rel.copy();
            let module_name = stem(name);
            if !module_name.is("lib") {
                path.push(module_name);
            }
            let home = ModuleId.{ package: package.id, path };
            if files.has(home) {
                fail(Out::new().put("two files define module ").add(joined(path)).put(" of ").add(package.name.get()).done());
            }
            files.set(home, join(here, name));
        }
        i = i + 1usize;
    }
    i = 0usize;
    while i < dirs.len() {
        let sub = rel.copy();
        sub.push(dirs.get(i));
        walk(package, join(here, dirs.get(i)), sub, files);
        i = i + 1usize;
    }
}

fn check_acyclic(packages: Seq[Package]) {
    let state: Map[usize, u32] = Map::new();
    var p = 0usize;
    while p < packages.len() {
        visit(packages, state, p);
        p = p + 1usize;
    }
}

fn visit(packages: Seq[Package], state: Map[usize, u32], package_id: usize) {
    let s = state.get_or(package_id, 0u32);
    if s == 1u32 {
        fail(Out::new().put("dependency cycle through package ").add(packages.get(package_id).name.get()).done());
    }
    if s == 0u32 {
        state.set(package_id, 1u32);
        let deps = packages.get(package_id).deps.values();
        var i = 0usize;
        while i < deps.len() {
            visit(packages, state, deps.get(i));
            i = i + 1usize;
        }
        state.set(package_id, 2u32);
    }
}

// ------------------------------------------------------------ namespaces --

// A lookup: `("path", module, path)`, `("import", module, [alias])` or `("export", module, [name])`.
fn lookup_key(kind: Slice[u8, 'static], home: ModuleId, names: Seq[Text]) -> (Text, ModuleId, Seq[Text]) {
    (text(kind), home, names)
}

fn problem(message: Text) -> Result[Target, Problem] {
    Result::Err.(Problem.{ message, pos: no_pos() })
}

exposed struct Resolver {
    packages: Seq[Package],
    scopes: Map[ModuleId, Scope],
    children: Map[ModuleId, Map[Text, ModuleId]],
    instances: Seq[(ModuleId, S::InstanceDecl)],
    // (owner, member) -> declarations
    attached: Map[(Owner, Text), Seq[Decl]],
    cache: Map[(Text, ModuleId, Seq[Text]), Target],
    active: Set[(Text, ModuleId, Seq[Text])],
    // the glob imports being resolved, by module and path
    expanding: Set[(ModuleId, Seq[Text])],
    // node id -> what it names
    refs: Map[u32, NameRef],
    // The files and positions errors are reported in, innermost last.
    locations: Seq[Location],
    decl_ids: Cell[u32],
}

impl Resolver {
    fn new(packages: Seq[Package], ids: Cell[u32]) -> Resolver {
        let r = Resolver.{
            packages,
            scopes: Map::new(),
            children: Map::new(),
            instances: Seq::new(),
            attached: Map::new(),
            cache: Map::new(),
            active: Set::new(),
            expanding: Set::new(),
            refs: Map::new(),
            locations: Seq::new(),
            decl_ids: Cell::new(0u32),
        };
        var p = 0usize;
        while p < packages.len() {
            let package = packages.get(p);
            let unit = r.children_of(ModuleId::root(package.id));
            let modules = package.files.keys();
            var i = 0usize;
            while i < modules.len() {
                let home = modules.get(i);
                let file = package.files.at(home);
                r.collect(home, parse(read_source(file), file, ids));
                var k = 0usize;
                while k < home.path.len() {
                    let parent = ModuleId.{ package: home.package, path: home.path.slice(0usize, k) };
                    let name = home.path.get(k);
                    r.children_of(parent).set(name, parent.child(name));
                    let unit = r.children_of(parent.child(name));
                    k = k + 1usize;
                }
                i = i + 1usize;
            }
            p = p + 1usize;
        }
        let scopes = r.scopes.values();
        var s = 0usize;
        while s < scopes.len() {
            r.attach(scopes.get(s));
            s = s + 1usize;
        }
        r
    }

    // `children.setdefault(module, {})`.
    fn children_of(self, home: ModuleId) -> Map[Text, ModuleId] {
        match self.children.get(home) {
            Option::Some(c) => c,
            Option::None => {
                let c: Map[Text, ModuleId] = Map::new();
                self.children.set(home, c);
                c
            },
        }
    }

    fn new_decl(self, kind: Slice[u8, 'static], home: ModuleId, name: Text, node: Named, impl_block: Option[S::Impl]) -> Decl {
        let id = self.decl_ids.get();
        self.decl_ids.set(id + 1u32);
        Decl.{ id, kind: text(kind), home, name, node, impl_block }
    }

    fn collect(self, home: ModuleId, items: Seq[S::Item]) {
        let scope = Scope.{ home, decls: Map::new(), imports: Map::new(), globs: Seq::new(), exports: Set::new(), items };
        self.scopes.set(home, scope);
        var i = 0usize;
        while i < items.len() {
            let unit = match items.get(i) {
                S::Item::Module(m) => self.fail(text("package sources do not declare 'module'"), m.pos),
                S::Item::Use(u) => self.use_tree(scope, Seq::new(), u.tree, u.is_export),
                S::Item::Instance(n) => self.instances.push((home, n)),
                S::Item::Struct(x) => self.declare(scope, self.new_decl("struct", home, x.name, Named::Struct.(x), Option::None)),
                S::Item::Enum(x) => self.declare(scope, self.new_decl("enum", home, x.name, Named::Enum.(x), Option::None)),
                S::Item::Tuple(x) => self.declare(scope, self.new_decl("tuple", home, x.name, Named::Tuple.(x), Option::None)),
                S::Item::Fn(x) => self.declare(scope, self.new_decl("fn", home, x.name, Named::Fn.(x), Option::None)),
                S::Item::Extern(x) => self.declare(scope, self.new_decl("extern", home, x.name, Named::Extern.(x), Option::None)),
                S::Item::Trait(x) => self.declare(scope, self.new_decl("trait", home, x.name, Named::Trait.(x), Option::None)),
                S::Item::Const(x) => self.declare(scope, self.new_decl("const", home, x.name, Named::Const.(x), Option::None)),
                S::Item::Impl(x) => (),
            };
            i = i + 1usize;
        }
    }

    fn declare(self, scope: Scope, decl: Decl) {
        if scope.decls.has(decl.name) || scope.imports.has(decl.name) {
            self.fail(Out::new().put("duplicate name ").add(decl.name).done(), named_pos(decl.node));
        }
        scope.decls.set(decl.name, decl);
    }

    fn use_tree(self, scope: Scope, prefix: Seq[Text], tree: S::UseTree, exported: bool) {
        let path = prefix.copy();
        path.append(tree.path);
        if tree.star {
            scope.globs.push(path);
        } else if !tree.children.is_empty() {
            var i = 0usize;
            while i < tree.children.len() {
                self.use_tree(scope, path, tree.children.get(i), exported);
                i = i + 1usize;
            }
        } else {
            let name = match tree.alias {
                Option::Some(a) => a,
                Option::None => path.last(),
            };
            // `export name;` publishes an existing name
            if exported && path.len() == 1usize && path.get(0usize).eq(name) {
                scope.exports.add(name);
                return;
            }
            if name.is("package") || name.is("builtin") || is_builtin_trait(name) {
                self.fail(Out::new().put("'").add(name).put("' is compiler-sealed").done(), no_pos());
            }
            if scope.imports.has(name) || scope.decls.has(name) {
                self.fail(Out::new().put("duplicate import ").add(name).put(" in ").add(repr_module(scope.home)).done(), no_pos());
            }
            scope.imports.set(name, path);
            if exported {
                scope.exports.add(name);
            }
        }
    }

    // Methods and associated consts are declared by their impl's module and attached to the impl's
    // target type for `Target::name` lookup.
    fn attach(self, scope: Scope) {
        var i = 0usize;
        while i < scope.items.len() {
            let unit = match scope.items.get(i) {
                S::Item::Impl(m) => self.attach_impl(scope, m),
                _ => (),
            };
            i = i + 1usize;
        }
    }

    fn attach_impl(self, scope: Scope, item: S::Impl) {
        let target = match item.type {
            Type::Name(n) => n,
            _ => self.fail(text("an impl target must be a named type"), item.pos),
        };
        let spelled = target.path.last();
        let params = match item.quantifier {
            Option::Some(f) => f.params,
            Option::None => Seq::new(),
        };
        let owner = if target.path.len() == 1usize && is_prim(target.path.get(0usize)) {
            Owner::Prim.(target.path.get(0usize))
        } else if target.path.len() == 1usize && params.has(target.path.get(0usize)) {
            // a blanket impl: its methods are found by method calls only
            Owner::Blanket
        } else {
            match self.need(scope.home, target.path, item.pos) {
                Target::Decl(d) => Owner::Decl.(d),
                _ => self.fail(text("an impl target must name a type declaration"), item.pos),
            }
        };
        var k = 0usize;
        while k < item.items.len() {
            let decl = match item.items.get(k) {
                S::Member::Fn(f) => self.new_decl("method", scope.home, Out::new().add(spelled).put("::").add(f.name).done(), Named::Fn.(f), Option::Some.(item)),
                S::Member::Const(c) => self.new_decl("const", scope.home, Out::new().add(spelled).put("::").add(c.name).done(), Named::Const.(c), Option::Some.(item)),
            };
            let member = match item.items.get(k) {
                S::Member::Fn(f) => f.name,
                S::Member::Const(c) => c.name,
            };
            self.declare(scope, decl);
            let key = (owner, member);
            match self.attached.get(key) {
                Option::Some(found) => found.push(decl),
                Option::None => self.attached.set(key, Seq::one(decl)),
            }
            k = k + 1usize;
        }
    }

    // ---- errors
    fn file(self, home: ModuleId) -> Text {
        self.packages.get(home.package).files.at(home)
    }

    // Errors from here until `unlocate` are inside `module`'s file and, when they have no
    // position, at `pos`.
    fn locate(self, home: ModuleId, pos: Pos) {
        self.locations.push(Location.{ file: self.file(home), pos });
    }

    fn unlocate(self) {
        let unit = self.locations.pop();
    }

    // Stops with `message` at `pos` (none on line 0), naming the files it is located in.
    fn fail(self, message: Text, pos: Pos) -> ! {
        var full = error_text(message, pos);
        var at = pos;
        var i = self.locations.len();
        while i > 0usize {
            i = i - 1usize;
            let l = self.locations.get(i);
            let (f, p) = located(full, message, at, l.file, l.pos);
            full = f;
            at = p;
        }
        fail(full)
    }

    // ---- path lookup
    // What `path` names from `module`, or why it names nothing; an error without a position gets
    // `pos`.
    fn lookup(self, home: ModuleId, path: Seq[Text], pos: Pos) -> Result[Target, Problem] {
        match self.solve(lookup_key("path", home, path)) {
            Result::Ok(t) => Result::Ok.(t),
            Result::Err(e) => if e.pos.line == 0u32 && pos.line != 0u32 {
                Result::Err.(Problem.{ message: e.message, pos })
            } else {
                Result::Err.(e)
            },
        }
    }

    // What `path` names from `module`, stopping if it names nothing.
    fn need(self, home: ModuleId, path: Seq[Text], pos: Pos) -> Target {
        match self.lookup(home, path, pos) {
            Result::Ok(t) => t,
            Result::Err(e) => self.fail(e.message, e.pos),
        }
    }

    fn solve(self, key: (Text, ModuleId, Seq[Text])) -> Result[Target, Problem] {
        let unit = match self.cache.get(key) {
            Option::Some(t) => return Result::Ok.(t),
            Option::None => (),
        };
        let (kind, home, names) = key;
        if self.active.has(key) {
            let at = if kind.is("path") { repr_tuple(names) } else { names.get(0usize) };
            return problem(Out::new().put("import cycle at ").add(at).done());
        }
        self.active.add(key);
        let value = if kind.is("import") {
            self.resolve_path(home, self.scopes.at(home).imports.at(names.get(0usize)), Option::Some.(names.get(0usize)))
        } else {
            self.resolve_path(home, names, Option::None)
        };
        self.active.remove(key);
        match value {
            Result::Ok(t) => {
                self.cache.set(key, t);
                Result::Ok.(t)
            },
            Result::Err(e) => Result::Err.(e),
        }
    }

    fn resolve_path(self, home: ModuleId, path: Seq[Text], importing: Option[Text]) -> Result[Target, Problem] {
        let first = path.get(0usize);
        let rest = path.from(1usize);
        let scope = self.scopes.at(home);
        let not_importing = match importing {
            Option::Some(name) => !name.eq(first),
            Option::None => true,
        };
        var target = if first.is("package") {
            Target::Module.(ModuleId::root(home.package))
        } else if scope.decls.has(first) {
            Target::Decl.(scope.decls.at(first))
        } else if scope.imports.has(first) && not_importing {
            match self.solve(lookup_key("import", home, Seq::one(first))) {
                Result::Ok(t) => t,
                Result::Err(e) => return Result::Err.(e),
            }
        } else {
            match self.root_member(home, first) {
                Option::Some(t) => t,
                Option::None => match self.glob(home, first) {
                    Result::Ok(found) => match found {
                        Option::Some(t) => t,
                        Option::None => return problem(Out::new().put("unknown name ").add(joined(path)).done()),
                    },
                    Result::Err(e) => return Result::Err.(e),
                },
            }
        };
        var k = 0usize;
        while k < rest.len() {
            target = match target {
                Target::Decl(d) => return self.associated(d, joined(rest.from(k))),
                Target::Module(m) => match self.member(home, m, rest.get(k)) {
                    Result::Ok(t) => t,
                    Result::Err(e) => return Result::Err.(e),
                },
                _ => return problem(Out::new().add(joined(path.slice(0usize, k + 1usize))).put(" is not a module").done()),
            };
            k = k + 1usize;
        }
        Result::Ok.(target)
    }

    fn root_member(self, home: ModuleId, name: Text) -> Option[Target] {
        let package = self.packages.get(home.package);
        let root = ModuleId::root(home.package);
        if package.deps.has(name) {
            return Option::Some.(Target::Module.(ModuleId::root(package.deps.at(name))));
        }
        let children = self.children.at(root);
        if children.has(name) {
            return Option::Some.(Target::Module.(children.at(name)));
        }
        match self.scopes.get(root) {
            Option::Some(scope) => match scope.decls.get(name) {
                Option::Some(d) => Option::Some.(Target::Decl.(d)),
                Option::None => Option::None,
            },
            Option::None => Option::None,
        }
    }

    // `name` through the module's glob imports, in order. A glob whose own path is being resolved
    // offers nothing more: its path's first name is unknown in the module itself.
    fn glob(self, home: ModuleId, name: Text) -> Result[Option[Target], Problem] {
        let globs = self.scopes.at(home).globs;
        var i = 0usize;
        while i < globs.len() {
            let path = globs.get(i);
            if !self.expanding.has((home, path)) {
                self.expanding.add((home, path));
                let found = self.resolve_path(home, path, Option::None);
                self.expanding.remove((home, path));
                let source = match found {
                    Result::Ok(t) => t,
                    Result::Err(e) => return Result::Err.(e),
                };
                let unit = match source {
                    Target::Module(m) => match self.member(home, m, name) {
                        Result::Ok(t) => return Result::Ok.(Option::Some.(t)),
                        Result::Err(e) => (),
                    },
                    _ => return Result::Err.(Problem.{ message: Out::new().add(joined(path)).put(" is not a module").done(), pos: no_pos() }),
                };
            }
            i = i + 1usize;
        }
        Result::Ok.(Option::None)
    }

    // `module::name`, seen from `caller`: its own declarations; within one package also its
    // children and imports; across packages only exports.
    fn member(self, caller: ModuleId, home: ModuleId, name: Text) -> Result[Target, Problem] {
        let scope = self.scopes.get(home);
        let unit = match scope {
            Option::Some(s) => match s.decls.get(name) {
                Option::Some(d) => return Result::Ok.(Target::Decl.(d)),
                Option::None => (),
            },
            Option::None => (),
        };
        if caller.package == home.package {
            let unit = match self.children.get(home) {
                Option::Some(c) => match c.get(name) {
                    Option::Some(m) => return Result::Ok.(Target::Module.(m)),
                    Option::None => (),
                },
                Option::None => (),
            };
            let unit = match scope {
                Option::Some(s) => {
                    if s.imports.has(name) {
                        return self.solve(lookup_key("import", home, Seq::one(name)));
                    }
                    let unit = match self.glob(home, name) {
                        Result::Ok(found) => match found {
                            Option::Some(t) => return Result::Ok.(t),
                            Option::None => (),
                        },
                        Result::Err(e) => return Result::Err.(e),
                    };
                },
                Option::None => (),
            };
        } else {
            let unit = match scope {
                Option::Some(s) => {
                    if s.exports.has(name) {
                        return self.solve(lookup_key("export", home, Seq::one(name)));
                    }
                },
                Option::None => (),
            };
        }
        let owner = if home.path.is_empty() { self.packages.get(home.package).name.get() } else { joined(home.path) };
        problem(Out::new().put("unknown or private member ").add(name).put(" of ").add(owner).done())
    }

    // `Owner::name`: an enum variant, or a method or const attached to `Owner`.
    fn associated(self, owner: Decl, name: Text) -> Result[Target, Problem] {
        let unit = match owner.node {
            Named::Enum(e) => {
                var i = 0usize;
                while i < e.variants.len() {
                    if e.variants.get(i).name.eq(name) {
                        return Result::Ok.(Target::Variant.(owner, name));
                    }
                    i = i + 1usize;
                }
            },
            Named::Trait(t) => {
                var i = 0usize;
                while i < t.methods.len() {
                    if t.methods.get(i).name.eq(name) {
                        return Result::Ok.(Target::TraitMethod.(owner, name));
                    }
                    i = i + 1usize;
                }
            },
            _ => (),
        };
        let found = self.attached.get_or((Owner::Decl.(owner), name), Seq::new());
        var own: Seq[Decl] = Seq::new();
        var i = 0usize;
        while i < found.len() {
            if Key::key_same(found.get(i).home, owner.home) {
                own.push(found.get(i));
            }
            i = i + 1usize;
        }
        if own.is_empty() {
            own = found;
        }
        if own.len() != 1usize {
            return problem(Out::new().put(if own.is_empty() { "unknown" } else { "ambiguous" }).put(" associated name ").add(owner.name).put("::").add(name).done());
        }
        Result::Ok.(Target::Decl.(own.get(0usize)))
    }

    // A library item the compiler itself refers to (Slice for string literals, Buffer and Format
    // for f-strings, Ordering for atomics): through a direct dependency on its home library, else
    // through std, else in the module's own package.
    fn library(self, home: ModuleId, library_name: Text, path: Seq[Text], std_path: Seq[Text]) -> Target {
        let deps = self.packages.get(home.package).deps;
        let root = if deps.has(library_name) { library_name } else if deps.has(text("std")) { text("std") } else { text("package") };
        let full: Seq[Text] = Seq::one(root);
        full.append(if root.is("std") { std_path } else { path });
        self.need(home, full, no_pos())
    }
}

// ---------------------------------------------------------- references --

// `names` with `more` added, as a new sequence: the sets of names in scope.
fn with(names: Seq[Text], more: Seq[Text]) -> Seq[Text] {
    let out = names.copy();
    out.append(more);
    out
}

fn with_one(names: Seq[Text], name: Text) -> Seq[Text] {
    let out = names.copy();
    out.push(name);
    out
}

fn quantifier_of(item: S::Item) -> Option[S::Forall] {
    match item {
        S::Item::Use(x) => x.quantifier,
        S::Item::Module(x) => Option::None,
        S::Item::Struct(x) => x.quantifier,
        S::Item::Tuple(x) => x.quantifier,
        S::Item::Enum(x) => x.quantifier,
        S::Item::Fn(x) => x.quantifier,
        S::Item::Extern(x) => x.quantifier,
        S::Item::Const(x) => x.quantifier,
        S::Item::Impl(x) => x.quantifier,
        S::Item::Trait(x) => x.quantifier,
        S::Item::Instance(x) => x.quantifier,
    }
}

// The type parameters a quantifier binds, without its brands.
fn forall_params(quantifier: Option[S::Forall]) -> Seq[Text] {
    let out: Seq[Text] = Seq::new();
    let unit = match quantifier {
        Option::Some(f) => {
            let all = with(f.params, f.determined);
            var i = 0usize;
            while i < all.len() {
                if !all.get(i).starts_with(text("'")) {
                    out.push(all.get(i));
                }
                i = i + 1usize;
            }
        },
        Option::None => (),
    };
    out
}

// Resolve every path in every item of every module.
exposed struct Names {
    r: Resolver,
    home: Cell[ModuleId],
}

impl Names {
    fn new(r: Resolver) -> Names {
        Names.{ r, home: Cell::new(ModuleId::root(0usize)) }
    }

    fn run(self) -> Resolver {
        let modules = self.r.scopes.keys();
        var m = 0usize;
        while m < modules.len() {
            let home = modules.get(m);
            self.home.set(home);
            let items = self.r.scopes.at(home).items;
            var i = 0usize;
            while i < items.len() {
                let item = items.get(i);
                self.r.locate(home, item_pos(item));
                self.item(item, Seq::new());
                self.r.unlocate();
                i = i + 1usize;
            }
            m = m + 1usize;
        }
        self.r
    }

    fn set(self, id: u32, r: NameRef) {
        self.r.refs.set(id, r);
    }

    fn premises(self, quantifier: Option[S::Forall], types: Seq[Text]) {
        let unit = match quantifier {
            Option::Some(f) => {
                var i = 0usize;
                while i < f.premises.len() {
                    let premise = f.premises.get(i);
                    let trait_path = premise.trait_path;
                    let trait_ref = if trait_path.len() == 1usize && is_builtin_trait(trait_path.get(0usize)) {
                        NameRef::Builtin.(trait_path.get(0usize))
                    } else {
                        NameRef::Decl.(self.decl(trait_path, "trait", no_pos()))
                    };
                    var k = 0usize;
                    while k < premise.args.args.len() {
                        self.type(premise.args.args.get(k), types, false);
                        k = k + 1usize;
                    }
                    self.set(premise.args.id, trait_ref);
                    i = i + 1usize;
                }
            },
            Option::None => (),
        };
    }

    fn item(self, item: S::Item, types: Seq[Text]) {
        let unit = match item {
            S::Item::Use(x) => return,
            S::Item::Module(x) => return,
            _ => (),
        };
        let quantifier = quantifier_of(item);
        let types = with(types, forall_params(quantifier));
        self.premises(quantifier, types);
        match item {
            S::Item::Struct(s) => {
                var i = 0usize;
                while i < s.fields.len() {
                    self.type(s.fields.get(i).type, types, false);
                    i = i + 1usize;
                }
            },
            S::Item::Tuple(t) => self.types(t.elems, types),
            S::Item::Enum(e) => {
                var i = 0usize;
                while i < e.variants.len() {
                    self.types(e.variants.get(i).payload, types);
                    i = i + 1usize;
                }
            },
            S::Item::Fn(f) => self.function(f, types),
            S::Item::Extern(x) => {
                var i = 0usize;
                while i < x.params.len() {
                    let unit = match x.params.get(i).type {
                        Option::Some(t) => self.type(t, types, false),
                        Option::None => (),
                    };
                    i = i + 1usize;
                }
                let unit = match x.ret {
                    Option::Some(t) => self.type(t, types, false),
                    Option::None => (),
                };
            },
            S::Item::Const(c) => {
                self.type(c.type, types, false);
                self.expr(c.value, types, Seq::new());
            },
            S::Item::Impl(m) => {
                self.type(m.type, types, false);
                var i = 0usize;
                while i < m.items.len() {
                    let unit = match m.items.get(i) {
                        S::Member::Fn(f) => self.item(S::Item::Fn.(f), types),
                        S::Member::Const(c) => self.item(S::Item::Const.(c), types),
                    };
                    i = i + 1usize;
                }
            },
            S::Item::Trait(t) => {
                let trait_types = if t.quantifier.is_none() { with_one(types, text("Self")) } else { types };
                var i = 0usize;
                while i < t.methods.len() {
                    self.function(t.methods.get(i), trait_types);
                    i = i + 1usize;
                }
            },
            S::Item::Instance(n) => {
                self.type(n.type, types, true);
                var i = 0usize;
                while i < n.methods.len() {
                    self.item(S::Item::Fn.(n.methods.get(i)), types);
                    i = i + 1usize;
                }
            },
            _ => (),
        }
    }

    fn function(self, f: S::Fn, types: Seq[Text]) {
        let types = with(types, forall_params(f.quantifier));
        self.premises(f.quantifier, types);
        let names: Seq[Text] = Seq::new();
        var i = 0usize;
        while i < f.params.len() {
            let p = f.params.get(i);
            let unit = match p.type {
                Option::Some(t) => self.type(t, types, false),
                Option::None => (),
            };
            names.push(p.name);
            i = i + 1usize;
        }
        let unit = match f.ret {
            Option::Some(t) => self.type(t, types, false),
            Option::None => (),
        };
        let unit = match f.body {
            Option::Some(b) => self.block(b, types, names),
            Option::None => (),
        };
    }

    // The declaration `path` names, of `kind` unless it is empty.
    fn decl(self, path: Seq[Text], kind: Slice[u8, 'static], pos: Pos) -> Decl {
        let target = self.r.need(self.home.get(), path, pos);
        let k = text(kind);
        match target {
            Target::Decl(d) => if k.is_empty() || d.kind.eq(k) {
                d
            } else {
                self.not_a(path, k, pos)
            },
            _ => self.not_a(path, k, pos),
        }
    }

    fn not_a(self, path: Seq[Text], kind: Text, pos: Pos) -> ! {
        let what = if kind.is_empty() { text("declaration") } else { kind };
        self.r.fail(Out::new().add(joined(path)).put(" is not a ").add(what).done(), pos)
    }

    // ---- types
    fn types(self, ts: Seq[Type], types: Seq[Text]) {
        var i = 0usize;
        while i < ts.len() {
            self.type(ts.get(i), types, false);
            i = i + 1usize;
        }
    }

    fn type(self, t: Type, types: Seq[Text], is_trait: bool) {
        match t {
            Type::Name(n) => {
                let path = n.path;
                let single = path.len() == 1usize;
                let name = path.get(0usize);
                if single && types.has(name) {
                    self.set(n.id, NameRef::Param.(name));
                } else if single && is_prim(name) {
                    self.set(n.id, NameRef::Prim.(name));
                } else if single && is_builtin_type(name) && !self.declared(name) {
                    self.set(n.id, NameRef::Builtin.(name));
                } else if name.is("builtin") {
                    if path.len() != 2usize {
                        self.r.fail(text("a builtin type path has exactly two components"), no_pos());
                    }
                    self.set(n.id, NameRef::Builtin.(path.get(1usize)));
                } else {
                    let d = self.decl(path, if is_trait { "trait" } else { "" }, no_pos());
                    self.set(n.id, NameRef::Decl.(d));
                    if !is_trait && !d.kind.is("struct") && !d.kind.is("enum") && !d.kind.is("tuple") {
                        self.r.fail(Out::new().add(joined(path)).put(" is not a type").done(), no_pos());
                    }
                }
                self.types(n.args, types);
            },
            Type::Ptr(inner) => self.type(inner.get(), types, false),
            Type::Tuple(elems) => self.types(elems, types),
            Type::Array(elem, length) => {
                self.type(elem.get(), types, false);
                self.expr(length.get(), types, Seq::new());
            },
            Type::Fn(f) => {
                self.slots(f.params, types);
                self.type(f.ret.get(), types, false);
            },
            Type::Closure(c) => {
                self.slots(c.params, types);
                self.type(c.ret.get(), types, false);
                let unit = match c.env {
                    Option::Some(env) => self.type(env.get(), types, false),
                    Option::None => (),
                };
            },
            Type::Exists(brands, body) => self.type(body.get(), types, false),
            Type::Foreach(f) => {
                self.type(f.source.get(), types, false);
                self.type(f.body.get(), with_one(types, f.binder), false);
            },
            Type::Forall(params, body) => {
                let bound: Seq[Text] = Seq::new();
                var i = 0usize;
                while i < params.len() {
                    if !params.get(i).starts_with(text("'")) {
                        bound.push(params.get(i));
                    }
                    i = i + 1usize;
                }
                self.type(body.get(), with(types, bound), false);
            },
            _ => (),
        }
    }

    fn slots(self, slots: Seq[S::Slot], types: Seq[Text]) {
        var i = 0usize;
        while i < slots.len() {
            self.type(slots.get(i).type, types, false);
            i = i + 1usize;
        }
    }

    fn visible(self, name: Text) -> bool {
        self.r.lookup(self.home.get(), Seq::one(name), no_pos()).is_ok()
    }

    fn declared(self, name: Text) -> bool {
        let scope = self.r.scopes.at(self.home.get());
        scope.decls.has(name) || scope.imports.has(name)
    }

    // ---- expressions
    // Resolve `e`; `values` are the locals in scope.
    fn expr(self, e: Expr, types: Seq[Text], values: Seq[Text]) {
        match e {
            Expr::Path(p) => self.path(p, types, values),
            Expr::Block(b) => self.block(b, types, values),
            Expr::StructLit(s) => {
                let names = s.path.names();
                if !names.get(0usize).is("builtin") {
                    self.set(s.path.id, NameRef::Decl.(self.decl(names, "struct", s.pos)));
                }
                self.segment_args(s.path, types);
                var i = 0usize;
                while i < s.fields.len() {
                    let unit = match s.fields.get(i).value {
                        Option::Some(v) => self.expr(v, types, values),
                        Option::None => (),
                    };
                    i = i + 1usize;
                }
                i = 0usize;
                while i < s.fields.len() {
                    let f = s.fields.get(i);
                    if f.value.is_none() && !values.has(f.name) {
                        self.r.fail(Out::new().put("unknown local ").add(f.name).done(), s.pos);
                    }
                    i = i + 1usize;
                }
            },
            Expr::Match(m) => {
                self.expr(m.scrutinee.get(), types, values);
                var i = 0usize;
                while i < m.arms.len() {
                    let arm = m.arms.get(i);
                    let bound: Seq[Text] = Seq::new();
                    var k = 0usize;
                    while k < arm.cases.len() {
                        let case = arm.cases.get(k);
                        let unit = match case.kind {
                            S::CaseKind::Variant => {
                                let path = match case.path {
                                    Option::Some(p) => p,
                                    Option::None => self.r.fail(text("internal error: a variant case without a path"), no_pos()),
                                };
                                self.variant(path);
                                self.segment_args(path, types);
                                let unit = match case.binders {
                                    Option::Some(bs) => {
                                        var b = 0usize;
                                        while b < bs.len() {
                                            if !bs.get(b).is("_") && !bs.get(b).is_empty() {
                                                bound.push(bs.get(b));
                                            }
                                            b = b + 1usize;
                                        }
                                    },
                                    Option::None => (),
                                };
                            },
                            _ => (),
                        };
                        k = k + 1usize;
                    }
                    self.expr(arm.body, types, with(values, bound));
                    i = i + 1usize;
                }
            },
            Expr::Closure(c) => {
                let names: Seq[Text] = Seq::new();
                var i = 0usize;
                while i < c.params.len() {
                    let p = c.params.get(i);
                    let unit = match p.type {
                        Option::Some(t) => self.type(t, types, false),
                        Option::None => (),
                    };
                    names.push(p.name);
                    i = i + 1usize;
                }
                let unit = match c.ret {
                    Option::Some(t) => self.type(t, types, false),
                    Option::None => (),
                };
                self.expr(c.body.get(), types, with(values, names));
            },
            Expr::Foreach(f) => {
                self.expr(f.source.get(), types, values);
                let inner = match f.binder {
                    Option::Some(b) => with_one(types, b),
                    Option::None => types,
                };
                self.block(f.body, inner, with_one(values, f.name));
            },
            Expr::Cast(c) => {
                self.expr(c.value.get(), types, values);
                self.type(c.type, types, false);
            },
            Expr::Sizeof(n) => self.type(n.value, types, false),
            Expr::While(w) => {
                self.expr(w.cond.get(), types, values);
                self.block(w.body, types, values);
            },
            Expr::For(f) => {
                self.expr(f.iterator.get(), types, values);
                self.block(f.body, types, with_one(values, f.name));
            },
            Expr::Lit(l) => (),
            _ => {
                let parts = children(e);
                var i = 0usize;
                while i < parts.len() {
                    self.expr(parts.get(i), types, values);
                    i = i + 1usize;
                }
            },
        }
    }

    fn block(self, b: S::Block, types: Seq[Text], values: Seq[Text]) {
        var values = values;
        var i = 0usize;
        while i < b.stmts.len() {
            values = self.stmt(b.stmts.get(i), types, values);
            i = i + 1usize;
        }
        let unit = match b.tail {
            Option::Some(t) => self.expr(t.get(), types, values),
            Option::None => (),
        };
    }

    fn stmt(self, s: Statement, types: Seq[Text], values: Seq[Text]) -> Seq[Text] {
        match s {
            Statement::Let(l) => {
                self.expr(l.value, types, values);
                let unit = match l.type {
                    Option::Some(t) => self.type(t, types, false),
                    Option::None => (),
                };
                with(values, bound(l.pattern))
            },
            Statement::Var(v) => {
                self.expr(v.value, types, values);
                let unit = match v.type {
                    Option::Some(t) => self.type(t, types, false),
                    Option::None => (),
                };
                with_one(values, v.name)
            },
            Statement::Const(c) => {
                self.type(c.type, types, false);
                self.expr(c.value, types, values);
                with_one(values, c.name)
            },
            Statement::Assign(a) => {
                self.expr(a.target, types, values);
                self.expr(a.value, types, values);
                values
            },
            Statement::Expr(n) => {
                self.expr(n.value, types, values);
                values
            },
        }
    }

    fn segment_args(self, p: S::Path, types: Seq[Text]) {
        var i = 0usize;
        while i < p.segments.len() {
            self.types(p.segments.get(i).args, types);
            i = i + 1usize;
        }
    }

    fn path(self, p: S::Path, types: Seq[Text], values: Seq[Text]) {
        let names = p.names();
        self.segment_args(p, types);
        let first = names.get(0usize);
        if names.len() == 1usize && values.has(first) {
            self.set(p.id, NameRef::Local.(first));
        } else if first.is("builtin") {
            self.set(p.id, NameRef::Builtin.(joined(names.from(1usize))));
        } else if names.len() == 1usize && is_builtin_value(first) && !self.visible(first) {
            self.set(p.id, NameRef::Builtin.(first));
        } else if names.len() == 2usize && is_prim(first) {
            let found = self.r.attached.get_or((Owner::Prim.(first), names.get(1usize)), Seq::new());
            if found.is_empty() {
                self.r.fail(Out::new().put("unknown ").add(first).put("::").add(names.get(1usize)).done(), p.pos);
            }
            self.set(p.id, NameRef::Decl.(found.get(0usize)));
        } else if names.len() == 2usize && types.has(first) {
            // a member of a type parameter, found by inference
            self.set(p.id, NameRef::Assoc.(first, names.get(1usize)));
        } else {
            let r = match self.r.need(self.home.get(), names, p.pos) {
                Target::Module(m) => self.r.fail(Out::new().add(joined(names)).put(" is a module, not a value").done(), p.pos),
                Target::Decl(d) => NameRef::Decl.(d),
                Target::Variant(d, v) => NameRef::Variant.(d, v),
                Target::TraitMethod(d, m) => NameRef::TraitMethod.(d, m),
            };
            self.set(p.id, r);
        }
    }

    fn variant(self, path: S::Path) {
        match self.r.need(self.home.get(), path.names(), path.pos) {
            Target::Variant(d, v) => self.set(path.id, NameRef::Variant.(d, v)),
            _ => self.r.fail(Out::new().add(joined(path.names())).put(" is not an enum variant").done(), path.pos),
        }
    }
}

fn bound(pattern: Pattern) -> Seq[Text] {
    let out: Seq[Text] = Seq::new();
    let unit = match pattern {
        Pattern::Bind(n) => out.push(n.value),
        Pattern::Tuple(n) => bound_all(out, n.value),
        Pattern::Array(n) => bound_all(out, n.value),
        Pattern::Struct(s) => {
            var i = 0usize;
            while i < s.fields.len() {
                out.append(bound(s.fields.get(i).pattern));
                i = i + 1usize;
            }
            let unit = match s.rest {
                Option::Some(r) => out.push(r),
                Option::None => (),
            };
        },
        Pattern::Wild(id) => (),
    };
    out
}

fn bound_all(out: Seq[Text], patterns: Seq[Pattern]) {
    var i = 0usize;
    while i < patterns.len() {
        out.append(bound(patterns.get(i)));
        i = i + 1usize;
    }
}

// The subexpressions of the expression forms with no binding structure.
fn children(e: Expr) -> Seq[Expr] {
    let out: Seq[Expr] = Seq::new();
    let unit = match e {
        Expr::Tuple(n) => out.append(n.value),
        Expr::Array(a) => out.append(a.elems),
        Expr::FStr(f) => {
            var i = 0usize;
            while i < f.parts.len() {
                let unit = match f.parts.get(i) {
                    S::Piece::Expr(x) => out.push(x),
                    S::Piece::Text(t) => (),
                };
                i = i + 1usize;
            }
        },
        Expr::If(n) => {
            out.push(n.cond.get());
            out.push(Expr::Block.(n.then));
            let unit = match n.other {
                Option::Some(o) => out.push(o.get()),
                Option::None => (),
            };
        },
        Expr::Return(n) => {
            let unit = match n.value {
                Option::Some(v) => out.push(v.get()),
                Option::None => (),
            };
        },
        Expr::Pack(p) => out.push(p.value.get()),
        Expr::Binop(b) => {
            out.push(b.left.get());
            out.push(b.right.get());
        },
        Expr::Unary(u) => out.push(u.operand.get()),
        Expr::UnsafeStore(s) => {
            out.push(s.pointer.get());
            out.push(s.value.get());
        },
        Expr::Field(f) => out.push(f.value.get()),
        Expr::Index(x) => out.push(x.value.get()),
        Expr::Try(n) => out.push(n.value.get()),
        Expr::Call(c) => {
            out.push(c.callee.get());
            out.append(c.args);
        },
        _ => fail(text("no resolution rule for this expression")),
    };
    out
}

// The resolved package graph rooted at `path`.
fn resolve(path: Text) -> Resolver {
    let ids = Cell::new(0u32);
    let resolver = Resolver::new(load(path, ids), ids);
    if !resolver.packages.is_empty() {
        let package = resolver.packages.get(0usize);
        let unit = match package.entry.get() {
            Option::Some(entry) => {
                if !entry.is_empty() {
                    let target = resolver.need(ModuleId::root(package.id), entry, no_pos());
                    let unit = match target {
                        Target::Decl(d) => {
                            if !d.kind.is("fn") || d.home.package != package.id {
                                fail(text("an executable's entry must be a function of its own package"));
                            }
                            package.entry_decl.set(Option::Some.(d));
                        },
                        _ => fail(text("an executable's entry must be a function of its own package")),
                    };
                }
            },
            Option::None => (),
        };
    }
    Names::new(resolver).run()
}
