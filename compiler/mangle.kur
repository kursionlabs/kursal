// Symbol names in the Itanium `_ZN...E` nested-name form (`kurs::path::h<hash>`, as `c++filt` shows
// them), where the hash is of the specialization's logical identity.
//
// This is a codegen convention, not a C++ ABI or a stable linking contract. Only bound names are
// normalized; nominal names and free brands remain distinct.

use package::base::{Out, Seq, Text, text};
use package::core::Type;
use package::types::{foreach_binders, kind_name, kurs_error};
use package::syntax::no_pos;
use std::option::Option;

// The number of characters of UTF-8 text: its bytes that do not continue a character.
fn char_count(t: Text) -> usize {
    var n = 0usize;
    var i = 0usize;
    while i < t.len {
        if (t.byte(i) & 192u8) != 128u8 {
            n = n + 1usize;
        }
        i = i + 1usize;
    }
    n
}

// Length framing avoids ambiguity without recursively escaping nested keys.
fn encode(parts: Seq[Text]) -> Text {
    let out = Out::new();
    var i = 0usize;
    while i < parts.len() {
        let unit = out.usize(char_count(parts.get(i))).put(":").add(parts.get(i));
        i = i + 1usize;
    }
    out.done()
}

fn bool_text(b: bool) -> Text {
    if b { text("True") } else { text("False") }
}

fn number(n: u64) -> Text {
    Out::new().u64(n).done()
}

fn with_names(scope: Seq[Text], names: Seq[Text]) -> Seq[Text] {
    let out = scope.copy();
    out.append(names);
    out
}

fn keys(types: Seq[Type], scope: Seq[Text]) -> Seq[Text] {
    let out: Seq[Text] = Seq::new();
    var i = 0usize;
    while i < types.len() {
        out.push(type_key(types.get(i), scope));
        i = i + 1usize;
    }
    out
}

// The position of the innermost binder of `name`, counted from the innermost.
fn bound(scope: Seq[Text], name: Text) -> Text {
    var i = scope.len();
    var found = 0usize;
    var going = true;
    while going && i > 0usize {
        i = i - 1usize;
        if scope.get(i).eq(name) {
            found = scope.len() - 1usize - i;
            going = false;
        }
    }
    Out::new().usize(found).done()
}

fn type_key(ty: Type, scope: Seq[Text]) -> Text {
    let parts: Seq[Text] = Seq::new();
    match ty {
        Type::Skolem(n) => {
            if scope.has(n) {
                parts.push(text("bound-brand"));
                parts.push(bound(scope, n));
            } else {
                parts.push(text("brand"));
                parts.push(n);
            }
        },
        Type::Named(n, args) => {
            if args.is_empty() && scope.has(n) {
                parts.push(text("bound-type"));
                parts.push(bound(scope, n));
            } else {
                parts.push(text("named"));
                parts.push(n);
                parts.append(keys(args, scope));
            }
        },
        Type::Prim(n) => {
            parts.push(text("prim"));
            parts.push(n);
        },
        Type::Never => parts.push(text("never")),
        Type::Ignored => parts.push(text("ignored")),
        Type::Tuple(elems) => {
            parts.push(text("tuple"));
            parts.append(keys(elems, scope));
        },
        Type::Struct(fields) => {
            parts.push(text("Struct"));
            var i = 0usize;
            while i < fields.len() {
                parts.push(encode(Seq::two(fields.get(i).name, type_key(fields.get(i).type, scope))));
                i = i + 1usize;
            }
        },
        Type::Enum(variants) => {
            parts.push(text("Enum"));
            var i = 0usize;
            while i < variants.len() {
                parts.push(encode(Seq::two(variants.get(i).name, type_key(variants.get(i).type, scope))));
                i = i + 1usize;
            }
        },
        Type::Array(elem, length) => {
            parts.push(text("array"));
            parts.push(number(length));
            parts.push(type_key(elem.get(), scope));
        },
        Type::Ptr(inner) => {
            parts.push(text("Ptr"));
            parts.push(type_key(inner.get(), scope));
        },
        Type::Brand(brand) => {
            parts.push(text("Brand"));
            parts.push(type_key(brand.get(), scope));
        },
        Type::Exists(names, body) => {
            parts.push(text("exists"));
            parts.push(number(names.len() as u64));
            parts.push(type_key(body.get(), with_names(scope, names)));
        },
        Type::Foreach(f) => {
            let binders = foreach_binders(f);
            parts.push(text("foreach"));
            parts.push(bool_text(f.indirect));
            parts.push(number(binders.len() as u64));
            parts.push(type_key(f.source.get(), scope));
            parts.push(type_key(f.body.get(), with_names(scope, binders)));
        },
        Type::Fn(f) => {
            let names: Seq[Text] = Seq::new();
            let kinds: Seq[Text] = Seq::new();
            var i = 0usize;
            while i < f.quantified.len() {
                names.push(f.quantified.get(i).name);
                kinds.push(kind_name(f.quantified.get(i).kind));
                i = i + 1usize;
            }
            let inner = with_names(scope, names);
            let places: Seq[Text] = Seq::new();
            var j = 0usize;
            while j < f.places.len() {
                places.push(number(f.places.get(j) as u64));
                j = j + 1usize;
            }
            parts.push(text("fn"));
            parts.push(bool_text(f.is_unsafe));
            parts.push(encode(places));
            parts.push(encode(kinds));
            parts.push(encode(keys(f.params, inner)));
            parts.push(type_key(f.ret.get(), inner));
        },
        Type::Meta(_m) => kurs_error(text("cannot mangle an inference variable"), no_pos()),
    };
    encode(parts)
}

fn hex_value(b: u8) -> u8 {
    if b >= b'0' && b <= b'9' { b - b'0' } else { b - b'a' + 10u8 }
}

fn is_lower_hex(b: u8) -> bool {
    b >= b'0' && b <= b'9' || b >= b'a' && b <= b'f'
}

// The bytes a linker identity segment encodes: `m` or `d` and pairs of lowercase hex digits that
// spell UTF-8 text. Any other segment encodes nothing.
fn decode_segment(seg: Text) -> Option[Text] {
    if seg.len < 3usize || seg.len % 2usize == 0usize || seg.byte(0usize) != b'm' && seg.byte(0usize) != b'd' {
        return Option::None;
    }
    let out = Out::new();
    var i = 1usize;
    while i < seg.len {
        if !is_lower_hex(seg.byte(i)) || !is_lower_hex(seg.byte(i + 1usize)) {
            return Option::None;
        }
        let unit = out.byte(hex_value(seg.byte(i)) * 16u8 + hex_value(seg.byte(i + 1usize)));
        i = i + 2usize;
    }
    let bytes = out.done();
    if valid_utf8(bytes) { Option::Some.(bytes) } else { Option::None }
}

// `t` is well-formed UTF-8: no overlong forms, surrogates or code points past U+10FFFF.
fn valid_utf8(t: Text) -> bool {
    var i = 0usize;
    while i < t.len {
        let b = t.byte(i);
        let (count, low, high) = if b < 128u8 {
            (0usize, 128u8, 191u8)
        } else if b >= 194u8 && b <= 223u8 {
            (1usize, 128u8, 191u8)
        } else if b == 224u8 {
            (2usize, 160u8, 191u8)
        } else if b == 237u8 {
            (2usize, 128u8, 159u8)
        } else if b >= 225u8 && b <= 239u8 {
            (2usize, 128u8, 191u8)
        } else if b == 240u8 {
            (3usize, 144u8, 191u8)
        } else if b == 244u8 {
            (3usize, 128u8, 143u8)
        } else if b >= 241u8 && b <= 243u8 {
            (3usize, 128u8, 191u8)
        } else {
            return false;
        };
        if count > 0usize && i + count >= t.len {
            return false;
        }
        var k = 1usize;
        while k <= count {
            let c = t.byte(i + k);
            let (lo, hi) = if k == 1usize { (low, high) } else { (128u8, 191u8) };
            if c < lo || c > hi {
                return false;
            }
            k = k + 1usize;
        }
        i = i + 1usize + count;
    }
    true
}

// Decode linker segments for display, then escape bytes into C identifiers.
fn path_segments(name: Text) -> Seq[Text] {
    let parts: Seq[Text] = Seq::new();
    let pieces = name.split(text("::"));
    var i = 0usize;
    while i < pieces.len() {
        let part = match decode_segment(pieces.get(i)) {
            Option::Some(bytes) => bytes,
            Option::None => pieces.get(i),
        };
        // Escape underscores too, so punctuation cannot alias literal escapes.
        let out = Out::new();
        var j = 0usize;
        while j < part.len {
            let b = part.byte(j);
            if b >= b'0' && b <= b'9' || b >= b'A' && b <= b'Z' || b >= b'a' && b <= b'z' {
                let unit = out.byte(b);
            } else {
                let unit = hex_byte(out.put("_"), b);
            }
            j = j + 1usize;
        }
        parts.push(if part.is_empty() { text("_empty") } else { out.done() });
        i = i + 1usize;
    }
    parts
}

// `b` as two lowercase hex digits.
fn hex_byte(out: Out, b: u8) -> Out {
    let digits = text("0123456789abcdef");
    out.byte(digits.byte((b / 16u8) as usize)).byte(digits.byte((b % 16u8) as usize))
}

fn mangle(path: Seq[Text], identity: Text, salt: u64) -> Text {
    let framed = Seq::two(text("kurs"), identity);
    framed.push(number(salt));
    let digest = sha256_hex(encode(framed)).slice(0usize, 16usize);
    let parts: Seq[Text] = Seq::one(text("kurs"));
    parts.append(path);
    parts.push(Out::new().put("h").add(digest).done());
    let out = Out::new().put("_ZN");
    var i = 0usize;
    while i < parts.len() {
        let unit = out.usize(char_count(parts.get(i))).add(parts.get(i));
        i = i + 1usize;
    }
    out.put("E").done()
}

// ---------------------------------------------------------------- SHA-256 --

fn rotr(x: u32, n: u32) -> u32 {
    (x >> n) | (x << (32u32 - n))
}

fn round_constants() -> Seq[u32] {
    let k: Seq[u32] = Seq::new();
    push8(k, 1116352408u32, 1899447441u32, 3049323471u32, 3921009573u32, 961987163u32, 1508970993u32, 2453635748u32, 2870763221u32);
    push8(k, 3624381080u32, 310598401u32, 607225278u32, 1426881987u32, 1925078388u32, 2162078206u32, 2614888103u32, 3248222580u32);
    push8(k, 3835390401u32, 4022224774u32, 264347078u32, 604807628u32, 770255983u32, 1249150122u32, 1555081692u32, 1996064986u32);
    push8(k, 2554220882u32, 2821834349u32, 2952996808u32, 3210313671u32, 3336571891u32, 3584528711u32, 113926993u32, 338241895u32);
    push8(k, 666307205u32, 773529912u32, 1294757372u32, 1396182291u32, 1695183700u32, 1986661051u32, 2177026350u32, 2456956037u32);
    push8(k, 2730485921u32, 2820302411u32, 3259730800u32, 3345764771u32, 3516065817u32, 3600352804u32, 4094571909u32, 275423344u32);
    push8(k, 430227734u32, 506948616u32, 659060556u32, 883997877u32, 958139571u32, 1322822218u32, 1537002063u32, 1747873779u32);
    push8(k, 1955562222u32, 2024104815u32, 2227730452u32, 2361852424u32, 2428436474u32, 2756734187u32, 3204031479u32, 3329325298u32);
    k
}

fn push8(k: Seq[u32], a: u32, b: u32, c: u32, d: u32, e: u32, f: u32, g: u32, h: u32) {
    k.push(a);
    k.push(b);
    k.push(c);
    k.push(d);
    k.push(e);
    k.push(f);
    k.push(g);
    k.push(h);
}

// The SHA-256 digest of `data`, in lowercase hex.
fn sha256_hex(data: Text) -> Text {
    let k = round_constants();
    let h: Seq[u32] = Seq::new();
    push8(h, 1779033703u32, 3144134277u32, 1013904242u32, 2773480762u32, 1359893119u32, 2600822924u32, 528734635u32, 1541459225u32);
    let message: Seq[u8] = Seq::new();
    message.push_bytes(data.ptr, data.len);
    message.push(128u8);
    while message.len() % 64usize != 56usize {
        message.push(0u8);
    }
    let bits = (data.len as u64) * 8u64;
    var j = 0u64;
    while j < 8u64 {
        message.push(((bits >> (56u64 - 8u64 * j)) & 255u64) as u8);
        j = j + 1u64;
    }
    let w: Seq[u32] = Seq::new();
    var chunk = 0usize;
    while chunk < message.len() {
        w.clear();
        var t = 0usize;
        while t < 16usize {
            let at = chunk + t * 4usize;
            w.push(((message.get(at) as u32) << 24u32) | ((message.get(at + 1usize) as u32) << 16u32)
                | ((message.get(at + 2usize) as u32) << 8u32) | (message.get(at + 3usize) as u32));
            t = t + 1usize;
        }
        while t < 64usize {
            let x = w.get(t - 15usize);
            let y = w.get(t - 2usize);
            let s0 = rotr(x, 7u32) ^ rotr(x, 18u32) ^ (x >> 3u32);
            let s1 = rotr(y, 17u32) ^ rotr(y, 19u32) ^ (y >> 10u32);
            w.push(w.get(t - 16usize) + s0 + w.get(t - 7usize) + s1);
            t = t + 1usize;
        }
        var a = h.get(0usize);
        var b = h.get(1usize);
        var c = h.get(2usize);
        var d = h.get(3usize);
        var e = h.get(4usize);
        var f = h.get(5usize);
        var g = h.get(6usize);
        var hh = h.get(7usize);
        var r = 0usize;
        while r < 64usize {
            let big1 = rotr(e, 6u32) ^ rotr(e, 11u32) ^ rotr(e, 25u32);
            let choice = (e & f) ^ ((e ^ 4294967295u32) & g);
            let t1 = hh + big1 + choice + k.get(r) + w.get(r);
            let big0 = rotr(a, 2u32) ^ rotr(a, 13u32) ^ rotr(a, 22u32);
            let majority = (a & b) ^ (a & c) ^ (b & c);
            let t2 = big0 + majority;
            hh = g;
            g = f;
            f = e;
            e = d + t1;
            d = c;
            c = b;
            b = a;
            a = t1 + t2;
            r = r + 1usize;
        }
        h.set(0usize, h.get(0usize) + a);
        h.set(1usize, h.get(1usize) + b);
        h.set(2usize, h.get(2usize) + c);
        h.set(3usize, h.get(3usize) + d);
        h.set(4usize, h.get(4usize) + e);
        h.set(5usize, h.get(5usize) + f);
        h.set(6usize, h.get(6usize) + g);
        h.set(7usize, h.get(7usize) + hh);
        chunk = chunk + 64usize;
    }
    let out = Out::new();
    var i = 0usize;
    while i < 8usize {
        let word = h.get(i);
        let unit = hex_byte(hex_byte(hex_byte(hex_byte(out, (word >> 24u32) as u8), ((word >> 16u32) & 255u32) as u8), ((word >> 8u32) & 255u32) as u8), (word & 255u32) as u8);
        i = i + 1usize;
    }
    out.done()
}
