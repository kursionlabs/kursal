// The surface AST, as the parser builds it.
//
// Every node that a later phase annotates carries an `id`, unique in the program. Resolution,
// inference and lowering keep what they learn about a node in tables keyed by that id, so the tree
// itself never changes once parsed. Subtrees are held in cells (`Cell[Expr]`), which is what lets a
// node contain nodes of its own kind.

use package::support::base::{Cell, Seq, Text};
use std::option::Option;

// A source position: line and column, from 1. Line 0 is no position.
exposed struct Pos {
    line: u32,
    col: u32,
}

fn no_pos() -> Pos {
    Pos.{ line: 0u32, col: 0u32 }
}

// ------------------------------------------------------------------ types --

exposed enum Type {
    Name(TName),
    Ptr(Cell[Type]),
    Never,
    Tuple(Seq[Type]),
    Array(Cell[Type], Cell[Expr]),
    Fn(TFn),
    Closure(TClosure),
    Exists(Seq[Text], Cell[Type]),
    Foreach(TForeach),
    Forall(Seq[Text], Cell[Type]),
    Brand(Text),
    Ignored,
}

// `a::B!['k, T -> U]`: the `determined` last arguments were written after `->`.
exposed struct TName {
    id: u32,
    path: Seq[Text],
    linear: bool,
    args: Seq[Type],
    determined: usize,
}

// A slot of a function or closure type: whether it is a place, and its type.
exposed struct Slot {
    lend: bool,
    type: Type,
}

exposed struct TFn {
    params: Seq[Slot],
    ret: Cell[Type],
    is_unsafe: bool,
}

exposed struct TClosure {
    env: Option[Cell[Type]],
    params: Seq[Slot],
    ret: Cell[Type],
}

exposed struct TForeach {
    binder: Text,
    indirect: bool,
    source: Cell[Type],
    body: Cell[Type],
}

// ------------------------------------------------------------ expressions --

exposed enum Expr {
    Lit(Lit),
    FStr(FStr),
    Path(Path),
    Tuple(Node[Seq[Expr]]),
    Array(ArrayLit),
    Sizeof(Node[Type]),
    StructLit(StructLit),
    Block(Block),
    If(If),
    Match(Match),
    Closure(Closure),
    Return(Node[Option[Cell[Expr]]]),
    Pack(Pack),
    Foreach(Foreach),
    Binop(Binop),
    Unary(Unary),
    Cast(Cast),
    UnsafeStore(UnsafeStore),
    Field(Field),
    Index(Index),
    Call(Call),
    Try(Node[Cell[Expr]]),
    While(While),
    For(For),
}

// A node with one part and nothing else to say about it.
forall T.
exposed struct Node {
    id: u32,
    value: T,
    pos: Pos,
}

exposed enum LitKind {
    Int,
    Float,
    Str,
    Bool,
}

// A literal. An integer's value is its magnitude: the parser folds a minus sign only into the
// low and high values of a match case, and marks those `negative`. A float keeps its digits; a
// string keeps its unescaped bytes; a boolean is the integer 0 or 1.
exposed struct Lit {
    id: u32,
    kind: LitKind,
    int: u64,
    negative: bool,
    text: Text,
    suffix: Option[Text],
    pos: Pos,
}

// An f-string's pieces, in order: text, or an expression to format.
exposed enum Piece {
    Text(Text),
    Expr(Expr),
}

exposed struct FStr {
    id: u32,
    parts: Seq[Piece],
    pos: Pos,
}

// One segment of a path: a name, whether it was written `Name!`, and its type arguments.
exposed struct Segment {
    name: Text,
    linear: bool,
    args: Seq[Type],
}

exposed struct Path {
    id: u32,
    segments: Seq[Segment],
    pos: Pos,
}

impl Path {
    fn names(self) -> Seq[Text] {
        let names: Seq[Text] = Seq::new();
        var i = 0usize;
        while i < self.segments.len() {
            names.push(self.segments.get(i).name);
            i = i + 1usize;
        }
        names
    }
}

// `[a, b]`, or `[a, b, ..]`, which repeats the last element.
exposed struct ArrayLit {
    id: u32,
    elems: Seq[Expr],
    fill: bool,
    pos: Pos,
}

// A field of a struct literal; `value` is none for the shorthand `Point.{ x }`.
exposed struct FieldInit {
    name: Text,
    value: Option[Expr],
}

exposed struct StructLit {
    id: u32,
    path: Path,
    fields: Seq[FieldInit],
    spread: Option[Text],
    pos: Pos,
}

exposed struct Block {
    id: u32,
    stmts: Seq[Statement],
    tail: Option[Cell[Expr]],
    pos: Pos,
}

exposed struct If {
    id: u32,
    cond: Cell[Expr],
    then: Block,
    // A block, or an `else if`.
    other: Option[Cell[Expr]],
    pos: Pos,
}

exposed enum CaseKind {
    Variant,
    Wild,
    Value,
}

// An arm's alternative. A variant case's binders are none when no parentheses were written; a `_`
// binder is the empty text. A value case covers `low` to `high`.
exposed struct Case {
    id: u32,
    kind: CaseKind,
    path: Option[Path],
    binders: Option[Seq[Text]],
    low: Option[Lit],
    high: Option[Lit],
    pos: Pos,
}

exposed struct Arm {
    cases: Seq[Case],
    body: Expr,
    pos: Pos,
}

exposed struct Match {
    id: u32,
    scrutinee: Cell[Expr],
    arms: Seq[Arm],
    pos: Pos,
}

exposed struct ClosureParam {
    lend: bool,
    name: Text,
    type: Option[Type],
}

exposed struct Closure {
    id: u32,
    params: Seq[ClosureParam],
    ret: Option[Type],
    body: Cell[Expr],
    pos: Pos,
}

exposed struct Pack {
    id: u32,
    brands: Seq[Text],
    value: Cell[Expr],
    pos: Pos,
}

exposed struct Foreach {
    id: u32,
    name: Text,
    binder: Option[Text],
    source: Cell[Expr],
    body: Block,
    pos: Pos,
}

exposed struct Binop {
    id: u32,
    op: Text,
    left: Cell[Expr],
    right: Cell[Expr],
    pos: Pos,
}

// `-`, `!`, `*`, `&` or `unsafe`.
exposed struct Unary {
    id: u32,
    op: Text,
    operand: Cell[Expr],
    pos: Pos,
}

exposed struct Cast {
    id: u32,
    value: Cell[Expr],
    type: Type,
    pos: Pos,
}

exposed struct UnsafeStore {
    id: u32,
    pointer: Cell[Expr],
    value: Cell[Expr],
    pos: Pos,
}

exposed struct Field {
    id: u32,
    value: Cell[Expr],
    name: Text,
    pos: Pos,
}

exposed struct Index {
    id: u32,
    value: Cell[Expr],
    index: usize,
    pos: Pos,
}

exposed struct Call {
    id: u32,
    callee: Cell[Expr],
    args: Seq[Expr],
    pos: Pos,
}

exposed struct While {
    id: u32,
    cond: Cell[Expr],
    body: Block,
    pos: Pos,
}

exposed struct For {
    id: u32,
    name: Text,
    iterator: Cell[Expr],
    body: Block,
    pos: Pos,
}

// The id and position of any expression.
fn expr_id(e: Expr) -> u32 {
    match e {
        Expr::Lit(n) => n.id,
        Expr::FStr(n) => n.id,
        Expr::Path(n) => n.id,
        Expr::Tuple(n) => n.id,
        Expr::Array(n) => n.id,
        Expr::Sizeof(n) => n.id,
        Expr::StructLit(n) => n.id,
        Expr::Block(n) => n.id,
        Expr::If(n) => n.id,
        Expr::Match(n) => n.id,
        Expr::Closure(n) => n.id,
        Expr::Return(n) => n.id,
        Expr::Pack(n) => n.id,
        Expr::Foreach(n) => n.id,
        Expr::Binop(n) => n.id,
        Expr::Unary(n) => n.id,
        Expr::Cast(n) => n.id,
        Expr::UnsafeStore(n) => n.id,
        Expr::Field(n) => n.id,
        Expr::Index(n) => n.id,
        Expr::Call(n) => n.id,
        Expr::Try(n) => n.id,
        Expr::While(n) => n.id,
        Expr::For(n) => n.id,
    }
}

fn expr_pos(e: Expr) -> Pos {
    match e {
        Expr::Lit(n) => n.pos,
        Expr::FStr(n) => n.pos,
        Expr::Path(n) => n.pos,
        Expr::Tuple(n) => n.pos,
        Expr::Array(n) => n.pos,
        Expr::Sizeof(n) => n.pos,
        Expr::StructLit(n) => n.pos,
        Expr::Block(n) => n.pos,
        Expr::If(n) => n.pos,
        Expr::Match(n) => n.pos,
        Expr::Closure(n) => n.pos,
        Expr::Return(n) => n.pos,
        Expr::Pack(n) => n.pos,
        Expr::Foreach(n) => n.pos,
        Expr::Binop(n) => n.pos,
        Expr::Unary(n) => n.pos,
        Expr::Cast(n) => n.pos,
        Expr::UnsafeStore(n) => n.pos,
        Expr::Field(n) => n.pos,
        Expr::Index(n) => n.pos,
        Expr::Call(n) => n.pos,
        Expr::Try(n) => n.pos,
        Expr::While(n) => n.pos,
        Expr::For(n) => n.pos,
    }
}

// ----------------------------------------------------- statements, patterns --

exposed enum Statement {
    Let(Let),
    Var(Var),
    Assign(Assign),
    Expr(Node[Expr]),
    Const(Const),
}

exposed struct Let {
    id: u32,
    pattern: Pattern,
    type: Option[Type],
    value: Expr,
    // `let exists 'a. ...`
    brands: Seq[Text],
    pos: Pos,
}

exposed struct Var {
    id: u32,
    name: Text,
    type: Option[Type],
    value: Expr,
    pos: Pos,
}

exposed struct Assign {
    target: Expr,
    value: Expr,
    pos: Pos,
}

exposed enum Pattern {
    Bind(Node[Text]),
    Wild(u32),
    Tuple(Node[Seq[Pattern]]),
    Array(Node[Seq[Pattern]]),
    Struct(PStruct),
}

exposed struct FieldPattern {
    name: Text,
    pattern: Pattern,
}

exposed struct PStruct {
    id: u32,
    fields: Seq[FieldPattern],
    rest: Option[Text],
}

fn pattern_id(p: Pattern) -> u32 {
    match p {
        Pattern::Bind(n) => n.id,
        Pattern::Wild(id) => id,
        Pattern::Tuple(n) => n.id,
        Pattern::Array(n) => n.id,
        Pattern::Struct(n) => n.id,
    }
}

// ------------------------------------------------------------------ items --

// `forall T, 'k -> U where Trait[T, U].`; brand parameters keep their quote.
exposed struct Forall {
    params: Seq[Text],
    determined: Seq[Text],
    premises: Seq[Premise],
}

exposed struct Premise {
    trait_path: Seq[Text],
    args: TypeArgs,
}

// Type arguments, the `determined` last of them written after `->`.
exposed struct TypeArgs {
    id: u32,
    args: Seq[Type],
    determined: usize,
}

exposed struct Param {
    name: Text,
    type: Option[Type],
    // written `&name: T` or `&self`
    lend: bool,
}

// `a::b::{c, d as e}` or `a::*`. `children` is empty unless braces were written.
exposed struct UseTree {
    path: Seq[Text],
    star: bool,
    children: Seq[UseTree],
    alias: Option[Text],
}

// `exposed`, or `exposed(scope)`; a declaration without one is restricted to its module.
exposed struct Exposed {
    scope: Option[Seq[Text]],
}

exposed enum Item {
    Use(UseItem),
    Module(Node[Seq[Text]]),
    Struct(StructDecl),
    Tuple(TupleDecl),
    Enum(EnumDecl),
    Fn(Fn),
    Extern(Extern),
    Const(Const),
    Impl(Impl),
    Trait(TraitDecl),
    Instance(InstanceDecl),
}

exposed struct UseItem {
    tree: UseTree,
    is_export: bool,
    quantifier: Option[Forall],
    pos: Pos,
}

exposed struct FieldDecl {
    name: Text,
    type: Type,
}

exposed struct StructDecl {
    id: u32,
    name: Text,
    linear: bool,
    fields: Seq[FieldDecl],
    exposure: Option[Exposed],
    quantifier: Option[Forall],
    pos: Pos,
}

exposed struct TupleDecl {
    id: u32,
    name: Text,
    linear: bool,
    elems: Seq[Type],
    exposure: Option[Exposed],
    quantifier: Option[Forall],
    pos: Pos,
}

exposed struct Variant {
    name: Text,
    payload: Seq[Type],
}

exposed struct EnumDecl {
    id: u32,
    name: Text,
    linear: bool,
    variants: Seq[Variant],
    exposure: Option[Exposed],
    quantifier: Option[Forall],
    pos: Pos,
}

// A function; without a body, a trait method's signature.
exposed struct Fn {
    id: u32,
    name: Text,
    params: Seq[Param],
    ret: Option[Type],
    body: Option[Block],
    is_unsafe: bool,
    quantifier: Option[Forall],
    pos: Pos,
}

exposed struct Extern {
    id: u32,
    abi: Text,
    name: Text,
    params: Seq[Param],
    ret: Option[Type],
    quantifier: Option[Forall],
    pos: Pos,
}

exposed struct Const {
    id: u32,
    name: Text,
    type: Type,
    value: Expr,
    quantifier: Option[Forall],
    pos: Pos,
}

// A member of an `impl`: a function or a constant.
exposed enum Member {
    Fn(Fn),
    Const(Const),
}

exposed struct Impl {
    id: u32,
    type: Type,
    items: Seq[Member],
    quantifier: Option[Forall],
    pos: Pos,
}

exposed struct TraitDecl {
    id: u32,
    name: Text,
    methods: Seq[Fn],
    quantifier: Option[Forall],
    pos: Pos,
}

exposed struct InstanceDecl {
    id: u32,
    type: Type,
    methods: Seq[Fn],
    is_unsafe: bool,
    quantifier: Option[Forall],
    pos: Pos,
}
