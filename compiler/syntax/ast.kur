// The surface AST, as the parser builds it.
//
// Every node that a later phase annotates carries an `id`, unique in the program. Resolution,
// inference and lowering keep what they learn about a node in tables keyed by that id, so the tree
// itself never changes once parsed. Subtrees are held in cells (`Ref[Expr]`), which is what lets a
// node contain nodes of its own kind.

use std::collections::arena_vec::ArenaVec;
use std::mem::Ref;
use std::raw::Span;
use std::alloc::arena::Domain;
use std::option::Option;

// A source position: line and column, from 1. Line 0 is no position.
exposed struct Pos {
    line: u32,
    col: u32,
}

fn no_pos() -> Pos {
    Pos.{ line: 0u32, col: 0u32 }
}

// ------------------------------------------------------------------ types --

forall 'k.
exposed enum Type {
    Name(TName['k]),
    Ptr(Ref[Type['k], 'k]),
    Never,
    Tuple(ArenaVec[Type['k], 'k]),
    Array(Ref[Type['k], 'k], Ref[Expr['k], 'k]),
    Fn(TFn['k]),
    Closure(TClosure['k]),
    Exists(ArenaVec[Span['k], 'k], Ref[Type['k], 'k]),
    Foreach(TForeach['k]),
    Forall(ArenaVec[Span['k], 'k], Ref[Type['k], 'k]),
    Brand(Span['k]),
    Ignored,
}

// `a::B!['k, T -> U]`: the `determined` last arguments were written after `->`.
forall 'k.
exposed struct TName {
    id: u32,
    path: ArenaVec[Span['k], 'k],
    linear: bool,
    args: ArenaVec[Type['k], 'k],
    determined: usize,
}

// A slot of a function or closure type: whether it is a place, and its type.
forall 'k.
exposed struct Slot {
    lend: bool,
    type: Type['k],
}

forall 'k.
exposed struct TFn {
    params: ArenaVec[Slot['k], 'k],
    ret: Ref[Type['k], 'k],
    is_unsafe: bool,
}

forall 'k.
exposed struct TClosure {
    env: Option[Ref[Type['k], 'k]],
    params: ArenaVec[Slot['k], 'k],
    ret: Ref[Type['k], 'k],
}

forall 'k.
exposed struct TForeach {
    binder: Span['k],
    indirect: bool,
    source: Ref[Type['k], 'k],
    body: Ref[Type['k], 'k],
}

// ------------------------------------------------------------ expressions --

forall 'k.
exposed enum Expr {
    Lit(Lit['k]),
    FStr(FStr['k]),
    Path(Path['k]),
    Tuple(Node[ArenaVec[Expr['k], 'k]]),
    Array(ArrayLit['k]),
    Sizeof(Node[Type['k]]),
    StructLit(StructLit['k]),
    Block(Block['k]),
    If(If['k]),
    Match(Match['k]),
    Closure(Closure['k]),
    Return(Node[Option[Ref[Expr['k], 'k]]]),
    Pack(Pack['k]),
    Foreach(Foreach['k]),
    Binop(Binop['k]),
    Unary(Unary['k]),
    Cast(Cast['k]),
    UnsafeStore(UnsafeStore['k]),
    Field(Field['k]),
    Index(Index['k]),
    Call(Call['k]),
    Try(Node[Ref[Expr['k], 'k]]),
    While(While['k]),
    For(For['k]),
}

// A node with one part and nothing else to say about it.
forall T.
exposed struct Node {
    id: u32,
    value: T,
    pos: Pos,
}

exposed enum LitKind {
    Int,
    Float,
    Str,
    Bool,
}

// A literal. An integer's value is its magnitude: the parser folds a minus sign only into the
// low and high values of a match case, and marks those `negative`. A float keeps its digits; a
// string keeps its unescaped bytes; a boolean is the integer 0 or 1.
forall 'k.
exposed struct Lit {
    id: u32,
    kind: LitKind,
    int: u64,
    negative: bool,
    text: Span['k],
    suffix: Option[Span['k]],
    pos: Pos,
}

// An f-string's pieces, in order: text, or an expression to format.
forall 'k.
exposed enum Piece {
    Text(Span['k]),
    Expr(Expr['k]),
}

forall 'k.
exposed struct FStr {
    id: u32,
    parts: ArenaVec[Piece['k], 'k],
    pos: Pos,
}

// One segment of a path: a name, whether it was written `Name!`, and its type arguments.
forall 'k.
exposed struct Segment {
    name: Span['k],
    linear: bool,
    args: ArenaVec[Type['k], 'k],
}

forall 'k.
exposed struct Path {
    id: u32,
    segments: ArenaVec[Segment['k], 'k],
    pos: Pos,
}

forall 'k.
impl Path['k] {
    fn names(self, &cx: Domain!['k]) -> ArenaVec[Span['k], 'k] {
        let names: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
        var i = 0usize;
        while i < self.segments.len(&cx) {
            names.push(&cx, self.segments.at(&cx, i).name);
            i = i + 1usize;
        }
        names
    }
}

// `[a, b]`, or `[a, b, ..]`, which repeats the last element.
forall 'k.
exposed struct ArrayLit {
    id: u32,
    elems: ArenaVec[Expr['k], 'k],
    fill: bool,
    pos: Pos,
}

// A field of a struct literal; `value` is none for the shorthand `Point.{ x }`.
forall 'k.
exposed struct FieldInit {
    name: Span['k],
    value: Option[Expr['k]],
}

forall 'k.
exposed struct StructLit {
    id: u32,
    path: Path['k],
    fields: ArenaVec[FieldInit['k], 'k],
    spread: Option[Span['k]],
    pos: Pos,
}

forall 'k.
exposed struct Block {
    id: u32,
    stmts: ArenaVec[Statement['k], 'k],
    tail: Option[Ref[Expr['k], 'k]],
    pos: Pos,
}

forall 'k.
exposed struct If {
    id: u32,
    cond: Ref[Expr['k], 'k],
    then: Block['k],
    // A block, or an `else if`.
    other: Option[Ref[Expr['k], 'k]],
    pos: Pos,
}

exposed enum CaseKind {
    Variant,
    Wild,
    Value,
}

// An arm's alternative. A variant case's binders are none when no parentheses were written; a `_`
// binder is the empty text. A value case covers `low` to `high`.
forall 'k.
exposed struct Case {
    id: u32,
    kind: CaseKind,
    path: Option[Path['k]],
    binders: Option[ArenaVec[Span['k], 'k]],
    low: Option[Lit['k]],
    high: Option[Lit['k]],
    pos: Pos,
}

forall 'k.
exposed struct Arm {
    cases: ArenaVec[Case['k], 'k],
    body: Expr['k],
    pos: Pos,
}

forall 'k.
exposed struct Match {
    id: u32,
    scrutinee: Ref[Expr['k], 'k],
    arms: ArenaVec[Arm['k], 'k],
    pos: Pos,
}

forall 'k.
exposed struct ClosureParam {
    lend: bool,
    name: Span['k],
    type: Option[Type['k]],
}

forall 'k.
exposed struct Closure {
    id: u32,
    params: ArenaVec[ClosureParam['k], 'k],
    ret: Option[Type['k]],
    body: Ref[Expr['k], 'k],
    pos: Pos,
}

forall 'k.
exposed struct Pack {
    id: u32,
    brands: ArenaVec[Span['k], 'k],
    value: Ref[Expr['k], 'k],
    pos: Pos,
}

forall 'k.
exposed struct Foreach {
    id: u32,
    name: Span['k],
    binder: Option[Span['k]],
    source: Ref[Expr['k], 'k],
    body: Block['k],
    pos: Pos,
}

forall 'k.
exposed struct Binop {
    id: u32,
    op: Span['k],
    left: Ref[Expr['k], 'k],
    right: Ref[Expr['k], 'k],
    pos: Pos,
}

// `-`, `!`, `*`, `&` or `unsafe`.
forall 'k.
exposed struct Unary {
    id: u32,
    op: Span['k],
    operand: Ref[Expr['k], 'k],
    pos: Pos,
}

forall 'k.
exposed struct Cast {
    id: u32,
    value: Ref[Expr['k], 'k],
    type: Type['k],
    pos: Pos,
}

forall 'k.
exposed struct UnsafeStore {
    id: u32,
    pointer: Ref[Expr['k], 'k],
    value: Ref[Expr['k], 'k],
    pos: Pos,
}

forall 'k.
exposed struct Field {
    id: u32,
    value: Ref[Expr['k], 'k],
    name: Span['k],
    pos: Pos,
}

forall 'k.
exposed struct Index {
    id: u32,
    value: Ref[Expr['k], 'k],
    index: usize,
    pos: Pos,
}

forall 'k.
exposed struct Call {
    id: u32,
    callee: Ref[Expr['k], 'k],
    args: ArenaVec[Expr['k], 'k],
    pos: Pos,
}

forall 'k.
exposed struct While {
    id: u32,
    cond: Ref[Expr['k], 'k],
    body: Block['k],
    pos: Pos,
}

forall 'k.
exposed struct For {
    id: u32,
    name: Span['k],
    iterator: Ref[Expr['k], 'k],
    body: Block['k],
    pos: Pos,
}

// The id and position of any expression.
forall 'k.
fn expr_id(e: Expr['k]) -> u32 {
    match e {
        Expr::Lit(n) => n.id,
        Expr::FStr(n) => n.id,
        Expr::Path(n) => n.id,
        Expr::Tuple(n) => n.id,
        Expr::Array(n) => n.id,
        Expr::Sizeof(n) => n.id,
        Expr::StructLit(n) => n.id,
        Expr::Block(n) => n.id,
        Expr::If(n) => n.id,
        Expr::Match(n) => n.id,
        Expr::Closure(n) => n.id,
        Expr::Return(n) => n.id,
        Expr::Pack(n) => n.id,
        Expr::Foreach(n) => n.id,
        Expr::Binop(n) => n.id,
        Expr::Unary(n) => n.id,
        Expr::Cast(n) => n.id,
        Expr::UnsafeStore(n) => n.id,
        Expr::Field(n) => n.id,
        Expr::Index(n) => n.id,
        Expr::Call(n) => n.id,
        Expr::Try(n) => n.id,
        Expr::While(n) => n.id,
        Expr::For(n) => n.id,
    }
}

forall 'k.
fn expr_pos(e: Expr['k]) -> Pos {
    match e {
        Expr::Lit(n) => n.pos,
        Expr::FStr(n) => n.pos,
        Expr::Path(n) => n.pos,
        Expr::Tuple(n) => n.pos,
        Expr::Array(n) => n.pos,
        Expr::Sizeof(n) => n.pos,
        Expr::StructLit(n) => n.pos,
        Expr::Block(n) => n.pos,
        Expr::If(n) => n.pos,
        Expr::Match(n) => n.pos,
        Expr::Closure(n) => n.pos,
        Expr::Return(n) => n.pos,
        Expr::Pack(n) => n.pos,
        Expr::Foreach(n) => n.pos,
        Expr::Binop(n) => n.pos,
        Expr::Unary(n) => n.pos,
        Expr::Cast(n) => n.pos,
        Expr::UnsafeStore(n) => n.pos,
        Expr::Field(n) => n.pos,
        Expr::Index(n) => n.pos,
        Expr::Call(n) => n.pos,
        Expr::Try(n) => n.pos,
        Expr::While(n) => n.pos,
        Expr::For(n) => n.pos,
    }
}

// ----------------------------------------------------- statements, patterns --

forall 'k.
exposed enum Statement {
    Let(Let['k]),
    Var(Var['k]),
    Assign(Assign['k]),
    Expr(Node[Expr['k]]),
    Const(Const['k]),
}

forall 'k.
exposed struct Let {
    id: u32,
    pattern: Pattern['k],
    type: Option[Type['k]],
    value: Expr['k],
    // `let exists 'a. ...`
    brands: ArenaVec[Span['k], 'k],
    pos: Pos,
}

forall 'k.
exposed struct Var {
    id: u32,
    name: Span['k],
    type: Option[Type['k]],
    value: Expr['k],
    pos: Pos,
}

forall 'k.
exposed struct Assign {
    target: Expr['k],
    value: Expr['k],
    pos: Pos,
}

forall 'k.
exposed enum Pattern {
    Bind(Node[Span['k]]),
    Wild(u32),
    Tuple(Node[ArenaVec[Pattern['k], 'k]]),
    Array(Node[ArenaVec[Pattern['k], 'k]]),
    Struct(PStruct['k]),
}

forall 'k.
exposed struct FieldPattern {
    name: Span['k],
    pattern: Pattern['k],
}

forall 'k.
exposed struct PStruct {
    id: u32,
    fields: ArenaVec[FieldPattern['k], 'k],
    rest: Option[Span['k]],
}

forall 'k.
fn pattern_id(p: Pattern['k]) -> u32 {
    match p {
        Pattern::Bind(n) => n.id,
        Pattern::Wild(id) => id,
        Pattern::Tuple(n) => n.id,
        Pattern::Array(n) => n.id,
        Pattern::Struct(n) => n.id,
    }
}

// ------------------------------------------------------------------ items --

// `forall T, 'k -> U where Trait[T, U].`; brand parameters keep their quote.
forall 'k.
exposed struct Forall {
    params: ArenaVec[Span['k], 'k],
    determined: ArenaVec[Span['k], 'k],
    premises: ArenaVec[Premise['k], 'k],
}

forall 'k.
exposed struct Premise {
    trait_path: ArenaVec[Span['k], 'k],
    args: TypeArgs['k],
}

// Type arguments, the `determined` last of them written after `->`.
forall 'k.
exposed struct TypeArgs {
    id: u32,
    args: ArenaVec[Type['k], 'k],
    determined: usize,
}

forall 'k.
exposed struct Param {
    name: Span['k],
    type: Option[Type['k]],
    // written `&name: T` or `&self`
    lend: bool,
}

// `a::b::{c, d as e}` or `a::*`. `children` is empty unless braces were written.
forall 'k.
exposed struct UseTree {
    path: ArenaVec[Span['k], 'k],
    star: bool,
    children: ArenaVec[UseTree['k], 'k],
    alias: Option[Span['k]],
}

// `exposed`, or `exposed(scope)`; a declaration without one is restricted to its module.
forall 'k.
exposed struct Exposed {
    scope: Option[ArenaVec[Span['k], 'k]],
}

forall 'k.
exposed enum Item {
    Use(UseItem['k]),
    Module(Node[ArenaVec[Span['k], 'k]]),
    Struct(StructDecl['k]),
    Tuple(TupleDecl['k]),
    Enum(EnumDecl['k]),
    Fn(Fn['k]),
    Extern(Extern['k]),
    Const(Const['k]),
    Impl(Impl['k]),
    Trait(TraitDecl['k]),
    Instance(InstanceDecl['k]),
}

forall 'k.
exposed struct UseItem {
    tree: UseTree['k],
    is_export: bool,
    quantifier: Option[Forall['k]],
    pos: Pos,
}

forall 'k.
exposed struct FieldDecl {
    name: Span['k],
    type: Type['k],
}

forall 'k.
exposed struct StructDecl {
    id: u32,
    name: Span['k],
    linear: bool,
    fields: ArenaVec[FieldDecl['k], 'k],
    exposure: Option[Exposed['k]],
    quantifier: Option[Forall['k]],
    pos: Pos,
}

forall 'k.
exposed struct TupleDecl {
    id: u32,
    name: Span['k],
    linear: bool,
    elems: ArenaVec[Type['k], 'k],
    exposure: Option[Exposed['k]],
    quantifier: Option[Forall['k]],
    pos: Pos,
}

forall 'k.
exposed struct Variant {
    name: Span['k],
    payload: ArenaVec[Type['k], 'k],
}

forall 'k.
exposed struct EnumDecl {
    id: u32,
    name: Span['k],
    linear: bool,
    variants: ArenaVec[Variant['k], 'k],
    exposure: Option[Exposed['k]],
    quantifier: Option[Forall['k]],
    pos: Pos,
}

// A function; without a body, a trait method's signature.
forall 'k.
exposed struct Fn {
    id: u32,
    name: Span['k],
    params: ArenaVec[Param['k], 'k],
    ret: Option[Type['k]],
    body: Option[Block['k]],
    is_unsafe: bool,
    quantifier: Option[Forall['k]],
    pos: Pos,
}

forall 'k.
exposed struct Extern {
    id: u32,
    abi: Span['k],
    name: Span['k],
    params: ArenaVec[Param['k], 'k],
    ret: Option[Type['k]],
    quantifier: Option[Forall['k]],
    pos: Pos,
}

forall 'k.
exposed struct Const {
    id: u32,
    name: Span['k],
    type: Type['k],
    value: Expr['k],
    quantifier: Option[Forall['k]],
    pos: Pos,
}

// A member of an `impl`: a function or a constant.
forall 'k.
exposed enum Member {
    Fn(Fn['k]),
    Const(Const['k]),
}

forall 'k.
exposed struct Impl {
    id: u32,
    type: Type['k],
    items: ArenaVec[Member['k], 'k],
    quantifier: Option[Forall['k]],
    pos: Pos,
}

forall 'k.
exposed struct TraitDecl {
    id: u32,
    name: Span['k],
    methods: ArenaVec[Fn['k], 'k],
    quantifier: Option[Forall['k]],
    pos: Pos,
}

forall 'k.
exposed struct InstanceDecl {
    id: u32,
    type: Type['k],
    methods: ArenaVec[Fn['k], 'k],
    is_unsafe: bool,
    quantifier: Option[Forall['k]],
    pos: Pos,
}
