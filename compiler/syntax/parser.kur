// A hand-written recursive-descent parser for Kursal source, building the AST of `syntax`.
//
// The grammar is LL(1): the current token alone decides every choice. The parser never looks
// further ahead and never backtracks. Errors stop the compiler with the file, line and column.

use package::support::base::fail;
use std::parse::parse_u64;
use std::collections::arena_vec::ArenaVec;
use std::mem::Ref;
use std::raw::Span;
use std::alloc::arena::Domain;
use std::bytes::buffer::Buffer;
use package::syntax::ast as S;
use package::syntax::ast::{Expr, Pos, Statement, Type};
use std::slice::Slice;
use std::option::Option;

// Every keyword, each between spaces.
forall 'k.
fn keywords(&cx: Domain!['k]) -> Span['k] {
    Span::from_static(&cx, " use export module struct tuple enum fn extern impl trait instance const forall where as exposed unsafe closure exists foreach of in for while if else match let var return pack sizeof true false self _ ")
}
// ------------------------------------------------------------------ lexer --

// A token: its kind (a keyword or operator is its own text; otherwise NAME, INT, FLOAT, BYTE,
// STRING, BRAND, TUPLE_INDEX, the f-string kinds, or EOF), its text and position.
forall 'k.
exposed struct Tok {
    kind: Span['k],
    text: Span['k],
    line: u32,
    col: u32,
}

forall 'k.
exposed struct Lexer {
    source: Span['k],
    file: Span['k],
    i: Ref[usize, 'k],
    // The offset where each line starts.
    lines: ArenaVec[usize, 'k],
    out: ArenaVec[Tok['k], 'k],
}

fn is_digit(b: u8) -> bool {
    b >= b'0' && b <= b'9'
}

fn is_hex(b: u8) -> bool {
    is_digit(b) || (b >= b'a' && b <= b'f') || (b >= b'A' && b <= b'F')
}

fn is_space(b: u8) -> bool {
    b == b' ' || b == b'\n' || b == b'\t' || b == b'\r' || b == 11u8 || b == 12u8
}

// A byte that can start a name: a letter, `_`, or any byte of a non-ASCII character.
fn is_name_start(b: u8) -> bool {
    (b >= b'a' && b <= b'z') || (b >= b'A' && b <= b'Z') || b == b'_' || b >= 128u8
}

fn is_name_byte(b: u8) -> bool {
    is_name_start(b) || is_digit(b)
}

forall 'k.
fn is_keyword(&cx: Domain!['k], word: Span['k]) -> bool {
    keywords(&cx).contains(&cx, Buffer::new().push_static(" ").push_bytes(&cx, word).push_static(" ").save(&cx))
}

forall 'k.
impl Lexer['k] {
    fn new(&cx: Domain!['k], source: Span['k], file: Span['k]) -> Lexer['k] {
        let lines: ArenaVec[usize, 'k] = ArenaVec::one(&cx, 0usize);
        var i = 0usize;
        while i < source.len() {
            if source.byte_or_zero(&cx, i) == b'\n' {
                lines.push(&cx, i + 1usize);
            }
            i = i + 1usize;
        }
        Lexer.{ source, file, i: Ref::new(&cx, 0usize), lines, out: ArenaVec::new(&cx) }
    }

    fn at(self, &cx: Domain!['k]) -> usize {
        self.i.copy(&cx)
    }

    fn byte(self, &cx: Domain!['k], offset: usize) -> u8 {
        self.source.byte_or_zero(&cx, offset)
    }

    // The line and column of `offset`; the column counts characters, not bytes.
    fn loc(self, &cx: Domain!['k], offset: usize) -> (u32, u32) {
        var lo = 0usize;
        var hi = self.lines.len(&cx);
        while lo + 1usize < hi {
            let mid = (lo + hi) / 2usize;
            if self.lines.at(&cx, mid) <= offset {
                lo = mid;
            } else {
                hi = mid;
            }
        }
        var col = 1u32;
        var k = self.lines.at(&cx, lo);
        while k < offset {
            if (self.byte(&cx, k) & 192u8) != 128u8 {
                col = col + 1u32;
            }
            k = k + 1usize;
        }
        ((lo + 1usize) as u32, col)
    }

    fn token(self, &cx: Domain!['k], kind: Span['k], word: Span['k], start: usize) {
        let (line, col) = self.loc(&cx, start);
        self.out.push(&cx, Tok.{ kind, text: word, line, col });
    }

    fn fail_at(self, &cx: Domain!['k], offset: usize) -> ! {
        let (line, col) = self.loc(&cx, offset);
        fail(&cx, Buffer::new().push_bytes(&cx, self.file).push_static(":").push_u64(line as u64).push_static(":").push_u64(col as u64).push_static(": syntax error").save(&cx))
    }

    fn run(self, &cx: Domain!['k]) -> ArenaVec[Tok['k], 'k] {
        let unit = self.expression(&cx, false);
        self.token(&cx, Span::from_static(&cx, "EOF"), Span::from_static(&cx, ""), self.source.len());
        self.out
    }

    // Tokens up to the end of the text; in an interpolation, up to its closing `}`, whose offset is
    // returned.
    fn expression(self, &cx: Domain!['k], nested: bool) -> usize {
        var depth = 0usize;
        var closing = Option::None;
        while closing.is_none() {
            let start = self.at(&cx);
            if start >= self.source.len() {
                if nested {
                    fail(&cx, Span::from_static(&cx, "unterminated f-string interpolation"));
                }
                closing = Option::Some.(start);
            } else if self.skip_blank(&cx, start) {
                ()
            } else {
                let (kind, end) = self.scan(&cx, start);
                self.i.set(&cx, end);
                let word = self.source.slice(start, end);
                if kind.is(&cx, "FSTRING_START") {
                    self.token(&cx, kind, word, start);
                    self.fstring(&cx);
                } else if kind.is(&cx, "NAME") && is_keyword(&cx, word) {
                    self.token(&cx, word, word, start);
                } else if kind.is(&cx, "OP") {
                    if nested && (word.is(&cx, "{") || word.is(&cx, ".{")) {
                        depth = depth + 1usize;
                        self.token(&cx, word, word, start);
                    } else if nested && word.is(&cx, "}") {
                        if depth == 0usize {
                            closing = Option::Some.(start);
                        } else {
                            depth = depth - 1usize;
                            self.token(&cx, word, word, start);
                        }
                    } else {
                        self.token(&cx, word, word, start);
                    }
                } else {
                    self.token(&cx, kind, word, start);
                }
            }
        }
        closing.unwrap_or(0usize)
    }

    // Skips whitespace or a comment at `start`, if there is one there.
    fn skip_blank(self, &cx: Domain!['k], start: usize) -> bool {
        let b = self.byte(&cx, start);
        if is_space(b) {
            var i = start;
            while i < self.source.len() && is_space(self.byte(&cx, i)) {
                i = i + 1usize;
            }
            self.i.set(&cx, i);
            true
        } else if b == b'/' && self.byte(&cx, start + 1usize) == b'/' {
            var i = start;
            while i < self.source.len() && self.byte(&cx, i) != b'\n' {
                i = i + 1usize;
            }
            self.i.set(&cx, i);
            true
        } else if b == b'/' && self.byte(&cx, start + 1usize) == b'*' {
            match self.source.find(&cx, Span::from_static(&cx, "*/"), start + 2usize) {
                Option::Some(end) => {
                    self.i.set(&cx, end + 2usize);
                    true
                },
                Option::None => false,
            }
        } else {
            false
        }
    }

    // The kind of the token at `start` and the offset where it ends.
    fn scan(self, &cx: Domain!['k], start: usize) -> (Span['k], usize) {
        let b = self.byte(&cx, start);
        let next = self.byte(&cx, start + 1usize);
        if b == b'f' && next == b'"' {
            return (Span::from_static(&cx, "FSTRING_START"), start + 2usize);
        }
        if b == b'b' && next == b'\'' {
            match self.byte_literal(&cx, start + 2usize) {
                Option::Some(end) => {
                    return (Span::from_static(&cx, "BYTE"), end);
                },
                Option::None => (),
            }
        }
        if b == b'"' {
            match self.string_end(&cx, start + 1usize) {
                Option::Some(end) => {
                    return (Span::from_static(&cx, "STRING"), end);
                },
                Option::None => (),
            }
        }
        if b == b'\'' && self.is_brand_byte(next) {
            var i = start + 1usize;
            while self.is_brand_byte(self.byte(&cx, i)) {
                i = i + 1usize;
            }
            return (Span::from_static(&cx, "BRAND"), i);
        }
        if is_digit(b) {
            return self.number(&cx, start);
        }
        if b == b'.' && is_digit(next) {
            var i = start + 1usize;
            while is_digit(self.byte(&cx, i)) {
                i = i + 1usize;
            }
            return (Span::from_static(&cx, "TUPLE_INDEX"), i);
        }
        if is_name_start(b) {
            var i = start;
            while i < self.source.len() && is_name_byte(self.byte(&cx, i)) {
                i = i + 1usize;
            }
            return (Span::from_static(&cx, "NAME"), i);
        }
        (Span::from_static(&cx, "OP"), self.operator(&cx, start))
    }

    fn is_brand_byte(self, b: u8) -> bool {
        (b >= b'a' && b <= b'z') || (b >= b'A' && b <= b'Z') || b == b'_' || is_digit(b)
    }

    // After `b'`: `\xHH`, `\c` or one other byte, then `'`.
    fn byte_literal(self, &cx: Domain!['k], i: usize) -> Option[usize] {
        let b = self.byte(&cx, i);
        let end = if b == b'\\' && self.byte(&cx, i + 1usize) == b'x' && is_hex(self.byte(&cx, i + 2usize)) && is_hex(self.byte(&cx, i + 3usize)) {
            i + 4usize
        } else if b == b'\\' && i + 1usize < self.source.len() && self.byte(&cx, i + 1usize) != b'\n' {
            i + 2usize
        } else if b != b'\'' && b != b'\\' && i < self.source.len() {
            i + 1usize + self.continuation(&cx, i + 1usize)
        } else {
            return Option::None;
        };
        if self.byte(&cx, end) == b'\'' && end < self.source.len() {
            Option::Some.(end + 1usize)
        } else {
            Option::None
        }
    }

    // The number of UTF-8 continuation bytes from `i`: one character is one regex `.`.
    fn continuation(self, &cx: Domain!['k], i: usize) -> usize {
        var n = 0usize;
        while i + n < self.source.len() && (self.byte(&cx, i + n) & 192u8) == 128u8 {
            n = n + 1usize;
        }
        n
    }

    // After `"`: the end of the string literal, past its closing quote.
    fn string_end(self, &cx: Domain!['k], start: usize) -> Option[usize] {
        var i = start;
        var end = Option::None;
        var going = true;
        while going {
            if i >= self.source.len() {
                going = false;
            } else {
                let b = self.byte(&cx, i);
                if b == b'"' {
                    end = Option::Some.(i + 1usize);
                    going = false;
                } else if b == b'\\' {
                    if i + 1usize >= self.source.len() || self.byte(&cx, i + 1usize) == b'\n' {
                        going = false;
                    } else {
                        i = i + 2usize + self.continuation(&cx, i + 2usize);
                    }
                } else {
                    i = i + 1usize;
                }
            }
        }
        end
    }

    fn digits(self, &cx: Domain!['k], i: usize, hex: bool, octal: bool, binary: bool) -> usize {
        var i = i;
        var going = true;
        while going {
            let b = self.byte(&cx, i);
            let ok = b == b'_' || (if hex { is_hex(b) } else if octal { b >= b'0' && b <= b'7' } else if binary { b == b'0' || b == b'1' } else { is_digit(b) });
            if ok && i < self.source.len() {
                i = i + 1usize;
            } else {
                going = false;
            }
        }
        i
    }

    fn starts(self, &cx: Domain!['k], at: usize, word: Slice[u8, 'static]) -> bool {
        self.source.skip(at).starts_with(&cx, Span::from_static(&cx, word))
    }

    // A FLOAT or an INT at `start`, which is a digit.
    fn number(self, &cx: Domain!['k], start: usize) -> (Span['k], usize) {
        let whole = self.digits(&cx, start, false, false, false);
        if self.byte(&cx, whole) == b'.' && is_digit(self.byte(&cx, whole + 1usize)) {
            let fraction = self.digits(&cx, whole + 1usize, false, false, false);
            let end = if self.starts(&cx, fraction, "f32") || self.starts(&cx, fraction, "f64") { fraction + 3usize } else { fraction };
            return (Span::from_static(&cx, "FLOAT"), end);
        }
        if self.starts(&cx, whole, "f32") || self.starts(&cx, whole, "f64") {
            return (Span::from_static(&cx, "FLOAT"), whole + 3usize);
        }
        let b = self.byte(&cx, start);
        let next = self.byte(&cx, start + 1usize);
        let prefixed = b == b'0' && (next == b'x' || next == b'o' || next == b'b');
        let body = if prefixed {
            let end = self.digits(&cx, start + 2usize, next == b'x', next == b'o', next == b'b');
            if end > start + 2usize { end } else { whole }
        } else {
            whole
        };
        (Span::from_static(&cx, "INT"), body + self.int_suffix(&cx, body))
    }

    fn int_suffix(self, &cx: Domain!['k], at: usize) -> usize {
        if self.starts(&cx, at, "i8") || self.starts(&cx, at, "u8") {
            2usize
        } else if self.starts(&cx, at, "i16") || self.starts(&cx, at, "i32") || self.starts(&cx, at, "i64") || self.starts(&cx, at, "u16") || self.starts(&cx, at, "u32") || self.starts(&cx, at, "u64") {
            3usize
        } else if self.starts(&cx, at, "isize") || self.starts(&cx, at, "usize") {
            5usize
        } else {
            0usize
        }
    }

    // The end of the operator at `start`, or a syntax error.
    fn operator(self, &cx: Domain!['k], start: usize) -> usize {
        let rest = self.source.skip(start);
        if rest.starts_with(&cx, Span::from_static(&cx, "..=")) {
            return start + 3usize;
        }
        let pairs = Span::from_static(&cx, " .{ .( .. :: -> => == != <= >= << >> || && ");
        if rest.len() >= 2usize && pairs.contains(&cx, Buffer::new().push_static(" ").push_bytes(&cx, rest.slice(0usize, 2usize)).push_static(" ").save(&cx)) {
            return start + 2usize;
        }
        let singles = Span::from_static(&cx, "-+*/%&|^!<>=.,;:()[]{}?");
        var j = 0usize;
        while j < singles.len() {
            if rest.len() > 0usize && singles.byte_or_zero(&cx, j) == rest.byte_or_zero(&cx, 0usize) {
                return start + 1usize;
            }
            j = j + 1usize;
        }
        self.fail_at(&cx, start)
    }

    // After `f"`: text up to a `{` (FSTRING_OPEN; `{{` and `}}` stand for the brace), then ordinary
    // tokens up to the matching `}` (FSTRING_CLOSE), then more text, until the closing quote
    // (FSTRING_END). A text token is always produced, possibly empty.
    fn fstring(self, &cx: Domain!['k]) {
        var i = self.at(&cx);
        var going = true;
        while going {
            var chunk = Buffer::new();
            let begin = i;
            var scanning = true;
            while scanning {
                if i >= self.source.len() {
                    fail(&cx, Span::from_static(&cx, "unterminated f-string"));
                }
                let ch = self.byte(&cx, i);
                if ch == b'\\' {
                    let width = if self.byte(&cx, i + 1usize) == b'x' { 4usize } else { 2usize };
                    chunk = chunk.push_bytes(&cx, self.source.slice(i, i + width));
                    i = i + width;
                } else if (ch == b'{' || ch == b'}') && self.byte(&cx, i + 1usize) == ch {
                    chunk = chunk.push_byte(ch);
                    i = i + 2usize;
                } else if ch == b'}' {
                    let (line, col) = self.loc(&cx, begin);
                    fail(&cx, Buffer::new().push_u64(line as u64).push_static(":").push_u64(col as u64).push_static(": a lone '}' in an f-string").save(&cx));
                } else if ch == b'{' || ch == b'"' {
                    scanning = false;
                } else {
                    chunk = chunk.push_byte(ch);
                    i = i + 1usize;
                }
            }
            self.token(&cx, Span::from_static(&cx, "FSTRING_TEXT"), chunk.save(&cx), begin);
            if self.byte(&cx, i) == b'"' {
                self.token(&cx, Span::from_static(&cx, "FSTRING_END"), Span::from_static(&cx, "\""), i);
                self.i.set(&cx, i + 1usize);
                going = false;
            } else {
                self.token(&cx, Span::from_static(&cx, "FSTRING_OPEN"), Span::from_static(&cx, "{"), i);
                self.i.set(&cx, i + 1usize);
                let close = self.expression(&cx, true);
                self.token(&cx, Span::from_static(&cx, "FSTRING_CLOSE"), Span::from_static(&cx, "}"), close);
                i = self.at(&cx);
            }
        }
    }
}

// ----------------------------------------------------------------- parser --

// A statement, or a block's tail expression.
forall 'k.
exposed enum Parsed {
    Stmt(Statement['k]),
    Tail(Expr['k]),
}

forall 'k.
exposed struct Parser {
    toks: ArenaVec[Tok['k], 'k],
    i: Ref[usize, 'k],
    file: Span['k],
    // The next node id, shared by every file of a program.
    ids: Ref[u32, 'k],
}

forall 'k.
fn is_block_like(&cx: Domain!['k], kind: Span['k]) -> bool {
    kind.is(&cx, "{") || kind.is(&cx, "if") || kind.is(&cx, "match") || kind.is(&cx, "while") || kind.is(&cx, "for") || kind.is(&cx, "foreach")
}

forall 'k.
fn is_expr_start(&cx: Domain!['k], kind: Span['k]) -> bool {
    is_block_like(&cx, kind) || kind.is(&cx, "INT") || kind.is(&cx, "FLOAT") || kind.is(&cx, "BYTE") || kind.is(&cx, "STRING")
        || kind.is(&cx, "FSTRING_START") || kind.is(&cx, "true") || kind.is(&cx, "false") || kind.is(&cx, "NAME") || kind.is(&cx, "self")
        || kind.is(&cx, "(") || kind.is(&cx, "[") || kind.is(&cx, "sizeof") || kind.is(&cx, "-") || kind.is(&cx, "!") || kind.is(&cx, "*")
        || kind.is(&cx, "&") || kind.is(&cx, "unsafe") || kind.is(&cx, "|") || kind.is(&cx, "||") || kind.is(&cx, "return") || kind.is(&cx, "pack")
}

// The binary operators of each precedence level, loosest first.
forall 'k.
fn level_has(&cx: Domain!['k], level: usize, kind: Span['k]) -> bool {
    if level == 0usize {
        kind.is(&cx, "||")
    } else if level == 1usize {
        kind.is(&cx, "&&")
    } else if level == 2usize {
        kind.is(&cx, "==") || kind.is(&cx, "!=") || kind.is(&cx, "<=") || kind.is(&cx, ">=") || kind.is(&cx, "<") || kind.is(&cx, ">")
    } else if level == 3usize {
        kind.is(&cx, "|")
    } else if level == 4usize {
        kind.is(&cx, "^")
    } else if level == 5usize {
        kind.is(&cx, "&")
    } else if level == 6usize {
        kind.is(&cx, "<<") || kind.is(&cx, ">>")
    } else if level == 7usize {
        kind.is(&cx, "+") || kind.is(&cx, "-")
    } else {
        kind.is(&cx, "*") || kind.is(&cx, "/") || kind.is(&cx, "%")
    }
}

const LEVELS: usize = 9usize;
const COMPARE: usize = 2usize;

// The items of one source file. `ids` numbers the nodes.
forall 'k.
fn parse(&cx: Domain!['k], source: Span['k], file: Span['k], ids: Ref[u32, 'k]) -> ArenaVec[S::Item['k], 'k] {
    let p = Parser.{ toks: Lexer::new(&cx, source, file).run(&cx), i: Ref::new(&cx, 0usize), file, ids };
    p.file_items(&cx)
}

forall 'k.
impl Parser['k] {
    // ---- tokens
    fn tok(self, &cx: Domain!['k]) -> Tok['k] {
        self.toks.at(&cx, self.i.copy(&cx))
    }

    fn k(self, &cx: Domain!['k]) -> Span['k] {
        self.tok(&cx).kind
    }

    fn at(self, &cx: Domain!['k], kind: Slice[u8, 'static]) -> bool {
        self.k(&cx).is(&cx, kind)
    }

    fn pos(self, &cx: Domain!['k]) -> Pos {
        let t = self.tok(&cx);
        Pos.{ line: t.line, col: t.col }
    }

    fn next(self, &cx: Domain!['k]) -> Tok['k] {
        let t = self.tok(&cx);
        if !t.kind.is(&cx, "EOF") {
            self.i.set(&cx, self.i.copy(&cx) + 1usize);
        }
        t
    }

    fn eat(self, &cx: Domain!['k], kind: Slice[u8, 'static]) -> bool {
        if self.at(&cx, kind) {
            let unit = self.next(&cx);
            true
        } else {
            false
        }
    }

    fn expect(self, &cx: Domain!['k], kind: Slice[u8, 'static]) -> Tok['k] {
        if !self.at(&cx, kind) {
            self.fail(&cx);
        }
        self.next(&cx)
    }

    fn fail(self, &cx: Domain!['k]) -> ! {
        let t = self.tok(&cx);
        fail(&cx, Buffer::new().push_bytes(&cx, self.file).push_static(":").push_u64(t.line as u64).push_static(":").push_u64(t.col as u64).push_static(": syntax error").save(&cx))
    }

    fn id(self, &cx: Domain!['k]) -> u32 {
        let id = self.ids.copy(&cx);
        self.ids.set(&cx, id + 1u32);
        id
    }

    fn name(self, &cx: Domain!['k]) -> Span['k] {
        self.expect(&cx, "NAME").text
    }

    // ---- items
    fn file_items(self, &cx: Domain!['k]) -> ArenaVec[S::Item['k], 'k] {
        let items: ArenaVec[S::Item['k], 'k] = ArenaVec::new(&cx);
        while !self.at(&cx, "EOF") {
            items.push(&cx, self.item(&cx));
        }
        items
    }

    fn item(self, &cx: Domain!['k]) -> S::Item['k] {
        let quantifier = if self.at(&cx, "forall") { Option::Some.(self.forall_clause(&cx)) } else { Option::None };
        self.item_body(&cx, quantifier)
    }

    // `BRAND ("," BRAND)* "."`: nonempty, with no trailing comma.
    fn brands(self, &cx: Domain!['k]) -> ArenaVec[Span['k], 'k] {
        let brands: ArenaVec[Span['k], 'k] = ArenaVec::one(&cx, self.expect(&cx, "BRAND").text);
        while self.eat(&cx, ",") {
            brands.push(&cx, self.expect(&cx, "BRAND").text);
        }
        let unit = self.expect(&cx, ".");
        brands
    }

    fn forall_param(self, &cx: Domain!['k]) -> Span['k] {
        if !self.at(&cx, "NAME") && !self.at(&cx, "BRAND") {
            self.fail(&cx);
        }
        self.next(&cx).text
    }

    fn forall_clause(self, &cx: Domain!['k]) -> S::Forall['k] {
        let unit = self.expect(&cx, "forall");
        let params: ArenaVec[Span['k], 'k] = ArenaVec::one(&cx, self.forall_param(&cx));
        let determined: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
        let premises: ArenaVec[S::Premise['k], 'k] = ArenaVec::new(&cx);
        while self.eat(&cx, ",") {
            params.push(&cx, self.forall_param(&cx));
        }
        if self.eat(&cx, "->") {
            determined.push(&cx, self.forall_param(&cx));
            while self.eat(&cx, ",") {
                determined.push(&cx, self.forall_param(&cx));
            }
        }
        if self.eat(&cx, "where") {
            premises.push(&cx, self.premise(&cx));
            while self.eat(&cx, ",") {
                premises.push(&cx, self.premise(&cx));
            }
        }
        let unit = self.expect(&cx, ".");
        S::Forall.{ params, determined, premises }
    }

    fn premise(self, &cx: Domain!['k]) -> S::Premise['k] {
        let trait_path = self.path(&cx);
        let unit = self.expect(&cx, "[");
        let args = self.type_args(&cx);
        let unit = self.expect(&cx, "]");
        S::Premise.{ trait_path, args }
    }

    fn item_body(self, &cx: Domain!['k], quantifier: Option[S::Forall['k]]) -> S::Item['k] {
        let k = self.k(&cx);
        let start = self.pos(&cx);
        if k.is(&cx, "use") || k.is(&cx, "export") {
            let unit = self.next(&cx);
            let tree = self.use_tree(&cx);
            let unit = self.expect(&cx, ";");
            return S::Item::Use.(S::UseItem.{ tree, is_export: k.is(&cx, "export"), quantifier, pos: start });
        }
        if k.is(&cx, "module") {
            let unit = self.next(&cx);
            let names: ArenaVec[Span['k], 'k] = ArenaVec::one(&cx, self.name(&cx));
            while self.eat(&cx, "::") {
                names.push(&cx, self.name(&cx));
            }
            let unit = self.expect(&cx, ";");
            return S::Item::Module.(S::Node.{ id: self.id(&cx), value: names, pos: start });
        }
        if k.is(&cx, "exposed") || k.is(&cx, "struct") || k.is(&cx, "tuple") || k.is(&cx, "enum") {
            return self.aggregate(&cx, quantifier);
        }
        if k.is(&cx, "unsafe") {
            let unit = self.next(&cx);
            if self.at(&cx, "instance") {
                return S::Item::Instance.(self.instance_decl(&cx, start, true, quantifier));
            }
            return S::Item::Fn.(self.fn_rest(&cx, start, true, quantifier));
        }
        if k.is(&cx, "instance") {
            return S::Item::Instance.(self.instance_decl(&cx, start, false, quantifier));
        }
        if k.is(&cx, "fn") {
            return S::Item::Fn.(self.fn_rest(&cx, start, false, quantifier));
        }
        if k.is(&cx, "extern") {
            return S::Item::Extern.(self.extern_decl(&cx, quantifier));
        }
        if k.is(&cx, "impl") {
            return S::Item::Impl.(self.impl_block(&cx, quantifier));
        }
        if k.is(&cx, "trait") {
            let unit = self.next(&cx);
            let name = self.name(&cx);
            let unit = self.expect(&cx, "{");
            let methods: ArenaVec[S::Fn['k], 'k] = ArenaVec::new(&cx);
            while !self.at(&cx, "}") {
                methods.push(&cx, self.fn_decl(&cx, Option::None));
            }
            let unit = self.next(&cx);
            return S::Item::Trait.(S::TraitDecl.{ id: self.id(&cx), name, methods, quantifier, pos: start });
        }
        if k.is(&cx, "const") {
            return S::Item::Const.(self.const_decl(&cx, quantifier));
        }
        self.fail(&cx)
    }

    fn use_tree(self, &cx: Domain!['k]) -> S::UseTree['k] {
        let path: ArenaVec[Span['k], 'k] = ArenaVec::one(&cx, self.name(&cx));
        var star = false;
        let children: ArenaVec[S::UseTree['k], 'k] = ArenaVec::new(&cx);
        var going = true;
        while going && self.eat(&cx, "::") {
            if self.at(&cx, "NAME") {
                path.push(&cx, self.next(&cx).text);
            } else if self.eat(&cx, "*") {
                star = true;
                going = false;
            } else if self.eat(&cx, "{") {
                while !self.at(&cx, "}") {
                    children.push(&cx, self.use_tree(&cx));
                    if !self.eat(&cx, ",") {
                        let unit = self.expect(&cx, "}");
                        return self.use_alias(&cx, path, star, children);
                    }
                }
                let unit = self.expect(&cx, "}");
                going = false;
            } else {
                self.fail(&cx);
            }
        }
        self.use_alias(&cx, path, star, children)
    }

    fn use_alias(self, &cx: Domain!['k], path: ArenaVec[Span['k], 'k], star: bool, children: ArenaVec[S::UseTree['k], 'k]) -> S::UseTree['k] {
        let alias = if self.eat(&cx, "as") { Option::Some.(self.name(&cx)) } else { Option::None };
        S::UseTree.{ path, star, children, alias }
    }

    fn path(self, &cx: Domain!['k]) -> ArenaVec[Span['k], 'k] {
        let names: ArenaVec[Span['k], 'k] = ArenaVec::one(&cx, self.name(&cx));
        while self.eat(&cx, "::") {
            names.push(&cx, self.name(&cx));
        }
        names
    }

    fn aggregate(self, &cx: Domain!['k], quantifier: Option[S::Forall['k]]) -> S::Item['k] {
        let start = self.pos(&cx);
        let exposure = if self.eat(&cx, "exposed") {
            var scope = Option::None;
            if self.eat(&cx, "(") {
                scope = Option::Some.(self.path(&cx));
                let unit = self.expect(&cx, ")");
            }
            Option::Some.(S::Exposed.{ scope })
        } else {
            Option::None
        };
        let kind = self.k(&cx);
        if !kind.is(&cx, "struct") && !kind.is(&cx, "tuple") && !kind.is(&cx, "enum") {
            self.fail(&cx);
        }
        let unit = self.next(&cx);
        let name = self.name(&cx);
        let linear = self.eat(&cx, "!");
        if kind.is(&cx, "struct") {
            let unit = self.expect(&cx, "{");
            let fields: ArenaVec[S::FieldDecl['k], 'k] = ArenaVec::new(&cx);
            while !self.at(&cx, "}") {
                let field_name = self.name(&cx);
                let unit = self.expect(&cx, ":");
                fields.push(&cx, S::FieldDecl.{ name: field_name, type: self.type(&cx) });
                if !self.eat(&cx, ",") {
                    let unit = self.expect(&cx, "}");
                    return S::Item::Struct.(S::StructDecl.{ id: self.id(&cx), name, linear, fields, exposure, quantifier, pos: start });
                }
            }
            let unit = self.expect(&cx, "}");
            return S::Item::Struct.(S::StructDecl.{ id: self.id(&cx), name, linear, fields, exposure, quantifier, pos: start });
        }
        if kind.is(&cx, "tuple") {
            let unit = self.expect(&cx, "(");
            let elems = self.types_until_close(&cx);
            let unit = self.expect(&cx, ";");
            return S::Item::Tuple.(S::TupleDecl.{ id: self.id(&cx), name, linear, elems, exposure, quantifier, pos: start });
        }
        let unit = self.expect(&cx, "{");
        let variants: ArenaVec[S::Variant['k], 'k] = ArenaVec::new(&cx);
        while !self.at(&cx, "}") {
            variants.push(&cx, self.variant(&cx));
            if !self.eat(&cx, ",") {
                let unit = self.expect(&cx, "}");
                return S::Item::Enum.(S::EnumDecl.{ id: self.id(&cx), name, linear, variants, exposure, quantifier, pos: start });
            }
        }
        let unit = self.expect(&cx, "}");
        S::Item::Enum.(S::EnumDecl.{ id: self.id(&cx), name, linear, variants, exposure, quantifier, pos: start })
    }

    // `type ("," type)* ","? ")"`, possibly empty; the `(` was read.
    fn types_until_close(self, &cx: Domain!['k]) -> ArenaVec[Type['k], 'k] {
        let out: ArenaVec[Type['k], 'k] = ArenaVec::new(&cx);
        var going = true;
        while going && !self.at(&cx, ")") {
            out.push(&cx, self.type(&cx));
            going = self.eat(&cx, ",");
        }
        let unit = self.expect(&cx, ")");
        out
    }

    fn variant(self, &cx: Domain!['k]) -> S::Variant['k] {
        let name = self.name(&cx);
        let payload: ArenaVec[Type['k], 'k] = ArenaVec::new(&cx);
        if self.eat(&cx, "(") {
            payload.push(&cx, self.type(&cx));
            var going = true;
            while going && self.eat(&cx, ",") {
                if self.at(&cx, ")") {
                    going = false;
                } else {
                    payload.push(&cx, self.type(&cx));
                }
            }
            let unit = self.expect(&cx, ")");
        }
        S::Variant.{ name, payload }
    }

    fn params(self, &cx: Domain!['k]) -> ArenaVec[S::Param['k], 'k] {
        let out: ArenaVec[S::Param['k], 'k] = ArenaVec::new(&cx);
        var going = true;
        while going && !self.at(&cx, ")") {
            let lend = self.eat(&cx, "&");
            if out.is_empty(&cx) && self.eat(&cx, "self") {
                let type = if self.eat(&cx, ":") { Option::Some.(self.type(&cx)) } else { Option::None };
                out.push(&cx, S::Param.{ name: Span::from_static(&cx, "self"), type, lend });
            } else {
                let name = self.name(&cx);
                let unit = self.expect(&cx, ":");
                out.push(&cx, S::Param.{ name, type: Option::Some.(self.ptype(&cx)), lend });
            }
            going = self.eat(&cx, ",");
        }
        out
    }

    // `fn NAME "(" params? ")" ("->" type)?`, shared by definitions and externs.
    fn fn_header(self, &cx: Domain!['k]) -> (Span['k], ArenaVec[S::Param['k], 'k], Option[Type['k]]) {
        let unit = self.expect(&cx, "fn");
        let name = self.name(&cx);
        let unit = self.expect(&cx, "(");
        let params = self.params(&cx);
        let unit = self.expect(&cx, ")");
        let ret = if self.eat(&cx, "->") { Option::Some.(self.type(&cx)) } else { Option::None };
        (name, params, ret)
    }

    // `"unsafe"? fn_header (";" | block)`.
    fn fn_decl(self, &cx: Domain!['k], quantifier: Option[S::Forall['k]]) -> S::Fn['k] {
        let start = self.pos(&cx);
        let is_unsafe = self.eat(&cx, "unsafe");
        self.fn_rest(&cx, start, is_unsafe, quantifier)
    }

    fn fn_rest(self, &cx: Domain!['k], start: Pos, is_unsafe: bool, quantifier: Option[S::Forall['k]]) -> S::Fn['k] {
        let (name, params, ret) = self.fn_header(&cx);
        let body = if self.eat(&cx, ";") { Option::None } else { Option::Some.(self.block(&cx)) };
        S::Fn.{ id: self.id(&cx), name, params, ret, body, is_unsafe, quantifier, pos: start }
    }

    fn extern_decl(self, &cx: Domain!['k], quantifier: Option[S::Forall['k]]) -> S::Extern['k] {
        let start = self.pos(&cx);
        let unit = self.expect(&cx, "extern");
        let raw = self.expect(&cx, "STRING").text;
        let abi = unescape(&cx, raw.slice(1usize, raw.len() - 1usize));
        let (name, params, ret) = self.fn_header(&cx);
        let unit = self.expect(&cx, ";");
        S::Extern.{ id: self.id(&cx), abi, name, params, ret, quantifier, pos: start }
    }

    fn const_decl(self, &cx: Domain!['k], quantifier: Option[S::Forall['k]]) -> S::Const['k] {
        let start = self.pos(&cx);
        let unit = self.expect(&cx, "const");
        let name = self.name(&cx);
        let unit = self.expect(&cx, ":");
        let type = self.type(&cx);
        let unit = self.expect(&cx, "=");
        let value = self.expr(&cx);
        let unit = self.expect(&cx, ";");
        S::Const.{ id: self.id(&cx), name, type, value, quantifier, pos: start }
    }

    fn impl_block(self, &cx: Domain!['k], quantifier: Option[S::Forall['k]]) -> S::Impl['k] {
        let start = self.pos(&cx);
        let unit = self.expect(&cx, "impl");
        let type = self.type(&cx);
        let unit = self.expect(&cx, "{");
        let items: ArenaVec[S::Member['k], 'k] = ArenaVec::new(&cx);
        while !self.at(&cx, "}") {
            let member_forall = if self.at(&cx, "forall") { Option::Some.(self.forall_clause(&cx)) } else { Option::None };
            if self.at(&cx, "const") {
                items.push(&cx, S::Member::Const.(self.const_decl(&cx, member_forall)));
            } else {
                items.push(&cx, S::Member::Fn.(self.fn_decl(&cx, member_forall)));
            }
        }
        let unit = self.next(&cx);
        S::Impl.{ id: self.id(&cx), type, items, quantifier, pos: start }
    }

    fn instance_decl(self, &cx: Domain!['k], start: Pos, is_unsafe: bool, quantifier: Option[S::Forall['k]]) -> S::InstanceDecl['k] {
        let unit = self.expect(&cx, "instance");
        let type = self.type(&cx);
        let unit = self.expect(&cx, "{");
        let methods: ArenaVec[S::Fn['k], 'k] = ArenaVec::new(&cx);
        while !self.at(&cx, "}") {
            methods.push(&cx, self.fn_decl(&cx, Option::None));
        }
        let unit = self.next(&cx);
        S::InstanceDecl.{ id: self.id(&cx), type, methods, is_unsafe, quantifier, pos: start }
    }

    // ---- types
    fn type(self, &cx: Domain!['k]) -> Type['k] {
        self.type_in(&cx, false)
    }

    // The type of a parameter, which may also be a `closure(...)` type whose environment is unnamed.
    fn ptype(self, &cx: Domain!['k]) -> Type['k] {
        self.type_in(&cx, true)
    }

    fn type_in(self, &cx: Domain!['k], parameter: bool) -> Type['k] {
        let k = self.k(&cx);
        if k.is(&cx, "NAME") {
            return Type::Name.(self.named_type(&cx));
        }
        if k.is(&cx, "*") {
            let unit = self.next(&cx);
            return Type::Ptr.(Ref::new(&cx, self.type(&cx)));
        }
        if k.is(&cx, "!") {
            let unit = self.next(&cx);
            return Type::Never;
        }
        if k.is(&cx, "(") {
            let unit = self.next(&cx);
            if self.eat(&cx, ")") {
                return Type::Tuple.(ArenaVec::new(&cx));
            }
            let first = self.type(&cx);
            if self.eat(&cx, ")") {
                return first;
            }
            let unit = self.expect(&cx, ",");
            let elems = self.types_until_close(&cx);
            elems.insert(&cx, 0usize, first);
            return Type::Tuple.(elems);
        }
        if k.is(&cx, "[") {
            let unit = self.next(&cx);
            let elem = self.type(&cx);
            let unit = self.expect(&cx, ";");
            let length = self.expr(&cx);
            let unit = self.expect(&cx, "]");
            return Type::Array.(Ref::new(&cx, elem), Ref::new(&cx, length));
        }
        if k.is(&cx, "unsafe") || k.is(&cx, "fn") {
            let is_unsafe = self.eat(&cx, "unsafe");
            let unit = self.expect(&cx, "fn");
            let unit = self.expect(&cx, "(");
            let params = self.fn_params(&cx);
            let unit = self.expect(&cx, "->");
            return Type::Fn.(S::TFn.{ params, ret: Ref::new(&cx, self.type(&cx)), is_unsafe });
        }
        if k.is(&cx, "closure") {
            let unit = self.next(&cx);
            var env = Option::None;
            if self.eat(&cx, "[") {
                env = Option::Some.(Ref::new(&cx, self.type(&cx)));
                let unit = self.expect(&cx, "]");
            } else if !parameter {
                self.fail(&cx);
            }
            let unit = self.expect(&cx, "(");
            let params = self.fn_params(&cx);
            let unit = self.expect(&cx, "->");
            return Type::Closure.(S::TClosure.{ env, params, ret: Ref::new(&cx, self.type(&cx)) });
        }
        if k.is(&cx, "exists") {
            let unit = self.next(&cx);
            let brands = self.brands(&cx);
            return Type::Exists.(brands, Ref::new(&cx, self.type(&cx)));
        }
        if k.is(&cx, "foreach") {
            let unit = self.next(&cx);
            let indirect = self.eat(&cx, "*");
            let binder = self.name(&cx);
            let unit = self.expect(&cx, "of");
            let source = self.type(&cx);
            let unit = self.expect(&cx, "=>");
            return Type::Foreach.(S::TForeach.{ binder, indirect, source: Ref::new(&cx, source), body: Ref::new(&cx, self.type(&cx)) });
        }
        if k.is(&cx, "forall") {
            let unit = self.next(&cx);
            let quantified: ArenaVec[Span['k], 'k] = ArenaVec::one(&cx, self.forall_param(&cx));
            while self.eat(&cx, ",") {
                quantified.push(&cx, self.forall_param(&cx));
            }
            let unit = self.expect(&cx, ".");
            return Type::Forall.(quantified, Ref::new(&cx, self.type(&cx)));
        }
        self.fail(&cx)
    }

    // The slots of a `fn(...)` or `closure(...)` type, after its `(`; the `)` is consumed.
    fn fn_params(self, &cx: Domain!['k]) -> ArenaVec[S::Slot['k], 'k] {
        let out: ArenaVec[S::Slot['k], 'k] = ArenaVec::new(&cx);
        var going = true;
        while going && !self.at(&cx, ")") {
            if self.eat(&cx, "&") {
                if !self.at(&cx, "NAME") && !self.at(&cx, "_") {
                    self.fail(&cx);
                }
                let unit = self.next(&cx);
                let unit = self.expect(&cx, ":");
                out.push(&cx, S::Slot.{ lend: true, type: self.type(&cx) });
            } else {
                out.push(&cx, S::Slot.{ lend: false, type: self.ptype(&cx) });
            }
            going = self.eat(&cx, ",");
        }
        let unit = self.expect(&cx, ")");
        out
    }

    fn named_type(self, &cx: Domain!['k]) -> S::TName['k] {
        let path = self.path(&cx);
        let linear = self.eat(&cx, "!");
        if self.eat(&cx, "[") {
            let args = self.type_args(&cx);
            let unit = self.expect(&cx, "]");
            S::TName.{ id: self.id(&cx), path, linear, args: args.args, determined: args.determined }
        } else {
            S::TName.{ id: self.id(&cx), path, linear, args: ArenaVec::new(&cx), determined: 0usize }
        }
    }

    fn type_arg(self, &cx: Domain!['k]) -> Type['k] {
        if self.at(&cx, "BRAND") {
            return Type::Brand.(self.next(&cx).text);
        }
        if self.eat(&cx, "_") {
            return Type::Ignored;
        }
        self.type(&cx)
    }

    // `a, b` or `a, b -> c`, with an optional trailing comma; ends before the `]`.
    fn type_args(self, &cx: Domain!['k]) -> S::TypeArgs['k] {
        let args: ArenaVec[Type['k], 'k] = ArenaVec::one(&cx, self.type_arg(&cx));
        var split = Option::None;
        var going = true;
        while going {
            if self.eat(&cx, ",") {
                if self.at(&cx, "]") {
                    going = false;
                } else {
                    args.push(&cx, self.type_arg(&cx));
                }
            } else if self.at(&cx, "->") && split.is_none() {
                let unit = self.next(&cx);
                split = Option::Some.(args.len(&cx));
                args.push(&cx, self.type_arg(&cx));
            } else {
                going = false;
            }
        }
        let determined = match split {
            Option::Some(at) => args.len(&cx) - at,
            Option::None => 0usize,
        };
        S::TypeArgs.{ id: self.id(&cx), args, determined }
    }

    // ---- statements
    fn block(self, &cx: Domain!['k]) -> S::Block['k] {
        let start = self.pos(&cx);
        let unit = self.expect(&cx, "{");
        let stmts: ArenaVec[Statement['k], 'k] = ArenaVec::new(&cx);
        var tail = Option::None;
        while !self.at(&cx, "}") {
            let unit = match self.statement(&cx) {
                Parsed::Stmt(s) => stmts.push(&cx, s),
                Parsed::Tail(e) => {
                    tail = Option::Some.(Ref::new(&cx, e));
                },
            };
        }
        let unit = self.next(&cx);
        S::Block.{ id: self.id(&cx), stmts, tail, pos: start }
    }

    fn expr_stmt(self, &cx: Domain!['k], e: Expr['k], start: Pos) -> Statement['k] {
        Statement::Expr.(S::Node.{ id: self.id(&cx), value: e, pos: start })
    }

    // A statement; or, when the block ends right after it, a bare expression (its tail).
    fn statement(self, &cx: Domain!['k]) -> Parsed['k] {
        let k = self.k(&cx);
        let start = self.pos(&cx);
        if k.is(&cx, "let") {
            return Parsed::Stmt.(Statement::Let.(self.let_stmt(&cx)));
        }
        if k.is(&cx, "var") {
            let unit = self.next(&cx);
            let name = self.name(&cx);
            let type = if self.eat(&cx, ":") { Option::Some.(self.type(&cx)) } else { Option::None };
            let unit = self.expect(&cx, "=");
            let value = self.expr(&cx);
            let unit = self.expect(&cx, ";");
            return Parsed::Stmt.(Statement::Var.(S::Var.{ id: self.id(&cx), name, type, value, pos: start }));
        }
        if k.is(&cx, "const") {
            return Parsed::Stmt.(Statement::Const.(self.const_decl(&cx, Option::None)));
        }
        if is_block_like(&cx, k) {
            let e = self.block_like(&cx);
            let looping = match e {
                Expr::While(w) => true,
                Expr::For(f) => true,
                _ => false,
            };
            if !self.eat(&cx, ";") && self.at(&cx, "}") && !looping {
                return Parsed::Tail.(e);
            }
            return Parsed::Stmt.(self.expr_stmt(&cx, e, start));
        }
        let e = if k.is(&cx, "unsafe") {
            let unit = self.next(&cx);
            let star = self.pos(&cx);
            if self.eat(&cx, "*") {
                let target = self.unary(&cx);
                if self.eat(&cx, "=") {
                    // a store: `unsafe *p = v;`
                    let value = self.expr(&cx);
                    let unit = self.expect(&cx, ";");
                    let store = Expr::UnsafeStore.(S::UnsafeStore.{ id: self.id(&cx), pointer: Ref::new(&cx, target), value: Ref::new(&cx, value), pos: start });
                    let marked = Expr::Unary.(S::Unary.{ id: self.id(&cx), op: Span::from_static(&cx, "unsafe"), operand: Ref::new(&cx, store), pos: start });
                    return Parsed::Stmt.(self.expr_stmt(&cx, marked, start));
                }
                let deref = Expr::Unary.(S::Unary.{ id: self.id(&cx), op: Span::from_static(&cx, "*"), operand: Ref::new(&cx, target), pos: star });
                self.oexpr_from(&cx, Expr::Unary.(S::Unary.{ id: self.id(&cx), op: Span::from_static(&cx, "unsafe"), operand: Ref::new(&cx, deref), pos: start }))
            } else {
                let operand = self.unary(&cx);
                self.oexpr_from(&cx, Expr::Unary.(S::Unary.{ id: self.id(&cx), op: Span::from_static(&cx, "unsafe"), operand: Ref::new(&cx, operand), pos: start }))
            }
        } else {
            self.expr(&cx)
        };
        if self.eat(&cx, "=") {
            if !assignable(&cx, e) {
                self.fail(&cx);
            }
            let value = self.expr(&cx);
            let unit = self.expect(&cx, ";");
            return Parsed::Stmt.(Statement::Assign.(S::Assign.{ target: e, value, pos: start }));
        }
        if self.eat(&cx, ";") {
            return Parsed::Stmt.(self.expr_stmt(&cx, e, start));
        }
        let returning = match e {
            Expr::Return(r) => true,
            _ => false,
        };
        if self.at(&cx, "}") && !returning {
            return Parsed::Tail.(e);
        }
        self.fail(&cx)
    }

    fn let_stmt(self, &cx: Domain!['k]) -> S::Let['k] {
        let start = self.pos(&cx);
        let unit = self.expect(&cx, "let");
        let brands = if self.eat(&cx, "exists") { self.brands(&cx) } else { ArenaVec::new(&cx) };
        let pattern = self.pattern(&cx);
        let type = if self.eat(&cx, ":") { Option::Some.(self.type(&cx)) } else { Option::None };
        let unit = self.expect(&cx, "=");
        let value = self.expr(&cx);
        let unit = self.expect(&cx, ";");
        S::Let.{ id: self.id(&cx), pattern, type, value, brands, pos: start }
    }

    fn pattern(self, &cx: Domain!['k]) -> S::Pattern['k] {
        let k = self.k(&cx);
        let start = self.pos(&cx);
        if k.is(&cx, "NAME") {
            return S::Pattern::Bind.(S::Node.{ id: self.id(&cx), value: self.next(&cx).text, pos: start });
        }
        if k.is(&cx, "_") {
            let unit = self.next(&cx);
            return S::Pattern::Wild.(self.id(&cx));
        }
        if k.is(&cx, "(") {
            let unit = self.next(&cx);
            let elems: ArenaVec[S::Pattern['k], 'k] = ArenaVec::new(&cx);
            if self.eat(&cx, ")") {
                return S::Pattern::Tuple.(S::Node.{ id: self.id(&cx), value: elems, pos: start });
            }
            elems.push(&cx, self.pattern(&cx));
            let unit = self.expect(&cx, ",");
            var going = true;
            while going && !self.at(&cx, ")") {
                elems.push(&cx, self.pattern(&cx));
                going = self.eat(&cx, ",");
            }
            let unit = self.expect(&cx, ")");
            return S::Pattern::Tuple.(S::Node.{ id: self.id(&cx), value: elems, pos: start });
        }
        if k.is(&cx, "[") {
            let unit = self.next(&cx);
            let elems: ArenaVec[S::Pattern['k], 'k] = ArenaVec::one(&cx, self.pattern(&cx));
            var going = true;
            while going && self.eat(&cx, ",") {
                if self.at(&cx, "]") {
                    going = false;
                } else {
                    elems.push(&cx, self.pattern(&cx));
                }
            }
            let unit = self.expect(&cx, "]");
            return S::Pattern::Array.(S::Node.{ id: self.id(&cx), value: elems, pos: start });
        }
        if k.is(&cx, "{") {
            let unit = self.next(&cx);
            let fields: ArenaVec[S::FieldPattern['k], 'k] = ArenaVec::new(&cx);
            var rest = Option::None;
            if self.at(&cx, "..") {
                rest = Option::Some.(self.spread(&cx));
            } else if !self.at(&cx, "}") {
                fields.push(&cx, self.field_pattern(&cx));
                var going = true;
                while going && self.eat(&cx, ",") {
                    if self.at(&cx, "}") {
                        going = false;
                    } else if self.at(&cx, "..") {
                        rest = Option::Some.(self.spread(&cx));
                        let unit = self.eat(&cx, ",");
                        going = false;
                    } else {
                        fields.push(&cx, self.field_pattern(&cx));
                    }
                }
            }
            let unit = self.expect(&cx, "}");
            return S::Pattern::Struct.(S::PStruct.{ id: self.id(&cx), fields, rest });
        }
        self.fail(&cx)
    }

    fn field_pattern(self, &cx: Domain!['k]) -> S::FieldPattern['k] {
        let start = self.pos(&cx);
        let name = self.name(&cx);
        let pattern = if self.eat(&cx, ":") { self.pattern(&cx) } else { S::Pattern::Bind.(S::Node.{ id: self.id(&cx), value: name, pos: start }) };
        S::FieldPattern.{ name, pattern }
    }

    fn spread(self, &cx: Domain!['k]) -> Span['k] {
        let unit = self.expect(&cx, "..");
        self.name(&cx)
    }

    // ---- expressions
    // A whole expression: an operator expression, or a block-like, closure, `return` or `pack` form.
    fn expr(self, &cx: Domain!['k]) -> Expr['k] {
        let k = self.k(&cx);
        if is_block_like(&cx, k) {
            return self.block_like(&cx);
        }
        if k.is(&cx, "|") || k.is(&cx, "||") {
            return self.closure_expr(&cx);
        }
        if k.is(&cx, "return") {
            let start = self.pos(&cx);
            let unit = self.next(&cx);
            let value = if is_expr_start(&cx, self.k(&cx)) { Option::Some.(Ref::new(&cx, self.expr(&cx))) } else { Option::None };
            return Expr::Return.(S::Node.{ id: self.id(&cx), value, pos: start });
        }
        if k.is(&cx, "pack") {
            let start = self.pos(&cx);
            let unit = self.next(&cx);
            let brands = self.brands(&cx);
            let value = self.expr(&cx);
            return Expr::Pack.(S::Pack.{ id: self.id(&cx), brands, value: Ref::new(&cx, value), pos: start });
        }
        self.oexpr(&cx)
    }

    fn block_like(self, &cx: Domain!['k]) -> Expr['k] {
        let k = self.k(&cx);
        let start = self.pos(&cx);
        if k.is(&cx, "{") {
            return Expr::Block.(self.block(&cx));
        }
        let unit = self.next(&cx);
        if k.is(&cx, "if") {
            let cond = self.oexpr(&cx);
            let then = self.block(&cx);
            var other = Option::None;
            if self.eat(&cx, "else") {
                if self.at(&cx, "{") {
                    other = Option::Some.(Ref::new(&cx, Expr::Block.(self.block(&cx))));
                } else if self.at(&cx, "if") {
                    other = Option::Some.(Ref::new(&cx, self.block_like(&cx)));
                } else {
                    self.fail(&cx);
                }
            }
            return Expr::If.(S::If.{ id: self.id(&cx), cond: Ref::new(&cx, cond), then, other, pos: start });
        }
        if k.is(&cx, "match") {
            return self.match_rest(&cx, start);
        }
        if k.is(&cx, "while") {
            let cond = self.oexpr(&cx);
            let body = self.block(&cx);
            return Expr::While.(S::While.{ id: self.id(&cx), cond: Ref::new(&cx, cond), body, pos: start });
        }
        if k.is(&cx, "for") {
            let name = self.name(&cx);
            let unit = self.expect(&cx, "in");
            let iterator = self.oexpr(&cx);
            let body = self.block(&cx);
            return Expr::For.(S::For.{ id: self.id(&cx), name, iterator: Ref::new(&cx, iterator), body, pos: start });
        }
        // foreach
        let name = self.name(&cx);
        let binder = if self.eat(&cx, ":") { Option::Some.(self.name(&cx)) } else { Option::None };
        let unit = self.expect(&cx, "of");
        let source = self.oexpr(&cx);
        let body = self.block(&cx);
        Expr::Foreach.(S::Foreach.{ id: self.id(&cx), name, binder, source: Ref::new(&cx, source), body, pos: start })
    }

    fn match_rest(self, &cx: Domain!['k], start: Pos) -> Expr['k] {
        let scrutinee = self.oexpr(&cx);
        let unit = self.expect(&cx, "{");
        let arms: ArenaVec[S::Arm['k], 'k] = ArenaVec::new(&cx);
        var going = true;
        while going && !self.at(&cx, "}") {
            let at = self.pos(&cx);
            if self.eat(&cx, "_") {
                // the wildcard arm is the last one
                let unit = self.expect(&cx, "=>");
                let body = self.expr(&cx);
                let unit = self.eat(&cx, ",");
                let wild = S::Case.{ id: self.id(&cx), kind: S::CaseKind::Wild, path: Option::None, binders: Option::None, low: Option::None, high: Option::None, pos: at };
                arms.push(&cx, S::Arm.{ cases: ArenaVec::one(&cx, wild), body, pos: at });
                going = false;
            } else {
                let cases: ArenaVec[S::Case['k], 'k] = ArenaVec::one(&cx, self.case(&cx));
                while self.eat(&cx, "|") {
                    cases.push(&cx, self.case(&cx));
                }
                let unit = self.expect(&cx, "=>");
                // A block-like body's comma is optional; any other body needs one, unless the arm is
                // last (and is not a `return`).
                let block_like = is_block_like(&cx, self.k(&cx));
                let body = self.expr(&cx);
                let returning = match body {
                    Expr::Return(r) => true,
                    _ => false,
                };
                if !(self.eat(&cx, ",") || block_like || (self.at(&cx, "}") && !returning)) {
                    self.fail(&cx);
                }
                arms.push(&cx, S::Arm.{ cases, body, pos: at });
            }
        }
        let unit = self.expect(&cx, "}");
        Expr::Match.(S::Match.{ id: self.id(&cx), scrutinee: Ref::new(&cx, scrutinee), arms, pos: start })
    }

    fn case(self, &cx: Domain!['k]) -> S::Case['k] {
        let start = self.pos(&cx);
        if self.at(&cx, "INT") || self.at(&cx, "BYTE") || self.at(&cx, "-") {
            let low = self.lit_value(&cx);
            let high = if self.eat(&cx, "..=") { self.lit_value(&cx) } else { low };
            return S::Case.{ id: self.id(&cx), kind: S::CaseKind::Value, path: Option::None, binders: Option::None, low: Option::Some.(low), high: Option::Some.(high), pos: start };
        }
        let path = self.expr_path(&cx);
        var binders = Option::None;
        if self.eat(&cx, "(") {
            let names: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
            var going = true;
            while going && !self.at(&cx, ")") {
                if !self.at(&cx, "NAME") && !self.at(&cx, "_") {
                    self.fail(&cx);
                }
                names.push(&cx, self.next(&cx).text);
                going = self.eat(&cx, ",");
            }
            let unit = self.expect(&cx, ")");
            if !names.is_empty(&cx) {
                binders = Option::Some.(names);
            }
        }
        S::Case.{ id: self.id(&cx), kind: S::CaseKind::Variant, path: Option::Some.(path), binders, low: Option::None, high: Option::None, pos: start }
    }

    fn lit_value(self, &cx: Domain!['k]) -> S::Lit['k] {
        let negative = self.eat(&cx, "-");
        if !self.at(&cx, "INT") && !self.at(&cx, "BYTE") {
            self.fail(&cx);
        }
        let value = self.literal(&cx);
        let { negative: unsigned, ..rest } = value;
        S::Lit.{ negative, ..rest }
    }

    fn closure_expr(self, &cx: Domain!['k]) -> Expr['k] {
        let start = self.pos(&cx);
        let params: ArenaVec[S::ClosureParam['k], 'k] = ArenaVec::new(&cx);
        if !self.eat(&cx, "||") {
            let unit = self.expect(&cx, "|");
            var going = true;
            while going && !self.at(&cx, "|") {
                let lend = self.eat(&cx, "&");
                let name = self.name(&cx);
                let type = if self.eat(&cx, ":") { Option::Some.(self.ptype(&cx)) } else { Option::None };
                params.push(&cx, S::ClosureParam.{ lend, name, type });
                going = self.eat(&cx, ",");
            }
            let unit = self.expect(&cx, "|");
        }
        if self.eat(&cx, "->") {
            let ret = self.type(&cx);
            let body = Expr::Block.(self.block(&cx));
            return Expr::Closure.(S::Closure.{ id: self.id(&cx), params, ret: Option::Some.(ret), body: Ref::new(&cx, body), pos: start });
        }
        let body = self.expr(&cx);
        Expr::Closure.(S::Closure.{ id: self.id(&cx), params, ret: Option::None, body: Ref::new(&cx, body), pos: start })
    }

    fn oexpr(self, &cx: Domain!['k]) -> Expr['k] {
        self.level(&cx, 0usize, Option::None)
    }

    // An operator expression whose first operand, `first`, was already read.
    fn oexpr_from(self, &cx: Domain!['k], first: Expr['k]) -> Expr['k] {
        self.level(&cx, 0usize, Option::Some.(first))
    }

    fn level(self, &cx: Domain!['k], precedence: usize, first: Option[Expr['k]]) -> Expr['k] {
        if precedence == LEVELS {
            return self.cast(&cx, first);
        }
        let start = match first {
            Option::Some(e) => S::expr_pos(e),
            Option::None => self.pos(&cx),
        };
        var left = self.level(&cx, precedence + 1usize, first);
        var going = true;
        while going && level_has(&cx, precedence, self.k(&cx)) {
            let op = self.next(&cx).text;
            let right = self.level(&cx, precedence + 1usize, Option::None);
            left = Expr::Binop.(S::Binop.{ id: self.id(&cx), op, left: Ref::new(&cx, left), right: Ref::new(&cx, right), pos: start });
            // comparisons do not chain
            going = precedence != COMPARE;
        }
        left
    }

    fn cast(self, &cx: Domain!['k], first: Option[Expr['k]]) -> Expr['k] {
        let start = match first {
            Option::Some(e) => S::expr_pos(e),
            Option::None => self.pos(&cx),
        };
        var left = match first {
            Option::Some(e) => e,
            Option::None => self.unary(&cx),
        };
        while self.eat(&cx, "as") {
            let type = self.type(&cx);
            left = Expr::Cast.(S::Cast.{ id: self.id(&cx), value: Ref::new(&cx, left), type, pos: start });
        }
        left
    }

    fn unary(self, &cx: Domain!['k]) -> Expr['k] {
        let k = self.k(&cx);
        let start = self.pos(&cx);
        if k.is(&cx, "-") || k.is(&cx, "!") || k.is(&cx, "*") || k.is(&cx, "&") || k.is(&cx, "unsafe") {
            let unit = self.next(&cx);
            let operand = self.unary(&cx);
            return Expr::Unary.(S::Unary.{ id: self.id(&cx), op: k, operand: Ref::new(&cx, operand), pos: start });
        }
        self.postfix(&cx)
    }

    fn postfix(self, &cx: Domain!['k]) -> Expr['k] {
        let start = self.pos(&cx);
        var e = self.atom(&cx);
        var after_index = false;
        var going = true;
        while going {
            let k = self.k(&cx);
            if k.is(&cx, ".") {
                let unit = self.next(&cx);
                let name = self.name(&cx);
                e = Expr::Field.(S::Field.{ id: self.id(&cx), value: Ref::new(&cx, e), name, pos: start });
                after_index = false;
            } else if k.is(&cx, "(") {
                let unit = self.next(&cx);
                let args = self.exprs_until(&cx, ")");
                e = Expr::Call.(S::Call.{ id: self.id(&cx), callee: Ref::new(&cx, e), args, pos: start });
                after_index = false;
            } else if k.is(&cx, "?") {
                let unit = self.next(&cx);
                e = Expr::Try.(S::Node.{ id: self.id(&cx), value: Ref::new(&cx, e), pos: start });
                after_index = false;
            } else if k.is(&cx, "TUPLE_INDEX") && !after_index {
                // `p.0.1` is written `(p.0).1`
                let t = self.next(&cx);
                let index = parse_u64(&cx, t.text.skip(1usize)).unwrap_or(0u64) as usize;
                e = Expr::Index.(S::Index.{ id: self.id(&cx), value: Ref::new(&cx, e), index, pos: start });
                after_index = true;
            } else {
                going = false;
            }
        }
        e
    }

    // `expr ("," expr)* ","? close`, possibly empty; consumes `close`.
    fn exprs_until(self, &cx: Domain!['k], close: Slice[u8, 'static]) -> ArenaVec[Expr['k], 'k] {
        let out: ArenaVec[Expr['k], 'k] = ArenaVec::new(&cx);
        var going = true;
        while going && !self.at(&cx, close) {
            out.push(&cx, self.expr(&cx));
            going = self.eat(&cx, ",");
        }
        let unit = self.expect(&cx, close);
        out
    }

    fn atom(self, &cx: Domain!['k]) -> Expr['k] {
        let k = self.k(&cx);
        let start = self.pos(&cx);
        if k.is(&cx, "INT") || k.is(&cx, "FLOAT") || k.is(&cx, "BYTE") || k.is(&cx, "STRING") || k.is(&cx, "true") || k.is(&cx, "false") {
            return Expr::Lit.(self.literal(&cx));
        }
        if k.is(&cx, "FSTRING_START") {
            let unit = self.next(&cx);
            let parts: ArenaVec[S::Piece['k], 'k] = ArenaVec::one(&cx, S::Piece::Text.(unescape(&cx, self.expect(&cx, "FSTRING_TEXT").text)));
            while self.eat(&cx, "FSTRING_OPEN") {
                parts.push(&cx, S::Piece::Expr.(self.expr(&cx)));
                let unit = self.expect(&cx, "FSTRING_CLOSE");
                parts.push(&cx, S::Piece::Text.(unescape(&cx, self.expect(&cx, "FSTRING_TEXT").text)));
            }
            let unit = self.expect(&cx, "FSTRING_END");
            return Expr::FStr.(S::FStr.{ id: self.id(&cx), parts, pos: start });
        }
        if k.is(&cx, "(") {
            let unit = self.next(&cx);
            if self.eat(&cx, ")") {
                return Expr::Tuple.(S::Node.{ id: self.id(&cx), value: ArenaVec::new(&cx), pos: start });
            }
            let first = self.expr(&cx);
            if self.eat(&cx, ")") {
                return first;
            }
            let unit = self.expect(&cx, ",");
            let elems = self.exprs_until(&cx, ")");
            elems.insert(&cx, 0usize, first);
            return Expr::Tuple.(S::Node.{ id: self.id(&cx), value: elems, pos: start });
        }
        if k.is(&cx, "[") {
            let unit = self.next(&cx);
            let elems: ArenaVec[Expr['k], 'k] = ArenaVec::new(&cx);
            var fill = false;
            if !self.at(&cx, "]") {
                elems.push(&cx, self.expr(&cx));
                var going = true;
                while going && self.eat(&cx, ",") {
                    if self.at(&cx, "]") {
                        going = false;
                    } else if self.eat(&cx, "..") {
                        fill = true;
                        let unit = self.eat(&cx, ",");
                        going = false;
                    } else {
                        elems.push(&cx, self.expr(&cx));
                    }
                }
            }
            let unit = self.expect(&cx, "]");
            return Expr::Array.(S::ArrayLit.{ id: self.id(&cx), elems, fill, pos: start });
        }
        if k.is(&cx, "sizeof") {
            let unit = self.next(&cx);
            let unit = self.expect(&cx, "[");
            let type = self.type(&cx);
            let unit = self.expect(&cx, "]");
            let unit = self.expect(&cx, "(");
            let unit = self.expect(&cx, ")");
            return Expr::Sizeof.(S::Node.{ id: self.id(&cx), value: type, pos: start });
        }
        let path = self.expr_path(&cx);
        if self.eat(&cx, ".{") {
            let fields: ArenaVec[S::FieldInit['k], 'k] = ArenaVec::new(&cx);
            var spread = Option::None;
            if self.at(&cx, "..") {
                spread = Option::Some.(self.spread(&cx));
            } else if !self.at(&cx, "}") {
                fields.push(&cx, self.field_init(&cx));
                var going = true;
                while going && self.eat(&cx, ",") {
                    if self.at(&cx, "}") {
                        going = false;
                    } else if self.at(&cx, "..") {
                        spread = Option::Some.(self.spread(&cx));
                        let unit = self.eat(&cx, ",");
                        going = false;
                    } else {
                        fields.push(&cx, self.field_init(&cx));
                    }
                }
            }
            let unit = self.expect(&cx, "}");
            return Expr::StructLit.(S::StructLit.{ id: self.id(&cx), path, fields, spread, pos: start });
        }
        if self.eat(&cx, ".(") {
            let args = self.exprs_until(&cx, ")");
            return Expr::Call.(S::Call.{ id: self.id(&cx), callee: Ref::new(&cx, Expr::Path.(path)), args, pos: start });
        }
        Expr::Path.(path)
    }

    fn field_init(self, &cx: Domain!['k]) -> S::FieldInit['k] {
        let name = self.name(&cx);
        let value = if self.eat(&cx, ":") { Option::Some.(self.expr(&cx)) } else { Option::None };
        S::FieldInit.{ name, value }
    }

    fn expr_path(self, &cx: Domain!['k]) -> S::Path['k] {
        let start = self.pos(&cx);
        let segments: ArenaVec[S::Segment['k], 'k] = ArenaVec::new(&cx);
        var going = true;
        while going {
            if !self.at(&cx, "NAME") && !self.at(&cx, "self") {
                self.fail(&cx);
            }
            let name = self.next(&cx).text;
            let linear = self.eat(&cx, "!");
            let args = if self.eat(&cx, "[") {
                let parsed = self.type_args(&cx);
                let unit = self.expect(&cx, "]");
                parsed.args
            } else {
                ArenaVec::new(&cx)
            };
            segments.push(&cx, S::Segment.{ name, linear, args });
            going = self.eat(&cx, "::");
        }
        S::Path.{ id: self.id(&cx), segments, pos: start }
    }

    fn literal(self, &cx: Domain!['k]) -> S::Lit['k] {
        let k = self.k(&cx);
        if !(k.is(&cx, "INT") || k.is(&cx, "FLOAT") || k.is(&cx, "BYTE") || k.is(&cx, "STRING") || k.is(&cx, "true") || k.is(&cx, "false")) {
            self.fail(&cx);
        }
        let tok = self.next(&cx);
        let p = Pos.{ line: tok.line, col: tok.col };
        let word = tok.text;
        let id = self.id(&cx);
        if k.is(&cx, "INT") {
            let (digits, suffix) = split_int_suffix(&cx, word);
            let (value, ok) = int_value(&cx, digits);
            if !ok {
                fail(&cx, Buffer::new().push_bytes(&cx, self.file).push_static(":").push_u64(tok.line as u64).push_static(":").push_u64(tok.col as u64).push_static(": integer literal out of range").save(&cx));
            }
            return S::Lit.{ id, kind: S::LitKind::Int, int: value, negative: false, text: word, suffix, pos: p };
        }
        if k.is(&cx, "FLOAT") {
            let (digits, suffix) = if word.ends_with(&cx, Span::from_static(&cx, "f32")) || word.ends_with(&cx, Span::from_static(&cx, "f64")) {
                (word.slice(0usize, word.len() - 3usize), Option::Some.(word.skip(word.len() - 3usize)))
            } else {
                (word, Option::None)
            };
            return S::Lit.{ id, kind: S::LitKind::Float, int: 0u64, negative: false, text: without_underscores(&cx, digits), suffix, pos: p };
        }
        if k.is(&cx, "BYTE") {
            let byte = unescape(&cx, word.slice(2usize, word.len() - 1usize));
            return S::Lit.{ id, kind: S::LitKind::Int, int: byte.byte_or_zero(&cx, 0usize) as u64, negative: false, text: word, suffix: Option::Some.(Span::from_static(&cx, "u8")), pos: p };
        }
        if k.is(&cx, "STRING") {
            return S::Lit.{ id, kind: S::LitKind::Str, int: 0u64, negative: false, text: unescape(&cx, word.slice(1usize, word.len() - 1usize)), suffix: Option::None, pos: p };
        }
        S::Lit.{ id, kind: S::LitKind::Bool, int: if k.is(&cx, "true") { 1u64 } else { 0u64 }, negative: false, text: word, suffix: Option::None, pos: p }
    }
}

// The left side of `=`: a name, then fields and tuple elements (`x`, `self.n`, `(p.0).1`).
forall 'k.
fn assignable(&cx: Domain!['k], e: Expr['k]) -> bool {
    match e {
        Expr::Path(p) => p.segments.len(&cx) == 1usize && !p.segments.at(&cx, 0usize).linear && p.segments.at(&cx, 0usize).args.is_empty(&cx),
        Expr::Field(f) => assignable(&cx, f.value.copy(&cx)),
        Expr::Index(i) => assignable(&cx, i.value.copy(&cx)),
        _ => false,
    }
}

forall 'k.
fn split_int_suffix(&cx: Domain!['k], word: Span['k]) -> (Span['k], Option[Span['k]]) {
    let suffixes = Span::from_static(&cx, "isize usize i8 i16 i32 i64 u8 u16 u32 u64").split(&cx, Span::from_static(&cx, " "));
    var k = 0usize;
    var found = Option::None;
    while found.is_none() && k < suffixes.len(&cx) {
        if word.ends_with(&cx, suffixes.at(&cx, k)) {
            found = Option::Some.(suffixes.at(&cx, k));
        }
        k = k + 1usize;
    }
    match found {
        Option::Some(s) => (word.slice(0usize, word.len() - s.len()), Option::Some.(s)),
        Option::None => (word, Option::None),
    }
}

forall 'k.
fn without_underscores(&cx: Domain!['k], word: Span['k]) -> Span['k] {
    var out = Buffer::new();
    var i = 0usize;
    while i < word.len() {
        if word.byte_or_zero(&cx, i) != b'_' {
            out = out.push_byte(word.byte_or_zero(&cx, i));
        }
        i = i + 1usize;
    }
    out.save(&cx)
}

// The value of decimal, `0x`, `0o` or `0b` digits; false when it does not fit in 64 bits.
forall 'k.
fn int_value(&cx: Domain!['k], word: Span['k]) -> (u64, bool) {
    let digits = without_underscores(&cx, word);
    let base = if digits.starts_with(&cx, Span::from_static(&cx, "0x")) { 16u64 } else if digits.starts_with(&cx, Span::from_static(&cx, "0o")) { 8u64 } else if digits.starts_with(&cx, Span::from_static(&cx, "0b")) { 2u64 } else { 10u64 };
    let body = if base == 10u64 { digits } else { digits.skip(2usize) };
    var value = 0u64;
    var ok = true;
    var i = 0usize;
    while i < body.len() {
        let b = body.byte_or_zero(&cx, i);
        let d = if b >= b'0' && b <= b'9' { (b - b'0') as u64 } else if b >= b'a' && b <= b'f' { (b - b'a') as u64 + 10u64 } else { (b - b'A') as u64 + 10u64 };
        if value > (18446744073709551615u64 - d) / base {
            ok = false;
        } else {
            value = value * base + d;
        }
        i = i + 1usize;
    }
    (value, ok)
}

// The bytes `\n`, `\t`, `\r`, `\0`, `\\`, `\'`, `\"` and `\xHH` stand for.
forall 'k.
fn unescape(&cx: Domain!['k], raw: Span['k]) -> Span['k] {
    var out = Buffer::new();
    var i = 0usize;
    while i < raw.len() {
        let b = raw.byte_or_zero(&cx, i);
        if b == b'\\' && raw.byte_or_zero(&cx, i + 1usize) == b'x' {
            let (value, ok) = int_value(&cx, Buffer::new().push_static("0x").push_bytes(&cx, raw.slice(i + 2usize, i + 4usize)).save(&cx));
            out = out.push_byte(value as u8);
            i = i + 4usize;
        } else if b == b'\\' {
            let c = raw.byte_or_zero(&cx, i + 1usize);
            let byte = if c == b'n' {
                b'\n'
            } else if c == b't' {
                b'\t'
            } else if c == b'r' {
                b'\r'
            } else if c == b'0' {
                0u8
            } else if c == b'\\' || c == b'\'' || c == b'"' {
                c
            } else {
                fail(&cx, Buffer::new().push_static("unknown escape \\").push_bytes(&cx, raw.slice(i + 1usize, i + 2usize)).save(&cx))
            };
            out = out.push_byte(byte);
            i = i + 2usize;
        } else {
            out = out.push_byte(b);
            i = i + 1usize;
        }
    }
    out.save(&cx)
}
