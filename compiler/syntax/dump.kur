// A canonical text form of the parsed AST, for comparing this parser with the reference parser.
//
// A node prints as `(Class field ...)`, with the class names and field order of the reference's
// `syntax.py` dataclasses: a sequence as `[...]`, text as a quoted string with `\xHH` for any byte
// outside printable ASCII, nothing as `_`, a boolean as `#t` or `#f`, a position as `line:col`.

use std::collections::arena_vec::ArenaVec;
use std::raw::Span;
use std::arena::Domain!;
use std::buffer::Buffer!;
use std::fmt::Writer;
use package::syntax::ast as S;
use package::syntax::ast::{Expr, Pattern, Statement, Type};
use std::option::Option;

forall 'k.
fn str(&cx: Domain!['k], out: Buffer!, t: Span['k]) -> Buffer! {
    var out = out;
    out = out.write_byte(b'"');
    var i = 0usize;
    while i < t.len() {
        let b = t.byte_or_zero(&cx, i);
        if b == b'"' || b == b'\\' {
            out = out.write_byte(b'\\').write_byte(b);
        } else if b >= 32u8 && b < 127u8 {
            out = out.write_byte(b);
        } else {
            let digits = Span::from_static(&cx, "0123456789abcdef");
            out = out.put("\\x").write_byte(digits.byte_or_zero(&cx, (b / 16u8) as usize)).write_byte(digits.byte_or_zero(&cx, (b % 16u8) as usize));
        }
        i = i + 1usize;
    }
    out.write_byte(b'"')
}

forall 'k.
fn flag(&cx: Domain!['k], out: Buffer!, b: bool) -> Buffer! {
    out.put(if b { " #t" } else { " #f" })
}

forall 'k.
fn pos(&cx: Domain!['k], out: Buffer!, p: S::Pos) -> Buffer! {
    if p.line == 0u32 {
        out.put(" _")
    } else {
        out.put(" ").put(p.line).put(":").put(p.col)
    }
}

forall 'k.
fn texts(&cx: Domain!['k], out: Buffer!, ts: ArenaVec[Span['k], 'k]) -> Buffer! {
    var out = out;
    out = out.put(" [");
    var i = 0usize;
    while i < ts.len(&cx) {
        if i > 0usize {
            out = out.put(" ");
        }
        out = str(&cx, out, ts.at(&cx, i));
        i = i + 1usize;
    }
    out.put("]")
}

forall 'k.
fn opt_text(&cx: Domain!['k], out: Buffer!, t: Option[Span['k]]) -> Buffer! {
    match t {
        Some(v) => str(&cx, out.put(" "), v),
        None => out.put(" _"),
    }
}

forall 'k.
fn opt_path(&cx: Domain!['k], out: Buffer!, t: Option[ArenaVec[Span['k], 'k]]) -> Buffer! {
    match t {
        Some(v) => texts(&cx, out, v),
        None => out.put(" _"),
    }
}

forall 'k.
fn types(&cx: Domain!['k], out: Buffer!, ts: ArenaVec[Type['k], 'k]) -> Buffer! {
    var out = out;
    out = out.put(" [");
    var i = 0usize;
    while i < ts.len(&cx) {
        out = ty(&cx, out.put(if i > 0usize { " " } else { "" }), ts.at(&cx, i));
        i = i + 1usize;
    }
    out.put("]")
}

forall 'k.
fn opt_type(&cx: Domain!['k], out: Buffer!, t: Option[Type['k]]) -> Buffer! {
    match t {
        Some(v) => ty(&cx, out.put(" "), v),
        None => out.put(" _"),
    }
}

forall 'k.
fn slots(&cx: Domain!['k], out: Buffer!, ss: ArenaVec[S::Slot['k], 'k]) -> Buffer! {
    var out = out;
    out = out.put(" [");
    var i = 0usize;
    while i < ss.len(&cx) {
        let s = ss.at(&cx, i);
        out = ty(&cx, flag(&cx, out.put(if i > 0usize { " [" } else { "[" }), s.lend).put(" "), s.ty).put("]");
        i = i + 1usize;
    }
    out.put("]")
}

forall 'k.
fn ty(&cx: Domain!['k], out: Buffer!, t: Type['k]) -> Buffer! {
    var out = out;
    match t {
        Name(n) => types(&cx, texts(&cx, out.put("(TName"), n.path), n.args).put(" ").put(n.determined).put(")"),
        Ptr(inner) => ty(&cx, out.put("(TPtr "), inner.copy(&cx)).put(")"),
        Never => out.put("(TNever)"),
        Tuple(elems) => types(&cx, out.put("(TTuple"), elems).put(")"),
        Array(elem, length) => expr(&cx, ty(&cx, out.put("(TArray "), elem.copy(&cx)).put(" "), length.copy(&cx)).put(")"),
        Fn(f) => flag(&cx, ty(&cx, slots(&cx, out.put("(TFn"), f.params).put(" "), f.ret.copy(&cx)), f.is_unsafe).put(")"),
        Closure(c) => {
            out = match c.env {
                Some(env) => ty(&cx, out.put("(TClosure "), env.copy(&cx)),
                None => out.put("(TClosure _"),
            };
            ty(&cx, slots(&cx, out, c.params).put(" "), c.ret.copy(&cx)).put(")")
        },
        Exists(brands, _at, body) => ty(&cx, texts(&cx, out.put("(TExists"), brands).put(" "), body.copy(&cx)).put(")"),
        Foreach(f) => ty(&cx, ty(&cx, flag(&cx, str(&cx, out.put("(TForeach "), f.binder), f.indirect).put(" "), f.source.copy(&cx)).put(" "), f.body.copy(&cx)).put(")"),
        Brand(label) => str(&cx, out.put("(TBrand "), label).put(")"),
        Ignored(_at) => out.put("(TIgnored)"),
    }
}

forall 'k.
fn exprs(&cx: Domain!['k], out: Buffer!, es: ArenaVec[Expr['k], 'k]) -> Buffer! {
    var out = out;
    out = out.put(" [");
    var i = 0usize;
    while i < es.len(&cx) {
        out = expr(&cx, out.put(if i > 0usize { " " } else { "" }), es.at(&cx, i));
        i = i + 1usize;
    }
    out.put("]")
}

forall 'k.
fn opt_expr(&cx: Domain!['k], out: Buffer!, e: Option[Expr['k]]) -> Buffer! {
    match e {
        Some(v) => expr(&cx, out.put(" "), v),
        None => out.put(" _"),
    }
}

forall 'k.
fn lit(&cx: Domain!['k], out: Buffer!, l: S::Lit['k]) -> Buffer! {
    var out = out;
    out = match l.kind {
        Int => {
            out = out.put("(Lit \"int\" ");
            out = if l.negative && l.int != 0u64 { out.put("-") } else { out };
            out.put(l.int)
        },
        Float => str(&cx, out.put("(Lit \"float\" "), l.text),
        Str => str(&cx, out.put("(Lit \"str\" "), l.text),
        Bool => out.put(if l.int == 1u64 { "(Lit \"bool\" #t" } else { "(Lit \"bool\" #f" }),
    };
    pos(&cx, opt_text(&cx, out, l.suffix), l.pos).put(")")
}

forall 'k.
fn path(&cx: Domain!['k], out: Buffer!, p: S::Path['k]) -> Buffer! {
    var out = out;
    out = out.put("(Path [");
    var i = 0usize;
    while i < p.segments.len(&cx) {
        let s = p.segments.at(&cx, i);
        out = types(&cx, str(&cx, out.put(if i > 0usize { " [" } else { "[" }), s.name), s.args).put("]");
        i = i + 1usize;
    }
    pos(&cx, out.put("]"), p.pos).put(")")
}

forall 'k.
fn block(&cx: Domain!['k], out: Buffer!, b: S::Block['k]) -> Buffer! {
    var out = out;
    out = out.put("(Block [");
    var i = 0usize;
    while i < b.stmts.len(&cx) {
        out = statement(&cx, out.put(if i > 0usize { " " } else { "" }), b.stmts.at(&cx, i));
        i = i + 1usize;
    }
    out = out.put("]");
    out = match b.tail {
        Some(t) => expr(&cx, out.put(" "), t.copy(&cx)),
        None => out.put(" _"),
    };
    pos(&cx, out, b.pos).put(")")
}

forall 'k.
fn case(&cx: Domain!['k], out: Buffer!, c: S::Case['k]) -> Buffer! {
    var out = out;
    out = match c.kind {
        Variant => out.put("(Case \"variant\""),
        Wild => out.put("(Case \"wild\""),
        Value => out.put("(Case \"value\""),
    };
    out = match c.path {
        Some(p) => path(&cx, out.put(" "), p),
        None => out.put(" _"),
    };
    out = opt_path(&cx, out, c.binders);
    out = match c.low {
        Some(l) => lit(&cx, out.put(" "), l),
        None => out.put(" _"),
    };
    out = match c.high {
        Some(l) => lit(&cx, out.put(" "), l),
        None => out.put(" _"),
    };
    pos(&cx, out, c.pos).put(")")
}

forall 'k.
fn expr(&cx: Domain!['k], out: Buffer!, e: Expr['k]) -> Buffer! {
    var out = out;
    match e {
        Lit(l) => lit(&cx, out, l),
        FStr(f) => {
            out = out.put("(FStr [");
            var i = 0usize;
            while i < f.parts.len(&cx) {
                out = out.put(if i > 0usize { " " } else { "" });
                out = match f.parts.at(&cx, i) {
                    Text(t) => str(&cx, out, t),
                    Expr(x) => expr(&cx, out, x),
                };
                i = i + 1usize;
            }
            pos(&cx, out.put("]"), f.pos).put(")")
        },
        Path(p) => path(&cx, out, p),
        Tuple(n) => pos(&cx, exprs(&cx, out.put("(Tuple"), n.value), n.pos).put(")"),
        Array(a) => pos(&cx, flag(&cx, exprs(&cx, out.put("(Array"), a.elems), a.fill), a.pos).put(")"),
        StructLit(s) => {
            out = path(&cx, out.put("(StructLit "), s.path).put(" [");
            var i = 0usize;
            while i < s.fields.len(&cx) {
                let f = s.fields.at(&cx, i);
                out = opt_expr(&cx, str(&cx, out.put(if i > 0usize { " [" } else { "[" }), f.name), f.value).put("]");
                i = i + 1usize;
            }
            pos(&cx, opt_text(&cx, out.put("]"), s.spread), s.pos).put(")")
        },
        Block(b) => block(&cx, out, b),
        If(n) => {
            out = block(&cx, expr(&cx, out.put("(If "), n.cond.copy(&cx)).put(" "), n.then);
            out = match n.other {
                Some(o) => expr(&cx, out.put(" "), o.copy(&cx)),
                None => out.put(" _"),
            };
            pos(&cx, out, n.pos).put(")")
        },
        Match(m) => {
            out = expr(&cx, out.put("(Match "), m.scrutinee.copy(&cx)).put(" [");
            var i = 0usize;
            while i < m.arms.len(&cx) {
                let arm = m.arms.at(&cx, i);
                out = out.put(if i > 0usize { " (Arm [" } else { "(Arm [" });
                var k = 0usize;
                while k < arm.cases.len(&cx) {
                    out = case(&cx, out.put(if k > 0usize { " " } else { "" }), arm.cases.at(&cx, k));
                    k = k + 1usize;
                }
                out = pos(&cx, expr(&cx, out.put("] "), arm.body), arm.pos).put(")");
                i = i + 1usize;
            }
            pos(&cx, out.put("]"), m.pos).put(")")
        },
        Closure(c) => {
            out = out.put("(Closure [");
            var i = 0usize;
            while i < c.params.len(&cx) {
                let p = c.params.at(&cx, i);
                out = opt_type(&cx, str(&cx, flag(&cx, out.put(if i > 0usize { " [" } else { "[" }), p.lend).put(" "), p.name), p.ty).put("]");
                i = i + 1usize;
            }
            pos(&cx, expr(&cx, opt_type(&cx, out.put("]"), c.ret).put(" "), c.body.copy(&cx)), c.pos).put(")")
        },
        Return(n) => {
            out = out.put("(Return");
            out = match n.value {
                Some(v) => expr(&cx, out.put(" "), v.copy(&cx)),
                None => out.put(" _"),
            };
            pos(&cx, out, n.pos).put(")")
        },
        Pack(p) => pos(&cx, expr(&cx, texts(&cx, out.put("(Pack"), p.brands).put(" "), p.value.copy(&cx)), p.pos).put(")"),
        Foreach(f) => pos(&cx, block(&cx, expr(&cx, opt_text(&cx, str(&cx, out.put("(Foreach "), f.name), f.binder).put(" "), f.source.copy(&cx)).put(" "), f.body), f.pos).put(")"),
        Binop(b) => pos(&cx, expr(&cx, expr(&cx, str(&cx, out.put("(Binop "), b.op).put(" "), b.left.copy(&cx)).put(" "), b.right.copy(&cx)), b.pos).put(")"),
        Unary(u) => pos(&cx, expr(&cx, str(&cx, out.put("(Unary "), u.op).put(" "), u.operand.copy(&cx)), u.pos).put(")"),
        Cast(c) => pos(&cx, ty(&cx, expr(&cx, out.put("(Cast "), c.value.copy(&cx)).put(" "), c.ty), c.pos).put(")"),
        UnsafeStore(s) => pos(&cx, expr(&cx, expr(&cx, out.put("(UnsafeStore "), s.pointer.copy(&cx)).put(" "), s.value.copy(&cx)), s.pos).put(")"),
        Field(f) => pos(&cx, str(&cx, expr(&cx, out.put("(Field "), f.value.copy(&cx)).put(" "), f.name), f.pos).put(")"),
        Index(x) => pos(&cx, expr(&cx, out.put("(Index "), x.value.copy(&cx)).put(" ").put(x.index), x.pos).put(")"),
        Call(c) => pos(&cx, flag(&cx, exprs(&cx, expr(&cx, out.put("(Call "), c.callee.copy(&cx)), c.args), c.construct), c.pos).put(")"),
        Try(n) => pos(&cx, expr(&cx, out.put("(Try "), n.value.copy(&cx)), n.pos).put(")"),
        While(w) => pos(&cx, block(&cx, expr(&cx, out.put("(While "), w.cond.copy(&cx)).put(" "), w.body), w.pos).put(")"),
        For(f) => pos(&cx, block(&cx, expr(&cx, str(&cx, out.put("(For "), f.name).put(" "), f.iterator.copy(&cx)).put(" "), f.body), f.pos).put(")"),
    }
}

forall 'k.
fn pattern(&cx: Domain!['k], out: Buffer!, p: Pattern['k]) -> Buffer! {
    var out = out;
    match p {
        Bind(n) => str(&cx, out.put("(PBind "), n.value).put(")"),
        Wild(id) => out.put("(PWild)"),
        Tuple(n) => patterns(&cx, out.put("(PTuple"), n.value).put(")"),
        Array(n) => patterns(&cx, out.put("(PArray"), n.value).put(")"),
        Struct(s) => {
            out = out.put("(PStruct [");
            var i = 0usize;
            while i < s.fields.len(&cx) {
                let f = s.fields.at(&cx, i);
                out = pattern(&cx, str(&cx, out.put(if i > 0usize { " [" } else { "[" }), f.name).put(" "), f.pattern).put("]");
                i = i + 1usize;
            }
            opt_text(&cx, out.put("]"), s.rest).put(")")
        },
    }
}

forall 'k.
fn patterns(&cx: Domain!['k], out: Buffer!, ps: ArenaVec[Pattern['k], 'k]) -> Buffer! {
    var out = out;
    out = out.put(" [");
    var i = 0usize;
    while i < ps.len(&cx) {
        out = pattern(&cx, out.put(if i > 0usize { " " } else { "" }), ps.at(&cx, i));
        i = i + 1usize;
    }
    out.put("]")
}

forall 'k.
fn statement(&cx: Domain!['k], out: Buffer!, s: Statement['k]) -> Buffer! {
    match s {
        Let(l) => pos(&cx, flag(&cx, texts(&cx, expr(&cx, opt_type(&cx, pattern(&cx, out.put("(Let "), l.pattern), l.ty).put(" "), l.value), l.brands), l.mutable), l.pos).put(")"),
        Assign(a) => pos(&cx, expr(&cx, expr(&cx, out.put("(Assign "), a.target).put(" "), a.value), a.pos).put(")"),
        Expr(n) => pos(&cx, expr(&cx, out.put("(ExprStmt "), n.value), n.pos).put(")"),
        Const(c) => const_decl(&cx, out, c),
    }
}

forall 'k.
fn type_args(&cx: Domain!['k], out: Buffer!, a: S::TypeArgs['k]) -> Buffer! {
    types(&cx, out.put("(TypeArgs"), a.args).put(" ").put(a.determined).put(")")
}

forall 'k.
fn quantifier(&cx: Domain!['k], out: Buffer!, q: Option[S::Forall['k]]) -> Buffer! {
    var out = out;
    match q {
        Some(f) => {
            out = texts(&cx, texts(&cx, out.put(" (Forall"), f.params), f.determined).put(" [");
            var i = 0usize;
            while i < f.premises.len(&cx) {
                let p = f.premises.at(&cx, i);
                out = type_args(&cx, texts(&cx, out.put(if i > 0usize { " [" } else { "[" }), p.trait_path).put(" "), p.args).put("]");
                i = i + 1usize;
            }
            out.put("])")
        },
        None => out.put(" _"),
    }
}

forall 'k.
fn params(&cx: Domain!['k], out: Buffer!, ps: ArenaVec[S::Param['k], 'k]) -> Buffer! {
    var out = out;
    out = out.put(" [");
    var i = 0usize;
    while i < ps.len(&cx) {
        let p = ps.at(&cx, i);
        out = flag(&cx, opt_type(&cx, str(&cx, out.put(if i > 0usize { " (Param " } else { "(Param " }), p.name), p.ty), p.lend).put(")");
        i = i + 1usize;
    }
    out.put("]")
}

forall 'k.
fn exposure(&cx: Domain!['k], out: Buffer!, e: Option[S::Exposed['k]]) -> Buffer! {
    match e {
        Some(x) => opt_path(&cx, out.put(" (Exposed"), x.scope).put(")"),
        None => out.put(" _"),
    }
}

forall 'k.
fn use_tree(&cx: Domain!['k], out: Buffer!, t: S::UseTree['k]) -> Buffer! {
    var out = out;
    out = flag(&cx, texts(&cx, out.put("["), t.path), t.star).put(" [");
    var i = 0usize;
    while i < t.children.len(&cx) {
        out = use_tree(&cx, out.put(if i > 0usize { " " } else { "" }), t.children.at(&cx, i));
        i = i + 1usize;
    }
    opt_text(&cx, out.put("]"), t.alias).put(" [").put(t.pos.line).put(" ").put(t.pos.col).put("]]")
}

forall 'k.
fn function(&cx: Domain!['k], out: Buffer!, f: S::Fn['k]) -> Buffer! {
    var out = out;
    out = opt_type(&cx, params(&cx, str(&cx, out.put("(Fn "), f.name), f.params), f.ret);
    out = match f.body {
        Some(b) => block(&cx, out.put(" "), b),
        None => out.put(" _"),
    };
    pos(&cx, quantifier(&cx, flag(&cx, out, f.is_unsafe), f.quantifier), f.pos).put(")")
}

forall 'k.
fn const_decl(&cx: Domain!['k], out: Buffer!, c: S::Const['k]) -> Buffer! {
    pos(&cx, expr(&cx, ty(&cx, str(&cx, out.put("(Const "), c.name).put(" "), c.ty).put(" "), c.value), c.pos).put(")")
}

forall 'k.
fn item(&cx: Domain!['k], out: Buffer!, it: S::Item['k]) -> Buffer! {
    var out = out;
    match it {
        Use(u) => pos(&cx, flag(&cx, use_tree(&cx, out.put("(Use "), u.tree), u.is_export), u.pos).put(")"),
        Struct(s) => {
            out = str(&cx, out.put("(Struct "), s.name).put(" [");
            var i = 0usize;
            while i < s.fields.len(&cx) {
                let f = s.fields.at(&cx, i);
                out = ty(&cx, str(&cx, out.put(if i > 0usize { " [" } else { "[" }), f.name).put(" "), f.ty).put("]");
                i = i + 1usize;
            }
            pos(&cx, quantifier(&cx, exposure(&cx, out.put("]"), s.exposure), s.quantifier), s.pos).put(")")
        },
        Tuple(t) => pos(&cx, quantifier(&cx, exposure(&cx, types(&cx, str(&cx, out.put("(TupleDecl "), t.name), t.elems), t.exposure), t.quantifier), t.pos).put(")"),
        Enum(e) => {
            out = str(&cx, out.put("(EnumDecl "), e.name).put(" [");
            var i = 0usize;
            while i < e.variants.len(&cx) {
                let v = e.variants.at(&cx, i);
                out = types(&cx, str(&cx, out.put(if i > 0usize { " [" } else { "[" }), v.name), v.payload).put("]");
                i = i + 1usize;
            }
            pos(&cx, quantifier(&cx, exposure(&cx, out.put("]"), e.exposure), e.quantifier), e.pos).put(")")
        },
        Alias(a) => pos(&cx, quantifier(&cx, exposure(&cx, ty(&cx, str(&cx, out.put("(TypeAlias "), a.name).put(" "), a.body), a.exposure), a.quantifier), a.pos).put(")"),
        Fn(f) => function(&cx, out, f),
        Extern(x) => pos(&cx, opt_type(&cx, params(&cx, str(&cx, str(&cx, out.put("(Extern "), x.abi).put(" "), x.name), x.params), x.ret), x.pos).put(")"),
        Const(c) => const_decl(&cx, out, c),
        Impl(m) => {
            out = ty(&cx, out.put("(Impl "), m.ty).put(" [");
            var i = 0usize;
            while i < m.items.len(&cx) {
                out = out.put(if i > 0usize { " " } else { "" });
                out = match m.items.at(&cx, i) {
                    Fn(f) => function(&cx, out, f),
                    Const(c) => const_decl(&cx, out, c),
                };
                i = i + 1usize;
            }
            pos(&cx, quantifier(&cx, out.put("]"), m.quantifier), m.pos).put(")")
        },
        Trait(t) => pos(&cx, quantifier(&cx, functions(&cx, str(&cx, out.put("(TraitDecl "), t.name), t.methods), t.quantifier), t.pos).put(")"),
        Instance(n) => pos(&cx, quantifier(&cx, functions(&cx, ty(&cx, out.put("(InstanceDecl "), n.ty), n.methods), n.quantifier), n.pos).put(")"),
    }
}

forall 'k.
fn functions(&cx: Domain!['k], out: Buffer!, fs: ArenaVec[S::Fn['k], 'k]) -> Buffer! {
    var out = out;
    out = out.put(" [");
    var i = 0usize;
    while i < fs.len(&cx) {
        out = function(&cx, out.put(if i > 0usize { " " } else { "" }), fs.at(&cx, i));
        i = i + 1usize;
    }
    out.put("]")
}

// One line per item.
forall 'k.
fn items(&cx: Domain!['k], items: ArenaVec[S::Item['k], 'k]) -> Span['k] {
    var out = Buffer!::new();
    var i = 0usize;
    while i < items.len(&cx) {
        out = item(&cx, out, items.at(&cx, i)).put("\n");
        i = i + 1usize;
    }
    out.save(&cx)
}
