// A canonical text form of the parsed AST, for comparing this parser with the reference parser.
//
// A node prints as `(Class field ...)`, with the class names and field order of the reference's
// `syntax.py` dataclasses: a sequence as `[...]`, text as a quoted string with `\xHH` for any byte
// outside printable ASCII, nothing as `_`, a boolean as `#t` or `#f`, a position as `line:col`.

use package::support::base::{Cx, Seq, Text, text, text_of};
use std::bytes::buffer::Buffer;
use package::syntax::ast as S;
use package::syntax::ast::{Expr, Pattern, Statement, Type};
use std::option::Option;

forall 'k.
fn str(&cx: Cx!['k], out: Buffer!, t: Text['k]) -> Buffer! {
    var out = out;
    out = out.push_byte(b'"');
    var i = 0usize;
    while i < t.len() {
        let b = t.byte(&cx, i);
        if b == b'"' || b == b'\\' {
            out = out.push_byte(b'\\').push_byte(b);
        } else if b >= 32u8 && b < 127u8 {
            out = out.push_byte(b);
        } else {
            let digits = text(&cx, "0123456789abcdef");
            out = out.push_static("\\x").push_byte(digits.byte(&cx, (b / 16u8) as usize)).push_byte(digits.byte(&cx, (b % 16u8) as usize));
        }
        i = i + 1usize;
    }
    out.push_byte(b'"')
}

forall 'k.
fn flag(&cx: Cx!['k], out: Buffer!, b: bool) -> Buffer! {
    out.push_static(if b { " #t" } else { " #f" })
}

forall 'k.
fn pos(&cx: Cx!['k], out: Buffer!, p: S::Pos) -> Buffer! {
    if p.line == 0u32 {
        out.push_static(" _")
    } else {
        out.push_static(" ").push_u64(p.line as u64).push_static(":").push_u64(p.col as u64)
    }
}

forall 'k.
fn texts(&cx: Cx!['k], out: Buffer!, ts: Seq[Text['k], 'k]) -> Buffer! {
    var out = out;
    out = out.push_static(" [");
    var i = 0usize;
    while i < ts.len(&cx) {
        if i > 0usize {
            out = out.push_static(" ");
        }
        out = str(&cx, out, ts.get(&cx, i));
        i = i + 1usize;
    }
    out.push_static("]")
}

forall 'k.
fn opt_text(&cx: Cx!['k], out: Buffer!, t: Option[Text['k]]) -> Buffer! {
    match t {
        Option::Some(v) => str(&cx, out.push_static(" "), v),
        Option::None => out.push_static(" _"),
    }
}

forall 'k.
fn opt_path(&cx: Cx!['k], out: Buffer!, t: Option[Seq[Text['k], 'k]]) -> Buffer! {
    match t {
        Option::Some(v) => texts(&cx, out, v),
        Option::None => out.push_static(" _"),
    }
}

forall 'k.
fn types(&cx: Cx!['k], out: Buffer!, ts: Seq[Type['k], 'k]) -> Buffer! {
    var out = out;
    out = out.push_static(" [");
    var i = 0usize;
    while i < ts.len(&cx) {
        out = type(&cx, out.push_static(if i > 0usize { " " } else { "" }), ts.get(&cx, i));
        i = i + 1usize;
    }
    out.push_static("]")
}

forall 'k.
fn opt_type(&cx: Cx!['k], out: Buffer!, t: Option[Type['k]]) -> Buffer! {
    match t {
        Option::Some(v) => type(&cx, out.push_static(" "), v),
        Option::None => out.push_static(" _"),
    }
}

forall 'k.
fn slots(&cx: Cx!['k], out: Buffer!, ss: Seq[S::Slot['k], 'k]) -> Buffer! {
    var out = out;
    out = out.push_static(" [");
    var i = 0usize;
    while i < ss.len(&cx) {
        let s = ss.get(&cx, i);
        out = type(&cx, flag(&cx, out.push_static(if i > 0usize { " [" } else { "[" }), s.lend).push_static(" "), s.type).push_static("]");
        i = i + 1usize;
    }
    out.push_static("]")
}

forall 'k.
fn type(&cx: Cx!['k], out: Buffer!, t: Type['k]) -> Buffer! {
    var out = out;
    match t {
        Type::Name(n) => types(&cx, texts(&cx, out.push_static("(TName"), n.path).push_static(if n.linear { " #t" } else { " #f" }), n.args).push_static(" ").push_usize(n.determined).push_static(")"),
        Type::Ptr(inner) => type(&cx, out.push_static("(TPtr "), inner.get(&cx)).push_static(")"),
        Type::Never => out.push_static("(TNever)"),
        Type::Tuple(elems) => types(&cx, out.push_static("(TTuple"), elems).push_static(")"),
        Type::Array(elem, length) => expr(&cx, type(&cx, out.push_static("(TArray "), elem.get(&cx)).push_static(" "), length.get(&cx)).push_static(")"),
        Type::Fn(f) => flag(&cx, type(&cx, slots(&cx, out.push_static("(TFn"), f.params).push_static(" "), f.ret.get(&cx)), f.is_unsafe).push_static(")"),
        Type::Closure(c) => {
            out = match c.env {
                Option::Some(env) => type(&cx, out.push_static("(TClosure "), env.get(&cx)),
                Option::None => out.push_static("(TClosure _"),
            };
            type(&cx, slots(&cx, out, c.params).push_static(" "), c.ret.get(&cx)).push_static(")")
        },
        Type::Exists(brands, body) => type(&cx, texts(&cx, out.push_static("(TExists"), brands).push_static(" "), body.get(&cx)).push_static(")"),
        Type::Foreach(f) => type(&cx, type(&cx, flag(&cx, str(&cx, out.push_static("(TForeach "), f.binder), f.indirect).push_static(" "), f.source.get(&cx)).push_static(" "), f.body.get(&cx)).push_static(")"),
        Type::Forall(params, body) => type(&cx, texts(&cx, out.push_static("(TForall"), params).push_static(" "), body.get(&cx)).push_static(")"),
        Type::Brand(label) => str(&cx, out.push_static("(TBrand "), label).push_static(")"),
        Type::Ignored => out.push_static("(TIgnored)"),
    }
}

forall 'k.
fn exprs(&cx: Cx!['k], out: Buffer!, es: Seq[Expr['k], 'k]) -> Buffer! {
    var out = out;
    out = out.push_static(" [");
    var i = 0usize;
    while i < es.len(&cx) {
        out = expr(&cx, out.push_static(if i > 0usize { " " } else { "" }), es.get(&cx, i));
        i = i + 1usize;
    }
    out.push_static("]")
}

forall 'k.
fn opt_expr(&cx: Cx!['k], out: Buffer!, e: Option[Expr['k]]) -> Buffer! {
    match e {
        Option::Some(v) => expr(&cx, out.push_static(" "), v),
        Option::None => out.push_static(" _"),
    }
}

forall 'k.
fn lit(&cx: Cx!['k], out: Buffer!, l: S::Lit['k]) -> Buffer! {
    var out = out;
    out = match l.kind {
        S::LitKind::Int => {
            out = out.push_static("(Lit \"int\" ");
            out = if l.negative && l.int != 0u64 { out.push_static("-") } else { out };
            out.push_u64(l.int)
        },
        S::LitKind::Float => str(&cx, out.push_static("(Lit \"float\" "), l.text),
        S::LitKind::Str => str(&cx, out.push_static("(Lit \"str\" "), l.text),
        S::LitKind::Bool => out.push_static(if l.int == 1u64 { "(Lit \"bool\" #t" } else { "(Lit \"bool\" #f" }),
    };
    pos(&cx, opt_text(&cx, out, l.suffix), l.pos).push_static(")")
}

forall 'k.
fn path(&cx: Cx!['k], out: Buffer!, p: S::Path['k]) -> Buffer! {
    var out = out;
    out = out.push_static("(Path [");
    var i = 0usize;
    while i < p.segments.len(&cx) {
        let s = p.segments.get(&cx, i);
        out = types(&cx, flag(&cx, str(&cx, out.push_static(if i > 0usize { " [" } else { "[" }), s.name), s.linear), s.args).push_static("]");
        i = i + 1usize;
    }
    pos(&cx, out.push_static("]"), p.pos).push_static(")")
}

forall 'k.
fn block(&cx: Cx!['k], out: Buffer!, b: S::Block['k]) -> Buffer! {
    var out = out;
    out = out.push_static("(Block [");
    var i = 0usize;
    while i < b.stmts.len(&cx) {
        out = statement(&cx, out.push_static(if i > 0usize { " " } else { "" }), b.stmts.get(&cx, i));
        i = i + 1usize;
    }
    out = out.push_static("]");
    out = match b.tail {
        Option::Some(t) => expr(&cx, out.push_static(" "), t.get(&cx)),
        Option::None => out.push_static(" _"),
    };
    pos(&cx, out, b.pos).push_static(")")
}

forall 'k.
fn case(&cx: Cx!['k], out: Buffer!, c: S::Case['k]) -> Buffer! {
    var out = out;
    out = match c.kind {
        S::CaseKind::Variant => out.push_static("(Case \"variant\""),
        S::CaseKind::Wild => out.push_static("(Case \"wild\""),
        S::CaseKind::Value => out.push_static("(Case \"value\""),
    };
    out = match c.path {
        Option::Some(p) => path(&cx, out.push_static(" "), p),
        Option::None => out.push_static(" _"),
    };
    out = opt_path(&cx, out, c.binders);
    out = match c.low {
        Option::Some(l) => lit(&cx, out.push_static(" "), l),
        Option::None => out.push_static(" _"),
    };
    out = match c.high {
        Option::Some(l) => lit(&cx, out.push_static(" "), l),
        Option::None => out.push_static(" _"),
    };
    pos(&cx, out, c.pos).push_static(")")
}

forall 'k.
fn expr(&cx: Cx!['k], out: Buffer!, e: Expr['k]) -> Buffer! {
    var out = out;
    match e {
        Expr::Lit(l) => lit(&cx, out, l),
        Expr::FStr(f) => {
            out = out.push_static("(FStr [");
            var i = 0usize;
            while i < f.parts.len(&cx) {
                out = out.push_static(if i > 0usize { " " } else { "" });
                out = match f.parts.get(&cx, i) {
                    S::Piece::Text(t) => str(&cx, out, t),
                    S::Piece::Expr(x) => expr(&cx, out, x),
                };
                i = i + 1usize;
            }
            pos(&cx, out.push_static("]"), f.pos).push_static(")")
        },
        Expr::Path(p) => path(&cx, out, p),
        Expr::Tuple(n) => pos(&cx, exprs(&cx, out.push_static("(Tuple"), n.value), n.pos).push_static(")"),
        Expr::Array(a) => pos(&cx, flag(&cx, exprs(&cx, out.push_static("(Array"), a.elems), a.fill), a.pos).push_static(")"),
        Expr::Sizeof(n) => pos(&cx, type(&cx, out.push_static("(Sizeof "), n.value), n.pos).push_static(")"),
        Expr::StructLit(s) => {
            out = path(&cx, out.push_static("(StructLit "), s.path).push_static(" [");
            var i = 0usize;
            while i < s.fields.len(&cx) {
                let f = s.fields.get(&cx, i);
                out = opt_expr(&cx, str(&cx, out.push_static(if i > 0usize { " [" } else { "[" }), f.name), f.value).push_static("]");
                i = i + 1usize;
            }
            pos(&cx, opt_text(&cx, out.push_static("]"), s.spread), s.pos).push_static(")")
        },
        Expr::Block(b) => block(&cx, out, b),
        Expr::If(n) => {
            out = block(&cx, expr(&cx, out.push_static("(If "), n.cond.get(&cx)).push_static(" "), n.then);
            out = match n.other {
                Option::Some(o) => expr(&cx, out.push_static(" "), o.get(&cx)),
                Option::None => out.push_static(" _"),
            };
            pos(&cx, out, n.pos).push_static(")")
        },
        Expr::Match(m) => {
            out = expr(&cx, out.push_static("(Match "), m.scrutinee.get(&cx)).push_static(" [");
            var i = 0usize;
            while i < m.arms.len(&cx) {
                let arm = m.arms.get(&cx, i);
                out = out.push_static(if i > 0usize { " (Arm [" } else { "(Arm [" });
                var k = 0usize;
                while k < arm.cases.len(&cx) {
                    out = case(&cx, out.push_static(if k > 0usize { " " } else { "" }), arm.cases.get(&cx, k));
                    k = k + 1usize;
                }
                out = pos(&cx, expr(&cx, out.push_static("] "), arm.body), arm.pos).push_static(")");
                i = i + 1usize;
            }
            pos(&cx, out.push_static("]"), m.pos).push_static(")")
        },
        Expr::Closure(c) => {
            out = out.push_static("(Closure [");
            var i = 0usize;
            while i < c.params.len(&cx) {
                let p = c.params.get(&cx, i);
                out = opt_type(&cx, str(&cx, flag(&cx, out.push_static(if i > 0usize { " [" } else { "[" }), p.lend).push_static(" "), p.name), p.type).push_static("]");
                i = i + 1usize;
            }
            pos(&cx, expr(&cx, opt_type(&cx, out.push_static("]"), c.ret).push_static(" "), c.body.get(&cx)), c.pos).push_static(")")
        },
        Expr::Return(n) => {
            out = out.push_static("(Return");
            out = match n.value {
                Option::Some(v) => expr(&cx, out.push_static(" "), v.get(&cx)),
                Option::None => out.push_static(" _"),
            };
            pos(&cx, out, n.pos).push_static(")")
        },
        Expr::Pack(p) => pos(&cx, expr(&cx, texts(&cx, out.push_static("(Pack"), p.brands).push_static(" "), p.value.get(&cx)), p.pos).push_static(")"),
        Expr::Foreach(f) => pos(&cx, block(&cx, expr(&cx, opt_text(&cx, str(&cx, out.push_static("(Foreach "), f.name), f.binder).push_static(" "), f.source.get(&cx)).push_static(" "), f.body), f.pos).push_static(")"),
        Expr::Binop(b) => pos(&cx, expr(&cx, expr(&cx, str(&cx, out.push_static("(Binop "), b.op).push_static(" "), b.left.get(&cx)).push_static(" "), b.right.get(&cx)), b.pos).push_static(")"),
        Expr::Unary(u) => pos(&cx, expr(&cx, str(&cx, out.push_static("(Unary "), u.op).push_static(" "), u.operand.get(&cx)), u.pos).push_static(")"),
        Expr::Cast(c) => pos(&cx, type(&cx, expr(&cx, out.push_static("(Cast "), c.value.get(&cx)).push_static(" "), c.type), c.pos).push_static(")"),
        Expr::UnsafeStore(s) => pos(&cx, expr(&cx, expr(&cx, out.push_static("(UnsafeStore "), s.pointer.get(&cx)).push_static(" "), s.value.get(&cx)), s.pos).push_static(")"),
        Expr::Field(f) => pos(&cx, str(&cx, expr(&cx, out.push_static("(Field "), f.value.get(&cx)).push_static(" "), f.name), f.pos).push_static(")"),
        Expr::Index(x) => pos(&cx, expr(&cx, out.push_static("(Index "), x.value.get(&cx)).push_static(" ").push_usize(x.index), x.pos).push_static(")"),
        Expr::Call(c) => pos(&cx, exprs(&cx, expr(&cx, out.push_static("(Call "), c.callee.get(&cx)), c.args), c.pos).push_static(")"),
        Expr::Try(n) => pos(&cx, expr(&cx, out.push_static("(Try "), n.value.get(&cx)), n.pos).push_static(")"),
        Expr::While(w) => pos(&cx, block(&cx, expr(&cx, out.push_static("(While "), w.cond.get(&cx)).push_static(" "), w.body), w.pos).push_static(")"),
        Expr::For(f) => pos(&cx, block(&cx, expr(&cx, str(&cx, out.push_static("(For "), f.name).push_static(" "), f.iterator.get(&cx)).push_static(" "), f.body), f.pos).push_static(")"),
    }
}

forall 'k.
fn pattern(&cx: Cx!['k], out: Buffer!, p: Pattern['k]) -> Buffer! {
    var out = out;
    match p {
        Pattern::Bind(n) => str(&cx, out.push_static("(PBind "), n.value).push_static(")"),
        Pattern::Wild(id) => out.push_static("(PWild)"),
        Pattern::Tuple(n) => patterns(&cx, out.push_static("(PTuple"), n.value).push_static(")"),
        Pattern::Array(n) => patterns(&cx, out.push_static("(PArray"), n.value).push_static(")"),
        Pattern::Struct(s) => {
            out = out.push_static("(PStruct [");
            var i = 0usize;
            while i < s.fields.len(&cx) {
                let f = s.fields.get(&cx, i);
                out = pattern(&cx, str(&cx, out.push_static(if i > 0usize { " [" } else { "[" }), f.name).push_static(" "), f.pattern).push_static("]");
                i = i + 1usize;
            }
            opt_text(&cx, out.push_static("]"), s.rest).push_static(")")
        },
    }
}

forall 'k.
fn patterns(&cx: Cx!['k], out: Buffer!, ps: Seq[Pattern['k], 'k]) -> Buffer! {
    var out = out;
    out = out.push_static(" [");
    var i = 0usize;
    while i < ps.len(&cx) {
        out = pattern(&cx, out.push_static(if i > 0usize { " " } else { "" }), ps.get(&cx, i));
        i = i + 1usize;
    }
    out.push_static("]")
}

forall 'k.
fn statement(&cx: Cx!['k], out: Buffer!, s: Statement['k]) -> Buffer! {
    match s {
        Statement::Let(l) => pos(&cx, texts(&cx, expr(&cx, opt_type(&cx, pattern(&cx, out.push_static("(Let "), l.pattern), l.type).push_static(" "), l.value), l.brands), l.pos).push_static(")"),
        Statement::Var(v) => pos(&cx, expr(&cx, opt_type(&cx, str(&cx, out.push_static("(Var "), v.name), v.type).push_static(" "), v.value), v.pos).push_static(")"),
        Statement::Assign(a) => pos(&cx, expr(&cx, expr(&cx, out.push_static("(Assign "), a.target).push_static(" "), a.value), a.pos).push_static(")"),
        Statement::Expr(n) => pos(&cx, expr(&cx, out.push_static("(ExprStmt "), n.value), n.pos).push_static(")"),
        Statement::Const(c) => const_decl(&cx, out, c),
    }
}

forall 'k.
fn type_args(&cx: Cx!['k], out: Buffer!, a: S::TypeArgs['k]) -> Buffer! {
    types(&cx, out.push_static("(TypeArgs"), a.args).push_static(" ").push_usize(a.determined).push_static(")")
}

forall 'k.
fn quantifier(&cx: Cx!['k], out: Buffer!, q: Option[S::Forall['k]]) -> Buffer! {
    var out = out;
    match q {
        Option::Some(f) => {
            out = texts(&cx, texts(&cx, out.push_static(" (Forall"), f.params), f.determined).push_static(" [");
            var i = 0usize;
            while i < f.premises.len(&cx) {
                let p = f.premises.get(&cx, i);
                out = type_args(&cx, texts(&cx, out.push_static(if i > 0usize { " [" } else { "[" }), p.trait_path).push_static(" "), p.args).push_static("]");
                i = i + 1usize;
            }
            out.push_static("])")
        },
        Option::None => out.push_static(" _"),
    }
}

forall 'k.
fn params(&cx: Cx!['k], out: Buffer!, ps: Seq[S::Param['k], 'k]) -> Buffer! {
    var out = out;
    out = out.push_static(" [");
    var i = 0usize;
    while i < ps.len(&cx) {
        let p = ps.get(&cx, i);
        out = flag(&cx, opt_type(&cx, str(&cx, out.push_static(if i > 0usize { " (Param " } else { "(Param " }), p.name), p.type), p.lend).push_static(")");
        i = i + 1usize;
    }
    out.push_static("]")
}

forall 'k.
fn exposure(&cx: Cx!['k], out: Buffer!, e: Option[S::Exposed['k]]) -> Buffer! {
    match e {
        Option::Some(x) => opt_path(&cx, out.push_static(" (Exposed"), x.scope).push_static(")"),
        Option::None => out.push_static(" _"),
    }
}

forall 'k.
fn use_tree(&cx: Cx!['k], out: Buffer!, t: S::UseTree['k]) -> Buffer! {
    var out = out;
    out = flag(&cx, texts(&cx, out.push_static("["), t.path), t.star).push_static(" [");
    var i = 0usize;
    while i < t.children.len(&cx) {
        out = use_tree(&cx, out.push_static(if i > 0usize { " " } else { "" }), t.children.get(&cx, i));
        i = i + 1usize;
    }
    opt_text(&cx, out.push_static("]"), t.alias).push_static("]")
}

forall 'k.
fn function(&cx: Cx!['k], out: Buffer!, f: S::Fn['k]) -> Buffer! {
    var out = out;
    out = opt_type(&cx, params(&cx, str(&cx, out.push_static("(Fn "), f.name), f.params), f.ret);
    out = match f.body {
        Option::Some(b) => block(&cx, out.push_static(" "), b),
        Option::None => out.push_static(" _"),
    };
    pos(&cx, quantifier(&cx, flag(&cx, out, f.is_unsafe), f.quantifier), f.pos).push_static(")")
}

forall 'k.
fn const_decl(&cx: Cx!['k], out: Buffer!, c: S::Const['k]) -> Buffer! {
    pos(&cx, quantifier(&cx, expr(&cx, type(&cx, str(&cx, out.push_static("(Const "), c.name).push_static(" "), c.type).push_static(" "), c.value), c.quantifier), c.pos).push_static(")")
}

forall 'k.
fn item(&cx: Cx!['k], out: Buffer!, it: S::Item['k]) -> Buffer! {
    var out = out;
    match it {
        S::Item::Use(u) => pos(&cx, flag(&cx, use_tree(&cx, out.push_static("(Use "), u.tree), u.is_export), u.pos).push_static(")"),
        S::Item::Module(m) => pos(&cx, texts(&cx, out.push_static("(Module"), m.value), m.pos).push_static(")"),
        S::Item::Struct(s) => {
            out = flag(&cx, str(&cx, out.push_static("(Struct "), s.name), s.linear).push_static(" [");
            var i = 0usize;
            while i < s.fields.len(&cx) {
                let f = s.fields.get(&cx, i);
                out = type(&cx, str(&cx, out.push_static(if i > 0usize { " [" } else { "[" }), f.name).push_static(" "), f.type).push_static("]");
                i = i + 1usize;
            }
            pos(&cx, quantifier(&cx, exposure(&cx, out.push_static("]"), s.exposure), s.quantifier), s.pos).push_static(")")
        },
        S::Item::Tuple(t) => pos(&cx, quantifier(&cx, exposure(&cx, types(&cx, flag(&cx, str(&cx, out.push_static("(TupleDecl "), t.name), t.linear), t.elems), t.exposure), t.quantifier), t.pos).push_static(")"),
        S::Item::Enum(e) => {
            out = flag(&cx, str(&cx, out.push_static("(EnumDecl "), e.name), e.linear).push_static(" [");
            var i = 0usize;
            while i < e.variants.len(&cx) {
                let v = e.variants.get(&cx, i);
                out = types(&cx, str(&cx, out.push_static(if i > 0usize { " [" } else { "[" }), v.name), v.payload).push_static("]");
                i = i + 1usize;
            }
            pos(&cx, quantifier(&cx, exposure(&cx, out.push_static("]"), e.exposure), e.quantifier), e.pos).push_static(")")
        },
        S::Item::Fn(f) => function(&cx, out, f),
        S::Item::Extern(x) => pos(&cx, opt_type(&cx, params(&cx, str(&cx, str(&cx, out.push_static("(Extern "), x.abi).push_static(" "), x.name), x.params), x.ret), x.pos).push_static(")"),
        S::Item::Const(c) => const_decl(&cx, out, c),
        S::Item::Impl(m) => {
            out = type(&cx, out.push_static("(Impl "), m.type).push_static(" [");
            var i = 0usize;
            while i < m.items.len(&cx) {
                out = out.push_static(if i > 0usize { " " } else { "" });
                out = match m.items.get(&cx, i) {
                    S::Member::Fn(f) => function(&cx, out, f),
                    S::Member::Const(c) => const_decl(&cx, out, c),
                };
                i = i + 1usize;
            }
            pos(&cx, quantifier(&cx, out.push_static("]"), m.quantifier), m.pos).push_static(")")
        },
        S::Item::Trait(t) => pos(&cx, quantifier(&cx, functions(&cx, str(&cx, out.push_static("(TraitDecl "), t.name), t.methods), t.quantifier), t.pos).push_static(")"),
        S::Item::Instance(n) => pos(&cx, quantifier(&cx, flag(&cx, functions(&cx, type(&cx, out.push_static("(InstanceDecl "), n.type), n.methods), n.is_unsafe), n.quantifier), n.pos).push_static(")"),
    }
}

forall 'k.
fn functions(&cx: Cx!['k], out: Buffer!, fs: Seq[S::Fn['k], 'k]) -> Buffer! {
    var out = out;
    out = out.push_static(" [");
    var i = 0usize;
    while i < fs.len(&cx) {
        out = function(&cx, out.push_static(if i > 0usize { " " } else { "" }), fs.get(&cx, i));
        i = i + 1usize;
    }
    out.push_static("]")
}

// One line per item.
forall 'k.
fn items(&cx: Cx!['k], items: Seq[S::Item['k], 'k]) -> Text['k] {
    var out = Buffer::new();
    var i = 0usize;
    while i < items.len(&cx) {
        out = item(&cx, out, items.get(&cx, i)).push_static("\n");
        i = i + 1usize;
    }
    text_of(&cx, out)
}
