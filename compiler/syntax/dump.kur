// A canonical text form of the parsed AST, for comparing this parser with the reference parser.
//
// A node prints as `(Class field ...)`, with the class names and field order of the reference's
// `syntax.py` dataclasses: a sequence as `[...]`, text as a quoted string with `\xHH` for any byte
// outside printable ASCII, nothing as `_`, a boolean as `#t` or `#f`, a position as `line:col`.

use package::support::base::{Cx, Out, Seq, Text, text};
use package::syntax::ast as S;
use package::syntax::ast::{Expr, Pattern, Statement, Type};
use std::option::Option;

forall 'k.
fn str(&cx: Cx!['k], out: Out['k], t: Text['k]) -> Out['k] {
    let unit = out.byte(&cx, b'"');
    var i = 0usize;
    while i < t.len() {
        let b = t.byte(&cx, i);
        if b == b'"' || b == b'\\' {
            let unit = out.byte(&cx, b'\\').byte(&cx, b);
        } else if b >= 32u8 && b < 127u8 {
            let unit = out.byte(&cx, b);
        } else {
            let digits = text(&cx, "0123456789abcdef");
            let unit = out.put(&cx, "\\x").byte(&cx, digits.byte(&cx, (b / 16u8) as usize)).byte(&cx, digits.byte(&cx, (b % 16u8) as usize));
        }
        i = i + 1usize;
    }
    out.byte(&cx, b'"')
}

forall 'k.
fn flag(&cx: Cx!['k], out: Out['k], b: bool) -> Out['k] {
    out.put(&cx, if b { " #t" } else { " #f" })
}

forall 'k.
fn pos(&cx: Cx!['k], out: Out['k], p: S::Pos) -> Out['k] {
    if p.line == 0u32 {
        out.put(&cx, " _")
    } else {
        out.put(&cx, " ").u64(&cx, p.line as u64).put(&cx, ":").u64(&cx, p.col as u64)
    }
}

forall 'k.
fn texts(&cx: Cx!['k], out: Out['k], ts: Seq[Text['k], 'k]) -> Out['k] {
    let unit = out.put(&cx, " [");
    var i = 0usize;
    while i < ts.len(&cx) {
        if i > 0usize {
            let unit = out.put(&cx, " ");
        }
        let unit = str(&cx, out, ts.get(&cx, i));
        i = i + 1usize;
    }
    out.put(&cx, "]")
}

forall 'k.
fn opt_text(&cx: Cx!['k], out: Out['k], t: Option[Text['k]]) -> Out['k] {
    match t {
        Option::Some(v) => str(&cx, out.put(&cx, " "), v),
        Option::None => out.put(&cx, " _"),
    }
}

forall 'k.
fn opt_path(&cx: Cx!['k], out: Out['k], t: Option[Seq[Text['k], 'k]]) -> Out['k] {
    match t {
        Option::Some(v) => texts(&cx, out, v),
        Option::None => out.put(&cx, " _"),
    }
}

forall 'k.
fn types(&cx: Cx!['k], out: Out['k], ts: Seq[Type['k], 'k]) -> Out['k] {
    let unit = out.put(&cx, " [");
    var i = 0usize;
    while i < ts.len(&cx) {
        let unit = type(&cx, out.put(&cx, if i > 0usize { " " } else { "" }), ts.get(&cx, i));
        i = i + 1usize;
    }
    out.put(&cx, "]")
}

forall 'k.
fn opt_type(&cx: Cx!['k], out: Out['k], t: Option[Type['k]]) -> Out['k] {
    match t {
        Option::Some(v) => type(&cx, out.put(&cx, " "), v),
        Option::None => out.put(&cx, " _"),
    }
}

forall 'k.
fn slots(&cx: Cx!['k], out: Out['k], ss: Seq[S::Slot['k], 'k]) -> Out['k] {
    let unit = out.put(&cx, " [");
    var i = 0usize;
    while i < ss.len(&cx) {
        let s = ss.get(&cx, i);
        let unit = type(&cx, flag(&cx, out.put(&cx, if i > 0usize { " [" } else { "[" }), s.lend).put(&cx, " "), s.type).put(&cx, "]");
        i = i + 1usize;
    }
    out.put(&cx, "]")
}

forall 'k.
fn type(&cx: Cx!['k], out: Out['k], t: Type['k]) -> Out['k] {
    match t {
        Type::Name(n) => types(&cx, texts(&cx, out.put(&cx, "(TName"), n.path).put(&cx, if n.linear { " #t" } else { " #f" }), n.args).put(&cx, " ").usize(&cx, n.determined).put(&cx, ")"),
        Type::Ptr(inner) => type(&cx, out.put(&cx, "(TPtr "), inner.get(&cx)).put(&cx, ")"),
        Type::Never => out.put(&cx, "(TNever)"),
        Type::Tuple(elems) => types(&cx, out.put(&cx, "(TTuple"), elems).put(&cx, ")"),
        Type::Array(elem, length) => expr(&cx, type(&cx, out.put(&cx, "(TArray "), elem.get(&cx)).put(&cx, " "), length.get(&cx)).put(&cx, ")"),
        Type::Fn(f) => flag(&cx, type(&cx, slots(&cx, out.put(&cx, "(TFn"), f.params).put(&cx, " "), f.ret.get(&cx)), f.is_unsafe).put(&cx, ")"),
        Type::Closure(c) => {
            let unit = match c.env {
                Option::Some(env) => type(&cx, out.put(&cx, "(TClosure "), env.get(&cx)),
                Option::None => out.put(&cx, "(TClosure _"),
            };
            type(&cx, slots(&cx, out, c.params).put(&cx, " "), c.ret.get(&cx)).put(&cx, ")")
        },
        Type::Exists(brands, body) => type(&cx, texts(&cx, out.put(&cx, "(TExists"), brands).put(&cx, " "), body.get(&cx)).put(&cx, ")"),
        Type::Foreach(f) => type(&cx, type(&cx, flag(&cx, str(&cx, out.put(&cx, "(TForeach "), f.binder), f.indirect).put(&cx, " "), f.source.get(&cx)).put(&cx, " "), f.body.get(&cx)).put(&cx, ")"),
        Type::Forall(params, body) => type(&cx, texts(&cx, out.put(&cx, "(TForall"), params).put(&cx, " "), body.get(&cx)).put(&cx, ")"),
        Type::Brand(label) => str(&cx, out.put(&cx, "(TBrand "), label).put(&cx, ")"),
        Type::Ignored => out.put(&cx, "(TIgnored)"),
    }
}

forall 'k.
fn exprs(&cx: Cx!['k], out: Out['k], es: Seq[Expr['k], 'k]) -> Out['k] {
    let unit = out.put(&cx, " [");
    var i = 0usize;
    while i < es.len(&cx) {
        let unit = expr(&cx, out.put(&cx, if i > 0usize { " " } else { "" }), es.get(&cx, i));
        i = i + 1usize;
    }
    out.put(&cx, "]")
}

forall 'k.
fn opt_expr(&cx: Cx!['k], out: Out['k], e: Option[Expr['k]]) -> Out['k] {
    match e {
        Option::Some(v) => expr(&cx, out.put(&cx, " "), v),
        Option::None => out.put(&cx, " _"),
    }
}

forall 'k.
fn lit(&cx: Cx!['k], out: Out['k], l: S::Lit['k]) -> Out['k] {
    let unit = match l.kind {
        S::LitKind::Int => {
            let unit = out.put(&cx, "(Lit \"int\" ");
            let unit = if l.negative && l.int != 0u64 { out.put(&cx, "-") } else { out };
            out.u64(&cx, l.int)
        },
        S::LitKind::Float => str(&cx, out.put(&cx, "(Lit \"float\" "), l.text),
        S::LitKind::Str => str(&cx, out.put(&cx, "(Lit \"str\" "), l.text),
        S::LitKind::Bool => out.put(&cx, if l.int == 1u64 { "(Lit \"bool\" #t" } else { "(Lit \"bool\" #f" }),
    };
    pos(&cx, opt_text(&cx, out, l.suffix), l.pos).put(&cx, ")")
}

forall 'k.
fn path(&cx: Cx!['k], out: Out['k], p: S::Path['k]) -> Out['k] {
    let unit = out.put(&cx, "(Path [");
    var i = 0usize;
    while i < p.segments.len(&cx) {
        let s = p.segments.get(&cx, i);
        let unit = types(&cx, flag(&cx, str(&cx, out.put(&cx, if i > 0usize { " [" } else { "[" }), s.name), s.linear), s.args).put(&cx, "]");
        i = i + 1usize;
    }
    pos(&cx, out.put(&cx, "]"), p.pos).put(&cx, ")")
}

forall 'k.
fn block(&cx: Cx!['k], out: Out['k], b: S::Block['k]) -> Out['k] {
    let unit = out.put(&cx, "(Block [");
    var i = 0usize;
    while i < b.stmts.len(&cx) {
        let unit = statement(&cx, out.put(&cx, if i > 0usize { " " } else { "" }), b.stmts.get(&cx, i));
        i = i + 1usize;
    }
    let unit = out.put(&cx, "]");
    let unit = match b.tail {
        Option::Some(t) => expr(&cx, out.put(&cx, " "), t.get(&cx)),
        Option::None => out.put(&cx, " _"),
    };
    pos(&cx, out, b.pos).put(&cx, ")")
}

forall 'k.
fn case(&cx: Cx!['k], out: Out['k], c: S::Case['k]) -> Out['k] {
    let unit = match c.kind {
        S::CaseKind::Variant => out.put(&cx, "(Case \"variant\""),
        S::CaseKind::Wild => out.put(&cx, "(Case \"wild\""),
        S::CaseKind::Value => out.put(&cx, "(Case \"value\""),
    };
    let unit = match c.path {
        Option::Some(p) => path(&cx, out.put(&cx, " "), p),
        Option::None => out.put(&cx, " _"),
    };
    let unit = opt_path(&cx, out, c.binders);
    let unit = match c.low {
        Option::Some(l) => lit(&cx, out.put(&cx, " "), l),
        Option::None => out.put(&cx, " _"),
    };
    let unit = match c.high {
        Option::Some(l) => lit(&cx, out.put(&cx, " "), l),
        Option::None => out.put(&cx, " _"),
    };
    pos(&cx, out, c.pos).put(&cx, ")")
}

forall 'k.
fn expr(&cx: Cx!['k], out: Out['k], e: Expr['k]) -> Out['k] {
    match e {
        Expr::Lit(l) => lit(&cx, out, l),
        Expr::FStr(f) => {
            let unit = out.put(&cx, "(FStr [");
            var i = 0usize;
            while i < f.parts.len(&cx) {
                let unit = out.put(&cx, if i > 0usize { " " } else { "" });
                let unit = match f.parts.get(&cx, i) {
                    S::Piece::Text(t) => str(&cx, out, t),
                    S::Piece::Expr(x) => expr(&cx, out, x),
                };
                i = i + 1usize;
            }
            pos(&cx, out.put(&cx, "]"), f.pos).put(&cx, ")")
        },
        Expr::Path(p) => path(&cx, out, p),
        Expr::Tuple(n) => pos(&cx, exprs(&cx, out.put(&cx, "(Tuple"), n.value), n.pos).put(&cx, ")"),
        Expr::Array(a) => pos(&cx, flag(&cx, exprs(&cx, out.put(&cx, "(Array"), a.elems), a.fill), a.pos).put(&cx, ")"),
        Expr::Sizeof(n) => pos(&cx, type(&cx, out.put(&cx, "(Sizeof "), n.value), n.pos).put(&cx, ")"),
        Expr::StructLit(s) => {
            let unit = path(&cx, out.put(&cx, "(StructLit "), s.path).put(&cx, " [");
            var i = 0usize;
            while i < s.fields.len(&cx) {
                let f = s.fields.get(&cx, i);
                let unit = opt_expr(&cx, str(&cx, out.put(&cx, if i > 0usize { " [" } else { "[" }), f.name), f.value).put(&cx, "]");
                i = i + 1usize;
            }
            pos(&cx, opt_text(&cx, out.put(&cx, "]"), s.spread), s.pos).put(&cx, ")")
        },
        Expr::Block(b) => block(&cx, out, b),
        Expr::If(n) => {
            let unit = block(&cx, expr(&cx, out.put(&cx, "(If "), n.cond.get(&cx)).put(&cx, " "), n.then);
            let unit = match n.other {
                Option::Some(o) => expr(&cx, out.put(&cx, " "), o.get(&cx)),
                Option::None => out.put(&cx, " _"),
            };
            pos(&cx, out, n.pos).put(&cx, ")")
        },
        Expr::Match(m) => {
            let unit = expr(&cx, out.put(&cx, "(Match "), m.scrutinee.get(&cx)).put(&cx, " [");
            var i = 0usize;
            while i < m.arms.len(&cx) {
                let arm = m.arms.get(&cx, i);
                let unit = out.put(&cx, if i > 0usize { " (Arm [" } else { "(Arm [" });
                var k = 0usize;
                while k < arm.cases.len(&cx) {
                    let unit = case(&cx, out.put(&cx, if k > 0usize { " " } else { "" }), arm.cases.get(&cx, k));
                    k = k + 1usize;
                }
                let unit = pos(&cx, expr(&cx, out.put(&cx, "] "), arm.body), arm.pos).put(&cx, ")");
                i = i + 1usize;
            }
            pos(&cx, out.put(&cx, "]"), m.pos).put(&cx, ")")
        },
        Expr::Closure(c) => {
            let unit = out.put(&cx, "(Closure [");
            var i = 0usize;
            while i < c.params.len(&cx) {
                let p = c.params.get(&cx, i);
                let unit = opt_type(&cx, str(&cx, flag(&cx, out.put(&cx, if i > 0usize { " [" } else { "[" }), p.lend).put(&cx, " "), p.name), p.type).put(&cx, "]");
                i = i + 1usize;
            }
            pos(&cx, expr(&cx, opt_type(&cx, out.put(&cx, "]"), c.ret).put(&cx, " "), c.body.get(&cx)), c.pos).put(&cx, ")")
        },
        Expr::Return(n) => {
            let unit = out.put(&cx, "(Return");
            let unit = match n.value {
                Option::Some(v) => expr(&cx, out.put(&cx, " "), v.get(&cx)),
                Option::None => out.put(&cx, " _"),
            };
            pos(&cx, out, n.pos).put(&cx, ")")
        },
        Expr::Pack(p) => pos(&cx, expr(&cx, texts(&cx, out.put(&cx, "(Pack"), p.brands).put(&cx, " "), p.value.get(&cx)), p.pos).put(&cx, ")"),
        Expr::Foreach(f) => pos(&cx, block(&cx, expr(&cx, opt_text(&cx, str(&cx, out.put(&cx, "(Foreach "), f.name), f.binder).put(&cx, " "), f.source.get(&cx)).put(&cx, " "), f.body), f.pos).put(&cx, ")"),
        Expr::Binop(b) => pos(&cx, expr(&cx, expr(&cx, str(&cx, out.put(&cx, "(Binop "), b.op).put(&cx, " "), b.left.get(&cx)).put(&cx, " "), b.right.get(&cx)), b.pos).put(&cx, ")"),
        Expr::Unary(u) => pos(&cx, expr(&cx, str(&cx, out.put(&cx, "(Unary "), u.op).put(&cx, " "), u.operand.get(&cx)), u.pos).put(&cx, ")"),
        Expr::Cast(c) => pos(&cx, type(&cx, expr(&cx, out.put(&cx, "(Cast "), c.value.get(&cx)).put(&cx, " "), c.type), c.pos).put(&cx, ")"),
        Expr::UnsafeStore(s) => pos(&cx, expr(&cx, expr(&cx, out.put(&cx, "(UnsafeStore "), s.pointer.get(&cx)).put(&cx, " "), s.value.get(&cx)), s.pos).put(&cx, ")"),
        Expr::Field(f) => pos(&cx, str(&cx, expr(&cx, out.put(&cx, "(Field "), f.value.get(&cx)).put(&cx, " "), f.name), f.pos).put(&cx, ")"),
        Expr::Index(x) => pos(&cx, expr(&cx, out.put(&cx, "(Index "), x.value.get(&cx)).put(&cx, " ").usize(&cx, x.index), x.pos).put(&cx, ")"),
        Expr::Call(c) => pos(&cx, exprs(&cx, expr(&cx, out.put(&cx, "(Call "), c.callee.get(&cx)), c.args), c.pos).put(&cx, ")"),
        Expr::Try(n) => pos(&cx, expr(&cx, out.put(&cx, "(Try "), n.value.get(&cx)), n.pos).put(&cx, ")"),
        Expr::While(w) => pos(&cx, block(&cx, expr(&cx, out.put(&cx, "(While "), w.cond.get(&cx)).put(&cx, " "), w.body), w.pos).put(&cx, ")"),
        Expr::For(f) => pos(&cx, block(&cx, expr(&cx, str(&cx, out.put(&cx, "(For "), f.name).put(&cx, " "), f.iterator.get(&cx)).put(&cx, " "), f.body), f.pos).put(&cx, ")"),
    }
}

forall 'k.
fn pattern(&cx: Cx!['k], out: Out['k], p: Pattern['k]) -> Out['k] {
    match p {
        Pattern::Bind(n) => str(&cx, out.put(&cx, "(PBind "), n.value).put(&cx, ")"),
        Pattern::Wild(id) => out.put(&cx, "(PWild)"),
        Pattern::Tuple(n) => patterns(&cx, out.put(&cx, "(PTuple"), n.value).put(&cx, ")"),
        Pattern::Array(n) => patterns(&cx, out.put(&cx, "(PArray"), n.value).put(&cx, ")"),
        Pattern::Struct(s) => {
            let unit = out.put(&cx, "(PStruct [");
            var i = 0usize;
            while i < s.fields.len(&cx) {
                let f = s.fields.get(&cx, i);
                let unit = pattern(&cx, str(&cx, out.put(&cx, if i > 0usize { " [" } else { "[" }), f.name).put(&cx, " "), f.pattern).put(&cx, "]");
                i = i + 1usize;
            }
            opt_text(&cx, out.put(&cx, "]"), s.rest).put(&cx, ")")
        },
    }
}

forall 'k.
fn patterns(&cx: Cx!['k], out: Out['k], ps: Seq[Pattern['k], 'k]) -> Out['k] {
    let unit = out.put(&cx, " [");
    var i = 0usize;
    while i < ps.len(&cx) {
        let unit = pattern(&cx, out.put(&cx, if i > 0usize { " " } else { "" }), ps.get(&cx, i));
        i = i + 1usize;
    }
    out.put(&cx, "]")
}

forall 'k.
fn statement(&cx: Cx!['k], out: Out['k], s: Statement['k]) -> Out['k] {
    match s {
        Statement::Let(l) => pos(&cx, texts(&cx, expr(&cx, opt_type(&cx, pattern(&cx, out.put(&cx, "(Let "), l.pattern), l.type).put(&cx, " "), l.value), l.brands), l.pos).put(&cx, ")"),
        Statement::Var(v) => pos(&cx, expr(&cx, opt_type(&cx, str(&cx, out.put(&cx, "(Var "), v.name), v.type).put(&cx, " "), v.value), v.pos).put(&cx, ")"),
        Statement::Assign(a) => pos(&cx, expr(&cx, expr(&cx, out.put(&cx, "(Assign "), a.target).put(&cx, " "), a.value), a.pos).put(&cx, ")"),
        Statement::Expr(n) => pos(&cx, expr(&cx, out.put(&cx, "(ExprStmt "), n.value), n.pos).put(&cx, ")"),
        Statement::Const(c) => const_decl(&cx, out, c),
    }
}

forall 'k.
fn type_args(&cx: Cx!['k], out: Out['k], a: S::TypeArgs['k]) -> Out['k] {
    types(&cx, out.put(&cx, "(TypeArgs"), a.args).put(&cx, " ").usize(&cx, a.determined).put(&cx, ")")
}

forall 'k.
fn quantifier(&cx: Cx!['k], out: Out['k], q: Option[S::Forall['k]]) -> Out['k] {
    match q {
        Option::Some(f) => {
            let unit = texts(&cx, texts(&cx, out.put(&cx, " (Forall"), f.params), f.determined).put(&cx, " [");
            var i = 0usize;
            while i < f.premises.len(&cx) {
                let p = f.premises.get(&cx, i);
                let unit = type_args(&cx, texts(&cx, out.put(&cx, if i > 0usize { " [" } else { "[" }), p.trait_path).put(&cx, " "), p.args).put(&cx, "]");
                i = i + 1usize;
            }
            out.put(&cx, "])")
        },
        Option::None => out.put(&cx, " _"),
    }
}

forall 'k.
fn params(&cx: Cx!['k], out: Out['k], ps: Seq[S::Param['k], 'k]) -> Out['k] {
    let unit = out.put(&cx, " [");
    var i = 0usize;
    while i < ps.len(&cx) {
        let p = ps.get(&cx, i);
        let unit = flag(&cx, opt_type(&cx, str(&cx, out.put(&cx, if i > 0usize { " (Param " } else { "(Param " }), p.name), p.type), p.lend).put(&cx, ")");
        i = i + 1usize;
    }
    out.put(&cx, "]")
}

forall 'k.
fn exposure(&cx: Cx!['k], out: Out['k], e: Option[S::Exposed['k]]) -> Out['k] {
    match e {
        Option::Some(x) => opt_path(&cx, out.put(&cx, " (Exposed"), x.scope).put(&cx, ")"),
        Option::None => out.put(&cx, " _"),
    }
}

forall 'k.
fn use_tree(&cx: Cx!['k], out: Out['k], t: S::UseTree['k]) -> Out['k] {
    let unit = flag(&cx, texts(&cx, out.put(&cx, "["), t.path), t.star).put(&cx, " [");
    var i = 0usize;
    while i < t.children.len(&cx) {
        let unit = use_tree(&cx, out.put(&cx, if i > 0usize { " " } else { "" }), t.children.get(&cx, i));
        i = i + 1usize;
    }
    opt_text(&cx, out.put(&cx, "]"), t.alias).put(&cx, "]")
}

forall 'k.
fn function(&cx: Cx!['k], out: Out['k], f: S::Fn['k]) -> Out['k] {
    let unit = opt_type(&cx, params(&cx, str(&cx, out.put(&cx, "(Fn "), f.name), f.params), f.ret);
    let unit = match f.body {
        Option::Some(b) => block(&cx, out.put(&cx, " "), b),
        Option::None => out.put(&cx, " _"),
    };
    pos(&cx, quantifier(&cx, flag(&cx, out, f.is_unsafe), f.quantifier), f.pos).put(&cx, ")")
}

forall 'k.
fn const_decl(&cx: Cx!['k], out: Out['k], c: S::Const['k]) -> Out['k] {
    pos(&cx, quantifier(&cx, expr(&cx, type(&cx, str(&cx, out.put(&cx, "(Const "), c.name).put(&cx, " "), c.type).put(&cx, " "), c.value), c.quantifier), c.pos).put(&cx, ")")
}

forall 'k.
fn item(&cx: Cx!['k], out: Out['k], it: S::Item['k]) -> Out['k] {
    match it {
        S::Item::Use(u) => pos(&cx, flag(&cx, use_tree(&cx, out.put(&cx, "(Use "), u.tree), u.is_export), u.pos).put(&cx, ")"),
        S::Item::Module(m) => pos(&cx, texts(&cx, out.put(&cx, "(Module"), m.value), m.pos).put(&cx, ")"),
        S::Item::Struct(s) => {
            let unit = flag(&cx, str(&cx, out.put(&cx, "(Struct "), s.name), s.linear).put(&cx, " [");
            var i = 0usize;
            while i < s.fields.len(&cx) {
                let f = s.fields.get(&cx, i);
                let unit = type(&cx, str(&cx, out.put(&cx, if i > 0usize { " [" } else { "[" }), f.name).put(&cx, " "), f.type).put(&cx, "]");
                i = i + 1usize;
            }
            pos(&cx, quantifier(&cx, exposure(&cx, out.put(&cx, "]"), s.exposure), s.quantifier), s.pos).put(&cx, ")")
        },
        S::Item::Tuple(t) => pos(&cx, quantifier(&cx, exposure(&cx, types(&cx, flag(&cx, str(&cx, out.put(&cx, "(TupleDecl "), t.name), t.linear), t.elems), t.exposure), t.quantifier), t.pos).put(&cx, ")"),
        S::Item::Enum(e) => {
            let unit = flag(&cx, str(&cx, out.put(&cx, "(EnumDecl "), e.name), e.linear).put(&cx, " [");
            var i = 0usize;
            while i < e.variants.len(&cx) {
                let v = e.variants.get(&cx, i);
                let unit = types(&cx, str(&cx, out.put(&cx, if i > 0usize { " [" } else { "[" }), v.name), v.payload).put(&cx, "]");
                i = i + 1usize;
            }
            pos(&cx, quantifier(&cx, exposure(&cx, out.put(&cx, "]"), e.exposure), e.quantifier), e.pos).put(&cx, ")")
        },
        S::Item::Fn(f) => function(&cx, out, f),
        S::Item::Extern(x) => pos(&cx, opt_type(&cx, params(&cx, str(&cx, str(&cx, out.put(&cx, "(Extern "), x.abi).put(&cx, " "), x.name), x.params), x.ret), x.pos).put(&cx, ")"),
        S::Item::Const(c) => const_decl(&cx, out, c),
        S::Item::Impl(m) => {
            let unit = type(&cx, out.put(&cx, "(Impl "), m.type).put(&cx, " [");
            var i = 0usize;
            while i < m.items.len(&cx) {
                let unit = out.put(&cx, if i > 0usize { " " } else { "" });
                let unit = match m.items.get(&cx, i) {
                    S::Member::Fn(f) => function(&cx, out, f),
                    S::Member::Const(c) => const_decl(&cx, out, c),
                };
                i = i + 1usize;
            }
            pos(&cx, quantifier(&cx, out.put(&cx, "]"), m.quantifier), m.pos).put(&cx, ")")
        },
        S::Item::Trait(t) => pos(&cx, quantifier(&cx, functions(&cx, str(&cx, out.put(&cx, "(TraitDecl "), t.name), t.methods), t.quantifier), t.pos).put(&cx, ")"),
        S::Item::Instance(n) => pos(&cx, quantifier(&cx, flag(&cx, functions(&cx, type(&cx, out.put(&cx, "(InstanceDecl "), n.type), n.methods), n.is_unsafe), n.quantifier), n.pos).put(&cx, ")"),
    }
}

forall 'k.
fn functions(&cx: Cx!['k], out: Out['k], fs: Seq[S::Fn['k], 'k]) -> Out['k] {
    let unit = out.put(&cx, " [");
    var i = 0usize;
    while i < fs.len(&cx) {
        let unit = function(&cx, out.put(&cx, if i > 0usize { " " } else { "" }), fs.get(&cx, i));
        i = i + 1usize;
    }
    out.put(&cx, "]")
}

// One line per item.
forall 'k.
fn items(&cx: Cx!['k], items: Seq[S::Item['k], 'k]) -> Text['k] {
    let out = Out::new(&cx);
    var i = 0usize;
    while i < items.len(&cx) {
        let unit = item(&cx, out, items.get(&cx, i)).put(&cx, "\n");
        i = i + 1usize;
    }
    out.done(&cx)
}
