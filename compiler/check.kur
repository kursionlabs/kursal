// The KURS assertion checker: every block is checked alone against its declared contract, using
// only signatures of its successors and callees.
//
// The checker records the type of every SSA value of every function it checks, for the backend
// and later passes. A function is identified by a `FunKey`: a program function by its name, an
// instance method by its trait, its instance's index among that trait's instances and its bare
// method name, since methods of different instances share names with each other and with
// functions.

use package::base::{Cell, Key, Map, Out, Seq, Set, Text, combine, text};
use package::core::{Arm, Block, Edge, Fun, Instance, Instr, Kind, Member, Method, ModuleId, Opened, Param, Premise, Program, Terminator, Type};
use package::core as C;
use package::coherence::check_coherence;
use package::formation::{Discharge, Formation};
use package::layout::check_type_expansion;
use package::literals::valid_literal;
use package::sexpr::Form;
use package::syntax::{Pos, no_pos};
use package::termination::check_instance_termination;
use package::types::{Fresh, Types, children, equal, fits, foreach_binders, foreach_item, free_brands, kurs_error, subst};
use package::unify::match_head;
use std::option::Option;
use std::slice::Slice;

fn is_arith(op: Text) -> bool {
    op.is("add") || op.is("sub") || op.is("mul") || op.is("div") || op.is("mod")
}

fn is_order(op: Text) -> bool {
    op.is("lt") || op.is("le") || op.is("gt") || op.is("ge")
}

fn is_equality(op: Text) -> bool {
    op.is("eq") || op.is("ne")
}

fn is_bits(op: Text) -> bool {
    op.is("bit_and") || op.is("bit_or") || op.is("bit_xor") || op.is("shl") || op.is("shr")
}

fn is_ordering(order: Text) -> bool {
    order.is("relaxed") || order.is("acquire") || order.is("release") || order.is("acq_rel") || order.is("seq_cst")
}

// The failure orderings a compare-exchange allows with a success ordering; none for an unknown one.
fn cas_failure(success: Text) -> Option[Seq[Text]] {
    let relaxed = text("relaxed");
    let acquire = text("acquire");
    if success.is("relaxed") || success.is("release") {
        Option::Some.(Seq::one(relaxed))
    } else if success.is("acquire") || success.is("acq_rel") {
        Option::Some.(Seq::two(relaxed, acquire))
    } else if success.is("seq_cst") {
        let all = Seq::two(relaxed, acquire);
        all.push(text("seq_cst"));
        Option::Some.(all)
    } else {
        Option::None
    }
}

// The number of operands of an atomic operation, if it is one.
fn atomic_arity(kind: Text) -> Option[usize] {
    if kind.is("fence") {
        Option::Some.(0usize)
    } else if kind.is("load") {
        Option::Some.(1usize)
    } else if kind.is("compare_exchange") {
        Option::Some.(3usize)
    } else if kind.is("store") || kind.is("swap") || kind.is("fetch_add") || kind.is("fetch_sub") || kind.is("fetch_and")
        || kind.is("fetch_or") || kind.is("fetch_xor") {
        Option::Some.(2usize)
    } else {
        Option::None
    }
}

fn static_brand() -> Text {
    text("static")
}

// The module of a declaration that names none: inside no exposure scope, so it has no shape
// authority over restricted declarations.
fn nowhere() -> ModuleId {
    ModuleId.{ package: 18446744073709551615usize, path: Seq::one(text("<no module>")) }
}

// Compiler-reserved trait names: no user trait or instance.
fn sealed(name: Text) -> bool {
    name.starts_with(text("Copy")) || name.starts_with(text("builtin::"))
}

fn segments(path: Text) -> Seq[Text] {
    path.split(text("."))
}

fn join(parts: Seq[Text]) -> Text {
    let out = Out::new();
    var i = 0usize;
    while i < parts.len() {
        if i > 0usize {
            let unit = out.put(".");
        }
        let unit = out.add(parts.get(i));
        i = i + 1usize;
    }
    out.done()
}

// Resolve a bounded decimal tuple component without parsing huge atoms.
fn canonical_tuple_index(segment: Text, arity: usize) -> Option[usize] {
    if arity == 0usize || segment.is_empty() || segment.len > 1usize && segment.byte(0usize) == b'0' {
        return Option::None;
    }
    var i = 0usize;
    while i < segment.len {
        let b = segment.byte(i);
        if b < b'0' || b > b'9' {
            return Option::None;
        }
        i = i + 1usize;
    }
    let largest = Out::new().usize(arity - 1usize).done();
    if segment.len > largest.len || segment.len == largest.len && segment.compare(largest) > 0 {
        return Option::None;
    }
    segment.to_usize()
}

// `parent` is an ancestor of `other_path`, or the path itself: its segments begin
// `other_path`'s. A segment holds no `.`, so this compares bytes without splitting.
fn prefix(parent: Text, other_path: Text) -> bool {
    other_path.starts_with(parent) && (other_path.len == parent.len || other_path.byte(parent.len) == b'.')
}

fn overlap(path: Text, other_path: Text) -> bool {
    prefix(path, other_path) || prefix(other_path, path)
}

// Some path of `paths` is `path` or an ancestor of it.
fn any_prefix(paths: Seq[Text], path: Text) -> bool {
    var i = 0usize;
    while i < paths.len() {
        if prefix(paths.get(i), path) {
            return true;
        }
        i = i + 1usize;
    }
    false
}

// Some key of `map` passes `test`. The keys are read in place, not copied.
forall V, Env where Copy[V], Copy[Env].
fn any_key(map: Map[Text, V], test: closure[Env](Text) -> bool) -> bool {
    var i = 0usize;
    while i < map.positions() {
        let found = match map.entry(i) {
            Option::Some(key) => test(key),
            Option::None => false,
        };
        if found {
            return true;
        }
        i = i + 1usize;
    }
    false
}

fn is_never(t: Type) -> bool {
    match t {
        Type::Never => true,
        _ => false,
    }
}

fn is_exists(t: Type) -> bool {
    match t {
        Type::Exists(_binders, _body) => true,
        _ => false,
    }
}

fn is_struct_or_tuple(t: Type) -> bool {
    match t {
        Type::Struct(_fields) => true,
        Type::Tuple(_elems) => true,
        _ => false,
    }
}

fn is_integer_type(t: Type) -> bool {
    match t {
        Type::Prim(name) => C::is_integer(name),
        _ => false,
    }
}

// The type of the last member named `name`, as `dict(members).get(name)` finds it.
fn member(members: Seq[Member], name: Text) -> Option[Type] {
    var found = Option::None;
    var i = 0usize;
    while i < members.len() {
        if members.get(i).name.eq(name) {
            found = Option::Some.(members.get(i).type);
        }
        i = i + 1usize;
    }
    found
}

fn texts_set(names: Seq[Text]) -> Set[Text] {
    let out: Set[Text] = Set::new();
    var i = 0usize;
    while i < names.len() {
        out.add(names.get(i));
        i = i + 1usize;
    }
    out
}

fn subset(a: Set[Text], b: Set[Text]) -> bool {
    !any_key(a.map, |x: Text| !b.has(x))
}

fn sets_meet(a: Set[Text], b: Set[Text]) -> bool {
    !subset_none(a, b)
}

fn subset_none(a: Set[Text], b: Set[Text]) -> bool {
    !any_key(a.map, |x: Text| b.has(x))
}

fn opened_before(a: Opened, b: Opened) -> bool {
    a.path.compare(b.path) < 0
}

// The two maps hold the same keys with the same values.
fn opened_same(a: Map[Text, Seq[Text]], b: Map[Text, Seq[Text]]) -> bool {
    if a.len() != b.len() {
        return false;
    }
    let keys = a.keys();
    var equal = true;
    var i = 0usize;
    while equal && i < keys.len() {
        equal = match b.get(keys.get(i)) {
            Option::Some(v) => v.same(a.at(keys.get(i))),
            Option::None => false,
        };
        i = i + 1usize;
    }
    equal
}

// ---------------------------------------------------------- function keys --

exposed enum FunKey {
    // a function of the program, by name
    Function(Text),
    // an instance method: its trait, the instance's index among the trait's instances, and the
    // method's bare name
    Method(Text, usize, Text),
}

instance Key[FunKey] {
    fn key_hash(key: FunKey) -> u64 {
        match key {
            FunKey::Function(name) => combine(1u64, name.hash()),
            FunKey::Method(trait_name, index, name) => combine(combine(combine(2u64, trait_name.hash()), index as u64), name.hash()),
        }
    }

    fn key_same(a: FunKey, b: FunKey) -> bool {
        match a {
            FunKey::Function(x) => match b {
                FunKey::Function(y) => x.eq(y),
                _ => false,
            },
            FunKey::Method(t, i, x) => match b {
                FunKey::Method(u, j, y) => t.eq(u) && i == j && x.eq(y),
                _ => false,
            },
        }
    }
}

// ------------------------------------------------------------------ places --

// P = (Z, K, O): empty paths, known variants, opened views.
exposed struct Places {
    empty: Set[Text],
    known: Map[Text, Text],
    opened: Map[Text, Seq[Text]],
}

impl Places {
    fn new(empty: Set[Text], known: Map[Text, Text], opened: Map[Text, Seq[Text]]) -> Places {
        Places.{ empty, known, opened }
    }

    fn copy(self) -> Places {
        Places.{ empty: self.empty.copy(), known: self.known.copy(), opened: self.opened.copy() }
    }

    fn covered(self, path: Text) -> bool {
        any_key(self.empty.map, |z: Text| prefix(z, path))
    }

    fn full(self, path: Text) -> bool {
        !any_key(self.empty.map, |z: Text| overlap(z, path))
    }

    fn forget(self, path: Text, keep_own_view: bool) {
        var i = 0usize;
        while i < self.known.positions() {
            match self.known.entry(i) {
                Option::Some(q) => {
                    if prefix(path, q) {
                        self.known.remove(q);
                    }
                },
                Option::None => (),
            };
            i = i + 1usize;
        }
        var j = 0usize;
        while j < self.opened.positions() {
            match self.opened.entry(j) {
                Option::Some(q) => {
                    if prefix(path, q) && !(keep_own_view && q.eq(path)) {
                        self.opened.remove(q);
                    }
                },
                Option::None => (),
            };
            j = j + 1usize;
        }
    }

    // Retain views only when all their opened ancestors are retained too.
    fn keep_opened(self, wanted: Map[Text, Seq[Text]]) {
        let current = self.opened.keys();
        let kept: Map[Text, Seq[Text]] = Map::new();
        let paths = wanted.keys();
        var i = 0usize;
        while i < paths.len() {
            let p = paths.get(i);
            var all = true;
            var j = 0usize;
            while all && j < current.len() {
                let q = current.get(j);
                if !q.eq(p) && prefix(q, p) {
                    all = wanted.has(q);
                }
                j = j + 1usize;
            }
            if all {
                kept.set(p, wanted.at(p));
            }
            i = i + 1usize;
        }
        let old = self.opened.keys();
        var k = 0usize;
        while k < old.len() {
            self.opened.remove(old.get(k));
            k = k + 1usize;
        }
        let new = kept.keys();
        var n = 0usize;
        while n < new.len() {
            self.opened.set(new.get(n), kept.at(new.get(n)));
            n = n + 1usize;
        }
    }
}

// (param types, result, unsafe, place indices) of a call's callee.
exposed struct Signature {
    ptypes: Seq[Type],
    ret: Type,
    is_unsafe: bool,
    places: Seq[usize],
}

// ----------------------------------------------------------------- checker --

exposed struct Checker {
    program: Program,
    counter: Fresh,
    formation: Formation[Checker],
    types: Types,
    // function -> (block label, SSA name) -> type, for the backend
    typed: Map[FunKey, Map[(Text, Text), Type]],
    home: Cell[Option[ModuleId]],
    kinds: Cell[Map[Text, Kind]],
    brands: Cell[Set[Text]],
    premises: Cell[Seq[Premise]],
    // what is being checked, for messages
    location: Cell[Text],
    current: Cell[Option[Fun]],
    params: Cell[Seq[Param]],
    blocks: Cell[Map[Text, Block]],
    record: Cell[Map[(Text, Text), Type]],
    roots: Cell[Map[Text, Type]],
    param_roots: Cell[Set[Text]],
    // the free brands of each root's type, as `edge` asks for them
    root_brand_cache: Cell[Map[Text, Set[Text]]],
    label: Cell[Text],
    env: Cell[Map[Text, Type]],
    used: Cell[Set[Text]],
    places: Cell[Places],
    instr: Cell[Option[Instr]],
}

instance Discharge[Checker] {
    fn discharge_premise(discharger: Checker, premise: Premise, env: Map[Text, Kind], premises: Seq[Premise], home: Option[ModuleId]) -> bool {
        discharger.formation_holds(premise, env, premises, home)
    }
}

fn with_brands(kinds: Map[Text, Kind], brands: Set[Text]) -> Map[Text, Kind] {
    let out = kinds.copy();
    let names = brands.items();
    var i = 0usize;
    while i < names.len() {
        out.set(names.get(i), Kind::Brand);
        i = i + 1usize;
    }
    out
}

fn concat_params(a: Seq[Param], b: Seq[Param]) -> Seq[Param] {
    let out = a.copy();
    out.append(b);
    out
}

fn concat_premises(a: Seq[Premise], b: Seq[Premise]) -> Seq[Premise] {
    let out = a.copy();
    out.append(b);
    out
}

fn brand_params(params: Seq[Param]) -> Set[Text] {
    let out: Set[Text] = Set::new();
    var i = 0usize;
    while i < params.len() {
        if C::same_kind(params.get(i).kind, Kind::Brand) {
            out.add(params.get(i).name);
        }
        i = i + 1usize;
    }
    out
}

fn subst_all(types: Seq[Type], sub: Map[Text, Type], counter: Fresh) -> Seq[Type] {
    let out: Seq[Type] = Seq::new();
    var i = 0usize;
    while i < types.len() {
        out.push(subst(types.get(i), sub, counter));
        i = i + 1usize;
    }
    out
}

impl Checker {
    fn new(program: Program, counter: Fresh) -> Checker {
        check_type_expansion(program, counter);
        let formation: Formation[Checker] = Formation::new(program, counter);
        formation.declarations();
        let heads: Seq[(Premise, Seq[Param], Pos)] = Seq::new();
        let headers: Seq[(Premise, Seq[Premise], Pos)] = Seq::new();
        let groups = program.instances.values();
        var g = 0usize;
        while g < groups.len() {
            let insts = groups.get(g);
            var i = 0usize;
            while i < insts.len() {
                let inst = insts.get(i);
                heads.push((Premise.{ trait_name: inst.trait_name, args: inst.head }, inst.params, inst.pos));
                headers.push((Premise.{ trait_name: inst.trait_name, args: inst.head }, inst.premises, no_pos()));
                i = i + 1usize;
            }
            g = g + 1usize;
        }
        check_coherence(heads, counter);
        check_instance_termination(headers);
        let checker = Checker.{
            program,
            counter,
            formation,
            types: Types::new(program, counter),
            typed: Map::new(),
            home: Cell::new(Option::None),
            kinds: Cell::new(Map::new()),
            brands: Cell::new(Set::new()),
            premises: Cell::new(Seq::new()),
            location: Cell::new(text("")),
            current: Cell::new(Option::None),
            params: Cell::new(Seq::new()),
            blocks: Cell::new(Map::new()),
            record: Cell::new(Map::new()),
            roots: Cell::new(Map::new()),
            param_roots: Cell::new(Set::new()),
            root_brand_cache: Cell::new(Map::new()),
            label: Cell::new(text("")),
            env: Cell::new(Map::new()),
            used: Cell::new(Set::new()),
            places: Cell::new(Places::new(Set::new(), Map::new(), Map::new())),
            instr: Cell::new(Option::None),
        };
        checker.brands.get().add(static_brand());
        formation.discharge.set(Option::Some.(checker));
        formation.declarations();
        checker
    }

    fn formation_holds(self, premise: Premise, kinds: Map[Text, Kind], premises: Seq[Premise], home: Option[ModuleId]) -> bool {
        let saved_kinds = self.kinds.get();
        let saved_premises = self.premises.get();
        let saved_home = self.home.get();
        let saved_brands = self.brands.get();
        self.kinds.set(kinds.copy());
        self.premises.set(premises);
        self.home.set(home);
        let brands: Set[Text] = Set::new();
        let names = kinds.keys();
        var i = 0usize;
        while i < names.len() {
            if C::same_kind(kinds.at(names.get(i)), Kind::Brand) {
                brands.add(names.get(i));
            }
            i = i + 1usize;
        }
        self.brands.set(brands);
        let result = self.holds(premise.trait_name, premise.args);
        self.kinds.set(saved_kinds);
        self.premises.set(saved_premises);
        self.home.set(saved_home);
        self.brands.set(saved_brands);
        result
    }

    fn fail(self, message: Slice[u8, 'static]) -> ! {
        kurs_error(Out::new().add(self.location.get()).put(": ").put(message).done(), no_pos())
    }

    fn fun(self) -> Fun {
        match self.current.get() {
            Option::Some(fun) => fun,
            Option::None => kurs_error(text("internal error: no function is being checked"), no_pos()),
        }
    }

    fn scope(self) -> Map[Text, Kind] {
        with_brands(self.kinds.get(), self.brands.get())
    }

    // ----------------------------------------------------------------- program --

    fn check(self) {
        let externs = self.program.externs.values();
        var e = 0usize;
        while e < externs.len() {
            let ext = externs.get(e);
            self.location.set(Out::new().put("extern ").add(ext.name).done());
            let unit = match ext.ptypes {
                Option::Some(ptypes) => {
                    var i = 0usize;
                    while i < ptypes.len() {
                        self.has_memory_form(ptypes.get(i));
                        i = i + 1usize;
                    }
                },
                Option::None => (),
            };
            e = e + 1usize;
        }
        let traits = self.program.traits.values();
        var t = 0usize;
        while t < traits.len() {
            let tr = traits.get(t);
            self.location.set(Out::new().put("trait ").add(tr.name).done());
            if sealed(tr.name) {
                self.fail("trait_name_is_reserved");
            }
            let names: Set[Text] = Set::new();
            var m = 0usize;
            while m < tr.methods.len() {
                names.add(tr.methods.get(m).name);
                m = m + 1usize;
            }
            if names.len() != tr.methods.len() {
                self.fail("duplicate_trait_method");
            }
            t = t + 1usize;
        }
        let funs = self.program.funs.values();
        var f = 0usize;
        while f < funs.len() {
            self.check_fun(funs.get(f), Seq::new(), Seq::new(), FunKey::Function.(funs.get(f).name));
            f = f + 1usize;
        }
        let trait_names = self.program.instances.keys();
        var g = 0usize;
        while g < trait_names.len() {
            let insts = self.program.instances.at(trait_names.get(g));
            var i = 0usize;
            while i < insts.len() {
                self.check_instance(insts.get(i), trait_names.get(g), i);
                i = i + 1usize;
            }
            g = g + 1usize;
        }
        let datas = self.program.datas.values();
        var d = 0usize;
        while d < datas.len() {
            let data = datas.get(d);
            self.location.set(data.name);
            self.home.set(Option::Some.(match data.home {
                Option::Some(m) => m,
                Option::None => nowhere(),
            }));
            self.check_data(data.ty, data.init);
            d = d + 1usize;
        }
    }

    // `group` is the key of the instance's list in the program, and `index` its place there.
    fn check_instance(self, inst: Instance, group: Text, index: usize) {
        let found = self.program.traits.get(inst.trait_name);
        self.location.set(Out::new().put("instance ").add(inst.trait_name).done());
        if sealed(inst.trait_name) {
            self.fail("trait_name_is_reserved");
        }
        let tr = match found {
            Option::Some(tr) => tr,
            Option::None => self.fail("instance_unknown_trait_wrong"),
        };
        if tr.params.len() != inst.head.len() {
            self.fail("instance_unknown_trait_wrong");
        }
        let head: Map[Text, Type] = Map::new();
        var h = 0usize;
        while h < tr.params.len() {
            head.set(tr.params.get(h), inst.head.get(h));
            h = h + 1usize;
        }
        let by_name: Map[Text, Fun] = Map::new();
        var i = 0usize;
        while i < inst.methods.len() {
            by_name.set(inst.methods.get(i).name, inst.methods.get(i));
            i = i + 1usize;
        }
        if by_name.len() != inst.methods.len() {
            self.fail("duplicate_instance_method");
        }
        let declared: Set[Text] = Set::new();
        var s = 0usize;
        while s < tr.methods.len() {
            declared.add(tr.methods.get(s).name);
            s = s + 1usize;
        }
        if !subset(texts_set(by_name.keys()), declared) {
            self.fail("instance_method_not_in_trait");
        }
        var m = 0usize;
        while m < tr.methods.len() {
            let sig = tr.methods.get(m);
            let fun = match by_name.get(sig.name) {
                Option::Some(fun) => fun,
                Option::None => self.fail("instance_lacks_method"),
            };
            if !fun.params.is_empty() || !fun.premises.is_empty() {
                self.fail("instance_method_has_own_quantifier");
            }
            let want = C::fn_type(subst_all(sig.ptypes, head, self.counter), subst(sig.ret, head, self.counter), Seq::new(), false, sig.places);
            let got = C::fn_type(fun.ptypes, fun.ret, Seq::new(), false, fun.places());
            if !equal(got, want) || (fun.is_unsafe && !sig.is_unsafe) {
                self.fail("method_does_match_trait");
            }
            self.check_fun(fun, inst.params, inst.premises, FunKey::Method.(group, index, sig.name));
            m = m + 1usize;
        }
    }

    fn check_data(self, ty: Type, form: Form) {
        let s = self.types.shape(ty, self.home.get());
        let unit = match s {
            Type::Prim(_name) => {
                if form.is_list() || form.is_str() {
                    self.fail("data_scalar_requires_atom");
                }
                self.scalar_literal(s, form.text);
                return ();
            },
            Type::Tuple(_elems) => (),
            Type::Struct(_fields) => (),
            Type::Array(_elem, _length) => (),
            _ => self.fail("data_initializer_type"),
        };
        if !form.is_list() {
            self.fail("data_product_requires_list");
        }
        let unit = match s {
            Type::Array(elem, length) => {
                var count = 0u64;
                var i = 0usize;
                while i < form.len() {
                    let part = form.at(i);
                    if C::same(elem.get(), C::prim("u8")) && part.is_str() {
                        count = count + (part.text.len as u64);
                    } else {
                        self.check_data(elem.get(), part);
                        count = count + 1u64;
                    }
                    i = i + 1usize;
                }
                if count != length {
                    self.fail("data_initializer_wrong_number");
                }
                return ();
            },
            _ => (),
        };
        let parts = self.types.fields(ty, self.home.get());
        if form.len() != parts.len() {
            self.fail("data_initializer_wrong_number");
        }
        var i = 0usize;
        while i < parts.len() {
            self.check_data(parts.get(i), form.at(i));
            i = i + 1usize;
        }
    }

    // ---------------------------------------------------------------- function --

    fn check_fun(self, fun: Fun, outer_params: Seq[Param], outer_premises: Seq[Premise], key: FunKey) {
        self.formation.function(fun, outer_params, outer_premises);
        self.current.set(Option::Some.(fun));
        self.location.set(fun.name);
        let params = concat_params(outer_params, fun.params);
        self.params.set(params);
        let kinds: Map[Text, Kind] = Map::new();
        var p = 0usize;
        while p < params.len() {
            kinds.set(params.get(p).name, params.get(p).kind);
            p = p + 1usize;
        }
        self.kinds.set(kinds);
        self.premises.set(concat_premises(outer_premises, fun.premises));
        self.home.set(Option::Some.(match fun.home {
            Option::Some(m) => m,
            Option::None => nowhere(),
        }));
        let blocks: Map[Text, Block] = Map::new();
        var b = 0usize;
        while b < fun.blocks.len() {
            blocks.set(fun.blocks.get(b).label, fun.blocks.get(b));
            b = b + 1usize;
        }
        self.blocks.set(blocks);
        let record = match self.typed.get(key) {
            Option::Some(r) => r,
            Option::None => {
                let r: Map[(Text, Text), Type] = Map::new();
                self.typed.set(key, r);
                r
            },
        };
        self.record.set(record);
        if blocks.len() != fun.blocks.len() {
            self.fail("duplicate_block_label");
        }
        let entry = fun.blocks.get(0usize);
        if entry.params.len() != fun.ptypes.len() || !entry.brands.is_empty() {
            self.fail("entry_parameters_disagree_signature");
        }
        let roots: Map[Text, Type] = Map::new();
        var l = 0usize;
        while l < fun.locals.len() {
            roots.set(fun.locals.get(l).name, fun.locals.get(l).type);
            l = l + 1usize;
        }
        self.roots.set(roots);
        self.root_brand_cache.set(Map::new());
        if roots.len() != fun.locals.len() {
            self.fail("duplicate_place_root");
        }
        let param_roots: Set[Text] = Set::new();
        var i = 0usize;
        while i < entry.params.len() {
            let binding = entry.params.get(i);
            if !equal(binding.type, fun.ptypes.get(i)) {
                self.fail("entry_parameter_disagrees_signature");
            }
            if binding.name.starts_with(text("&")) {
                if roots.has(binding.name) {
                    self.fail("duplicate_place_root");
                }
                roots.set(binding.name, binding.type);
            }
            i = i + 1usize;
        }
        var j = 0usize;
        while j < entry.params.len() {
            if entry.params.get(j).name.starts_with(text("&")) {
                param_roots.add(entry.params.get(j).name);
            }
            j = j + 1usize;
        }
        self.param_roots.set(param_roots);
        var k = 0usize;
        while k < fun.blocks.len() {
            self.check_block(fun.blocks.get(k), k == 0usize);
            k = k + 1usize;
        }
    }

    fn check_block(self, block: Block, is_entry: bool) {
        let fun = self.fun();
        self.formation.pos.set(block.pos);
        self.location.set(Out::new().add(fun.name).put("/").add(block.label).done());
        self.label.set(block.label);
        let brands = brand_params(self.params.get());
        var b = 0usize;
        while b < block.brands.len() {
            brands.add(block.brands.get(b));
            b = b + 1usize;
        }
        brands.add(static_brand());
        self.brands.set(brands);
        self.env.set(Map::new());
        self.used.set(Set::new());
        var p = 0usize;
        while p < block.params.len() {
            let binding = block.params.get(p);
            if binding.name.starts_with(text("&")) {
                if !is_entry {
                    self.fail("only_entry_declares_place");
                }
            } else {
                self.bind(binding.name, binding.type);
            }
            p = p + 1usize;
        }
        if is_entry {
            if !block.opened.is_empty() {
                self.fail("entry_cannot_assume_opened_views");
            }
            let empty: Set[Text] = Set::new();
            var l = 0usize;
            while l < fun.locals.len() {
                empty.add(fun.locals.get(l).name);
                l = l + 1usize;
            }
            self.places.set(Places::new(empty, Map::new(), Map::new()));
        } else {
            let known: Map[Text, Text] = Map::new();
            var k = 0usize;
            while k < block.known.len() {
                known.set(block.known.get(k).path, block.known.get(k).variant);
                k = k + 1usize;
            }
            self.places.set(Places::new(texts_set(block.empty), known, Map::new()));
            let paths: Set[Text] = Set::new();
            var o = 0usize;
            while o < block.opened.len() {
                paths.add(block.opened.get(o).path);
                o = o + 1usize;
            }
            if paths.len() != block.opened.len() {
                self.fail("duplicate_opened_view");
            }
            let sorted = block.opened.copy();
            sorted.sort(opened_before);
            let block_brands = texts_set(block.brands);
            var s = 0usize;
            while s < sorted.len() {
                let path = sorted.get(s).path;
                let view = sorted.get(s).brands;
                let view_set = texts_set(view);
                let ty = self.path_type(path);
                let fits_package = match ty {
                    Type::Exists(binders, _body) => binders.len() == view.len() && view_set.len() == view.len(),
                    _ => false,
                };
                if !fits_package {
                    self.fail("opened_contract_requires_package_brands");
                }
                if !subset(view_set, block_brands) {
                    self.fail("opened_contract_requires_block_brands");
                }
                let others = self.places.get().opened.values();
                var x = 0usize;
                while x < others.len() {
                    if sets_meet(view_set, texts_set(others.get(x))) {
                        self.fail("opened_contract_brand_names_one_view");
                    }
                    x = x + 1usize;
                }
                self.places.get().opened.set(path, view);
                s = s + 1usize;
            }
            var e = 0usize;
            while e < block.empty.len() {
                let unit = self.path_type(block.empty.get(e));
                e = e + 1usize;
            }
            var n = 0usize;
            while n < block.known.len() {
                let known = block.known.get(n);
                let names_variant = match self.types.shape(self.path_type(known.path), self.home.get()) {
                    Type::Enum(variants) => member(variants, known.variant).is_some(),
                    _ => false,
                };
                if !names_variant {
                    self.fail("known_contract_names_a_variant");
                }
                n = n + 1usize;
            }
        }
        var last: Option[Instr] = Option::None;
        var i = 0usize;
        while i < block.instrs.len() {
            self.check_instr(block.instrs.get(i));
            last = Option::Some.(block.instrs.get(i));
            i = i + 1usize;
        }
        self.check_term(block.term, last);
    }

    // -------------------------------------------------------------- SSA values --

    fn bind(self, name: Text, ty: Type) {
        self.formation.fits(ty, Kind::Any, self.scope());
        let env = self.env.get();
        if env.has(name) {
            self.fail("defined_twice");
        }
        env.set(name, ty);
        self.record.get().set((self.label.get(), name), ty);
    }

    fn use_value(self, name: Text) -> Type {
        let ty = self.peek(name);
        self.used.get().add(name);
        ty
    }

    fn peek(self, name: Text) -> Type {
        let ty = match self.env.get().get(name) {
            Option::Some(ty) => ty,
            Option::None => self.fail("defined"),
        };
        if self.used.get().has(name) {
            self.fail("was_already_consumed");
        }
        ty
    }

    // `free_brands` of a root's type, computed once per function.
    fn root_brands(self, root: Text) -> Set[Text] {
        let cache = self.root_brand_cache.get();
        match cache.get(root) {
            Option::Some(brands) => brands,
            Option::None => {
                let brands = free_brands(self.roots.get().at(root));
                cache.set(root, brands);
                brands
            },
        }
    }

    fn copy_type(self, ty: Type) -> bool {
        self.types.is_copy(ty, self.kinds.get())
    }

    fn accounted(self, used: Set[Text]) {
        let env = self.env.get();
        var i = 0usize;
        while i < env.positions() {
            match env.entry(i) {
                Option::Some(name) => {
                    if !used.has(name) && !self.copy_type(env.at(name)) {
                        self.fail("linear_value_never_consumed");
                    }
                },
                Option::None => (),
            };
            i = i + 1usize;
        }
    }

    // ------------------------------------------------------------------ places --

    fn path_type(self, path: Text) -> Type {
        self.view(path, self.storage_type(path))
    }

    // The final slot's stored type, applying views only to its ancestors.
    fn storage_type(self, path: Text) -> Type {
        let parts = segments(path);
        let roots = self.roots.get();
        var ty = match roots.get(parts.get(0usize)) {
            Option::Some(t) => t,
            Option::None => self.fail("place_function"),
        };
        var sofar = parts.get(0usize);
        var i = 1usize;
        while i < parts.len() {
            let seg = parts.get(i);
            ty = self.view(sofar, ty);
            let component = match self.types.shape(ty, self.home.get()) {
                Type::Enum(variants) => {
                    let known = match self.places.get().known.get(sofar) {
                        Option::Some(v) => v.eq(seg),
                        Option::None => false,
                    };
                    if !known {
                        self.fail("known");
                    }
                    member(variants, seg)
                },
                Type::Tuple(elems) => match canonical_tuple_index(seg, elems.len()) {
                    Option::Some(index) => Option::Some.(elems.get(index)),
                    Option::None => Option::None,
                },
                Type::Struct(fields) => member(fields, seg),
                _ => Option::None,
            };
            ty = match component {
                Option::Some(t) => t,
                Option::None => self.fail("names_component"),
            };
            sofar = Out::new().add(sofar).put(".").add(seg).done();
            i = i + 1usize;
        }
        ty
    }

    fn view(self, path: Text, ty: Type) -> Type {
        let brands = match self.places.get().opened.get(path) {
            Option::Some(b) => b,
            Option::None => {
                return ty;
            },
        };
        match ty {
            Type::Exists(binders, body) => {
                let sub: Map[Text, Type] = Map::new();
                var i = 0usize;
                while i < binders.len() && i < brands.len() {
                    sub.set(binders.get(i), Type::Skolem.(brands.get(i)));
                    i = i + 1usize;
                }
                subst(body.get(), sub, self.counter)
            },
            _ => self.fail("opened_view_requires_existential"),
        }
    }

    // Whether p may be discarded; ty is its stored type, before its own view.
    fn no_linear(self, path: Text, ty: Type) -> bool {
        let places = self.places.get();
        if self.copy_type(ty) || places.covered(path) {
            return true;
        }
        if places.opened.has(path) {
            return self.no_linear_parts(path, self.view(path, ty));
        }
        self.no_linear_parts(path, ty)
    }

    fn no_linear_parts(self, path: Text, ty: Type) -> bool {
        if self.copy_type(ty) {
            return true;
        }
        let places = self.places.get();
        let decomposed = any_key(places.empty.map, |z: Text| prefix(path, z) && !z.eq(path));
        let known = places.known.get(path);
        if !decomposed && known.is_none() {
            // A full non-Copy value cannot be discarded, irrespective of shape.
            // In particular, abstract parameters have no nominal body to unfold.
            return false;
        }
        let rows: Seq[Member] = match self.types.shape(ty, self.home.get()) {
            Type::Enum(variants) => match known {
                Option::Some(variant) => {
                    let payload = match member(variants, variant) {
                        Option::Some(t) => t,
                        Option::None => kurs_error(text("internal error: a known variant is not a variant"), no_pos()),
                    };
                    return self.no_linear(Out::new().add(path).put(".").add(variant).done(), payload);
                },
                Option::None => {
                    return false;
                },
            },
            Type::Struct(fields) => {
                if !decomposed {
                    return false;
                }
                fields
            },
            Type::Tuple(elems) => {
                if !decomposed {
                    return false;
                }
                let out: Seq[Member] = Seq::new();
                var k = 0usize;
                while k < elems.len() {
                    out.push(Member.{ name: Out::new().usize(k).done(), type: elems.get(k) });
                    k = k + 1usize;
                }
                out
            },
            _ => {
                return false;
            },
        };
        var all = true;
        var r = 0usize;
        while all && r < rows.len() {
            all = self.no_linear(Out::new().add(path).put(".").add(rows.get(r).name).done(), rows.get(r).type);
            r = r + 1usize;
        }
        all
    }

    // A view opened strictly inside `path` is closed (packed) before `path` is loaded or lent.
    fn nested_view_closed(self, path: Text) {
        if any_key(self.places.get().opened, |q: Text| prefix(path, q) && !q.eq(path)) {
            self.fail("nested_view_open");
        }
    }

    fn load(self, path: Text) -> Type {
        let ty = self.path_type(path);
        if !self.places.get().full(path) {
            self.fail("full");
        }
        self.nested_view_closed(path);
        if !self.copy_type(ty) {
            self.places.get().empty.add(path);
            self.places.get().forget(path, true);
        }
        ty
    }

    fn store(self, path: Text, ty: Type) {
        let want = self.path_type(path);
        if !fits(ty, want) {
            self.fail("storing_into");
        }
        let places = self.places.get();
        if any_key(places.empty.map, |z: Text| prefix(z, path) && !z.eq(path)) {
            self.fail("empty_ancestor_store_whole");
        }
        let empty = places.empty.items();
        // What the store overwrites holds no linear contents: a Copy value, or a place whose linear
        // parts were moved out (dropping that empty linear place is its destruct in the value-only
        // translation).
        if !self.no_linear(path, self.storage_type(path)) {
            self.fail("storing_into_discard_linear");
        }
        var j = 0usize;
        while j < empty.len() {
            if prefix(path, empty.get(j)) {
                places.empty.remove(empty.get(j));
            }
            j = j + 1usize;
        }
        places.forget(path, true);
    }

    // Any number of whole roots, and at most two paths below roots, which part at a struct or tuple.
    fn lend(self, paths: Seq[Text]) {
        var i = 0usize;
        while i < paths.len() {
            let p = paths.get(i);
            if !self.places.get().full(p) {
                self.fail("lent_place_full");
            }
            self.nested_view_closed(p);
            var j = i + 1usize;
            while j < paths.len() {
                if overlap(p, paths.get(j)) {
                    self.fail("lent_places_overlap");
                }
                j = j + 1usize;
            }
            i = i + 1usize;
        }
        let nested: Seq[Text] = Seq::new();
        var k = 0usize;
        while k < paths.len() {
            if paths.get(k).contains(text(".")) {
                nested.push(paths.get(k));
            }
            k = k + 1usize;
        }
        if nested.len() > 2usize {
            self.fail("at_most_two_nested_lends");
        }
        if nested.len() == 2usize && !self.product_branches(nested) {
            self.fail("nested_lends_part_at_a_product");
        }
    }

    fn common_parent(self, paths: Seq[Text]) -> Text {
        let parts = split_all(paths);
        join(parts.get(0usize).slice(0usize, common_depth(parts)))
    }

    // The paths part at a struct or tuple, and reach it through structs and tuples only, past no
    // known variant or opened view.
    fn product_branches(self, paths: Seq[Text]) -> bool {
        let parts = split_all(paths);
        let common = common_depth(parts);
        if segments_agree(parts, common) {
            return false;
        }
        let places = self.places.get();
        var i = 0usize;
        while i < parts.len() {
            let s = parts.get(i);
            var depth = 1usize;
            while depth < s.len() {
                let step = join(s.slice(0usize, depth));
                if places.known.has(step) || places.opened.has(step)
                    || !is_struct_or_tuple(self.types.shape(self.path_type(step), self.home.get())) {
                    return false;
                }
                depth = depth + 1usize;
            }
            i = i + 1usize;
        }
        true
    }

    fn after_call(self, paths: Seq[Text]) {
        var i = 0usize;
        while i < paths.len() {
            self.places.get().forget(paths.get(i), true);
            i = i + 1usize;
        }
    }

    // ---------------------------------------------------------------- premises --

    // A premise is discharged by an assumption, or by an instance whose head matches and whose own
    // premises hold.
    fn holds(self, trait_name: Text, args: Seq[Type]) -> bool {
        if trait_name.is("builtin::Exposed") {
            return args.len() == 1usize && self.types.exposure_available(args.get(0usize), self.home.get(), self.kinds.get(), self.premises.get());
        }
        let premises = self.premises.get();
        var i = 0usize;
        while i < premises.len() {
            let p = premises.get(i);
            if p.trait_name.eq(trait_name) && p.args.len() == args.len() {
                var all = true;
                var j = 0usize;
                while all && j < args.len() {
                    all = equal(p.args.get(j), args.get(j));
                    j = j + 1usize;
                }
                if all {
                    return true;
                }
            }
            i = i + 1usize;
        }
        self.find_instance(trait_name, args).is_some()
    }

    // Select the unique coherent head, with its index among the trait's instances; this does not
    // authorize its use.
    fn matching_instance(self, trait_name: Text, args: Seq[Type]) -> Option[(usize, Instance, Map[Text, Type])] {
        let insts = match self.program.instances.get(trait_name) {
            Option::Some(insts) => insts,
            Option::None => {
                return Option::None;
            },
        };
        var i = 0usize;
        while i < insts.len() {
            let inst = insts.get(i);
            match match_head(inst.params, inst.head, args, true, self.counter) {
                Option::Some(sub) => {
                    return Option::Some.((i, inst, sub));
                },
                Option::None => (),
            };
            i = i + 1usize;
        }
        Option::None
    }

    fn find_instance(self, trait_name: Text, args: Seq[Type]) -> Option[(usize, Instance, Map[Text, Type])] {
        let found = self.matching_instance(trait_name, args);
        let (_index, inst, sub) = match found {
            Option::Some(f) => f,
            Option::None => {
                return Option::None;
            },
        };
        var p = 0usize;
        while p < inst.params.len() {
            let param = inst.params.get(p);
            if C::same_kind(param.kind, Kind::Copy) && !self.copy_type(sub.at(param.name)) {
                return Option::None;
            }
            p = p + 1usize;
        }
        // A matched type can have been formed under a function type's own premises. Those
        // assumptions do not escape into this instance call.
        let saved_premises = self.formation.premises.get();
        let saved_home = self.formation.home.get();
        self.formation.premises.set(self.premises.get());
        self.formation.home.set(self.home.get());
        let chosen: Seq[Type] = Seq::new();
        var c = 0usize;
        while c < inst.params.len() {
            chosen.push(sub.at(inst.params.get(c).name));
            c = c + 1usize;
        }
        self.formation.arguments(inst.params, chosen, self.scope(), false);
        self.formation.premises.set(saved_premises);
        self.formation.home.set(saved_home);
        var q = 0usize;
        while q < inst.premises.len() {
            let premise = inst.premises.get(q);
            if !self.holds(premise.trait_name, subst_all(premise.args, sub, self.counter)) {
                return Option::None;
            }
            q = q + 1usize;
        }
        found
    }

    // -------------------------------------------------------------- signatures --

    fn instantiate(self, params: Seq[Param], premises: Seq[Premise], tys: Seq[Type]) -> Map[Text, Type] {
        if tys.len() != params.len() {
            self.fail("takes_type_arguments_got");
        }
        let sub: Map[Text, Type] = Map::new();
        var i = 0usize;
        while i < params.len() {
            let p = params.get(i);
            let t = tys.get(i);
            var skip = false;
            if C::same_kind(p.kind, Kind::Brand) {
                let unit = match t {
                    Type::Ignored => {
                        skip = true;
                    },
                    Type::Skolem(label) => {
                        if !self.brands.get().has(label) {
                            self.fail("brand_argument_scope");
                        }
                    },
                    _ => self.fail("brand_argument_scope"),
                };
            } else if C::same_kind(p.kind, Kind::Copy) && !self.copy_type(t) {
                self.fail("copy");
            }
            if !skip {
                sub.set(p.name, t);
            }
            i = i + 1usize;
        }
        var j = 0usize;
        while j < premises.len() {
            let premise = premises.get(j);
            if !self.holds(premise.trait_name, subst_all(premise.args, sub, self.counter)) {
                self.fail("unsatisfied_premise");
            }
            j = j + 1usize;
        }
        sub
    }

    fn signature(self, instr: Instr) -> Signature {
        let callee = instr.args.get(0usize);
        let tys = instr.tys;
        if callee.starts_with(text("%")) {
            let ty = self.use_value(callee);
            let f = match ty {
                Type::Fn(f) => f,
                _ => self.fail("function_value"),
            };
            let sub = self.instantiate(f.quantified, Seq::new(), tys);
            return Signature.{ ptypes: subst_all(f.params, sub, self.counter), ret: subst(f.ret.get(), sub, self.counter), is_unsafe: f.is_unsafe, places: f.places };
        }
        match self.program.externs.get(callee) {
            Option::Some(ext) => {
                let ptypes = match ext.ptypes {
                    Option::Some(p) => p,
                    Option::None => self.fail("extern_value_not_callable"),
                };
                let ret = match ext.ret {
                    Option::Some(r) => r,
                    Option::None => self.fail("extern_value_not_callable"),
                };
                return Signature.{ ptypes, ret, is_unsafe: true, places: Seq::new() };
            },
            Option::None => (),
        };
        let fun = match self.program.funs.get(callee) {
            Option::Some(f) => f,
            Option::None => self.fail("unknown_function"),
        };
        let sub = self.instantiate(fun.params, fun.premises, tys);
        Signature.{ ptypes: subst_all(fun.ptypes, sub, self.counter), ret: subst(fun.ret, sub, self.counter), is_unsafe: fun.is_unsafe, places: fun.places() }
    }

    fn arguments(self, ptypes: Seq[Type], args: Seq[Text], places: Seq[usize]) -> Seq[Text] {
        if ptypes.len() != args.len() {
            self.fail("expected_arguments_got");
        }
        let lent: Seq[Text] = Seq::new();
        var k = 0usize;
        while k < ptypes.len() {
            let want = ptypes.get(k);
            let arg = args.get(k);
            if places.has(k) != arg.starts_with(text("&")) {
                self.fail("argument_mode");
            }
            if arg.starts_with(text("&*")) {
                self.authorize(self.current_instr(), true);
                let ty = self.use_value(arg.from(2usize));
                let ok = match ty {
                    Type::Ptr(inner) => equal(inner.get(), want),
                    _ => false,
                };
                if !ok {
                    self.fail("raw_target_lend_wrong");
                }
            } else if arg.starts_with(text("&")) {
                if !equal(self.path_type(arg), want) {
                    self.fail("lent_place_type_expected");
                }
                lent.push(arg);
            } else {
                let got = self.use_value(arg);
                if !fits(got, want) {
                    self.fail("argument_expected");
                }
            }
            k = k + 1usize;
        }
        self.lend(lent);
        lent
    }

    fn current_instr(self) -> Instr {
        match self.instr.get() {
            Option::Some(instr) => instr,
            Option::None => kurs_error(text("internal error: no instruction is being checked"), no_pos()),
        }
    }

    fn authorize(self, instr: Instr, is_unsafe: bool) {
        if is_unsafe && !(self.fun().is_unsafe || instr.is_unsafe) {
            self.fail("unsafe_authorization");
        }
    }

    // ------------------------------------------------------------ instructions --

    fn check_instr(self, instr: Instr) {
        self.formation.pos.set(instr.pos);
        let op = instr.op;
        self.instr.set(Option::Some.(instr));
        let outs: Seq[Type] = if op.is("const") {
            Seq::one(self.op_const(instr))
        } else if op.is("copy") {
            Seq::one(self.op_copy(instr))
        } else if op.is("construct") {
            Seq::one(self.op_construct(instr))
        } else if op.is("destruct") {
            self.op_destruct(instr)
        } else if op.is("construct_variant") {
            Seq::one(self.op_construct_variant(instr))
        } else if op.is("variant_tag") {
            Seq::one(self.op_variant_tag(instr))
        } else if op.is("builtin::int_cast") {
            Seq::one(self.op_int_cast(instr))
        } else if op.is("builtin::unsafe::cast") {
            Seq::one(self.op_unsafe_cast(instr))
        } else if op.is("call") {
            Seq::one(self.op_call(instr))
        } else if op.is("trait_call") {
            Seq::one(self.op_trait_call(instr))
        } else if op.is("fn") {
            Seq::one(self.op_fn(instr))
        } else if op.is("alloca") {
            Seq::one(self.op_alloca(instr))
        } else if op.is("builtin::sizeof") {
            Seq::one(self.op_sizeof(instr))
        } else if op.is("data") {
            Seq::one(self.op_data(instr))
        } else if op.is("builtin::unsafe::static_brand") {
            Seq::one(self.op_unsafe_static_brand(instr))
        } else if op.is("builtin::fresh") {
            Seq::one(self.op_fresh(instr))
        } else if op.is("pack") {
            Seq::one(self.op_pack(instr))
        } else if op.is("open") {
            Seq::one(self.op_open(instr))
        } else if op.is("builtin::unsafe::deref") || op.is("builtin::unsafe::load_volatile") {
            Seq::one(self.op_unsafe_deref(instr))
        } else if op.is("builtin::unsafe::store") || op.is("builtin::unsafe::store_volatile") {
            Seq::one(self.op_unsafe_store(instr))
        } else if op.is("load") {
            Seq::one(self.op_load(instr))
        } else if op.is("store") {
            Seq::one(self.op_store(instr))
        } else if op.is("foreach") {
            Seq::one(self.op_foreach(instr))
        } else if is_arith(op) || is_order(op) || is_equality(op) || is_bits(op) {
            Seq::one(self.primitive(instr))
        } else if op.starts_with(text("builtin::unsafe::atomic_")) {
            Seq::one(self.atomic(instr))
        } else {
            self.fail("unknown_instruction")
        };
        if outs.len() != instr.lhs.len() {
            self.fail("produces_results_named");
        }
        var i = 0usize;
        while i < outs.len() {
            self.bind(instr.lhs.get(i), outs.get(i));
            i = i + 1usize;
        }
    }

    fn type_operand(self, instr: Instr) -> Type {
        match instr.ty {
            Option::Some(t) => t,
            Option::None => self.fail("instruction_requires_type"),
        }
    }

    fn op_const(self, instr: Instr) -> Type {
        let lit = match instr.lit {
            Option::Some(l) => l,
            Option::None => self.fail("const_requires_literal"),
        };
        let t = match instr.ty {
            Option::Some(t) => t,
            Option::None => self.fail("const_scalar_type"),
        };
        let unit = match t {
            Type::Prim(_name) => (),
            _ => self.fail("const_scalar_type"),
        };
        self.scalar_literal(t, lit);
        t
    }

    fn scalar_literal(self, t: Type, lit: Text) {
        if !valid_literal(t, lit) {
            self.fail("invalid");
        }
    }

    fn op_copy(self, instr: Instr) -> Type {
        let t = self.peek(instr.args.get(0usize));
        if !self.copy_type(t) {
            self.fail("copy_linear");
        }
        t
    }

    fn op_construct(self, instr: Instr) -> Type {
        let ty = self.type_operand(instr);
        let want: Seq[Type] = match self.types.shape(ty, self.home.get()) {
            Type::Array(elem, length) => {
                let n = instr.args.len() as u64;
                if !(n == length || 0u64 < n && n < length && self.copy_type(elem.get())) {
                    self.fail("array_construct_element_copy");
                }
                let out: Seq[Type] = Seq::new();
                var i = 0u64;
                while i < n {
                    out.push(elem.get());
                    i = i + 1u64;
                }
                out
            },
            _ => {
                let fields = self.types.fields(ty, self.home.get());
                if fields.len() != instr.args.len() {
                    self.fail("components_given");
                }
                fields
            },
        };
        var i = 0usize;
        while i < instr.args.len() && i < want.len() {
            let got = self.use_value(instr.args.get(i));
            if !fits(got, want.get(i)) {
                self.fail("component_expected");
            }
            i = i + 1usize;
        }
        ty
    }

    fn op_destruct(self, instr: Instr) -> Seq[Type] {
        let ty = self.type_operand(instr);
        let arg = instr.args.get(0usize);
        let got = if arg.starts_with(text("&")) { self.load(arg) } else { self.use_value(arg) };
        match got {
            Type::Ptr(inner) => {
                if !equal(got, ty) {
                    self.fail("destruct");
                }
                let fields = self.types.fields(inner.get(), self.home.get());
                let out: Seq[Type] = Seq::new();
                var i = 0usize;
                while i < fields.len() {
                    out.push(C::ptr(fields.get(i)));
                    i = i + 1usize;
                }
                out
            },
            _ => {
                if !equal(got, ty) {
                    self.fail("destruct");
                }
                self.types.fields(ty, self.home.get()).copy()
            },
        }
    }

    fn op_construct_variant(self, instr: Instr) -> Type {
        let ty = self.type_operand(instr);
        let variants = self.types.variants(ty, self.home.get());
        let payload = match instr.lit {
            Option::Some(lit) => match member(variants, lit) {
                Option::Some(t) => t,
                Option::None => self.fail("variant"),
            },
            Option::None => self.fail("variant"),
        };
        let got = self.use_value(instr.args.get(0usize));
        if !fits(got, payload) {
            self.fail("payload_expected");
        }
        ty
    }

    fn op_variant_tag(self, instr: Instr) -> Type {
        let ty = self.type_operand(instr);
        let arg = instr.args.get(0usize);
        let got = if arg.starts_with(text("&")) {
            if !self.places.get().full(arg) {
                self.fail("readable_tag");
            }
            self.path_type(arg)
        } else {
            self.peek(arg)
        };
        if !equal(got, ty) {
            self.fail("variant_tag");
        }
        let unit = self.types.variants(ty, self.home.get());
        C::u32_type()
    }

    fn op_int_cast(self, instr: Instr) -> Type {
        let got = self.use_value(instr.args.get(0usize));
        let target = match instr.ty {
            Option::Some(t) => is_integer_type(t),
            Option::None => false,
        };
        let ok = is_integer_type(got) && target;
        if !ok {
            self.fail("int_cast_converts_between");
        }
        self.type_operand(instr)
    }

    fn op_unsafe_cast(self, instr: Instr) -> Type {
        let ty = self.type_operand(instr);
        self.authorize(instr, true);
        let got = self.use_value(instr.args.get(0usize));
        if self.contains(got) || self.contains(ty) {
            self.fail("unsafe_cast_cannot_produce");
        }
        ty
    }

    // `uncastable` holds somewhere in the value representation of `ty`: a pointer's target is not
    // part of it.
    fn contains(self, ty: Type) -> bool {
        if self.uncastable(ty) {
            return true;
        }
        match ty {
            Type::Ptr(_inner) => false,
            _ => {
                let parts = children(ty);
                var found = false;
                var i = 0usize;
                while !found && i < parts.len() {
                    found = self.contains(parts.get(i));
                    i = i + 1usize;
                }
                found
            },
        }
    }

    // What no unsafe cast may conjure in a value: a package, a brand witness, a function value, a
    // transform, a value of an abstract type parameter, or Never. Behind a pointer, reading any of
    // them is a separate unsafe operation.
    fn uncastable(self, ty: Type) -> bool {
        match ty {
            Type::Exists(_binders, _body) => true,
            Type::Brand(_brand) => true,
            Type::Fn(_f) => true,
            Type::Foreach(_f) => true,
            Type::Never => true,
            Type::Named(name, args) => args.is_empty() && self.kinds.get().has(name),
            _ => false,
        }
    }

    fn primitive(self, instr: Instr) -> Type {
        if instr.args.len() != 2usize {
            self.fail("takes_two_operands");
        }
        let x = self.use_value(instr.args.get(0usize));
        let y = self.use_value(instr.args.get(1usize));
        if !equal(x, y) {
            self.fail("operands_differ");
        }
        let (integer, floating, scalar) = match x {
            Type::Prim(name) => (C::is_integer(name), C::is_float(name), true),
            Type::Ptr(_inner) => (false, false, true),
            _ => (false, false, false),
        };
        let op = instr.op;
        let ok = if is_order(op) || is_arith(op) && !op.is("mod") {
            integer || floating
        } else if is_bits(op) || op.is("mod") {
            integer
        } else {
            scalar
        };
        if !ok {
            self.fail("does_apply");
        }
        if is_order(op) || is_equality(op) { C::bool_type() } else { x }
    }

    fn op_call(self, instr: Instr) -> Type {
        let sig = self.signature(instr);
        self.authorize(instr, sig.is_unsafe);
        self.after_call(self.arguments(sig.ptypes, instr.args.from(1usize), sig.places));
        sig.ret
    }

    fn op_trait_call(self, instr: Instr) -> Type {
        let tr = match self.program.traits.get(instr.args.get(0usize)) {
            Option::Some(tr) => tr,
            Option::None => self.fail("unknown_trait_wrong_arity"),
        };
        if tr.params.len() != instr.tys.len() {
            self.fail("unknown_trait_wrong_arity");
        }
        var found: Option[Method] = Option::None;
        var i = 0usize;
        while found.is_none() && i < tr.methods.len() {
            if tr.methods.get(i).name.eq(instr.args.get(1usize)) {
                found = Option::Some.(tr.methods.get(i));
            }
            i = i + 1usize;
        }
        let sig = match found {
            Option::Some(m) => m,
            Option::None => self.fail("trait_method"),
        };
        if !self.holds(tr.name, instr.tys) {
            self.fail("evidence");
        }
        let sub: Map[Text, Type] = Map::new();
        var p = 0usize;
        while p < tr.params.len() {
            sub.set(tr.params.get(p), instr.tys.get(p));
            p = p + 1usize;
        }
        self.authorize(instr, sig.is_unsafe);
        self.after_call(self.arguments(subst_all(sig.ptypes, sub, self.counter), instr.args.from(2usize), sig.places));
        subst(sig.ret, sub, self.counter)
    }

    fn op_fn(self, instr: Instr) -> Type {
        let name = instr.args.get(0usize);
        match self.program.externs.get(name) {
            Option::Some(ext) => {
                let ptypes = match ext.ptypes {
                    Option::Some(p) => p,
                    Option::None => self.fail("extern_value_not_callable"),
                };
                let ret = match ext.ret {
                    Option::Some(r) => r,
                    Option::None => self.fail("extern_value_not_callable"),
                };
                return C::fn_type(ptypes, ret, Seq::new(), true, Seq::new());
            },
            Option::None => (),
        };
        let fun = match self.program.funs.get(name) {
            Option::Some(f) => f,
            Option::None => self.fail("unknown_function"),
        };
        let retained: Seq[Param] = Seq::new();
        var i = 0usize;
        while i < fun.params.len() && i < instr.tys.len() {
            let p = fun.params.get(i);
            let ignored = match instr.tys.get(i) {
                Type::Ignored => true,
                _ => false,
            };
            if C::same_kind(p.kind, Kind::Brand) && ignored {
                retained.push(p);
            }
            i = i + 1usize;
        }
        let retained_brands: Set[Text] = Set::new();
        var r = 0usize;
        while r < retained.len() {
            retained_brands.add(retained.get(r).name);
            r = r + 1usize;
        }
        // A function value may keep brands quantified, but no premise on them: every premise is
        // discharged where the value is made.
        var q = 0usize;
        while q < fun.premises.len() {
            let args = fun.premises.get(q).args;
            var a = 0usize;
            while a < args.len() {
                if sets_meet(retained_brands, free_brands(args.get(a))) {
                    self.fail("retained_brand_with_premise");
                }
                a = a + 1usize;
            }
            q = q + 1usize;
        }
        let sub = self.instantiate(fun.params, fun.premises, instr.tys);
        C::fn_type(subst_all(fun.ptypes, sub, self.counter), subst(fun.ret, sub, self.counter), retained, fun.is_unsafe, fun.places())
    }

    // How a zero-size type is laid out in memory is not decided yet, so nothing may observe it:
    // `sizeof`, `alloca`, unsafe memory operations and extern parameters reject zero-size types.
    fn has_memory_form(self, ty: Type) {
        if self.types.zero_size(ty) {
            self.fail("zero_size_type_has_no_memory_form");
        }
    }

    fn op_alloca(self, instr: Instr) -> Type {
        let ty = self.type_operand(instr);
        self.authorize(instr, true);
        self.has_memory_form(ty);
        C::ptr(ty)
    }

    fn op_sizeof(self, instr: Instr) -> Type {
        let ty = self.type_operand(instr);
        self.has_memory_form(ty);
        C::usize_type()
    }

    fn op_data(self, instr: Instr) -> Type {
        match self.program.datas.get(instr.args.get(0usize)) {
            Option::Some(data) => C::ptr(data.ty),
            Option::None => self.fail("unknown_data"),
        }
    }

    fn op_unsafe_static_brand(self, instr: Instr) -> Type {
        self.authorize(instr, true);
        Type::Brand.(Cell::new(Type::Skolem.(static_brand())))
    }

    fn op_fresh(self, instr: Instr) -> Type {
        Type::Exists.(Seq::one(text("k")), Cell::new(Type::Brand.(Cell::new(Type::Skolem.(text("k"))))))
    }

    fn op_pack(self, instr: Instr) -> Type {
        let t = match instr.ty {
            Option::Some(t) => t,
            Option::None => self.fail("pack_existential_type_brand"),
        };
        let (binders, body) = match t {
            Type::Exists(binders, body) => (binders, body.get()),
            _ => self.fail("pack_existential_type_brand"),
        };
        if instr.tys.len() != binders.len() {
            self.fail("pack_existential_type_brand");
        }
        let witnesses: Seq[Text] = Seq::new();
        var i = 0usize;
        while i < instr.tys.len() {
            let unit = match instr.tys.get(i) {
                Type::Skolem(label) => {
                    if !self.brands.get().has(label) {
                        self.fail("pack_witness_scope");
                    }
                    witnesses.push(label);
                },
                _ => self.fail("pack_witness_scope"),
            };
            i = i + 1usize;
        }
        let sub: Map[Text, Type] = Map::new();
        var j = 0usize;
        while j < binders.len() {
            sub.set(binders.get(j), instr.tys.get(j));
            j = j + 1usize;
        }
        let payload = subst(body, sub, self.counter);
        let arg = instr.args.get(0usize);
        if arg.starts_with(text("&")) {
            let places = self.places.get();
            let matches = match places.opened.get(arg) {
                Option::Some(view) => view.same(witnesses),
                Option::None => false,
            };
            if !matches {
                self.fail("open_at_those_brands");
            }
            if !equal(self.path_type(arg), payload) {
                self.fail("packing");
            }
            if !places.full(arg) {
                self.fail("pack_place_full");
            }
            places.forget(arg, false);
            if !equal(self.path_type(arg), t) {
                self.fail("pack_place_type");
            }
            return C::unit();
        }
        let got = self.use_value(arg);
        if !fits(got, payload) {
            self.fail("packing");
        }
        t
    }

    fn op_open(self, instr: Instr) -> Type {
        let arg = instr.args.get(0usize);
        let brands = self.brands.get();
        var i = 0usize;
        while i < instr.binders.len() {
            if brands.has(instr.binders.get(i)) {
                self.fail("open_binder_already_scope");
            }
            brands.add(instr.binders.get(i));
            i = i + 1usize;
        }
        if arg.starts_with(text("&")) {
            let places = self.places.get();
            if places.opened.has(arg) {
                self.fail("place_already_open");
            }
            let ok = match self.path_type(arg) {
                Type::Exists(binders, _body) => binders.len() == instr.binders.len() && places.full(arg),
                _ => false,
            };
            if !ok {
                self.fail("full_package_brands");
            }
            places.opened.set(arg, instr.binders);
            return C::unit();
        }
        match self.use_value(arg) {
            Type::Exists(binders, body) => {
                if binders.len() != instr.binders.len() {
                    self.fail("open_binders");
                }
                let sub: Map[Text, Type] = Map::new();
                var j = 0usize;
                while j < binders.len() {
                    sub.set(binders.get(j), Type::Skolem.(instr.binders.get(j)));
                    j = j + 1usize;
                }
                subst(body.get(), sub, self.counter)
            },
            _ => self.fail("open_binders"),
        }
    }

    // Also `builtin::unsafe::load_volatile`.
    fn op_unsafe_deref(self, instr: Instr) -> Type {
        self.authorize(instr, true);
        let inner = match self.use_value(instr.args.get(0usize)) {
            Type::Ptr(inner) => inner.get(),
            _ => self.fail("deref_non_pointer"),
        };
        if is_never(inner) {
            self.fail("unsafe_read_cannot_produce_never");
        }
        self.has_memory_form(inner);
        inner
    }

    // Also `builtin::unsafe::store_volatile`.
    fn op_unsafe_store(self, instr: Instr) -> Type {
        self.authorize(instr, true);
        let p = self.use_value(instr.args.get(0usize));
        let v = self.use_value(instr.args.get(1usize));
        let inner = match p {
            Type::Ptr(inner) => inner.get(),
            _ => self.fail("store_through_pointer_another"),
        };
        if !fits(v, inner) {
            self.fail("store_through_pointer_another");
        }
        self.has_memory_form(inner);
        C::unit()
    }

    fn atomic(self, instr: Instr) -> Type {
        self.authorize(instr, true);
        let kind = instr.op.from(text("builtin::unsafe::atomic_").len);
        let arity = match atomic_arity(kind) {
            Option::Some(n) => n,
            Option::None => self.fail("unknown_atomic_operation"),
        };
        if instr.args.len() != arity {
            self.fail("atomic_operand_count");
        }
        let order = match instr.lit {
            Option::Some(o) => o,
            Option::None => self.fail("atomic_requires_ordering"),
        };
        if kind.is("compare_exchange") {
            let (success, failure) = match order.find(text("/"), 0usize) {
                Option::Some(at) => (order.slice(0usize, at), order.from(at + 1usize)),
                Option::None => (order, text("")),
            };
            let allowed = match cas_failure(success) {
                Option::Some(a) => a.has(failure),
                Option::None => false,
            };
            if !allowed {
                self.fail("bad_compare_exchange_ordering");
            }
        } else if !is_ordering(order) || kind.is("load") && (order.is("release") || order.is("acq_rel"))
            || kind.is("store") && (order.is("acquire") || order.is("acq_rel")) || kind.is("fence") && order.is("relaxed") {
            self.fail("bad_ordering");
        }
        if kind.is("fence") {
            return C::unit();
        }
        let inner = match self.use_value(instr.args.get(0usize)) {
            Type::Ptr(inner) => inner.get(),
            _ => self.fail("atomic_operation_non_pointer"),
        };
        let integer = is_integer_type(inner);
        let pointer = match inner {
            Type::Ptr(_x) => true,
            _ => false,
        };
        let transfer = C::same(inner, C::bool_type()) || pointer;
        if kind.starts_with(text("fetch_")) && !integer || !(integer || transfer) {
            self.fail("atomic_pointee_type");
        }
        var i = 1usize;
        while i < instr.args.len() {
            if !equal(self.use_value(instr.args.get(i)), inner) {
                self.fail("atomic_operand_wrong_type");
            }
            i = i + 1usize;
        }
        if kind.is("store") {
            C::unit()
        } else if kind.is("compare_exchange") {
            Type::Tuple.(Seq::two(inner, C::bool_type()))
        } else {
            inner
        }
    }

    fn op_load(self, instr: Instr) -> Type {
        self.load(instr.args.get(0usize))
    }

    fn op_store(self, instr: Instr) -> Type {
        self.store(instr.args.get(0usize), self.use_value(instr.args.get(1usize)));
        C::unit()
    }

    fn op_foreach(self, instr: Instr) -> Type {
        let t = match instr.ty {
            Option::Some(ty) => ty,
            Option::None => self.fail("foreach_builds_foreach_type"),
        };
        let f = match t {
            Type::Foreach(f) => f,
            _ => self.fail("foreach_builds_foreach_type"),
        };
        let got = self.use_value(instr.args.get(0usize));
        if !equal(got, f.source.get()) {
            self.fail("foreach_source");
        }
        if !self.holds(text("builtin::Exposed"), Seq::one(f.source.get())) {
            self.fail("foreach_source_not_exposed");
        }
        if !self.types.pattern_available(f, self.home.get(), self.kinds.get()) {
            self.fail("foreach_pointer_pattern_requires_pointer_components");
        }
        let mapper = match self.program.funs.get(instr.args.get(1usize)) {
            Option::Some(m) => m,
            Option::None => self.fail("unknown_mapper"),
        };
        let binders = foreach_binders(f);
        if mapper.params.len() != binders.len() + instr.tys.len() || !mapper.places().is_empty() {
            self.fail("mapper_takes_traversal_binders");
        }
        let sub: Map[Text, Type] = Map::new();
        var i = 0usize;
        while i < mapper.params.len() && i < binders.len() {
            sub.set(mapper.params.get(i).name, C::named(binders.get(i), Seq::new()));
            i = i + 1usize;
        }
        var j = binders.len();
        while j < mapper.params.len() {
            sub.set(mapper.params.get(j).name, instr.tys.get(j - binders.len()));
            j = j + 1usize;
        }
        // The mapper is checked for an arbitrary component, not only today's rows.
        let saved_kinds = self.kinds.get();
        let kinds = saved_kinds.copy();
        var b = 0usize;
        while b < binders.len() {
            kinds.set(binders.get(b), Kind::Any);
            b = b + 1usize;
        }
        self.kinds.set(kinds);
        let chosen: Seq[Type] = Seq::new();
        var c = 0usize;
        while c < mapper.params.len() {
            chosen.push(sub.at(mapper.params.get(c).name));
            c = c + 1usize;
        }
        let unit = self.instantiate(mapper.params, mapper.premises, chosen);
        self.kinds.set(saved_kinds);
        let item = foreach_item(f);
        let ptypes = subst_all(mapper.ptypes, sub, self.counter);
        if ptypes.is_empty() || !equal(ptypes.get(0usize), item) || !equal(subst(mapper.ret, sub, self.counter), f.body.get()) {
            self.fail("mapper_does_map");
        }
        var k = 2usize;
        while k < instr.args.len() && k - 1usize < ptypes.len() {
            let got = self.use_value(instr.args.get(k));
            if !self.copy_type(got) || !fits(got, ptypes.get(k - 1usize)) {
                self.fail("foreach_capture_copy_fit");
            }
            k = k + 1usize;
        }
        if instr.args.len() - 2usize != ptypes.len() - 1usize {
            self.fail("foreach_capture_count_disagrees");
        }
        self.authorize(instr, mapper.is_unsafe);
        t
    }

    // ------------------------------------------------------------- terminators --

    fn check_term(self, term: Terminator, last: Option[Instr]) {
        match term {
            Terminator::Ret(value, _pos) => {
                let fun = self.fun();
                let got = self.use_value(value);
                if !fits(got, fun.ret) {
                    self.fail("returning_function");
                }
                self.accounted(self.used.get());
                let roots = self.roots.get();
                let param_roots = self.param_roots.get();
                let places = self.places.get();
                let names = roots.keys();
                var i = 0usize;
                while i < names.len() {
                    let root = names.get(i);
                    let ty = roots.at(root);
                    if param_roots.has(root) && any_key(places.opened, |q: Text| prefix(root, q)) {
                        self.fail("place_parameter_sealed");
                    }
                    if param_roots.has(root) && !places.full(root) {
                        self.fail("place_parameter_restored");
                    }
                    if !param_roots.has(root) && !self.no_linear(root, ty) {
                        self.fail("local_place_still_holds");
                    }
                    i = i + 1usize;
                }
                let generic = brand_params(self.params.get());
                let found = free_brands(got).items();
                var local = false;
                var k = 0usize;
                while k < found.len() {
                    if !generic.has(found.get(k)) && !found.get(k).eq(static_brand()) {
                        local = true;
                    }
                    k = k + 1usize;
                }
                if local && !is_never(got) {
                    self.fail("result_mentions_local_brands");
                }
            },
            Terminator::Jmp(edge, _pos) => self.edge(edge, self.used.get(), self.places.get(), Option::None),
            Terminator::Jnz(cond, then, other, _pos) => {
                if !C::same(self.use_value(cond), C::bool_type()) {
                    self.fail("jnz_bool_condition");
                }
                let used = self.used.get().copy();
                self.edge(then, used.copy(), self.places.get().copy(), Option::None);
                self.edge(other, used.copy(), self.places.get().copy(), Option::None);
            },
            Terminator::Switch(scrutinee, ty, arms, _pos) => self.switch(scrutinee, ty, arms),
            Terminator::Unreachable(_pos) => {
                let ok = match last {
                    Option::Some(instr) => instr.lhs.len() == 1usize && is_never(self.env.get().at(instr.lhs.get(0usize))),
                    Option::None => false,
                };
                if !ok {
                    self.fail("unreachable_follow_instruction_producing");
                }
            },
        };
    }

    fn edge(self, edge: Edge, used: Set[Text], places: Places, payload: Option[Type]) {
        let fun = self.fun();
        let target = match self.blocks.get().get(edge.target) {
            Option::Some(b) => b,
            Option::None => self.fail("jump"),
        };
        if target.label.eq(fun.blocks.get(0usize).label) {
            self.fail("jump");
        }
        if edge.tys.len() != target.brands.len() {
            self.fail("takes_brand_arguments");
        }
        let sub: Map[Text, Type] = Map::new();
        var i = 0usize;
        while i < target.brands.len() {
            let t = edge.tys.get(i);
            let unit = match t {
                Type::Skolem(label) => {
                    if !self.brands.get().has(label) {
                        self.fail("brand_argument_scope");
                    }
                },
                _ => self.fail("brand_argument_scope"),
            };
            sub.set(target.brands.get(i), t);
            i = i + 1usize;
        }
        let offset = if payload.is_some() { 1usize } else { 0usize };
        if edge.args.len() + offset != target.params.len() {
            self.fail("takes_arguments_got");
        }
        let saved = self.used.get();
        self.used.set(used);
        var k = 0usize;
        while k < target.params.len() {
            let got = if k < offset {
                match payload {
                    Option::Some(t) => t,
                    Option::None => C::unit(),
                }
            } else {
                self.use_value(edge.args.get(k - offset))
            };
            if !fits(got, subst(target.params.get(k).type, sub, self.counter)) {
                self.fail("argument_expected");
            }
            k = k + 1usize;
        }
        self.accounted(self.used.get());
        self.used.set(saved);
        self.entails(places, target, sub);
        let kept = brand_params(self.params.get());
        kept.add(static_brand());
        let names = sub.keys();
        var n = 0usize;
        while n < names.len() {
            let unit = match sub.at(names.get(n)) {
                Type::Skolem(label) => {
                    if label.eq(names.get(n)) {
                        kept.add(names.get(n));
                    }
                },
                _ => (),
            };
            n = n + 1usize;
        }
        let roots = self.roots.get();
        let param_roots = self.param_roots.get();
        var r = 0usize;
        while r < roots.positions() {
            let root = match roots.entry(r) {
                Option::Some(name) => name,
                Option::None => text(""),
            };
            var emptied = false;
            var q = 0usize;
            while !emptied && q < target.empty.len() {
                emptied = prefix(target.empty.get(q), root);
                q = q + 1usize;
            }
            if !param_roots.has(root) && !emptied && !subset(self.root_brands(root), kept) {
                self.fail("full_local_block_brand");
            }
            r = r + 1usize;
        }
    }

    fn entails(self, places: Places, target: Block, sub: Map[Text, Type]) {
        let saved = self.places.get();
        self.places.set(places);
        let wanted: Map[Text, Seq[Text]] = Map::new();
        var o = 0usize;
        while o < target.opened.len() {
            let brands = target.opened.get(o).brands;
            let labels: Seq[Text] = Seq::new();
            var b = 0usize;
            while b < brands.len() {
                let label = match sub.get(brands.get(b)) {
                    Option::Some(t) => match t {
                        Type::Skolem(l) => l,
                        _ => brands.get(b),
                    },
                    Option::None => brands.get(b),
                };
                labels.push(label);
                b = b + 1usize;
            }
            wanted.set(target.opened.get(o).path, labels);
            o = o + 1usize;
        }
        if !opened_same(places.opened, wanted) {
            self.fail("opened_view_contract");
        }
        let target_empty = target.empty;
        if any_key(places.empty.map, |z: Text| !any_prefix(target_empty, z)) {
            self.fail("empty_assumes_full");
        }
        let fresh: Seq[Text] = Seq::new();
        var f = 0usize;
        while f < target.empty.len() {
            if !places.covered(target.empty.get(f)) {
                fresh.push(target.empty.get(f));
            }
            f = f + 1usize;
        }
        let roots: Set[Text] = Set::new();
        var s = 0usize;
        while s < fresh.len() {
            roots.add(segments(fresh.get(s)).get(0usize));
            s = s + 1usize;
        }
        let root_names = roots.items();
        var r = 0usize;
        while r < root_names.len() {
            let own: Seq[Text] = Seq::new();
            var q = 0usize;
            while q < fresh.len() {
                if segments(fresh.get(q)).get(0usize).eq(root_names.get(r)) {
                    own.push(fresh.get(q));
                }
                q = q + 1usize;
            }
            // One newly empty path per root, or leaves of one full product tree.
            if own.len() > 1usize && !(self.product_branches(own) && places.full(self.common_parent(own))) {
                self.fail("edge_empties_one_path_or_product_leaves");
            }
            r = r + 1usize;
        }
        var e = 0usize;
        while e < target.empty.len() {
            let q = target.empty.get(e);
            if !self.no_linear(q, self.storage_type(q)) {
                self.fail("holds_linear_contents_assumes");
            }
            e = e + 1usize;
        }
        var k = 0usize;
        while k < target.known.len() {
            let known = target.known.get(k);
            let ok = match places.known.get(known.path) {
                Option::Some(v) => v.eq(known.variant),
                Option::None => false,
            };
            if !ok {
                self.fail("assumes");
            }
            k = k + 1usize;
        }
        self.places.set(saved);
    }

    // An enum switch: one arm per variant, each variant once. A value switch passes each arm its
    // variant's payload; a place switch tells each arm which variant the place holds.
    fn switch(self, arg: Text, ty: Type, arms: Seq[Arm]) {
        let place = arg.starts_with(text("&"));
        let got = if place {
            let t = self.path_type(arg);
            if !self.places.get().full(arg) {
                self.fail("switch_which_full");
            }
            t
        } else {
            self.use_value(arg)
        };
        if !equal(got, ty) {
            self.fail("switch");
        }
        let unit = match self.types.shape(ty, self.home.get()) {
            Type::Prim(_name) => self.fail("switch_on_enum"),
            _ => (),
        };
        let variants = self.types.variants(ty, self.home.get());
        let names: Set[Text] = Set::new();
        let arm_names: Set[Text] = Set::new();
        var v = 0usize;
        while v < variants.len() {
            names.add(variants.get(v).name);
            v = v + 1usize;
        }
        var a = 0usize;
        while a < arms.len() {
            arm_names.add(arms.get(a).variant);
            a = a + 1usize;
        }
        if arm_names.len() != arms.len() || !subset(arm_names, names) || !subset(names, arm_names) {
            self.fail("switch_arm_per_variant");
        }
        let used = self.used.get().copy();
        var i = 0usize;
        while i < arms.len() {
            let arm = arms.get(i);
            let places = self.places.get().copy();
            var payload: Option[Type] = Option::None;
            if place {
                places.known.set(arg, arm.variant);
            } else {
                payload = member(variants, arm.variant);
            }
            self.edge(arm.edge, used.copy(), places, payload);
            i = i + 1usize;
        }
    }
}

fn split_all(paths: Seq[Text]) -> Seq[Seq[Text]] {
    let out: Seq[Seq[Text]] = Seq::new();
    var i = 0usize;
    while i < paths.len() {
        out.push(segments(paths.get(i)));
        i = i + 1usize;
    }
    out
}

// Every path has the same segment at `depth`.
fn segments_agree(parts: Seq[Seq[Text]], depth: usize) -> bool {
    let first = parts.get(0usize).get(depth);
    var all = true;
    var i = 1usize;
    while all && i < parts.len() {
        all = parts.get(i).get(depth).eq(first);
        i = i + 1usize;
    }
    all
}

// The number of leading segments the paths share, keeping at least one more segment in each.
fn common_depth(parts: Seq[Seq[Text]]) -> usize {
    var common = 0usize;
    var going = true;
    while going {
        var long = true;
        var i = 0usize;
        while long && i < parts.len() {
            long = parts.get(i).len() > common + 1usize;
            i = i + 1usize;
        }
        if long && segments_agree(parts, common) {
            common = common + 1usize;
        } else {
            going = false;
        }
    }
    common
}

fn check_program(program: Program, counter: Fresh) -> Checker {
    let checker = Checker::new(program, counter);
    checker.check();
    checker
}
