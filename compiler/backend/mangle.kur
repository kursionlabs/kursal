// Symbol names in the Itanium `_ZN...E` nested-name form (`kurs::path::h<hash>`, as `c++filt` shows
// them), where the hash is of the specialization's logical identity.
//
// This is a codegen convention, not a C++ ABI or a stable linking contract. `type_key` normalizes
// bound names; nominal names and free brands remain distinct. A specialization's type arguments are
// keyed `unbranded`, so code made for them does not depend on their brands.

use std::collections::arena_vec::ArenaVec;
use std::raw::Span;
use std::arena::Domain!;
use std::buffer::Buffer!;
use package::kurs::core::{Member, Param, Type};
use package::types::ops::{kind_name, kurs_error, map_children};
use package::syntax::ast::no_pos;
use std::option::Option;
use std::utf8::validate;

// The number of characters of UTF-8 text: its bytes that do not continue a character.
forall 'k.
fn char_count(&cx: Domain!['k], t: Span['k]) -> usize {
    var n = 0usize;
    var i = 0usize;
    while i < t.len() {
        if (t.byte_or_zero(&cx, i) & 192u8) != 128u8 {
            n = n + 1usize;
        }
        i = i + 1usize;
    }
    n
}

// Length framing avoids ambiguity without recursively escaping nested keys.
forall 'k.
fn encode(&cx: Domain!['k], parts: ArenaVec[Span['k], 'k]) -> Span['k] {
    var out = Buffer!::new();
    var i = 0usize;
    while i < parts.len(&cx) {
        out = out.push_usize(char_count(&cx, parts.at(&cx, i))).push_static(":").push_bytes(&cx, parts.at(&cx, i));
        i = i + 1usize;
    }
    out.save(&cx)
}

forall 'k.
fn bool_text(&cx: Domain!['k], b: bool) -> Span['k] {
    if b { Span::from_static(&cx, "True") } else { Span::from_static(&cx, "False") }
}

forall 'k.
fn number(&cx: Domain!['k], n: u64) -> Span['k] {
    Buffer!::new().push_u64(n).save(&cx)
}

forall 'k.
fn keys(&cx: Domain!['k], types: ArenaVec[Type['k], 'k], scope: ArenaVec[Span['k], 'k]) -> ArenaVec[Span['k], 'k] {
    let out: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
    var i = 0usize;
    while i < types.len(&cx) {
        out.push(&cx, type_key(&cx, types.at(&cx, i), scope));
        i = i + 1usize;
    }
    out
}

forall 'k.
fn any_branded(&cx: Domain!['k], types: ArenaVec[Type['k], 'k]) -> bool {
    var i = 0usize;
    while i < types.len(&cx) {
        if branded(&cx, types.at(&cx, i)) {
            return true;
        }
        i = i + 1usize;
    }
    false
}

forall 'k.
fn members_branded(&cx: Domain!['k], members: ArenaVec[Member['k], 'k]) -> bool {
    var i = 0usize;
    while i < members.len(&cx) {
        if branded(&cx, members.at(&cx, i).ty) {
            return true;
        }
        i = i + 1usize;
    }
    false
}

// Whether `ty` mentions a brand.
forall 'k.
fn branded(&cx: Domain!['k], ty: Type['k]) -> bool {
    match ty {
        Skolem(_label) => true,
        Named(_name, args) => any_branded(&cx, args),
        Brand(brand) => branded(&cx, brand.copy(&cx)),
        Ptr(inner) => branded(&cx, inner.copy(&cx)),
        NonNull(inner) => branded(&cx, inner.copy(&cx)),
        Array(elem, _length) => branded(&cx, elem.copy(&cx)),
        Tuple(elems) => any_branded(&cx, elems),
        Struct(fields) => members_branded(&cx, fields),
        Enum(variants) => members_branded(&cx, variants),
        Exists(_binders, body) => branded(&cx, body.copy(&cx)),
        Foreach(f) => branded(&cx, f.source.copy(&cx)) || branded(&cx, f.body.copy(&cx)),
        Fn(f) => any_branded(&cx, f.params) || branded(&cx, f.ret.copy(&cx)),
        _ => false,
    }
}

// `ty` with every brand, free or bound, written as the one brand `_`.
//
// A brand has no representation, and coherence never tells two instance heads apart by brands
// alone, so specializations whose type arguments differ only in brands make the same C.
forall 'k.
fn unbranded(&cx: Domain!['k], ty: Type['k]) -> Type['k] {
    match ty {
        Skolem(_label) => Type::Skolem.(Span::from_static(&cx, "_")),
        _ => if branded(&cx, ty) { map_children(&cx, ty, |&cx, child: Type['k]| unbranded(&cx, child)) } else { ty },
    }
}

// The position of the innermost binder of `name`, counted from the innermost.
forall 'k.
fn bound(&cx: Domain!['k], scope: ArenaVec[Span['k], 'k], name: Span['k]) -> Span['k] {
    var i = scope.len(&cx);
    var found = 0usize;
    var going = true;
    while going && i > 0usize {
        i = i - 1usize;
        if scope.at(&cx, i).eq(&cx, name) {
            found = scope.len(&cx) - 1usize - i;
            going = false;
        }
    }
    Buffer!::new().push_usize(found).save(&cx)
}

forall 'k.
fn type_key(&cx: Domain!['k], ty: Type['k], scope: ArenaVec[Span['k], 'k]) -> Span['k] {
    let parts: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
    match ty {
        Skolem(n) => {
            if scope.contains(&cx, n) {
                parts.push(&cx, Span::from_static(&cx, "bound-brand"));
                parts.push(&cx, bound(&cx, scope, n));
            } else {
                parts.push(&cx, Span::from_static(&cx, "brand"));
                parts.push(&cx, n);
            }
        },
        Named(n, args) => {
            if args.is_empty(&cx) && scope.contains(&cx, n) {
                parts.push(&cx, Span::from_static(&cx, "bound-type"));
                parts.push(&cx, bound(&cx, scope, n));
            } else {
                parts.push(&cx, Span::from_static(&cx, "named"));
                parts.push(&cx, n);
                parts.append(&cx, keys(&cx, args, scope));
            }
        },
        Prim(n) => {
            parts.push(&cx, Span::from_static(&cx, "prim"));
            parts.push(&cx, n);
        },
        Never => parts.push(&cx, Span::from_static(&cx, "never")),
        Tuple(elems) => {
            parts.push(&cx, Span::from_static(&cx, "tuple"));
            parts.append(&cx, keys(&cx, elems, scope));
        },
        Struct(fields) => {
            parts.push(&cx, Span::from_static(&cx, "Struct"));
            var i = 0usize;
            while i < fields.len(&cx) {
                parts.push(&cx, encode(&cx, ArenaVec::two(&cx, fields.at(&cx, i).name, type_key(&cx, fields.at(&cx, i).ty, scope))));
                i = i + 1usize;
            }
        },
        Enum(variants) => {
            parts.push(&cx, Span::from_static(&cx, "Enum"));
            var i = 0usize;
            while i < variants.len(&cx) {
                parts.push(&cx, encode(&cx, ArenaVec::two(&cx, variants.at(&cx, i).name, type_key(&cx, variants.at(&cx, i).ty, scope))));
                i = i + 1usize;
            }
        },
        Array(elem, length) => {
            parts.push(&cx, Span::from_static(&cx, "array"));
            parts.push(&cx, number(&cx, length));
            parts.push(&cx, type_key(&cx, elem.copy(&cx), scope));
        },
        Ptr(inner) => {
            parts.push(&cx, Span::from_static(&cx, "Ptr"));
            parts.push(&cx, type_key(&cx, inner.copy(&cx), scope));
        },
        NonNull(inner) => {
            parts.push(&cx, Span::from_static(&cx, "NonNull"));
            parts.push(&cx, type_key(&cx, inner.copy(&cx), scope));
        },
        Brand(brand) => {
            parts.push(&cx, Span::from_static(&cx, "Brand"));
            parts.push(&cx, type_key(&cx, brand.copy(&cx), scope));
        },
        Exists(names, body) => {
            parts.push(&cx, Span::from_static(&cx, "exists"));
            parts.push(&cx, number(&cx, names.len(&cx) as u64));
            parts.push(&cx, type_key(&cx, body.copy(&cx), scope.concat(&cx, names)));
        },
        Foreach(f) => {
            parts.push(&cx, Span::from_static(&cx, "foreach"));
            parts.push(&cx, bool_text(&cx, f.indirect));
            parts.push(&cx, type_key(&cx, f.source.copy(&cx), scope));
            parts.push(&cx, type_key(&cx, f.body.copy(&cx), scope.concat(&cx, ArenaVec::one(&cx, f.binder))));
        },
        Fn(f) => {
            let places: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
            var j = 0usize;
            while j < f.places.len(&cx) {
                places.push(&cx, number(&cx, f.places.at(&cx, j) as u64));
                j = j + 1usize;
            }
            parts.push(&cx, Span::from_static(&cx, "fn"));
            parts.push(&cx, bool_text(&cx, f.is_unsafe));
            parts.push(&cx, encode(&cx, places));
            parts.push(&cx, encode(&cx, keys(&cx, f.params, scope)));
            parts.push(&cx, type_key(&cx, f.ret.copy(&cx), scope));
        },
        Meta(_m) => kurs_error(&cx, Span::from_static(&cx, "cannot mangle an inference variable"), no_pos()),
    };
    encode(&cx, parts)
}

// A generic function's signature `ty`, its parameters `params` bound, so renaming them keeps the key.
forall 'k.
fn signature_key(&cx: Domain!['k], params: ArenaVec[Param['k], 'k], ty: Type['k]) -> Span['k] {
    let names: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
    let kinds: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
    var i = 0usize;
    while i < params.len(&cx) {
        names.push(&cx, params.at(&cx, i).name);
        kinds.push(&cx, kind_name(&cx, params.at(&cx, i).kind));
        i = i + 1usize;
    }
    encode(&cx, ArenaVec::two(&cx, encode(&cx, kinds), type_key(&cx, ty, names)))
}

fn hex_value(b: u8) -> u8 {
    if b >= b'0' && b <= b'9' { b - b'0' } else { b - b'a' + 10u8 }
}

fn is_lower_hex(b: u8) -> bool {
    b >= b'0' && b <= b'9' || b >= b'a' && b <= b'f'
}

// The bytes a linker identity segment encodes: `m` or `d` and pairs of lowercase hex digits that
// spell UTF-8 text. Any other segment encodes nothing.
forall 'k.
fn decode_segment(&cx: Domain!['k], seg: Span['k]) -> Option[Span['k]] {
    if seg.len() < 3usize || seg.len() % 2usize == 0usize || seg.byte_or_zero(&cx, 0usize) != b'm' && seg.byte_or_zero(&cx, 0usize) != b'd' {
        return Option::None;
    }
    var out = Buffer!::new();
    var i = 1usize;
    while i < seg.len() {
        if !is_lower_hex(seg.byte_or_zero(&cx, i)) || !is_lower_hex(seg.byte_or_zero(&cx, i + 1usize)) {
            out.destroy();
            return Option::None;
        }
        out = out.push_byte(hex_value(seg.byte_or_zero(&cx, i)) * 16u8 + hex_value(seg.byte_or_zero(&cx, i + 1usize)));
        i = i + 2usize;
    }
    let bytes = out.save(&cx);
    if validate(&cx, bytes) { Option::Some.(bytes) } else { Option::None }
}

// Decode linker segments for display, then escape bytes into C identifiers.
forall 'k.
fn path_segments(&cx: Domain!['k], name: Span['k]) -> ArenaVec[Span['k], 'k] {
    let parts: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
    let pieces = ArenaVec::split(&cx, name, Span::from_static(&cx, "::"));
    var i = 0usize;
    while i < pieces.len(&cx) {
        let part = match decode_segment(&cx, pieces.at(&cx, i)) {
            Some(bytes) => bytes,
            None => pieces.at(&cx, i),
        };
        // Escape underscores too, so punctuation cannot alias literal escapes.
        var out = Buffer!::new();
        var j = 0usize;
        while j < part.len() {
            let b = part.byte_or_zero(&cx, j);
            if b >= b'0' && b <= b'9' || b >= b'A' && b <= b'Z' || b >= b'a' && b <= b'z' {
                out = out.push_byte(b);
            } else {
                out = hex_byte(&cx, out.push_static("_"), b);
            }
            j = j + 1usize;
        }
        parts.push(&cx, if part.is_empty() {
            out.destroy();
            Span::from_static(&cx, "_empty")
        } else {
            out.save(&cx)
        });
        i = i + 1usize;
    }
    parts
}

// `b` as two lowercase hex digits.
forall 'k.
fn hex_byte(&cx: Domain!['k], out: Buffer!, b: u8) -> Buffer! {
    let digits = Span::from_static(&cx, "0123456789abcdef");
    out.push_byte(digits.byte_or_zero(&cx, (b / 16u8) as usize)).push_byte(digits.byte_or_zero(&cx, (b % 16u8) as usize))
}

forall 'k.
fn mangle(&cx: Domain!['k], path: ArenaVec[Span['k], 'k], identity: Span['k], salt: u64) -> Span['k] {
    let framed = ArenaVec::two(&cx, Span::from_static(&cx, "kurs"), identity);
    framed.push(&cx, number(&cx, salt));
    let digest = sha256_hex(&cx, encode(&cx, framed)).slice(0usize, 16usize);
    let parts: ArenaVec[Span['k], 'k] = ArenaVec::one(&cx, Span::from_static(&cx, "kurs"));
    parts.append(&cx, path);
    parts.push(&cx, Buffer!::new().push_static("h").push_bytes(&cx, digest).save(&cx));
    var out = Buffer!::new().push_static("_ZN");
    var i = 0usize;
    while i < parts.len(&cx) {
        out = out.push_usize(char_count(&cx, parts.at(&cx, i))).push_bytes(&cx, parts.at(&cx, i));
        i = i + 1usize;
    }
    out.push_static("E").save(&cx)
}

// ---------------------------------------------------------------- SHA-256 --

fn rotr(x: u32, n: u32) -> u32 {
    (x >> n) | (x << (32u32 - n))
}

forall 'k.
fn round_constants(&cx: Domain!['k]) -> ArenaVec[u32, 'k] {
    let k: ArenaVec[u32, 'k] = ArenaVec::new(&cx);
    push8(&cx, k, 1116352408u32, 1899447441u32, 3049323471u32, 3921009573u32, 961987163u32, 1508970993u32, 2453635748u32, 2870763221u32);
    push8(&cx, k, 3624381080u32, 310598401u32, 607225278u32, 1426881987u32, 1925078388u32, 2162078206u32, 2614888103u32, 3248222580u32);
    push8(&cx, k, 3835390401u32, 4022224774u32, 264347078u32, 604807628u32, 770255983u32, 1249150122u32, 1555081692u32, 1996064986u32);
    push8(&cx, k, 2554220882u32, 2821834349u32, 2952996808u32, 3210313671u32, 3336571891u32, 3584528711u32, 113926993u32, 338241895u32);
    push8(&cx, k, 666307205u32, 773529912u32, 1294757372u32, 1396182291u32, 1695183700u32, 1986661051u32, 2177026350u32, 2456956037u32);
    push8(&cx, k, 2730485921u32, 2820302411u32, 3259730800u32, 3345764771u32, 3516065817u32, 3600352804u32, 4094571909u32, 275423344u32);
    push8(&cx, k, 430227734u32, 506948616u32, 659060556u32, 883997877u32, 958139571u32, 1322822218u32, 1537002063u32, 1747873779u32);
    push8(&cx, k, 1955562222u32, 2024104815u32, 2227730452u32, 2361852424u32, 2428436474u32, 2756734187u32, 3204031479u32, 3329325298u32);
    k
}

forall 'k.
fn push8(&cx: Domain!['k], k: ArenaVec[u32, 'k], a: u32, b: u32, c: u32, d: u32, e: u32, f: u32, g: u32, h: u32) {
    k.push(&cx, a);
    k.push(&cx, b);
    k.push(&cx, c);
    k.push(&cx, d);
    k.push(&cx, e);
    k.push(&cx, f);
    k.push(&cx, g);
    k.push(&cx, h);
}

// Byte `i` of `data` padded as SHA-256 pads it to `total` bytes: a 1 bit, zeros, and the length in
// bits, big-endian, in the last 8 bytes.
forall 'k.
fn padded_byte(&cx: Domain!['k], data: Span['k], total: usize, i: usize) -> u32 {
    let n = data.len();
    if i < n {
        data.byte_or_zero(&cx, i) as u32
    } else if i == n {
        128u32
    } else if i + 8usize >= total {
        ((((n as u64) * 8u64) >> (((total - 1usize - i) * 8usize) as u64)) & 255u64) as u32
    } else {
        0u32
    }
}

// The big-endian word at byte `i` of the padded message.
forall 'k.
fn padded_word(&cx: Domain!['k], data: Span['k], total: usize, i: usize) -> u32 {
    (padded_byte(&cx, data, total, i) << 24u32) | (padded_byte(&cx, data, total, i + 1usize) << 16u32)
        | (padded_byte(&cx, data, total, i + 2usize) << 8u32) | padded_byte(&cx, data, total, i + 3usize)
}

forall 'k.
fn hex_word(&cx: Domain!['k], out: Buffer!, word: u32) -> Buffer! {
    hex_byte(&cx, hex_byte(&cx, hex_byte(&cx, hex_byte(&cx, out, (word >> 24u32) as u8), ((word >> 16u32) & 255u32) as u8), ((word >> 8u32) & 255u32) as u8), (word & 255u32) as u8)
}

// The SHA-256 digest of `data`, in lowercase hex. The message is read in place, padded as it is
// read, and each block's schedule is a window of its last 16 words, held in locals.
forall 'k.
fn sha256_hex(&cx: Domain!['k], data: Span['k]) -> Span['k] {
    let k = round_constants(&cx);
    var h0 = 1779033703u32;
    var h1 = 3144134277u32;
    var h2 = 1013904242u32;
    var h3 = 2773480762u32;
    var h4 = 1359893119u32;
    var h5 = 2600822924u32;
    var h6 = 528734635u32;
    var h7 = 1541459225u32;
    let total = (data.len() + 9usize + 63usize) / 64usize * 64usize;
    var chunk = 0usize;
    while chunk < total {
        var w0 = padded_word(&cx, data, total, chunk);
        var w1 = padded_word(&cx, data, total, chunk + 4usize);
        var w2 = padded_word(&cx, data, total, chunk + 8usize);
        var w3 = padded_word(&cx, data, total, chunk + 12usize);
        var w4 = padded_word(&cx, data, total, chunk + 16usize);
        var w5 = padded_word(&cx, data, total, chunk + 20usize);
        var w6 = padded_word(&cx, data, total, chunk + 24usize);
        var w7 = padded_word(&cx, data, total, chunk + 28usize);
        var w8 = padded_word(&cx, data, total, chunk + 32usize);
        var w9 = padded_word(&cx, data, total, chunk + 36usize);
        var w10 = padded_word(&cx, data, total, chunk + 40usize);
        var w11 = padded_word(&cx, data, total, chunk + 44usize);
        var w12 = padded_word(&cx, data, total, chunk + 48usize);
        var w13 = padded_word(&cx, data, total, chunk + 52usize);
        var w14 = padded_word(&cx, data, total, chunk + 56usize);
        var w15 = padded_word(&cx, data, total, chunk + 60usize);
        var a = h0;
        var b = h1;
        var c = h2;
        var d = h3;
        var e = h4;
        var f = h5;
        var g = h6;
        var hh = h7;
        var r = 0usize;
        while r < 64usize {
            // `w0` is the schedule's word `r`; the window moves on by one, taking word `r + 16`.
            let current = w0;
            let s0 = rotr(w1, 7u32) ^ rotr(w1, 18u32) ^ (w1 >> 3u32);
            let s1 = rotr(w14, 17u32) ^ rotr(w14, 19u32) ^ (w14 >> 10u32);
            let later = w0 + s0 + w9 + s1;
            w0 = w1;
            w1 = w2;
            w2 = w3;
            w3 = w4;
            w4 = w5;
            w5 = w6;
            w6 = w7;
            w7 = w8;
            w8 = w9;
            w9 = w10;
            w10 = w11;
            w11 = w12;
            w12 = w13;
            w13 = w14;
            w14 = w15;
            w15 = later;
            let big1 = rotr(e, 6u32) ^ rotr(e, 11u32) ^ rotr(e, 25u32);
            let choice = (e & f) ^ ((e ^ 4294967295u32) & g);
            let t1 = hh + big1 + choice + k.at(&cx, r) + current;
            let big0 = rotr(a, 2u32) ^ rotr(a, 13u32) ^ rotr(a, 22u32);
            let majority = (a & b) ^ (a & c) ^ (b & c);
            let t2 = big0 + majority;
            hh = g;
            g = f;
            f = e;
            e = d + t1;
            d = c;
            c = b;
            b = a;
            a = t1 + t2;
            r = r + 1usize;
        }
        h0 = h0 + a;
        h1 = h1 + b;
        h2 = h2 + c;
        h3 = h3 + d;
        h4 = h4 + e;
        h5 = h5 + f;
        h6 = h6 + g;
        h7 = h7 + hh;
        chunk = chunk + 64usize;
    }
    let out = hex_word(&cx, hex_word(&cx, hex_word(&cx, hex_word(&cx, Buffer!::new(), h0), h1), h2), h3);
    hex_word(&cx, hex_word(&cx, hex_word(&cx, hex_word(&cx, out, h4), h5), h6), h7).save(&cx)
}
