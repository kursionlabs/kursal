// Symbol names in the Itanium `_ZN...E` nested-name form (`kurs::path::h<hash>`, as `c++filt` shows
// them), where the hash is of the specialization's logical identity.
//
// This is a codegen convention, not a C++ ABI or a stable linking contract. `type_key` normalizes
// bound names; nominal names and free brands remain distinct. A specialization's type arguments are
// keyed `unbranded`, so code made for them does not depend on their brands.

use package::support::base::{Cx, Seq, Text, text, text_of};
use std::bytes::buffer::Buffer;
use package::kurs::core::{Member, Type};
use package::types::ops::{foreach_binders, kind_name, kurs_error, map_children};
use package::syntax::ast::no_pos;
use std::option::Option;

// The number of characters of UTF-8 text: its bytes that do not continue a character.
forall 'k.
fn char_count(&cx: Cx!['k], t: Text['k]) -> usize {
    var n = 0usize;
    var i = 0usize;
    while i < t.len() {
        if (t.byte(&cx, i) & 192u8) != 128u8 {
            n = n + 1usize;
        }
        i = i + 1usize;
    }
    n
}

// Length framing avoids ambiguity without recursively escaping nested keys.
forall 'k.
fn encode(&cx: Cx!['k], parts: Seq[Text['k], 'k]) -> Text['k] {
    var out = Buffer::new();
    var i = 0usize;
    while i < parts.len(&cx) {
        out = out.push_usize(char_count(&cx, parts.get(&cx, i))).push_static(":").push_bytes(&cx, parts.get(&cx, i));
        i = i + 1usize;
    }
    text_of(&cx, out)
}

forall 'k.
fn bool_text(&cx: Cx!['k], b: bool) -> Text['k] {
    if b { text(&cx, "True") } else { text(&cx, "False") }
}

forall 'k.
fn number(&cx: Cx!['k], n: u64) -> Text['k] {
    text_of(&cx, Buffer::new().push_u64(n))
}

forall 'k.
fn with_names(&cx: Cx!['k], scope: Seq[Text['k], 'k], names: Seq[Text['k], 'k]) -> Seq[Text['k], 'k] {
    let out = scope.copy(&cx);
    out.append(&cx, names);
    out
}

forall 'k.
fn keys(&cx: Cx!['k], types: Seq[Type['k], 'k], scope: Seq[Text['k], 'k]) -> Seq[Text['k], 'k] {
    let out: Seq[Text['k], 'k] = Seq::new(&cx);
    var i = 0usize;
    while i < types.len(&cx) {
        out.push(&cx, type_key(&cx, types.get(&cx, i), scope));
        i = i + 1usize;
    }
    out
}

forall 'k.
fn any_branded(&cx: Cx!['k], types: Seq[Type['k], 'k]) -> bool {
    var i = 0usize;
    while i < types.len(&cx) {
        if branded(&cx, types.get(&cx, i)) {
            return true;
        }
        i = i + 1usize;
    }
    false
}

forall 'k.
fn members_branded(&cx: Cx!['k], members: Seq[Member['k], 'k]) -> bool {
    var i = 0usize;
    while i < members.len(&cx) {
        if branded(&cx, members.get(&cx, i).type) {
            return true;
        }
        i = i + 1usize;
    }
    false
}

// Whether `ty` mentions a brand.
forall 'k.
fn branded(&cx: Cx!['k], ty: Type['k]) -> bool {
    match ty {
        Type::Skolem(_label) => true,
        Type::Named(_name, args) => any_branded(&cx, args),
        Type::Brand(brand) => branded(&cx, brand.get(&cx)),
        Type::Ptr(inner) => branded(&cx, inner.get(&cx)),
        Type::Array(elem, _length) => branded(&cx, elem.get(&cx)),
        Type::Tuple(elems) => any_branded(&cx, elems),
        Type::Struct(fields) => members_branded(&cx, fields),
        Type::Enum(variants) => members_branded(&cx, variants),
        Type::Exists(_binders, body) => branded(&cx, body.get(&cx)),
        Type::Foreach(f) => branded(&cx, f.source.get(&cx)) || branded(&cx, f.body.get(&cx)),
        Type::Fn(f) => any_branded(&cx, f.params) || branded(&cx, f.ret.get(&cx)),
        _ => false,
    }
}

// `ty` with every brand, free or bound, written as the one brand `_`.
//
// A brand has no representation, and coherence never tells two instance heads apart by brands
// alone, so specializations whose type arguments differ only in brands make the same C.
forall 'k.
fn unbranded(&cx: Cx!['k], ty: Type['k]) -> Type['k] {
    match ty {
        Type::Skolem(_label) => Type::Skolem.(text(&cx, "_")),
        _ => if branded(&cx, ty) { map_children(&cx, ty, |&cx, child: Type['k]| unbranded(&cx, child)) } else { ty },
    }
}

// The position of the innermost binder of `name`, counted from the innermost.
forall 'k.
fn bound(&cx: Cx!['k], scope: Seq[Text['k], 'k], name: Text['k]) -> Text['k] {
    var i = scope.len(&cx);
    var found = 0usize;
    var going = true;
    while going && i > 0usize {
        i = i - 1usize;
        if scope.get(&cx, i).eq(&cx, name) {
            found = scope.len(&cx) - 1usize - i;
            going = false;
        }
    }
    text_of(&cx, Buffer::new().push_usize(found))
}

forall 'k.
fn type_key(&cx: Cx!['k], ty: Type['k], scope: Seq[Text['k], 'k]) -> Text['k] {
    let parts: Seq[Text['k], 'k] = Seq::new(&cx);
    match ty {
        Type::Skolem(n) => {
            if scope.has(&cx, n) {
                parts.push(&cx, text(&cx, "bound-brand"));
                parts.push(&cx, bound(&cx, scope, n));
            } else {
                parts.push(&cx, text(&cx, "brand"));
                parts.push(&cx, n);
            }
        },
        Type::Named(n, args) => {
            if args.is_empty(&cx) && scope.has(&cx, n) {
                parts.push(&cx, text(&cx, "bound-type"));
                parts.push(&cx, bound(&cx, scope, n));
            } else {
                parts.push(&cx, text(&cx, "named"));
                parts.push(&cx, n);
                parts.append(&cx, keys(&cx, args, scope));
            }
        },
        Type::Prim(n) => {
            parts.push(&cx, text(&cx, "prim"));
            parts.push(&cx, n);
        },
        Type::Never => parts.push(&cx, text(&cx, "never")),
        Type::Ignored => parts.push(&cx, text(&cx, "ignored")),
        Type::Tuple(elems) => {
            parts.push(&cx, text(&cx, "tuple"));
            parts.append(&cx, keys(&cx, elems, scope));
        },
        Type::Struct(fields) => {
            parts.push(&cx, text(&cx, "Struct"));
            var i = 0usize;
            while i < fields.len(&cx) {
                parts.push(&cx, encode(&cx, Seq::two(&cx, fields.get(&cx, i).name, type_key(&cx, fields.get(&cx, i).type, scope))));
                i = i + 1usize;
            }
        },
        Type::Enum(variants) => {
            parts.push(&cx, text(&cx, "Enum"));
            var i = 0usize;
            while i < variants.len(&cx) {
                parts.push(&cx, encode(&cx, Seq::two(&cx, variants.get(&cx, i).name, type_key(&cx, variants.get(&cx, i).type, scope))));
                i = i + 1usize;
            }
        },
        Type::Array(elem, length) => {
            parts.push(&cx, text(&cx, "array"));
            parts.push(&cx, number(&cx, length));
            parts.push(&cx, type_key(&cx, elem.get(&cx), scope));
        },
        Type::Ptr(inner) => {
            parts.push(&cx, text(&cx, "Ptr"));
            parts.push(&cx, type_key(&cx, inner.get(&cx), scope));
        },
        Type::Brand(brand) => {
            parts.push(&cx, text(&cx, "Brand"));
            parts.push(&cx, type_key(&cx, brand.get(&cx), scope));
        },
        Type::Exists(names, body) => {
            parts.push(&cx, text(&cx, "exists"));
            parts.push(&cx, number(&cx, names.len(&cx) as u64));
            parts.push(&cx, type_key(&cx, body.get(&cx), with_names(&cx, scope, names)));
        },
        Type::Foreach(f) => {
            let binders = foreach_binders(&cx, f);
            parts.push(&cx, text(&cx, "foreach"));
            parts.push(&cx, bool_text(&cx, f.indirect));
            parts.push(&cx, number(&cx, binders.len(&cx) as u64));
            parts.push(&cx, type_key(&cx, f.source.get(&cx), scope));
            parts.push(&cx, type_key(&cx, f.body.get(&cx), with_names(&cx, scope, binders)));
        },
        Type::Fn(f) => {
            let names: Seq[Text['k], 'k] = Seq::new(&cx);
            let kinds: Seq[Text['k], 'k] = Seq::new(&cx);
            var i = 0usize;
            while i < f.quantified.len(&cx) {
                names.push(&cx, f.quantified.get(&cx, i).name);
                kinds.push(&cx, kind_name(&cx, f.quantified.get(&cx, i).kind));
                i = i + 1usize;
            }
            let inner = with_names(&cx, scope, names);
            let places: Seq[Text['k], 'k] = Seq::new(&cx);
            var j = 0usize;
            while j < f.places.len(&cx) {
                places.push(&cx, number(&cx, f.places.get(&cx, j) as u64));
                j = j + 1usize;
            }
            parts.push(&cx, text(&cx, "fn"));
            parts.push(&cx, bool_text(&cx, f.is_unsafe));
            parts.push(&cx, encode(&cx, places));
            parts.push(&cx, encode(&cx, kinds));
            parts.push(&cx, encode(&cx, keys(&cx, f.params, inner)));
            parts.push(&cx, type_key(&cx, f.ret.get(&cx), inner));
        },
        Type::Meta(_m) => kurs_error(&cx, text(&cx, "cannot mangle an inference variable"), no_pos()),
    };
    encode(&cx, parts)
}

fn hex_value(b: u8) -> u8 {
    if b >= b'0' && b <= b'9' { b - b'0' } else { b - b'a' + 10u8 }
}

fn is_lower_hex(b: u8) -> bool {
    b >= b'0' && b <= b'9' || b >= b'a' && b <= b'f'
}

// The bytes a linker identity segment encodes: `m` or `d` and pairs of lowercase hex digits that
// spell UTF-8 text. Any other segment encodes nothing.
forall 'k.
fn decode_segment(&cx: Cx!['k], seg: Text['k]) -> Option[Text['k]] {
    if seg.len() < 3usize || seg.len() % 2usize == 0usize || seg.byte(&cx, 0usize) != b'm' && seg.byte(&cx, 0usize) != b'd' {
        return Option::None;
    }
    var out = Buffer::new();
    var i = 1usize;
    while i < seg.len() {
        if !is_lower_hex(seg.byte(&cx, i)) || !is_lower_hex(seg.byte(&cx, i + 1usize)) {
            out.destroy();
            return Option::None;
        }
        out = out.push_byte(hex_value(seg.byte(&cx, i)) * 16u8 + hex_value(seg.byte(&cx, i + 1usize)));
        i = i + 2usize;
    }
    let bytes = text_of(&cx, out);
    if valid_utf8(&cx, bytes) { Option::Some.(bytes) } else { Option::None }
}

// `t` is well-formed UTF-8: no overlong forms, surrogates or code points past U+10FFFF.
forall 'k.
fn valid_utf8(&cx: Cx!['k], t: Text['k]) -> bool {
    var i = 0usize;
    while i < t.len() {
        let b = t.byte(&cx, i);
        let (count, low, high) = if b < 128u8 {
            (0usize, 128u8, 191u8)
        } else if b >= 194u8 && b <= 223u8 {
            (1usize, 128u8, 191u8)
        } else if b == 224u8 {
            (2usize, 160u8, 191u8)
        } else if b == 237u8 {
            (2usize, 128u8, 159u8)
        } else if b >= 225u8 && b <= 239u8 {
            (2usize, 128u8, 191u8)
        } else if b == 240u8 {
            (3usize, 144u8, 191u8)
        } else if b == 244u8 {
            (3usize, 128u8, 143u8)
        } else if b >= 241u8 && b <= 243u8 {
            (3usize, 128u8, 191u8)
        } else {
            return false;
        };
        if count > 0usize && i + count >= t.len() {
            return false;
        }
        var k = 1usize;
        while k <= count {
            let c = t.byte(&cx, i + k);
            let (lo, hi) = if k == 1usize { (low, high) } else { (128u8, 191u8) };
            if c < lo || c > hi {
                return false;
            }
            k = k + 1usize;
        }
        i = i + 1usize + count;
    }
    true
}

// Decode linker segments for display, then escape bytes into C identifiers.
forall 'k.
fn path_segments(&cx: Cx!['k], name: Text['k]) -> Seq[Text['k], 'k] {
    let parts: Seq[Text['k], 'k] = Seq::new(&cx);
    let pieces = name.split(&cx, text(&cx, "::"));
    var i = 0usize;
    while i < pieces.len(&cx) {
        let part = match decode_segment(&cx, pieces.get(&cx, i)) {
            Option::Some(bytes) => bytes,
            Option::None => pieces.get(&cx, i),
        };
        // Escape underscores too, so punctuation cannot alias literal escapes.
        var out = Buffer::new();
        var j = 0usize;
        while j < part.len() {
            let b = part.byte(&cx, j);
            if b >= b'0' && b <= b'9' || b >= b'A' && b <= b'Z' || b >= b'a' && b <= b'z' {
                out = out.push_byte(b);
            } else {
                out = hex_byte(&cx, out.push_static("_"), b);
            }
            j = j + 1usize;
        }
        parts.push(&cx, if part.is_empty() {
            out.destroy();
            text(&cx, "_empty")
        } else {
            text_of(&cx, out)
        });
        i = i + 1usize;
    }
    parts
}

// `b` as two lowercase hex digits.
forall 'k.
fn hex_byte(&cx: Cx!['k], out: Buffer!, b: u8) -> Buffer! {
    let digits = text(&cx, "0123456789abcdef");
    out.push_byte(digits.byte(&cx, (b / 16u8) as usize)).push_byte(digits.byte(&cx, (b % 16u8) as usize))
}

forall 'k.
fn mangle(&cx: Cx!['k], path: Seq[Text['k], 'k], identity: Text['k], salt: u64) -> Text['k] {
    let framed = Seq::two(&cx, text(&cx, "kurs"), identity);
    framed.push(&cx, number(&cx, salt));
    let digest = sha256_hex(&cx, encode(&cx, framed)).slice(0usize, 16usize);
    let parts: Seq[Text['k], 'k] = Seq::one(&cx, text(&cx, "kurs"));
    parts.append(&cx, path);
    parts.push(&cx, text_of(&cx, Buffer::new().push_static("h").push_bytes(&cx, digest)));
    var out = Buffer::new().push_static("_ZN");
    var i = 0usize;
    while i < parts.len(&cx) {
        out = out.push_usize(char_count(&cx, parts.get(&cx, i))).push_bytes(&cx, parts.get(&cx, i));
        i = i + 1usize;
    }
    text_of(&cx, out.push_static("E"))
}

// ---------------------------------------------------------------- SHA-256 --

fn rotr(x: u32, n: u32) -> u32 {
    (x >> n) | (x << (32u32 - n))
}

forall 'k.
fn round_constants(&cx: Cx!['k]) -> Seq[u32, 'k] {
    let k: Seq[u32, 'k] = Seq::new(&cx);
    push8(&cx, k, 1116352408u32, 1899447441u32, 3049323471u32, 3921009573u32, 961987163u32, 1508970993u32, 2453635748u32, 2870763221u32);
    push8(&cx, k, 3624381080u32, 310598401u32, 607225278u32, 1426881987u32, 1925078388u32, 2162078206u32, 2614888103u32, 3248222580u32);
    push8(&cx, k, 3835390401u32, 4022224774u32, 264347078u32, 604807628u32, 770255983u32, 1249150122u32, 1555081692u32, 1996064986u32);
    push8(&cx, k, 2554220882u32, 2821834349u32, 2952996808u32, 3210313671u32, 3336571891u32, 3584528711u32, 113926993u32, 338241895u32);
    push8(&cx, k, 666307205u32, 773529912u32, 1294757372u32, 1396182291u32, 1695183700u32, 1986661051u32, 2177026350u32, 2456956037u32);
    push8(&cx, k, 2730485921u32, 2820302411u32, 3259730800u32, 3345764771u32, 3516065817u32, 3600352804u32, 4094571909u32, 275423344u32);
    push8(&cx, k, 430227734u32, 506948616u32, 659060556u32, 883997877u32, 958139571u32, 1322822218u32, 1537002063u32, 1747873779u32);
    push8(&cx, k, 1955562222u32, 2024104815u32, 2227730452u32, 2361852424u32, 2428436474u32, 2756734187u32, 3204031479u32, 3329325298u32);
    k
}

forall 'k.
fn push8(&cx: Cx!['k], k: Seq[u32, 'k], a: u32, b: u32, c: u32, d: u32, e: u32, f: u32, g: u32, h: u32) {
    k.push(&cx, a);
    k.push(&cx, b);
    k.push(&cx, c);
    k.push(&cx, d);
    k.push(&cx, e);
    k.push(&cx, f);
    k.push(&cx, g);
    k.push(&cx, h);
}

// The SHA-256 digest of `data`, in lowercase hex.
forall 'k.
fn sha256_hex(&cx: Cx!['k], data: Text['k]) -> Text['k] {
    let k = round_constants(&cx);
    let h: Seq[u32, 'k] = Seq::new(&cx);
    push8(&cx, h, 1779033703u32, 3144134277u32, 1013904242u32, 2773480762u32, 1359893119u32, 2600822924u32, 528734635u32, 1541459225u32);
    let message: Seq[u8, 'k] = Seq::new(&cx);
    var b = 0usize;
    while b < data.len() {
        message.push(&cx, data.byte(&cx, b));
        b = b + 1usize;
    }
    message.push(&cx, 128u8);
    while message.len(&cx) % 64usize != 56usize {
        message.push(&cx, 0u8);
    }
    let bits = (data.len() as u64) * 8u64;
    var j = 0u64;
    while j < 8u64 {
        message.push(&cx, ((bits >> (56u64 - 8u64 * j)) & 255u64) as u8);
        j = j + 1u64;
    }
    let w: Seq[u32, 'k] = Seq::new(&cx);
    var chunk = 0usize;
    while chunk < message.len(&cx) {
        w.clear(&cx);
        var t = 0usize;
        while t < 16usize {
            let at = chunk + t * 4usize;
            w.push(&cx, ((message.get(&cx, at) as u32) << 24u32) | ((message.get(&cx, at + 1usize) as u32) << 16u32)
                | ((message.get(&cx, at + 2usize) as u32) << 8u32) | (message.get(&cx, at + 3usize) as u32));
            t = t + 1usize;
        }
        while t < 64usize {
            let x = w.get(&cx, t - 15usize);
            let y = w.get(&cx, t - 2usize);
            let s0 = rotr(x, 7u32) ^ rotr(x, 18u32) ^ (x >> 3u32);
            let s1 = rotr(y, 17u32) ^ rotr(y, 19u32) ^ (y >> 10u32);
            w.push(&cx, w.get(&cx, t - 16usize) + s0 + w.get(&cx, t - 7usize) + s1);
            t = t + 1usize;
        }
        var a = h.get(&cx, 0usize);
        var b = h.get(&cx, 1usize);
        var c = h.get(&cx, 2usize);
        var d = h.get(&cx, 3usize);
        var e = h.get(&cx, 4usize);
        var f = h.get(&cx, 5usize);
        var g = h.get(&cx, 6usize);
        var hh = h.get(&cx, 7usize);
        var r = 0usize;
        while r < 64usize {
            let big1 = rotr(e, 6u32) ^ rotr(e, 11u32) ^ rotr(e, 25u32);
            let choice = (e & f) ^ ((e ^ 4294967295u32) & g);
            let t1 = hh + big1 + choice + k.get(&cx, r) + w.get(&cx, r);
            let big0 = rotr(a, 2u32) ^ rotr(a, 13u32) ^ rotr(a, 22u32);
            let majority = (a & b) ^ (a & c) ^ (b & c);
            let t2 = big0 + majority;
            hh = g;
            g = f;
            f = e;
            e = d + t1;
            d = c;
            c = b;
            b = a;
            a = t1 + t2;
            r = r + 1usize;
        }
        h.set(&cx, 0usize, h.get(&cx, 0usize) + a);
        h.set(&cx, 1usize, h.get(&cx, 1usize) + b);
        h.set(&cx, 2usize, h.get(&cx, 2usize) + c);
        h.set(&cx, 3usize, h.get(&cx, 3usize) + d);
        h.set(&cx, 4usize, h.get(&cx, 4usize) + e);
        h.set(&cx, 5usize, h.get(&cx, 5usize) + f);
        h.set(&cx, 6usize, h.get(&cx, 6usize) + g);
        h.set(&cx, 7usize, h.get(&cx, 7usize) + hh);
        chunk = chunk + 64usize;
    }
    var out = Buffer::new();
    var i = 0usize;
    while i < 8usize {
        let word = h.get(&cx, i);
        out = hex_byte(&cx, hex_byte(&cx, hex_byte(&cx, hex_byte(&cx, out, (word >> 24u32) as u8), ((word >> 16u32) & 255u32) as u8), ((word >> 8u32) & 255u32) as u8), (word & 255u32) as u8);
        i = i + 1usize;
    }
    text_of(&cx, out)
}
