// Checked KURS to C, by the canonical profile: no optimization, one C local per SSA definition,
// places as fixed C objects, parallel edge assignment.
//
// Generic functions are specialized on demand by logical type arguments, up to their brands.
// Representation erasure is separate from code-specialization identity.
//
// A zero-size type (`Types::zero_size`) has no C representation: its C type is `void` (`erased`),
// and no struct member, parameter, local, argument or assignment has it, as in cgen.py.
//
// An enum is a tag and a union of its payloads, or, in the niche layout (`Types::niche_variant`),
// its one payload with a niche, the other variant a null there (`niche_layout`, `tag`, `payload`,
// `set_variant`).

use std::collections::arena_vec::ArenaVec;
use std::collections::arena_map::{ArenaMap, ArenaSet};
use std::mem::Ref;
use std::ascii::{is_alnum, is_digit, to_lower};
use std::raw::Span;
use std::arena::Domain!;
use std::buffer::Buffer!;
use package::check::checker::{FunKey, matching_instance};
use package::kurs::core::{Arm, Binding, Block, Data, Edge, Fun, ForeachType, Instr, Kind, Member, Param, Program, Terminator, Type, same};
use package::kurs::core as C;
use package::backend::plan::{Adapter, Plan, is_member, is_place, is_pure, root, term_edges, term_reads, value_read};
use package::check::checker::{overlap, prefix};
use package::backend::mangle::{decode_segment, encode, mangle, path_segments, type_key, unbranded};
use package::kurs::sexpr::Form;
use package::syntax::ast::{Pos, no_pos};
use package::types::termination::check_mono_termination;
use package::types::ops::{Fresh, Row, Types, alpha_hashes, equal, kurs_error, map_children, mapped_component, mapped_operand, subst};
use std::option::Option;
use std::slice::Slice;
use std::time::Instant;
use std::io::eprint_buffer;

fn c_stage(times: bool, name: Slice[u8, 'static], started: Instant) -> Instant {
    let now = Instant::now();
    if times {
        let ms = now.since(started).as_millis();
        eprint_buffer(Buffer!::new().push_static(name).push_static(": ").push_usize(ms as usize).push_static("ms\n"));
        Instant::now()
    } else {
        now
    }
}

// The C function, in `lib/libc/start.c`, that C's `main` calls to report the error an entry returns.
const REPORT_ERROR: Slice[u8, 'static] = "kur_libc_process_report_error";
// The C function, in `lib/libc/start.c`, that a hosted C `main` calls first: it opens /dev/null on each
// standard descriptor the process started without, and ignores SIGPIPE.
const START: Slice[u8, 'static] = "kur_libc_process_start";

// How C's `main` makes an entry's result its exit status (`Backend::entry_result`).
enum EntryResult {
    Status,
    Zero,
    Report,
}

fn prelude() -> Buffer! {
    Buffer!::new()
        .push_static("#include <stddef.h>\n")
        .push_static("#include <stdint.h>\n")
        .push_static("#define KUR_TRAP() __builtin_trap()\n")
        .push_static("/* A call the C compiler must make a tail call, where it can be told to: Clang's `musttail`. */\n")
        .push_static("#if defined(__clang__) && defined(__has_attribute)\n")
        .push_static("#if __has_attribute(musttail)\n")
        .push_static("#define KUR_MUSTTAIL __attribute__((musttail))\n")
        .push_static("#endif\n")
        .push_static("#endif\n")
        .push_static("#ifndef KUR_MUSTTAIL\n")
        .push_static("#define KUR_MUSTTAIL\n")
        .push_static("#endif\n")
        .push_static("/* A component's address by integer arithmetic: projection never dereferences, so it is defined for any\n")
        .push_static("   pointer value, null and dangling included. The `__typeof__` operands are not evaluated. */\n")
        .push_static("#define KUR_FIELD(p, m) ((__typeof__(&(p)->m))((uintptr_t)(p) + offsetof(__typeof__(*(p)), m)))\n")
        .push_static("static inline int8_t kur_dec_i8(uint64_t b) { b &= 0xFF; return b < 0x80 ? (int8_t)b : (int8_t)((int64_t)b - 0x100); }\n")
        .push_static("static inline int16_t kur_dec_i16(uint64_t b) { b &= 0xFFFF; return b < 0x8000 ? (int16_t)b : (int16_t)((int64_t)b - 0x10000); }\n")
        .push_static("static inline int32_t kur_dec_i32(uint64_t b) { b &= 0xFFFFFFFF; return b < 0x80000000 ? (int32_t)b : (int32_t)((int64_t)b - 0x100000000); }\n")
        .push_static("static inline int64_t kur_dec_i64(uint64_t b) { return b <= (uint64_t)INT64_MAX ? (int64_t)b : -INT64_C(1) - (int64_t)(UINT64_MAX - b); }\n")
        .push_static("/* usize and isize are pointer-sized: uintptr_t and intptr_t, of KUR_PTR_BITS bits. */\n")
        .push_static("#define KUR_PTR_BITS (8 * sizeof(uintptr_t))\n")
        .push_static("static inline intptr_t kur_dec_isize(uintptr_t b) { return b <= (uintptr_t)INTPTR_MAX ? (intptr_t)b : -(intptr_t)1 - (intptr_t)(UINTPTR_MAX - b); }\n")
}

// The header every file of a split build includes: the program's types, externs, data declarations
// and function heads.
const HEADER: Slice[u8, 'static] = "kursal-decls.h";

// About the most C one file of a split build holds, in bytes, unless one function is longer.
const PIECE: usize = 524288usize;

// The start of a split build's C file other than its header.
fn included() -> Buffer! {
    Buffer!::new().push_static("#include \"").push_static(HEADER).push_static("\"\n\n")
}

// The C of a program: one file, or the files of a split build, each its name and text (`emit_c`).
forall 'k.
exposed enum CText! {
    One(Buffer!),
    Split(ArenaVec[(Span['k], Span['k]), 'k]),
}

// The file of a split build a function goes to, without its `.c`: its module, the leading segments
// of its qualified name without the function's own, at most three, joined by `.`
// (`kursal::infer::inference::Infer::unify` goes to `kursal.infer.inference`). A segment that is
// not a plain name ends the module before it; a linear type's `!` is left out. Such names never
// hold a `-`, which the header and the files the backend adds have.
forall 'k.
fn module_file(&cx: Domain!['k], name: Span['k]) -> Span['k] {
    let separator = Span::from_static(&cx, "::");
    let segments: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
    var rest = name;
    var more = true;
    while more {
        more = match rest.find(&cx, separator, 0usize) {
            Option::Some(at) => {
                segments.push(&cx, rest.take(at));
                rest = rest.skip(at + 2usize);
                true
            },
            Option::None => false,
        };
    }
    var out = Buffer!::new();
    var taken = 0usize;
    var plain = true;
    while plain && taken < segments.len(&cx) && taken < 3usize {
        let segment = segments.at(&cx, taken);
        var i = 0usize;
        while plain && i < segment.len() {
            let b = segment.at(&cx, i);
            plain = is_word_byte(b) || b == b'!' && i + 1usize == segment.len();
            i = i + 1usize;
        }
        if plain && !segment.is_empty() {
            if taken > 0usize {
                out = out.push_static(".");
            }
            let bare = if segment.ends_with(&cx, Span::from_static(&cx, "!")) { segment.take(segment.len() - 1usize) } else { segment };
            out = out.push_bytes(&cx, bare);
            taken = taken + 1usize;
        } else {
            plain = false;
        }
    }
    if taken == 0usize {
        out.destroy();
        return Span::from_static(&cx, "kursal-root");
    }
    out.save(&cx)
}

// Each of `items`, followed by a newline.
forall 'k.
fn text_lines(&cx: Domain!['k], c: Buffer!, items: ArenaVec[Span['k], 'k]) -> Buffer! {
    var c = c;
    var i = 0usize;
    while i < items.len(&cx) {
        c = c.push_bytes(&cx, items.at(&cx, i)).push_static("\n");
        i = i + 1usize;
    }
    c
}

forall 'k.
fn c_prim(&cx: Domain!['k], name: Span['k]) -> Span['k] {
    if name.is(&cx, "bool") {
        Span::from_static(&cx, "_Bool")
    } else if name.is(&cx, "f32") {
        Span::from_static(&cx, "float")
    } else if name.is(&cx, "f64") {
        Span::from_static(&cx, "double")
    } else if name.is(&cx, "usize") {
        Span::from_static(&cx, "uintptr_t")
    } else if name.is(&cx, "isize") {
        Span::from_static(&cx, "intptr_t")
    } else if name.byte_or_zero(&cx, 0usize) == b'u' {
        Buffer!::new().push_static("uint").push_bytes(&cx, name.skip(1usize)).push_static("_t").save(&cx)
    } else {
        Buffer!::new().push_static("int").push_bytes(&cx, name.skip(1usize)).push_static("_t").save(&cx)
    }
}

// One line of a function's body, indented, appended to `lines`; `l` is freed.
fn line(&lines: Buffer!, l: Buffer!) {
    lines = lines.push_static("  ").push_buffer(l).push_static("\n");
}

// The suffix of a signed integer type's `kur_dec_i` decoder (`8` to `64`, or `size`), or none for
// any other type.
forall 'k.
fn signed_suffix(&cx: Domain!['k], name: Span['k]) -> Option[Span['k]] {
    if name.byte_or_zero(&cx, 0usize) == b'i' && C::is_integer(&cx, name) { Option::Some.(name.skip(1usize)) } else { Option::None }
}

forall 'k.
fn c_order(&cx: Domain!['k], order: Span['k]) -> Span['k] {
    var out = Buffer!::new().push_static("__ATOMIC_");
    var i = 0usize;
    while i < order.len() {
        let b = order.byte_or_zero(&cx, i);
        out = out.push_byte(if b >= b'a' && b <= b'z' { b - 32u8 } else { b });
        i = i + 1usize;
    }
    out.save(&cx)
}

forall 'k.
fn c_op(&cx: Domain!['k], op: Span['k]) -> Span['k] {
    if op.is(&cx, "add") {
        Span::from_static(&cx, "+")
    } else if op.is(&cx, "sub") {
        Span::from_static(&cx, "-")
    } else if op.is(&cx, "mul") {
        Span::from_static(&cx, "*")
    } else if op.is(&cx, "div") {
        Span::from_static(&cx, "/")
    } else if op.is(&cx, "mod") {
        Span::from_static(&cx, "%")
    } else if op.is(&cx, "bit_and") {
        Span::from_static(&cx, "&")
    } else if op.is(&cx, "bit_or") {
        Span::from_static(&cx, "|")
    } else if op.is(&cx, "bit_xor") {
        Span::from_static(&cx, "^")
    } else if op.is(&cx, "eq") {
        Span::from_static(&cx, "==")
    } else if op.is(&cx, "ne") {
        Span::from_static(&cx, "!=")
    } else if op.is(&cx, "lt") {
        Span::from_static(&cx, "<")
    } else if op.is(&cx, "le") {
        Span::from_static(&cx, "<=")
    } else if op.is(&cx, "gt") {
        Span::from_static(&cx, ">")
    } else {
        Span::from_static(&cx, ">=")
    }
}

forall 'k.
fn is_c_op(&cx: Domain!['k], op: Span['k]) -> bool {
    op.is(&cx, "add") || op.is(&cx, "sub") || op.is(&cx, "mul") || op.is(&cx, "div") || op.is(&cx, "mod") || op.is(&cx, "bit_and") || op.is(&cx, "bit_or")
        || op.is(&cx, "bit_xor") || op.is(&cx, "eq") || op.is(&cx, "ne") || op.is(&cx, "lt") || op.is(&cx, "le") || op.is(&cx, "gt") || op.is(&cx, "ge")
}

forall 'k.
fn add_words(&cx: Domain!['k], set: ArenaSet[Span['k], 'k], words: Slice[u8, 'static]) {
    let all = Span::from_static(&cx, words).split(&cx, Span::from_static(&cx, " "));
    var i = 0usize;
    while i < all.len(&cx) {
        set.insert(&cx, all.at(&cx, i));
        i = i + 1usize;
    }
}

forall 'k.
fn c_keywords(&cx: Domain!['k]) -> ArenaSet[Span['k], 'k] {
    let out: ArenaSet[Span['k], 'k] = ArenaSet::new(&cx);
    add_words(&cx, out, "auto break case char const continue default do double else enum extern float for goto if");
    add_words(&cx, out, "inline int long register restrict return short signed sizeof static struct switch typedef");
    add_words(&cx, out, "union unsigned void volatile while _Alignas _Alignof _Atomic _Bool _Complex _Generic");
    add_words(&cx, out, "_Imaginary _Noreturn _Static_assert _Thread_local");
    out
}

forall 'k.
fn runtime_names(&cx: Domain!['k]) -> ArenaSet[Span['k], 'k] {
    let out: ArenaSet[Span['k], 'k] = ArenaSet::new(&cx);
    add_words(&cx, out, "KUR_TRAP KUR_MUSTTAIL KUR_FIELD KUR_PTR_BITS kur_dec_i8 kur_dec_i16 kur_dec_i32 kur_dec_i64 kur_dec_isize");
    add_words(&cx, out, "SIZE_MAX PTRDIFF_MIN PTRDIFF_MAX SIG_ATOMIC_MIN SIG_ATOMIC_MAX WCHAR_MIN WCHAR_MAX WINT_MIN WINT_MAX");
    add_words(&cx, out, "__ATOMIC_RELAXED __ATOMIC_ACQUIRE __ATOMIC_RELEASE __ATOMIC_ACQ_REL __ATOMIC_SEQ_CST");
    let stems = Span::from_static(&cx, "8 16 32 64 _LEAST8 _LEAST16 _LEAST32 _LEAST64 _FAST8 _FAST16 _FAST32 _FAST64 PTR MAX").split(&cx, Span::from_static(&cx, " "));
    let suffixes = Span::from_static(&cx, "MIN MAX C WIDTH").split(&cx, Span::from_static(&cx, " "));
    var i = 0usize;
    while i < stems.len(&cx) {
        let stem = stems.at(&cx, i);
        var u = 0usize;
        while u < 2usize {
            let unsigned = if u == 1usize { Span::from_static(&cx, "U") } else { Span::from_static(&cx, "") };
            out.insert(&cx, Buffer!::new().push_bytes(&cx, lower(&cx, unsigned)).push_static("int").push_bytes(&cx, lower(&cx, stem)).push_static("_t").save(&cx));
            var s = 0usize;
            while s < suffixes.len(&cx) {
                out.insert(&cx, Buffer!::new().push_bytes(&cx, unsigned).push_static("INT").push_bytes(&cx, stem).push_static("_").push_bytes(&cx, suffixes.at(&cx, s)).save(&cx));
                s = s + 1usize;
            }
            u = u + 1usize;
        }
        i = i + 1usize;
    }
    out
}

forall 'k.
fn lower(&cx: Domain!['k], t: Span['k]) -> Span['k] {
    var out = Buffer!::new();
    var i = 0usize;
    while i < t.len() {
        let b = t.byte_or_zero(&cx, i);
        out = out.push_byte(to_lower(b));
        i = i + 1usize;
    }
    out.save(&cx)
}

fn is_word_byte(b: u8) -> bool {
    is_alnum(b) || b == b'_'
}

// The identifiers taken in one namespace. Many functions spell their locals alike, so for each
// base `last` remembers the highest numbered spelling `allocate` has tried: names are never
// released, so every lower number is still taken, and the search resumes after it.
forall 'k.
exposed struct Pool {
    taken: ArenaSet[Span['k], 'k],
    last: ArenaMap[Span['k], usize, 'k],
}

forall 'k.
impl Pool['k] {
    fn new(&cx: Domain!['k], taken: ArenaSet[Span['k], 'k]) -> Pool['k] {
        Pool.{ taken, last: ArenaMap::new(&cx) }
    }
}

// Allocate a C identifier; the readable spelling is only a hint.
forall 'k.
fn allocate(&cx: Domain!['k], base: Span['k], pool: Pool['k]) -> Span['k] {
    let start = if is_digit(base.byte_or_zero(&cx, 0usize)) { Buffer!::new().push_static("k_").push_bytes(&cx, base).save(&cx) } else { base };
    var name = start;
    if pool.taken.contains(&cx, name) {
        var index = pool.last.get_or(&cx, start, 0usize);
        var going = true;
        while going {
            index = index + 1usize;
            name = Buffer!::new().push_bytes(&cx, start).push_static("_").push_usize(index).save(&cx);
            going = pool.taken.contains(&cx, name);
        }
        pool.last.insert(&cx, start, index);
    }
    pool.taken.insert(&cx, name);
    name
}

// Decode the linker's hex-encoded identity segments, then make a C identifier.
forall 'k.
fn readable(&cx: Domain!['k], name: Span['k]) -> Span['k] {
    var joined = Buffer!::new();
    let pieces = name.split(&cx, Span::from_static(&cx, "::"));
    var i = 0usize;
    while i < pieces.len(&cx) {
        if i > 0usize {
            joined = joined.push_static("_");
        }
        joined = joined.push_bytes(&cx, match decode_segment(&cx, pieces.at(&cx, i)) {
            Option::Some(bytes) => bytes,
            Option::None => pieces.at(&cx, i),
        });
        i = i + 1usize;
    }
    // Every character outside [A-Za-z0-9_] becomes one `_`; the text is UTF-8, so a character's
    // continuation bytes add nothing.
    let all = joined.save(&cx);
    var out = Buffer!::new();
    var j = 0usize;
    while j < all.len() {
        let b = all.byte_or_zero(&cx, j);
        if is_word_byte(b) {
            out = out.push_byte(b);
        } else if (b & 192u8) != 128u8 {
            out = out.push_static("_");
        }
        j = j + 1usize;
    }
    let made = out.save(&cx);
    var start = 0usize;
    var end = made.len();
    while start < end && made.byte_or_zero(&cx, start) == b'_' {
        start = start + 1usize;
    }
    while end > start && made.byte_or_zero(&cx, end - 1usize) == b'_' {
        end = end - 1usize;
    }
    if start == end { Span::from_static(&cx, "x") } else { made.slice(start, end) }
}

// The last `n` characters of ASCII text.
forall 'k.
fn tail(t: Span['k], n: usize) -> Span['k] {
    if t.len() > n { t.skip(t.len() - n) } else { t }
}

// The representation key: brands erased, packages unwrapped, transforms expanded.
forall 'k.
fn erase(&cx: Domain!['k], ty: Type['k], types: Types['k]) -> Type['k] {
    match ty {
        Type::Skolem(_label) => Type::Skolem.(Span::from_static(&cx, "_")),
        Type::Brand(_brand) => C::unit(&cx),
        Type::Exists(_binders, body) => erase(&cx, body.copy(&cx), types),
        Type::Foreach(f) => erase(&cx, types.expand(&cx, f, Option::None), types),
        Type::Fn(f) => {
            let params: ArenaVec[Type['k], 'k] = ArenaVec::new(&cx);
            var i = 0usize;
            while i < f.params.len(&cx) {
                params.push(&cx, erase(&cx, f.params.at(&cx, i), types));
                i = i + 1usize;
            }
            C::fn_type(&cx, params, erase(&cx, f.ret.copy(&cx), types), ArenaVec::new(&cx), false, f.places)
        },
        _ => map_children(&cx, ty, |&cx, child: Type['k]| erase(&cx, child, types)),
    }
}

forall 'k.
fn is_never(t: Type['k]) -> bool {
    match t {
        Type::Never => true,
        _ => false,
    }
}

forall 'k.
fn is_ptr(t: Type['k]) -> bool {
    match t {
        Type::Ptr(_inner) => true,
        _ => false,
    }
}

forall 'k.
fn is_non_null(t: Type['k]) -> bool {
    match t {
        Type::NonNull(_inner) => true,
        _ => false,
    }
}

// A pointer or a `NonNull`.
forall 'k.
fn is_pointer_like(t: Type['k]) -> bool {
    match t {
        Type::Ptr(_inner) => true,
        Type::NonNull(_inner) => true,
        _ => false,
    }
}

forall 'k.
fn or_void(&cx: Domain!['k], t: Span['k]) -> Span['k] {
    if t.is_empty() { Span::from_static(&cx, "void") } else { t }
}

// A C identifier: `[A-Za-z_][A-Za-z0-9_]*`.
forall 'k.
fn is_c_identifier(&cx: Domain!['k], t: Span['k]) -> bool {
    if t.is_empty() || is_digit(t.byte_or_zero(&cx, 0usize)) {
        return false;
    }
    var i = 0usize;
    while i < t.len() {
        if !is_word_byte(t.byte_or_zero(&cx, i)) {
            return false;
        }
        i = i + 1usize;
    }
    true
}

forall 'k.
fn member_names(&cx: Domain!['k], members: ArenaVec[(Span['k], Type['k]), 'k]) -> ArenaVec[Span['k], 'k] {
    let out: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
    var i = 0usize;
    while i < members.len(&cx) {
        let (m, _t) = members.at(&cx, i);
        out.push(&cx, m);
        i = i + 1usize;
    }
    out
}

// The members `items[k]` of an array of `count` elements of type `elem`, as `Backend::members`
// gives a struct's.
forall 'k.
fn items_of(&cx: Domain!['k], count: usize, elem: Type['k]) -> ArenaVec[(Span['k], Type['k]), 'k] {
    let out: ArenaVec[(Span['k], Type['k]), 'k] = ArenaVec::new(&cx);
    var k = 0usize;
    while k < count {
        out.push(&cx, (Buffer!::new().push_static("items[").push_usize(k).push_static("]").save(&cx), elem));
        k = k + 1usize;
    }
    out
}

forall 'k.
fn items_access(&cx: Domain!['k], count: usize) -> ArenaVec[Span['k], 'k] {
    let out: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
    var k = 0usize;
    while k < count {
        out.push(&cx, Buffer!::new().push_static("items[").push_usize(k).push_static("]").save(&cx));
        k = k + 1usize;
    }
    out
}

// An assignment of an edge or a tail call: to `dst`, of the type `ty` (a place's pointer when
// `place`), the C expression `value`, which reads the C variable `base`.
forall 'k.
exposed struct Move {
    dst: Span['k],
    ty: Type['k],
    place: bool,
    value: Span['k],
    base: Span['k],
}

// Whether a C type is a scalar: an integer, a floating type or a pointer.
forall 'k.
fn is_scalar(&cx: Domain!['k], t: Span['k]) -> bool {
    t.ends_with(&cx, Span::from_static(&cx, "*")) || t.is(&cx, "_Bool") || t.is(&cx, "float") || t.is(&cx, "double")
        || t.is(&cx, "uint8_t") || t.is(&cx, "uint16_t") || t.is(&cx, "uint32_t") || t.is(&cx, "uint64_t")
        || t.is(&cx, "int8_t") || t.is(&cx, "int16_t") || t.is(&cx, "int32_t") || t.is(&cx, "int64_t")
        || t.is(&cx, "uintptr_t") || t.is(&cx, "intptr_t")
}

// A C parameter of a function: its type, its name, and whether it is a place's pointer (`T*` then,
// qualified as `qualifiers` decides).
forall 'k.
exposed struct CParam {
    ctype: Span['k],
    cname: Span['k],
    place: bool,
}

forall 'k.
exposed struct Backend {
    program: Program['k],
    // function -> (block label, SSA name) -> type, as the checker recorded them
    recorded: ArenaMap[FunKey['k], ArenaMap[(Span['k], Span['k]), Type['k], 'k], 'k],
    counter: Fresh['k],
    types: Types['k],
    // representation key -> C type name
    names: ArenaMap[Type['k], Span['k], 'k],
    // an enum in the niche layout -> its payload's representation key
    represented: ArenaMap[Type['k], Type['k], 'k],
    // a type as written -> its C type, once `ctype` has named and defined it
    ctypes: ArenaMap[Type['k], Span['k], 'k],
    // a name -> `readable` of it
    readables: ArenaMap[Span['k], Span['k], 'k],
    // named but not yet defined aggregates
    pending: ArenaMap[Type['k], Type['k], 'k],
    forward: ArenaVec[Span['k], 'k],
    defs: ArenaVec[Span['k], 'k],
    // (function, `alpha_hashes` of the arguments) -> the unbranded type arguments of each of its
    // specializations whose arguments hash so, and its C symbol
    symbols: ArenaMap[(FunKey['k], u64), ArenaVec[(ArenaVec[Type['k], 'k], Span['k]), 'k], 'k],
    // the same, by structure: an earlier request with these very arguments
    symbol_index: ArenaMap[(FunKey['k], ArenaVec[Type['k], 'k]), Span['k], 'k],
    // the part of a specialization's C identity that depends only on its function definition
    signature_keys: ArenaMap[FunKey['k], Span['k], 'k],
    // Whether a resolved type is passed indirectly in C, shared across function specializations.
    by_pointer_cache: ArenaMap[Type['k], bool, 'k],
    queue: ArenaVec[(FunKey['k], Fun['k], ArenaMap[Span['k], Type['k], 'k], Span['k]), 'k],
    // Each function in order: its symbol, when its head waits for `qualifiers`, else its head; its body;
    // and the file of a split build it goes to (`module_file`), empty for a thunk.
    emitted: ArenaVec[(Option[Span['k]], Span['k], Span['k], Span['k]), 'k],
    // `static ` for one C file, where every function and data is the file's own; empty for a split
    // build, whose files call one another's
    linkage: Span['k],
    // symbol -> its C result, whether it never returns, and its parameters; a parameter of a zero-size
    // type has the C type `void` and no name, and is not written
    heads: ArenaMap[Span['k], (Span['k], bool, ArenaVec[CParam['k], 'k]), 'k],
    // Every place lent to a function by symbol: (callee, its parameter, where the place is: "param"
    // under the caller's place parameter, "local" in its local place, "raw" behind a pointer; the
    // caller, and its parameter for "param").
    lends: ArenaVec[(Span['k], usize, Span['k], Span['k], usize), 'k],
    // place parameters the function may write
    written: ArenaSet[(Span['k], usize), 'k],
    address_taken: ArenaSet[Span['k], 'k],
    // functions whose tail call to themselves moves a place parameter
    looping: ArenaSet[Span['k], 'k],
    datas: ArenaMap[Span['k], (Span['k], Data['k]), 'k],
    // One conservative pool for ordinary identifiers, including function locals: later global
    // declarations must not be shadowed by earlier locals.
    taken: Pool['k],
    component_names: ArenaMap[(Span['k], Span['k]), Span['k], 'k],
    component_taken: Pool['k],
    instance_params: ArenaMap[FunKey['k], ArenaVec[Param['k], 'k], 'k],
    function_ids: ArenaMap[FunKey['k], (ArenaVec[Span['k], 'k], Span['k]), 'k],
    // the function being emitted
    fun: Ref[Option[Fun['k]], 'k],
    sub: Ref[ArenaMap[Span['k], Type['k], 'k], 'k],
    // types under `sub`, when substituting renamed no binder
    substituted: Ref[ArenaMap[Type['k], Type['k], 'k], 'k],
    locals: Ref[ArenaMap[(Span['k], Span['k]), Span['k], 'k], 'k],

    symbol: Ref[Span['k], 'k],
    plan: Ref[Option[Plan['k]], 'k],
    // the entry block's parameter names
    params: Ref[ArenaVec[Span['k], 'k], 'k],
    // (block label, SSA name) -> the C variable a copy or a forwarded load reads
    aliases: Ref[ArenaMap[(Span['k], Span['k]), Span['k], 'k], 'k],
    // a forwarded place -> the C variable of the value stored there
    forwards: Ref[ArenaMap[Span['k], Span['k], 'k], 'k],
    scratch: Ref[usize, 'k],
    labels: Ref[ArenaMap[Span['k], Span['k], 'k], 'k],
    // the declarations of the scratch locals of edges
    temps: Ref[ArenaVec[Span['k], 'k], 'k],
    place_c: Ref[ArenaMap[Span['k], Span['k], 'k], 'k],
    roots: Ref[ArenaMap[Span['k], Type['k], 'k], 'k],
    typed: Ref[ArenaMap[(Span['k], Span['k]), Type['k], 'k], 'k],
    // (block label, SSA name) -> whether the value's type is zero-size, as `value_erased_in` finds it
    erasure: Ref[ArenaMap[(Span['k], Span['k]), bool, 'k], 'k],
    blocks: Ref[ArenaMap[Span['k], Block['k], 'k], 'k],
    label: Ref[Span['k], 'k],
    // the index of the instruction being written in its block
    index: Ref[usize, 'k],
    // what `adapter` found of each function it was asked of
    adapters: ArenaMap[Span['k], Option[(Adapter['k], Fun['k])], 'k],
    // symbol -> for each of its parameters, whether it takes an aggregate by pointer (`request`)
    by_ref: ArenaMap[Span['k], ArenaVec[bool, 'k], 'k],
    // symbol of a function whose address is taken -> its by-value entry (`thunk`)
    thunks: ArenaMap[Span['k], Span['k], 'k],
    // the parameters of the function being written read through their pointer
    deref: Ref[ArenaSet[Span['k], 'k], 'k],
    // symbol -> the elements of its tuple result it writes through out pointers (`request`)
    outs: ArenaMap[Span['k], ArenaVec[usize, 'k], 'k],
    // symbol -> the C type and name of each out pointer's pointee, in element order
    out_params: ArenaMap[Span['k], ArenaVec[(Span['k], Span['k]), 'k], 'k],
    // symbol with out pointers -> its whole result type
    results: ArenaMap[Span['k], Type['k], 'k],
    // (block label, value, element) of each element of a returned value already in its out pointer's
    // pointee
    at_out: Ref[ArenaSet[(Span['k], Span['k], usize), 'k], 'k],
    // the call being written is the one whose result its block returns (`emit_call`)
    returning: Ref[bool, 'k],
    // the place paths the call being written passes as out pointers (`by_address`)
    out_paths: Ref[ArenaVec[Span['k], 'k], 'k],
}

forall 'k.
fn fail_at(&cx: Domain!['k], message: Span['k], pos: Pos) -> ! {
    kurs_error(&cx, message, pos)
}

forall 'k.
fn fail_text(&cx: Domain!['k], message: Span['k]) -> ! {
    kurs_error(&cx, message, no_pos())
}

forall 'k.
impl Backend['k] {
    fn new(&cx: Domain!['k], program: Program['k], typed: ArenaMap[FunKey['k], ArenaMap[(Span['k], Span['k]), Type['k], 'k], 'k], counter: Fresh['k], split: bool) -> Backend['k] {
        let taken = c_keywords(&cx);
        let runtime = runtime_names(&cx).keys(&cx);
        var r = 0usize;
        while r < runtime.len(&cx) {
            taken.insert(&cx, runtime.at(&cx, r));
            r = r + 1usize;
        }
        taken.insert(&cx, Span::from_static(&cx, "main"));
        taken.insert(&cx, Span::from_static(&cx, REPORT_ERROR));
        taken.insert(&cx, Span::from_static(&cx, START));
        let externs = program.externs.values(&cx);
        var e = 0usize;
        while e < externs.len(&cx) {
            taken.insert(&cx, externs.at(&cx, e).name);
            e = e + 1usize;
        }
        let function_ids: ArenaMap[FunKey['k], (ArenaVec[Span['k], 'k], Span['k]), 'k] = ArenaMap::new(&cx);
        let funs = program.funs.values(&cx);
        var f = 0usize;
        while f < funs.len(&cx) {
            let name = funs.at(&cx, f).name;
            function_ids.insert(&cx, FunKey::Function.(name), (path_segments(&cx, name), encode(&cx, ArenaVec::two(&cx, Span::from_static(&cx, "function"), name))));
            f = f + 1usize;
        }
        let instance_params: ArenaMap[FunKey['k], ArenaVec[Param['k], 'k], 'k] = ArenaMap::new(&cx);
        let groups = program.instances.keys(&cx);
        var g = 0usize;
        while g < groups.len(&cx) {
            let insts = program.instances.at(&cx, groups.at(&cx, g));
            var i = 0usize;
            while i < insts.len(&cx) {
                let inst = insts.at(&cx, i);
                let scope: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
                var p = 0usize;
                while p < inst.params.len(&cx) {
                    scope.push(&cx, inst.params.at(&cx, p).name);
                    p = p + 1usize;
                }
                let head_keys: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
                var h = 0usize;
                while h < inst.head.len(&cx) {
                    head_keys.push(&cx, type_key(&cx, inst.head.at(&cx, h), scope));
                    h = h + 1usize;
                }
                let head = encode(&cx, head_keys);
                var m = 0usize;
                while m < inst.methods.len(&cx) {
                    let fun = inst.methods.at(&cx, m);
                    let key = FunKey::Method.(groups.at(&cx, g), i, fun.name);
                    let params = inst.params.clone(&cx);
                    params.append(&cx, fun.params);
                    instance_params.insert(&cx, key, params);
                    let path = path_segments(&cx, inst.trait_name);
                    path.push(&cx, Span::from_static(&cx, "impl"));
                    path.append(&cx, path_segments(&cx, fun.name));
                    let identity = ArenaVec::two(&cx, Span::from_static(&cx, "instance"), inst.trait_name);
                    identity.push(&cx, head);
                    identity.push(&cx, fun.name);
                    function_ids.insert(&cx, key, (path, encode(&cx, identity)));
                    m = m + 1usize;
                }
                i = i + 1usize;
            }
            g = g + 1usize;
        }
        Backend.{
            program,
            recorded: typed,
            counter,
            types: Types::new(&cx, program, counter),
            names: ArenaMap::new(&cx),
            represented: ArenaMap::new(&cx),
            ctypes: ArenaMap::new(&cx),
            readables: ArenaMap::new(&cx),
            pending: ArenaMap::new(&cx),
            forward: ArenaVec::new(&cx),
            defs: ArenaVec::new(&cx),
            symbols: ArenaMap::new(&cx),
            symbol_index: ArenaMap::new(&cx),
            signature_keys: ArenaMap::new(&cx),
            by_pointer_cache: ArenaMap::new(&cx),
            queue: ArenaVec::new(&cx),
            emitted: ArenaVec::new(&cx),
            linkage: Span::from_static(&cx, if split { "" } else { "static " }),
            heads: ArenaMap::new(&cx),
            lends: ArenaVec::new(&cx),
            written: ArenaSet::new(&cx),
            address_taken: ArenaSet::new(&cx),
            looping: ArenaSet::new(&cx),
            datas: ArenaMap::new(&cx),
            taken: Pool::new(&cx, taken),
            component_names: ArenaMap::new(&cx),
            component_taken: Pool::new(&cx, ArenaSet::new(&cx)),
            instance_params,
            function_ids,
            fun: Ref::new(&cx, Option::None),
            sub: Ref::new(&cx, ArenaMap::new(&cx)),
            substituted: Ref::new(&cx, ArenaMap::new(&cx)),
            locals: Ref::new(&cx, ArenaMap::new(&cx)),

            symbol: Ref::new(&cx, Span::from_static(&cx, "")),
            plan: Ref::new(&cx, Option::None),
            params: Ref::new(&cx, ArenaVec::new(&cx)),
            aliases: Ref::new(&cx, ArenaMap::new(&cx)),
            forwards: Ref::new(&cx, ArenaMap::new(&cx)),
            scratch: Ref::new(&cx, 0usize),
            labels: Ref::new(&cx, ArenaMap::new(&cx)),
            temps: Ref::new(&cx, ArenaVec::new(&cx)),
            place_c: Ref::new(&cx, ArenaMap::new(&cx)),
            roots: Ref::new(&cx, ArenaMap::new(&cx)),
            typed: Ref::new(&cx, ArenaMap::new(&cx)),
            erasure: Ref::new(&cx, ArenaMap::new(&cx)),
            blocks: Ref::new(&cx, ArenaMap::new(&cx)),
            label: Ref::new(&cx, Span::from_static(&cx, "")),
            index: Ref::new(&cx, 0usize),
            adapters: ArenaMap::new(&cx),
            by_ref: ArenaMap::new(&cx),
            thunks: ArenaMap::new(&cx),
            deref: Ref::new(&cx, ArenaSet::new(&cx)),
            outs: ArenaMap::new(&cx),
            out_params: ArenaMap::new(&cx),
            results: ArenaMap::new(&cx),
            at_out: Ref::new(&cx, ArenaSet::new(&cx)),
            returning: Ref::new(&cx, false),
            out_paths: Ref::new(&cx, ArenaVec::new(&cx)),
        }
    }

    // ------------------------------------------------------------ representations --

    // `readable(name)`, made once per name.
    fn readable(self, &cx: Domain!['k], name: Span['k]) -> Span['k] {
        match self.readables.get(&cx, name) {
            Option::Some(known) => known,
            Option::None => {
                let made = readable(&cx, name);
                self.readables.insert(&cx, name, made);
                made
            },
        }
    }

    fn fresh_name(self, &cx: Domain!['k], hint: Span['k]) -> Span['k] {
        allocate(&cx, Buffer!::new().push_static("K_").push_bytes(&cx, tail(self.readable(&cx, hint), 48usize)).save(&cx), self.taken)
    }

    // The C type of `ty`; through a pointer, an aggregate needs only its name.
    fn ctype(self, &cx: Domain!['k], ty: Type['k], defined: bool) -> Span['k] {
        match self.ctypes.get(&cx, ty) {
            Option::Some(known) => return known,
            Option::None => (),
        }
        let name = self.ctype_of(&cx, ty, defined);
        if defined {
            self.ctypes.insert(&cx, ty, name);
        }
        name
    }

    fn ctype_of(self, &cx: Domain!['k], ty: Type['k], defined: bool) -> Span['k] {
        let ty = erase(&cx, ty, self.types);
        match ty {
            Type::Prim(name) => {
                return c_prim(&cx, name);
            },
            Type::Never => {
                return Span::from_static(&cx, "void");
            },
            Type::Ptr(inner) => {
                let inner = erase(&cx, inner.copy(&cx), self.types);
                return Buffer!::new().push_bytes(&cx, self.ctype(&cx, inner, false)).push_static("*").save(&cx);
            },
            Type::NonNull(inner) => {
                let inner = erase(&cx, inner.copy(&cx), self.types);
                return Buffer!::new().push_bytes(&cx, self.ctype(&cx, inner, false)).push_static("*").save(&cx);
            },
            _ => (),
        };
        if !self.names.contains(&cx, ty) {
            self.register(&cx, ty);
        }
        let key = self.represented.get_or(&cx, ty, ty);
        if defined && self.pending.contains(&cx, key) {
            self.define(&cx, key);
        }
        self.names.at(&cx, ty)
    }

    fn c(self, &cx: Domain!['k], ty: Type['k]) -> Span['k] {
        self.ctype(&cx, ty, true)
    }

    fn register(self, &cx: Domain!['k], ty: Type['k]) {
        if self.types.zero_size(&cx, ty) {
            self.names.insert(&cx, ty, Span::from_static(&cx, "void"));
            return;
        }
        let s = match ty {
            Type::Named(_name, _args) => self.types.shape(&cx, ty, Option::None),
            _ => ty,
        };
        match s {
            Type::Tuple(_elems) => self.aggregate(&cx, ty, s, Span::from_static(&cx, "tuple")),
            Type::Struct(_fields) => self.aggregate(&cx, ty, s, Span::from_static(&cx, "struct")),
            Type::Array(_elem, _length) => self.aggregate(&cx, ty, s, Span::from_static(&cx, "array")),
            Type::Enum(variants) => match self.types.niche_variant(&cx, variants) {
                // The niche layout: the payload's C type, the other variant a null at the niche.
                Option::Some(k) => {
                    let payload = erase(&cx, variants.at(&cx, k).type, self.types);
                    let name = self.ctype(&cx, payload, false);
                    self.names.insert(&cx, ty, name);
                    self.represented.insert(&cx, ty, payload);
                },
                Option::None => self.aggregate(&cx, ty, s, Span::from_static(&cx, "enum")),
            },
            Type::Fn(f) => {
                let name = self.fresh_name(&cx, Span::from_static(&cx, "fn"));
                self.names.insert(&cx, ty, name);
                // Function declarations may name forward-declared aggregates. Define their
                // fields after this typedef, which they may use.
                let result = self.ctype(&cx, f.ret.copy(&cx), false);
                let params: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
                var k = 0usize;
                while k < f.params.len(&cx) {
                    let ct = self.ctype(&cx, f.params.at(&cx, k), false);
                    if !ct.is(&cx, "void") {
                        params.push(&cx, if f.places.contains(&cx, k) { Buffer!::new().push_bytes(&cx, ct).push_static("*").save(&cx) } else { ct });
                    }
                    k = k + 1usize;
                }
                self.defs.push(&cx, Buffer!::new().push_static("typedef ").push_bytes(&cx, result).push_static(" (*").push_bytes(&cx, name).push_static(")(").push_bytes(&cx, or_void(&cx, params.join(&cx, ", "))).push_static(");").save(&cx));
            },
            _ => {
                let name = self.c(&cx, s);
                self.names.insert(&cx, ty, name);
            },
        };
    }

    fn aggregate(self, &cx: Domain!['k], ty: Type['k], s: Type['k], kind: Span['k]) {
        let hint = match ty {
            Type::Named(name, _args) => name,
            _ => kind,
        };
        let name = self.fresh_name(&cx, hint);
        self.names.insert(&cx, ty, name);
        self.forward.push(&cx, Buffer!::new().push_static("typedef struct ").push_bytes(&cx, name).push_static(" ").push_bytes(&cx, name).push_static(";").save(&cx));
        self.pending.insert(&cx, ty, s);
    }

    fn define(self, &cx: Domain!['k], ty: Type['k]) {
        let s = self.pending.at(&cx, ty);
        self.pending.remove(&cx, ty);
        let body = match s {
            Type::Array(elem, length) => Buffer!::new().push_bytes(&cx, self.c(&cx, elem.copy(&cx))).push_static(" items[").push_u64(length).push_static("];").save(&cx),
            Type::Enum(variants) => {
                let members: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
                var i = 0usize;
                while i < variants.len(&cx) {
                    let t = variants.at(&cx, i).type;
                    if !self.erased(&cx, t) {
                        let ct = self.c(&cx, t);
                        members.push(&cx, Buffer!::new().push_bytes(&cx, ct).push_static(" ").push_bytes(&cx, self.variant(&cx, variants.at(&cx, i).name)).push_static(";").save(&cx));
                    }
                    i = i + 1usize;
                }
                if members.is_empty(&cx) {
                    Span::from_static(&cx, "uint32_t tag;")
                } else {
                    Buffer!::new().push_static("uint32_t tag; union { ").push_bytes(&cx, members.join(&cx, " ")).push_static(" } payload;").save(&cx)
                }
            },
            _ => {
                let rows = self.members(&cx, s);
                let parts: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
                var i = 0usize;
                while i < rows.len(&cx) {
                    let (m, f) = rows.at(&cx, i);
                    if !self.erased(&cx, f) {
                        parts.push(&cx, Buffer!::new().push_bytes(&cx, self.c(&cx, f)).push_static(" ").push_bytes(&cx, m).push_static(";").save(&cx));
                    }
                    i = i + 1usize;
                }
                parts.join(&cx, " ")
            },
        };
        self.defs.push(&cx, Buffer!::new().push_static("struct ").push_bytes(&cx, self.names.at(&cx, ty)).push_static(" { ").push_bytes(&cx, body).push_static(" };").save(&cx));
    }

    // (C member, component type) of a struct or tuple shape, in order.
    fn members(self, &cx: Domain!['k], shape: Type['k]) -> ArenaVec[(Span['k], Type['k]), 'k] {
        let out: ArenaVec[(Span['k], Type['k]), 'k] = ArenaVec::new(&cx);
        match shape {
            Type::Tuple(elems) => {
                var i = 0usize;
                while i < elems.len(&cx) {
                    out.push(&cx, (Buffer!::new().push_static("e").push_usize(i).save(&cx), elems.at(&cx, i)));
                    i = i + 1usize;
                }
            },
            Type::Struct(fields) => {
                var i = 0usize;
                while i < fields.len(&cx) {
                    out.push(&cx, (self.component(&cx, fields.at(&cx, i).name, Span::from_static(&cx, "f")), fields.at(&cx, i).type));
                    i = i + 1usize;
                }
            },
            _ => fail_text(&cx, Span::from_static(&cx, "internal error: members of a type that is not a struct or tuple")),
        };
        out
    }

    // (C member, component type) of the component `label` (a field name or a tuple index) of a
    // struct or tuple shape.
    fn member_of(self, &cx: Domain!['k], shape: Type['k], label: Span['k]) -> (Span['k], Type['k]) {
        let names: ArenaVec[Span['k], 'k] = match shape {
            Type::Struct(fields) => {
                let out: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
                var f = 0usize;
                while f < fields.len(&cx) {
                    out.push(&cx, fields.at(&cx, f).name);
                    f = f + 1usize;
                }
                out
            },
            Type::Tuple(elems) => {
                let out: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
                var e = 0usize;
                while e < elems.len(&cx) {
                    out.push(&cx, Buffer!::new().push_usize(e).save(&cx));
                    e = e + 1usize;
                }
                out
            },
            _ => fail_text(&cx, Span::from_static(&cx, "internal error: a component of a type that is not a product")),
        };
        let rows = self.members(&cx, shape);
        var k = names.len(&cx);
        while k > 0usize {
            k = k - 1usize;
            if names.at(&cx, k).eq(&cx, label) {
                return rows.at(&cx, k);
            }
        }
        fail_text(&cx, Span::from_static(&cx, "internal error: no such component"))
    }

    fn component(self, &cx: Domain!['k], name: Span['k], prefix: Span['k]) -> Span['k] {
        let key = (prefix, name);
        if !self.component_names.contains(&cx, key) {
            self.component_names.insert(&cx, key, allocate(&cx, Buffer!::new().push_bytes(&cx, prefix).push_static("_").push_bytes(&cx, self.readable(&cx, name)).save(&cx), self.component_taken));
        }
        self.component_names.at(&cx, key)
    }

    fn variant(self, &cx: Domain!['k], name: Span['k]) -> Span['k] {
        self.component(&cx, name, Span::from_static(&cx, "v"))
    }

    fn shape(self, &cx: Domain!['k], ty: Type['k]) -> Type['k] {
        self.types.shape(&cx, erase(&cx, ty, self.types), Option::None)
    }

    // ------------------------------------------------------------ enum layouts --

    // For an enum in the niche layout (`Types::niche_variant`): the index of the variant it is
    // represented as, and the C access from a value of it to the niche's pointer (`""` when the
    // payload is that pointer).
    fn niche_layout(self, &cx: Domain!['k], ty: Type['k]) -> Option[(usize, Span['k])] {
        let variants = self.types.variants(&cx, erase(&cx, ty, self.types), Option::None);
        let k = match self.types.niche_variant(&cx, variants) {
            Option::Some(k) => k,
            Option::None => return Option::None,
        };
        var payload = variants.at(&cx, k).type;
        let path = match self.types.niche(&cx, payload) {
            Option::Some(p) => p,
            Option::None => fail_text(&cx, Span::from_static(&cx, "internal error: a niche variant without a niche")),
        };
        var access = Span::from_static(&cx, "");
        var i = 0usize;
        while i < path.len(&cx) {
            let s = self.shape(&cx, payload);
            let unit = match s {
                Type::Array(elem, _length) => {
                    access = access.concat(&cx, Span::from_static(&cx, ".items[0]"));
                    payload = elem.copy(&cx);
                },
                _ => {
                    let (member, t) = self.member_of(&cx, s, path.at(&cx, i));
                    access = Buffer!::new().push_bytes(&cx, access).push_static(".").push_bytes(&cx, member).save(&cx);
                    payload = t;
                },
            };
            i = i + 1usize;
        }
        Option::Some.((k, access))
    }

    // The index of the variant a value of the enum `ty` holds, as C.
    fn tag(self, &cx: Domain!['k], source: Span['k], ty: Type['k]) -> Span['k] {
        match self.niche_layout(&cx, ty) {
            Option::Some(layout) => {
                let (k, access) = layout;
                Buffer!::new().push_static("(").push_bytes(&cx, source).push_bytes(&cx, access).push_static(" == 0 ? ").push_usize(1usize - k)
                    .push_static(" : ").push_usize(k).push_static(")").save(&cx)
            },
            Option::None => Buffer!::new().push_bytes(&cx, source).push_static(".tag").save(&cx),
        }
    }

    // The C object of one variant's payload within a value or place of the enum `ty`.
    fn payload(self, &cx: Domain!['k], source: Span['k], ty: Type['k], variant: Span['k]) -> Span['k] {
        match self.niche_layout(&cx, ty) {
            Option::Some(_layout) => source,
            Option::None => Buffer!::new().push_bytes(&cx, source).push_static(".payload.").push_bytes(&cx, self.variant(&cx, variant)).save(&cx),
        }
    }

    // C that makes `dst` hold `variant` of the enum `ty`, with the payload `value` (none for a payload
    // of a zero-size type). In the niche layout, the payload variant is its payload; the other is the
    // null at the niche, and the rest of the object is not written.
    fn set_variant(self, &cx: Domain!['k], dst: Span['k], ty: Type['k], variant: Span['k], value: Option[Span['k]]) -> ArenaVec[Span['k], 'k] {
        let variants = self.types.variants(&cx, erase(&cx, ty, self.types), Option::None);
        var index = 0usize;
        while index < variants.len(&cx) && !variants.at(&cx, index).name.eq(&cx, variant) {
            index = index + 1usize;
        }
        let value_text = match value {
            Option::Some(v) => v,
            Option::None => Span::from_static(&cx, "None"),
        };
        match self.niche_layout(&cx, ty) {
            Option::Some(layout) => {
                let (k, access) = layout;
                if index == k {
                    ArenaVec::one(&cx, Buffer!::new().push_bytes(&cx, dst).push_static(" = ").push_bytes(&cx, value_text).push_static(";").save(&cx))
                } else {
                    ArenaVec::one(&cx, Buffer!::new().push_bytes(&cx, dst).push_bytes(&cx, access).push_static(" = 0;").save(&cx))
                }
            },
            Option::None => {
                let out: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
                let unit = match value {
                    Option::Some(v) => {
                        out.push(&cx, Buffer!::new().push_bytes(&cx, dst).push_static(".payload.").push_bytes(&cx, self.variant(&cx, variant)).push_static(" = ")
                            .push_bytes(&cx, v).push_static(";").save(&cx));
                    },
                    Option::None => (),
                };
                out.push(&cx, Buffer!::new().push_bytes(&cx, dst).push_static(".tag = ").push_usize(index).push_static(";").save(&cx));
                out
            },
        }
    }

    // Whether an entry function may take `ty`, which C's `main` fills from `argv` and `argc`
    // (`std::process::Args`): a struct of exactly a `*(*u8)` and a `usize`, in that order.
    fn arguments_type(self, &cx: Domain!['k], ty: Type['k]) -> bool {
        match self.shape(&cx, ty) {
            Type::Struct(fields) => fields.len(&cx) == 2usize
                && equal(&cx, fields.at(&cx, 0usize).type, C::ptr(&cx, C::ptr(&cx, C::prim(&cx, "u8"))))
                && equal(&cx, fields.at(&cx, 1usize).type, C::prim(&cx, "usize")),
            _ => false,
        }
    }

    // How C's `main` makes an entry function's result `ty` its exit status, or none if it cannot:
    // `Status` returns it (`i32`), `Zero` returns 0 (`()`), and `Report` (`Result[(), std::io::Error]`)
    // returns 0 for `Ok`, and 1 for `Err` once `REPORT_ERROR` has reported its errno on stderr. As
    // `Args` is, the result is known by its shape alone: an enum of `Ok` of `()` and `Err` of a struct
    // of exactly one `i32`.
    fn entry_result(self, &cx: Domain!['k], ty: Type['k]) -> Option[EntryResult] {
        if equal(&cx, ty, C::prim(&cx, "i32")) {
            return Option::Some.(EntryResult::Status);
        }
        if equal(&cx, ty, C::unit(&cx)) {
            return Option::Some.(EntryResult::Zero);
        }
        let variants = match self.shape(&cx, ty) {
            Type::Enum(variants) => variants,
            _ => return Option::None,
        };
        if variants.len(&cx) != 2usize || !variants.at(&cx, 0usize).name.is(&cx, "Ok") || !variants.at(&cx, 1usize).name.is(&cx, "Err")
            || !equal(&cx, variants.at(&cx, 0usize).type, C::unit(&cx)) {
            return Option::None;
        }
        match self.shape(&cx, variants.at(&cx, 1usize).type) {
            Type::Struct(fields) => if fields.len(&cx) == 1usize && equal(&cx, fields.at(&cx, 0usize).type, C::prim(&cx, "i32")) {
                Option::Some.(EntryResult::Report)
            } else {
                Option::None
            },
            _ => Option::None,
        }
    }

    // `ty` has no C representation: it is zero-size (Never included).
    fn erased(self, &cx: Domain!['k], ty: Type['k]) -> bool {
        self.c(&cx, ty).is(&cx, "void")
    }

    // A call argument passes nothing: a value, a lent place or a raw target of a zero-size type.
    fn erased_arg(self, &cx: Domain!['k], arg: Span['k]) -> bool {
        if arg.starts_with(&cx, Span::from_static(&cx, "&*")) {
            return self.erased(&cx, self.pointee(&cx, self.type_of(&cx, arg.skip(2usize))));
        }
        if arg.starts_with(&cx, Span::from_static(&cx, "&")) {
            let (_expr, ty) = self.place(&cx, arg);
            return self.erased(&cx, ty);
        }
        self.value_erased(&cx, arg)
    }

    // ------------------------------------------------------------ specialization --

    fn request(self, &cx: Domain!['k], key: FunKey['k], fun: Fun['k], sub: ArenaMap[Span['k], Type['k], 'k]) -> Span['k] {
        let params = self.instance_params.get_or(&cx, key, fun.params);
        var agree = sub.len(&cx) == params.len(&cx);
        var p = 0usize;
        while agree && p < params.len(&cx) {
            agree = sub.contains(&cx, params.at(&cx, p).name);
            p = p + 1usize;
        }
        if !agree {
            fail_text(&cx, Buffer!::new().push_static("specialization arguments disagree for ").push_bytes(&cx, fun.name).save(&cx));
        }
        // One specialization for type arguments that differ only in brands, made for the first
        // request's. Otherwise logical alpha-equivalence, not representation equality.
        // Capture-avoiding substitution may freshen bound names on recursive requests. At most one
        // earlier request is alpha-equivalent to these arguments, so one with structurally equal
        // arguments is it.
        let args: ArenaVec[Type['k], 'k] = ArenaVec::new(&cx);
        var a = 0usize;
        while a < params.len(&cx) {
            args.push(&cx, unbranded(&cx, sub.at(&cx, params.at(&cx, a).name)));
            a = a + 1usize;
        }
        match self.symbol_index.get(&cx, (key, args)) {
            Option::Some(symbol) => {
                return symbol;
            },
            Option::None => (),
        };
        // Only an earlier request whose arguments hash alike can be alpha-equivalent to these.
        let bucket = (key, alpha_hashes(&cx, args));
        let earlier = match self.symbols.get(&cx, bucket) {
            Option::Some(found) => found,
            Option::None => {
                let found: ArenaVec[(ArenaVec[Type['k], 'k], Span['k]), 'k] = ArenaVec::new(&cx);
                self.symbols.insert(&cx, bucket, found);
                found
            },
        };
        var s = 0usize;
        while s < earlier.len(&cx) {
            let (previous, symbol) = earlier.at(&cx, s);
            var same = true;
            var i = 0usize;
            while same && i < args.len(&cx) && i < previous.len(&cx) {
                same = equal(&cx, args.at(&cx, i), previous.at(&cx, i));
                i = i + 1usize;
            }
            if same {
                return symbol;
            }
            s = s + 1usize;
        }
        let (path, function_id) = self.function_ids.at(&cx, key);
        let signature_key = match self.signature_keys.get(&cx, key) {
            Option::Some(found) => found,
            Option::None => {
                let signature = C::fn_type(&cx, fun.ptypes, fun.ret, params, fun.is_unsafe, fun.places(&cx));
                let found = type_key(&cx, signature, ArenaVec::new(&cx));
                self.signature_keys.insert(&cx, key, found);
                found
            },
        };
        let identity = ArenaVec::two(&cx, function_id, signature_key);
        var t = 0usize;
        while t < args.len(&cx) {
            identity.push(&cx, type_key(&cx, args.at(&cx, t), ArenaVec::new(&cx)));
            t = t + 1usize;
        }
        let symbol = self.function_name(&cx, path, encode(&cx, identity));
        earlier.push(&cx, (args, symbol));
        self.symbol_index.insert(&cx, (key, args), symbol);
        self.queue.push(&cx, (key, fun, sub.clone(&cx), symbol));
        let refs: ArenaVec[bool, 'k] = ArenaVec::new(&cx);
        let entry = fun.blocks.at(&cx, 0usize);
        var r = 0usize;
        while r < entry.params.len(&cx) {
            let binding = entry.params.at(&cx, r);
            refs.push(&cx, !binding.name.starts_with(&cx, Span::from_static(&cx, "&")) && self.by_pointer(&cx, subst(&cx, binding.type, sub, self.counter)));
            r = r + 1usize;
        }
        self.by_ref.insert(&cx, symbol, refs);
        let outs: ArenaVec[usize, 'k] = ArenaVec::new(&cx);
        match self.shape(&cx, subst(&cx, fun.ret, sub, self.counter)) {
            Type::Tuple(elems) => {
                var k = 0usize;
                while k < elems.len(&cx) {
                    if self.by_pointer(&cx, elems.at(&cx, k)) {
                        outs.push(&cx, k);
                    }
                    k = k + 1usize;
                }
            },
            _ => (),
        };
        self.outs.insert(&cx, symbol, outs);
        symbol
    }

    // The C result of a function writing the elements `outs` of its tuple result `ret` through out
    // pointers: a tuple of the other elements.
    fn reduced(self, &cx: Domain!['k], ret: Type['k], outs: ArenaVec[usize, 'k]) -> Type['k] {
        let rest: ArenaVec[Type['k], 'k] = ArenaVec::new(&cx);
        match self.shape(&cx, ret) {
            Type::Tuple(elems) => {
                var k = 0usize;
                while k < elems.len(&cx) {
                    if !outs.contains(&cx, k) {
                        rest.push(&cx, elems.at(&cx, k));
                    }
                    k = k + 1usize;
                }
            },
            _ => fail_text(&cx, Span::from_static(&cx, "internal error: out pointers of a result that is not a tuple")),
        };
        Type::Tuple.(rest)
    }

    // The C type and name of each out pointer of `symbol`, by element.
    fn out_pointers(self, &cx: Domain!['k], symbol: Span['k]) -> ArenaVec[(Span['k], Span['k]), 'k] {
        self.out_params.get_or(&cx, symbol, ArenaVec::new(&cx))
    }

    // A value of `ty` is passed by pointer: its C representation is more than four words. Up to four
    // words the C compiler copies it in as many moves, while a pointer costs the callee a load per read
    // and the inliner a higher estimate: `Interp!::cons` of `examples/lisp`, taking two four-word values,
    // is not inlined into the interpreter's loop when it takes them by pointer.
    fn by_pointer(self, &cx: Domain!['k], ty: Type['k]) -> bool {
        match self.by_pointer_cache.get(&cx, ty) {
            Option::Some(found) => found,
            Option::None => {
                let found = self.words(&cx, ty) > 4usize;
                self.by_pointer_cache.insert(&cx, ty, found);
                found
            },
        }
    }

    // The size of `ty`'s C representation in 8-byte words, as estimated from its structure: a scalar
    // is a word, an enum its tag and its largest payload (in the niche layout, its payload).
    fn words(self, &cx: Domain!['k], ty: Type['k]) -> usize {
        let t = erase(&cx, ty, self.types);
        if self.types.zero_size(&cx, t) {
            return 0usize;
        }
        match self.types.shape(&cx, t, Option::None) {
            Type::Struct(fields) => {
                var total = 0usize;
                var f = 0usize;
                while f < fields.len(&cx) {
                    total = total + self.words(&cx, fields.at(&cx, f).type);
                    f = f + 1usize;
                }
                total
            },
            Type::Tuple(elems) => {
                var total = 0usize;
                var e = 0usize;
                while e < elems.len(&cx) {
                    total = total + self.words(&cx, elems.at(&cx, e));
                    e = e + 1usize;
                }
                total
            },
            Type::Array(elem, length) => (length as usize) * self.words(&cx, elem.copy(&cx)),
            Type::Enum(variants) => match self.types.niche_variant(&cx, variants) {
                Option::Some(k) => self.words(&cx, variants.at(&cx, k).type),
                Option::None => {
                    var most = 0usize;
                    var v = 0usize;
                    while v < variants.len(&cx) {
                        let size = self.words(&cx, variants.at(&cx, v).type);
                        if size > most {
                            most = size;
                        }
                        v = v + 1usize;
                    }
                    1usize + most
                },
            },
            _ => 1usize,
        }
    }

    fn takes_by_ref(self, &cx: Domain!['k], symbol: Span['k]) -> bool {
        let refs = self.by_ref.at(&cx, symbol);
        var k = 0usize;
        while k < refs.len(&cx) {
            if refs.at(&cx, k) {
                return true;
            }
            k = k + 1usize;
        }
        false
    }

    fn function_name(self, &cx: Domain!['k], path: ArenaVec[Span['k], 'k], identity: Span['k]) -> Span['k] {
        var salt = 0u64;
        var symbol = mangle(&cx, path, identity, salt);
        while self.taken.taken.contains(&cx, symbol) {
            salt = salt + 1u64;
            symbol = mangle(&cx, path, identity, salt);
        }
        self.taken.taken.insert(&cx, symbol);
        symbol
    }

    fn function_address(self, &cx: Domain!['k], instr: Instr['k]) -> Span['k] {
        let name = instr.args.at(&cx, 0usize);
        if self.program.externs.contains(&cx, name) {
            return name;
        }
        let fun = self.program.funs.at(&cx, name);
        // Stable distinct rigid identities: not a wildcard and not static.
        let sub: ArenaMap[Span['k], Type['k], 'k] = ArenaMap::new(&cx);
        var k = 0usize;
        while k < fun.params.len(&cx) && k < instr.tys.len(&cx) {
            let t = instr.tys.at(&cx, k);
            let value = match t {
                Type::Ignored => {
                    let identity = ArenaVec::two(&cx, Span::from_static(&cx, "#retained"), fun.name);
                    identity.push(&cx, Buffer!::new().push_usize(k).save(&cx));
                    Type::Skolem.(encode(&cx, identity))
                },
                _ => self.substitute_type(&cx, t),
            };
            sub.insert(&cx, fun.params.at(&cx, k).name, value);
            k = k + 1usize;
        }
        let symbol = self.request(&cx, FunKey::Function.(name), fun, sub);
        let added = self.address_taken.insert(&cx, symbol);
        if !self.takes_by_ref(&cx, symbol) && self.outs.at(&cx, symbol).is_empty(&cx) {
            return symbol;
        }
        // A function value calls with the plain convention: through an entry taking every value as is.
        match self.thunks.get(&cx, symbol) {
            Option::Some(thunk) => thunk,
            Option::None => {
                let thunk = allocate(&cx, Buffer!::new().push_bytes(&cx, symbol).push_static("_value").save(&cx), self.taken);
                self.thunks.insert(&cx, symbol, thunk);
                thunk
            },
        }
    }

    // The head and body of `thunk`, the by-value entry of `symbol` that function values call: it takes
    // each aggregate `symbol` takes by pointer as a value, and passes its address.
    fn thunk(self, &cx: Domain!['k], symbol: Span['k], thunk: Span['k]) -> (Span['k], Span['k]) {
        let (ret, noreturn, cparams) = self.heads.at(&cx, symbol);
        let refs = self.by_ref.at(&cx, symbol);
        let params: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
        let args: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
        var k = 0usize;
        while k < cparams.len(&cx) {
            let cp = cparams.at(&cx, k);
            if !cp.ctype.is(&cx, "void") {
                params.push(&cx, Buffer!::new().push_bytes(&cx, cp.ctype).push_static(if cp.place { "*" } else { "" }).push_static(" ").push_bytes(&cx, cp.cname).save(&cx));
                args.push(&cx, Buffer!::new().push_static(if refs.at(&cx, k) { "&" } else { "" }).push_bytes(&cx, cp.cname).save(&cx));
            }
            k = k + 1usize;
        }
        let outs = self.out_pointers(&cx, symbol);
        if !outs.is_empty(&cx) {
            return self.whole_thunk(&cx, symbol, thunk, ret, params, args, outs);
        }
        let call = Buffer!::new().push_bytes(&cx, symbol).push_static("(").push_bytes(&cx, args.join(&cx, ", ")).push_static(");").save(&cx);
        let body = if ret.is(&cx, "void") {
            Buffer!::new().push_static(" {\n  ").push_bytes(&cx, call).push_static("\n}\n").save(&cx)
        } else {
            Buffer!::new().push_static(" {\n  return ").push_bytes(&cx, call).push_static("\n}\n").save(&cx)
        };
        let head = Buffer!::new().push_static(if noreturn { "_Noreturn " } else { "" }).push_bytes(&cx, self.linkage).push_bytes(&cx, ret).push_static(" ").push_bytes(&cx, thunk)
            .push_static("(").push_bytes(&cx, or_void(&cx, params.join(&cx, ", "))).push_static(")").save(&cx);
        (head, body)
    }

    // `thunk` of a function writing elements of its result through the out pointers `outs`: it takes
    // them into locals, and returns the whole result.
    fn whole_thunk(self, &cx: Domain!['k], symbol: Span['k], thunk: Span['k], ret: Span['k], params: ArenaVec[Span['k], 'k], args: ArenaVec[Span['k], 'k],
        outs: ArenaVec[(Span['k], Span['k]), 'k]) -> (Span['k], Span['k]) {
        let whole = self.results.at(&cx, symbol);
        let ks = self.outs.at(&cx, symbol);
        let members = self.members(&cx, self.shape(&cx, whole));
        var body = Buffer!::new().push_static(" {\n");
        var o = 0usize;
        while o < outs.len(&cx) {
            let (ctype, cname) = outs.at(&cx, o);
            body = body.push_static("  ").push_bytes(&cx, ctype).push_static(" ").push_bytes(&cx, cname).push_static(";\n");
            args.push(&cx, Buffer!::new().push_static("&").push_bytes(&cx, cname).save(&cx));
            o = o + 1usize;
        }
        let call = Buffer!::new().push_bytes(&cx, symbol).push_static("(").push_bytes(&cx, args.join(&cx, ", ")).push_static(")").save(&cx);
        let rest = self.members(&cx, self.shape(&cx, self.reduced(&cx, whole, ks)));
        var r = 0usize;
        let parts: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
        var k = 0usize;
        while k < members.len(&cx) {
            let (member, t) = members.at(&cx, k);
            let source = match ks.index_of(&cx, k) {
                Option::Some(i) => {
                    let (_ctype, cname) = outs.at(&cx, i);
                    cname
                },
                Option::None => {
                    let (m, _t) = rest.at(&cx, r);
                    r = r + 1usize;
                    Buffer!::new().push_static("reduced.").push_bytes(&cx, m).save(&cx)
                },
            };
            if !self.erased(&cx, t) {
                parts.push(&cx, Buffer!::new().push_static(".").push_bytes(&cx, member).push_static(" = ").push_bytes(&cx, source).save(&cx));
            }
            k = k + 1usize;
        }
        body = if ret.is(&cx, "void") {
            body.push_static("  ").push_bytes(&cx, call).push_static(";\n")
        } else {
            body.push_static("  ").push_bytes(&cx, ret).push_static(" reduced = ").push_bytes(&cx, call).push_static(";\n")
        };
        let ct = self.c(&cx, whole);
        body = body.push_static("  return (").push_bytes(&cx, ct).push_static("){ ").push_bytes(&cx, parts.join(&cx, ", ")).push_static(" };\n}\n");
        let head = Buffer!::new().push_bytes(&cx, self.linkage).push_bytes(&cx, self.c(&cx, whole)).push_static(" ").push_bytes(&cx, thunk)
            .push_static("(").push_bytes(&cx, or_void(&cx, params.join(&cx, ", "))).push_static(")").save(&cx);
        (head, body.save(&cx))
    }

    // The value parameters the function being written assigns (`written_params` in cgen.py).
    fn written_params(self, &cx: Domain!['k], fun: Fun['k]) -> ArenaSet[Span['k], 'k] {
        let plan = self.the_plan(&cx);
        let out: ArenaSet[Span['k], 'k] = ArenaSet::new(&cx);
        var b = 0usize;
        while b < plan.emitted.len(&cx) {
            let block = plan.emitted.at(&cx, b);
            if plan.tail_call(&cx, block) {
                let call = block.instrs.at(&cx, block.instrs.len(&cx) - 1usize);
                if call.op.is(&cx, "trait_call") || call.args.at(&cx, 0usize).eq(&cx, fun.name) {
                    let params = fun.blocks.at(&cx, 0usize).params;
                    var p = 0usize;
                    while p < params.len(&cx) {
                        out.insert(&cx, params.at(&cx, p).name);
                        p = p + 1usize;
                    }
                    return out;
                }
            }
            b = b + 1usize;
        }
        let entry = fun.blocks.at(&cx, 0usize).label;
        var i = 0usize;
        while i < plan.in_place.positions(&cx) {
            match plan.in_place.key_at(&cx, i) {
                Option::Some(at) => {
                    let (label, _index) = at;
                    let paths = plan.in_place.at(&cx, at);
                    var k = 0usize;
                    while k < paths.len(&cx) {
                        if paths.at(&cx, k).starts_with(&cx, Span::from_static(&cx, "%")) {
                            match plan.variable(&cx, label, root(&cx, paths.at(&cx, k))) {
                                Option::Some(home) => {
                                    let (block, name) = home;
                                    if block.eq(&cx, entry) {
                                        out.insert(&cx, name);
                                    }
                                },
                                Option::None => (),
                            };
                        }
                        k = k + 1usize;
                    }
                },
                Option::None => (),
            };
            i = i + 1usize;
        }
        out
    }

    fn resolve_trait(self, &cx: Domain!['k], trait_name: Span['k], method: Span['k], tys: ArenaVec[Type['k], 'k]) -> (FunKey['k], Fun['k], ArenaMap[Span['k], Type['k], 'k]) {
        // Checking already discharged authority at the use site. Specialization selects its
        // coherent head; the callee's module need not own that shape.
        let (index, inst, sub) = match matching_instance(&cx, self.program, self.counter, trait_name, tys) {
            Option::Some(found) => found,
            Option::None => fail_text(&cx, Buffer!::new().push_static("no instance of ").push_bytes(&cx, trait_name).push_static(" for these types").save(&cx)),
        };
        var i = 0usize;
        while i < inst.methods.len(&cx) {
            if inst.methods.at(&cx, i).name.eq(&cx, method) {
                return (FunKey::Method.(trait_name, index, method), inst.methods.at(&cx, i), sub);
            }
            i = i + 1usize;
        }
        fail_text(&cx, Buffer!::new().push_static("internal error: no method ").push_bytes(&cx, method).save(&cx))
    }

    // ------------------------------------------------------------------- program --

    fn emit_program(self, &cx: Domain!['k], entry: Option[Span['k]], hosted: bool, times: bool) -> CText!['k] {
        var started = Instant::now();
        check_mono_termination(&cx, self.program);
        let keywords = c_keywords(&cx);
        let runtime = runtime_names(&cx);
        let externs: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
        let all = self.program.externs.values(&cx);
        var e = 0usize;
        while e < all.len(&cx) {
            let ext = all.at(&cx, e);
            if !is_c_identifier(&cx, ext.name) || keywords.contains(&cx, ext.name) {
                fail_at(&cx, Buffer!::new().push_static("backend: foreign symbol ").push_bytes(&cx, ext.name).push_static(" is not a C identifier").save(&cx), ext.pos);
            }
            if runtime.contains(&cx, ext.name) || ext.name.starts_with(&cx, Span::from_static(&cx, "__builtin_")) || ext.name.starts_with(&cx, Span::from_static(&cx, "__atomic_"))
                || (ext.name.is(&cx, "main") || ext.name.is(&cx, REPORT_ERROR)) && entry.is_some()
                || ext.name.is(&cx, START) && entry.is_some() && hosted {
                fail_at(&cx, Buffer!::new().push_static("backend: foreign symbol ").push_bytes(&cx, ext.name)
                    .push_static(" conflicts with the C runtime prelude or entry wrapper").save(&cx), ext.pos);
            }
            let ret = match ext.ret {
                Option::Some(r) => r,
                Option::None => fail_text(&cx, Span::from_static(&cx, "internal error: an extern without a type")),
            };
            match ext.ptypes {
                Option::None => externs.push(&cx, Buffer!::new().push_static("extern ").push_bytes(&cx, self.c(&cx, ret)).push_static(" ").push_bytes(&cx, ext.name).push_static(";").save(&cx)),
                Option::Some(ptypes) => {
                    let result = self.c(&cx, ret);
                    let noreturn = if is_never(ret) { Span::from_static(&cx, "_Noreturn ") } else { Span::from_static(&cx, "") };
                    let params: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
                    var p = 0usize;
                    while p < ptypes.len(&cx) {
                        params.push(&cx, self.c(&cx, ptypes.at(&cx, p)));
                        p = p + 1usize;
                    }
                    externs.push(&cx, Buffer!::new().push_bytes(&cx, noreturn).push_bytes(&cx, result).push_static(" ").push_bytes(&cx, ext.name).push_static("(").push_bytes(&cx, or_void(&cx, params.join(&cx, ", "))).push_static(");").save(&cx));
                },
            };
            e = e + 1usize;
        }
        var main: Option[Span['k]] = Option::None;
        match entry {
            Option::Some(name) => {
                let ok = match self.program.funs.get(&cx, name) {
                    Option::Some(fun) => fun.params.is_empty(&cx) && fun.premises.is_empty(&cx) && !fun.is_unsafe && fun.places(&cx).is_empty(&cx)
                        && self.entry_result(&cx, fun.ret).is_some()
                        && (fun.ptypes.is_empty(&cx) || fun.ptypes.len(&cx) == 1usize && self.arguments_type(&cx, fun.ptypes.at(&cx, 0usize))),
                    Option::None => false,
                };
                if !ok {
                    fail_text(&cx, Buffer!::new().push_static("backend: the entry ").push_bytes(&cx, name).push_static(" must be `fn()`, `fn() -> i32` or ")
                        .push_static("`fn() -> Result[(), std::io::Error]`, each with or without a parameter ")
                        .push_static("`args: std::process::Args`, and safe, not generic and without premises").save(&cx));
                }
                main = Option::Some.(self.request(&cx, FunKey::Function.(name), self.program.funs.at(&cx, name), ArenaMap::new(&cx)));
            },
            Option::None => {
                // The roots are the functions with nothing left to choose or discharge. One with
                // premises gets code only when a checked call, which discharged them, requests it.
                let funs = self.program.funs.values(&cx);
                var f = 0usize;
                while f < funs.len(&cx) {
                    let fun = funs.at(&cx, f);
                    if fun.params.is_empty(&cx) && fun.premises.is_empty(&cx) {
                        let unit = self.request(&cx, FunKey::Function.(fun.name), fun, ArenaMap::new(&cx));
                    }
                    f = f + 1usize;
                }
            },
        };
        started = c_stage(times, "C setup", started);
        var next = 0usize;
        while next < self.queue.len(&cx) {
            let (key, fun, sub, symbol) = self.queue.at(&cx, next);
            next = next + 1usize;
            self.emit_function(&cx, key, fun, sub, symbol);
        }
        started = c_stage(times, "C functions", started);
        var t = 0usize;
        while t < self.thunks.positions(&cx) {
            match self.thunks.key_at(&cx, t) {
                Option::Some(symbol) => {
                    let (head, body) = self.thunk(&cx, symbol, self.thunks.at(&cx, symbol));
                    self.emitted.push(&cx, (Option::None, head, body, Span::from_static(&cx, "")));
                },
                Option::None => (),
            };
            t = t + 1usize;
        }
        let declared: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
        let datas: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
        let entries = self.datas.values(&cx);
        var d = 0usize;
        while d < entries.len(&cx) {
            let (declaration, definition) = self.emit_data(&cx, entries.at(&cx, d));
            declared.push(&cx, declaration);
            datas.push(&cx, definition);
            d = d + 1usize;
        }
        // The first pending type each time: positions before `first` hold only defined ones.
        var first = 0usize;
        while first < self.pending.positions(&cx) {
            match self.pending.key_at(&cx, first) {
                Option::Some(ty) => self.define(&cx, ty),
                Option::None => {
                    first = first + 1usize;
                },
            };
        }
        let (const_params, restrict_params) = self.qualifiers(&cx);
        started = c_stage(times, "C definitions", started);
        let heads: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
        var h = 0usize;
        while h < self.emitted.len(&cx) {
            let (symbol, fixed, _body, _file) = self.emitted.at(&cx, h);
            heads.push(&cx, match symbol {
                Option::Some(s) => self.head(&cx, s, const_params, restrict_params),
                Option::None => fixed,
            });
            h = h + 1usize;
        }
        let wrapper = match main {
            Option::Some(symbol) => {
                let fun = self.program.funs.at(&cx, match entry {
                    Option::Some(name) => name,
                    Option::None => Span::from_static(&cx, ""),
                });
                Option::Some.(self.entry_wrapper(&cx, fun, symbol, hosted))
            },
            Option::None => Option::None,
        };
        // Types, externs and data, then every head, then every body: one file, or a split build's
        // header and the files that include it.
        var c = text_lines(&cx, text_lines(&cx, text_lines(&cx, prelude().push_static("\n"), self.forward), self.defs), externs);
        let result = if self.linkage.is_empty() {
            c = text_lines(&cx, c, declared);
            var p = 0usize;
            while p < heads.len(&cx) {
                c = c.push_bytes(&cx, heads.at(&cx, p)).push_static(";\n");
                p = p + 1usize;
            }
            let files: ArenaVec[(Span['k], Span['k]), 'k] = ArenaVec::new(&cx);
            files.push(&cx, (Span::from_static(&cx, HEADER), Buffer!::new().push_static("#pragma once\n").push_buffer(c).save(&cx)));
            files.push(&cx, (Span::from_static(&cx, "kursal-data.c"), text_lines(&cx, included(), datas).save(&cx)));
            // the file of each group of functions, in the order their first function comes
            let order: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
            let groups: ArenaMap[Span['k], ArenaVec[usize, 'k], 'k] = ArenaMap::new(&cx);
            var b = 0usize;
            while b < self.emitted.len(&cx) {
                let (_symbol, _fixed, _body, file) = self.emitted.at(&cx, b);
                let name = if file.is_empty() { Span::from_static(&cx, "kursal-thunks") } else { file };
                match groups.get(&cx, name) {
                    Option::Some(members) => members.push(&cx, b),
                    Option::None => {
                        order.push(&cx, name);
                        groups.insert(&cx, name, ArenaVec::one(&cx, b));
                    },
                };
                b = b + 1usize;
            }
            // A group's functions in files of about `PIECE` bytes each, the first named for the
            // group, the next for it and `.2`, `.3`...: the largest file bounds a parallel build.
            var g = 0usize;
            while g < order.len(&cx) {
                let name = order.at(&cx, g);
                let members = groups.at(&cx, name);
                var text = included();
                var piece = 1usize;
                var m = 0usize;
                while m < members.len(&cx) {
                    let at = members.at(&cx, m);
                    let (_symbol, _fixed, body, _file) = self.emitted.at(&cx, at);
                    text = text.push_bytes(&cx, heads.at(&cx, at)).push_bytes(&cx, body).push_static("\n");
                    m = m + 1usize;
                    if &text.len() >= PIECE || m == members.len(&cx) {
                        let file = Buffer!::new().push_bytes(&cx, name);
                        let file = if piece > 1usize { file.push_static(".").push_usize(piece) } else { file };
                        files.push(&cx, (file.push_static(".c").save(&cx), text.save(&cx)));
                        text = included();
                        piece = piece + 1usize;
                    }
                }
                text.destroy();
                g = g + 1usize;
            }
            match wrapper {
                Option::Some(text) => files.push(&cx, (Span::from_static(&cx, "kursal-main.c"), included().push_bytes(&cx, text).push_static("\n").save(&cx))),
                Option::None => (),
            };
            CText!::Split.(files)
        } else {
            c = text_lines(&cx, c, datas);
            var p = 0usize;
            while p < heads.len(&cx) {
                c = c.push_bytes(&cx, heads.at(&cx, p)).push_static(";\n");
                p = p + 1usize;
            }
            var b = 0usize;
            while b < self.emitted.len(&cx) {
                let (_symbol, _fixed, body, _file) = self.emitted.at(&cx, b);
                c = c.push_bytes(&cx, heads.at(&cx, b)).push_bytes(&cx, body).push_static("\n");
                b = b + 1usize;
            }
            CText!::One.(match wrapper {
                Option::Some(text) => c.push_bytes(&cx, text).push_static("\n"),
                Option::None => c,
            })
        };
        let finished = c_stage(times, "C assembly", started);
        result
    }

    // C's `main`: it calls the entry `fun`, whose C is `symbol`, with `Args` from `argv` and `argc` if
    // `fun` takes them, and makes its result the exit status (`entry_result`). A `hosted` one, for an
    // executable `kursal build` links with `lib/libc/start.c`, calls `START` first; any other (`kursal c`,
    // whose C a freestanding target may enter from start-up code of its own) does not.
    fn entry_wrapper(self, &cx: Domain!['k], fun: Fun['k], symbol: Span['k], hosted: bool) -> Span['k] {
        let (head, call) = if !fun.ptypes.is_empty(&cx) {
            let args = fun.ptypes.at(&cx, 0usize);
            let fields = match self.shape(&cx, args) {
                Type::Struct(members) => members,
                _ => fail_text(&cx, Span::from_static(&cx, "internal error: entry arguments that are not a struct")),
            };
            (Span::from_static(&cx, "int main(int argc, char **argv)"),
                Buffer!::new().push_bytes(&cx, symbol).push_static("((").push_bytes(&cx, self.c(&cx, args)).push_static("){ (")
                    .push_bytes(&cx, self.c(&cx, fields.at(&cx, 0usize).type)).push_static(")argv, (")
                    .push_bytes(&cx, self.c(&cx, fields.at(&cx, 1usize).type)).push_static(")argc })").save(&cx))
        } else {
            (Span::from_static(&cx, "int main(void)"), Buffer!::new().push_bytes(&cx, symbol).push_static("()").save(&cx))
        };
        let (declare, start) = if hosted {
            (Buffer!::new().push_static("void ").push_static(START).push_static("(void);\n").save(&cx),
                Buffer!::new().push_static(START).push_static("(); ").save(&cx))
        } else {
            (Span::from_static(&cx, ""), Span::from_static(&cx, ""))
        };
        let kind = match self.entry_result(&cx, fun.ret) {
            Option::Some(kind) => kind,
            Option::None => fail_text(&cx, Span::from_static(&cx, "internal error: an entry whose result is no exit status")),
        };
        match kind {
            EntryResult::Status => Buffer!::new().push_bytes(&cx, declare).push_bytes(&cx, head).push_static(" { ").push_bytes(&cx, start)
                .push_static("return (int)").push_bytes(&cx, call).push_static("; }").save(&cx),
            EntryResult::Zero => Buffer!::new().push_bytes(&cx, declare).push_bytes(&cx, head).push_static(" { ").push_bytes(&cx, start)
                .push_bytes(&cx, call).push_static("; return 0; }").save(&cx),
            EntryResult::Report => {
                let error = match self.shape(&cx, fun.ret) {
                    Type::Enum(variants) => self.shape(&cx, variants.at(&cx, 1usize).type),
                    _ => fail_text(&cx, Span::from_static(&cx, "internal error: an entry result that is not an enum")),
                };
                let label = match error {
                    Type::Struct(fields) => fields.at(&cx, 0usize).name,
                    _ => fail_text(&cx, Span::from_static(&cx, "internal error: an entry error that is not a struct")),
                };
                let (member, _type) = self.member_of(&cx, error, label);
                let status = self.fresh_name(&cx, Span::from_static(&cx, "status"));
                Buffer!::new().push_bytes(&cx, declare).push_static("void ").push_static(REPORT_ERROR).push_static("(int32_t);\n")
                    .push_bytes(&cx, head).push_static(" { ").push_bytes(&cx, start).push_bytes(&cx, self.c(&cx, fun.ret)).push_static(" ").push_bytes(&cx, status)
                    .push_static(" = ").push_bytes(&cx, call).push_static("; if (").push_bytes(&cx, self.tag(&cx, status, fun.ret))
                    .push_static(" == 0) return 0; ").push_static(REPORT_ERROR).push_static("(")
                    .push_bytes(&cx, self.payload(&cx, status, fun.ret, Span::from_static(&cx, "Err"))).push_static(".").push_bytes(&cx, member)
                    .push_static("); return 1; }").save(&cx)
            },
        }
    }

    // ---------------------------------------------------------------------- data --

    fn data_symbol(self, &cx: Domain!['k], name: Span['k]) -> Span['k] {
        if !self.datas.contains(&cx, name) {
            let symbol = allocate(&cx, Buffer!::new().push_static("d").push_usize(self.datas.len(&cx)).push_static("_").push_bytes(&cx, tail(self.readable(&cx, name), 40usize)).save(&cx), self.taken);
            self.datas.insert(&cx, name, (symbol, self.program.datas.at(&cx, name)));
        }
        let (symbol, _data) = self.datas.at(&cx, name);
        symbol
    }

    // A data's C object, declared and defined, read-only as the static image is; one of a zero-size type
    // is a `char`, for the address the program sees.
    fn emit_data(self, &cx: Domain!['k], entry: (Span['k], Data['k])) -> (Span['k], Span['k]) {
        let (symbol, data) = entry;
        let ct = if self.erased(&cx, data.ty) { Span::from_static(&cx, "char") } else { self.c(&cx, data.ty) };
        let declared = Buffer!::new().push_static("extern const ").push_bytes(&cx, ct).push_static(" ").push_bytes(&cx, symbol).push_static(";").save(&cx);
        let defined = Buffer!::new().push_bytes(&cx, self.linkage).push_static("const ").push_bytes(&cx, ct).push_static(" ").push_bytes(&cx, symbol);
        let defined = if self.erased(&cx, data.ty) { defined } else {
            defined.push_static(" = ").push_bytes(&cx, self.initializer(&cx, data.ty, data.init))
        };
        (declared, defined.push_static(";").save(&cx))
    }

    fn initializer(self, &cx: Domain!['k], ty: Type['k], form: Form['k]) -> Span['k] {
        let s = self.shape(&cx, ty);
        match s {
            Type::Prim(_name) => {
                return self.literal(&cx, s, form.text);
            },
            Type::Array(elem, length) => {
                let values: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
                var i = 0usize;
                while i < form.len(&cx) {
                    let part = form.at(&cx, i);
                    if C::same(&cx, elem.copy(&cx), C::prim(&cx, "u8")) && part.is_str() {
                        var b = 0usize;
                        while b < part.text.len() {
                            values.push(&cx, Buffer!::new().push_u64(part.text.byte_or_zero(&cx, b) as u64).save(&cx));
                            b = b + 1usize;
                        }
                    } else {
                        values.push(&cx, self.initializer(&cx, elem.copy(&cx), part));
                    }
                    i = i + 1usize;
                }
                return Buffer!::new().push_static("{ { ").push_bytes(&cx, values.join(&cx, ", ")).push_static(" } }").save(&cx);
            },
            _ => (),
        };
        let rows = self.members(&cx, s);
        let parts: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
        var i = 0usize;
        while i < rows.len(&cx) && i < form.len(&cx) {
            let (_m, f) = rows.at(&cx, i);
            if !self.erased(&cx, f) {
                parts.push(&cx, self.initializer(&cx, f, form.at(&cx, i)));
            }
            i = i + 1usize;
        }
        Buffer!::new().push_static("{ ").push_bytes(&cx, parts.join(&cx, ", ")).push_static(" }").save(&cx)
    }

    fn literal(self, &cx: Domain!['k], ty: Type['k], lit: Span['k]) -> Span['k] {
        let name = match ty {
            Type::Prim(n) => n,
            _ => fail_text(&cx, Span::from_static(&cx, "internal error: a literal of a type that is not primitive")),
        };
        if name.is(&cx, "bool") {
            return if lit.is(&cx, "1") || lit.is(&cx, "true") || lit.is(&cx, "True") { Span::from_static(&cx, "1") } else { Span::from_static(&cx, "0") };
        }
        if C::is_float(&cx, name) {
            let digits = if lit.contains(&cx, Span::from_static(&cx, ".")) || lit.contains(&cx, Span::from_static(&cx, "e")) || lit.contains(&cx, Span::from_static(&cx, "E")) { lit } else { lit.concat(&cx, Span::from_static(&cx, ".0")) };
            return if name.is(&cx, "f32") { digits.concat(&cx, Span::from_static(&cx, "f")) } else { digits };
        }
        if signed_suffix(&cx, name).is_some() {
            return if lit.is(&cx, "-9223372036854775808") { Span::from_static(&cx, "(-INT64_C(9223372036854775807) - 1)") } else { Buffer!::new().push_static("INT64_C(").push_bytes(&cx, lit).push_static(")").save(&cx) };
        }
        Buffer!::new().push_static("UINT64_C(").push_bytes(&cx, lit).push_static(")").save(&cx)
    }

    // ----------------------------------------------------------------- functions --

    fn emit_function(self, &cx: Domain!['k], key: FunKey['k], fun: Fun['k], sub: ArenaMap[Span['k], Type['k], 'k], symbol: Span['k]) {
        self.fun.set(&cx, Option::Some.(fun));
        self.sub.set(&cx, sub);
        self.symbol.set(&cx, symbol);
        self.substituted.copy(&cx).clear(&cx);
        self.erasure.copy(&cx).clear(&cx);
        let components: ArenaMap[(Span['k], usize), ArenaVec[Span['k], 'k], 'k] = ArenaMap::new(&cx);
        let shapes: ArenaMap[(Span['k], usize), Type['k], 'k] = ArenaMap::new(&cx);
        let adapters: ArenaMap[Span['k], Adapter['k], 'k] = ArenaMap::new(&cx);
        var cb = 0usize;
        while cb < fun.blocks.len(&cx) {
            let block = fun.blocks.at(&cx, cb);
            var ci = 0usize;
            while ci < block.instrs.len(&cx) {
                let instr = block.instrs.at(&cx, ci);
                if instr.op.is(&cx, "destruct") || instr.op.is(&cx, "construct") {
                    let ty = self.type_operand(&cx, instr);
                    match self.labels_of(&cx, ty) {
                        Option::Some(labels) => {
                            components.insert(&cx, (block.label, ci), labels);
                            shapes.insert(&cx, (block.label, ci), erase(&cx, ty, self.types));
                        },
                        Option::None => (),
                    };
                } else if instr.op.is(&cx, "call") && self.program.funs.contains(&cx, instr.args.at(&cx, 0usize)) {
                    match self.adapter(&cx, instr.args.at(&cx, 0usize)) {
                        Option::Some(found) => {
                            let (adapter, _fun) = found;
                            adapters.insert(&cx, instr.args.at(&cx, 0usize), adapter);
                        },
                        Option::None => (),
                    };
                }
                ci = ci + 1usize;
            }
            cb = cb + 1usize;
        }
        let place_params: ArenaSet[Span['k], 'k] = ArenaSet::new(&cx);
        var pp = 0usize;
        while pp < fun.blocks.at(&cx, 0usize).params.len(&cx) {
            let name = fun.blocks.at(&cx, 0usize).params.at(&cx, pp).name;
            if name.starts_with(&cx, Span::from_static(&cx, "&")) {
                place_params.insert(&cx, name);
            }
            pp = pp + 1usize;
        }
        var plan = Plan::new(&cx, fun, components, adapters, place_params, shapes);
        self.plan.set(&cx, Option::Some.(plan));
        let typed = self.recorded.at(&cx, key);
        let first_roots: ArenaMap[Span['k], Type['k], 'k] = ArenaMap::new(&cx);
        var fr = 0usize;
        while fr < fun.blocks.at(&cx, 0usize).params.len(&cx) {
            let binding = fun.blocks.at(&cx, 0usize).params.at(&cx, fr);
            if binding.name.starts_with(&cx, Span::from_static(&cx, "&")) {
                first_roots.insert(&cx, binding.name, self.substitute_type(&cx, binding.type));
            }
            fr = fr + 1usize;
        }
        var fl = 0usize;
        while fl < fun.locals.len(&cx) {
            first_roots.insert(&cx, fun.locals.at(&cx, fl).name, self.substitute_type(&cx, fun.locals.at(&cx, fl).type));
            fl = fl + 1usize;
        }
        self.roots.set(&cx, first_roots);
        let homes = self.homes(&cx, key, fun, typed, plan);
        let has_homes = !homes.is_empty(&cx);
        let fun = if has_homes { homed(&cx, fun, homes) } else { fun };
        if has_homes {
            self.fun.set(&cx, Option::Some.(fun));
            plan = Plan::new(&cx, fun, components, adapters, place_params, shapes);
            self.plan.set(&cx, Option::Some.(plan));
        }
        self.locals.copy(&cx).clear(&cx);
        self.aliases.copy(&cx).clear(&cx);
        self.forwards.copy(&cx).clear(&cx);
        self.scratch.set(&cx, 0usize);
        let label_taken = Pool::new(&cx, ArenaSet::new(&cx));
        let labels = self.labels.copy(&cx);
        labels.clear(&cx);
        var b = 0usize;
        while b < fun.blocks.len(&cx) {
            let label = fun.blocks.at(&cx, b).label;
            labels.insert(&cx, label, allocate(&cx, Buffer!::new().push_static("L_").push_bytes(&cx, self.readable(&cx, label)).save(&cx), label_taken));
            b = b + 1usize;
        }
        let decls: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
        let temps = self.temps.copy(&cx);
        temps.clear(&cx);
        let entry = fun.blocks.at(&cx, 0usize);
        let params = self.params.copy(&cx);
        params.clear(&cx);
        var n = 0usize;
        while n < entry.params.len(&cx) {
            params.push(&cx, entry.params.at(&cx, n).name);
            n = n + 1usize;
        }
        let place_c = self.place_c.copy(&cx);
        place_c.clear(&cx);
        let cparams: ArenaVec[CParam['k], 'k] = ArenaVec::new(&cx);
        // The parameters taken by pointer: read through it, or copied into the parameter's variable
        // where the function writes that (a call of itself in tail position, or a lend in place).
        let written = self.written_params(&cx, fun);
        let deref: ArenaSet[Span['k], 'k] = ArenaSet::new(&cx);
        self.deref.set(&cx, deref);
        let prologue: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
        let refs = self.by_ref.at(&cx, symbol);
        var p = 0usize;
        while p < entry.params.len(&cx) {
            let binding = entry.params.at(&cx, p);
            let ctype = self.c(&cx, self.substitute_type(&cx, binding.type));
            let place = binding.name.starts_with(&cx, Span::from_static(&cx, "&"));
            if ctype.is(&cx, "void") {
                cparams.push(&cx, CParam.{ ctype, cname: Span::from_static(&cx, ""), place });
            } else {
                let cname = self.cname(&cx, entry.label, binding.name);
                var passed = cname;
                if place {
                    place_c.insert(&cx, binding.name, Buffer!::new().push_static("(*").push_bytes(&cx, cname).push_static(")").save(&cx));
                } else if refs.at(&cx, p) && written.contains(&cx, binding.name) {
                    passed = allocate(&cx, Buffer!::new().push_bytes(&cx, cname).push_static("_ref").save(&cx), self.taken);
                    decls.push(&cx, Buffer!::new().push_bytes(&cx, ctype).push_static(" ").push_bytes(&cx, cname).push_static(";").save(&cx));
                    prologue.push(&cx, Buffer!::new().push_bytes(&cx, cname).push_static(" = *").push_bytes(&cx, passed).push_static(";").save(&cx));
                } else if refs.at(&cx, p) {
                    deref.insert(&cx, binding.name);
                }
                cparams.push(&cx, CParam.{ ctype, cname: passed, place });
            }
            p = p + 1usize;
        }
        let ret_type = self.substitute_type(&cx, fun.ret);
        let outs = self.outs.at(&cx, symbol);
        if outs.is_empty(&cx) {
            let unit = self.heads.insert(&cx, symbol, (self.c(&cx, ret_type), is_never(ret_type), cparams));
        } else {
            let elems = match self.shape(&cx, ret_type) {
                Type::Tuple(elems) => elems,
                _ => fail_text(&cx, Span::from_static(&cx, "internal error: out pointers of a result that is not a tuple")),
            };
            let pointees: ArenaVec[(Span['k], Span['k]), 'k] = ArenaVec::new(&cx);
            var k = 0usize;
            while k < outs.len(&cx) {
                let ctype = self.c(&cx, elems.at(&cx, outs.at(&cx, k)));
                pointees.push(&cx, (ctype, allocate(&cx, Buffer!::new().push_static("out_").push_usize(outs.at(&cx, k)).save(&cx), self.taken)));
                k = k + 1usize;
            }
            self.out_params.insert(&cx, symbol, pointees);
            self.results.insert(&cx, symbol, ret_type);
            let unit = self.heads.insert(&cx, symbol, (self.c(&cx, self.reduced(&cx, ret_type, outs)), false, cparams));
        }
        self.at_out.set(&cx, ArenaSet::new(&cx));
        var l = 0usize;
        while l < fun.locals.len(&cx) {
            let binding = fun.locals.at(&cx, l);
            if !plan.forwarded.contains(&cx, binding.name) && !self.erased(&cx, self.substitute_type(&cx, binding.type)) {
                let cname = allocate(&cx, Buffer!::new().push_static("p_").push_bytes(&cx, self.readable(&cx, binding.name)).save(&cx), self.taken);
                place_c.insert(&cx, binding.name, cname);
                decls.push(&cx, Buffer!::new().push_bytes(&cx, self.c(&cx, self.substitute_type(&cx, binding.type))).push_static(" ").push_bytes(&cx, cname).push_static(";").save(&cx));
            }
            l = l + 1usize;
        }
        // Homing may add or change locals. Otherwise the map built for `homes` is still current.
        if has_homes {
            let roots: ArenaMap[Span['k], Type['k], 'k] = ArenaMap::new(&cx);
            var r = 0usize;
            while r < entry.params.len(&cx) {
                let binding = entry.params.at(&cx, r);
                if binding.name.starts_with(&cx, Span::from_static(&cx, "&")) {
                    roots.insert(&cx, binding.name, self.substitute_type(&cx, binding.type));
                }
                r = r + 1usize;
            }
            var o = 0usize;
            while o < fun.locals.len(&cx) {
                roots.insert(&cx, fun.locals.at(&cx, o).name, self.substitute_type(&cx, fun.locals.at(&cx, o).type));
                o = o + 1usize;
            }
            self.roots.set(&cx, roots);
        }
        self.typed.set(&cx, typed);
        // (block label, SSA name, type, C variable) of each value that is no entry parameter
        let values: ArenaVec[(Span['k], Span['k], Type['k], Span['k]), 'k] = ArenaVec::new(&cx);
        let keys = typed.keys(&cx);
        var v = 0usize;
        while v < keys.len(&cx) {
            let (label, name) = keys.at(&cx, v);
            let ty = typed.at(&cx, keys.at(&cx, v));
            var parameter = false;
            if label.eq(&cx, entry.label) {
                var q = 0usize;
                while q < entry.params.len(&cx) {
                    if entry.params.at(&cx, q).name.eq(&cx, name) {
                        parameter = true;
                    }
                    q = q + 1usize;
                }
            }
            if !parameter && !self.record_erasure(&cx, label, name, ty) {
                values.push(&cx, (label, name, ty, self.cname(&cx, label, name)));
            }
            v = v + 1usize;
        }
        let blocks: ArenaMap[Span['k], Block['k], 'k] = ArenaMap::new(&cx);
        var k = 0usize;
        while k < fun.blocks.len(&cx) {
            blocks.insert(&cx, fun.blocks.at(&cx, k).label, fun.blocks.at(&cx, k));
            k = k + 1usize;
        }
        self.blocks.set(&cx, blocks);
        self.returning.set(&cx, false);
        self.out_paths.set(&cx, ArenaVec::new(&cx));
        // The lines of the body, after the declarations that emitting them may add to.
        var lines = Buffer!::new();
        var pr = 0usize;
        while pr < prologue.len(&cx) {
            line(&lines, Buffer!::new().push_bytes(&cx, prologue.at(&cx, pr)));
            pr = pr + 1usize;
        }
        var e = 0usize;
        while e < plan.emitted.len(&cx) {
            let block = plan.emitted.at(&cx, e);
            self.label.set(&cx, block.label);
            line(&lines, Buffer!::new().push_bytes(&cx, labels.at(&cx, block.label)).push_static(": ;"));
            let tail = plan.tail_call(&cx, block);
            let count = if tail { block.instrs.len(&cx) - 1usize } else { block.instrs.len(&cx) };
            var i = 0usize;
            while i < count {
                self.index.set(&cx, i);
                self.instr(&cx, &lines, block.instrs.at(&cx, i));
                i = i + 1usize;
            }
            self.index.set(&cx, count);
            if !tail || !self.tail_call(&cx, &lines, block.instrs.at(&cx, count)) {
                if tail {
                    self.returning.set(&cx, true);
                    self.instr(&cx, &lines, block.instrs.at(&cx, count));
                    self.returning.set(&cx, false);
                }
                self.term(&cx, &lines, block.term);
            }
            e = e + 1usize;
        }
        var w = 0usize;
        while w < values.len(&cx) {
            let (label, name, ty, cname) = values.at(&cx, w);
            if plan.variables.contains(&cx, (label, name)) {
                decls.push(&cx, Buffer!::new().push_bytes(&cx, self.c(&cx, self.substitute_type(&cx, ty))).push_static(" ").push_bytes(&cx, cname).push_static(";").save(&cx));
            }
            w = w + 1usize;
        }
        decls.append(&cx, temps);
        var body = Buffer!::new().push_static(" {\n");
        var d = 0usize;
        while d < decls.len(&cx) {
            body = body.push_static("  ").push_bytes(&cx, decls.at(&cx, d)).push_static("\n");
            d = d + 1usize;
        }
        self.emitted.push(&cx, (Option::Some.(symbol), Span::from_static(&cx, ""), body.push_buffer(lines).push_static("}\n").save(&cx), module_file(&cx, fun.name)));
    }

    // The local places that share the storage of a place path; `Backend.homes` in cgen.py states the
    // rules. `Plan` decides the rest on the function with their paths rewritten (`homed`).
    fn homes(self, &cx: Domain!['k], key: FunKey['k], fun: Fun['k], typed: ArenaMap[(Span['k], Span['k]), Type['k], 'k], plan: Plan['k]) -> ArenaMap[Span['k], Span['k], 'k] {
        let kinds: ArenaMap[Span['k], Kind, 'k] = ArenaMap::new(&cx);
        let quantified = self.instance_params.get_or(&cx, key, fun.params);
        var q = 0usize;
        while q < quantified.len(&cx) {
            kinds.insert(&cx, quantified.at(&cx, q).name, quantified.at(&cx, q).kind);
            q = q + 1usize;
        }
        let local_names: ArenaSet[Span['k], 'k] = ArenaSet::new(&cx);
        var n = 0usize;
        while n < fun.locals.len(&cx) {
            local_names.insert(&cx, fun.locals.at(&cx, n).name);
            n = n + 1usize;
        }
        // local -> the one path every whole store into it stores a value lying at, or none
        let seen: ArenaMap[Span['k], Option[Span['k]], 'k] = ArenaMap::new(&cx);
        var b = 0usize;
        while b < fun.blocks.len(&cx) {
            let block = fun.blocks.at(&cx, b);
            var i = 0usize;
            while i < block.instrs.len(&cx) {
                let instr = block.instrs.at(&cx, i);
                let a = instr.args;
                // A forwarded place has no storage to share.
                if instr.op.is(&cx, "store") && !plan.forwarded.contains(&cx, a.at(&cx, 0usize))
                    && (seen.contains(&cx, a.at(&cx, 0usize)) || local_names.contains(&cx, a.at(&cx, 0usize))) {
                    let local = a.at(&cx, 0usize);
                    let lying = plan.resident.get(&cx, (block.label, a.at(&cx, 1usize)));
                    let path = match lying {
                        Option::Some(at) => at,
                        Option::None => Span::from_static(&cx, ""),
                    };
                    let clash = match seen.get(&cx, local) {
                        Option::Some(known) => match known {
                            Option::Some(other) => !other.eq(&cx, path),
                            Option::None => true,
                        },
                        Option::None => false,
                    };
                    let bad = lying.is_none() || !path.starts_with(&cx, Span::from_static(&cx, "&")) || clash;
                    if bad {
                        seen.insert(&cx, local, Option::None);
                    } else {
                        seen.insert(&cx, local, plan.resident.get(&cx, (block.label, a.at(&cx, 1usize))));
                    }
                }
                i = i + 1usize;
            }
            b = b + 1usize;
        }
        let first: ArenaMap[Span['k], Span['k], 'k] = ArenaMap::new(&cx);
        var s = 0usize;
        while s < seen.positions(&cx) {
            match seen.key_at(&cx, s) {
                Option::Some(local) => match seen.at(&cx, local) {
                    Option::Some(path) => if !plan.forwarded.contains(&cx, local) && !plan.forwarded.contains(&cx, root(&cx, path))
                        && !root(&cx, path).eq(&cx, local) {
                        first.insert(&cx, local, path);
                    },
                    Option::None => (),
                },
                Option::None => (),
            };
            s = s + 1usize;
        }
        let found: ArenaMap[Span['k], Span['k], 'k] = ArenaMap::new(&cx);
        var f = 0usize;
        while f < first.positions(&cx) {
            match first.key_at(&cx, f) {
                Option::Some(local) => {
                    let path = first.at(&cx, local);
                    var fits = !first.contains(&cx, root(&cx, path));
                    var o = 0usize;
                    while fits && o < first.positions(&cx) {
                        match first.key_at(&cx, o) {
                            Option::Some(other) => if !other.eq(&cx, local) && overlap(&cx, path, first.at(&cx, other)) {
                                fits = false;
                            },
                            Option::None => (),
                        };
                        o = o + 1usize;
                    }
                    let root_type = self.roots.copy(&cx).at(&cx, local);
                    fits = fits && !self.erased(&cx, root_type);
                    if fits {
                        let (_expr, there) = self.place(&cx, path);
                        fits = same(&cx, erase(&cx, root_type, self.types), erase(&cx, there, self.types));
                    }
                    if fits {
                        found.insert(&cx, local, path);
                    }
                },
                Option::None => (),
            };
            f = f + 1usize;
        }
        if found.is_empty(&cx) {
            return found;
        }
        // A local whose contents C reads as a value stays a variable: each whole load of it is moved
        // back to the path alone, and nothing reads part of it but a lend.
        var k = 0usize;
        while k < fun.blocks.len(&cx) {
            let block = fun.blocks.at(&cx, k);
            let count = block.instrs.len(&cx);
            let reads: ArenaMap[Span['k], ArenaVec[usize, 'k], 'k] = ArenaMap::new(&cx);
            var i = 0usize;
            while i < count {
                let args = block.instrs.at(&cx, i).args;
                var g = 0usize;
                while g < args.len(&cx) {
                    match value_read(&cx, args.at(&cx, g)) {
                        Option::Some(v) => read_at(&cx, reads, v, i),
                        Option::None => (),
                    };
                    g = g + 1usize;
                }
                i = i + 1usize;
            }
            let ending = term_reads(&cx, block.term);
            let edges = term_edges(&cx, block.term);
            var e = 0usize;
            while e < edges.len(&cx) {
                let (edge, _skip) = edges.at(&cx, e);
                ending.append(&cx, edge.args);
                e = e + 1usize;
            }
            var t = 0usize;
            while t < ending.len(&cx) {
                read_at(&cx, reads, ending.at(&cx, t), count);
                t = t + 1usize;
            }
            var j = 0usize;
            while j < count {
                let instr = block.instrs.at(&cx, j);
                let a = instr.args;
                var g = 0usize;
                while g < a.len(&cx) {
                    let arg = a.at(&cx, g);
                    let local = if is_place(&cx, arg) { root(&cx, arg) } else { Span::from_static(&cx, "") };
                    let call = instr.op.is(&cx, "call") || instr.op.is(&cx, "trait_call");
                    let skip = !found.contains(&cx, local) || (call || instr.op.is(&cx, "store")) && !arg.eq(&cx, local)
                        || instr.op.is(&cx, "store") && g == 0usize;
                    if !skip {
                        var back = instr.op.is(&cx, "load") && arg.eq(&cx, local) && reads_once(&cx, reads, instr.lhs.at(&cx, 0usize));
                        if back {
                            var value = instr.lhs.at(&cx, 0usize);
                            var at = reads.at(&cx, value).at(&cx, 0usize);
                            // A value waiting in a forwarded place is read where it is loaded again.
                            while at < count && block.instrs.at(&cx, at).op.is(&cx, "store") && plan.forwarded.contains(&cx, block.instrs.at(&cx, at).args.at(&cx, 0usize)) {
                                let waiting = block.instrs.at(&cx, at).args.at(&cx, 0usize);
                                var again = at + 1usize;
                                while !(block.instrs.at(&cx, again).op.is(&cx, "load") && block.instrs.at(&cx, again).args.len(&cx) == 1usize
                                    && block.instrs.at(&cx, again).args.at(&cx, 0usize).eq(&cx, waiting)) {
                                    again = again + 1usize;
                                }
                                value = block.instrs.at(&cx, again).lhs.at(&cx, 0usize);
                                at = if reads_once(&cx, reads, value) { reads.at(&cx, value).at(&cx, 0usize) } else { count + 1usize };
                            }
                            let home = found.at(&cx, local);
                            back = if at < count {
                                let user = block.instrs.at(&cx, at);
                                if user.op.is(&cx, "store") {
                                    user.args.len(&cx) == 2usize && user.args.at(&cx, 0usize).eq(&cx, home) && user.args.at(&cx, 1usize).eq(&cx, value)
                                } else if user.op.is(&cx, "construct") && plan.fused.contains(&cx, (block.label, at)) {
                                    let target = block.instrs.at(&cx, at + 1usize).args.at(&cx, 0usize);
                                    let parts = match self.labels_of(&cx, self.type_operand(&cx, user)) {
                                        Option::Some(found_parts) => found_parts,
                                        Option::None => ArenaVec::new(&cx),
                                    };
                                    var hit = false;
                                    var p = 0usize;
                                    while !hit && p < user.args.len(&cx) && p < parts.len(&cx) {
                                        hit = user.args.at(&cx, p).eq(&cx, value) && is_member(&cx, home, target, parts.at(&cx, p));
                                        p = p + 1usize;
                                    }
                                    hit
                                } else {
                                    false
                                }
                            } else {
                                false
                            };
                        }
                        if !back && !call {
                            found.remove(&cx, local);
                        }
                    }
                    g = g + 1usize;
                }
                j = j + 1usize;
            }
            match block.term {
                Terminator::Switch(scrutinee, _ty, _arms, _pos) => if scrutinee.starts_with(&cx, Span::from_static(&cx, "&")) {
                    found.remove(&cx, root(&cx, scrutinee));
                },
                _ => (),
            };
            k = k + 1usize;
        }
        let blocks: ArenaMap[Span['k], Block['k], 'k] = ArenaMap::new(&cx);
        var r = 0usize;
        while r < fun.blocks.len(&cx) {
            blocks.insert(&cx, fun.blocks.at(&cx, r).label, fun.blocks.at(&cx, r));
            r = r + 1usize;
        }
        let out: ArenaMap[Span['k], Span['k], 'k] = ArenaMap::new(&cx);
        if found.is_empty(&cx) {
            return out;
        }
        // block -> the blocks reachable from its successors
        let reach: ArenaMap[Span['k], ArenaSet[Span['k], 'k], 'k] = ArenaMap::new(&cx);
        var u = 0usize;
        while u < fun.blocks.len(&cx) {
            let block = fun.blocks.at(&cx, u);
            let reached: ArenaSet[Span['k], 'k] = ArenaSet::new(&cx);
            let todo: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
            let edges = term_edges(&cx, block.term);
            var e = 0usize;
            while e < edges.len(&cx) {
                let (edge, _skip) = edges.at(&cx, e);
                todo.push(&cx, edge.target);
                e = e + 1usize;
            }
            while !todo.is_empty(&cx) {
                let label = todo.at(&cx, todo.len(&cx) - 1usize);
                let popped = todo.pop(&cx);
                if reached.insert(&cx, label) {
                    let next = term_edges(&cx, blocks.at(&cx, label).term);
                    var x = 0usize;
                    while x < next.len(&cx) {
                        let (edge, _skip) = next.at(&cx, x);
                        todo.push(&cx, edge.target);
                        x = x + 1usize;
                    }
                }
            }
            reach.insert(&cx, block.label, reached);
            u = u + 1usize;
        }
        var h = 0usize;
        while h < found.positions(&cx) {
            match found.key_at(&cx, h) {
                Option::Some(local) => {
                    let path = found.at(&cx, local);
                    var fits = true;
                    var w = 0usize;
                    while w < fun.blocks.len(&cx) {
                        let block = fun.blocks.at(&cx, w);
                        // Every local place is empty where the function starts.
                        let empty: ArenaSet[Span['k], 'k] = ArenaSet::new(&cx);
                        var z = 0usize;
                        while z < block.empty.len(&cx) {
                            empty.insert(&cx, block.empty.at(&cx, z));
                            z = z + 1usize;
                        }
                        if w == 0usize {
                            var y = 0usize;
                            while y < fun.locals.len(&cx) {
                                empty.insert(&cx, fun.locals.at(&cx, y).name);
                                y = y + 1usize;
                            }
                        }
                        fits = fits && apart(&cx, empty, local, path, block, 0usize, blocks, reach);
                        var i = 0usize;
                        while fits && i < block.instrs.len(&cx) {
                            let instr = block.instrs.at(&cx, i);
                            let a = instr.args;
                            if instr.op.is(&cx, "load") && is_place(&cx, a.at(&cx, 0usize)) {
                                if !self.types.is_copy(&cx, typed.at(&cx, (block.label, instr.lhs.at(&cx, 0usize))), kinds) {
                                    empty.insert(&cx, a.at(&cx, 0usize));
                                }
                            } else if instr.op.is(&cx, "destruct") && a.at(&cx, 0usize).starts_with(&cx, Span::from_static(&cx, "&")) {
                                let ty = match instr.ty {
                                    Option::Some(t) => t,
                                    Option::None => fail_text(&cx, Span::from_static(&cx, "internal error: a destruct without a type")),
                                };
                                if !self.types.is_copy(&cx, ty, kinds) {
                                    empty.insert(&cx, a.at(&cx, 0usize));
                                }
                            } else if instr.op.is(&cx, "store") {
                                let kept: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
                                var m = 0usize;
                                while m < empty.positions(&cx) {
                                    match empty.key_at(&cx, m) {
                                        Option::Some(e) => if overlap(&cx, e, a.at(&cx, 0usize)) {
                                            kept.push(&cx, e);
                                        },
                                        Option::None => (),
                                    };
                                    m = m + 1usize;
                                }
                                var x = 0usize;
                                while x < kept.len(&cx) {
                                    empty.remove(&cx, kept.at(&cx, x));
                                    x = x + 1usize;
                                }
                            }
                            fits = apart(&cx, empty, local, path, block, i + 1usize, blocks, reach);
                            i = i + 1usize;
                        }
                        w = w + 1usize;
                    }
                    if fits {
                        out.insert(&cx, local, path);
                    }
                },
                Option::None => (),
            };
            h = h + 1usize;
        }
        out
    }

    // The labels of a struct's or tuple's components in a place path; none for other types.
    fn labels_of(self, &cx: Domain!['k], ty: Type['k]) -> Option[ArenaVec[Span['k], 'k]] {
        let out: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
        match self.shape(&cx, ty) {
            Type::Struct(fields) => {
                var f = 0usize;
                while f < fields.len(&cx) {
                    out.push(&cx, fields.at(&cx, f).name);
                    f = f + 1usize;
                }
                Option::Some.(out)
            },
            Type::Tuple(elems) => {
                var e = 0usize;
                while e < elems.len(&cx) {
                    out.push(&cx, Buffer!::new().push_usize(e).save(&cx));
                    e = e + 1usize;
                }
                Option::Some.(out)
            },
            _ => Option::None,
        }
    }

    // The lend adapter `name` is, by its shape alone: one block that stores some of its value
    // parameters into its local places, one apiece, makes one call lending each place, and returns
    // the places reloaded and the call's result as a tuple, or never returns.
    fn adapter(self, &cx: Domain!['k], name: Span['k]) -> Option[(Adapter['k], Fun['k])] {
        match self.adapters.get(&cx, name) {
            Option::Some(known) => return known,
            Option::None => (),
        };
        let found = self.adapter_shape(&cx, self.program.funs.at(&cx, name));
        self.adapters.insert(&cx, name, found);
        found
    }

    fn adapter_shape(self, &cx: Domain!['k], fun: Fun['k]) -> Option[(Adapter['k], Fun['k])] {
        let block = fun.blocks.at(&cx, 0usize);
        let k = fun.locals.len(&cx);
        let instrs = block.instrs;
        if fun.blocks.len(&cx) != 1usize || k == 0usize || instrs.len(&cx) < k + 1usize {
            return Option::None;
        }
        let names: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
        var n = 0usize;
        while n < block.params.len(&cx) {
            names.push(&cx, block.params.at(&cx, n).name);
            n = n + 1usize;
        }
        let call = instrs.at(&cx, k);
        let borrowed: ArenaVec[usize, 'k] = ArenaVec::new(&cx);
        var i = 0usize;
        while i < k {
            let store = instrs.at(&cx, i);
            let slot = fun.locals.at(&cx, i).name;
            if !store.op.is(&cx, "store") || !store.args.at(&cx, 0usize).eq(&cx, slot)
                || !store.args.at(&cx, 1usize).starts_with(&cx, Span::from_static(&cx, "%")) {
                return Option::None;
            }
            match names.index_of(&cx, store.args.at(&cx, 1usize)) {
                Option::Some(at) => borrowed.push(&cx, at),
                Option::None => return Option::None,
            };
            i = i + 1usize;
        }
        if !(call.op.is(&cx, "call") || call.op.is(&cx, "trait_call")) || call.lhs.len(&cx) != 1usize {
            return Option::None;
        }
        var l = 0usize;
        while l < k {
            let slot = fun.locals.at(&cx, l).name;
            var uses = 0usize;
            var g = 0usize;
            while g < call.args.len(&cx) {
                if call.args.at(&cx, g).eq(&cx, slot) {
                    uses = uses + 1usize;
                }
                g = g + 1usize;
            }
            if uses != 1usize {
                return Option::None;
            }
            l = l + 1usize;
        }
        let rest = instrs.len(&cx) - k - 1usize;
        match block.term {
            Terminator::Unreachable(_pos) => if rest == 0usize {
                return Option::Some.((Adapter.{ borrowed, returns: false }, fun));
            },
            Terminator::Ret(value, _pos) => if rest == k + 1usize {
                let made = instrs.at(&cx, k + 1usize + k);
                if !made.op.is(&cx, "construct") || made.args.len(&cx) != k + 1usize || !made.args.at(&cx, k).eq(&cx, call.lhs.at(&cx, 0usize))
                    || !value.eq(&cx, made.lhs.at(&cx, 0usize)) {
                    return Option::None;
                }
                var r = 0usize;
                while r < k {
                    let load = instrs.at(&cx, k + 1usize + r);
                    if !load.op.is(&cx, "load") || load.args.len(&cx) != 1usize || !load.args.at(&cx, 0usize).eq(&cx, fun.locals.at(&cx, r).name)
                        || !made.args.at(&cx, r).eq(&cx, load.lhs.at(&cx, 0usize)) {
                        return Option::None;
                    }
                    r = r + 1usize;
                }
                return Option::Some.((Adapter.{ borrowed, returns: true }, fun));
            },
            _ => (),
        };
        Option::None
    }

    // A function's head, with its place parameters qualified as `qualifiers` allows.
    fn head(self, &cx: Domain!['k], symbol: Span['k], const_params: ArenaSet[(Span['k], usize), 'k], restrict_params: ArenaSet[(Span['k], usize), 'k]) -> Span['k] {
        let (ret, noreturn, cparams) = self.heads.at(&cx, symbol);
        let params: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
        var k = 0usize;
        while k < cparams.len(&cx) {
            let cp = cparams.at(&cx, k);
            if !cp.ctype.is(&cx, "void") {
                var t = Buffer!::new().push_bytes(&cx, cp.ctype);
                if cp.place {
                    if const_params.contains(&cx, (symbol, k)) {
                        t = t.push_static(" const");
                    }
                    t = t.push_static("*");
                    if restrict_params.contains(&cx, (symbol, k)) {
                        t = t.push_static(" restrict");
                    }
                } else if self.by_ref.at(&cx, symbol).at(&cx, k) {
                    t = t.push_static(" const*");
                }
                params.push(&cx, t.push_static(" ").push_bytes(&cx, cp.cname).save(&cx));
            }
            k = k + 1usize;
        }
        let outs = self.out_pointers(&cx, symbol);
        var o = 0usize;
        while o < outs.len(&cx) {
            let (ctype, cname) = outs.at(&cx, o);
            params.push(&cx, Buffer!::new().push_bytes(&cx, ctype).push_static("* ").push_bytes(&cx, cname).save(&cx));
            o = o + 1usize;
        }
        Buffer!::new().push_static(if noreturn { "_Noreturn " } else { "" }).push_bytes(&cx, self.linkage).push_bytes(&cx, ret).push_static(" ").push_bytes(&cx, symbol)
            .push_static("(").push_bytes(&cx, or_void(&cx, params.join(&cx, ", "))).push_static(")").save(&cx)
    }

    fn the_plan(self, &cx: Domain!['k]) -> Plan['k] {
        match self.plan.copy(&cx) {
            Option::Some(plan) => plan,
            Option::None => fail_text(&cx, Span::from_static(&cx, "internal error: no function is being emitted")),
        }
    }

    fn substitute_type(self, &cx: Domain!['k], ty: Type['k]) -> Type['k] {
        let done = self.substituted.copy(&cx);
        match done.get(&cx, ty) {
            Option::Some(known) => return known,
            Option::None => (),
        }
        let before = self.counter.next.copy(&cx);
        let out = subst(&cx, ty, self.sub.copy(&cx), self.counter);
        if self.counter.next.copy(&cx) == before {
            done.insert(&cx, ty, out);
        }
        out
    }

    fn cname(self, &cx: Domain!['k], label: Span['k], name: Span['k]) -> Span['k] {
        let key = (label, name);
        let locals = self.locals.copy(&cx);
        match locals.get(&cx, key) {
            Option::Some(known) => known,
            Option::None => {
                let made = allocate(&cx, Buffer!::new().push_bytes(&cx, self.readable(&cx, label)).push_static("_").push_bytes(&cx, self.readable(&cx, name)).save(&cx), self.taken);
                locals.insert(&cx, key, made);
                made
            },
        }
    }

    // The C variable holding a value of the current block: its own, the one it reads, or the place it
    // lies in (`Plan`).
    fn value_name(self, &cx: Domain!['k], name: Span['k]) -> Span['k] {
        let plan = self.the_plan(&cx);
        let key = (self.label.copy(&cx), name);
        if !plan.resident.contains(&cx, key) && self.deref.copy(&cx).contains(&cx, name) && self.label.copy(&cx).eq(&cx, self.fun_entry_label(&cx)) {
            return Buffer!::new().push_static("(*").push_bytes(&cx, self.cname(&cx, self.label.copy(&cx), name)).push_static(")").save(&cx);
        }
        if !plan.moved.contains(&cx, key) {
            return match self.aliases.copy(&cx).get(&cx, key) {
                Option::Some(alias) => alias,
                Option::None => self.cname(&cx, self.label.copy(&cx), name),
            };
        }
        match plan.resident.get(&cx, key) {
            Option::Some(path) => {
                let (expr, _ty) = self.place(&cx, path);
                return expr;
            },
            Option::None => (),
        };
        match plan.shared.get(&cx, key) {
            Option::Some(found) => {
                let (block, param) = found;
                return self.cname(&cx, block, param);
            },
            Option::None => (),
        };
        match plan.arrived.get(&cx, key) {
            Option::Some(found) => {
                let (block, scrutinee, variant) = found;
                let here = self.label.copy(&cx);
                self.label.set(&cx, block);
                let source = self.value_name(&cx, scrutinee);
                let ty = self.type_of(&cx, scrutinee);
                self.label.set(&cx, here);
                return self.payload(&cx, source, ty, variant);
            },
            Option::None => (),
        };
        match self.aliases.copy(&cx).get(&cx, (self.label.copy(&cx), name)) {
            Option::Some(alias) => alias,
            Option::None => self.cname(&cx, self.label.copy(&cx), name),
        }
    }

    // The C variable an assignment from `name` reads: for a value lying in a place under a place
    // parameter, the parameter's pointer, which a self tail call may assign.
    fn value_base(self, &cx: Domain!['k], name: Span['k]) -> Span['k] {
        match self.the_plan(&cx).resident.get(&cx, (self.label.copy(&cx), name)) {
            Option::Some(path) => {
                let r = root(&cx, path);
                if path.starts_with(&cx, Span::from_static(&cx, "%")) {
                    self.cname(&cx, self.label.copy(&cx), r)
                } else if self.param_index(&cx, r).is_some() {
                    self.cname(&cx, self.fun_entry_label(&cx), r)
                } else {
                    self.place_c.copy(&cx).at(&cx, r)
                }
            },
            Option::None => match self.the_plan(&cx).arrived.get(&cx, (self.label.copy(&cx), name)) {
                Option::Some(found) => {
                    let (block, scrutinee, _variant) = found;
                    let here = self.label.copy(&cx);
                    self.label.set(&cx, block);
                    let base = self.value_base(&cx, scrutinee);
                    self.label.set(&cx, here);
                    base
                },
                Option::None => self.value_name(&cx, name),
            },
        }
    }

    fn fun_entry_label(self, &cx: Domain!['k]) -> Span['k] {
        match self.fun.copy(&cx) {
            Option::Some(fun) => fun.blocks.at(&cx, 0usize).label,
            Option::None => fail_text(&cx, Span::from_static(&cx, "internal error: no function is being emitted")),
        }
    }

    fn is_live(self, &cx: Domain!['k], name: Span['k]) -> bool {
        self.the_plan(&cx).is_live(&cx, self.label.copy(&cx), name)
    }

    // Whether the value `name` of the current block has a zero-size type: `erased(type_of(name))`.
    fn value_erased(self, &cx: Domain!['k], name: Span['k]) -> bool {
        self.value_erased_in(&cx, self.label.copy(&cx), name)
    }

    // Whether the value `name` of block `label` has a zero-size type, kept for the function being
    // emitted once finding it drew no fresh name.
    fn value_erased_in(self, &cx: Domain!['k], label: Span['k], name: Span['k]) -> bool {
        let known = self.erasure.copy(&cx);
        match known.get(&cx, (label, name)) {
            Option::Some(answer) => answer,
            Option::None => self.record_erasure(&cx, label, name, self.typed.copy(&cx).at(&cx, (label, name))),
        }
    }

    // Record erasure using a type the caller already has, without another lookup in `typed`.
    fn record_erasure(self, &cx: Domain!['k], label: Span['k], name: Span['k], ty: Type['k]) -> bool {
        let before = self.counter.next.copy(&cx);
        let answer = self.erased(&cx, self.substitute_type(&cx, ty));
        if self.counter.next.copy(&cx) == before {
            self.erasure.copy(&cx).insert(&cx, (label, name), answer);
        }
        answer
    }

    fn type_of(self, &cx: Domain!['k], name: Span['k]) -> Type['k] {
        self.substitute_type(&cx, self.typed.copy(&cx).at(&cx, (self.label.copy(&cx), name)))
    }


    // ------------------------------------------------------------------- places --

    // The C lvalue and type of a place path, or of a path in the C variable of a value of the current
    // block (`%v.f`, lent as `&%v.f`; `Plan::residences`).
    fn place(self, &cx: Domain!['k], path: Span['k]) -> (Span['k], Type['k]) {
        let parts = path.split(&cx, Span::from_static(&cx, "."));
        let first = parts.at(&cx, 0usize);
        let in_value = first.starts_with(&cx, Span::from_static(&cx, "%")) || first.starts_with(&cx, Span::from_static(&cx, "&%"));
        let value = if first.starts_with(&cx, Span::from_static(&cx, "&")) { first.skip(1usize) } else { first };
        var expr = if in_value { self.value_name(&cx, value) } else { self.place_c.copy(&cx).get_or(&cx, first, Span::from_static(&cx, "")) };
        var ty = if in_value { self.type_of(&cx, value) } else { self.roots.copy(&cx).at(&cx, first) };
        var i = 1usize;
        while i < parts.len(&cx) {
            let seg = parts.at(&cx, i);
            ty = self.view(&cx, ty);
            let s = self.shape(&cx, ty);
            match s {
                Type::Enum(variants) => {
                    expr = self.payload(&cx, expr, ty, seg);
                    ty = last_member(&cx, variants, seg);
                },
                _ => {
                    let names: ArenaVec[Span['k], 'k] = match s {
                        Type::Struct(fields) => {
                            let out: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
                            var f = 0usize;
                            while f < fields.len(&cx) {
                                out.push(&cx, fields.at(&cx, f).name);
                                f = f + 1usize;
                            }
                            out
                        },
                        Type::Tuple(elems) => {
                            let out: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
                            var e = 0usize;
                            while e < elems.len(&cx) {
                                out.push(&cx, Buffer!::new().push_usize(e).save(&cx));
                                e = e + 1usize;
                            }
                            out
                        },
                        _ => fail_text(&cx, Span::from_static(&cx, "internal error: a place through a type that is not a product")),
                    };
                    let rows = self.members(&cx, s);
                    var found = false;
                    var k = names.len(&cx);
                    while !found && k > 0usize {
                        k = k - 1usize;
                        if names.at(&cx, k).eq(&cx, seg) {
                            let (m, t) = rows.at(&cx, k);
                            expr = Buffer!::new().push_bytes(&cx, expr).push_static(".").push_bytes(&cx, m).save(&cx);
                            ty = t;
                            found = true;
                        }
                    }
                    if !found {
                        fail_text(&cx, Span::from_static(&cx, "internal error: a place names no component"));
                    }
                },
            };
            i = i + 1usize;
        }
        (expr, ty)
    }

    // Opened views share the package's representation.
    fn view(self, &cx: Domain!['k], ty: Type['k]) -> Type['k] {
        match ty {
            Type::Exists(_binders, body) => body.copy(&cx),
            _ => ty,
        }
    }

    // A call argument: a value, a lent place's address, or a raw target.
    fn operand(self, &cx: Domain!['k], arg: Span['k]) -> Span['k] {
        if arg.starts_with(&cx, Span::from_static(&cx, "&*")) {
            return self.value_name(&cx, arg.skip(2usize));
        }
        if arg.starts_with(&cx, Span::from_static(&cx, "&")) {
            let (expr, _ty) = self.place(&cx, arg);
            return Buffer!::new().push_static("&").push_bytes(&cx, expr).save(&cx);
        }
        self.value_name(&cx, arg)
    }

    // ------------------------------------------------------------- instructions --

    fn instr(self, &cx: Domain!['k], &lines: Buffer!, instr: Instr['k]) {
        let op = instr.op;
        let a = instr.args;
        // A pure instruction is written when the C reads one of its results: one that is live and not
        // of a zero-size type (so never `static_brand`, `fresh`, nor `pack` and `open` of a place).
        if is_pure(&cx, op) {
            var read = false;
            var l = 0usize;
            while !read && l < instr.lhs.len(&cx) {
                let name = instr.lhs.at(&cx, l);
                read = self.is_live(&cx, name) && !self.value_erased(&cx, name);
                l = l + 1usize;
            }
            if !read {
                return;
            }
        }
        let plan = self.the_plan(&cx);
        let label = self.label.copy(&cx);
        let index = self.index.copy(&cx);
        let after_lend = index > 0usize && plan.in_place.contains(&cx, (label, index - 1usize));
        match plan.in_place.get(&cx, (label, index)) {
            Option::Some(paths) => {
                self.lend_in_place(&cx, &lines, instr, paths);
                return;
            },
            Option::None => (),
        };
        if plan.fused.contains(&cx, (label, index))
            || (op.is(&cx, "load") || op.is(&cx, "open") || op.is(&cx, "pack") || op.is(&cx, "construct")) && plan.resident.contains(&cx, (label, instr.lhs.at(&cx, 0usize))) {
            return;
        }
        if op.is(&cx, "destruct") && after_lend {
            self.handed_back(&cx, &lines, instr, plan.in_place.at(&cx, (label, index - 1usize)));
            return;
        }
        if plan.unwritten.contains(&cx, (label, index)) {
            return;
        }
        if op.is(&cx, "store") && index > 0usize && plan.fused.contains(&cx, (label, index - 1usize)) {
            self.store_in_place(&cx, &lines, a.at(&cx, 0usize), self.blocks.copy(&cx).at(&cx, label).instrs.at(&cx, index - 1usize));
            return;
        }
        // Store emission never uses its result, so it needs no C destination lookup.
        let dst = if !op.is(&cx, "store") && instr.lhs.len(&cx) == 1usize && !self.value_erased(&cx, instr.lhs.at(&cx, 0usize)) {
            Option::Some.(self.value_name(&cx, instr.lhs.at(&cx, 0usize)))
        } else {
            Option::None
        };
        // `None` where an instruction without one result would name it, as the f-strings print it.
        let d = match dst {
            Option::Some(t) => t,
            Option::None => Span::from_static(&cx, "None"),
        };
        if op.is(&cx, "const") {
            let lit = match instr.lit {
                Option::Some(l) => l,
                Option::None => Span::from_static(&cx, ""),
            };
            line(&lines, Buffer!::new().push_bytes(&cx, d).push_static(" = ").push_bytes(&cx, self.literal(&cx, self.type_operand_raw(&cx, instr), lit)).push_static(";"));
        } else if op.is(&cx, "copy") {
            let unit = self.aliases.copy(&cx).insert(&cx, (self.label.copy(&cx), instr.lhs.at(&cx, 0usize)), self.value_name(&cx, a.at(&cx, 0usize)));
        } else if op.is(&cx, "load") && plan.forwarded.contains(&cx, a.at(&cx, 0usize)) {
            let unit = self.aliases.copy(&cx).insert(&cx, (self.label.copy(&cx), instr.lhs.at(&cx, 0usize)), self.forwards.copy(&cx).at(&cx, a.at(&cx, 0usize)));
        } else if op.is(&cx, "store") && plan.forwarded.contains(&cx, a.at(&cx, 0usize)) {
            if !self.value_erased(&cx, a.at(&cx, 1usize)) {
                let unit = self.forwards.copy(&cx).insert(&cx, a.at(&cx, 0usize), self.value_name(&cx, a.at(&cx, 1usize)));
            }
        } else if op.is(&cx, "construct") {
            let ty = self.type_operand(&cx, instr);
            let away = self.away(&cx, instr.lhs.at(&cx, 0usize));
            self.construct(&cx, &lines, d, ty, a, away);
        } else if op.is(&cx, "destruct") {
            self.destruct(&cx, &lines, instr);
        } else if op.is(&cx, "construct_variant") {
            let lit = match instr.lit {
                Option::Some(l) => l,
                Option::None => Span::from_static(&cx, ""),
            };
            let ty = self.type_operand(&cx, instr);
            let variants = self.types.variants(&cx, erase(&cx, ty, self.types), Option::None);
            let payload = last_member(&cx, variants, lit);
            let value = if self.erased(&cx, payload) { Option::None } else { Option::Some.(self.value_name(&cx, a.at(&cx, 0usize))) };
            let statements = self.set_variant(&cx, d, ty, lit, value);
            var s = 0usize;
            while s < statements.len(&cx) {
                line(&lines, Buffer!::new().push_bytes(&cx, statements.at(&cx, s)));
                s = s + 1usize;
            }
        } else if op.is(&cx, "variant_tag") {
            let source = if a.at(&cx, 0usize).starts_with(&cx, Span::from_static(&cx, "&")) {
                let (expr, _ty) = self.place(&cx, a.at(&cx, 0usize));
                expr
            } else {
                self.value_name(&cx, a.at(&cx, 0usize))
            };
            line(&lines, Buffer!::new().push_bytes(&cx, d).push_static(" = ").push_bytes(&cx, self.tag(&cx, source, self.type_operand(&cx, instr))).push_static(";"));
        } else if op.is(&cx, "to_ptr") {
            line(&lines, Buffer!::new().push_bytes(&cx, d).push_static(" = ").push_bytes(&cx, self.value_name(&cx, a.at(&cx, 0usize))).push_static(";"));
        } else if op.is(&cx, "int_cast") {
            let value = self.value_name(&cx, a.at(&cx, 0usize));
            line(&lines, Buffer!::new().push_bytes(&cx, d).push_static(" = ").push_bytes(&cx, self.convert(&cx, value, self.type_operand(&cx, instr))).push_static(";"));
        } else if op.is(&cx, "float_cast") {
            let value = self.value_name(&cx, a.at(&cx, 0usize));
            let converted = self.float_convert(&cx, value, self.type_of(&cx, a.at(&cx, 0usize)), self.type_operand(&cx, instr));
            line(&lines, Buffer!::new().push_bytes(&cx, d).push_static(" = ").push_bytes(&cx, converted).push_static(";"));
        } else if op.is(&cx, "cast") {
            let value = self.value_name(&cx, a.at(&cx, 0usize));
            let src = self.type_of(&cx, a.at(&cx, 0usize));
            self.cast(&cx, &lines, d, value, src, self.type_operand(&cx, instr));
        } else if is_c_op(&cx, op) || op.is(&cx, "shl") || op.is(&cx, "shr") {
            self.primitive(&cx, &lines, d, op, a);
        } else if op.is(&cx, "call") {
            self.call(&cx, &lines, instr);
        } else if op.is(&cx, "trait_call") {
            self.trait_call(&cx, &lines, instr);
        } else if op.is(&cx, "fn") {
            line(&lines, Buffer!::new().push_bytes(&cx, d).push_static(" = ").push_bytes(&cx, self.function_address(&cx, instr)).push_static(";"));
        } else if op.is(&cx, "alloca") {
            let ct = self.c(&cx, self.type_operand(&cx, instr));
            // A zero-size type has no bytes to reserve: its pointer is any one that is not null, aligned
            // as `alignof` says (to 1).
            if ct.is(&cx, "void") {
                line(&lines, Buffer!::new().push_bytes(&cx, d).push_static(" = (void*)(uintptr_t)1;"));
            } else {
                line(&lines, Buffer!::new().push_bytes(&cx, d).push_static(" = (").push_bytes(&cx, ct).push_static("*)__builtin_alloca(sizeof(").push_bytes(&cx, ct).push_static("));"));
            }
        } else if op.is(&cx, "sizeof") {
            let ct = self.c(&cx, self.type_operand(&cx, instr));
            if ct.is(&cx, "void") {
                line(&lines, Buffer!::new().push_bytes(&cx, d).push_static(" = UINT64_C(0);"));
            } else {
                line(&lines, Buffer!::new().push_bytes(&cx, d).push_static(" = (uintptr_t)sizeof(").push_bytes(&cx, ct).push_static(");"));
            }
        } else if op.is(&cx, "data") {
            // The program's pointer is not `const`: no write reaches the static image (CONTRACTS.md).
            let ct = self.c(&cx, self.program.datas.at(&cx, a.at(&cx, 0usize)).ty);
            line(&lines, Buffer!::new().push_bytes(&cx, d).push_static(" = (").push_bytes(&cx, ct).push_static("*)&").push_bytes(&cx, self.data_symbol(&cx, a.at(&cx, 0usize))).push_static(";"));
        } else if op.is(&cx, "trap") {
            line(&lines, Buffer!::new().push_static("KUR_TRAP();"));
        } else if op.is(&cx, "pack") || op.is(&cx, "open") {
            line(&lines, Buffer!::new().push_bytes(&cx, d).push_static(" = ").push_bytes(&cx, self.value_name(&cx, a.at(&cx, 0usize))).push_static(";"));
        } else if (op.is(&cx, "ptr_load") || op.is(&cx, "ptr_load_volatile") || op.is(&cx, "ptr_store") || op.is(&cx, "ptr_store_volatile"))
                && self.erased(&cx, self.pointee(&cx, self.type_of(&cx, a.at(&cx, 0usize)))) {
            // a zero-size value is read and written nowhere
        } else if op.is(&cx, "ptr_load") {
            line(&lines, Buffer!::new().push_bytes(&cx, d).push_static(" = *").push_bytes(&cx, self.value_name(&cx, a.at(&cx, 0usize))).push_static(";"));
        } else if op.is(&cx, "ptr_load_volatile") {
            let ct = self.c(&cx, self.pointee(&cx, self.type_of(&cx, a.at(&cx, 0usize))));
            line(&lines, Buffer!::new().push_bytes(&cx, d).push_static(" = *(").push_bytes(&cx, ct).push_static(" volatile*)").push_bytes(&cx, self.value_name(&cx, a.at(&cx, 0usize))).push_static(";"));
        } else if op.is(&cx, "ptr_store") || op.is(&cx, "ptr_store_volatile") {
            let inner = self.pointee(&cx, self.type_of(&cx, a.at(&cx, 0usize)));
            let qual = if op.ends_with(&cx, Span::from_static(&cx, "volatile")) { Buffer!::new().push_static("(").push_bytes(&cx, self.c(&cx, inner)).push_static(" volatile*)").save(&cx) } else { Span::from_static(&cx, "") };
            let target = self.value_name(&cx, a.at(&cx, 0usize));
            line(&lines, Buffer!::new().push_static("*").push_bytes(&cx, qual).push_bytes(&cx, target).push_static(" = ").push_bytes(&cx, self.value_name(&cx, a.at(&cx, 1usize))).push_static(";"));
        } else if C::atomic_kind(&cx, op).is_some() {
            self.atomic(&cx, &lines, instr, dst);
        } else if op.is(&cx, "load") {
            let (expr, _ty) = self.place(&cx, a.at(&cx, 0usize));
            line(&lines, Buffer!::new().push_bytes(&cx, d).push_static(" = ").push_bytes(&cx, expr).push_static(";"));
        } else if op.is(&cx, "store") {
            let (expr, ty) = self.place(&cx, a.at(&cx, 0usize));
            if !self.erased(&cx, ty) {
                match self.param_index(&cx, root(&cx, a.at(&cx, 0usize))) {
                    Option::Some(j) => {
                        let added = self.written.insert(&cx, (self.symbol.copy(&cx), j));
                    },
                    Option::None => (),
                };
                line(&lines, Buffer!::new().push_bytes(&cx, expr).push_static(" = ").push_bytes(&cx, self.value_name(&cx, a.at(&cx, 1usize))).push_static(";"));
            }
        } else if op.is(&cx, "foreach") {
            self.foreach_instr(&cx, &lines, instr, d);
        } else {
            fail_text(&cx, Buffer!::new().push_static("no C recipe for ").push_bytes(&cx, op).save(&cx));
        }
    }

    fn pointee(self, &cx: Domain!['k], pointer: Type['k]) -> Type['k] {
        match pointer {
            Type::Ptr(inner) => inner.copy(&cx),
            _ => fail_text(&cx, Span::from_static(&cx, "internal error: a pointer operation on a value that is not a pointer")),
        }
    }

    fn type_operand_raw(self, &cx: Domain!['k], instr: Instr['k]) -> Type['k] {
        match instr.ty {
            Option::Some(t) => t,
            Option::None => fail_text(&cx, Span::from_static(&cx, "internal error: an instruction without its type")),
        }
    }

    fn type_operand(self, &cx: Domain!['k], instr: Instr['k]) -> Type['k] {
        self.substitute_type(&cx, self.type_operand_raw(&cx, instr))
    }

    // Assigns each component to its member of `dst`, but the components `away` sends elsewhere: to a
    // place path where a homed component ends up, or through an out pointer (`*out`), after the others.
    fn construct(self, &cx: Domain!['k], &lines: Buffer!, dst: Span['k], ty: Type['k], args: ArenaVec[Span['k], 'k], away: ArenaVec[(usize, Span['k]), 'k]) {
        let s = self.shape(&cx, ty);
        match s {
            Type::Array(_elem, length) => {
                var k = 0u64;
                while k < length {
                    let at = if (k as usize) < args.len(&cx) - 1usize { k as usize } else { args.len(&cx) - 1usize };
                    line(&lines, Buffer!::new().push_bytes(&cx, dst).push_static(".items[").push_u64(k).push_static("] = ").push_bytes(&cx, self.value_name(&cx, args.at(&cx, at))).push_static(";"));
                    k = k + 1u64;
                }
            },
            _ => {
                let rows = self.members(&cx, s);
                var i = 0usize;
                while i < rows.len(&cx) && i < args.len(&cx) {
                    let (m, t) = rows.at(&cx, i);
                    if !self.erased(&cx, t) && home_of(&cx, away, i).is_none() {
                        line(&lines, Buffer!::new().push_bytes(&cx, dst).push_static(".").push_bytes(&cx, m).push_static(" = ").push_bytes(&cx, self.value_name(&cx, args.at(&cx, i))).push_static(";"));
                    }
                    i = i + 1usize;
                }
                var w = 0usize;
                while w < away.len(&cx) {
                    let (k, target) = away.at(&cx, w);
                    if target.starts_with(&cx, Span::from_static(&cx, "*")) {
                        line(&lines, Buffer!::new().push_bytes(&cx, target).push_static(" = ").push_bytes(&cx, self.value_name(&cx, args.at(&cx, k))).push_static(";"));
                    } else {
                        let value = self.value_name(&cx, args.at(&cx, k));
                        self.write_home(&cx, &lines, target, value, Span::from_static(&cx, ""));
                    }
                    w = w + 1usize;
                }
            },
        };
    }

    // Where the components of the value `name` that a construction or a call makes go instead of its
    // variable (`away` in cgen.py): the homed ones of a value shared into a homed parameter to their
    // place paths; when the function writes elements of its result through out pointers, and the
    // value is returned and read nothing else, those elements to `*out` (then marked as there).
    fn away(self, &cx: Domain!['k], name: Span['k]) -> ArenaVec[(usize, Span['k]), 'k] {
        let plan = self.the_plan(&cx);
        let label = self.label.copy(&cx);
        let key = (label, name);
        if plan.made_home.contains(&cx, key) {
            return plan.homed.at(&cx, plan.shared.at(&cx, key));
        }
        let away: ArenaVec[(usize, Span['k]), 'k] = ArenaVec::new(&cx);
        let symbol = self.symbol.copy(&cx);
        let outs = self.out_pointers(&cx, symbol);
        if outs.is_empty(&cx) || !self.returned_alone(&cx, name) {
            return away;
        }
        let ks = self.outs.at(&cx, symbol);
        var k = 0usize;
        while k < ks.len(&cx) {
            let added = self.at_out.copy(&cx).insert(&cx, (label, name, ks.at(&cx, k)));
            k = k + 1usize;
        }
        var o = 0usize;
        while o < ks.len(&cx) && o < outs.len(&cx) {
            let (_ctype, cname) = outs.at(&cx, o);
            away.push(&cx, (ks.at(&cx, o), Buffer!::new().push_static("*").push_bytes(&cx, cname).save(&cx)));
            o = o + 1usize;
        }
        away
    }

    // The value `name` of the current block is what it returns, directly or through return joins, and
    // the block reads it nowhere else.
    fn returned_alone(self, &cx: Domain!['k], name: Span['k]) -> bool {
        let plan = self.the_plan(&cx);
        let block = self.blocks.copy(&cx).at(&cx, self.label.copy(&cx));
        let returned = match block.term {
            Terminator::Ret(value, _pos) => value,
            Terminator::Jmp(edge, _pos) => match plan.return_index.get(&cx, edge.target) {
                Option::Some(index) => edge.args.at(&cx, index),
                Option::None => return false,
            },
            _ => return false,
        };
        if !returned.eq(&cx, name) {
            return false;
        }
        var count = 0usize;
        var i = 0usize;
        while i < block.instrs.len(&cx) {
            let args = block.instrs.at(&cx, i).args;
            var g = 0usize;
            while g < args.len(&cx) {
                match value_read(&cx, args.at(&cx, g)) {
                    Option::Some(v) => if v.eq(&cx, name) {
                        count = count + 1usize;
                    },
                    Option::None => (),
                };
                g = g + 1usize;
            }
            i = i + 1usize;
        }
        let ending = term_reads(&cx, block.term);
        let edges = term_edges(&cx, block.term);
        var e = 0usize;
        while e < edges.len(&cx) {
            let (edge, _skip) = edges.at(&cx, e);
            ending.append(&cx, edge.args);
            e = e + 1usize;
        }
        var t = 0usize;
        while t < ending.len(&cx) {
            if ending.at(&cx, t).eq(&cx, name) {
                count = count + 1usize;
            }
            t = t + 1usize;
        }
        count == 1usize
    }

    // Writes `value` at the place path `path` where a homed component ends up, unless it lies there.
    fn write_home(self, &cx: Domain!['k], &lines: Buffer!, path: Span['k], value: Span['k], indent: Span['k]) {
        let (target, _ty) = self.place(&cx, path);
        if !target.eq(&cx, value) {
            match self.param_index(&cx, root(&cx, path)) {
                Option::Some(j) => {
                    let added = self.written.insert(&cx, (self.symbol.copy(&cx), j));
                },
                Option::None => (),
            };
            line(&lines, Buffer!::new().push_bytes(&cx, indent).push_bytes(&cx, target).push_static(" = ").push_bytes(&cx, value).push_static(";"));
        }
    }

    // Returns the value `value` (of the SSA value `name`, or none: `""`): each element written
    // through an out pointer is assigned to its pointee, unless it is there already, and the rest
    // returned.
    fn give_back(self, &cx: Domain!['k], &lines: Buffer!, name: Span['k], value: Span['k], indent: Span['k]) {
        let symbol = self.symbol.copy(&cx);
        let outs = self.out_pointers(&cx, symbol);
        if outs.is_empty(&cx) {
            line(&lines, Buffer!::new().push_bytes(&cx, indent).push_static("return ").push_bytes(&cx, value).push_static(";"));
            return;
        }
        let ks = self.outs.at(&cx, symbol);
        let whole = self.results.at(&cx, symbol);
        let members = self.members(&cx, self.shape(&cx, whole));
        let label = self.label.copy(&cx);
        var o = 0usize;
        while o < ks.len(&cx) && o < outs.len(&cx) {
            let k = ks.at(&cx, o);
            let (_ctype, cname) = outs.at(&cx, o);
            if !self.at_out.copy(&cx).contains(&cx, (label, name, k)) {
                let (member, _t) = members.at(&cx, k);
                line(&lines, Buffer!::new().push_bytes(&cx, indent).push_static("*").push_bytes(&cx, cname).push_static(" = ").push_bytes(&cx, value).push_static(".").push_bytes(&cx, member).push_static(";"));
            }
            o = o + 1usize;
        }
        let reduced = self.reduced(&cx, whole, ks);
        if self.erased(&cx, reduced) {
            line(&lines, Buffer!::new().push_bytes(&cx, indent).push_static("return;"));
            return;
        }
        let rows = self.members(&cx, self.shape(&cx, reduced));
        let parts: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
        var r = 0usize;
        var k = 0usize;
        while k < members.len(&cx) {
            if !ks.contains(&cx, k) {
                let (m, t) = members.at(&cx, k);
                if r < rows.len(&cx) {
                    let (into, _rt) = rows.at(&cx, r);
                    if !self.erased(&cx, t) {
                        parts.push(&cx, Buffer!::new().push_static(".").push_bytes(&cx, into).push_static(" = ").push_bytes(&cx, value).push_static(".").push_bytes(&cx, m).save(&cx));
                    }
                }
                r = r + 1usize;
            }
            k = k + 1usize;
        }
        line(&lines, Buffer!::new().push_bytes(&cx, indent).push_static("return (").push_bytes(&cx, self.c(&cx, reduced)).push_static("){ ").push_bytes(&cx, parts.join(&cx, ", ")).push_static(" };"));
    }

    fn destruct(self, &cx: Domain!['k], &lines: Buffer!, instr: Instr['k]) {
        let arg = instr.args.at(&cx, 0usize);
        let (source, ty) = if arg.starts_with(&cx, Span::from_static(&cx, "&")) {
            self.place(&cx, arg)
        } else {
            let source = self.value_name(&cx, arg);
            (source, self.type_of(&cx, arg))
        };
        let representation = erase(&cx, ty, self.types);
        let pointer = is_ptr(representation);
        let component_type = match representation {
            Type::Ptr(inner) => inner.copy(&cx),
            _ => ty,
        };
        let s = self.shape(&cx, component_type);
        let access = match s {
            Type::Array(elem, length) => items_of(&cx, length as usize, elem.copy(&cx)),
            _ => self.members(&cx, s),
        };
        var i = 0usize;
        while i < instr.lhs.len(&cx) && i < access.len(&cx) {
            let lhs = instr.lhs.at(&cx, i);
            let (member, t) = access.at(&cx, i);
            if self.is_live(&cx, lhs) && !self.value_erased(&cx, lhs) && !self.the_plan(&cx).resident.contains(&cx, (self.label.copy(&cx), lhs)) {
                let name = self.value_name(&cx, lhs);
                // A pointer to a zero-size component is the pointer to the whole: they may share an address.
                if pointer && self.erased(&cx, t) {
                    line(&lines, Buffer!::new().push_bytes(&cx, name).push_static(" = (void*)").push_bytes(&cx, source).push_static(";"));
                } else if pointer {
                    line(&lines, Buffer!::new().push_bytes(&cx, name).push_static(" = KUR_FIELD(").push_bytes(&cx, source).push_static(", ").push_bytes(&cx, member).push_static(");"));
                } else {
                    line(&lines, Buffer!::new().push_bytes(&cx, name).push_static(" = ").push_bytes(&cx, source).push_static(".").push_bytes(&cx, member).push_static(";"));
                }
            }
            i = i + 1usize;
        }
    }

    // Integer conversion by truncation or sign extension.
    fn convert(self, &cx: Domain!['k], expr: Span['k], dst: Type['k]) -> Span['k] {
        let name = match dst {
            Type::Prim(n) => n,
            _ => fail_text(&cx, Span::from_static(&cx, "internal error: a conversion to a type that is not primitive")),
        };
        let wide = if C::is_pointer_sized(&cx, name) { "uintptr_t" } else { "uint64_t" };
        match signed_suffix(&cx, name) {
            Option::Some(suffix) => return Buffer!::new().push_static("kur_dec_i").push_bytes(&cx, suffix).push_static("((").push_static(wide).push_static(")(").push_bytes(&cx, expr).push_static("))").save(&cx),
            Option::None => (),
        };
        Buffer!::new().push_static("(").push_bytes(&cx, c_prim(&cx, name)).push_static(")((").push_static(wide).push_static(")(").push_bytes(&cx, expr).push_static("))").save(&cx)
    }

    // Conversion by value with a float on one side. To a float, C's conversion: the nearest value,
    // ties to even, and past the largest to an infinity. To an integer, toward zero, saturating at the
    // integer's bounds, NaN to 0: C's conversion is undefined outside the range, so it is used only in
    // it. The bounds are powers of two, exact in either float type.
    fn float_convert(self, &cx: Domain!['k], expr: Span['k], src: Type['k], dst: Type['k]) -> Span['k] {
        let (sn, dn) = match self.shape(&cx, src) {
            Type::Prim(x) => match self.shape(&cx, dst) {
                Type::Prim(y) => (x, y),
                _ => fail_text(&cx, Span::from_static(&cx, "internal error: a float conversion to a type that is not primitive")),
            },
            _ => fail_text(&cx, Span::from_static(&cx, "internal error: a float conversion from a type that is not primitive")),
        };
        let ct = c_prim(&cx, dn);
        if C::is_float(&cx, dn) {
            return Buffer!::new().push_static("(").push_bytes(&cx, ct).push_static(")").push_bytes(&cx, expr).save(&cx);
        }
        let signed = signed_suffix(&cx, dn).is_some();
        let (low, high, limits) = if C::is_pointer_sized(&cx, dn) {
            // -2^(N-1), for the target's pointer width N.
            let low = Buffer!::new().push_static("(").push_bytes(&cx, c_prim(&cx, sn)).push_static(")INTPTR_MIN").save(&cx);
            let high = Buffer!::new().push_static(if signed { "-" } else { "-2 * " }).push_bytes(&cx, low).save(&cx);
            (low, high, Span::from_static(&cx, if signed { "INTPTR" } else { "UINTPTR" }))
        } else {
            let suffix = if sn.is(&cx, "f32") { "f" } else { "" };
            let bits = C::integer_bits(&cx, dn);
            let low = Buffer!::new().push_static("-0x1p").push_u64(((bits - 1u32) as u64)).push_static(suffix).save(&cx);
            let top = if signed { bits - 1u32 } else { bits };
            let high = Buffer!::new().push_static("0x1p").push_u64((top as u64)).push_static(suffix).save(&cx);
            // `int8_t` to `INT8`, `uint64_t` to `UINT64`.
            let limits = Buffer!::new().push_static(if signed { "INT" } else { "UINT" }).push_u64((bits as u64)).save(&cx);
            (low, high, limits)
        };
        var out = Buffer!::new().push_bytes(&cx, expr);
        out = if signed { out.push_static(" >= ").push_bytes(&cx, low) } else { out.push_static(" > -1") };
        out = out.push_static(" && ").push_bytes(&cx, expr).push_static(" < ").push_bytes(&cx, high)
            .push_static(" ? (").push_bytes(&cx, ct).push_static(")").push_bytes(&cx, expr)
            .push_static(" : ").push_bytes(&cx, expr).push_static(" > 0 ? ").push_bytes(&cx, limits).push_static("_MAX : ");
        if signed {
            out = out.push_bytes(&cx, expr).push_static(" < 0 ? ").push_bytes(&cx, limits).push_static("_MIN : ");
        }
        out.push_static("0").save(&cx)
    }

    fn cast(self, &cx: Domain!['k], &lines: Buffer!, dst: Span['k], expr: Span['k], src: Type['k], dst_ty: Type['k]) {
        let s = self.shape(&cx, src);
        let d = self.shape(&cx, dst_ty);
        let cd = self.c(&cx, dst_ty);
        if is_pointer_like(s) && is_pointer_like(d) {
            line(&lines, Buffer!::new().push_bytes(&cx, dst).push_static(" = (").push_bytes(&cx, cd).push_static(")").push_bytes(&cx, expr).push_static(";"));
            if is_non_null(d) && !is_non_null(s) {
                // The cast's obligation: the pointer is not null. Telling the C compiler lets it fold
                // the niche checks of an enum made from it.
                line(&lines, Buffer!::new().push_static("if (").push_bytes(&cx, dst).push_static(" == 0) __builtin_unreachable();"));
            }
            return ();
        }
        if is_ptr(s) || is_ptr(d) {
            // The other side is an integer: the checker casts a pointer to or from nothing else
            // (`pointer_cast_fits`), and a `NonNull` only to or from a pointer.
            let value = Buffer!::new().push_static("(uintptr_t)").push_bytes(&cx, expr).save(&cx);
            let converted = if is_ptr(s) { self.convert(&cx, value, d) } else { Buffer!::new().push_static("(").push_bytes(&cx, cd).push_static(")").push_bytes(&cx, value).save(&cx) };
            line(&lines, Buffer!::new().push_bytes(&cx, dst).push_static(" = ").push_bytes(&cx, converted).push_static(";"));
            return ();
        }
        let prims = match s {
            Type::Prim(_x) => match d {
                Type::Prim(_y) => true,
                _ => false,
            },
            _ => false,
        };
        if prims {
            // One is a bool: the checker leaves a number to a number to `int_cast` and `float_cast`.
            line(&lines, Buffer!::new().push_bytes(&cx, dst).push_static(" = (").push_bytes(&cx, cd).push_static(")").push_bytes(&cx, expr).push_static(";"));
        } else {
            // Layout belongs to C. Never silently truncate a source or leave a destination tail
            // uninitialized; exact size is a target obligation.
            self.reinterpret(&cx, &lines, dst, expr);
        }
    }

    fn reinterpret(self, &cx: Domain!['k], &lines: Buffer!, dst: Span['k], expr: Span['k]) {
        line(&lines, Buffer!::new().push_static("_Static_assert(sizeof(").push_bytes(&cx, dst).push_static(") == sizeof(").push_bytes(&cx, expr)
            .push_static("), \"KURS cast requires equal representation sizes\");"));
        line(&lines, Buffer!::new().push_static("__builtin_memcpy(&").push_bytes(&cx, dst).push_static(", &").push_bytes(&cx, expr).push_static(", sizeof(").push_bytes(&cx, dst).push_static("));"));
    }

    fn primitive(self, &cx: Domain!['k], &lines: Buffer!, dst: Span['k], op: Span['k], args: ArenaVec[Span['k], 'k]) {
        let x = self.value_name(&cx, args.at(&cx, 0usize));
        let y = self.value_name(&cx, args.at(&cx, 1usize));
        let t = self.shape(&cx, self.type_of(&cx, args.at(&cx, 0usize)));
        if is_pointer_like(t) {
            line(&lines, Buffer!::new().push_bytes(&cx, dst).push_static(" = ((uintptr_t)").push_bytes(&cx, x).push_static(" ").push_bytes(&cx, c_op(&cx, op)).push_static(" (uintptr_t)").push_bytes(&cx, y).push_static(");"));
            return ();
        }
        let name = match t {
            Type::Prim(n) => n,
            _ => fail_text(&cx, Span::from_static(&cx, "internal error: a primitive operation on a value that is not primitive")),
        };
        if !C::is_integer(&cx, name) || op.is(&cx, "eq") || op.is(&cx, "ne") || op.is(&cx, "lt") || op.is(&cx, "le") || op.is(&cx, "gt") || op.is(&cx, "ge") {
            line(&lines, Buffer!::new().push_bytes(&cx, dst).push_static(" = (").push_bytes(&cx, x).push_static(" ").push_bytes(&cx, c_op(&cx, op)).push_static(" ").push_bytes(&cx, y).push_static(");"));
            return ();
        }
        let ct = c_prim(&cx, name);
        let suffix = signed_suffix(&cx, name);
        let signed = suffix.is_some();
        // The arithmetic is done unsigned, in `wide`, of `bits` bits: 64, or a pointer's width for
        // `usize` and `isize`.
        let pointer_sized = C::is_pointer_sized(&cx, name);
        let width = C::integer_bits(&cx, name);
        let wide = if pointer_sized { Span::from_static(&cx, "uintptr_t") } else { Span::from_static(&cx, "uint64_t") };
        let wide_max = if pointer_sized { Span::from_static(&cx, "UINTPTR_MAX") } else { Span::from_static(&cx, "UINT64_MAX") };
        let bits = if pointer_sized { Span::from_static(&cx, "KUR_PTR_BITS") } else { Buffer!::new().push_u64(width as u64).save(&cx) };
        let mask = if pointer_sized { Span::from_static(&cx, "(KUR_PTR_BITS - 1)") } else { Buffer!::new().push_u64((width - 1u32) as u64).save(&cx) };
        let bits_of = if pointer_sized {
            Buffer!::new().push_static("(uintptr_t)(").push_bytes(&cx, x).push_static(")").save(&cx)
        } else if width < 64u32 || signed {
            Buffer!::new().push_static("(uint64_t)(uint").push_u64(width as u64).push_static("_t)(").push_bytes(&cx, x).push_static(")").save(&cx)
        } else {
            Buffer!::new().push_static("(uint64_t)(").push_bytes(&cx, x).push_static(")").save(&cx)
        };
        if op.is(&cx, "div") || op.is(&cx, "mod") {
            line(&lines, Buffer!::new().push_static("if (").push_bytes(&cx, y).push_static(" == 0) KUR_TRAP();"));
            if signed {
                let minus = if op.is(&cx, "div") {
                    wrap(&cx, Buffer!::new().push_static("(").push_bytes(&cx, wide).push_static(")0 - (").push_bytes(&cx, wide).push_static(")(").push_bytes(&cx, x).push_static(")").save(&cx), suffix, ct)
                } else {
                    Span::from_static(&cx, "0")
                };
                line(&lines, Buffer!::new().push_bytes(&cx, dst).push_static(" = (").push_bytes(&cx, y).push_static(" == -1) ? ").push_bytes(&cx, minus).push_static(" : (").push_bytes(&cx, ct).push_static(")(")
                    .push_bytes(&cx, x).push_static(" ").push_bytes(&cx, c_op(&cx, op)).push_static(" ").push_bytes(&cx, y).push_static(");"));
            } else {
                line(&lines, Buffer!::new().push_bytes(&cx, dst).push_static(" = (").push_bytes(&cx, ct).push_static(")((").push_bytes(&cx, wide).push_static(")").push_bytes(&cx, x).push_static(" ").push_bytes(&cx, c_op(&cx, op))
                    .push_static(" (").push_bytes(&cx, wide).push_static(")").push_bytes(&cx, y).push_static(");"));
            }
            return ();
        }
        if op.is(&cx, "shl") || op.is(&cx, "shr") {
            let amount = Buffer!::new().push_static("((").push_bytes(&cx, wide).push_static(")(").push_bytes(&cx, y).push_static(") & ").push_bytes(&cx, mask).push_static(")").save(&cx);
            let shifted = if op.is(&cx, "shl") {
                Buffer!::new().push_bytes(&cx, bits_of).push_static(" << ").push_bytes(&cx, amount).save(&cx)
            } else if !signed {
                Buffer!::new().push_bytes(&cx, bits_of).push_static(" >> ").push_bytes(&cx, amount).save(&cx)
            } else {
                let fill = Buffer!::new().push_static("(").push_bytes(&cx, x).push_static(" < 0 && ").push_bytes(&cx, amount).push_static(" ? (").push_bytes(&cx, wide_max).push_static(" << (").push_bytes(&cx, bits)
                    .push_static(" - ").push_bytes(&cx, amount).push_static(")) : 0)").save(&cx);
                Buffer!::new().push_static("(").push_bytes(&cx, bits_of).push_static(" >> ").push_bytes(&cx, amount).push_static(") | ").push_bytes(&cx, fill).save(&cx)
            };
            line(&lines, Buffer!::new().push_bytes(&cx, dst).push_static(" = ").push_bytes(&cx, wrap(&cx, shifted, suffix, ct)).push_static(";"));
            return ();
        }
        let expr = Buffer!::new().push_static("(").push_bytes(&cx, wide).push_static(")(").push_bytes(&cx, x).push_static(") ").push_bytes(&cx, c_op(&cx, op)).push_static(" (").push_bytes(&cx, wide).push_static(")(").push_bytes(&cx, y).push_static(")").save(&cx);
        line(&lines, Buffer!::new().push_bytes(&cx, dst).push_static(" = ").push_bytes(&cx, wrap(&cx, expr, suffix, ct)).push_static(";"));
    }

    fn call(self, &cx: Domain!['k], &lines: Buffer!, instr: Instr['k]) {
        let callee = instr.args.at(&cx, 0usize);
        if callee.starts_with(&cx, Span::from_static(&cx, "%")) {
            let ret = match erase(&cx, self.type_of(&cx, callee), self.types) {
                Type::Fn(f) => f.ret.copy(&cx),
                _ => fail_text(&cx, Span::from_static(&cx, "internal error: a call of a value that is not a function")),
            };
            self.lend(&cx, Option::None, instr.args.skip(&cx, 1usize));
            self.emit_call(&cx, &lines, instr, self.value_name(&cx, callee), ret, ArenaMap::new(&cx), instr.args.skip(&cx, 1usize), ArenaVec::new(&cx), ArenaVec::new(&cx));
        } else if self.program.externs.contains(&cx, callee) {
            let ret = match self.program.externs.at(&cx, callee).ret {
                Option::Some(r) => r,
                Option::None => fail_text(&cx, Span::from_static(&cx, "internal error: an extern without a type")),
            };
            self.emit_call(&cx, &lines, instr, callee, ret, ArenaMap::new(&cx), instr.args.skip(&cx, 1usize), ArenaVec::new(&cx), ArenaVec::new(&cx));
        } else {
            let fun = self.program.funs.at(&cx, callee);
            let sub: ArenaMap[Span['k], Type['k], 'k] = ArenaMap::new(&cx);
            var i = 0usize;
            while i < fun.params.len(&cx) && i < instr.tys.len(&cx) {
                sub.insert(&cx, fun.params.at(&cx, i).name, self.substitute_type(&cx, instr.tys.at(&cx, i)));
                i = i + 1usize;
            }
            let symbol = self.request(&cx, FunKey::Function.(callee), fun, sub);
            self.lend(&cx, Option::Some.(symbol), instr.args.skip(&cx, 1usize));
            self.emit_call(&cx, &lines, instr, symbol, fun.ret, sub, instr.args.skip(&cx, 1usize), self.by_ref.at(&cx, symbol), self.outs.at(&cx, symbol));
        }
    }

    fn trait_call(self, &cx: Domain!['k], &lines: Buffer!, instr: Instr['k]) {
        let a = instr.args;
        let tys: ArenaVec[Type['k], 'k] = ArenaVec::new(&cx);
        var i = 0usize;
        while i < instr.tys.len(&cx) {
            tys.push(&cx, self.substitute_type(&cx, instr.tys.at(&cx, i)));
            i = i + 1usize;
        }
        let (key, fun, sub) = self.resolve_trait(&cx, a.at(&cx, 0usize), a.at(&cx, 1usize), tys);
        let symbol = self.request(&cx, key, fun, sub);
        self.lend(&cx, Option::Some.(symbol), a.skip(&cx, 2usize));
        self.emit_call(&cx, &lines, instr, symbol, fun.ret, sub, a.skip(&cx, 2usize), self.by_ref.at(&cx, symbol), self.outs.at(&cx, symbol));
    }

    // A lend adapter's call (`Plan::residences`) as its own call, lending the callee the places
    // `paths` the borrowed values lie in instead of the adapter's places, its result assigned to the
    // result of the destruct that follows.
    fn lend_in_place(self, &cx: Domain!['k], &lines: Buffer!, instr: Instr['k], paths: ArenaVec[Span['k], 'k]) {
        let (adapter, fun) = match self.adapters.at(&cx, instr.args.at(&cx, 0usize)) {
            Option::Some(found) => found,
            Option::None => fail_text(&cx, Span::from_static(&cx, "internal error: a lend in place of no adapter")),
        };
        let block = fun.blocks.at(&cx, 0usize);
        let inner = block.instrs.at(&cx, fun.locals.len(&cx));
        let actual: ArenaMap[Span['k], Span['k], 'k] = ArenaMap::new(&cx);
        var p = 0usize;
        while p < block.params.len(&cx) && p + 1usize < instr.args.len(&cx) {
            actual.insert(&cx, block.params.at(&cx, p).name, instr.args.at(&cx, p + 1usize));
            p = p + 1usize;
        }
        var s = 0usize;
        while s < fun.locals.len(&cx) && s < paths.len(&cx) {
            let path = paths.at(&cx, s);
            let lent = if path.starts_with(&cx, Span::from_static(&cx, "&")) { path } else { Buffer!::new().push_static("&").push_bytes(&cx, path).save(&cx) };
            actual.insert(&cx, fun.locals.at(&cx, s).name, lent);
            s = s + 1usize;
        }
        let sub: ArenaMap[Span['k], Type['k], 'k] = ArenaMap::new(&cx);
        var t = 0usize;
        while t < fun.params.len(&cx) && t < instr.tys.len(&cx) {
            sub.insert(&cx, fun.params.at(&cx, t).name, instr.tys.at(&cx, t));
            t = t + 1usize;
        }
        let args: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
        var g = 0usize;
        while g < inner.args.len(&cx) {
            args.push(&cx, actual.get_or(&cx, inner.args.at(&cx, g), inner.args.at(&cx, g)));
            g = g + 1usize;
        }
        let tys: ArenaVec[Type['k], 'k] = ArenaVec::new(&cx);
        var y = 0usize;
        while y < inner.tys.len(&cx) {
            tys.push(&cx, subst(&cx, inner.tys.at(&cx, y), sub, self.counter));
            y = y + 1usize;
        }
        let lhs = if adapter.returns {
            let after = self.blocks.copy(&cx).at(&cx, self.label.copy(&cx)).instrs.at(&cx, self.index.copy(&cx) + 1usize).lhs;
            let only: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
            only.push(&cx, after.at(&cx, after.len(&cx) - 1usize));
            only
        } else {
            instr.lhs
        };
        let call = Instr.{ lhs, op: inner.op, args, ty: Option::None, tys, lit: Option::None, is_unsafe: inner.is_unsafe, binders: ArenaVec::new(&cx), pos: inner.pos };
        if call.op.is(&cx, "call") {
            self.call(&cx, &lines, call);
        } else {
            self.trait_call(&cx, &lines, call);
        }
    }

    // The destruct after a lend in place: the call assigned the result, and each value handed back
    // lies in its place, or is copied out of it when it cannot be read there.
    fn handed_back(self, &cx: Domain!['k], &lines: Buffer!, instr: Instr['k], paths: ArenaVec[Span['k], 'k]) {
        let plan = self.the_plan(&cx);
        var k = 0usize;
        while k < instr.lhs.len(&cx) && k < paths.len(&cx) {
            let name = instr.lhs.at(&cx, k);
            if self.is_live(&cx, name) && !self.value_erased(&cx, name) && !plan.resident.contains(&cx, (self.label.copy(&cx), name)) {
                let (expr, _ty) = self.place(&cx, paths.at(&cx, k));
                line(&lines, Buffer!::new().push_bytes(&cx, self.value_name(&cx, name)).push_static(" = ").push_bytes(&cx, expr).push_static(";"));
            }
            k = k + 1usize;
        }
    }

    // A store of the construction just before it (`Plan::fused`): each component written into its
    // member of the place, except the ones that lie there already.
    fn store_in_place(self, &cx: Domain!['k], &lines: Buffer!, target: Span['k], construct: Instr['k]) {
        let (dst, _ty) = self.place(&cx, target);
        let ty = self.type_operand(&cx, construct);
        let labels = match self.labels_of(&cx, ty) {
            Option::Some(found) => found,
            Option::None => fail_text(&cx, Span::from_static(&cx, "internal error: a construction in place that is not a product")),
        };
        let rows = self.members(&cx, self.shape(&cx, ty));
        let plan = self.the_plan(&cx);
        let label = self.label.copy(&cx);
        var k = 0usize;
        while k < rows.len(&cx) && k < construct.args.len(&cx) && k < labels.len(&cx) {
            let (member, t) = rows.at(&cx, k);
            let arg = construct.args.at(&cx, k);
            let there = match plan.resident.get(&cx, (label, arg)) {
                Option::Some(path) => path.len() == target.len() + 1usize + labels.at(&cx, k).len() && path.starts_with(&cx, target)
                    && path.byte_or_zero(&cx, target.len()) == b'.' && path.skip(target.len() + 1usize).eq(&cx, labels.at(&cx, k)),
                Option::None => false,
            };
            if !self.erased(&cx, t) && !there {
                match self.param_index(&cx, root(&cx, target)) {
                    Option::Some(j) => {
                        let added = self.written.insert(&cx, (self.symbol.copy(&cx), j));
                    },
                    Option::None => (),
                };
                line(&lines, Buffer!::new().push_bytes(&cx, dst).push_static(".").push_bytes(&cx, member).push_static(" = ").push_bytes(&cx, self.value_name(&cx, arg)).push_static(";"));
            }
            k = k + 1usize;
        }
    }

    // The C arguments of a call: those that pass something.
    fn operands(self, &cx: Domain!['k], &lines: Buffer!, args: ArenaVec[Span['k], 'k], refs: ArenaVec[bool, 'k]) -> Span['k] {
        let out: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
        var i = 0usize;
        while i < args.len(&cx) {
            if !self.erased_arg(&cx, args.at(&cx, i)) {
                if i < refs.len(&cx) && refs.at(&cx, i) {
                    out.push(&cx, self.by_address(&cx, &lines, args.at(&cx, i), args));
                } else {
                    out.push(&cx, self.operand(&cx, args.at(&cx, i)));
                }
            }
            i = i + 1usize;
        }
        out.join(&cx, ", ")
    }

    // The address of the value `arg` for a callee that reads it through a pointer (`by_address` in
    // cgen.py).
    fn by_address(self, &cx: Domain!['k], &lines: Buffer!, arg: Span['k], args: ArenaVec[Span['k], 'k]) -> Span['k] {
        let expr = self.value_name(&cx, arg);
        let path = self.the_plan(&cx).resident.get_or(&cx, (self.label.copy(&cx), arg), Span::from_static(&cx, ""));
        var unsafe_spot = false;
        if path.starts_with(&cx, Span::from_static(&cx, "&")) {
            unsafe_spot = self.param_index(&cx, root(&cx, path)).is_some();
            var g = 0usize;
            while !unsafe_spot && g < args.len(&cx) {
                unsafe_spot = is_place(&cx, args.at(&cx, g)) && overlap(&cx, args.at(&cx, g), path);
                g = g + 1usize;
            }
            let out_paths = self.out_paths.copy(&cx);
            var q = 0usize;
            while !unsafe_spot && q < out_paths.len(&cx) {
                unsafe_spot = overlap(&cx, out_paths.at(&cx, q), path);
                q = q + 1usize;
            }
        }
        if !unsafe_spot {
            return Buffer!::new().push_static("&").push_bytes(&cx, expr).save(&cx);
        }
        let copy = allocate(&cx, Buffer!::new().push_static("arg_").push_usize(self.scratch.copy(&cx)).save(&cx), self.taken);
        self.scratch.set(&cx, self.scratch.copy(&cx) + 1usize);
        self.temps.copy(&cx).push(&cx, Buffer!::new().push_bytes(&cx, self.c(&cx, self.type_of(&cx, arg))).push_static(" ").push_bytes(&cx, copy).push_static(";").save(&cx));
        line(&lines, Buffer!::new().push_bytes(&cx, copy).push_static(" = ").push_bytes(&cx, expr).push_static(";"));
        Buffer!::new().push_static("&").push_bytes(&cx, copy).save(&cx)
    }

    fn emit_call(self, &cx: Domain!['k], &lines: Buffer!, instr: Instr['k], callee: Span['k], ret: Type['k], sub: ArenaMap[Span['k], Type['k], 'k], args: ArenaVec[Span['k], 'k],
        refs: ArenaVec[bool, 'k], outs: ArenaVec[usize, 'k]) {
        let name = instr.lhs.at(&cx, 0usize);
        let label = self.label.copy(&cx);
        let result = subst(&cx, ret, sub, self.counter);
        let live = !self.erased(&cx, result) && self.is_live(&cx, name);
        let dst = if live { self.value_name(&cx, name) } else { Span::from_static(&cx, "") };
        let homed = if live && self.the_plan(&cx).made_home.contains(&cx, (label, name)) { self.away(&cx, name) } else { ArenaVec::new(&cx) };
        let members = if outs.is_empty(&cx) { ArenaVec::new(&cx) } else { self.members(&cx, self.shape(&cx, result)) };
        let current = self.symbol.copy(&cx);
        let own_ks = if self.returning.copy(&cx) { self.outs.at(&cx, current) } else { ArenaVec::new(&cx) };
        let own = self.out_pointers(&cx, current);
        let pointers: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
        let out_paths: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
        var o = 0usize;
        while o < outs.len(&cx) {
            let k = outs.at(&cx, o);
            let mine = match own_ks.index_of(&cx, k) {
                Option::Some(i) => if i < own.len(&cx) { Option::Some.(own.at(&cx, i)) } else { Option::None },
                Option::None => Option::None,
            };
            match home_of(&cx, homed, k) {
                Option::Some(path) => {
                    let (expr, _ty) = self.place(&cx, path);
                    pointers.push(&cx, Buffer!::new().push_static("&").push_bytes(&cx, expr).save(&cx));
                    match self.param_index(&cx, root(&cx, path)) {
                        Option::Some(j) => {
                            let added = self.written.insert(&cx, (current, j));
                        },
                        Option::None => (),
                    };
                    out_paths.push(&cx, path);
                },
                Option::None => if self.passes_own(&cx, mine, result, k) {
                    let (_ctype, cname) = match mine {
                        Option::Some(pointee) => pointee,
                        Option::None => fail_text(&cx, Span::from_static(&cx, "internal error: no out pointer")),
                    };
                    pointers.push(&cx, cname);
                    let added = self.at_out.copy(&cx).insert(&cx, (label, name, k));
                } else if live {
                    let (member, _t) = members.at(&cx, k);
                    pointers.push(&cx, Buffer!::new().push_static("&").push_bytes(&cx, dst).push_static(".").push_bytes(&cx, member).save(&cx));
                } else {
                    let temp = allocate(&cx, Buffer!::new().push_static("arg_").push_usize(self.scratch.copy(&cx)).save(&cx), self.taken);
                    self.scratch.set(&cx, self.scratch.copy(&cx) + 1usize);
                    self.temps.copy(&cx).push(&cx, Buffer!::new().push_bytes(&cx, self.c(&cx, self.element(&cx, result, k))).push_static(" ").push_bytes(&cx, temp).push_static(";").save(&cx));
                    pointers.push(&cx, Buffer!::new().push_static("&").push_bytes(&cx, temp).save(&cx));
                },
            };
            o = o + 1usize;
        }
        self.out_paths.set(&cx, out_paths);
        let operands = self.operands(&cx, &lines, args, refs);
        self.out_paths.set(&cx, ArenaVec::new(&cx));
        let passed: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
        if !operands.is_empty() {
            passed.push(&cx, operands);
        }
        var p = 0usize;
        while p < pointers.len(&cx) {
            passed.push(&cx, pointers.at(&cx, p));
            p = p + 1usize;
        }
        let call = Buffer!::new().push_bytes(&cx, callee).push_static("(").push_bytes(&cx, passed.join(&cx, ", ")).push_static(")").save(&cx);
        if !outs.is_empty(&cx) {
            let reduced = self.reduced(&cx, result, outs);
            if !live || self.erased(&cx, reduced) {
                line(&lines, Buffer!::new().push_bytes(&cx, call).push_static(";"));
            } else {
                let temp = allocate(&cx, Buffer!::new().push_static("ret_").push_usize(self.scratch.copy(&cx)).save(&cx), self.taken);
                self.scratch.set(&cx, self.scratch.copy(&cx) + 1usize);
                self.temps.copy(&cx).push(&cx, Buffer!::new().push_bytes(&cx, self.c(&cx, reduced)).push_static(" ").push_bytes(&cx, temp).push_static(";").save(&cx));
                line(&lines, Buffer!::new().push_bytes(&cx, temp).push_static(" = ").push_bytes(&cx, call).push_static(";"));
                let rows = self.members(&cx, self.shape(&cx, reduced));
                var r = 0usize;
                var k = 0usize;
                while k < members.len(&cx) {
                    if !outs.contains(&cx, k) {
                        let (m, t) = members.at(&cx, k);
                        if r < rows.len(&cx) && !self.erased(&cx, t) {
                            let (into, _rt) = rows.at(&cx, r);
                            line(&lines, Buffer!::new().push_bytes(&cx, dst).push_static(".").push_bytes(&cx, m).push_static(" = ").push_bytes(&cx, temp).push_static(".").push_bytes(&cx, into).push_static(";"));
                        }
                        r = r + 1usize;
                    }
                    k = k + 1usize;
                }
            }
        } else if !live {
            line(&lines, Buffer!::new().push_bytes(&cx, call).push_static(";"));
        } else {
            line(&lines, Buffer!::new().push_bytes(&cx, dst).push_static(" = ").push_bytes(&cx, call).push_static(";"));
        }
        // A homed component the callee does not write through a pointer goes to its place after the call.
        var h = 0usize;
        while h < homed.len(&cx) {
            let (k, path) = homed.at(&cx, h);
            if !outs.contains(&cx, k) {
                let (member, _t) = self.members(&cx, self.shape(&cx, result)).at(&cx, k);
                self.write_home(&cx, &lines, path, Buffer!::new().push_bytes(&cx, dst).push_static(".").push_bytes(&cx, member).save(&cx), Span::from_static(&cx, ""));
            }
            h = h + 1usize;
        }
    }

    // The caller's own out pointer `mine` for element `k` of a call's result `result` is passed on: its
    // pointee has the element's C type.
    fn passes_own(self, &cx: Domain!['k], mine: Option[(Span['k], Span['k])], result: Type['k], k: usize) -> bool {
        match mine {
            Option::Some(pointee) => {
                let (ctype, _cname) = pointee;
                ctype.eq(&cx, self.c(&cx, self.element(&cx, result, k)))
            },
            Option::None => false,
        }
    }

    // The type of element `k` of the tuple `ty`'s shape.
    fn element(self, &cx: Domain!['k], ty: Type['k], k: usize) -> Type['k] {
        match self.shape(&cx, ty) {
            Type::Tuple(elems) => elems.at(&cx, k),
            _ => fail_text(&cx, Span::from_static(&cx, "internal error: an element of a type that is not a tuple")),
        }
    }

    fn atomic(self, &cx: Domain!['k], &lines: Buffer!, instr: Instr['k], dst: Option[Span['k]]) {
        let order = match instr.lit {
            Option::Some(o) => o,
            Option::None => fail_text(&cx, Span::from_static(&cx, "internal error: an atomic operation without its ordering")),
        };
        let d = match dst {
            Option::Some(t) => t,
            Option::None => Span::from_static(&cx, "None"),
        };
        let kind = match C::atomic_kind(&cx, instr.op) {
            Option::Some(k) => k,
            Option::None => fail_text(&cx, Span::from_static(&cx, "internal error: not an atomic operation")),
        };
        let args: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
        var i = 0usize;
        while i < instr.args.len(&cx) {
            args.push(&cx, self.value_name(&cx, instr.args.at(&cx, i)));
            i = i + 1usize;
        }
        if !kind.is(&cx, "fence") {
            let item = self.shape(&cx, self.pointee(&cx, self.type_of(&cx, instr.args.at(&cx, 0usize))));
            let (integer, transfer) = match item {
                Type::Prim(n) => (C::is_integer(&cx, n), n.is(&cx, "bool")),
                Type::Ptr(_inner) => (false, true),
                _ => (false, false),
            };
            if !integer && (kind.starts_with(&cx, Span::from_static(&cx, "fetch_")) || !transfer) {
                fail_at(&cx, Buffer!::new().push_static("backend atomic ").push_bytes(&cx, kind).push_static(" does not support this pointee type; ")
                    .push_static("fetch operations require integers, transfers require integers, bool or raw pointers").save(&cx), instr.pos);
            }
        }
        if kind.is(&cx, "fence") {
            line(&lines, Buffer!::new().push_static("__atomic_thread_fence(").push_bytes(&cx, c_order(&cx, order)).push_static(");"));
        } else if kind.is(&cx, "load") {
            line(&lines, Buffer!::new().push_bytes(&cx, d).push_static(" = __atomic_load_n(").push_bytes(&cx, args.at(&cx, 0usize)).push_static(", ").push_bytes(&cx, c_order(&cx, order)).push_static(");"));
        } else if kind.is(&cx, "store") {
            line(&lines, Buffer!::new().push_static("__atomic_store_n(").push_bytes(&cx, args.at(&cx, 0usize)).push_static(", ").push_bytes(&cx, args.at(&cx, 1usize)).push_static(", ").push_bytes(&cx, c_order(&cx, order)).push_static(");"));
        } else if kind.is(&cx, "swap") {
            line(&lines, Buffer!::new().push_bytes(&cx, d).push_static(" = __atomic_exchange_n(").push_bytes(&cx, args.at(&cx, 0usize)).push_static(", ").push_bytes(&cx, args.at(&cx, 1usize)).push_static(", ")
                .push_bytes(&cx, c_order(&cx, order)).push_static(");"));
        } else if kind.is(&cx, "compare_exchange") {
            let (success, failure) = match order.find(&cx, Span::from_static(&cx, "/"), 0usize) {
                Option::Some(at) => (order.slice(0usize, at), order.skip(at + 1usize)),
                Option::None => (order, Span::from_static(&cx, "")),
            };
            line(&lines, Buffer!::new().push_bytes(&cx, d).push_static(".e0 = ").push_bytes(&cx, args.at(&cx, 1usize)).push_static(";"));
            line(&lines, Buffer!::new().push_bytes(&cx, d).push_static(".e1 = __atomic_compare_exchange_n(").push_bytes(&cx, args.at(&cx, 0usize)).push_static(", &").push_bytes(&cx, d).push_static(".e0, ")
                .push_bytes(&cx, args.at(&cx, 2usize)).push_static(", 0, ").push_bytes(&cx, c_order(&cx, success)).push_static(", ").push_bytes(&cx, c_order(&cx, failure)).push_static(");"));
        } else {
            line(&lines, Buffer!::new().push_bytes(&cx, d).push_static(" = __atomic_").push_bytes(&cx, kind).push_static("(").push_bytes(&cx, args.at(&cx, 0usize)).push_static(", ").push_bytes(&cx, args.at(&cx, 1usize)).push_static(", ")
                .push_bytes(&cx, c_order(&cx, order)).push_static(");"));
        }
    }

    fn foreach_instr(self, &cx: Domain!['k], &lines: Buffer!, instr: Instr['k], dst: Span['k]) {
        let t = match instr.ty {
            Option::Some(ty) => match self.substitute_type(&cx, ty) {
                Type::Foreach(f) => f,
                _ => fail_text(&cx, Span::from_static(&cx, "internal error: a foreach of a type that is not a transform")),
            },
            Option::None => fail_text(&cx, Span::from_static(&cx, "internal error: a foreach without its type")),
        };
        let operand = self.type_of(&cx, instr.args.at(&cx, 0usize));
        let mapped = mapped_operand(operand);
        let source = if self.value_erased(&cx, instr.args.at(&cx, 0usize)) { Span::from_static(&cx, "") } else { self.value_name(&cx, instr.args.at(&cx, 0usize)) };
        let mapper_name = instr.args.at(&cx, 1usize);
        let mapper = self.program.funs.at(&cx, mapper_name);
        let own: ArenaVec[Type['k], 'k] = ArenaVec::new(&cx);
        var o = 0usize;
        while o < instr.tys.len(&cx) {
            own.push(&cx, self.substitute_type(&cx, instr.tys.at(&cx, o)));
            o = o + 1usize;
        }
        if mapper.params.len(&cx) != 1usize + own.len(&cx) {
            fail_at(&cx, Span::from_static(&cx, "foreach mapper parameter partition disagrees"), instr.pos);
        }
        // A captured value the mapper takes by pointer (an aggregate of more than four words, as
        // `request` decides for its parameter of that type) is passed by its address.
        let caps: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
        var c = 2usize;
        while c < instr.args.len(&cx) {
            if !self.value_erased(&cx, instr.args.at(&cx, c)) {
                if self.by_pointer(&cx, self.type_of(&cx, instr.args.at(&cx, c))) {
                    caps.push(&cx, self.by_address(&cx, &lines, instr.args.at(&cx, c), ArenaVec::new(&cx)));
                } else {
                    caps.push(&cx, self.value_name(&cx, instr.args.at(&cx, c)));
                }
            }
            c = c + 1usize;
        }
        let values: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
        var v = 2usize;
        while v < instr.args.len(&cx) {
            if !self.value_erased(&cx, instr.args.at(&cx, v)) {
                values.push(&cx, self.value_name(&cx, instr.args.at(&cx, v)));
            }
            v = v + 1usize;
        }
        let found = self.types.rows(&cx, t.source.copy(&cx), Option::None, false);
        let rows = found.rows;
        let pointer = mapped.is_none() && is_ptr(self.shape(&cx, t.source.copy(&cx)));
        let out_shape = self.shape(&cx, Type::Foreach.(t));
        let walk = Walk.{ backend: self, t, mapped, mapper, mapper_name, own, caps, values, pointer };
        match found.skeleton {
            Option::Some(skeleton) => match skeleton {
                Type::Enum(_variants) => {
                    let results = match out_shape {
                        Type::Enum(variants) => variants,
                        _ => fail_text(&cx, Span::from_static(&cx, "internal error: a foreach over an enum that makes no enum")),
                    };
                    let source_type = self.type_of(&cx, instr.args.at(&cx, 0usize));
                    let result_type = Type::Foreach.(t);
                    // Through a pointer the variant is read there, and each payload is passed by its
                    // address: the pointer to the whole for a zero-size payload or the niche layout's.
                    let sum_type = if pointer {
                        self.pointee(&cx, self.shape(&cx, source_type))
                    } else {
                        source_type
                    };
                    let held = if pointer {
                        self.tag(&cx, Buffer!::new().push_static("(*").push_bytes(&cx, source).push_static(")").save(&cx), sum_type)
                    } else {
                        self.tag(&cx, source, source_type)
                    };
                    let niche = self.niche_layout(&cx, sum_type).is_some();
                    line(&lines, Buffer!::new().push_static("switch (").push_bytes(&cx, held).push_static(") {"));
                    var k = 0usize;
                    while k < rows.len(&cx) && k < results.len(&cx) {
                        let row = rows.at(&cx, k);
                        let component = if !pointer {
                            self.payload(&cx, source, source_type, row.label)
                        } else if niche || self.erased(&cx, self.pointee(&cx, row.item)) {
                            Buffer!::new().push_static("(void*)").push_bytes(&cx, source).save(&cx)
                        } else {
                            Buffer!::new().push_static("KUR_FIELD(").push_bytes(&cx, source).push_static(", payload.").push_bytes(&cx, self.variant(&cx, row.label)).push_static(")").save(&cx)
                        };
                        let applied = walk.apply(&cx, row, component);
                        let body = if self.erased(&cx, results.at(&cx, k).type) {
                            Buffer!::new().push_bytes(&cx, applied).push_static("; ").push_bytes(&cx, self.set_variant(&cx, dst, result_type, row.label, Option::None).join(&cx, " ")).save(&cx)
                        } else {
                            match self.niche_layout(&cx, result_type) {
                                Option::Some(_layout) => Buffer!::new().push_bytes(&cx, dst).push_static(" = ").push_bytes(&cx, applied).push_static(";").save(&cx),
                                Option::None => self.set_variant(&cx, dst, result_type, row.label, Option::Some.(applied)).join(&cx, " "),
                            }
                        };
                        line(&lines, Buffer!::new().push_static("case ").push_usize(k).push_static(": ").push_bytes(&cx, body).push_static(" break;"));
                        k = k + 1usize;
                    }
                    line(&lines, Buffer!::new().push_static("default: KUR_TRAP();\n  }"));
                    return ();
                },
                _ => (),
            },
            Option::None => (),
        };
        let out = match out_shape {
            Type::Array(elem, _length) => items_of(&cx, rows.len(&cx), elem.copy(&cx)),
            _ => self.members(&cx, out_shape),
        };
        let skeleton = match found.skeleton {
            Option::Some(s) => s,
            Option::None => {
                // A mapped operand of a leaf source is a one-component tuple.
                let component = if mapped.is_some() { Buffer!::new().push_bytes(&cx, source).push_static(".e0").save(&cx) } else { source };
                let (member, result) = out.at(&cx, 0usize);
                let applied = walk.apply(&cx, rows.at(&cx, 0usize), component);
                line(&lines, Buffer!::new().push_bytes(&cx, self.assign_result(&cx, Buffer!::new().push_bytes(&cx, dst).push_static(".").push_bytes(&cx, member).save(&cx), result, applied)));
                return ();
            },
        };
        // A mapped operand is a value of its expansion, with its own members; a source's are the
        // skeleton's.
        let accessed = if mapped.is_some() { self.shape(&cx, operand) } else { skeleton };
        let source_access = match accessed {
            Type::Array(_elem, _length) => items_access(&cx, rows.len(&cx)),
            _ => member_names(&cx, self.members(&cx, accessed)),
        };
        var k = 0usize;
        while k < rows.len(&cx) && k < source_access.len(&cx) && k < out.len(&cx) {
            let row = rows.at(&cx, k);
            // A pointer to a zero-size component is the pointer to the whole, as `destruct` makes it.
            let component = if pointer && self.erased(&cx, row.item) {
                Buffer!::new().push_static("(void*)").push_bytes(&cx, source).save(&cx)
            } else if pointer {
                Buffer!::new().push_static("KUR_FIELD(").push_bytes(&cx, source).push_static(", ").push_bytes(&cx, source_access.at(&cx, k)).push_static(")").save(&cx)
            } else {
                Buffer!::new().push_bytes(&cx, source).push_static(".").push_bytes(&cx, source_access.at(&cx, k)).save(&cx)
            };
            let (member, result) = out.at(&cx, k);
            let applied = walk.apply(&cx, row, component);
            line(&lines, Buffer!::new().push_bytes(&cx, self.assign_result(&cx, Buffer!::new().push_bytes(&cx, dst).push_static(".").push_bytes(&cx, member).save(&cx), result, applied)));
            k = k + 1usize;
        }
    }

    // `target = call;`, or the call alone for a result of a zero-size type.
    fn assign_result(self, &cx: Domain!['k], target: Span['k], result: Type['k], call: Span['k]) -> Span['k] {
        if self.erased(&cx, result) {
            Buffer!::new().push_bytes(&cx, call).push_static(";").save(&cx)
        } else {
            Buffer!::new().push_bytes(&cx, target).push_static(" = ").push_bytes(&cx, call).push_static(";").save(&cx)
        }
    }

    // ---------------------------------------------------------------- terminators --

    fn term(self, &cx: Domain!['k], &lines: Buffer!, term: Terminator['k]) {
        match term {
            Terminator::Ret(value, _pos) => if self.value_erased(&cx, value) {
                line(&lines, Buffer!::new().push_static("return;"));
            } else {
                let returned = self.value_name(&cx, value);
                self.give_back(&cx, &lines, value, returned, Span::from_static(&cx, ""));
            },
            Terminator::Jmp(edge, _pos) => self.edge(&cx, &lines, edge, Option::None, Span::from_static(&cx, ""), Span::from_static(&cx, "")),
            Terminator::Jnz(cond, then, other, _pos) => {
                line(&lines, Buffer!::new().push_static("if (").push_bytes(&cx, self.value_name(&cx, cond)).push_static(") {"));
                self.edge(&cx, &lines, then, Option::None, Span::from_static(&cx, ""), Span::from_static(&cx, "  "));
                line(&lines, Buffer!::new().push_static("} else {"));
                self.edge(&cx, &lines, other, Option::None, Span::from_static(&cx, ""), Span::from_static(&cx, "  "));
                line(&lines, Buffer!::new().push_static("}"));
            },
            Terminator::Switch(scrutinee, ty, arms, _pos) => self.switch(&cx, &lines, scrutinee, ty, arms),
            Terminator::Unreachable(_pos) => {
                let instrs = self.blocks.copy(&cx).at(&cx, self.label.copy(&cx)).instrs;
                // A `trap` has written its own.
                if instrs.is_empty(&cx) || !instrs.at(&cx, instrs.len(&cx) - 1usize).op.is(&cx, "trap") {
                    line(&lines, Buffer!::new().push_static("KUR_TRAP();"));
                }
            },
        };
    }

    // A jump assigns the target's live parameters (`source` is the C variable `payload` reads); a jump
    // to a return join returns the value it passes there. A value of a zero-size type is empty: nothing
    // is assigned or returned.
    fn edge(self, &cx: Domain!['k], &lines: Buffer!, edge: Edge['k], payload: Option[Span['k]], source: Span['k], indent: Span['k]) {
        let plan = self.the_plan(&cx);
        let target = self.blocks.copy(&cx).at(&cx, edge.target);
        // (value, the C variable it reads)
        let values: ArenaVec[(Span['k], Span['k]), 'k] = ArenaVec::new(&cx);
        // the SSA value of each, or `""` for the payload
        let names: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
        if payload.is_some() {
            names.push(&cx, Span::from_static(&cx, ""));
        }
        names.append(&cx, edge.args);
        match payload {
            Option::Some(p) => if plan.arrived.contains(&cx, (target.label, target.params.at(&cx, 0usize).name)) {
                values.push(&cx, (Span::from_static(&cx, ""), source));
            } else {
                values.push(&cx, (p, source));
            },
            Option::None => (),
        };
        var a = 0usize;
        while a < edge.args.len(&cx) {
            let arg = edge.args.at(&cx, a);
            if self.value_erased(&cx, arg) {
                values.push(&cx, (Span::from_static(&cx, ""), Span::from_static(&cx, "")));
            } else {
                values.push(&cx, (self.value_name(&cx, arg), self.value_base(&cx, arg)));
            }
            a = a + 1usize;
        }
        match plan.return_index.get(&cx, target.label) {
            Option::Some(index) => {
                let (value, _base) = values.at(&cx, index);
                if value.is_empty() {
                    line(&lines, Buffer!::new().push_bytes(&cx, indent).push_static("return;"));
                } else {
                    self.give_back(&cx, &lines, names.at(&cx, index), value, indent);
                }
                return;
            },
            Option::None => (),
        };
        let moves: ArenaVec[Move['k], 'k] = ArenaVec::new(&cx);
        // (place path, value) of each homed component the edge writes, after every other assignment
        let homes: ArenaVec[(Span['k], Span['k]), 'k] = ArenaVec::new(&cx);
        let label = self.label.copy(&cx);
        var p = 0usize;
        while p < target.params.len(&cx) && p < values.len(&cx) {
            let binding = target.params.at(&cx, p);
            let (value, base) = values.at(&cx, p);
            if !value.is_empty() && plan.is_live(&cx, target.label, binding.name) {
                match plan.homed.get(&cx, (target.label, binding.name)) {
                    Option::Some(homed) => {
                        // The components written where they end up (`Plan::home_params`): the others are
                        // assigned one by one, and the homed ones after every other assignment, unless the
                        // value's making wrote them.
                        let made = plan.made_home.contains(&cx, (label, names.at(&cx, p)));
                        let rows = self.members(&cx, self.shape(&cx, self.substitute_type(&cx, binding.type)));
                        var k = 0usize;
                        while k < rows.len(&cx) {
                            let (member, mt) = rows.at(&cx, k);
                            match home_of(&cx, homed, k) {
                                Option::Some(path) => if !made {
                                    homes.push(&cx, (path, Buffer!::new().push_bytes(&cx, value).push_static(".").push_bytes(&cx, member).save(&cx)));
                                },
                                Option::None => if !self.erased(&cx, mt) {
                                    moves.push(&cx, Move.{ dst: Buffer!::new().push_bytes(&cx, self.cname(&cx, target.label, binding.name)).push_static(".").push_bytes(&cx, member).save(&cx),
                                        ty: mt, place: false, value: Buffer!::new().push_bytes(&cx, value).push_static(".").push_bytes(&cx, member).save(&cx), base });
                                },
                            };
                            k = k + 1usize;
                        }
                    },
                    Option::None => moves.push(&cx, Move.{ dst: self.cname(&cx, target.label, binding.name), ty: binding.type, place: false, value, base }),
                };
            }
            p = p + 1usize;
        }
        self.assign(&cx, &lines, moves, indent);
        var h = 0usize;
        while h < homes.len(&cx) {
            let (path, value) = homes.at(&cx, h);
            self.write_home(&cx, &lines, path, value, indent);
            h = h + 1usize;
        }
        line(&lines, Buffer!::new().push_bytes(&cx, indent).push_static("goto ").push_bytes(&cx, self.labels.copy(&cx).at(&cx, target.label)).push_static(";"));
    }

    // Assigns each move at once: one after another when no assignment overwrites what a later one
    // reads, else through scratch locals.
    fn assign(self, &cx: Domain!['k], &lines: Buffer!, all: ArenaVec[Move['k], 'k], indent: Span['k]) {
        let moves: ArenaVec[Move['k], 'k] = ArenaVec::new(&cx);
        var m = 0usize;
        while m < all.len(&cx) {
            if !all.at(&cx, m).dst.eq(&cx, all.at(&cx, m).value) {
                moves.push(&cx, all.at(&cx, m));
            }
            m = m + 1usize;
        }
        var conflict = false;
        var k = 0usize;
        while k < moves.len(&cx) {
            var later = k + 1usize;
            while later < moves.len(&cx) {
                if root(&cx, moves.at(&cx, k).dst).eq(&cx, moves.at(&cx, later).base) {
                    conflict = true;
                }
                later = later + 1usize;
            }
            k = k + 1usize;
        }
        if conflict {
            let temps: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
            var i = 0usize;
            while i < moves.len(&cx) {
                let move = moves.at(&cx, i);
                let temp = allocate(&cx, Buffer!::new().push_static("edge_").push_usize(self.scratch.copy(&cx)).save(&cx), self.taken);
                self.scratch.set(&cx, self.scratch.copy(&cx) + 1usize);
                self.temps.copy(&cx).push(&cx, Buffer!::new().push_bytes(&cx, self.c(&cx, self.substitute_type(&cx, move.ty))).push_static(if move.place { "*" } else { "" })
                    .push_static(" ").push_bytes(&cx, temp).push_static(";").save(&cx));
                line(&lines, Buffer!::new().push_bytes(&cx, indent).push_bytes(&cx, temp).push_static(" = ").push_bytes(&cx, move.value).push_static(";"));
                temps.push(&cx, temp);
                i = i + 1usize;
            }
            var j = 0usize;
            while j < moves.len(&cx) {
                line(&lines, Buffer!::new().push_bytes(&cx, indent).push_bytes(&cx, moves.at(&cx, j).dst).push_static(" = ").push_bytes(&cx, temps.at(&cx, j)).push_static(";"));
                j = j + 1usize;
            }
        } else {
            var j = 0usize;
            while j < moves.len(&cx) {
                line(&lines, Buffer!::new().push_bytes(&cx, indent).push_bytes(&cx, moves.at(&cx, j).dst).push_static(" = ").push_bytes(&cx, moves.at(&cx, j).value).push_static(";"));
                j = j + 1usize;
            }
        }
    }

    fn switch(self, &cx: Domain!['k], &lines: Buffer!, arg: Span['k], ty: Type['k], arms: ArenaVec[Arm['k], 'k]) {
        let place = arg.starts_with(&cx, Span::from_static(&cx, "&"));
        let (source, base) = if place {
            let (expr, _t) = self.place(&cx, arg);
            (expr, expr)
        } else {
            (self.value_name(&cx, arg), self.value_base(&cx, arg))
        };
        let ty = self.substitute_type(&cx, ty);
        let variants = self.types.variants(&cx, erase(&cx, ty, self.types), Option::None);
        line(&lines, Buffer!::new().push_static("switch (").push_bytes(&cx, self.tag(&cx, source, ty)).push_static(") {"));
        var i = 0usize;
        while i < arms.len(&cx) {
            let arm = arms.at(&cx, i);
            var index = 0usize;
            var found = false;
            while !found && index < variants.len(&cx) {
                if variants.at(&cx, index).name.eq(&cx, arm.variant) {
                    found = true;
                } else {
                    index = index + 1usize;
                }
            }
            line(&lines, Buffer!::new().push_static("case ").push_usize(index).push_static(":"));
            let payload = if place {
                Option::None
            } else if self.erased(&cx, variants.at(&cx, index).type) {
                Option::Some.(Span::from_static(&cx, ""))
            } else {
                Option::Some.(self.payload(&cx, source, ty, arm.variant))
            };
            line(&lines, Buffer!::new().push_static("  {"));
            self.edge(&cx, &lines, arm.edge, payload, base, Span::from_static(&cx, "    "));
            line(&lines, Buffer!::new().push_static("  }"));
            i = i + 1usize;
        }
        line(&lines, Buffer!::new().push_static("default: KUR_TRAP();"));
        line(&lines, Buffer!::new().push_static("}"));
    }

    // ----------------------------------------------------------------- tail calls --

    // The position of `name` among the entry block's parameters.
    fn param_index(self, &cx: Domain!['k], name: Span['k]) -> Option[usize] {
        self.params.copy(&cx).index_of(&cx, name)
    }

    // Records where each place lent to `callee` lies, for `qualifiers`; `None` for a call through a
    // function value, whose place parameters are neither `const` nor `restrict`. A place of a zero-size
    // type passes nothing.
    fn lend(self, &cx: Domain!['k], callee: Option[Span['k]], args: ArenaVec[Span['k], 'k]) {
        var k = 0usize;
        while k < args.len(&cx) {
            let arg = args.at(&cx, k);
            if arg.starts_with(&cx, Span::from_static(&cx, "&")) && !self.erased_arg(&cx, arg) {
                var kind = Span::from_static(&cx, "local");
                var j = 0usize;
                if arg.starts_with(&cx, Span::from_static(&cx, "&*")) {
                    kind = Span::from_static(&cx, "raw");
                } else {
                    match self.param_index(&cx, root(&cx, arg)) {
                        Option::Some(index) => {
                            kind = Span::from_static(&cx, "param");
                            j = index;
                        },
                        Option::None => (),
                    };
                }
                match callee {
                    Option::Some(symbol) => self.lends.push(&cx, (symbol, k, kind, self.symbol.copy(&cx), j)),
                    Option::None => if kind.is(&cx, "param") {
                        let added = self.written.insert(&cx, (self.symbol.copy(&cx), j));
                    },
                };
            }
            k = k + 1usize;
        }
    }

    // A call whose result its block returns (`Plan::tail_call`), as a jump when the C allows one: see
    // `tail_call` in cgen.py. Returns whether it wrote the call; otherwise the block is written as usual.
    fn tail_call(self, &cx: Domain!['k], &lines: Buffer!, call: Instr['k]) -> bool {
        let a = call.args;
        let (key, fun, sub, args) = if call.op.is(&cx, "call") {
            let name = a.at(&cx, 0usize);
            if name.starts_with(&cx, Span::from_static(&cx, "%")) || self.program.externs.contains(&cx, name) {
                return false;
            }
            let fun = self.program.funs.at(&cx, name);
            let sub: ArenaMap[Span['k], Type['k], 'k] = ArenaMap::new(&cx);
            var i = 0usize;
            while i < fun.params.len(&cx) && i < call.tys.len(&cx) {
                sub.insert(&cx, fun.params.at(&cx, i).name, self.substitute_type(&cx, call.tys.at(&cx, i)));
                i = i + 1usize;
            }
            (FunKey::Function.(name), fun, sub, a.skip(&cx, 1usize))
        } else {
            let tys: ArenaVec[Type['k], 'k] = ArenaVec::new(&cx);
            var i = 0usize;
            while i < call.tys.len(&cx) {
                tys.push(&cx, self.substitute_type(&cx, call.tys.at(&cx, i)));
                i = i + 1usize;
            }
            let (key, fun, sub) = self.resolve_trait(&cx, a.at(&cx, 0usize), a.at(&cx, 1usize), tys);
            (key, fun, sub, a.skip(&cx, 2usize))
        };
        var g = 0usize;
        while g < args.len(&cx) {
            let arg = args.at(&cx, g);
            if arg.starts_with(&cx, Span::from_static(&cx, "&")) && !arg.starts_with(&cx, Span::from_static(&cx, "&*"))
                && self.param_index(&cx, root(&cx, arg)).is_none() {
                return false;
            }
            g = g + 1usize;
        }
        let symbol = self.request(&cx, key, fun, sub);
        let current = self.symbol.copy(&cx);
        if symbol.eq(&cx, current) {
            self.lend(&cx, Option::Some.(symbol), args);
            let plan = self.the_plan(&cx);
            let entry = fun.blocks.at(&cx, 0usize);
            let (_ret, _noreturn, cparams) = self.heads.at(&cx, current);
            let moves: ArenaVec[Move['k], 'k] = ArenaVec::new(&cx);
            var p = 0usize;
            while p < entry.params.len(&cx) && p < args.len(&cx) && p < cparams.len(&cx) {
                let binding = entry.params.at(&cx, p);
                let arg = args.at(&cx, p);
                let place = binding.name.starts_with(&cx, Span::from_static(&cx, "&"));
                if cparams.at(&cx, p).ctype.is(&cx, "void") {
                } else if place && !arg.eq(&cx, binding.name) {
                    let added = self.looping.insert(&cx, current);
                    let base = if arg.starts_with(&cx, Span::from_static(&cx, "&*")) { self.value_name(&cx, arg.skip(2usize)) } else { self.cname(&cx, entry.label, root(&cx, arg)) };
                    moves.push(&cx, Move.{ dst: self.cname(&cx, entry.label, binding.name), ty: binding.type, place: true, value: self.operand(&cx, arg), base });
                } else if !place && plan.is_live(&cx, entry.label, binding.name) {
                    moves.push(&cx, Move.{ dst: self.cname(&cx, entry.label, binding.name), ty: binding.type, place: false, value: self.value_name(&cx, arg), base: self.value_base(&cx, arg) });
                }
                p = p + 1usize;
            }
            self.assign(&cx, &lines, moves, Span::from_static(&cx, ""));
            line(&lines, Buffer!::new().push_static("goto ").push_bytes(&cx, self.labels.copy(&cx).at(&cx, entry.label)).push_static(";"));
            return true;
        }
        let (ret, _noreturn, all_params) = self.heads.at(&cx, current);
        let callee_ret = subst(&cx, fun.ret, sub, self.counter);
        let places = fun.places(&cx);
        let callee_params: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
        var t = 0usize;
        while t < fun.ptypes.len(&cx) {
            let ct = self.c(&cx, subst(&cx, fun.ptypes.at(&cx, t), sub, self.counter));
            if !ct.is(&cx, "void") {
                callee_params.push(&cx, Buffer!::new().push_bytes(&cx, ct).push_static(if places.contains(&cx, t) { "*" } else { "" }).save(&cx));
            }
            t = t + 1usize;
        }
        let params: ArenaVec[CParam['k], 'k] = ArenaVec::new(&cx);
        var q = 0usize;
        while q < all_params.len(&cx) {
            if !all_params.at(&cx, q).ctype.is(&cx, "void") {
                params.push(&cx, all_params.at(&cx, q));
            }
            q = q + 1usize;
        }
        var same = !is_never(callee_ret) && self.c(&cx, callee_ret).eq(&cx, ret) && callee_params.len(&cx) == params.len(&cx);
        var s = 0usize;
        while same && s < params.len(&cx) {
            let cp = params.at(&cx, s);
            if !callee_params.at(&cx, s).eq(&cx, Buffer!::new().push_bytes(&cx, cp.ctype).push_static(if cp.place { "*" } else { "" }).save(&cx)) {
                same = false;
            }
            s = s + 1usize;
        }
        var scalar = is_scalar(&cx, ret);
        var c = 0usize;
        while c < callee_params.len(&cx) {
            if !is_scalar(&cx, callee_params.at(&cx, c)) {
                scalar = false;
            }
            c = c + 1usize;
        }
        if !same || self.the_plan(&cx).has_alloca(&cx) || !scalar {
            return false;
        }
        self.lend(&cx, Option::Some.(symbol), args);
        line(&lines, Buffer!::new().push_static("KUR_MUSTTAIL return ").push_bytes(&cx, symbol).push_static("(").push_bytes(&cx, self.operands(&cx, &lines, args, ArenaVec::new(&cx))).push_static(");"));
        true
    }

    // ----------------------------------------------------------------- qualifiers --

    // The place parameters that are `const` and that are `restrict`: see `qualifiers` in cgen.py,
    // which states why.
    fn qualifiers(self, &cx: Domain!['k]) -> (ArenaSet[(Span['k], usize), 'k], ArenaSet[(Span['k], usize), 'k]) {
        let const_params: ArenaSet[(Span['k], usize), 'k] = ArenaSet::new(&cx);
        let restrict_params: ArenaSet[(Span['k], usize), 'k] = ArenaSet::new(&cx);
        var h = 0usize;
        while h < self.heads.positions(&cx) {
            match self.heads.key_at(&cx, h) {
                Option::Some(s) => {
                    let (_ret, _noreturn, params) = self.heads.at(&cx, s);
                    var k = 0usize;
                    while k < params.len(&cx) {
                        if params.at(&cx, k).place && !self.address_taken.contains(&cx, s) {
                            if !self.written.contains(&cx, (s, k)) {
                                let added = const_params.insert(&cx, (s, k));
                            }
                            if !self.looping.contains(&cx, s) {
                                let added = restrict_params.insert(&cx, (s, k));
                            }
                        }
                        k = k + 1usize;
                    }
                },
                Option::None => (),
            };
            h = h + 1usize;
        }
        var changed = true;
        while changed {
            changed = false;
            var l = 0usize;
            while l < self.lends.len(&cx) {
                let (callee, k, kind, caller, j) = self.lends.at(&cx, l);
                if restrict_params.contains(&cx, (callee, k))
                    && (kind.is(&cx, "raw") || kind.is(&cx, "param") && !restrict_params.contains(&cx, (caller, j))) {
                    let removed = restrict_params.remove(&cx, (callee, k));
                    changed = true;
                }
                if kind.is(&cx, "param") && const_params.contains(&cx, (caller, j)) && !const_params.contains(&cx, (callee, k)) {
                    let removed = const_params.remove(&cx, (caller, j));
                    changed = true;
                }
                l = l + 1usize;
            }
        }
        (const_params, restrict_params)
    }
}

forall 'k.
fn wrap(&cx: Domain!['k], expr: Span['k], suffix: Option[Span['k]], ct: Span['k]) -> Span['k] {
    match suffix {
        Option::Some(s) => Buffer!::new().push_static("kur_dec_i").push_bytes(&cx, s).push_static("(").push_bytes(&cx, expr).push_static(")").save(&cx),
        Option::None => Buffer!::new().push_static("(").push_bytes(&cx, ct).push_static(")(").push_bytes(&cx, expr).push_static(")").save(&cx),
    }
}

forall 'k.
fn last_member(&cx: Domain!['k], members: ArenaVec[Member['k], 'k], name: Span['k]) -> Type['k] {
    var found: Option[Type['k]] = Option::None;
    var i = 0usize;
    while i < members.len(&cx) {
        if members.at(&cx, i).name.eq(&cx, name) {
            found = Option::Some.(members.at(&cx, i).type);
        }
        i = i + 1usize;
    }
    match found {
        Option::Some(t) => t,
        Option::None => fail_text(&cx, Span::from_static(&cx, "internal error: no such variant")),
    }
}

// One foreach instruction's mapping of its rows: the transform at the specialization, the operand's
// type when it is mapped (the map form), the mapper, its own type arguments, the captured values
// that pass something (as the mapper takes them, and as values), and whether the source is a
// pointer whose components are pointers.
forall 'k.
exposed struct Walk {
    backend: Backend['k],
    t: ForeachType['k],
    mapped: Option[ForeachType['k]],
    mapper: Fun['k],
    mapper_name: Span['k],
    own: ArenaVec[Type['k], 'k],
    caps: ArenaVec[Span['k], 'k],
    values: ArenaVec[Span['k], 'k],
    pointer: bool,
}

forall 'k.
impl Walk['k] {
    fn apply(self, &cx: Domain!['k], row: Row['k], component: Span['k]) -> Span['k] {
        let bound = self.backend.types.binding(&cx, self.t, row.item);
        // What the mapper is given: the source's component, or the mapped operand's at this row.
        let given = match self.mapped {
            Option::Some(o) => mapped_component(&cx, o, bound, self.backend.counter),
            Option::None => row.item,
        };
        let sub: ArenaMap[Span['k], Type['k], 'k] = ArenaMap::new(&cx);
        sub.insert(&cx, self.mapper.params.at(&cx, 0usize).name, bound);
        var j = 1usize;
        while j < self.mapper.params.len(&cx) && j - 1usize < self.own.len(&cx) {
            sub.insert(&cx, self.mapper.params.at(&cx, j).name, self.own.at(&cx, j - 1usize));
            j = j + 1usize;
        }
        let symbol = self.backend.request(&cx, FunKey::Function.(self.mapper_name), self.mapper, sub);
        let arguments: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
        if !self.backend.outs.at(&cx, symbol).is_empty(&cx) {
            // A mapper writing elements of its result through out pointers is called through its
            // by-value entry, which returns the whole result.
            let added = self.backend.address_taken.insert(&cx, symbol);
            let thunk = match self.backend.thunks.get(&cx, symbol) {
                Option::Some(known) => known,
                Option::None => {
                    let made = allocate(&cx, Buffer!::new().push_bytes(&cx, symbol).push_static("_value").save(&cx), self.backend.taken);
                    self.backend.thunks.insert(&cx, symbol, made);
                    made
                },
            };
            if self.pointer || !self.backend.erased(&cx, given) {
                arguments.push(&cx, component);
            }
            arguments.append(&cx, self.values);
            return Buffer!::new().push_bytes(&cx, thunk).push_static("(").push_bytes(&cx, arguments.join(&cx, ", ")).push_static(")").save(&cx);
        }
        if self.pointer || !self.backend.erased(&cx, given) {
            if self.backend.by_ref.at(&cx, symbol).at(&cx, 0usize) {
                arguments.push(&cx, Buffer!::new().push_static("&").push_bytes(&cx, component).save(&cx));
            } else {
                arguments.push(&cx, component);
            }
        }
        arguments.append(&cx, self.caps);
        Buffer!::new().push_bytes(&cx, symbol).push_static("(").push_bytes(&cx, arguments.join(&cx, ", ")).push_static(")").save(&cx)
    }
}

forall 'k.
fn emit_c(&cx: Domain!['k], program: Program['k], typed: ArenaMap[FunKey['k], ArenaMap[(Span['k], Span['k]), Type['k], 'k], 'k], entry: Option[Span['k]], counter: Fresh['k], times: bool,
    split: bool, hosted: bool) -> CText!['k] {
    Backend::new(&cx, program, typed, counter, split).emit_program(&cx, entry, hosted, times)
}

// The place path or out pointer `away` sends component `k` to (`Backend::away`).
forall 'k.
fn home_of(&cx: Domain!['k], away: ArenaVec[(usize, Span['k]), 'k], k: usize) -> Option[Span['k]] {
    var i = 0usize;
    while i < away.len(&cx) {
        let (at, target) = away.at(&cx, i);
        if at == k {
            return Option::Some.(target);
        }
        i = i + 1usize;
    }
    Option::None
}

// Records that instruction `at` (or the terminator, at the block's length) reads `name`.
forall 'k.
fn read_at(&cx: Domain!['k], reads: ArenaMap[Span['k], ArenaVec[usize, 'k], 'k], name: Span['k], at: usize) {
    match reads.get(&cx, name) {
        Option::Some(found) => found.push(&cx, at),
        Option::None => {
            let fresh: ArenaVec[usize, 'k] = ArenaVec::new(&cx);
            fresh.push(&cx, at);
            reads.insert(&cx, name, fresh);
        },
    };
}

forall 'k.
fn reads_once(&cx: Domain!['k], reads: ArenaMap[Span['k], ArenaVec[usize, 'k], 'k], name: Span['k]) -> bool {
    match reads.get(&cx, name) {
        Option::Some(found) => found.len(&cx) == 1usize,
        Option::None => false,
    }
}

// An instruction of `block` from `start` on, or its terminator, names a path under `local`.
forall 'k.
fn names(&cx: Domain!['k], local: Span['k], block: Block['k], start: usize) -> bool {
    var i = start;
    while i < block.instrs.len(&cx) {
        let args = block.instrs.at(&cx, i).args;
        var g = 0usize;
        while g < args.len(&cx) {
            if is_place(&cx, args.at(&cx, g)) && root(&cx, args.at(&cx, g)).eq(&cx, local) {
                return true;
            }
            g = g + 1usize;
        }
        i = i + 1usize;
    }
    match block.term {
        Terminator::Switch(scrutinee, _ty, _arms, _pos) => is_place(&cx, scrutinee) && root(&cx, scrutinee).eq(&cx, local),
        _ => false,
    }
}

// `local` is empty or named no more from instruction `at` of `block` on, or `path` is empty.
forall 'k.
fn apart(&cx: Domain!['k], empty: ArenaSet[Span['k], 'k], local: Span['k], path: Span['k], block: Block['k], at: usize,
    blocks: ArenaMap[Span['k], Block['k], 'k], reach: ArenaMap[Span['k], ArenaSet[Span['k], 'k], 'k]) -> bool {
    var m = 0usize;
    while m < empty.positions(&cx) {
        match empty.key_at(&cx, m) {
            Option::Some(e) => if prefix(&cx, e, local) || prefix(&cx, e, path) {
                return true;
            },
            Option::None => (),
        };
        m = m + 1usize;
    }
    if names(&cx, local, block, at) {
        return false;
    }
    let reached = reach.at(&cx, block.label);
    var r = 0usize;
    while r < reached.positions(&cx) {
        match reached.key_at(&cx, r) {
            Option::Some(label) => if names(&cx, local, blocks.at(&cx, label), 0usize) {
                return false;
            },
            Option::None => (),
        };
        r = r + 1usize;
    }
    true
}

// A path, rewritten under the path its local place shares (`homes`).
forall 'k.
fn rehome(&cx: Domain!['k], homes: ArenaMap[Span['k], Span['k], 'k], arg: Span['k]) -> Span['k] {
    if !is_place(&cx, arg) {
        return arg;
    }
    let local = root(&cx, arg);
    match homes.get(&cx, local) {
        Option::Some(path) => Buffer!::new().push_bytes(&cx, path).push_bytes(&cx, arg.skip(local.len())).save(&cx),
        Option::None => arg,
    }
}

// `fun` with each path under a local place of `homes` rewritten under the path it shares.
forall 'k.
fn homed(&cx: Domain!['k], fun: Fun['k], homes: ArenaMap[Span['k], Span['k], 'k]) -> Fun['k] {
    let blocks: ArenaVec[Block['k], 'k] = ArenaVec::new(&cx);
    var b = 0usize;
    while b < fun.blocks.len(&cx) {
        let block = fun.blocks.at(&cx, b);
        let instrs: ArenaVec[Instr['k], 'k] = ArenaVec::new(&cx);
        var i = 0usize;
        while i < block.instrs.len(&cx) {
            let instr = block.instrs.at(&cx, i);
            let args: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
            var g = 0usize;
            while g < instr.args.len(&cx) {
                args.push(&cx, rehome(&cx, homes, instr.args.at(&cx, g)));
                g = g + 1usize;
            }
            let { args: _old, ..rest } = instr;
            instrs.push(&cx, Instr.{ args, ..rest });
            i = i + 1usize;
        }
        let term = match block.term {
            Terminator::Switch(scrutinee, ty, arms, pos) => Terminator::Switch.(rehome(&cx, homes, scrutinee), ty, arms, pos),
            _ => block.term,
        };
        let { instrs: _instrs, term: _term, ..rest } = block;
        blocks.push(&cx, Block.{ instrs, term, ..rest });
        b = b + 1usize;
    }
    let locals: ArenaVec[Binding['k], 'k] = ArenaVec::new(&cx);
    var l = 0usize;
    while l < fun.locals.len(&cx) {
        if !homes.contains(&cx, fun.locals.at(&cx, l).name) {
            locals.push(&cx, fun.locals.at(&cx, l));
        }
        l = l + 1usize;
    }
    let { blocks: _blocks, locals: _locals, ..rest } = fun;
    Fun.{ blocks, locals, ..rest }
}
