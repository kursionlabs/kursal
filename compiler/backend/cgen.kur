// Checked KURS to C, by the canonical profile: no optimization, one C local per SSA definition,
// places as fixed C objects, parallel edge assignment.
//
// Generic functions are specialized on demand by logical type arguments. Representation erasure is
// separate from code-specialization identity.

use package::support::base::{Cell, Cx, Map, Out, Seq, Set, Text, key_same, text};
use package::check::checker::{Checker, FunKey};
use package::kurs::core::{Arm, Block, Data, Edge, Fun, ForeachType, Instr, Member, Param, Program, Terminator, Type};
use package::kurs::core as C;
use package::backend::mangle::{decode_segment, encode, mangle, path_segments, type_key};
use package::kurs::sexpr::Form;
use package::syntax::ast::{Pos, no_pos};
use package::types::termination::check_mono_termination;
use package::types::ops::{Fresh, Row, Types, equal, foreach_binders, kurs_error, map_children, subst, subst_foreach};
use std::option::Option;
use std::slice::Slice;

forall 'k.
fn prelude(&cx: Cx!['k]) -> Text['k] {
    Out::new(&cx)
        .put(&cx, "#include <stddef.h>\n")
        .put(&cx, "#include <stdint.h>\n")
        .put(&cx, "typedef struct { unsigned char dummy; } KurUnit;\n")
        .put(&cx, "#define KUR_TRAP() __builtin_trap()\n")
        .put(&cx, "/* A component's address by integer arithmetic: projection never dereferences, so it is defined for any\n")
        .put(&cx, "   pointer value, null and dangling included. The `__typeof__` operands are not evaluated. */\n")
        .put(&cx, "#define KUR_FIELD(p, m) ((__typeof__(&(p)->m))((uintptr_t)(p) + offsetof(__typeof__(*(p)), m)))\n")
        .put(&cx, "static inline int8_t kur_dec_i8(uint64_t b) { b &= 0xFF; return b < 0x80 ? (int8_t)b : (int8_t)((int64_t)b - 0x100); }\n")
        .put(&cx, "static inline int16_t kur_dec_i16(uint64_t b) { b &= 0xFFFF; return b < 0x8000 ? (int16_t)b : (int16_t)((int64_t)b - 0x10000); }\n")
        .put(&cx, "static inline int32_t kur_dec_i32(uint64_t b) { b &= 0xFFFFFFFF; return b < 0x80000000 ? (int32_t)b : (int32_t)((int64_t)b - 0x100000000); }\n")
        .put(&cx, "static inline int64_t kur_dec_i64(uint64_t b) { return b <= (uint64_t)INT64_MAX ? (int64_t)b : -INT64_C(1) - (int64_t)(UINT64_MAX - b); }\n")
        .done(&cx)
}

forall 'k.
fn c_prim(&cx: Cx!['k], name: Text['k]) -> Text['k] {
    if name.is(&cx, "bool") {
        text(&cx, "_Bool")
    } else if name.is(&cx, "f32") {
        text(&cx, "float")
    } else if name.is(&cx, "f64") {
        text(&cx, "double")
    } else if name.is(&cx, "usize") {
        text(&cx, "uint64_t")
    } else if name.is(&cx, "isize") {
        text(&cx, "int64_t")
    } else if name.byte(&cx, 0usize) == b'u' {
        Out::new(&cx).put(&cx, "uint").add(&cx, name.from(1usize)).put(&cx, "_t").done(&cx)
    } else {
        Out::new(&cx).put(&cx, "int").add(&cx, name.from(1usize)).put(&cx, "_t").done(&cx)
    }
}

// The width of a signed integer type, or 0 for any other.
forall 'k.
fn signed_bits(&cx: Cx!['k], name: Text['k]) -> u32 {
    if name.byte(&cx, 0usize) == b'i' { C::integer_bits(&cx, name) } else { 0u32 }
}

forall 'k.
fn c_order(&cx: Cx!['k], order: Text['k]) -> Text['k] {
    let out = Out::new(&cx).put(&cx, "__ATOMIC_");
    var i = 0usize;
    while i < order.len() {
        let b = order.byte(&cx, i);
        let unit = out.byte(&cx, if b >= b'a' && b <= b'z' { b - 32u8 } else { b });
        i = i + 1usize;
    }
    out.done(&cx)
}

forall 'k.
fn c_op(&cx: Cx!['k], op: Text['k]) -> Text['k] {
    if op.is(&cx, "add") {
        text(&cx, "+")
    } else if op.is(&cx, "sub") {
        text(&cx, "-")
    } else if op.is(&cx, "mul") {
        text(&cx, "*")
    } else if op.is(&cx, "div") {
        text(&cx, "/")
    } else if op.is(&cx, "mod") {
        text(&cx, "%")
    } else if op.is(&cx, "bit_and") {
        text(&cx, "&")
    } else if op.is(&cx, "bit_or") {
        text(&cx, "|")
    } else if op.is(&cx, "bit_xor") {
        text(&cx, "^")
    } else if op.is(&cx, "eq") {
        text(&cx, "==")
    } else if op.is(&cx, "ne") {
        text(&cx, "!=")
    } else if op.is(&cx, "lt") {
        text(&cx, "<")
    } else if op.is(&cx, "le") {
        text(&cx, "<=")
    } else if op.is(&cx, "gt") {
        text(&cx, ">")
    } else {
        text(&cx, ">=")
    }
}

forall 'k.
fn is_c_op(&cx: Cx!['k], op: Text['k]) -> bool {
    op.is(&cx, "add") || op.is(&cx, "sub") || op.is(&cx, "mul") || op.is(&cx, "div") || op.is(&cx, "mod") || op.is(&cx, "bit_and") || op.is(&cx, "bit_or")
        || op.is(&cx, "bit_xor") || op.is(&cx, "eq") || op.is(&cx, "ne") || op.is(&cx, "lt") || op.is(&cx, "le") || op.is(&cx, "gt") || op.is(&cx, "ge")
}

forall 'k.
fn add_words(&cx: Cx!['k], set: Set[Text['k], 'k], words: Slice[u8, 'static]) {
    let all = text(&cx, words).split(&cx, text(&cx, " "));
    var i = 0usize;
    while i < all.len(&cx) {
        set.add(&cx, all.get(&cx, i));
        i = i + 1usize;
    }
}

forall 'k.
fn c_keywords(&cx: Cx!['k]) -> Set[Text['k], 'k] {
    let out: Set[Text['k], 'k] = Set::new(&cx);
    add_words(&cx, out, "auto break case char const continue default do double else enum extern float for goto if");
    add_words(&cx, out, "inline int long register restrict return short signed sizeof static struct switch typedef");
    add_words(&cx, out, "union unsigned void volatile while _Alignas _Alignof _Atomic _Bool _Complex _Generic");
    add_words(&cx, out, "_Imaginary _Noreturn _Static_assert _Thread_local");
    out
}

forall 'k.
fn runtime_names(&cx: Cx!['k]) -> Set[Text['k], 'k] {
    let out: Set[Text['k], 'k] = Set::new(&cx);
    add_words(&cx, out, "KurUnit KUR_TRAP kur_dec_i8 kur_dec_i16 kur_dec_i32 kur_dec_i64");
    add_words(&cx, out, "SIZE_MAX PTRDIFF_MIN PTRDIFF_MAX SIG_ATOMIC_MIN SIG_ATOMIC_MAX WCHAR_MIN WCHAR_MAX WINT_MIN WINT_MAX");
    add_words(&cx, out, "__ATOMIC_RELAXED __ATOMIC_ACQUIRE __ATOMIC_RELEASE __ATOMIC_ACQ_REL __ATOMIC_SEQ_CST");
    let stems = text(&cx, "8 16 32 64 _LEAST8 _LEAST16 _LEAST32 _LEAST64 _FAST8 _FAST16 _FAST32 _FAST64 PTR MAX").split(&cx, text(&cx, " "));
    let suffixes = text(&cx, "MIN MAX C WIDTH").split(&cx, text(&cx, " "));
    var i = 0usize;
    while i < stems.len(&cx) {
        let stem = stems.get(&cx, i);
        var u = 0usize;
        while u < 2usize {
            let unsigned = if u == 1usize { text(&cx, "U") } else { text(&cx, "") };
            out.add(&cx, Out::new(&cx).add(&cx, lower(&cx, unsigned)).put(&cx, "int").add(&cx, lower(&cx, stem)).put(&cx, "_t").done(&cx));
            var s = 0usize;
            while s < suffixes.len(&cx) {
                out.add(&cx, Out::new(&cx).add(&cx, unsigned).put(&cx, "INT").add(&cx, stem).put(&cx, "_").add(&cx, suffixes.get(&cx, s)).done(&cx));
                s = s + 1usize;
            }
            u = u + 1usize;
        }
        i = i + 1usize;
    }
    out
}

forall 'k.
fn lower(&cx: Cx!['k], t: Text['k]) -> Text['k] {
    let out = Out::new(&cx);
    var i = 0usize;
    while i < t.len() {
        let b = t.byte(&cx, i);
        let unit = out.byte(&cx, if b >= b'A' && b <= b'Z' { b + 32u8 } else { b });
        i = i + 1usize;
    }
    out.done(&cx)
}

fn is_digit(b: u8) -> bool {
    b >= b'0' && b <= b'9'
}

fn is_word_byte(b: u8) -> bool {
    is_digit(b) || b >= b'A' && b <= b'Z' || b >= b'a' && b <= b'z' || b == b'_'
}

// The identifiers taken in one namespace. Many functions spell their locals alike, so for each
// base `last` remembers the highest numbered spelling `allocate` has tried: names are never
// released, so every lower number is still taken, and the search resumes after it.
forall 'k.
exposed struct Pool {
    taken: Set[Text['k], 'k],
    last: Map[Text['k], usize, 'k],
}

forall 'k.
impl Pool['k] {
    fn new(&cx: Cx!['k], taken: Set[Text['k], 'k]) -> Pool['k] {
        Pool.{ taken, last: Map::new(&cx) }
    }
}

// Allocate a C identifier; the readable spelling is only a hint.
forall 'k.
fn allocate(&cx: Cx!['k], base: Text['k], pool: Pool['k]) -> Text['k] {
    let start = if is_digit(base.byte(&cx, 0usize)) { Out::new(&cx).put(&cx, "k_").add(&cx, base).done(&cx) } else { base };
    var name = start;
    if pool.taken.has(&cx, name) {
        var index = pool.last.get_or(&cx, start, 0usize);
        var going = true;
        while going {
            index = index + 1usize;
            name = Out::new(&cx).add(&cx, start).put(&cx, "_").usize(&cx, index).done(&cx);
            going = pool.taken.has(&cx, name);
        }
        pool.last.set(&cx, start, index);
    }
    pool.taken.add(&cx, name);
    name
}

// Decode the linker's hex-encoded identity segments, then make a C identifier.
forall 'k.
fn readable(&cx: Cx!['k], name: Text['k]) -> Text['k] {
    let joined = Out::new(&cx);
    let pieces = name.split(&cx, text(&cx, "::"));
    var i = 0usize;
    while i < pieces.len(&cx) {
        if i > 0usize {
            let unit = joined.put(&cx, "_");
        }
        let unit = joined.add(&cx, match decode_segment(&cx, pieces.get(&cx, i)) {
            Option::Some(bytes) => bytes,
            Option::None => pieces.get(&cx, i),
        });
        i = i + 1usize;
    }
    // Every character outside [A-Za-z0-9_] becomes one `_`; the text is UTF-8, so a character's
    // continuation bytes add nothing.
    let all = joined.done(&cx);
    let out = Out::new(&cx);
    var j = 0usize;
    while j < all.len() {
        let b = all.byte(&cx, j);
        if is_word_byte(b) {
            let unit = out.byte(&cx, b);
        } else if (b & 192u8) != 128u8 {
            let unit = out.put(&cx, "_");
        }
        j = j + 1usize;
    }
    let made = out.done(&cx);
    var start = 0usize;
    var end = made.len();
    while start < end && made.byte(&cx, start) == b'_' {
        start = start + 1usize;
    }
    while end > start && made.byte(&cx, end - 1usize) == b'_' {
        end = end - 1usize;
    }
    if start == end { text(&cx, "x") } else { made.slice(start, end) }
}

// The last `n` characters of ASCII text.
forall 'k.
fn tail(t: Text['k], n: usize) -> Text['k] {
    if t.len() > n { t.from(t.len() - n) } else { t }
}

// The representation key: brands erased, packages unwrapped, transforms expanded.
forall 'k.
fn erase(&cx: Cx!['k], ty: Type['k], types: Types['k]) -> Type['k] {
    match ty {
        Type::Skolem(_label) => Type::Skolem.(text(&cx, "_")),
        Type::Brand(_brand) => C::unit(&cx),
        Type::Exists(_binders, body) => erase(&cx, body.get(&cx), types),
        Type::Foreach(f) => erase(&cx, types.expand(&cx, f, Option::None), types),
        Type::Fn(f) => {
            let params: Seq[Type['k], 'k] = Seq::new(&cx);
            var i = 0usize;
            while i < f.params.len(&cx) {
                params.push(&cx, erase(&cx, f.params.get(&cx, i), types));
                i = i + 1usize;
            }
            C::fn_type(&cx, params, erase(&cx, f.ret.get(&cx), types), Seq::new(&cx), false, f.places)
        },
        _ => map_children(&cx, ty, |&cx, child: Type['k]| erase(&cx, child, types)),
    }
}

forall 'k.
fn is_never(t: Type['k]) -> bool {
    match t {
        Type::Never => true,
        _ => false,
    }
}

forall 'k.
fn is_ptr(t: Type['k]) -> bool {
    match t {
        Type::Ptr(_inner) => true,
        _ => false,
    }
}

forall 'k.
fn is_foreach(t: Type['k]) -> bool {
    match t {
        Type::Foreach(_f) => true,
        _ => false,
    }
}

forall 'k.
fn joined(&cx: Cx!['k], parts: Seq[Text['k], 'k], separator: Slice[u8, 'static]) -> Text['k] {
    let out = Out::new(&cx);
    var i = 0usize;
    while i < parts.len(&cx) {
        if i > 0usize {
            let unit = out.put(&cx, separator);
        }
        let unit = out.add(&cx, parts.get(&cx, i));
        i = i + 1usize;
    }
    out.done(&cx)
}

forall 'k.
fn or_void(&cx: Cx!['k], t: Text['k]) -> Text['k] {
    if t.is_empty() { text(&cx, "void") } else { t }
}

// A C identifier: `[A-Za-z_][A-Za-z0-9_]*`.
forall 'k.
fn is_c_identifier(&cx: Cx!['k], t: Text['k]) -> bool {
    if t.is_empty() || is_digit(t.byte(&cx, 0usize)) {
        return false;
    }
    var i = 0usize;
    while i < t.len() {
        if !is_word_byte(t.byte(&cx, i)) {
            return false;
        }
        i = i + 1usize;
    }
    true
}

// Python's `repr` of a string: quoted, with backslashes, the quote and control characters escaped.
forall 'k.
fn repr(&cx: Cx!['k], t: Text['k]) -> Text['k] {
    let quote = if t.contains(&cx, text(&cx, "'")) && !t.contains(&cx, text(&cx, "\"")) { b'"' } else { b'\'' };
    let out = Out::new(&cx).byte(&cx, quote);
    let digits = text(&cx, "0123456789abcdef");
    var i = 0usize;
    while i < t.len() {
        let b = t.byte(&cx, i);
        if b == b'\\' || b == quote {
            let unit = out.byte(&cx, b'\\').byte(&cx, b);
        } else if b == b'\n' {
            let unit = out.put(&cx, "\\n");
        } else if b == b'\r' {
            let unit = out.put(&cx, "\\r");
        } else if b == b'\t' {
            let unit = out.put(&cx, "\\t");
        } else if b < 32u8 || b == 127u8 {
            let unit = out.put(&cx, "\\x").byte(&cx, digits.byte(&cx, (b / 16u8) as usize)).byte(&cx, digits.byte(&cx, (b % 16u8) as usize));
        } else {
            let unit = out.byte(&cx, b);
        }
        i = i + 1usize;
    }
    out.byte(&cx, quote).done(&cx)
}

forall 'k.
fn member_names(&cx: Cx!['k], members: Seq[(Text['k], Type['k]), 'k]) -> Seq[Text['k], 'k] {
    let out: Seq[Text['k], 'k] = Seq::new(&cx);
    var i = 0usize;
    while i < members.len(&cx) {
        let (m, _t) = members.get(&cx, i);
        out.push(&cx, m);
        i = i + 1usize;
    }
    out
}

forall 'k.
fn items_access(&cx: Cx!['k], count: usize) -> Seq[Text['k], 'k] {
    let out: Seq[Text['k], 'k] = Seq::new(&cx);
    var k = 0usize;
    while k < count {
        out.push(&cx, Out::new(&cx).put(&cx, "items[").usize(&cx, k).put(&cx, "]").done(&cx));
        k = k + 1usize;
    }
    out
}

forall 'k.
exposed struct Backend {
    program: Program['k],
    checker: Checker['k],
    counter: Fresh['k],
    types: Types['k],
    // representation key -> C type name
    names: Map[Type['k], Text['k], 'k],
    // a type as written -> its C type, once `ctype` has named and defined it
    ctypes: Map[Type['k], Text['k], 'k],
    // a name -> `readable` of it
    readables: Map[Text['k], Text['k], 'k],
    // named but not yet defined aggregates
    pending: Map[Type['k], Type['k], 'k],
    forward: Seq[Text['k], 'k],
    defs: Seq[Text['k], 'k],
    // specialization key (function, type arguments) -> C symbol
    symbols: Seq[(FunKey['k], Seq[Type['k], 'k], Text['k]), 'k],
    // the same, by structure: an earlier request with these very arguments
    symbol_index: Map[(FunKey['k], Seq[Type['k], 'k]), Text['k], 'k],
    queue: Seq[(FunKey['k], Fun['k], Map[Text['k], Type['k], 'k], Text['k]), 'k],
    bodies: Seq[Text['k], 'k],
    protos: Seq[Text['k], 'k],
    datas: Map[Text['k], (Text['k], Data['k]), 'k],
    // One conservative pool for ordinary identifiers, including function locals: later global
    // declarations must not be shadowed by earlier locals.
    taken: Pool['k],
    component_names: Map[(Text['k], Text['k]), Text['k], 'k],
    component_taken: Pool['k],
    foreign_adapters: Map[Text['k], Text['k], 'k],
    instance_params: Map[FunKey['k], Seq[Param['k], 'k], 'k],
    function_ids: Map[FunKey['k], (Seq[Text['k], 'k], Text['k]), 'k],
    // the function being emitted
    fun: Cell[Option[Fun['k]], 'k],
    sub: Cell[Map[Text['k], Type['k], 'k], 'k],
    // types under `sub`, when substituting renamed no binder
    substituted: Cell[Map[Type['k], Type['k], 'k], 'k],
    locals: Cell[Map[(Text['k], Text['k]), Text['k], 'k], 'k],
    lines: Cell[Seq[Text['k], 'k], 'k],
    scratch: Cell[usize, 'k],
    labels: Cell[Map[Text['k], Text['k], 'k], 'k],
    decls: Cell[Seq[Text['k], 'k], 'k],
    place_c: Cell[Map[Text['k], Text['k], 'k], 'k],
    roots: Cell[Map[Text['k], Type['k], 'k], 'k],
    typed: Cell[Map[(Text['k], Text['k]), Type['k], 'k], 'k],
    blocks: Cell[Map[Text['k], Block['k], 'k], 'k],
    label: Cell[Text['k], 'k],
}

forall 'k.
fn fail_at(&cx: Cx!['k], message: Text['k], pos: Pos) -> ! {
    kurs_error(&cx, message, pos)
}

forall 'k.
fn fail_text(&cx: Cx!['k], message: Text['k]) -> ! {
    kurs_error(&cx, message, no_pos())
}

forall 'k.
impl Backend['k] {
    fn new(&cx: Cx!['k], program: Program['k], checker: Checker['k], counter: Fresh['k]) -> Backend['k] {
        let taken = c_keywords(&cx);
        let runtime = runtime_names(&cx).items(&cx);
        var r = 0usize;
        while r < runtime.len(&cx) {
            taken.add(&cx, runtime.get(&cx, r));
            r = r + 1usize;
        }
        taken.add(&cx, text(&cx, "main"));
        let externs = program.externs.values(&cx);
        var e = 0usize;
        while e < externs.len(&cx) {
            taken.add(&cx, externs.get(&cx, e).name);
            e = e + 1usize;
        }
        let function_ids: Map[FunKey['k], (Seq[Text['k], 'k], Text['k]), 'k] = Map::new(&cx);
        let funs = program.funs.values(&cx);
        var f = 0usize;
        while f < funs.len(&cx) {
            let name = funs.get(&cx, f).name;
            function_ids.set(&cx, FunKey::Function.(name), (path_segments(&cx, name), encode(&cx, Seq::two(&cx, text(&cx, "function"), name))));
            f = f + 1usize;
        }
        let instance_params: Map[FunKey['k], Seq[Param['k], 'k], 'k] = Map::new(&cx);
        let groups = program.instances.keys(&cx);
        var g = 0usize;
        while g < groups.len(&cx) {
            let insts = program.instances.at(&cx, groups.get(&cx, g));
            var i = 0usize;
            while i < insts.len(&cx) {
                let inst = insts.get(&cx, i);
                let scope: Seq[Text['k], 'k] = Seq::new(&cx);
                var p = 0usize;
                while p < inst.params.len(&cx) {
                    scope.push(&cx, inst.params.get(&cx, p).name);
                    p = p + 1usize;
                }
                let head_keys: Seq[Text['k], 'k] = Seq::new(&cx);
                var h = 0usize;
                while h < inst.head.len(&cx) {
                    head_keys.push(&cx, type_key(&cx, inst.head.get(&cx, h), scope));
                    h = h + 1usize;
                }
                let head = encode(&cx, head_keys);
                var m = 0usize;
                while m < inst.methods.len(&cx) {
                    let fun = inst.methods.get(&cx, m);
                    let key = FunKey::Method.(groups.get(&cx, g), i, fun.name);
                    let params = inst.params.copy(&cx);
                    params.append(&cx, fun.params);
                    instance_params.set(&cx, key, params);
                    let path = path_segments(&cx, inst.trait_name);
                    path.push(&cx, text(&cx, "impl"));
                    path.append(&cx, path_segments(&cx, fun.name));
                    let identity = Seq::two(&cx, text(&cx, "instance"), inst.trait_name);
                    identity.push(&cx, head);
                    identity.push(&cx, fun.name);
                    function_ids.set(&cx, key, (path, encode(&cx, identity)));
                    m = m + 1usize;
                }
                i = i + 1usize;
            }
            g = g + 1usize;
        }
        Backend.{
            program,
            checker,
            counter,
            types: Types::new(&cx, program, counter),
            names: Map::new(&cx),
            ctypes: Map::new(&cx),
            readables: Map::new(&cx),
            pending: Map::new(&cx),
            forward: Seq::new(&cx),
            defs: Seq::new(&cx),
            symbols: Seq::new(&cx),
            symbol_index: Map::new(&cx),
            queue: Seq::new(&cx),
            bodies: Seq::new(&cx),
            protos: Seq::new(&cx),
            datas: Map::new(&cx),
            taken: Pool::new(&cx, taken),
            component_names: Map::new(&cx),
            component_taken: Pool::new(&cx, Set::new(&cx)),
            foreign_adapters: Map::new(&cx),
            instance_params,
            function_ids,
            fun: Cell::new(&cx, Option::None),
            sub: Cell::new(&cx, Map::new(&cx)),
            substituted: Cell::new(&cx, Map::new(&cx)),
            locals: Cell::new(&cx, Map::new(&cx)),
            lines: Cell::new(&cx, Seq::new(&cx)),
            scratch: Cell::new(&cx, 0usize),
            labels: Cell::new(&cx, Map::new(&cx)),
            decls: Cell::new(&cx, Seq::new(&cx)),
            place_c: Cell::new(&cx, Map::new(&cx)),
            roots: Cell::new(&cx, Map::new(&cx)),
            typed: Cell::new(&cx, Map::new(&cx)),
            blocks: Cell::new(&cx, Map::new(&cx)),
            label: Cell::new(&cx, text(&cx, "")),
        }
    }

    // ------------------------------------------------------------ representations --

    // `readable(name)`, made once per name.
    fn readable(self, &cx: Cx!['k], name: Text['k]) -> Text['k] {
        match self.readables.get(&cx, name) {
            Option::Some(known) => known,
            Option::None => {
                let made = readable(&cx, name);
                self.readables.set(&cx, name, made);
                made
            },
        }
    }

    fn fresh_name(self, &cx: Cx!['k], hint: Text['k]) -> Text['k] {
        allocate(&cx, Out::new(&cx).put(&cx, "K_").add(&cx, tail(self.readable(&cx, hint), 48usize)).done(&cx), self.taken)
    }

    // The C type of `ty`; through a pointer, an aggregate needs only its name.
    fn ctype(self, &cx: Cx!['k], ty: Type['k], defined: bool) -> Text['k] {
        match self.ctypes.get(&cx, ty) {
            Option::Some(known) => return known,
            Option::None => (),
        }
        let name = self.ctype_of(&cx, ty, defined);
        if defined {
            self.ctypes.set(&cx, ty, name);
        }
        name
    }

    fn ctype_of(self, &cx: Cx!['k], ty: Type['k], defined: bool) -> Text['k] {
        let ty = erase(&cx, ty, self.types);
        match ty {
            Type::Prim(name) => {
                return c_prim(&cx, name);
            },
            Type::Never => {
                return text(&cx, "void");
            },
            Type::Ptr(inner) => {
                let inner = erase(&cx, inner.get(&cx), self.types);
                return if is_never(inner) { text(&cx, "void*") } else { Out::new(&cx).add(&cx, self.ctype(&cx, inner, false)).put(&cx, "*").done(&cx) };
            },
            _ => (),
        };
        if !self.names.has(&cx, ty) {
            self.register(&cx, ty);
        }
        if defined && self.pending.has(&cx, ty) {
            self.define(&cx, ty);
        }
        self.names.at(&cx, ty)
    }

    fn c(self, &cx: Cx!['k], ty: Type['k]) -> Text['k] {
        self.ctype(&cx, ty, true)
    }

    fn register(self, &cx: Cx!['k], ty: Type['k]) {
        let s = match ty {
            Type::Named(_name, _args) => self.types.shape(&cx, ty, Option::None),
            _ => ty,
        };
        match s {
            Type::Tuple(elems) => {
                if elems.is_empty(&cx) {
                    self.names.set(&cx, ty, text(&cx, "KurUnit"));
                } else {
                    self.aggregate(&cx, ty, s, text(&cx, "tuple"));
                }
            },
            Type::Struct(fields) => {
                if fields.is_empty(&cx) {
                    self.names.set(&cx, ty, text(&cx, "KurUnit"));
                } else {
                    self.aggregate(&cx, ty, s, text(&cx, "struct"));
                }
            },
            Type::Array(_elem, _length) => self.aggregate(&cx, ty, s, text(&cx, "array")),
            Type::Enum(_variants) => self.aggregate(&cx, ty, s, text(&cx, "enum")),
            Type::Fn(f) => {
                let name = self.fresh_name(&cx, text(&cx, "fn"));
                self.names.set(&cx, ty, name);
                // Function declarations may name forward-declared aggregates. Define their
                // fields after this typedef, which they may use.
                let ret = f.ret.get(&cx);
                let result = if is_never(ret) { text(&cx, "void") } else { self.ctype(&cx, ret, false) };
                let params: Seq[Text['k], 'k] = Seq::new(&cx);
                var k = 0usize;
                while k < f.params.len(&cx) {
                    let ct = self.ctype(&cx, f.params.get(&cx, k), false);
                    params.push(&cx, if f.places.has(&cx, k) { Out::new(&cx).add(&cx, ct).put(&cx, "*").done(&cx) } else { ct });
                    k = k + 1usize;
                }
                self.defs.push(&cx, Out::new(&cx).put(&cx, "typedef ").add(&cx, result).put(&cx, " (*").add(&cx, name).put(&cx, ")(").add(&cx, or_void(&cx, joined(&cx, params, ", "))).put(&cx, ");").done(&cx));
            },
            _ => {
                let name = self.c(&cx, s);
                self.names.set(&cx, ty, name);
            },
        };
    }

    fn aggregate(self, &cx: Cx!['k], ty: Type['k], s: Type['k], kind: Text['k]) {
        let hint = match ty {
            Type::Named(name, _args) => name,
            _ => kind,
        };
        let name = self.fresh_name(&cx, hint);
        self.names.set(&cx, ty, name);
        self.forward.push(&cx, Out::new(&cx).put(&cx, "typedef struct ").add(&cx, name).put(&cx, " ").add(&cx, name).put(&cx, ";").done(&cx));
        self.pending.set(&cx, ty, s);
    }

    fn define(self, &cx: Cx!['k], ty: Type['k]) {
        let s = self.pending.at(&cx, ty);
        self.pending.remove(&cx, ty);
        let body = match s {
            Type::Array(elem, length) => {
                if length != 0u64 {
                    Out::new(&cx).add(&cx, self.c(&cx, elem.get(&cx))).put(&cx, " items[").u64(&cx, length).put(&cx, "];").done(&cx)
                } else {
                    text(&cx, "unsigned char dummy;")
                }
            },
            Type::Enum(variants) => {
                let members: Seq[Text['k], 'k] = Seq::new(&cx);
                var i = 0usize;
                while i < variants.len(&cx) {
                    let ct = self.c(&cx, variants.get(&cx, i).type);
                    members.push(&cx, Out::new(&cx).add(&cx, ct).put(&cx, " ").add(&cx, self.variant(&cx, variants.get(&cx, i).name)).put(&cx, ";").done(&cx));
                    i = i + 1usize;
                }
                Out::new(&cx).put(&cx, "uint32_t tag; union { ").add(&cx, joined(&cx, members, " ")).put(&cx, " } payload;").done(&cx)
            },
            _ => {
                let rows = self.members(&cx, s);
                let parts: Seq[Text['k], 'k] = Seq::new(&cx);
                var i = 0usize;
                while i < rows.len(&cx) {
                    let (m, f) = rows.get(&cx, i);
                    parts.push(&cx, Out::new(&cx).add(&cx, self.c(&cx, f)).put(&cx, " ").add(&cx, m).put(&cx, ";").done(&cx));
                    i = i + 1usize;
                }
                joined(&cx, parts, " ")
            },
        };
        self.defs.push(&cx, Out::new(&cx).put(&cx, "struct ").add(&cx, self.names.at(&cx, ty)).put(&cx, " { ").add(&cx, body).put(&cx, " };").done(&cx));
    }

    // (C member, component type) of a struct or tuple shape, in order.
    fn members(self, &cx: Cx!['k], shape: Type['k]) -> Seq[(Text['k], Type['k]), 'k] {
        let out: Seq[(Text['k], Type['k]), 'k] = Seq::new(&cx);
        match shape {
            Type::Tuple(elems) => {
                var i = 0usize;
                while i < elems.len(&cx) {
                    out.push(&cx, (Out::new(&cx).put(&cx, "e").usize(&cx, i).done(&cx), elems.get(&cx, i)));
                    i = i + 1usize;
                }
            },
            Type::Struct(fields) => {
                var i = 0usize;
                while i < fields.len(&cx) {
                    out.push(&cx, (self.component(&cx, fields.get(&cx, i).name, text(&cx, "f")), fields.get(&cx, i).type));
                    i = i + 1usize;
                }
            },
            _ => fail_text(&cx, text(&cx, "internal error: members of a type that is not a struct or tuple")),
        };
        out
    }

    fn component(self, &cx: Cx!['k], name: Text['k], prefix: Text['k]) -> Text['k] {
        let key = (prefix, name);
        if !self.component_names.has(&cx, key) {
            self.component_names.set(&cx, key, allocate(&cx, Out::new(&cx).add(&cx, prefix).put(&cx, "_").add(&cx, self.readable(&cx, name)).done(&cx), self.component_taken));
        }
        self.component_names.at(&cx, key)
    }

    fn variant(self, &cx: Cx!['k], name: Text['k]) -> Text['k] {
        self.component(&cx, name, text(&cx, "v"))
    }

    fn shape(self, &cx: Cx!['k], ty: Type['k]) -> Type['k] {
        self.types.shape(&cx, erase(&cx, ty, self.types), Option::None)
    }

    fn is_unit(self, &cx: Cx!['k], ty: Type['k]) -> bool {
        self.c(&cx, ty).is(&cx, "KurUnit")
    }

    // ------------------------------------------------------------ specialization --

    fn request(self, &cx: Cx!['k], key: FunKey['k], fun: Fun['k], sub: Map[Text['k], Type['k], 'k]) -> Text['k] {
        let params = self.instance_params.get_or(&cx, key, fun.params);
        var agree = sub.len(&cx) == params.len(&cx);
        var p = 0usize;
        while agree && p < params.len(&cx) {
            agree = sub.has(&cx, params.get(&cx, p).name);
            p = p + 1usize;
        }
        if !agree {
            fail_text(&cx, Out::new(&cx).put(&cx, "specialization arguments disagree for ").add(&cx, fun.name).done(&cx));
        }
        let args: Seq[Type['k], 'k] = Seq::new(&cx);
        var a = 0usize;
        while a < params.len(&cx) {
            args.push(&cx, sub.at(&cx, params.get(&cx, a).name));
            a = a + 1usize;
        }
        // Logical alpha-equivalence, not representation equality. Capture-avoiding substitution
        // may freshen bound names on recursive requests. At most one earlier request is
        // alpha-equivalent to these arguments, so one with structurally equal arguments is it.
        match self.symbol_index.get(&cx, (key, args)) {
            Option::Some(symbol) => {
                return symbol;
            },
            Option::None => (),
        };
        var s = 0usize;
        while s < self.symbols.len(&cx) {
            let (identity, previous, symbol) = self.symbols.get(&cx, s);
            if key_same(&cx, identity, key) {
                var same = true;
                var i = 0usize;
                while same && i < args.len(&cx) && i < previous.len(&cx) {
                    same = equal(&cx, args.get(&cx, i), previous.get(&cx, i));
                    i = i + 1usize;
                }
                if same {
                    return symbol;
                }
            }
            s = s + 1usize;
        }
        let (path, function_id) = self.function_ids.at(&cx, key);
        let signature = C::fn_type(&cx, fun.ptypes, fun.ret, params, fun.is_unsafe, fun.places(&cx));
        let identity = Seq::two(&cx, function_id, type_key(&cx, signature, Seq::new(&cx)));
        var t = 0usize;
        while t < args.len(&cx) {
            identity.push(&cx, type_key(&cx, args.get(&cx, t), Seq::new(&cx)));
            t = t + 1usize;
        }
        let symbol = self.function_name(&cx, path, encode(&cx, identity));
        self.symbols.push(&cx, (key, args, symbol));
        self.symbol_index.set(&cx, (key, args), symbol);
        self.queue.push(&cx, (key, fun, sub.copy(&cx), symbol));
        symbol
    }

    fn function_name(self, &cx: Cx!['k], path: Seq[Text['k], 'k], identity: Text['k]) -> Text['k] {
        var salt = 0u64;
        var symbol = mangle(&cx, path, identity, salt);
        while self.taken.taken.has(&cx, symbol) {
            salt = salt + 1u64;
            symbol = mangle(&cx, path, identity, salt);
        }
        self.taken.taken.add(&cx, symbol);
        symbol
    }

    fn function_address(self, &cx: Cx!['k], instr: Instr['k]) -> Text['k] {
        let name = instr.args.get(&cx, 0usize);
        if self.program.externs.has(&cx, name) {
            return self.foreign_address(&cx, name);
        }
        let fun = self.program.funs.at(&cx, name);
        // Stable distinct rigid identities: not a wildcard and not static.
        let sub: Map[Text['k], Type['k], 'k] = Map::new(&cx);
        var k = 0usize;
        while k < fun.params.len(&cx) && k < instr.tys.len(&cx) {
            let t = instr.tys.get(&cx, k);
            let value = match t {
                Type::Ignored => {
                    let identity = Seq::two(&cx, text(&cx, "#retained"), fun.name);
                    identity.push(&cx, Out::new(&cx).usize(&cx, k).done(&cx));
                    Type::Skolem.(encode(&cx, identity))
                },
                _ => self.substitute_type(&cx, t),
            };
            sub.set(&cx, fun.params.get(&cx, k).name, value);
            k = k + 1usize;
        }
        self.request(&cx, FunKey::Function.(name), fun, sub)
    }

    fn foreign_address(self, &cx: Cx!['k], name: Text['k]) -> Text['k] {
        let ext = self.program.externs.at(&cx, name);
        let ret = match ext.ret {
            Option::Some(r) => r,
            Option::None => fail_text(&cx, text(&cx, "internal error: an extern without a type")),
        };
        let ptypes = match ext.ptypes {
            Option::Some(p) => p,
            Option::None => fail_text(&cx, text(&cx, "internal error: an extern value has no address")),
        };
        if !self.is_unit(&cx, ret) {
            return name;
        }
        match self.foreign_adapters.get(&cx, name) {
            Option::Some(symbol) => {
                return symbol;
            },
            Option::None => (),
        };
        let signature = C::fn_type(&cx, ptypes, ret, Seq::new(&cx), true, Seq::new(&cx));
        let path = Seq::one(&cx, text(&cx, "adapter"));
        path.append(&cx, path_segments(&cx, name));
        let identity = Seq::two(&cx, text(&cx, "adapter"), name);
        identity.push(&cx, type_key(&cx, signature, Seq::new(&cx)));
        let symbol = self.function_name(&cx, path, encode(&cx, identity));
        self.foreign_adapters.set(&cx, name, symbol);
        let names: Seq[Text['k], 'k] = Seq::new(&cx);
        var k = 0usize;
        while k < ptypes.len(&cx) {
            names.push(&cx, allocate(&cx, Out::new(&cx).put(&cx, "a").usize(&cx, k).done(&cx), self.taken));
            k = k + 1usize;
        }
        let params: Seq[Text['k], 'k] = Seq::new(&cx);
        var p = 0usize;
        while p < ptypes.len(&cx) {
            params.push(&cx, Out::new(&cx).add(&cx, self.c(&cx, ptypes.get(&cx, p))).put(&cx, " ").add(&cx, names.get(&cx, p)).done(&cx));
            p = p + 1usize;
        }
        let args = joined(&cx, names, ", ");
        let result = allocate(&cx, text(&cx, "result"), self.taken);
        let head = Out::new(&cx).put(&cx, "static KurUnit ").add(&cx, symbol).put(&cx, "(").add(&cx, or_void(&cx, joined(&cx, params, ", "))).put(&cx, ")").done(&cx);
        self.protos.push(&cx, Out::new(&cx).add(&cx, head).put(&cx, ";").done(&cx));
        self.bodies.push(&cx, Out::new(&cx).add(&cx, head).put(&cx, " {\n  ").add(&cx, name).put(&cx, "(").add(&cx, args).put(&cx, ");\n")
            .put(&cx, "  KurUnit ").add(&cx, result).put(&cx, " = { 0 };\n  return ").add(&cx, result).put(&cx, ";\n}").done(&cx));
        symbol
    }

    fn resolve_trait(self, &cx: Cx!['k], trait_name: Text['k], method: Text['k], tys: Seq[Type['k], 'k]) -> (FunKey['k], Fun['k], Map[Text['k], Type['k], 'k]) {
        // Checking already discharged authority at the use site. Specialization selects its
        // coherent head; the callee's module need not own that shape.
        let (index, inst, sub) = match self.checker.matching_instance(&cx, trait_name, tys) {
            Option::Some(found) => found,
            Option::None => fail_text(&cx, Out::new(&cx).put(&cx, "no instance of ").add(&cx, trait_name).put(&cx, " for these types").done(&cx)),
        };
        var i = 0usize;
        while i < inst.methods.len(&cx) {
            if inst.methods.get(&cx, i).name.eq(&cx, method) {
                return (FunKey::Method.(trait_name, index, method), inst.methods.get(&cx, i), sub);
            }
            i = i + 1usize;
        }
        fail_text(&cx, Out::new(&cx).put(&cx, "internal error: no method ").add(&cx, method).done(&cx))
    }

    // ------------------------------------------------------------------- program --

    fn emit_program(self, &cx: Cx!['k], entry: Option[Text['k]]) -> Text['k] {
        check_mono_termination(&cx, self.program);
        let keywords = c_keywords(&cx);
        let runtime = runtime_names(&cx);
        let externs: Seq[Text['k], 'k] = Seq::new(&cx);
        let all = self.program.externs.values(&cx);
        var e = 0usize;
        while e < all.len(&cx) {
            let ext = all.get(&cx, e);
            if !is_c_identifier(&cx, ext.name) || keywords.has(&cx, ext.name) {
                fail_at(&cx, Out::new(&cx).put(&cx, "backend: foreign symbol ").add(&cx, repr(&cx, ext.name)).put(&cx, " is not a C identifier").done(&cx), ext.pos);
            }
            if runtime.has(&cx, ext.name) || ext.name.starts_with(&cx, text(&cx, "__builtin_")) || ext.name.starts_with(&cx, text(&cx, "__atomic_"))
                || ext.name.is(&cx, "main") && entry.is_some() {
                fail_at(&cx, Out::new(&cx).put(&cx, "backend: foreign symbol ").add(&cx, repr(&cx, ext.name))
                    .put(&cx, " conflicts with the C runtime prelude or entry wrapper").done(&cx), ext.pos);
            }
            let ret = match ext.ret {
                Option::Some(r) => r,
                Option::None => fail_text(&cx, text(&cx, "internal error: an extern without a type")),
            };
            match ext.ptypes {
                Option::None => externs.push(&cx, Out::new(&cx).put(&cx, "extern ").add(&cx, self.c(&cx, ret)).put(&cx, " ").add(&cx, ext.name).put(&cx, ";").done(&cx)),
                Option::Some(ptypes) => {
                    let result = if self.is_foreign_void(&cx, ret) { text(&cx, "void") } else { self.c(&cx, ret) };
                    let noreturn = if is_never(ret) { text(&cx, "_Noreturn ") } else { text(&cx, "") };
                    let params: Seq[Text['k], 'k] = Seq::new(&cx);
                    var p = 0usize;
                    while p < ptypes.len(&cx) {
                        params.push(&cx, self.c(&cx, ptypes.get(&cx, p)));
                        p = p + 1usize;
                    }
                    externs.push(&cx, Out::new(&cx).add(&cx, noreturn).add(&cx, result).put(&cx, " ").add(&cx, ext.name).put(&cx, "(").add(&cx, or_void(&cx, joined(&cx, params, ", "))).put(&cx, ");").done(&cx));
                },
            };
            e = e + 1usize;
        }
        var main: Option[Text['k]] = Option::None;
        match entry {
            Option::Some(name) => {
                let i32 = C::prim(&cx, "i32");
                let argv = C::ptr(&cx, C::ptr(&cx, C::prim(&cx, "u8")));
                let ok = match self.program.funs.get(&cx, name) {
                    Option::Some(fun) => {
                        let plain = fun.ptypes.is_empty(&cx) || fun.ptypes.len(&cx) == 2usize && C::same(&cx, fun.ptypes.get(&cx, 0usize), i32)
                            && C::same(&cx, fun.ptypes.get(&cx, 1usize), argv);
                        fun.params.is_empty(&cx) && fun.premises.is_empty(&cx) && !fun.is_unsafe && fun.places(&cx).is_empty(&cx)
                            && equal(&cx, fun.ret, i32) && plain
                    },
                    Option::None => false,
                };
                if !ok {
                    fail_text(&cx, Out::new(&cx).put(&cx, "backend: the entry ").add(&cx, name).put(&cx, " must be a safe, non-generic ")
                        .put(&cx, "`fn() -> i32` or `fn(i32, *(*u8)) -> i32` without premises").done(&cx));
                }
                main = Option::Some.(self.request(&cx, FunKey::Function.(name), self.program.funs.at(&cx, name), Map::new(&cx)));
            },
            Option::None => {
                // The roots are the functions with nothing left to choose or discharge. One with
                // premises gets code only when a checked call, which discharged them, requests it.
                let funs = self.program.funs.values(&cx);
                var f = 0usize;
                while f < funs.len(&cx) {
                    let fun = funs.get(&cx, f);
                    if fun.params.is_empty(&cx) && fun.premises.is_empty(&cx) {
                        let unit = self.request(&cx, FunKey::Function.(fun.name), fun, Map::new(&cx));
                    }
                    f = f + 1usize;
                }
            },
        };
        while !self.queue.is_empty(&cx) {
            let (key, fun, sub, symbol) = self.queue.remove(&cx, 0usize);
            self.emit_function(&cx, key, fun, sub, symbol);
        }
        let datas: Seq[Text['k], 'k] = Seq::new(&cx);
        let entries = self.datas.values(&cx);
        var d = 0usize;
        while d < entries.len(&cx) {
            datas.push(&cx, self.emit_data(&cx, entries.get(&cx, d)));
            d = d + 1usize;
        }
        // The first pending type each time: positions before `first` hold only defined ones.
        var first = 0usize;
        while first < self.pending.positions(&cx) {
            match self.pending.entry(&cx, first) {
                Option::Some(ty) => self.define(&cx, ty),
                Option::None => {
                    first = first + 1usize;
                },
            };
        }
        let out: Seq[Text['k], 'k] = Seq::one(&cx, prelude(&cx));
        out.append(&cx, self.forward);
        out.append(&cx, self.defs);
        out.append(&cx, externs);
        out.append(&cx, datas);
        out.append(&cx, self.protos);
        out.append(&cx, self.bodies);
        match main {
            Option::Some(symbol) => {
                let fun = self.program.funs.at(&cx, match entry {
                    Option::Some(name) => name,
                    Option::None => text(&cx, ""),
                });
                if !fun.ptypes.is_empty(&cx) {
                    out.push(&cx, Out::new(&cx).put(&cx, "int main(int argc, char **argv) { return (int)").add(&cx, symbol).put(&cx, "((int32_t)argc, ")
                        .put(&cx, "(").add(&cx, self.c(&cx, fun.ptypes.get(&cx, 1usize))).put(&cx, ")argv); }").done(&cx));
                } else {
                    out.push(&cx, Out::new(&cx).put(&cx, "int main(void) { return (int)").add(&cx, symbol).put(&cx, "(); }").done(&cx));
                }
            },
            Option::None => (),
        };
        Out::new(&cx).add(&cx, joined(&cx, out, "\n")).put(&cx, "\n").done(&cx)
    }

    fn is_foreign_void(self, &cx: Cx!['k], ty: Type['k]) -> bool {
        is_never(ty) || self.is_unit(&cx, ty)
    }

    // ---------------------------------------------------------------------- data --

    fn data_symbol(self, &cx: Cx!['k], name: Text['k]) -> Text['k] {
        if !self.datas.has(&cx, name) {
            let symbol = allocate(&cx, Out::new(&cx).put(&cx, "d").usize(&cx, self.datas.len(&cx)).put(&cx, "_").add(&cx, tail(self.readable(&cx, name), 40usize)).done(&cx), self.taken);
            self.datas.set(&cx, name, (symbol, self.program.datas.at(&cx, name)));
        }
        let (symbol, _data) = self.datas.at(&cx, name);
        symbol
    }

    fn emit_data(self, &cx: Cx!['k], entry: (Text['k], Data['k])) -> Text['k] {
        let (symbol, data) = entry;
        let ct = self.c(&cx, data.ty);
        Out::new(&cx).put(&cx, "static ").add(&cx, ct).put(&cx, " ").add(&cx, symbol).put(&cx, " = ").add(&cx, self.initializer(&cx, data.ty, data.init)).put(&cx, ";").done(&cx)
    }

    fn initializer(self, &cx: Cx!['k], ty: Type['k], form: Form['k]) -> Text['k] {
        let s = self.shape(&cx, ty);
        match s {
            Type::Prim(_name) => {
                return self.literal(&cx, s, form.text);
            },
            Type::Array(elem, length) => {
                let values: Seq[Text['k], 'k] = Seq::new(&cx);
                var i = 0usize;
                while i < form.len(&cx) {
                    let part = form.at(&cx, i);
                    if C::same(&cx, elem.get(&cx), C::prim(&cx, "u8")) && part.is_str() {
                        var b = 0usize;
                        while b < part.text.len() {
                            values.push(&cx, Out::new(&cx).u64(&cx, part.text.byte(&cx, b) as u64).done(&cx));
                            b = b + 1usize;
                        }
                    } else {
                        values.push(&cx, self.initializer(&cx, elem.get(&cx), part));
                    }
                    i = i + 1usize;
                }
                return if length != 0u64 { Out::new(&cx).put(&cx, "{ { ").add(&cx, joined(&cx, values, ", ")).put(&cx, " } }").done(&cx) } else { text(&cx, "{ 0 }") };
            },
            _ => (),
        };
        if self.is_unit(&cx, ty) {
            return text(&cx, "{ 0 }");
        }
        let rows = self.members(&cx, s);
        let parts: Seq[Text['k], 'k] = Seq::new(&cx);
        var i = 0usize;
        while i < rows.len(&cx) && i < form.len(&cx) {
            let (_m, f) = rows.get(&cx, i);
            parts.push(&cx, self.initializer(&cx, f, form.at(&cx, i)));
            i = i + 1usize;
        }
        Out::new(&cx).put(&cx, "{ ").add(&cx, joined(&cx, parts, ", ")).put(&cx, " }").done(&cx)
    }

    fn literal(self, &cx: Cx!['k], ty: Type['k], lit: Text['k]) -> Text['k] {
        let name = match ty {
            Type::Prim(n) => n,
            _ => fail_text(&cx, text(&cx, "internal error: a literal of a type that is not primitive")),
        };
        if name.is(&cx, "bool") {
            return if lit.is(&cx, "1") || lit.is(&cx, "true") || lit.is(&cx, "True") { text(&cx, "1") } else { text(&cx, "0") };
        }
        if C::is_float(&cx, name) {
            let digits = if lit.contains(&cx, text(&cx, ".")) || lit.contains(&cx, text(&cx, "e")) || lit.contains(&cx, text(&cx, "E")) { lit } else { lit.concat(&cx, text(&cx, ".0")) };
            return if name.is(&cx, "f32") { digits.concat(&cx, text(&cx, "f")) } else { digits };
        }
        if signed_bits(&cx, name) != 0u32 {
            return if lit.is(&cx, "-9223372036854775808") { text(&cx, "(-INT64_C(9223372036854775807) - 1)") } else { Out::new(&cx).put(&cx, "INT64_C(").add(&cx, lit).put(&cx, ")").done(&cx) };
        }
        Out::new(&cx).put(&cx, "UINT64_C(").add(&cx, lit).put(&cx, ")").done(&cx)
    }

    // ----------------------------------------------------------------- functions --

    fn emit_function(self, &cx: Cx!['k], key: FunKey['k], fun: Fun['k], sub: Map[Text['k], Type['k], 'k], symbol: Text['k]) {
        self.fun.set(&cx, Option::Some.(fun));
        self.sub.set(&cx, sub);
        self.substituted.set(&cx, Map::new(&cx));
        let typed = self.checker.typed.at(&cx, key);
        self.locals.set(&cx, Map::new(&cx));
        self.lines.set(&cx, Seq::new(&cx));
        self.scratch.set(&cx, 0usize);
        let label_taken = Pool::new(&cx, Set::new(&cx));
        let labels: Map[Text['k], Text['k], 'k] = Map::new(&cx);
        var b = 0usize;
        while b < fun.blocks.len(&cx) {
            let label = fun.blocks.get(&cx, b).label;
            labels.set(&cx, label, allocate(&cx, Out::new(&cx).put(&cx, "L_").add(&cx, self.readable(&cx, label)).done(&cx), label_taken));
            b = b + 1usize;
        }
        self.labels.set(&cx, labels);
        let decls: Seq[Text['k], 'k] = Seq::new(&cx);
        self.decls.set(&cx, decls);
        let entry = fun.blocks.get(&cx, 0usize);
        let place_c: Map[Text['k], Text['k], 'k] = Map::new(&cx);
        self.place_c.set(&cx, place_c);
        let cparams: Seq[Text['k], 'k] = Seq::new(&cx);
        var p = 0usize;
        while p < entry.params.len(&cx) {
            let binding = entry.params.get(&cx, p);
            let cname = self.cname(&cx, entry.label, binding.name);
            if binding.name.starts_with(&cx, text(&cx, "&")) {
                place_c.set(&cx, binding.name, Out::new(&cx).put(&cx, "(*").add(&cx, cname).put(&cx, ")").done(&cx));
                cparams.push(&cx, Out::new(&cx).add(&cx, self.c(&cx, self.substitute_type(&cx, binding.type))).put(&cx, "* ").add(&cx, cname).done(&cx));
            } else {
                cparams.push(&cx, Out::new(&cx).add(&cx, self.c(&cx, self.substitute_type(&cx, binding.type))).put(&cx, " ").add(&cx, cname).done(&cx));
            }
            p = p + 1usize;
        }
        var l = 0usize;
        while l < fun.locals.len(&cx) {
            let binding = fun.locals.get(&cx, l);
            let cname = allocate(&cx, Out::new(&cx).put(&cx, "p_").add(&cx, self.readable(&cx, binding.name)).done(&cx), self.taken);
            place_c.set(&cx, binding.name, cname);
            decls.push(&cx, Out::new(&cx).add(&cx, self.c(&cx, self.substitute_type(&cx, binding.type))).put(&cx, " ").add(&cx, cname).put(&cx, ";").done(&cx));
            l = l + 1usize;
        }
        let roots: Map[Text['k], Type['k], 'k] = Map::new(&cx);
        var r = 0usize;
        while r < entry.params.len(&cx) {
            let binding = entry.params.get(&cx, r);
            if binding.name.starts_with(&cx, text(&cx, "&")) {
                roots.set(&cx, binding.name, self.substitute_type(&cx, binding.type));
            }
            r = r + 1usize;
        }
        var o = 0usize;
        while o < fun.locals.len(&cx) {
            roots.set(&cx, fun.locals.get(&cx, o).name, self.substitute_type(&cx, fun.locals.get(&cx, o).type));
            o = o + 1usize;
        }
        self.roots.set(&cx, roots);
        self.typed.set(&cx, typed);
        let values = typed.keys(&cx);
        var v = 0usize;
        while v < values.len(&cx) {
            let (label, name) = values.get(&cx, v);
            let ty = typed.at(&cx, values.get(&cx, v));
            var parameter = false;
            if label.eq(&cx, entry.label) {
                var q = 0usize;
                while q < entry.params.len(&cx) {
                    if entry.params.get(&cx, q).name.eq(&cx, name) {
                        parameter = true;
                    }
                    q = q + 1usize;
                }
            }
            if !parameter && !is_never(self.substitute_type(&cx, ty)) {
                let ct = self.c(&cx, self.substitute_type(&cx, ty));
                decls.push(&cx, Out::new(&cx).add(&cx, ct).put(&cx, " ").add(&cx, self.cname(&cx, label, name)).put(&cx, ";").done(&cx));
            }
            v = v + 1usize;
        }
        let blocks: Map[Text['k], Block['k], 'k] = Map::new(&cx);
        var k = 0usize;
        while k < fun.blocks.len(&cx) {
            blocks.set(&cx, fun.blocks.get(&cx, k).label, fun.blocks.get(&cx, k));
            k = k + 1usize;
        }
        self.blocks.set(&cx, blocks);
        var n = 0usize;
        while n < fun.blocks.len(&cx) {
            let block = fun.blocks.get(&cx, n);
            self.label.set(&cx, block.label);
            self.line(&cx, Out::new(&cx).add(&cx, labels.at(&cx, block.label)).put(&cx, ": ;").done(&cx));
            var i = 0usize;
            while i < block.instrs.len(&cx) {
                self.instr(&cx, block.instrs.get(&cx, i));
                i = i + 1usize;
            }
            self.term(&cx, block.term);
            n = n + 1usize;
        }
        let ret_type = self.substitute_type(&cx, fun.ret);
        let ret = if is_never(ret_type) { text(&cx, "void") } else { self.c(&cx, ret_type) };
        let head = Out::new(&cx).put(&cx, if ret.is(&cx, "void") { "_Noreturn " } else { "" }).put(&cx, "static ").add(&cx, ret).put(&cx, " ").add(&cx, symbol)
            .put(&cx, "(").add(&cx, or_void(&cx, joined(&cx, cparams, ", "))).put(&cx, ")").done(&cx);
        self.protos.push(&cx, Out::new(&cx).add(&cx, head).put(&cx, ";").done(&cx));
        let body = Out::new(&cx).add(&cx, head).put(&cx, " {\n");
        var d = 0usize;
        while d < decls.len(&cx) {
            let unit = body.put(&cx, "  ").add(&cx, decls.get(&cx, d)).put(&cx, "\n");
            d = d + 1usize;
        }
        let lines = self.lines.get(&cx);
        var j = 0usize;
        while j < lines.len(&cx) {
            let unit = body.put(&cx, "  ").add(&cx, lines.get(&cx, j)).put(&cx, "\n");
            j = j + 1usize;
        }
        self.bodies.push(&cx, body.put(&cx, "}\n").done(&cx));
    }

    fn substitute_type(self, &cx: Cx!['k], ty: Type['k]) -> Type['k] {
        let done = self.substituted.get(&cx);
        match done.get(&cx, ty) {
            Option::Some(known) => return known,
            Option::None => (),
        }
        let before = self.counter.next.get(&cx);
        let out = subst(&cx, ty, self.sub.get(&cx), self.counter);
        if self.counter.next.get(&cx) == before {
            done.set(&cx, ty, out);
        }
        out
    }

    fn cname(self, &cx: Cx!['k], label: Text['k], name: Text['k]) -> Text['k] {
        let key = (label, name);
        let locals = self.locals.get(&cx);
        if !locals.has(&cx, key) {
            locals.set(&cx, key, allocate(&cx, Out::new(&cx).add(&cx, self.readable(&cx, label)).put(&cx, "_").add(&cx, self.readable(&cx, name)).done(&cx), self.taken));
        }
        locals.at(&cx, key)
    }

    fn value_name(self, &cx: Cx!['k], name: Text['k]) -> Text['k] {
        self.cname(&cx, self.label.get(&cx), name)
    }

    fn type_of(self, &cx: Cx!['k], name: Text['k]) -> Type['k] {
        self.substitute_type(&cx, self.typed.get(&cx).at(&cx, (self.label.get(&cx), name)))
    }

    fn line(self, &cx: Cx!['k], t: Text['k]) {
        self.lines.get(&cx).push(&cx, t);
    }

    // ------------------------------------------------------------------- places --

    // The C lvalue and type of a place path.
    fn place(self, &cx: Cx!['k], path: Text['k]) -> (Text['k], Type['k]) {
        let parts = path.split(&cx, text(&cx, "."));
        var expr = self.place_c.get(&cx).at(&cx, parts.get(&cx, 0usize));
        var ty = self.roots.get(&cx).at(&cx, parts.get(&cx, 0usize));
        var i = 1usize;
        while i < parts.len(&cx) {
            let seg = parts.get(&cx, i);
            ty = self.view(&cx, ty);
            let s = self.shape(&cx, ty);
            match s {
                Type::Enum(variants) => {
                    expr = Out::new(&cx).add(&cx, expr).put(&cx, ".payload.").add(&cx, self.variant(&cx, seg)).done(&cx);
                    ty = last_member(&cx, variants, seg);
                },
                _ => {
                    let names: Seq[Text['k], 'k] = match s {
                        Type::Struct(fields) => {
                            let out: Seq[Text['k], 'k] = Seq::new(&cx);
                            var f = 0usize;
                            while f < fields.len(&cx) {
                                out.push(&cx, fields.get(&cx, f).name);
                                f = f + 1usize;
                            }
                            out
                        },
                        Type::Tuple(elems) => {
                            let out: Seq[Text['k], 'k] = Seq::new(&cx);
                            var e = 0usize;
                            while e < elems.len(&cx) {
                                out.push(&cx, Out::new(&cx).usize(&cx, e).done(&cx));
                                e = e + 1usize;
                            }
                            out
                        },
                        _ => fail_text(&cx, text(&cx, "internal error: a place through a type that is not a product")),
                    };
                    let rows = self.members(&cx, s);
                    var found = false;
                    var k = names.len(&cx);
                    while !found && k > 0usize {
                        k = k - 1usize;
                        if names.get(&cx, k).eq(&cx, seg) {
                            let (m, t) = rows.get(&cx, k);
                            expr = Out::new(&cx).add(&cx, expr).put(&cx, ".").add(&cx, m).done(&cx);
                            ty = t;
                            found = true;
                        }
                    }
                    if !found {
                        fail_text(&cx, text(&cx, "internal error: a place names no component"));
                    }
                },
            };
            i = i + 1usize;
        }
        (expr, ty)
    }

    // Opened views share the package's representation.
    fn view(self, &cx: Cx!['k], ty: Type['k]) -> Type['k] {
        match ty {
            Type::Exists(_binders, body) => body.get(&cx),
            _ => ty,
        }
    }

    // A call argument: a value, a lent place's address, or a raw target.
    fn operand(self, &cx: Cx!['k], arg: Text['k]) -> Text['k] {
        if arg.starts_with(&cx, text(&cx, "&*")) {
            return self.value_name(&cx, arg.from(2usize));
        }
        if arg.starts_with(&cx, text(&cx, "&")) {
            let (expr, _ty) = self.place(&cx, arg);
            return Out::new(&cx).put(&cx, "&").add(&cx, expr).done(&cx);
        }
        self.value_name(&cx, arg)
    }

    // ------------------------------------------------------------- instructions --

    fn instr(self, &cx: Cx!['k], instr: Instr['k]) {
        let op = instr.op;
        let a = instr.args;
        let dst = if instr.lhs.len(&cx) == 1usize { Option::Some.(self.value_name(&cx, instr.lhs.get(&cx, 0usize))) } else { Option::None };
        // `None` where an instruction without one result would name it, as the f-strings print it.
        let d = match dst {
            Option::Some(t) => t,
            Option::None => text(&cx, "None"),
        };
        if op.is(&cx, "const") {
            let lit = match instr.lit {
                Option::Some(l) => l,
                Option::None => text(&cx, ""),
            };
            self.line(&cx, Out::new(&cx).add(&cx, d).put(&cx, " = ").add(&cx, self.literal(&cx, self.type_operand_raw(&cx, instr), lit)).put(&cx, ";").done(&cx));
        } else if op.is(&cx, "copy") {
            self.line(&cx, Out::new(&cx).add(&cx, d).put(&cx, " = ").add(&cx, self.value_name(&cx, a.get(&cx, 0usize))).put(&cx, ";").done(&cx));
        } else if op.is(&cx, "construct") {
            let ty = self.type_operand(&cx, instr);
            let values: Seq[Text['k], 'k] = Seq::new(&cx);
            var i = 0usize;
            while i < a.len(&cx) {
                values.push(&cx, self.value_name(&cx, a.get(&cx, i)));
                i = i + 1usize;
            }
            self.construct(&cx, d, ty, values);
        } else if op.is(&cx, "destruct") {
            self.destruct(&cx, instr);
        } else if op.is(&cx, "construct_variant") {
            let lit = match instr.lit {
                Option::Some(l) => l,
                Option::None => text(&cx, ""),
            };
            let variants = self.types.variants(&cx, erase(&cx, self.type_operand(&cx, instr), self.types), Option::None);
            var index = 0usize;
            var found = false;
            while !found && index < variants.len(&cx) {
                if variants.get(&cx, index).name.eq(&cx, lit) {
                    found = true;
                } else {
                    index = index + 1usize;
                }
            }
            let member = self.variant(&cx, lit);
            self.line(&cx, Out::new(&cx).add(&cx, d).put(&cx, ".payload.").add(&cx, member).put(&cx, " = ").add(&cx, self.value_name(&cx, a.get(&cx, 0usize))).put(&cx, ";").done(&cx));
            self.line(&cx, Out::new(&cx).add(&cx, d).put(&cx, ".tag = ").usize(&cx, index).put(&cx, ";").done(&cx));
        } else if op.is(&cx, "variant_tag") {
            let source = if a.get(&cx, 0usize).starts_with(&cx, text(&cx, "&")) {
                let (expr, _ty) = self.place(&cx, a.get(&cx, 0usize));
                expr
            } else {
                self.value_name(&cx, a.get(&cx, 0usize))
            };
            self.line(&cx, Out::new(&cx).add(&cx, d).put(&cx, " = ").add(&cx, source).put(&cx, ".tag;").done(&cx));
        } else if op.is(&cx, "builtin::int_cast") {
            let value = self.value_name(&cx, a.get(&cx, 0usize));
            self.line(&cx, Out::new(&cx).add(&cx, d).put(&cx, " = ").add(&cx, self.convert(&cx, value, self.type_operand(&cx, instr))).put(&cx, ";").done(&cx));
        } else if op.is(&cx, "builtin::unsafe::cast") {
            let value = self.value_name(&cx, a.get(&cx, 0usize));
            let src = self.type_of(&cx, a.get(&cx, 0usize));
            self.cast(&cx, d, value, src, self.type_operand(&cx, instr));
        } else if is_c_op(&cx, op) || op.is(&cx, "shl") || op.is(&cx, "shr") {
            self.primitive(&cx, d, op, a);
        } else if op.is(&cx, "call") {
            self.call(&cx, instr);
        } else if op.is(&cx, "trait_call") {
            let tys: Seq[Type['k], 'k] = Seq::new(&cx);
            var i = 0usize;
            while i < instr.tys.len(&cx) {
                tys.push(&cx, self.substitute_type(&cx, instr.tys.get(&cx, i)));
                i = i + 1usize;
            }
            let (key, fun, sub) = self.resolve_trait(&cx, a.get(&cx, 0usize), a.get(&cx, 1usize), tys);
            let symbol = self.request(&cx, key, fun, sub);
            self.emit_call(&cx, instr, symbol, fun.ret, sub, a.from(&cx, 2usize), false);
        } else if op.is(&cx, "fn") {
            self.line(&cx, Out::new(&cx).add(&cx, d).put(&cx, " = ").add(&cx, self.function_address(&cx, instr)).put(&cx, ";").done(&cx));
        } else if op.is(&cx, "alloca") {
            self.has_memory_form(&cx, self.type_operand(&cx, instr), instr);
            let ct = self.c(&cx, self.type_operand(&cx, instr));
            self.line(&cx, Out::new(&cx).add(&cx, d).put(&cx, " = (").add(&cx, ct).put(&cx, "*)__builtin_alloca(sizeof(").add(&cx, ct).put(&cx, "));").done(&cx));
        } else if op.is(&cx, "builtin::sizeof") {
            self.has_memory_form(&cx, self.type_operand(&cx, instr), instr);
            self.line(&cx, Out::new(&cx).add(&cx, d).put(&cx, " = (uint64_t)sizeof(").add(&cx, self.c(&cx, self.type_operand(&cx, instr))).put(&cx, ");").done(&cx));
        } else if op.is(&cx, "data") {
            self.line(&cx, Out::new(&cx).add(&cx, d).put(&cx, " = &").add(&cx, self.data_symbol(&cx, a.get(&cx, 0usize))).put(&cx, ";").done(&cx));
        } else if op.is(&cx, "builtin::unsafe::static_brand") || op.is(&cx, "builtin::fresh") {
            self.line(&cx, Out::new(&cx).add(&cx, d).put(&cx, ".dummy = 0;").done(&cx));
        } else if op.is(&cx, "pack") || op.is(&cx, "open") {
            if a.get(&cx, 0usize).starts_with(&cx, text(&cx, "&")) {
                self.unit(&cx, dst);
            } else {
                self.line(&cx, Out::new(&cx).add(&cx, d).put(&cx, " = ").add(&cx, self.value_name(&cx, a.get(&cx, 0usize))).put(&cx, ";").done(&cx));
            }
        } else if op.is(&cx, "builtin::unsafe::deref") {
            let inner = self.pointee(&cx, self.type_of(&cx, a.get(&cx, 0usize)));
            self.has_memory_form(&cx, inner, instr);
            self.line(&cx, Out::new(&cx).add(&cx, d).put(&cx, " = *").add(&cx, self.value_name(&cx, a.get(&cx, 0usize))).put(&cx, ";").done(&cx));
        } else if op.is(&cx, "builtin::unsafe::load_volatile") {
            let inner = self.pointee(&cx, self.type_of(&cx, a.get(&cx, 0usize)));
            self.has_memory_form(&cx, inner, instr);
            let ct = self.c(&cx, inner);
            self.line(&cx, Out::new(&cx).add(&cx, d).put(&cx, " = *(").add(&cx, ct).put(&cx, " volatile*)").add(&cx, self.value_name(&cx, a.get(&cx, 0usize))).put(&cx, ";").done(&cx));
        } else if op.is(&cx, "builtin::unsafe::store") || op.is(&cx, "builtin::unsafe::store_volatile") {
            let inner = self.pointee(&cx, self.type_of(&cx, a.get(&cx, 0usize)));
            self.has_memory_form(&cx, inner, instr);
            let qual = if op.ends_with(&cx, text(&cx, "volatile")) { Out::new(&cx).put(&cx, "(").add(&cx, self.c(&cx, inner)).put(&cx, " volatile*)").done(&cx) } else { text(&cx, "") };
            let target = self.value_name(&cx, a.get(&cx, 0usize));
            self.line(&cx, Out::new(&cx).put(&cx, "*").add(&cx, qual).add(&cx, target).put(&cx, " = ").add(&cx, self.value_name(&cx, a.get(&cx, 1usize))).put(&cx, ";").done(&cx));
            self.unit(&cx, dst);
        } else if op.starts_with(&cx, text(&cx, "builtin::unsafe::atomic_")) {
            self.atomic(&cx, instr, dst);
        } else if op.is(&cx, "load") {
            let (expr, _ty) = self.place(&cx, a.get(&cx, 0usize));
            self.line(&cx, Out::new(&cx).add(&cx, d).put(&cx, " = ").add(&cx, expr).put(&cx, ";").done(&cx));
        } else if op.is(&cx, "store") {
            let (expr, _ty) = self.place(&cx, a.get(&cx, 0usize));
            self.line(&cx, Out::new(&cx).add(&cx, expr).put(&cx, " = ").add(&cx, self.value_name(&cx, a.get(&cx, 1usize))).put(&cx, ";").done(&cx));
            self.unit(&cx, dst);
        } else if op.is(&cx, "foreach") {
            self.foreach_instr(&cx, instr, d);
        } else {
            fail_text(&cx, Out::new(&cx).put(&cx, "no C recipe for ").add(&cx, op).done(&cx));
        }
    }

    fn pointee(self, &cx: Cx!['k], pointer: Type['k]) -> Type['k] {
        match pointer {
            Type::Ptr(inner) => inner.get(&cx),
            _ => fail_text(&cx, text(&cx, "internal error: a pointer operation on a value that is not a pointer")),
        }
    }

    // The checker's zero-size rule, for types a specialization chose.
    fn has_memory_form(self, &cx: Cx!['k], ty: Type['k], instr: Instr['k]) {
        if self.types.zero_size(&cx, ty) {
            fail_at(&cx, text(&cx, "a zero-size type has no memory form yet"), instr.pos);
        }
    }

    fn type_operand_raw(self, &cx: Cx!['k], instr: Instr['k]) -> Type['k] {
        match instr.ty {
            Option::Some(t) => t,
            Option::None => fail_text(&cx, text(&cx, "internal error: an instruction without its type")),
        }
    }

    fn type_operand(self, &cx: Cx!['k], instr: Instr['k]) -> Type['k] {
        self.substitute_type(&cx, self.type_operand_raw(&cx, instr))
    }

    fn unit(self, &cx: Cx!['k], dst: Option[Text['k]]) {
        match dst {
            Option::Some(d) => self.line(&cx, Out::new(&cx).add(&cx, d).put(&cx, ".dummy = 0;").done(&cx)),
            Option::None => (),
        };
    }

    fn construct(self, &cx: Cx!['k], dst: Text['k], ty: Type['k], values: Seq[Text['k], 'k]) {
        let s = self.shape(&cx, ty);
        if self.is_unit(&cx, ty) {
            self.line(&cx, Out::new(&cx).add(&cx, dst).put(&cx, ".dummy = 0;").done(&cx));
            return ();
        }
        match s {
            Type::Array(_elem, length) => {
                if length == 0u64 {
                    self.line(&cx, Out::new(&cx).add(&cx, dst).put(&cx, ".dummy = 0;").done(&cx));
                }
                var k = 0u64;
                while k < length {
                    let at = if (k as usize) < values.len(&cx) - 1usize { k as usize } else { values.len(&cx) - 1usize };
                    self.line(&cx, Out::new(&cx).add(&cx, dst).put(&cx, ".items[").u64(&cx, k).put(&cx, "] = ").add(&cx, values.get(&cx, at)).put(&cx, ";").done(&cx));
                    k = k + 1u64;
                }
            },
            _ => {
                let rows = self.members(&cx, s);
                var i = 0usize;
                while i < rows.len(&cx) && i < values.len(&cx) {
                    let (m, _t) = rows.get(&cx, i);
                    self.line(&cx, Out::new(&cx).add(&cx, dst).put(&cx, ".").add(&cx, m).put(&cx, " = ").add(&cx, values.get(&cx, i)).put(&cx, ";").done(&cx));
                    i = i + 1usize;
                }
            },
        };
    }

    fn destruct(self, &cx: Cx!['k], instr: Instr['k]) {
        let arg = instr.args.get(&cx, 0usize);
        let (source, ty) = if arg.starts_with(&cx, text(&cx, "&")) {
            self.place(&cx, arg)
        } else {
            let source = self.value_name(&cx, arg);
            (source, self.type_of(&cx, arg))
        };
        let representation = erase(&cx, ty, self.types);
        let pointer = is_ptr(representation);
        let component_type = match representation {
            Type::Ptr(inner) => inner.get(&cx),
            _ => ty,
        };
        let s = self.shape(&cx, component_type);
        let access = match s {
            Type::Array(_elem, length) => items_access(&cx, length as usize),
            _ => if !self.is_unit(&cx, component_type) { member_names(&cx, self.members(&cx, s)) } else { Seq::new(&cx) },
        };
        var i = 0usize;
        while i < instr.lhs.len(&cx) && i < access.len(&cx) {
            let name = self.value_name(&cx, instr.lhs.get(&cx, i));
            if pointer {
                self.line(&cx, Out::new(&cx).add(&cx, name).put(&cx, " = KUR_FIELD(").add(&cx, source).put(&cx, ", ").add(&cx, access.get(&cx, i)).put(&cx, ");").done(&cx));
            } else {
                self.line(&cx, Out::new(&cx).add(&cx, name).put(&cx, " = ").add(&cx, source).put(&cx, ".").add(&cx, access.get(&cx, i)).put(&cx, ";").done(&cx));
            }
            i = i + 1usize;
        }
    }

    // Integer conversion by truncation or sign extension.
    fn convert(self, &cx: Cx!['k], expr: Text['k], dst: Type['k]) -> Text['k] {
        let name = match dst {
            Type::Prim(n) => n,
            _ => fail_text(&cx, text(&cx, "internal error: a conversion to a type that is not primitive")),
        };
        let bits = signed_bits(&cx, name);
        if bits != 0u32 {
            return Out::new(&cx).put(&cx, "kur_dec_i").u64(&cx, bits as u64).put(&cx, "((uint64_t)(").add(&cx, expr).put(&cx, "))").done(&cx);
        }
        Out::new(&cx).put(&cx, "(").add(&cx, c_prim(&cx, name)).put(&cx, ")((uint64_t)(").add(&cx, expr).put(&cx, "))").done(&cx)
    }

    fn cast(self, &cx: Cx!['k], dst: Text['k], expr: Text['k], src: Type['k], dst_ty: Type['k]) {
        let s = self.shape(&cx, src);
        let d = self.shape(&cx, dst_ty);
        let cd = self.c(&cx, dst_ty);
        if is_never(s) || is_never(d) {
            fail_text(&cx, text(&cx, "backend cast does not support a never representation"));
        }
        if is_ptr(s) || is_ptr(d) {
            let s_int = match s {
                Type::Prim(n) => C::is_integer(&cx, n),
                _ => false,
            };
            let d_int = match d {
                Type::Prim(n) => C::is_integer(&cx, n),
                _ => false,
            };
            if is_ptr(s) && is_ptr(d) {
                self.line(&cx, Out::new(&cx).add(&cx, dst).put(&cx, " = (").add(&cx, cd).put(&cx, ")").add(&cx, expr).put(&cx, ";").done(&cx));
            } else if is_ptr(s) && d_int || is_ptr(d) && s_int {
                let value = Out::new(&cx).put(&cx, "(uintptr_t)").add(&cx, expr).done(&cx);
                let converted = if d_int { self.convert(&cx, value, d) } else { Out::new(&cx).put(&cx, "(").add(&cx, cd).put(&cx, ")").add(&cx, value).done(&cx) };
                self.line(&cx, Out::new(&cx).add(&cx, dst).put(&cx, " = ").add(&cx, converted).put(&cx, ";").done(&cx));
            } else {
                fail_text(&cx, text(&cx, "backend cast supports raw pointers only with pointers or integers"));
            }
            return ();
        }
        let (sn, dn) = match s {
            Type::Prim(x) => match d {
                Type::Prim(y) => (x, y),
                _ => {
                    // Layout belongs to C. Never silently truncate a source or leave a destination
                    // tail uninitialized; exact size is a target obligation.
                    self.reinterpret(&cx, dst, expr);
                    return ();
                },
            },
            _ => {
                self.reinterpret(&cx, dst, expr);
                return ();
            },
        };
        if sn.is(&cx, "bool") || dn.is(&cx, "bool") || C::is_float(&cx, sn) && C::is_float(&cx, dn) {
            self.line(&cx, Out::new(&cx).add(&cx, dst).put(&cx, " = (").add(&cx, cd).put(&cx, ")").add(&cx, expr).put(&cx, ";").done(&cx));
        } else if C::is_float(&cx, sn) != C::is_float(&cx, dn) {
            if width(&cx, sn) != width(&cx, dn) {
                fail_text(&cx, text(&cx, "backend integer/float reinterpretation requires equal widths"));
            }
            self.reinterpret(&cx, dst, expr);
        } else {
            self.line(&cx, Out::new(&cx).add(&cx, dst).put(&cx, " = ").add(&cx, self.convert(&cx, expr, d)).put(&cx, ";").done(&cx));
        }
    }

    fn reinterpret(self, &cx: Cx!['k], dst: Text['k], expr: Text['k]) {
        self.line(&cx, Out::new(&cx).put(&cx, "_Static_assert(sizeof(").add(&cx, dst).put(&cx, ") == sizeof(").add(&cx, expr)
            .put(&cx, "), \"KURS cast requires equal representation sizes\");").done(&cx));
        self.line(&cx, Out::new(&cx).put(&cx, "__builtin_memcpy(&").add(&cx, dst).put(&cx, ", &").add(&cx, expr).put(&cx, ", sizeof(").add(&cx, dst).put(&cx, "));").done(&cx));
    }

    fn primitive(self, &cx: Cx!['k], dst: Text['k], op: Text['k], args: Seq[Text['k], 'k]) {
        let x = self.value_name(&cx, args.get(&cx, 0usize));
        let y = self.value_name(&cx, args.get(&cx, 1usize));
        let t = self.shape(&cx, self.type_of(&cx, args.get(&cx, 0usize)));
        let name = match t {
            Type::Ptr(_inner) => {
                self.line(&cx, Out::new(&cx).add(&cx, dst).put(&cx, " = ((uintptr_t)").add(&cx, x).put(&cx, " ").add(&cx, c_op(&cx, op)).put(&cx, " (uintptr_t)").add(&cx, y).put(&cx, ");").done(&cx));
                return ();
            },
            Type::Prim(n) => n,
            _ => fail_text(&cx, text(&cx, "internal error: a primitive operation on a value that is not primitive")),
        };
        if !C::is_integer(&cx, name) || op.is(&cx, "eq") || op.is(&cx, "ne") || op.is(&cx, "lt") || op.is(&cx, "le") || op.is(&cx, "gt") || op.is(&cx, "ge") {
            self.line(&cx, Out::new(&cx).add(&cx, dst).put(&cx, " = (").add(&cx, x).put(&cx, " ").add(&cx, c_op(&cx, op)).put(&cx, " ").add(&cx, y).put(&cx, ");").done(&cx));
            return ();
        }
        let bits = C::integer_bits(&cx, name);
        let ct = c_prim(&cx, name);
        let signed = signed_bits(&cx, name) != 0u32;
        if op.is(&cx, "div") || op.is(&cx, "mod") {
            self.line(&cx, Out::new(&cx).put(&cx, "if (").add(&cx, y).put(&cx, " == 0) KUR_TRAP();").done(&cx));
            if signed {
                let minus = if op.is(&cx, "div") {
                    wrap(&cx, Out::new(&cx).put(&cx, "(uint64_t)0 - (uint64_t)(").add(&cx, x).put(&cx, ")").done(&cx), bits, signed, ct)
                } else {
                    text(&cx, "0")
                };
                self.line(&cx, Out::new(&cx).add(&cx, dst).put(&cx, " = (").add(&cx, y).put(&cx, " == -1) ? ").add(&cx, minus).put(&cx, " : (").add(&cx, ct).put(&cx, ")(")
                    .add(&cx, x).put(&cx, " ").add(&cx, c_op(&cx, op)).put(&cx, " ").add(&cx, y).put(&cx, ");").done(&cx));
            } else {
                self.line(&cx, Out::new(&cx).add(&cx, dst).put(&cx, " = (").add(&cx, ct).put(&cx, ")((uint64_t)").add(&cx, x).put(&cx, " ").add(&cx, c_op(&cx, op))
                    .put(&cx, " (uint64_t)").add(&cx, y).put(&cx, ");").done(&cx));
            }
            return ();
        }
        if op.is(&cx, "shl") || op.is(&cx, "shr") {
            let amount = Out::new(&cx).put(&cx, "((uint64_t)(").add(&cx, y).put(&cx, ") & ").u64(&cx, (bits - 1u32) as u64).put(&cx, ")").done(&cx);
            let bits_of = if bits < 64u32 || signed {
                Out::new(&cx).put(&cx, "(uint64_t)(uint").u64(&cx, bits as u64).put(&cx, "_t)(").add(&cx, x).put(&cx, ")").done(&cx)
            } else {
                Out::new(&cx).put(&cx, "(uint64_t)(").add(&cx, x).put(&cx, ")").done(&cx)
            };
            let shifted = if op.is(&cx, "shl") {
                Out::new(&cx).add(&cx, bits_of).put(&cx, " << ").add(&cx, amount).done(&cx)
            } else if !signed {
                Out::new(&cx).add(&cx, bits_of).put(&cx, " >> ").add(&cx, amount).done(&cx)
            } else {
                let fill = Out::new(&cx).put(&cx, "(").add(&cx, x).put(&cx, " < 0 && ").add(&cx, amount).put(&cx, " ? (UINT64_MAX << (").u64(&cx, bits as u64)
                    .put(&cx, " - ").add(&cx, amount).put(&cx, ")) : 0)").done(&cx);
                Out::new(&cx).put(&cx, "(").add(&cx, bits_of).put(&cx, " >> ").add(&cx, amount).put(&cx, ") | ").add(&cx, fill).done(&cx)
            };
            self.line(&cx, Out::new(&cx).add(&cx, dst).put(&cx, " = ").add(&cx, wrap(&cx, shifted, bits, signed, ct)).put(&cx, ";").done(&cx));
            return ();
        }
        let expr = Out::new(&cx).put(&cx, "(uint64_t)(").add(&cx, x).put(&cx, ") ").add(&cx, c_op(&cx, op)).put(&cx, " (uint64_t)(").add(&cx, y).put(&cx, ")").done(&cx);
        self.line(&cx, Out::new(&cx).add(&cx, dst).put(&cx, " = ").add(&cx, wrap(&cx, expr, bits, signed, ct)).put(&cx, ";").done(&cx));
    }

    fn call(self, &cx: Cx!['k], instr: Instr['k]) {
        let callee = instr.args.get(&cx, 0usize);
        if callee.starts_with(&cx, text(&cx, "%")) {
            let ret = match erase(&cx, self.type_of(&cx, callee), self.types) {
                Type::Fn(f) => f.ret.get(&cx),
                _ => fail_text(&cx, text(&cx, "internal error: a call of a value that is not a function")),
            };
            self.emit_call(&cx, instr, self.value_name(&cx, callee), ret, Map::new(&cx), instr.args.from(&cx, 1usize), false);
        } else if self.program.externs.has(&cx, callee) {
            let ret = match self.program.externs.at(&cx, callee).ret {
                Option::Some(r) => r,
                Option::None => fail_text(&cx, text(&cx, "internal error: an extern without a type")),
            };
            self.emit_call(&cx, instr, callee, ret, Map::new(&cx), instr.args.from(&cx, 1usize), true);
        } else {
            let fun = self.program.funs.at(&cx, callee);
            let sub: Map[Text['k], Type['k], 'k] = Map::new(&cx);
            var i = 0usize;
            while i < fun.params.len(&cx) && i < instr.tys.len(&cx) {
                sub.set(&cx, fun.params.get(&cx, i).name, self.substitute_type(&cx, instr.tys.get(&cx, i)));
                i = i + 1usize;
            }
            let symbol = self.request(&cx, FunKey::Function.(callee), fun, sub);
            self.emit_call(&cx, instr, symbol, fun.ret, sub, instr.args.from(&cx, 1usize), false);
        }
    }

    fn emit_call(self, &cx: Cx!['k], instr: Instr['k], callee: Text['k], ret: Type['k], sub: Map[Text['k], Type['k], 'k], args: Seq[Text['k], 'k], foreign: bool) {
        let operands: Seq[Text['k], 'k] = Seq::new(&cx);
        var i = 0usize;
        while i < args.len(&cx) {
            operands.push(&cx, self.operand(&cx, args.get(&cx, i)));
            i = i + 1usize;
        }
        let call = Out::new(&cx).add(&cx, callee).put(&cx, "(").add(&cx, joined(&cx, operands, ", ")).put(&cx, ")").done(&cx);
        let ret = subst(&cx, ret, sub, self.counter);
        let dst = self.value_name(&cx, instr.lhs.get(&cx, 0usize));
        if is_never(ret) {
            self.line(&cx, Out::new(&cx).add(&cx, call).put(&cx, ";").done(&cx));
        } else if foreign && self.is_unit(&cx, ret) {
            self.line(&cx, Out::new(&cx).add(&cx, call).put(&cx, ";").done(&cx));
            self.line(&cx, Out::new(&cx).add(&cx, dst).put(&cx, ".dummy = 0;").done(&cx));
        } else {
            self.line(&cx, Out::new(&cx).add(&cx, dst).put(&cx, " = ").add(&cx, call).put(&cx, ";").done(&cx));
        }
    }

    fn atomic(self, &cx: Cx!['k], instr: Instr['k], dst: Option[Text['k]]) {
        let order = match instr.lit {
            Option::Some(o) => o,
            Option::None => fail_text(&cx, text(&cx, "internal error: an atomic operation without its ordering")),
        };
        let d = match dst {
            Option::Some(t) => t,
            Option::None => text(&cx, "None"),
        };
        let kind = instr.op.from(text(&cx, "builtin::unsafe::atomic_").len());
        let args: Seq[Text['k], 'k] = Seq::new(&cx);
        var i = 0usize;
        while i < instr.args.len(&cx) {
            args.push(&cx, self.value_name(&cx, instr.args.get(&cx, i)));
            i = i + 1usize;
        }
        if !kind.is(&cx, "fence") {
            let item = self.shape(&cx, self.pointee(&cx, self.type_of(&cx, instr.args.get(&cx, 0usize))));
            let (integer, transfer) = match item {
                Type::Prim(n) => (C::is_integer(&cx, n), n.is(&cx, "bool")),
                Type::Ptr(_inner) => (false, true),
                _ => (false, false),
            };
            if !integer && (kind.starts_with(&cx, text(&cx, "fetch_")) || !transfer) {
                fail_at(&cx, Out::new(&cx).put(&cx, "backend atomic ").add(&cx, kind).put(&cx, " does not support this pointee type; ")
                    .put(&cx, "fetch operations require integers, transfers require integers, bool or raw pointers").done(&cx), instr.pos);
            }
        }
        if kind.is(&cx, "fence") {
            self.line(&cx, Out::new(&cx).put(&cx, "__atomic_thread_fence(").add(&cx, c_order(&cx, order)).put(&cx, ");").done(&cx));
            self.unit(&cx, dst);
        } else if kind.is(&cx, "load") {
            self.line(&cx, Out::new(&cx).add(&cx, d).put(&cx, " = __atomic_load_n(").add(&cx, args.get(&cx, 0usize)).put(&cx, ", ").add(&cx, c_order(&cx, order)).put(&cx, ");").done(&cx));
        } else if kind.is(&cx, "store") {
            self.line(&cx, Out::new(&cx).put(&cx, "__atomic_store_n(").add(&cx, args.get(&cx, 0usize)).put(&cx, ", ").add(&cx, args.get(&cx, 1usize)).put(&cx, ", ").add(&cx, c_order(&cx, order)).put(&cx, ");").done(&cx));
            self.unit(&cx, dst);
        } else if kind.is(&cx, "swap") {
            self.line(&cx, Out::new(&cx).add(&cx, d).put(&cx, " = __atomic_exchange_n(").add(&cx, args.get(&cx, 0usize)).put(&cx, ", ").add(&cx, args.get(&cx, 1usize)).put(&cx, ", ")
                .add(&cx, c_order(&cx, order)).put(&cx, ");").done(&cx));
        } else if kind.is(&cx, "compare_exchange") {
            let (success, failure) = match order.find(&cx, text(&cx, "/"), 0usize) {
                Option::Some(at) => (order.slice(0usize, at), order.from(at + 1usize)),
                Option::None => (order, text(&cx, "")),
            };
            self.line(&cx, Out::new(&cx).add(&cx, d).put(&cx, ".e0 = ").add(&cx, args.get(&cx, 1usize)).put(&cx, ";").done(&cx));
            self.line(&cx, Out::new(&cx).add(&cx, d).put(&cx, ".e1 = __atomic_compare_exchange_n(").add(&cx, args.get(&cx, 0usize)).put(&cx, ", &").add(&cx, d).put(&cx, ".e0, ")
                .add(&cx, args.get(&cx, 2usize)).put(&cx, ", 0, ").add(&cx, c_order(&cx, success)).put(&cx, ", ").add(&cx, c_order(&cx, failure)).put(&cx, ");").done(&cx));
        } else {
            self.line(&cx, Out::new(&cx).add(&cx, d).put(&cx, " = __atomic_").add(&cx, kind).put(&cx, "(").add(&cx, args.get(&cx, 0usize)).put(&cx, ", ").add(&cx, args.get(&cx, 1usize)).put(&cx, ", ")
                .add(&cx, c_order(&cx, order)).put(&cx, ");").done(&cx));
        }
    }

    fn foreach_instr(self, &cx: Cx!['k], instr: Instr['k], dst: Text['k]) {
        let original = match instr.ty {
            Option::Some(ty) => match ty {
                Type::Foreach(f) => f,
                _ => fail_text(&cx, text(&cx, "internal error: a foreach of a type that is not a transform")),
            },
            Option::None => fail_text(&cx, text(&cx, "internal error: a foreach without its type")),
        };
        let (t, renamed) = subst_foreach(&cx, original, self.sub.get(&cx), self.counter);
        let source = self.value_name(&cx, instr.args.get(&cx, 0usize));
        let mapper_name = instr.args.get(&cx, 1usize);
        let mapper = self.program.funs.at(&cx, mapper_name);
        let binders: Seq[Text['k], 'k] = Seq::new(&cx);
        let names = foreach_binders(&cx, original);
        var b = 0usize;
        while b < names.len(&cx) {
            let name = names.get(&cx, b);
            let binder = match renamed.get(&cx, name) {
                Option::Some(found) => match found {
                    Type::Named(n, args) => {
                        if !args.is_empty(&cx) {
                            fail_text(&cx, text(&cx, "internal error: a foreach binder renamed to an application"));
                        }
                        n
                    },
                    _ => fail_text(&cx, text(&cx, "internal error: a foreach binder renamed to a type that is not a name")),
                },
                Option::None => name,
            };
            binders.push(&cx, binder);
            b = b + 1usize;
        }
        let own: Seq[Type['k], 'k] = Seq::new(&cx);
        var o = 0usize;
        while o < instr.tys.len(&cx) {
            own.push(&cx, self.substitute_type(&cx, instr.tys.get(&cx, o)));
            o = o + 1usize;
        }
        if mapper.params.len(&cx) != binders.len(&cx) + own.len(&cx) {
            fail_at(&cx, text(&cx, "foreach mapper parameter partition disagrees"), instr.pos);
        }
        let caps: Seq[Text['k], 'k] = Seq::new(&cx);
        var c = 2usize;
        while c < instr.args.len(&cx) {
            caps.push(&cx, self.value_name(&cx, instr.args.get(&cx, c)));
            c = c + 1usize;
        }
        let found = self.types.rows(&cx, t.source.get(&cx), Option::None, false);
        let rows = found.rows;
        let pointer = is_ptr(self.shape(&cx, t.source.get(&cx))) && !is_foreach(t.source.get(&cx));
        let out_shape = self.shape(&cx, Type::Foreach.(t));
        let walk = Walk.{ backend: self, t, mapper, mapper_name, binders, own, caps };
        let skeleton = match found.skeleton {
            Option::Some(s) => s,
            Option::None => {
                let component = if is_foreach(t.source.get(&cx)) { Out::new(&cx).add(&cx, source).put(&cx, ".e0").done(&cx) } else { source };
                self.line(&cx, Out::new(&cx).add(&cx, dst).put(&cx, ".e0 = ").add(&cx, walk.apply(&cx, rows.get(&cx, 0usize), component)).put(&cx, ";").done(&cx));
                return ();
            },
        };
        let unit = match skeleton {
            Type::Enum(_variants) => {
                self.line(&cx, Out::new(&cx).put(&cx, "switch (").add(&cx, source).put(&cx, ".tag) {").done(&cx));
                var k = 0usize;
                while k < rows.len(&cx) {
                    let row = rows.get(&cx, k);
                    let member = self.variant(&cx, row.label);
                    let applied = walk.apply(&cx, row, Out::new(&cx).add(&cx, source).put(&cx, ".payload.").add(&cx, member).done(&cx));
                    self.line(&cx, Out::new(&cx).put(&cx, "case ").usize(&cx, k).put(&cx, ": ").add(&cx, dst).put(&cx, ".payload.").add(&cx, member).put(&cx, " = ").add(&cx, applied)
                        .put(&cx, "; ").add(&cx, dst).put(&cx, ".tag = ").usize(&cx, k).put(&cx, "; break;").done(&cx));
                    k = k + 1usize;
                }
                self.line(&cx, text(&cx, "default: KUR_TRAP();\n  }"));
                return ();
            },
            _ => (),
        };
        let (src_access, dst_access) = match skeleton {
            Type::Array(_elem, _length) => (items_access(&cx, rows.len(&cx)), items_access(&cx, rows.len(&cx))),
            _ => (member_names(&cx, self.members(&cx, skeleton)), member_names(&cx, self.members(&cx, out_shape))),
        };
        var source_access = src_access;
        if is_foreach(t.source.get(&cx)) {
            let inner_shape = self.shape(&cx, t.source.get(&cx));
            source_access = match inner_shape {
                Type::Array(_elem, _length) => items_access(&cx, rows.len(&cx)),
                _ => member_names(&cx, self.members(&cx, inner_shape)),
            };
        }
        var k = 0usize;
        while k < rows.len(&cx) && k < source_access.len(&cx) && k < dst_access.len(&cx) {
            let component = if pointer {
                Out::new(&cx).put(&cx, "KUR_FIELD(").add(&cx, source).put(&cx, ", ").add(&cx, source_access.get(&cx, k)).put(&cx, ")").done(&cx)
            } else {
                Out::new(&cx).add(&cx, source).put(&cx, ".").add(&cx, source_access.get(&cx, k)).done(&cx)
            };
            let applied = walk.apply(&cx, rows.get(&cx, k), component);
            self.line(&cx, Out::new(&cx).add(&cx, dst).put(&cx, ".").add(&cx, dst_access.get(&cx, k)).put(&cx, " = ").add(&cx, applied).put(&cx, ";").done(&cx));
            k = k + 1usize;
        }
        if rows.is_empty(&cx) {
            self.line(&cx, Out::new(&cx).add(&cx, dst).put(&cx, ".dummy = 0;").done(&cx));
        }
    }

    // ---------------------------------------------------------------- terminators --

    fn term(self, &cx: Cx!['k], term: Terminator['k]) {
        match term {
            Terminator::Ret(value, _pos) => self.line(&cx, Out::new(&cx).put(&cx, "return ").add(&cx, self.value_name(&cx, value)).put(&cx, ";").done(&cx)),
            Terminator::Jmp(edge, _pos) => self.edge(&cx, edge, Option::None, text(&cx, "")),
            Terminator::Jnz(cond, then, other, _pos) => {
                self.line(&cx, Out::new(&cx).put(&cx, "if (").add(&cx, self.value_name(&cx, cond)).put(&cx, ") {").done(&cx));
                self.edge(&cx, then, Option::None, text(&cx, "  "));
                self.line(&cx, text(&cx, "} else {"));
                self.edge(&cx, other, Option::None, text(&cx, "  "));
                self.line(&cx, text(&cx, "}"));
            },
            Terminator::Switch(scrutinee, ty, arms, _pos) => self.switch(&cx, scrutinee, ty, arms),
            Terminator::Unreachable(_pos) => self.line(&cx, text(&cx, "KUR_TRAP();")),
        };
    }

    // A jump assigns every target parameter at once, through scratch locals.
    fn edge(self, &cx: Cx!['k], edge: Edge['k], payload: Option[Text['k]], indent: Text['k]) {
        let target = self.blocks.get(&cx).at(&cx, edge.target);
        let values: Seq[Text['k], 'k] = Seq::new(&cx);
        match payload {
            Option::Some(p) => values.push(&cx, p),
            Option::None => (),
        };
        var a = 0usize;
        while a < edge.args.len(&cx) {
            values.push(&cx, self.value_name(&cx, edge.args.get(&cx, a)));
            a = a + 1usize;
        }
        let params: Seq[(Text['k], Type['k]), 'k] = Seq::new(&cx);
        var p = 0usize;
        while p < target.params.len(&cx) {
            params.push(&cx, (self.cname(&cx, target.label, target.params.get(&cx, p).name), target.params.get(&cx, p).type));
            p = p + 1usize;
        }
        let temps: Seq[Text['k], 'k] = Seq::new(&cx);
        var i = 0usize;
        while i < params.len(&cx) && i < values.len(&cx) {
            let (_cname, t) = params.get(&cx, i);
            let temp = allocate(&cx, Out::new(&cx).put(&cx, "edge_").usize(&cx, self.scratch.get(&cx)).done(&cx), self.taken);
            self.scratch.set(&cx, self.scratch.get(&cx) + 1usize);
            self.decls.get(&cx).push(&cx, Out::new(&cx).add(&cx, self.c(&cx, self.substitute_type(&cx, t))).put(&cx, " ").add(&cx, temp).put(&cx, ";").done(&cx));
            self.line(&cx, Out::new(&cx).add(&cx, indent).add(&cx, temp).put(&cx, " = ").add(&cx, values.get(&cx, i)).put(&cx, ";").done(&cx));
            temps.push(&cx, temp);
            i = i + 1usize;
        }
        var j = 0usize;
        while j < params.len(&cx) && j < temps.len(&cx) {
            let (cname, _t) = params.get(&cx, j);
            self.line(&cx, Out::new(&cx).add(&cx, indent).add(&cx, cname).put(&cx, " = ").add(&cx, temps.get(&cx, j)).put(&cx, ";").done(&cx));
            j = j + 1usize;
        }
        self.line(&cx, Out::new(&cx).add(&cx, indent).put(&cx, "goto ").add(&cx, self.labels.get(&cx).at(&cx, target.label)).put(&cx, ";").done(&cx));
    }

    fn switch(self, &cx: Cx!['k], arg: Text['k], ty: Type['k], arms: Seq[Arm['k], 'k]) {
        let place = arg.starts_with(&cx, text(&cx, "&"));
        let source = if place {
            let (expr, _t) = self.place(&cx, arg);
            expr
        } else {
            self.value_name(&cx, arg)
        };
        let variants = self.types.variants(&cx, erase(&cx, self.substitute_type(&cx, ty), self.types), Option::None);
        self.line(&cx, Out::new(&cx).put(&cx, "switch (").add(&cx, source).put(&cx, ".tag) {").done(&cx));
        var i = 0usize;
        while i < arms.len(&cx) {
            let arm = arms.get(&cx, i);
            var index = 0usize;
            var found = false;
            while !found && index < variants.len(&cx) {
                if variants.get(&cx, index).name.eq(&cx, arm.variant) {
                    found = true;
                } else {
                    index = index + 1usize;
                }
            }
            self.line(&cx, Out::new(&cx).put(&cx, "case ").usize(&cx, index).put(&cx, ":").done(&cx));
            let payload = if place {
                Option::None
            } else {
                Option::Some.(Out::new(&cx).add(&cx, source).put(&cx, ".payload.").add(&cx, self.variant(&cx, arm.variant)).done(&cx))
            };
            self.line(&cx, text(&cx, "  {"));
            self.edge(&cx, arm.edge, payload, text(&cx, "    "));
            self.line(&cx, text(&cx, "  }"));
            i = i + 1usize;
        }
        self.line(&cx, text(&cx, "default: KUR_TRAP();"));
        self.line(&cx, text(&cx, "}"));
    }
}

forall 'k.
fn width(&cx: Cx!['k], name: Text['k]) -> u32 {
    if name.is(&cx, "f32") { 32u32 } else if name.is(&cx, "f64") { 64u32 } else { C::integer_bits(&cx, name) }
}

forall 'k.
fn wrap(&cx: Cx!['k], expr: Text['k], bits: u32, signed: bool, ct: Text['k]) -> Text['k] {
    if signed {
        Out::new(&cx).put(&cx, "kur_dec_i").u64(&cx, bits as u64).put(&cx, "(").add(&cx, expr).put(&cx, ")").done(&cx)
    } else {
        Out::new(&cx).put(&cx, "(").add(&cx, ct).put(&cx, ")(").add(&cx, expr).put(&cx, ")").done(&cx)
    }
}

forall 'k.
fn last_member(&cx: Cx!['k], members: Seq[Member['k], 'k], name: Text['k]) -> Type['k] {
    var found: Option[Type['k]] = Option::None;
    var i = 0usize;
    while i < members.len(&cx) {
        if members.get(&cx, i).name.eq(&cx, name) {
            found = Option::Some.(members.get(&cx, i).type);
        }
        i = i + 1usize;
    }
    match found {
        Option::Some(t) => t,
        Option::None => fail_text(&cx, text(&cx, "internal error: no such variant")),
    }
}

// One foreach instruction's mapping of its rows: the transform at the specialization, the mapper,
// its traversal binders, its own type arguments and the captured values.
forall 'k.
exposed struct Walk {
    backend: Backend['k],
    t: ForeachType['k],
    mapper: Fun['k],
    mapper_name: Text['k],
    binders: Seq[Text['k], 'k],
    own: Seq[Type['k], 'k],
    caps: Seq[Text['k], 'k],
}

forall 'k.
impl Walk['k] {
    fn apply(self, &cx: Cx!['k], row: Row['k], component: Text['k]) -> Text['k] {
        let bound = self.backend.types.bind(&cx, self.t, row.item, row.extra);
        let sub: Map[Text['k], Type['k], 'k] = Map::new(&cx);
        var i = 0usize;
        while i < self.mapper.params.len(&cx) && i < self.binders.len(&cx) {
            sub.set(&cx, self.mapper.params.get(&cx, i).name, bound.at(&cx, self.binders.get(&cx, i)));
            i = i + 1usize;
        }
        var j = self.binders.len(&cx);
        while j < self.mapper.params.len(&cx) && j - self.binders.len(&cx) < self.own.len(&cx) {
            sub.set(&cx, self.mapper.params.get(&cx, j).name, self.own.get(&cx, j - self.binders.len(&cx)));
            j = j + 1usize;
        }
        let arguments = Seq::one(&cx, component);
        arguments.append(&cx, self.caps);
        Out::new(&cx).add(&cx, self.backend.request(&cx, FunKey::Function.(self.mapper_name), self.mapper, sub)).put(&cx, "(").add(&cx, joined(&cx, arguments, ", ")).put(&cx, ")").done(&cx)
    }
}

forall 'k.
fn emit_c(&cx: Cx!['k], program: Program['k], checker: Checker['k], entry: Option[Text['k]], counter: Fresh['k]) -> Text['k] {
    Backend::new(&cx, program, checker, counter).emit_program(&cx, entry)
}
