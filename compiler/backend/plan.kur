// What the C backend leaves out of one function, decided from its checked KURS before any C is
// written: live values, copies, forwarded places, return joins, tail calls and residences. It
// translates `plan.py`, whose docstring states each rule.

use std::collections::arena_vec::ArenaVec;
use std::collections::arena_map::{ArenaMap, ArenaSet};
use std::raw::Span;
use std::alloc::arena::Domain!;
use std::bytes::buffer::Buffer!;
use package::kurs::core::{Block, Edge, Fun, Instr, Terminator, Type, atomic_kind, same};
use package::check::checker::{overlap, prefix};
use std::option::Option;

// Instructions whose C writes only their results: left out when every result is dead.
forall 'k.
fn is_pure(&cx: Domain!['k], op: Span['k]) -> bool {
    op.is(&cx, "const") || op.is(&cx, "copy") || op.is(&cx, "construct") || op.is(&cx, "construct_variant")
        || op.is(&cx, "destruct") || op.is(&cx, "variant_tag") || op.is(&cx, "load") || op.is(&cx, "int_cast")
        || op.is(&cx, "to_ptr") || op.is(&cx, "pack") || op.is(&cx, "open") || op.is(&cx, "static_brand") || op.is(&cx, "fresh")
        || op.is(&cx, "add") || op.is(&cx, "sub") || op.is(&cx, "mul") || op.is(&cx, "bit_and") || op.is(&cx, "bit_or")
        || op.is(&cx, "bit_xor") || op.is(&cx, "shl") || op.is(&cx, "shr") || op.is(&cx, "eq") || op.is(&cx, "ne")
        || op.is(&cx, "lt") || op.is(&cx, "le") || op.is(&cx, "gt") || op.is(&cx, "ge")
}

// Instructions whose dead result the C does not assign: unit results of stores, and call results.
forall 'k.
fn is_unassigned(&cx: Domain!['k], op: Span['k]) -> bool {
    op.is(&cx, "store") || op.is(&cx, "ptr_store") || op.is(&cx, "ptr_store_volatile")
        || op.is(&cx, "ptr_atomic_store") || op.is(&cx, "fence")
        || op.is(&cx, "call") || op.is(&cx, "trait_call")
}

// Instructions that may write memory through a raw pointer, or run code that may: memory under a place
// parameter counts as reachable so too, since this backend does not rely on a raw target's exclusivity.
forall 'k.
fn is_opaque(&cx: Domain!['k], op: Span['k]) -> bool {
    let writes = match atomic_kind(&cx, op) {
        Option::Some(kind) => !(kind.is(&cx, "load") || kind.is(&cx, "fence")),
        Option::None => false,
    };
    writes || op.is(&cx, "call") || op.is(&cx, "trait_call") || op.is(&cx, "foreach") || op.is(&cx, "ptr_store")
        || op.is(&cx, "ptr_store_volatile")
}

// Whether an instruction is a call: `call` or `trait_call`.
forall 'k.
fn is_call(&cx: Domain!['k], op: Span['k]) -> bool {
    op.is(&cx, "call") || op.is(&cx, "trait_call")
}

// A lend adapter, which lowering makes for a lend of a value: it stores its parameters at `borrowed`
// (in the order it hands them back) into places of its own, lends those to one call, and returns them
// reloaded beside the call's result in a tuple, or never returns (`returns` false).
forall 'k.
exposed struct Adapter {
    borrowed: ArenaVec[usize, 'k],
    returns: bool,
}

// The SSA value an operand reads: `%x`, or the pointer of a raw target `&*%x`; none for a place.
forall 'k.
fn value_read(&cx: Domain!['k], arg: Span['k]) -> Option[Span['k]] {
    if arg.starts_with(&cx, Span::from_static(&cx, "%")) {
        Option::Some.(arg)
    } else if arg.starts_with(&cx, Span::from_static(&cx, "&*")) {
        Option::Some.(arg.skip(2usize))
    } else {
        Option::None
    }
}

// Whether an operand is a place path (not a raw target).
forall 'k.
fn is_place(&cx: Domain!['k], arg: Span['k]) -> bool {
    arg.starts_with(&cx, Span::from_static(&cx, "&")) && !arg.starts_with(&cx, Span::from_static(&cx, "&*"))
}

forall 'k.
fn root(&cx: Domain!['k], path: Span['k]) -> Span['k] {
    match path.find(&cx, Span::from_static(&cx, "."), 0usize) {
        Option::Some(at) => path.slice(0usize, at),
        Option::None => path,
    }
}

// Adds what `instr` reads to `used`.
forall 'k.
fn add_reads(&cx: Domain!['k], used: ArenaSet[Span['k], 'k], instr: Instr['k]) {
    var i = 0usize;
    while i < instr.args.len(&cx) {
        match value_read(&cx, instr.args.at(&cx, i)) {
            Option::Some(v) => {
                let added = used.insert(&cx, v);
            },
            Option::None => (),
        };
        i = i + 1usize;
    }
}

// Each edge of a terminator, with the number of target parameters before its arguments: a switch
// on a value passes the variant's payload first.
forall 'k.
fn term_edges(&cx: Domain!['k], term: Terminator['k]) -> ArenaVec[(Edge['k], usize), 'k] {
    let out: ArenaVec[(Edge['k], usize), 'k] = ArenaVec::new(&cx);
    match term {
        Terminator::Jmp(edge, _pos) => out.push(&cx, (edge, 0usize)),
        Terminator::Jnz(_cond, then, other, _pos) => {
            out.push(&cx, (then, 0usize));
            out.push(&cx, (other, 0usize));
        },
        Terminator::Switch(scrutinee, _ty, arms, _pos) => {
            let skip = if scrutinee.starts_with(&cx, Span::from_static(&cx, "&")) { 0usize } else { 1usize };
            var a = 0usize;
            while a < arms.len(&cx) {
                out.push(&cx, (arms.at(&cx, a).edge, skip));
                a = a + 1usize;
            }
        },
        _ => (),
    };
    out
}

// The index of `name` among `block`'s parameters.
forall 'k.
fn param_index(&cx: Domain!['k], block: Block['k], name: Span['k]) -> Option[usize] {
    var i = 0usize;
    while i < block.params.len(&cx) {
        if block.params.at(&cx, i).name.eq(&cx, name) {
            return Option::Some.(i);
        }
        i = i + 1usize;
    }
    Option::None
}

// The maps `Plan::residences` works in, made once per function and cleared for each block, keeping
// the room they have.
forall 'k.
exposed struct Scratch {
    alias: ArenaMap[Span['k], Span['k], 'k],
    stored: ArenaMap[Span['k], Span['k], 'k],
    held: ArenaMap[Span['k], Type['k], 'k],
    candidates: ArenaMap[Span['k], (Span['k], usize, Option[usize]), 'k],
    lent: ArenaMap[usize, ArenaVec[(Span['k], Span['k]), 'k], 'k],
    last: ArenaMap[Span['k], usize, 'k],
    reads: ArenaMap[Span['k], usize, 'k],
    valid: ArenaSet[Span['k], 'k],
}

forall 'k.
exposed struct Plan {
    fun: Fun['k],
    blocks: ArenaMap[Span['k], Block['k], 'k],
    // the local places a store and a load alone name
    forwarded: ArenaSet[Span['k], 'k],
    // a return join -> the position of the parameter it returns
    return_index: ArenaMap[Span['k], usize, 'k],
    // the blocks the C has: every edge into a return join returns instead
    emitted: ArenaVec[Block['k], 'k],
    // (block label, SSA name) of every value the C reads
    live: ArenaSet[(Span['k], Span['k]), 'k],
    // Reused by `block_reads`: each result is consumed before the next block is visited.
    read_scratch: ArenaSet[Span['k], 'k],
    // the values that need a C variable
    variables: ArenaSet[(Span['k], Span['k]), 'k],
    // (block label, SSA name) -> the path the value is read from
    resident: ArenaMap[(Span['k], Span['k]), Span['k], 'k],
    // (block label, index) of a lend adapter's call -> the paths it lends its callee, in the order
    // handed back
    in_place: ArenaMap[(Span['k], usize), ArenaVec[Span['k], 'k], 'k],
    // (block label, index) of each store that writes nothing, and of each construction its store
    // writes in place
    unwritten: ArenaSet[(Span['k], usize), 'k],
    fused: ArenaSet[(Span['k], usize), 'k],
    // (block label, value) -> (block label, parameter) whose C variable the value is assigned to
    shared: ArenaMap[(Span['k], Span['k]), (Span['k], Span['k]), 'k],
    // (block label, payload parameter) -> (block label, scrutinee, variant) whose payload the
    // parameter reads
    arrived: ArenaMap[(Span['k], Span['k]), (Span['k], Span['k], Span['k]), 'k],
    // every key of `resident`, `shared` and `arrived`: the values the C reads elsewhere than in a
    // variable of their own
    moved: ArenaSet[(Span['k], Span['k]), 'k],
    // (block label, parameter) -> each (component index, the place path the component is written to),
    // by index (`home_params`)
    homed: ArenaMap[(Span['k], Span['k]), ArenaVec[(usize, Span['k]), 'k], 'k],
    // (block label, value) of each construction or call shared into a homed parameter: it writes the
    // homed components itself, and the edge does not
    made_home: ArenaSet[(Span['k], Span['k]), 'k],
}

forall 'k.
impl Plan['k] {
    // `components`: for each (block, index) of a `destruct` or `construct` of a struct or tuple, the
    // labels of its components in a place path, and in `shapes` its type with brands erased;
    // `adapters`: the lend adapters the function calls; `params`: the place parameters, whose memory a
    // raw pointer may reach.
    fn new(&cx: Domain!['k], fun: Fun['k], components: ArenaMap[(Span['k], usize), ArenaVec[Span['k], 'k], 'k],
        adapters: ArenaMap[Span['k], Adapter['k], 'k], params: ArenaSet[Span['k], 'k], shapes: ArenaMap[(Span['k], usize), Type['k], 'k]) -> Plan['k] {
        let blocks: ArenaMap[Span['k], Block['k], 'k] = ArenaMap::new(&cx);
        var b = 0usize;
        while b < fun.blocks.len(&cx) {
            let unit = blocks.insert(&cx, fun.blocks.at(&cx, b).label, fun.blocks.at(&cx, b));
            b = b + 1usize;
        }
        let plan = Plan.{ fun, blocks, forwarded: ArenaSet::new(&cx), return_index: ArenaMap::new(&cx), emitted: ArenaVec::new(&cx),
            live: ArenaSet::new(&cx), read_scratch: ArenaSet::new(&cx), variables: ArenaSet::new(&cx), resident: ArenaMap::new(&cx), in_place: ArenaMap::new(&cx),
            unwritten: ArenaSet::new(&cx), fused: ArenaSet::new(&cx), shared: ArenaMap::new(&cx), arrived: ArenaMap::new(&cx),
            moved: ArenaSet::new(&cx), homed: ArenaMap::new(&cx), made_home: ArenaSet::new(&cx) };
        plan.forwarded_places(&cx);
        var r = 1usize;
        while r < fun.blocks.len(&cx) {
            let label = fun.blocks.at(&cx, r).label;
            match plan.returned(&cx, label, ArenaSet::new(&cx)) {
                Option::Some(index) => {
                    let unit = plan.return_index.insert(&cx, label, index);
                },
                Option::None => (),
            };
            r = r + 1usize;
        }
        var e = 0usize;
        while e < fun.blocks.len(&cx) {
            let block = fun.blocks.at(&cx, e);
            if !plan.return_index.contains(&cx, block.label) {
                plan.emitted.push(&cx, block);
            }
            e = e + 1usize;
        }
        let scratch = Scratch.{ alias: ArenaMap::new(&cx), stored: ArenaMap::new(&cx), held: ArenaMap::new(&cx), candidates: ArenaMap::new(&cx),
            lent: ArenaMap::new(&cx), last: ArenaMap::new(&cx), reads: ArenaMap::new(&cx), valid: ArenaSet::new(&cx) };
        var s = 0usize;
        while s < plan.emitted.len(&cx) {
            plan.residences(&cx, plan.emitted.at(&cx, s), components, adapters, params, shapes, scratch);
            s = s + 1usize;
        }
        plan.liveness(&cx);
        plan.share(&cx);
        plan.home_params(&cx, components);
        plan.c_variables(&cx);
        plan
    }

    fn is_live(self, &cx: Domain!['k], label: Span['k], name: Span['k]) -> bool {
        self.live.contains(&cx, (label, name))
    }

    // ---------------------------------------------------------------- forwarding --

    // The local places a store and a load alone name, the load later in the store's block.
    fn forwarded_places(self, &cx: Domain!['k]) {
        // place root -> each (block, instruction index, opcode or "" for a switch, path) naming it
        let named: ArenaMap[Span['k], ArenaVec[(usize, usize, Span['k], Span['k]), 'k], 'k] = ArenaMap::new(&cx);
        var b = 0usize;
        while b < self.fun.blocks.len(&cx) {
            let block = self.fun.blocks.at(&cx, b);
            var i = 0usize;
            while i < block.instrs.len(&cx) {
                let instr = block.instrs.at(&cx, i);
                var a = 0usize;
                while a < instr.args.len(&cx) {
                    let arg = instr.args.at(&cx, a);
                    if is_place(&cx, arg) {
                        name_place(&cx, named, (b, i, instr.op, arg));
                    }
                    a = a + 1usize;
                }
                i = i + 1usize;
            }
            match block.term {
                Terminator::Switch(scrutinee, _ty, _arms, _pos) => {
                    if scrutinee.starts_with(&cx, Span::from_static(&cx, "&")) {
                        name_place(&cx, named, (b, block.instrs.len(&cx), Span::from_static(&cx, ""), scrutinee));
                    }
                },
                _ => (),
            };
            b = b + 1usize;
        }
        var l = 0usize;
        while l < self.fun.locals.len(&cx) {
            let name = self.fun.locals.at(&cx, l).name;
            match named.get(&cx, name) {
                Option::Some(uses) => {
                    if uses.len(&cx) == 2usize {
                        let (b1, i1, op1, path1) = uses.at(&cx, 0usize);
                        let (b2, i2, op2, path2) = uses.at(&cx, 1usize);
                        if op1.is(&cx, "store") && op2.is(&cx, "load") && path1.eq(&cx, name) && path2.eq(&cx, name) && b1 == b2 && i1 < i2 {
                            let added = self.forwarded.insert(&cx, name);
                        }
                    }
                },
                Option::None => (),
            };
            l = l + 1usize;
        }
    }

    fn is_forwarded_load(self, &cx: Domain!['k], instr: Instr['k]) -> bool {
        instr.op.is(&cx, "load") && self.forwarded.contains(&cx, instr.args.at(&cx, 0usize))
    }

    // ------------------------------------------------------------------ liveness --

    fn liveness(self, &cx: Domain!['k]) {
        let live_params: ArenaSet[(Span['k], Span['k]), 'k] = ArenaSet::new(&cx);
        var changed = true;
        while changed {
            changed = false;
            var b = self.emitted.len(&cx);
            while b > 0usize {
                b = b - 1usize;
                let block = self.emitted.at(&cx, b);
                let used = self.block_reads(&cx, block, live_params);
                var p = 0usize;
                while p < block.params.len(&cx) {
                    let name = block.params.at(&cx, p).name;
                    if used.contains(&cx, name) && live_params.insert(&cx, (block.label, name)) {
                        changed = true;
                    }
                    p = p + 1usize;
                }
            }
        }
        var k = 0usize;
        while k < self.emitted.len(&cx) {
            let block = self.emitted.at(&cx, k);
            let used = self.block_reads(&cx, block, live_params);
            var u = 0usize;
            while u < used.positions(&cx) {
                match used.key_at(&cx, u) {
                    Option::Some(name) => {
                        let added = self.live.insert(&cx, (block.label, name));
                    },
                    Option::None => (),
                };
                u = u + 1usize;
            }
            k = k + 1usize;
        }
    }

    // The names of `block` the C reads, given which parameters of other blocks are live.
    fn block_reads(self, &cx: Domain!['k], block: Block['k], live_params: ArenaSet[(Span['k], Span['k]), 'k]) -> ArenaSet[Span['k], 'k] {
        let used = self.read_scratch;
        used.clear(&cx);
        match block.term {
            Terminator::Ret(value, _pos) => {
                let added = used.insert(&cx, value);
            },
            Terminator::Jnz(cond, _then, _other, _pos) => {
                let added = used.insert(&cx, cond);
            },
            Terminator::Switch(scrutinee, _ty, _arms, _pos) => {
                if !scrutinee.starts_with(&cx, Span::from_static(&cx, "&")) {
                    let added = used.insert(&cx, scrutinee);
                }
            },
            _ => (),
        };
        let edges = term_edges(&cx, block.term);
        var e = 0usize;
        while e < edges.len(&cx) {
            let (edge, skip) = edges.at(&cx, e);
            let target = self.blocks.at(&cx, edge.target);
            match self.return_index.get(&cx, target.label) {
                Option::Some(index) => {
                    // The payload, when it is the value returned, is the scrutinee's, which the switch reads.
                    if index >= skip {
                        let added = used.insert(&cx, edge.args.at(&cx, index - skip));
                    }
                },
                Option::None => {
                    var a = 0usize;
                    while a < edge.args.len(&cx) && skip + a < target.params.len(&cx) {
                        if live_params.contains(&cx, (target.label, target.params.at(&cx, skip + a).name)) {
                            let added = used.insert(&cx, edge.args.at(&cx, a));
                        }
                        a = a + 1usize;
                    }
                },
            };
            e = e + 1usize;
        }
        var i = block.instrs.len(&cx);
        while i > 0usize {
            i = i - 1usize;
            let instr = block.instrs.at(&cx, i);
            var any_used = false;
            var l = 0usize;
            while l < instr.lhs.len(&cx) {
                if used.contains(&cx, instr.lhs.at(&cx, l)) {
                    any_used = true;
                }
                l = l + 1usize;
            }
            if any_used || !is_pure(&cx, instr.op) {
                add_reads(&cx, used, instr);
            }
        }
        used
    }

    // The values that need a C variable: live parameters, and the results the C assigns.
    fn c_variables(self, &cx: Domain!['k]) {
        var b = 0usize;
        while b < self.emitted.len(&cx) {
            let block = self.emitted.at(&cx, b);
            var p = 0usize;
            while p < block.params.len(&cx) {
                let key = (block.label, block.params.at(&cx, p).name);
                if self.live.contains(&cx, key) && !self.arrived.contains(&cx, key) {
                    let added = self.variables.insert(&cx, key);
                }
                p = p + 1usize;
            }
            var i = 0usize;
            while i < block.instrs.len(&cx) {
                let instr = block.instrs.at(&cx, i);
                if !instr.op.is(&cx, "copy") && !self.is_forwarded_load(&cx, instr) && !self.fused.contains(&cx, (block.label, i))
                    && !self.in_place.contains(&cx, (block.label, i)) {
                    var l = 0usize;
                    while l < instr.lhs.len(&cx) {
                        let key = (block.label, instr.lhs.at(&cx, l));
                        if !self.resident.contains(&cx, key) && !self.shared.contains(&cx, key) && (self.live.contains(&cx, key) || !is_pure(&cx, instr.op) && !is_unassigned(&cx, instr.op)) {
                            let added = self.variables.insert(&cx, key);
                        }
                        l = l + 1usize;
                    }
                }
                i = i + 1usize;
            }
            b = b + 1usize;
        }
    }

    // ------------------------------------------------------------------- sharing --

    // Values that move along one edge share the C variable they move into; `Plan.share` in plan.py
    // states the rules.
    fn share(self, &cx: Domain!['k]) {
        let incoming: ArenaMap[Span['k], usize, 'k] = ArenaMap::new(&cx);
        var b = 0usize;
        while b < self.emitted.len(&cx) {
            let edges = term_edges(&cx, self.emitted.at(&cx, b).term);
            var e = 0usize;
            while e < edges.len(&cx) {
                let (edge, _skip) = edges.at(&cx, e);
                incoming.insert(&cx, edge.target, incoming.get_or(&cx, edge.target, 0usize) + 1usize);
                e = e + 1usize;
            }
            b = b + 1usize;
        }
        var a = 0usize;
        while a < self.emitted.len(&cx) {
            self.arrive(&cx, self.emitted.at(&cx, a), incoming);
            a = a + 1usize;
        }
        var k = 0usize;
        while k < self.emitted.len(&cx) {
            let block = self.emitted.at(&cx, k);
            // Nothing moves along an edge without arguments.
            let edges_here = term_edges(&cx, block.term);
            var moving = false;
            var q = 0usize;
            while !moving && q < edges_here.len(&cx) {
                let (edge, _skip) = edges_here.at(&cx, q);
                moving = !edge.args.is_empty(&cx);
                q = q + 1usize;
            }
            if moving {
                self.share_block(&cx, block);
            }
            k = k + 1usize;
        }
    }

    // The payloads that arrive where the scrutinee of a switch ending `block` lies (`arrived`).
    fn arrive(self, &cx: Domain!['k], block: Block['k], incoming: ArenaMap[Span['k], usize, 'k]) {
        let label = block.label;
        match block.term {
            Terminator::Switch(scrutinee, _ty, arms, _pos) => {
                let placed = match self.resident.get(&cx, (label, scrutinee)) {
                    Option::Some(path) => path.starts_with(&cx, Span::from_static(&cx, "&")),
                    Option::None => false,
                };
                if !scrutinee.starts_with(&cx, Span::from_static(&cx, "&")) && !placed {
                    var r = 0usize;
                    while r < arms.len(&cx) {
                        let arm = arms.at(&cx, r);
                        let target = self.blocks.at(&cx, arm.edge.target);
                        if !self.return_index.contains(&cx, target.label) && !target.label.eq(&cx, label)
                            && is_at(incoming.get(&cx, target.label), 1usize) && !target.params.is_empty(&cx) {
                            self.arrived.insert(&cx, (target.label, target.params.at(&cx, 0usize).name), (label, scrutinee, arm.variant));
                            self.moved.insert(&cx, (target.label, target.params.at(&cx, 0usize).name));
                        }
                        r = r + 1usize;
                    }
                }
            },
            _ => (),
        };
    }

    // `share` in one block that passes something along an edge.
    fn share_block(self, &cx: Domain!['k], block: Block['k]) {
        let label = block.label;
        // The variable the block's payload is read in (`arrived`), which no value of the block is made in.
        let arrival = if block.params.is_empty(&cx) {
            Option::None
        } else if self.arrived.contains(&cx, (label, block.params.at(&cx, 0usize).name)) {
            self.variable(&cx, label, block.params.at(&cx, 0usize).name)
        } else {
            Option::None
        };
        let reads: ArenaMap[Span['k], usize, 'k] = ArenaMap::new(&cx);
        let assigned: ArenaSet[Span['k], 'k] = ArenaSet::new(&cx);
        var i = 0usize;
        while i < block.instrs.len(&cx) {
            let instr = block.instrs.at(&cx, i);
            var g = 0usize;
            while g < instr.args.len(&cx) {
                match value_read(&cx, instr.args.at(&cx, g)) {
                    Option::Some(v) => {
                        reads.insert(&cx, v, reads.get_or(&cx, v, 0usize) + 1usize);
                    },
                    Option::None => (),
                };
                g = g + 1usize;
            }
            if !instr.op.is(&cx, "copy") && !self.is_forwarded_load(&cx, instr) && !self.fused.contains(&cx, (label, i))
                && !self.in_place.contains(&cx, (label, i)) {
                var l = 0usize;
                while l < instr.lhs.len(&cx) {
                    assigned.insert(&cx, instr.lhs.at(&cx, l));
                    l = l + 1usize;
                }
            }
            i = i + 1usize;
        }
        let ending = term_reads(&cx, block.term);
        let edges = term_edges(&cx, block.term);
        var e = 0usize;
        while e < edges.len(&cx) {
            let (edge, _skip) = edges.at(&cx, e);
            ending.append(&cx, edge.args);
            e = e + 1usize;
        }
        var t = 0usize;
        while t < ending.len(&cx) {
            reads.insert(&cx, ending.at(&cx, t), reads.get_or(&cx, ending.at(&cx, t), 0usize) + 1usize);
            t = t + 1usize;
        }
        var f = 0usize;
        while f < edges.len(&cx) {
            let (edge, skip) = edges.at(&cx, f);
            let target = self.blocks.at(&cx, edge.target);
            if !self.return_index.contains(&cx, target.label) && !target.label.eq(&cx, label) {
                var a = 0usize;
                while a < edge.args.len(&cx) && skip + a < target.params.len(&cx) {
                    let param = target.params.at(&cx, skip + a).name;
                    let arg = edge.args.at(&cx, a);
                    let into = match arrival {
                        Option::Some(held) => {
                            let (at, name) = held;
                            at.eq(&cx, target.label) && name.eq(&cx, param)
                        },
                        Option::None => false,
                    };
                    if assigned.contains(&cx, arg) && is_at(reads.get(&cx, arg), 1usize) && !self.resident.contains(&cx, (label, arg))
                        && self.live.contains(&cx, (target.label, param)) && !into {
                        self.shared.insert(&cx, (label, arg), (target.label, param));
                        self.moved.insert(&cx, (label, arg));
                    }
                    a = a + 1usize;
                }
            }
            f = f + 1usize;
        }
    }

    // ---------------------------------------------------------- homed parameters --

    // Components of a block parameter written where they end up (`homed`); `Plan.home_params` in
    // plan.py states the rules.
    fn home_params(self, &cx: Domain!['k], components: ArenaMap[(Span['k], usize), ArenaVec[Span['k], 'k], 'k]) {
        // block label -> each (block, edge, skip) of an edge into it
        let preds: ArenaMap[Span['k], ArenaVec[(Block['k], Edge['k], usize), 'k], 'k] = ArenaMap::new(&cx);
        var b = 0usize;
        while b < self.emitted.len(&cx) {
            let block = self.emitted.at(&cx, b);
            let edges = term_edges(&cx, block.term);
            var e = 0usize;
            while e < edges.len(&cx) {
                let (edge, skip) = edges.at(&cx, e);
                match preds.get(&cx, edge.target) {
                    Option::Some(found) => found.push(&cx, (block, edge, skip)),
                    Option::None => {
                        let fresh: ArenaVec[(Block['k], Edge['k], usize), 'k] = ArenaVec::new(&cx);
                        fresh.push(&cx, (block, edge, skip));
                        let unit = preds.insert(&cx, edge.target, fresh);
                    },
                };
                e = e + 1usize;
            }
            b = b + 1usize;
        }
        let alias: ArenaMap[Span['k], Span['k], 'k] = ArenaMap::new(&cx);
        let stored: ArenaMap[Span['k], Span['k], 'k] = ArenaMap::new(&cx);
        // class -> (how many times the block reads it, where it reads it last: an instruction's index,
        // or the block's length for the terminator or an edge), but stores into forwarded places
        let reads: ArenaMap[Span['k], (usize, usize), 'k] = ArenaMap::new(&cx);
        var t = 1usize;
        while t < self.emitted.len(&cx) {
            let target = self.emitted.at(&cx, t);
            // Only a destruct of a parameter homes its components.
            var destructs = false;
            var d = 0usize;
            while !destructs && d < target.instrs.len(&cx) {
                destructs = target.instrs.at(&cx, d).op.is(&cx, "destruct");
                d = d + 1usize;
            }
            if destructs && !target.params.is_empty(&cx) {
                match preds.get(&cx, target.label) {
                    Option::Some(into) => self.home_block(&cx, target, into, components, alias, stored, reads),
                    Option::None => (),
                };
            }
            t = t + 1usize;
        }
    }

    // `home_params` in one block with edges into it.
    fn home_block(self, &cx: Domain!['k], target: Block['k], preds: ArenaVec[(Block['k], Edge['k], usize), 'k],
        components: ArenaMap[(Span['k], usize), ArenaVec[Span['k], 'k], 'k], alias: ArenaMap[Span['k], Span['k], 'k],
        stored: ArenaMap[Span['k], Span['k], 'k], reads: ArenaMap[Span['k], (usize, usize), 'k]) {
        let label = target.label;
        let instrs = target.instrs;
        let n = instrs.len(&cx);
        alias.clear(&cx);
        stored.clear(&cx);
        reads.clear(&cx);
        var i = 0usize;
        while i < n {
            let instr = instrs.at(&cx, i);
            let op = instr.op;
            let a = instr.args;
            if (op.is(&cx, "copy") || op.is(&cx, "open") || op.is(&cx, "pack")) && a.at(&cx, 0usize).starts_with(&cx, Span::from_static(&cx, "%")) {
                alias.insert(&cx, instr.lhs.at(&cx, 0usize), find(&cx, alias, a.at(&cx, 0usize)));
            } else if op.is(&cx, "store") && self.forwarded.contains(&cx, a.at(&cx, 0usize)) {
                stored.insert(&cx, a.at(&cx, 0usize), a.at(&cx, 1usize));
            } else if op.is(&cx, "load") && self.forwarded.contains(&cx, a.at(&cx, 0usize)) {
                alias.insert(&cx, instr.lhs.at(&cx, 0usize), find(&cx, alias, stored.at(&cx, a.at(&cx, 0usize))));
            }
            i = i + 1usize;
        }
        var j = 0usize;
        while j < n {
            let instr = instrs.at(&cx, j);
            if !(instr.op.is(&cx, "store") && self.forwarded.contains(&cx, instr.args.at(&cx, 0usize))) {
                var g = 0usize;
                while g < instr.args.len(&cx) {
                    match value_read(&cx, instr.args.at(&cx, g)) {
                        Option::Some(v) => count_read(&cx, reads, find(&cx, alias, v), j),
                        Option::None => (),
                    };
                    g = g + 1usize;
                }
            }
            j = j + 1usize;
        }
        let ending = term_reads(&cx, target.term);
        let edges = term_edges(&cx, target.term);
        var e = 0usize;
        while e < edges.len(&cx) {
            let (edge, _skip) = edges.at(&cx, e);
            ending.append(&cx, edge.args);
            e = e + 1usize;
        }
        var t = 0usize;
        while t < ending.len(&cx) {
            count_read(&cx, reads, find(&cx, alias, ending.at(&cx, t)), n);
            t = t + 1usize;
        }
        // the paths homed so far, in the order every edge and construction writes them
        let chosen: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
        var pi = 0usize;
        while pi < target.params.len(&cx) {
            let p = target.params.at(&cx, pi).name;
            if self.live.contains(&cx, (label, p)) {
                match read_once(reads.get(&cx, p), n) {
                    Option::Some(d) => {
                        let destruct = instrs.at(&cx, d);
                        if destruct.op.is(&cx, "destruct") && destruct.args.len(&cx) == 1usize && destruct.args.at(&cx, 0usize).eq(&cx, p)
                            && components.contains(&cx, (label, d)) {
                            self.home_param(&cx, target, preds, pi, d, components.at(&cx, (label, d)), alias, reads, chosen);
                        }
                    },
                    Option::None => (),
                };
            }
            pi = pi + 1usize;
        }
    }

    // `home_params` for parameter `pi` of `target`, which the destruct at `d` takes apart into
    // components labelled `parts`, after the components homed at `chosen`.
    fn home_param(self, &cx: Domain!['k], target: Block['k], preds: ArenaVec[(Block['k], Edge['k], usize), 'k], pi: usize, d: usize,
        parts: ArenaVec[Span['k], 'k], alias: ArenaMap[Span['k], Span['k], 'k], reads: ArenaMap[Span['k], (usize, usize), 'k],
        chosen: ArenaVec[Span['k], 'k]) {
        let label = target.label;
        let instrs = target.instrs;
        let n = instrs.len(&cx);
        let destruct = instrs.at(&cx, d);
        let homes: ArenaVec[(usize, Span['k]), 'k] = ArenaVec::new(&cx);
        var k = 0usize;
        while k < destruct.lhs.len(&cx) && k < parts.len(&cx) {
            let c = destruct.lhs.at(&cx, k);
            let class = find(&cx, alias, c);
            match read_once(reads.get(&cx, class), n) {
                Option::Some(s) => if instrs.at(&cx, s).op.is(&cx, "store") && self.homes_at(&cx, target, s, d, class, alias) {
                    let path = instrs.at(&cx, s).args.at(&cx, 0usize);
                    var all = true;
                    var q = 0usize;
                    while all && q < preds.len(&cx) {
                        let (block, edge, skip) = preds.at(&cx, q);
                        all = self.written_on(&cx, block, edge, skip, pi, k, parts.at(&cx, k), path, chosen);
                        q = q + 1usize;
                    }
                    if all {
                        homes.push(&cx, (k, path));
                        chosen.push(&cx, path);
                        let added = self.unwritten.insert(&cx, (label, s));
                        self.resident.insert(&cx, (label, c), path);
                        let moved = self.moved.insert(&cx, (label, c));
                        var m = 0usize;
                        while m < n {
                            let lhs = instrs.at(&cx, m).lhs;
                            var h = 0usize;
                            while h < lhs.len(&cx) {
                                if find(&cx, alias, lhs.at(&cx, h)).eq(&cx, class) {
                                    self.resident.insert(&cx, (label, lhs.at(&cx, h)), path);
                                    let also = self.moved.insert(&cx, (label, lhs.at(&cx, h)));
                                }
                                h = h + 1usize;
                            }
                            m = m + 1usize;
                        }
                    }
                },
                Option::None => (),
            };
            k = k + 1usize;
        }
        if !homes.is_empty(&cx) {
            let param = (label, target.params.at(&cx, pi).name);
            self.homed.insert(&cx, param, homes);
            var q = 0usize;
            while q < preds.len(&cx) {
                let (block, edge, skip) = preds.at(&cx, q);
                let arg = edge.args.at(&cx, pi - skip);
                if self.made_at(&cx, block, arg, param) < block.instrs.len(&cx) {
                    let added = self.made_home.insert(&cx, (block.label, arg));
                }
                q = q + 1usize;
            }
        }
    }

    // The store at `s` in `target`, the one read of the class `class` of a component the destruct at
    // `d` makes, stores it into a place path the block's header declares empty (or a path around
    // it), which nothing in the block names before the store.
    fn homes_at(self, &cx: Domain!['k], target: Block['k], s: usize, d: usize, class: Span['k], alias: ArenaMap[Span['k], Span['k], 'k]) -> bool {
        let store = target.instrs.at(&cx, s);
        let path = store.args.at(&cx, 0usize);
        if !find(&cx, alias, store.args.at(&cx, 1usize)).eq(&cx, class) || !is_place(&cx, path)
            || self.forwarded.contains(&cx, root(&cx, path)) || s <= d {
            return false;
        }
        var empty = false;
        var e = 0usize;
        while !empty && e < target.empty.len(&cx) {
            empty = prefix(&cx, target.empty.at(&cx, e), path);
            e = e + 1usize;
        }
        if !empty {
            return false;
        }
        var i = 0usize;
        while i < s {
            let args = target.instrs.at(&cx, i).args;
            var g = 0usize;
            while g < args.len(&cx) {
                if is_place(&cx, args.at(&cx, g)) && overlap(&cx, args.at(&cx, g), path) {
                    return false;
                }
                g = g + 1usize;
            }
            i = i + 1usize;
        }
        true
    }

    // Where a homed component of `arg`, passed to `param`, is written in `block`: at the
    // construction or call making it when it is shared into the parameter, else at the edge (the
    // block's length).
    fn made_at(self, &cx: Domain!['k], block: Block['k], arg: Span['k], param: (Span['k], Span['k])) -> usize {
        let n = block.instrs.len(&cx);
        let (param_block, param_name) = param;
        match self.shared.get(&cx, (block.label, arg)) {
            Option::Some(found) => {
                let (into, name) = found;
                if into.eq(&cx, param_block) && name.eq(&cx, param_name) {
                    var i = 0usize;
                    while i < n {
                        let instr = block.instrs.at(&cx, i);
                        if instr.lhs.contains(&cx, arg) {
                            return if instr.op.is(&cx, "construct") || is_call(&cx, instr.op) { i } else { n };
                        }
                        i = i + 1usize;
                    }
                }
            },
            Option::None => (),
        };
        n
    }

    // Component `k` (labelled `part`) of the argument `edge` passes to parameter `pi` of its target
    // can be written at `path` in `block` (`home_params`), after the components homed at `chosen`.
    fn written_on(self, &cx: Domain!['k], block: Block['k], edge: Edge['k], skip: usize, pi: usize, k: usize, part: Span['k], path: Span['k],
        chosen: ArenaVec[Span['k], 'k]) -> bool {
        if pi < skip {
            return false;
        }
        let label = block.label;
        let instrs = block.instrs;
        let n = instrs.len(&cx);
        let arg = edge.args.at(&cx, pi - skip);
        let at = self.made_at(&cx, block, arg, (edge.target, self.blocks.at(&cx, edge.target).params.at(&cx, pi).name));
        let made = at < n;
        let construct = made && instrs.at(&cx, at).op.is(&cx, "construct");
        // Nothing after the write names a path overlapping `path` (a call's own lends included).
        var i = if made && !construct { at } else { at + 1usize };
        while i < n {
            let args = instrs.at(&cx, i).args;
            var g = 0usize;
            while g < args.len(&cx) {
                if is_place(&cx, args.at(&cx, g)) && overlap(&cx, args.at(&cx, g), path) {
                    return false;
                }
                g = g + 1usize;
            }
            i = i + 1usize;
        }
        if made {
            let switched = match block.term {
                Terminator::Switch(scrutinee, _ty, _arms, _pos) => scrutinee.starts_with(&cx, Span::from_static(&cx, "&")) && overlap(&cx, scrutinee, path),
                _ => false,
            };
            if switched {
                return false;
            }
        }
        // Nothing read after the write lies at a path overlapping `path`.
        var r = at + 1usize;
        while r < n {
            let args = instrs.at(&cx, r).args;
            var g = 0usize;
            while g < args.len(&cx) {
                match value_read(&cx, args.at(&cx, g)) {
                    Option::Some(v) => if self.lies_over(&cx, label, v, path) {
                        return false;
                    },
                    Option::None => (),
                };
                g = g + 1usize;
            }
            r = r + 1usize;
        }
        if made {
            let ending = term_reads(&cx, block.term);
            let edges = term_edges(&cx, block.term);
            var e = 0usize;
            while e < edges.len(&cx) {
                let (other, _skip) = edges.at(&cx, e);
                ending.append(&cx, other.args);
                e = e + 1usize;
            }
            var t = 0usize;
            while t < ending.len(&cx) {
                if self.lies_over(&cx, label, ending.at(&cx, t), path) {
                    return false;
                }
                t = t + 1usize;
            }
        }
        // What is written does not lie at a path overlapping `path` but `path` itself, nor at one a
        // component written before it was written at.
        if made && !construct {
            return true;
        }
        let source = if construct {
            self.resident.get_or(&cx, (label, instrs.at(&cx, at).args.at(&cx, k)), Span::from_static(&cx, "%"))
        } else {
            // Nor in a variable the edge assigns before it.
            match self.variable(&cx, label, arg) {
                Option::Some(held) => {
                    let (into, name) = held;
                    if into.eq(&cx, edge.target) && param_index(&cx, self.blocks.at(&cx, edge.target), name).is_some() {
                        return false;
                    }
                },
                Option::None => (),
            };
            match self.resident.get(&cx, (label, arg)) {
                Option::Some(whole) => Buffer!::new().push_bytes(&cx, whole).push_static(".").push_bytes(&cx, part).save(&cx),
                Option::None => Span::from_static(&cx, "%"),
            }
        };
        if !source.eq(&cx, path) && overlap(&cx, source, path) {
            return false;
        }
        var c = 0usize;
        while c < chosen.len(&cx) {
            if overlap(&cx, source, chosen.at(&cx, c)) {
                return false;
            }
            c = c + 1usize;
        }
        true
    }

    // The block and value whose C variable the value `name` of block `label` lies in, through the
    // scrutinees payloads arrive from; none when it lies in a place.
    fn variable(self, &cx: Domain!['k], label: Span['k], name: Span['k]) -> Option[(Span['k], Span['k])] {
        let path = self.resident.get_or(&cx, (label, name), name);
        if path.starts_with(&cx, Span::from_static(&cx, "&")) {
            return Option::None;
        }
        let value = root(&cx, path);
        match self.arrived.get(&cx, (label, value)) {
            Option::Some(found) => {
                let (source, scrutinee, _variant) = found;
                self.variable(&cx, source, scrutinee)
            },
            Option::None => Option::Some.((label, value)),
        }
    }

    // The value `name` of block `label` lies at a path overlapping `path`.
    fn lies_over(self, &cx: Domain!['k], label: Span['k], name: Span['k], path: Span['k]) -> bool {
        match self.resident.get(&cx, (label, name)) {
            Option::Some(at) => overlap(&cx, at, path),
            Option::None => false,
        }
    }

    // ---------------------------------------------------------------- residences --

    // Which values of `block` are read where they lie, and what that saves; `Plan::residences` in
    // plan.py states the rules. A candidate is (path, the first index after the instruction that took
    // the class's first value out of the path, the adapter call it waits on).
    fn residences(self, &cx: Domain!['k], block: Block['k], components: ArenaMap[(Span['k], usize), ArenaVec[Span['k], 'k], 'k],
        adapters: ArenaMap[Span['k], Adapter['k], 'k], params: ArenaSet[Span['k], 'k], shapes: ArenaMap[(Span['k], usize), Type['k], 'k],
        scratch: Scratch['k]) {
        let label = block.label;
        let instrs = block.instrs;
        let n = instrs.len(&cx);
        // Nothing lies anywhere, nor is stored in place, in a block with no load, destruct, construct
        // or call.
        var busy = false;
        var b = 0usize;
        while !busy && b < n {
            let op = instrs.at(&cx, b).op;
            busy = op.is(&cx, "load") || op.is(&cx, "destruct") || op.is(&cx, "construct") || op.is(&cx, "call");
            b = b + 1usize;
        }
        if !busy {
            return;
        }
        let alias = scratch.alias;
        alias.clear(&cx);
        let stored = scratch.stored;
        stored.clear(&cx);
        // path -> the type of the value there that a destruct took apart
        let held = scratch.held;
        held.clear(&cx);
        let candidates = scratch.candidates;
        candidates.clear(&cx);
        // adapter call index -> (class, path) of each borrowed value, in the order handed back
        let lent = scratch.lent;
        lent.clear(&cx);
        var i = 0usize;
        while i < n {
            let instr = instrs.at(&cx, i);
            let op = instr.op;
            let a = instr.args;
            if (op.is(&cx, "copy") || op.is(&cx, "open") || op.is(&cx, "pack")) && a.at(&cx, 0usize).starts_with(&cx, Span::from_static(&cx, "%")) {
                alias.insert(&cx, instr.lhs.at(&cx, 0usize), find(&cx, alias, a.at(&cx, 0usize)));
            } else if op.is(&cx, "store") && self.forwarded.contains(&cx, a.at(&cx, 0usize)) {
                stored.insert(&cx, a.at(&cx, 0usize), a.at(&cx, 1usize));
            } else if op.is(&cx, "load") && self.forwarded.contains(&cx, a.at(&cx, 0usize)) {
                alias.insert(&cx, instr.lhs.at(&cx, 0usize), find(&cx, alias, stored.at(&cx, a.at(&cx, 0usize))));
            } else if op.is(&cx, "load") && is_place(&cx, a.at(&cx, 0usize)) {
                candidates.insert(&cx, instr.lhs.at(&cx, 0usize), (a.at(&cx, 0usize), i + 1usize, Option::None));
            } else if op.is(&cx, "destruct") && components.contains(&cx, (label, i)) && !(i > 0usize && lent.contains(&cx, i - 1usize)) {
                let source = a.at(&cx, 0usize);
                let (path, from, waits) = if is_place(&cx, source) {
                    (source, i + 1usize, Option::None)
                } else {
                    let c = find(&cx, alias, source);
                    candidates.get_or(&cx, c, (c, i + 1usize, Option::None))
                };
                held.insert(&cx, path, shapes.at(&cx, (label, i)));
                let parts = components.at(&cx, (label, i));
                var k = 0usize;
                while k < instr.lhs.len(&cx) && k < parts.len(&cx) {
                    candidates.insert(&cx, instr.lhs.at(&cx, k), (Buffer!::new().push_bytes(&cx, path).push_static(".").push_bytes(&cx, parts.at(&cx, k)).save(&cx), from, waits));
                    k = k + 1usize;
                }
            } else if op.is(&cx, "call") && adapters.contains(&cx, a.at(&cx, 0usize)) {
                let adapter = adapters.at(&cx, a.at(&cx, 0usize));
                let actuals: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
                var values = true;
                var m = 0usize;
                while m < adapter.borrowed.len(&cx) {
                    let x = find(&cx, alias, a.at(&cx, 1usize + adapter.borrowed.at(&cx, m)));
                    values = values && x.starts_with(&cx, Span::from_static(&cx, "%"));
                    actuals.push(&cx, x);
                    m = m + 1usize;
                }
                let destructed = i + 1usize < n && instrs.at(&cx, i + 1usize).op.is(&cx, "destruct")
                    && instrs.at(&cx, i + 1usize).args.len(&cx) == 1usize && instrs.at(&cx, i + 1usize).args.at(&cx, 0usize).eq(&cx, instr.lhs.at(&cx, 0usize));
                if values && (!adapter.returns || destructed) {
                    let entries: ArenaVec[(Span['k], Span['k]), 'k] = ArenaVec::new(&cx);
                    var x = 0usize;
                    while x < actuals.len(&cx) {
                        let actual = actuals.at(&cx, x);
                        if !candidates.contains(&cx, actual) {
                            candidates.insert(&cx, actual, (actual, 0usize, Option::None));
                        }
                        let (path, _from, _waits) = candidates.at(&cx, actual);
                        entries.push(&cx, (actual, path));
                        x = x + 1usize;
                    }
                    lent.insert(&cx, i, entries);
                    if adapter.returns {
                        let back = instrs.at(&cx, i + 1usize).lhs;
                        var r = 0usize;
                        while r < back.len(&cx) && r < entries.len(&cx) {
                            let (_actual, path) = entries.at(&cx, r);
                            candidates.insert(&cx, back.at(&cx, r), (path, i + 1usize, Option::Some.(i)));
                            r = r + 1usize;
                        }
                    }
                }
            }
            i = i + 1usize;
        }

        let last = scratch.last;
        last.clear(&cx);
        let reads = scratch.reads;
        reads.clear(&cx);
        var j = 0usize;
        while j < n {
            let args = instrs.at(&cx, j).args;
            var g = 0usize;
            while g < args.len(&cx) {
                match value_read(&cx, args.at(&cx, g)) {
                    Option::Some(v) => {
                        let c = find(&cx, alias, v);
                        last.insert(&cx, c, j);
                        reads.insert(&cx, c, reads.get_or(&cx, c, 0usize) + 1usize);
                    },
                    Option::None => (),
                };
                g = g + 1usize;
            }
            j = j + 1usize;
        }
        let ending = term_reads(&cx, block.term);
        let edges = term_edges(&cx, block.term);
        var e = 0usize;
        while e < edges.len(&cx) {
            let (edge, _skip) = edges.at(&cx, e);
            ending.append(&cx, edge.args);
            e = e + 1usize;
        }
        var t = 0usize;
        while t < ending.len(&cx) {
            last.insert(&cx, find(&cx, alias, ending.at(&cx, t)), n);
            t = t + 1usize;
        }

        let valid = scratch.valid;
        valid.clear(&cx);
        var v = 0usize;
        while v < candidates.positions(&cx) {
            match candidates.key_at(&cx, v) {
                Option::Some(c) => {
                    let (path, from, _waits) = candidates.at(&cx, c);
                    if kept(&cx, instrs, alias, last, lent, params, c, path, from, Option::None) {
                        valid.insert(&cx, c);
                    }
                },
                Option::None => (),
            };
            v = v + 1usize;
        }
        var l = 0usize;
        while l < lent.positions(&cx) {
            match lent.key_at(&cx, l) {
                Option::Some(at) => {
                    let entries = lent.at(&cx, at);
                    var ok = true;
                    var k = 0usize;
                    while ok && k < entries.len(&cx) {
                        let (x, q) = entries.at(&cx, k);
                        let (_path, _from, waits) = candidates.at(&cx, x);
                        let ready = match waits {
                            Option::Some(w) => self.in_place.contains(&cx, (label, w)),
                            Option::None => true,
                        };
                        let unseen = if q.starts_with(&cx, Span::from_static(&cx, "%")) {
                            match last.get(&cx, root(&cx, q)) {
                                Option::Some(read) => read <= at,
                                Option::None => true,
                            }
                        } else {
                            stored_back(&cx, label, instrs, alias, components, at, k, q)
                        };
                        ok = valid.contains(&cx, x) && is_at(last.get(&cx, x), at) && ready && unseen;
                        var p = k + 1usize;
                        while ok && p < entries.len(&cx) {
                            let (_y, other) = entries.at(&cx, p);
                            ok = !overlap(&cx, q, other);
                            p = p + 1usize;
                        }
                        let args = instrs.at(&cx, at).args;
                        var o = 1usize;
                        while ok && o < args.len(&cx) {
                            ok = !(is_place(&cx, args.at(&cx, o)) && overlap(&cx, q, args.at(&cx, o)));
                            o = o + 1usize;
                        }
                        k = k + 1usize;
                    }
                    if ok {
                        let paths: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
                        var q = 0usize;
                        while q < entries.len(&cx) {
                            let (_x, path) = entries.at(&cx, q);
                            paths.push(&cx, path);
                            q = q + 1usize;
                        }
                        self.in_place.insert(&cx, (label, at), paths);
                    }
                },
                Option::None => (),
            };
            l = l + 1usize;
        }
        // A construction whose components each lie at their own member of one path when it is made, a
        // path where a destruct took apart a value of the construction's type, lies at that path.
        var u = 0usize;
        while u < n {
            let instr = instrs.at(&cx, u);
            if instr.op.is(&cx, "construct") && components.contains(&cx, (label, u)) && !instr.args.is_empty(&cx)
                && components.at(&cx, (label, u)).len(&cx) == instr.args.len(&cx) {
                let parts = components.at(&cx, (label, u));
                let first = find(&cx, alias, instr.args.at(&cx, 0usize));
                match candidates.get(&cx, first) {
                    Option::Some(found) => {
                        let (path, _from, _waits) = found;
                        let part = parts.at(&cx, 0usize);
                        if path.len() > part.len() && path.ends_with(&cx, part) && path.byte_or_zero(&cx, path.len() - part.len() - 1usize) == b'.' {
                            let whole = path.slice(0usize, path.len() - part.len() - 1usize);
                            var fits = match held.get(&cx, whole) {
                                Option::Some(ty) => same(&cx, ty, shapes.at(&cx, (label, u))),
                                Option::None => false,
                            };
                            var k = 0usize;
                            while fits && k < parts.len(&cx) {
                                let c = find(&cx, alias, instr.args.at(&cx, k));
                                fits = match candidates.get(&cx, c) {
                                    Option::Some(entry) => {
                                        let (at, from, waits) = entry;
                                        let ready = match waits {
                                            Option::Some(w) => self.in_place.contains(&cx, (label, w)),
                                            Option::None => true,
                                        };
                                        ready && is_member(&cx, at, whole, parts.at(&cx, k))
                                            && kept(&cx, instrs, alias, last, lent, params, c, at, from, Option::Some.(u))
                                    },
                                    Option::None => false,
                                };
                                k = k + 1usize;
                            }
                            if fits {
                                let made = instr.lhs.at(&cx, 0usize);
                                candidates.insert(&cx, made, (whole, u + 1usize, Option::None));
                                if kept(&cx, instrs, alias, last, lent, params, made, whole, u + 1usize, Option::None) {
                                    valid.insert(&cx, made);
                                }
                            }
                        }
                    },
                    Option::None => (),
                };
            }
            u = u + 1usize;
        }
        var d = 0usize;
        while d < n {
            let lhs = instrs.at(&cx, d).lhs;
            var h = 0usize;
            while h < lhs.len(&cx) {
                let name = lhs.at(&cx, h);
                let c = find(&cx, alias, name);
                if valid.contains(&cx, c) {
                    let (path, _from, waits) = candidates.at(&cx, c);
                    let ready = match waits {
                        Option::Some(w) => self.in_place.contains(&cx, (label, w)),
                        Option::None => true,
                    };
                    if ready && !path.eq(&cx, name) {
                        self.resident.insert(&cx, (label, name), path);
                        self.moved.insert(&cx, (label, name));
                    }
                }
                h = h + 1usize;
            }
            d = d + 1usize;
        }

        var s = 0usize;
        while s < n {
            let instr = instrs.at(&cx, s);
            let a = instr.args;
            if instr.op.is(&cx, "store") && !self.forwarded.contains(&cx, a.at(&cx, 0usize)) {
                match self.resident.get(&cx, (label, a.at(&cx, 1usize))) {
                    Option::Some(path) => if path.eq(&cx, a.at(&cx, 0usize)) {
                        self.unwritten.insert(&cx, (label, s));
                    },
                    Option::None => (),
                };
            } else if instr.op.is(&cx, "construct") && components.contains(&cx, (label, s)) && s + 1usize < n
                && !self.resident.contains(&cx, (label, instr.lhs.at(&cx, 0usize))) {
                let store = instrs.at(&cx, s + 1usize);
                let made = find(&cx, alias, instr.lhs.at(&cx, 0usize));
                if store.op.is(&cx, "store") && store.args.at(&cx, 1usize).eq(&cx, instr.lhs.at(&cx, 0usize))
                    && !self.forwarded.contains(&cx, root(&cx, store.args.at(&cx, 0usize)))
                    && is_at(reads.get(&cx, made), 1usize) && is_at(last.get(&cx, made), s + 1usize) {
                    let target = store.args.at(&cx, 0usize);
                    let parts = components.at(&cx, (label, s));
                    var fits = true;
                    var k = 0usize;
                    while fits && k < a.len(&cx) && k < parts.len(&cx) {
                        match self.resident.get(&cx, (label, a.at(&cx, k))) {
                            Option::Some(path) => {
                                fits = !overlap(&cx, path, target) || is_member(&cx, path, target, parts.at(&cx, k));
                            },
                            Option::None => (),
                        };
                        k = k + 1usize;
                    }
                    if fits {
                        self.fused.insert(&cx, (label, s));
                    }
                }
            }
            s = s + 1usize;
        }
    }

    // ------------------------------------------------------------------- returns --

    // The position of the parameter a return join returns.
    fn returned(self, &cx: Domain!['k], label: Span['k], seen: ArenaSet[Span['k], 'k]) -> Option[usize] {
        let block = self.blocks.at(&cx, label);
        if !block.instrs.is_empty(&cx) || !seen.insert(&cx, label) {
            return Option::None;
        }
        match block.term {
            Terminator::Ret(value, _pos) => param_index(&cx, block, value),
            Terminator::Jmp(edge, _pos) => {
                var a = 0usize;
                while a < edge.args.len(&cx) {
                    if param_index(&cx, block, edge.args.at(&cx, a)).is_none() {
                        return Option::None;
                    }
                    a = a + 1usize;
                }
                match self.returned(&cx, edge.target, seen) {
                    Option::Some(index) => param_index(&cx, block, edge.args.at(&cx, index)),
                    Option::None => Option::None,
                }
            },
            _ => Option::None,
        }
    }

    // Whether `block`'s last instruction is a call whose result the block returns, directly or
    // through return joins.
    fn tail_call(self, &cx: Domain!['k], block: Block['k]) -> bool {
        if block.instrs.is_empty(&cx) {
            return false;
        }
        let call = block.instrs.at(&cx, block.instrs.len(&cx) - 1usize);
        if !(call.op.is(&cx, "call") || call.op.is(&cx, "trait_call")) || call.lhs.len(&cx) != 1usize {
            return false;
        }
        let returned = match block.term {
            Terminator::Ret(value, _pos) => value,
            Terminator::Jmp(edge, _pos) => match self.return_index.get(&cx, edge.target) {
                Option::Some(index) => edge.args.at(&cx, index),
                Option::None => return false,
            },
            _ => return false,
        };
        returned.eq(&cx, call.lhs.at(&cx, 0usize))
    }

    fn has_alloca(self, &cx: Domain!['k]) -> bool {
        var b = 0usize;
        while b < self.fun.blocks.len(&cx) {
            let instrs = self.fun.blocks.at(&cx, b).instrs;
            var i = 0usize;
            while i < instrs.len(&cx) {
                if instrs.at(&cx, i).op.is(&cx, "alloca") {
                    return true;
                }
                i = i + 1usize;
            }
            b = b + 1usize;
        }
        false
    }
}

forall 'k.
fn name_place(&cx: Domain!['k], named: ArenaMap[Span['k], ArenaVec[(usize, usize, Span['k], Span['k]), 'k], 'k], use_: (usize, usize, Span['k], Span['k])) {
    let (_b, _i, _op, path) = use_;
    let key = root(&cx, path);
    match named.get(&cx, key) {
        Option::Some(uses) => uses.push(&cx, use_),
        Option::None => {
            let uses: ArenaVec[(usize, usize, Span['k], Span['k]), 'k] = ArenaVec::new(&cx);
            uses.push(&cx, use_);
            let unit = named.insert(&cx, key, uses);
        },
    };
}

// What a terminator reads besides its edges' arguments.
forall 'k.
fn term_reads(&cx: Domain!['k], term: Terminator['k]) -> ArenaVec[Span['k], 'k] {
    let out: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
    match term {
        Terminator::Ret(value, _pos) => out.push(&cx, value),
        Terminator::Jnz(cond, _then, _other, _pos) => out.push(&cx, cond),
        Terminator::Switch(scrutinee, _ty, _arms, _pos) => if !scrutinee.starts_with(&cx, Span::from_static(&cx, "&")) {
            out.push(&cx, scrutinee);
        },
        _ => (),
    };
    out
}

// The class of a value: the value it copies, opens, packs or forwards, followed to the first.
forall 'k.
fn find(&cx: Domain!['k], alias: ArenaMap[Span['k], Span['k], 'k], name: Span['k]) -> Span['k] {
    var at = name;
    var more = true;
    while more {
        match alias.get(&cx, at) {
            Option::Some(next) => {
                at = next;
            },
            Option::None => {
                more = false;
            },
        };
    }
    at
}

// Counts a read of `name` at `at` (`home_params`).
forall 'k.
fn count_read(&cx: Domain!['k], reads: ArenaMap[Span['k], (usize, usize), 'k], name: Span['k], at: usize) {
    let (count, _last) = reads.get_or(&cx, name, (0usize, 0usize));
    reads.insert(&cx, name, (count + 1usize, at));
}

// Where a class is read, when it is read once and not by the terminator or an edge (at `n`).
fn read_once(found: Option[(usize, usize)], n: usize) -> Option[usize] {
    match found {
        Option::Some(entry) => {
            let (count, at) = entry;
            if count == 1usize && at != n { Option::Some.(at) } else { Option::None }
        },
        Option::None => Option::None,
    }
}

fn is_at(found: Option[usize], index: usize) -> bool {
    match found {
        Option::Some(at) => at == index,
        Option::None => false,
    }
}

// Whether `path` is `parent.part`.
forall 'k.
fn is_member(&cx: Domain!['k], path: Span['k], parent: Span['k], part: Span['k]) -> bool {
    path.len() == parent.len() + 1usize + part.len() && path.starts_with(&cx, parent) && path.byte_or_zero(&cx, parent.len()) == b'.'
        && path.skip(parent.len() + 1usize).eq(&cx, part)
}

// Nothing writes a path overlapping `path` from the instruction at `from` to the last read of the
// class `c`, but what reads the class last, or to the instruction `until` (`Plan::residences`).
forall 'k.
fn kept(&cx: Domain!['k], instrs: ArenaVec[Instr['k], 'k], alias: ArenaMap[Span['k], Span['k], 'k], last: ArenaMap[Span['k], usize, 'k],
    lent: ArenaMap[usize, ArenaVec[(Span['k], Span['k]), 'k], 'k], params: ArenaSet[Span['k], 'k], c: Span['k], path: Span['k], from: usize,
    until: Option[usize]) -> bool {
    let end = match until {
        Option::Some(at) => at,
        Option::None => match last.get(&cx, c) {
            Option::Some(at) => at,
            Option::None => return true,
        },
    };
    let under_param = params.contains(&cx, root(&cx, path));
    let n = instrs.len(&cx);
    var j = from;
    while j <= end && j < n {
        let instr = instrs.at(&cx, j);
        let op = instr.op;
        let a = instr.args;
        if op.is(&cx, "store") {
            if overlap(&cx, a.at(&cx, 0usize), path)
                && !(j == end && a.at(&cx, 0usize).eq(&cx, path) && find(&cx, alias, a.at(&cx, 1usize)).eq(&cx, c)) {
                return false;
            }
        } else if is_call(&cx, op) && j == end {
        } else if under_param && is_opaque(&cx, op) {
            return false;
        } else if is_call(&cx, op) {
            var g = 0usize;
            while g < a.len(&cx) {
                if is_place(&cx, a.at(&cx, g)) && overlap(&cx, a.at(&cx, g), path) {
                    return false;
                }
                g = g + 1usize;
            }
            match lent.get(&cx, j) {
                Option::Some(entries) => {
                    var k = 0usize;
                    while k < entries.len(&cx) {
                        let (x, q) = entries.at(&cx, k);
                        if !x.eq(&cx, c) && overlap(&cx, q, path) {
                            return false;
                        }
                        k = k + 1usize;
                    }
                },
                Option::None => (),
            };
        }
        j = j + 1usize;
    }
    true
}

// The value the adapter call at `at` hands back `k`th is stored into the place `path` again before
// any other instruction names a path overlapping it.
forall 'k.
fn stored_back(&cx: Domain!['k], label: Span['k], instrs: ArenaVec[Instr['k], 'k], alias: ArenaMap[Span['k], Span['k], 'k],
    components: ArenaMap[(Span['k], usize), ArenaVec[Span['k], 'k], 'k], at: usize, k: usize, path: Span['k]) -> bool {
    let back = find(&cx, alias, instrs.at(&cx, at + 1usize).lhs.at(&cx, k));
    let n = instrs.len(&cx);
    var s = at + 2usize;
    while s < n {
        let instr = instrs.at(&cx, s);
        var named = false;
        var g = 0usize;
        while g < instr.args.len(&cx) {
            if is_place(&cx, instr.args.at(&cx, g)) && overlap(&cx, instr.args.at(&cx, g), path) {
                named = true;
            }
            g = g + 1usize;
        }
        if named {
            if !instr.op.is(&cx, "store") {
                return false;
            }
            let target = instr.args.at(&cx, 0usize);
            let value = instr.args.at(&cx, 1usize);
            if target.eq(&cx, path) {
                return find(&cx, alias, value).eq(&cx, back);
            }
            let made = instrs.at(&cx, s - 1usize);
            if !made.op.is(&cx, "construct") || !made.lhs.at(&cx, 0usize).eq(&cx, value) || !components.contains(&cx, (label, s - 1usize)) {
                return false;
            }
            let parts = components.at(&cx, (label, s - 1usize));
            var p = 0usize;
            while p < parts.len(&cx) && p < made.args.len(&cx) {
                if is_member(&cx, path, target, parts.at(&cx, p)) && find(&cx, alias, made.args.at(&cx, p)).eq(&cx, back) {
                    return true;
                }
                p = p + 1usize;
            }
            return false;
        }
        s = s + 1usize;
    }
    false
}
