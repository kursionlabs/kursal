// Type operations shared by the checker and the backend: substitution, equality, multiplicity,
// exposure and logical shape.

use package::base::{Cell, Key, Map, Out, Seq, Set, Text, fail, text};
use package::core::{Exposure, ExposureMode, FnType, ForeachType, Kind, Member, ModuleId, Param, Premise, Program, Type, TypeDecl};
use package::core as C;
use package::sexpr::located;
use package::syntax::{Pos, no_pos};
use std::option::Option;

// Stops the compiler with a KursError's text: `line:col: message` when `pos` is a position, the
// message alone when it is none (line 0).
fn kurs_error(message: Text, pos: Pos) -> ! {
    if pos.line == 0u32 {
        fail(message)
    } else {
        fail(located(message, pos))
    }
}

// --------------------------------------------------------------- fresh names --

// The counter that numbers fresh names. The compiler makes one and passes it to everything that
// may rename a binder, so names are numbered in the order they are made.
exposed struct Fresh {
    next: Cell[u64],
}

impl Fresh {
    fn new() -> Fresh {
        Fresh.{ next: Cell::new(0u64) }
    }
}

// `label` without any `#` suffix, numbered anew: `a#3`.
fn fresh(label: Text, counter: Fresh) -> Text {
    let n = counter.next.get();
    counter.next.set(n + 1u64);
    let stem = match label.find(text("#"), 0usize) {
        Option::Some(at) => label.slice(0usize, at),
        Option::None => label,
    };
    Out::new().add(stem).put("#").u64(n).done()
}

// ------------------------------------------------------------- name sets --

fn with_names(bound: Set[Text], names: Seq[Text]) -> Set[Text] {
    let out = bound.copy();
    var i = 0usize;
    while i < names.len() {
        out.add(names.get(i));
        i = i + 1usize;
    }
    out
}

// The two sets share a name.
fn overlap(a: Set[Text], b: Set[Text]) -> bool {
    let items = a.items();
    var found = false;
    var i = 0usize;
    while !found && i < items.len() {
        found = b.has(items.get(i));
        i = i + 1usize;
    }
    found
}

fn add_all(out: Set[Text], names: Set[Text]) {
    let items = names.items();
    var i = 0usize;
    while i < items.len() {
        out.add(items.get(i));
        i = i + 1usize;
    }
}

fn param_names(params: Seq[Param]) -> Seq[Text] {
    let out: Seq[Text] = Seq::new();
    var i = 0usize;
    while i < params.len() {
        out.push(params.get(i).name);
        i = i + 1usize;
    }
    out
}

// `t` with every non-overlapping `old` replaced by `new`, left to right.
fn replace_all(t: Text, old: Text, new: Text) -> Text {
    let out = Out::new();
    var i = 0usize;
    while i < t.len {
        if i + old.len <= t.len && t.slice(i, i + old.len).eq(old) {
            let unit = out.add(new);
            i = i + old.len;
        } else {
            let unit = out.byte(t.byte(i));
            i = i + 1usize;
        }
    }
    out.done()
}

fn kind_name(k: Kind) -> Text {
    match k {
        Kind::Brand => text("brand"),
        Kind::Copy => text("copy"),
        Kind::Any => text("any"),
    }
}

// Which constructor a type is: equal for two types exactly when Python's `type(a) is type(b)`.
fn type_tag(t: Type) -> u32 {
    match t {
        Type::Prim(_x) => 0u32,
        Type::Never => 1u32,
        Type::Named(_x, _y) => 2u32,
        Type::Struct(_x) => 3u32,
        Type::Enum(_x) => 4u32,
        Type::Tuple(_x) => 5u32,
        Type::Array(_x, _y) => 6u32,
        Type::Ptr(_x) => 7u32,
        Type::Skolem(_x) => 8u32,
        Type::Brand(_x) => 9u32,
        Type::Exists(_x, _y) => 10u32,
        Type::Foreach(_x) => 11u32,
        Type::Fn(_x) => 12u32,
        Type::Ignored => 13u32,
        Type::Meta(_x) => 14u32,
    }
}

// ------------------------------------------------------------- structure --

// Rebuild one type layer, applying `transform` to its type children (including premises).
//
// Binders, labels, lengths and calling conventions are preserved. The caller controls recursion
// and scope; this helper does not substitute bound names.
forall Env where Copy[Env].
fn map_children(ty: Type, transform: closure[Env](Type) -> Type) -> Type {
    match ty {
        Type::Named(name, args) => {
            if args.is_empty() {
                ty
            } else {
                let out: Seq[Type] = Seq::new();
                var i = 0usize;
                while i < args.len() {
                    out.push(transform(args.get(i)));
                    i = i + 1usize;
                }
                Type::Named.(name, out)
            }
        },
        Type::Brand(brand) => Type::Brand.(Cell::new(transform(brand.get()))),
        Type::Ptr(inner) => Type::Ptr.(Cell::new(transform(inner.get()))),
        Type::Array(elem, length) => Type::Array.(Cell::new(transform(elem.get())), length),
        Type::Tuple(elems) => {
            let out: Seq[Type] = Seq::new();
            var i = 0usize;
            while i < elems.len() {
                out.push(transform(elems.get(i)));
                i = i + 1usize;
            }
            Type::Tuple.(out)
        },
        Type::Struct(fields) => {
            let out: Seq[Member] = Seq::new();
            var i = 0usize;
            while i < fields.len() {
                out.push(Member.{ name: fields.get(i).name, type: transform(fields.get(i).type) });
                i = i + 1usize;
            }
            Type::Struct.(out)
        },
        Type::Enum(variants) => {
            let out: Seq[Member] = Seq::new();
            var i = 0usize;
            while i < variants.len() {
                out.push(Member.{ name: variants.get(i).name, type: transform(variants.get(i).type) });
                i = i + 1usize;
            }
            Type::Enum.(out)
        },
        Type::Exists(binders, body) => Type::Exists.(binders, Cell::new(transform(body.get()))),
        Type::Foreach(f) => {
            let source = transform(f.source.get());
            let body = transform(f.body.get());
            Type::Foreach.(ForeachType.{ binder: f.binder, indirect: f.indirect, source: Cell::new(source), body: Cell::new(body), retained: f.retained })
        },
        Type::Fn(f) => {
            let params: Seq[Type] = Seq::new();
            var i = 0usize;
            while i < f.params.len() {
                params.push(transform(f.params.get(i)));
                i = i + 1usize;
            }
            let ret = transform(f.ret.get());
            Type::Fn.(FnType.{ params, ret: Cell::new(ret), quantified: f.quantified, is_unsafe: f.is_unsafe, places: f.places })
        },
        _ => ty,
    }
}

// Simultaneous, capture-avoiding substitution.
//
// `sub` maps type-variable names (written `Named(name)`) and brand labels (written
// `Skolem(label)`) to types; a brand maps to a `Skolem`.
fn subst(ty: Type, sub: Map[Text, Type], counter: Fresh) -> Type {
    if sub.is_empty() {
        return ty;
    }
    match ty {
        Type::Named(name, args) => {
            if args.is_empty() && sub.has(name) {
                sub.at(name)
            } else {
                map_children(ty, |child: Type| subst(child, sub, counter))
            }
        },
        Type::Skolem(label) => sub.get_or(label, ty),
        Type::Exists(binders, body) => {
            let (names, inner) = rebind(binders, sub, true, counter);
            Type::Exists.(names, Cell::new(subst(body.get(), inner, counter)))
        },
        Type::Foreach(f) => {
            let (result, inner) = subst_foreach(f, sub, counter);
            Type::Foreach.(result)
        },
        Type::Fn(f) => {
            let (names, inner) = rebind(param_names(f.quantified), sub, true, counter);
            let params: Seq[Type] = Seq::new();
            var i = 0usize;
            while i < f.params.len() {
                params.push(subst(f.params.get(i), inner, counter));
                i = i + 1usize;
            }
            let ret = subst(f.ret.get(), inner, counter);
            let quantified: Seq[Param] = Seq::new();
            var j = 0usize;
            while j < names.len() {
                quantified.push(Param.{ name: names.get(j), kind: f.quantified.get(j).kind });
                j = j + 1usize;
            }
            Type::Fn.(FnType.{ params, ret: Cell::new(ret), quantified, is_unsafe: f.is_unsafe, places: f.places })
        },
        _ => map_children(ty, |child: Type| subst(child, sub, counter)),
    }
}

// The binder prefix fixed when the transform was formed.
fn foreach_binders(ty: ForeachType) -> Seq[Text] {
    let out: Seq[Text] = Seq::one(ty.binder);
    out.append(ty.retained);
    out
}

// Abstract mapper input, using only the retained binders of this transform.
fn foreach_item(ty: ForeachType) -> Type {
    if !ty.retained.is_empty() {
        let unit = match ty.source.get() {
            Type::Foreach(source) => {
                return source.body.get();
            },
            _ => (),
        };
    }
    let binder = C::named(ty.binder, Seq::new());
    if ty.indirect { C::ptr(binder) } else { binder }
}

// Transport retained binder renamings into each enclosing transform body.
fn subst_foreach(ty: ForeachType, sub: Map[Text, Type], counter: Fresh) -> (ForeachType, Map[Text, Type]) {
    let (source, retained) = match ty.source.get() {
        Type::Foreach(inner) => {
            let (s, r) = subst_foreach(inner, sub, counter);
            (Type::Foreach.(s), r)
        },
        _ => (subst(ty.source.get(), sub, counter), sub.copy()),
    };
    let (binders, inner) = rebind(Seq::one(ty.binder), retained, false, counter);
    let names: Seq[Text] = Seq::new();
    var i = 0usize;
    while i < ty.retained.len() {
        let b = ty.retained.get(i);
        let name = match inner.get(b) {
            Option::Some(t) => match t {
                Type::Named(n, _args) => n,
                Type::Prim(n) => n,
                _ => fail(text("internal error: a retained foreach binder renamed to a non-name")),
            },
            Option::None => b,
        };
        names.push(name);
        i = i + 1usize;
    }
    let result = ForeachType.{ binder: binders.get(0usize), indirect: ty.indirect, source: Cell::new(source), body: Cell::new(subst(ty.body.get(), inner, counter)), retained: names };
    (result, inner)
}

// Drop `binders` from `sub`, renaming any a replacement would capture.
fn rebind(binders: Seq[Text], sub: Map[Text, Type], brand: bool, counter: Fresh) -> (Seq[Text], Map[Text, Type]) {
    let inner: Map[Text, Type] = Map::new();
    let keys = sub.keys();
    var i = 0usize;
    while i < keys.len() {
        if !binders.has(keys.get(i)) {
            inner.set(keys.get(i), sub.at(keys.get(i)));
        }
        i = i + 1usize;
    }
    let captured: Set[Text] = Set::new();
    let values = inner.values();
    var j = 0usize;
    while j < values.len() {
        add_all(captured, free_names(values.get(j)));
        j = j + 1usize;
    }
    let out: Seq[Text] = Seq::new();
    var k = 0usize;
    while k < binders.len() {
        let b = binders.get(k);
        if captured.has(b) {
            let new = fresh(b, counter);
            inner.set(b, if brand { Type::Skolem.(new) } else { C::named(new, Seq::new()) });
            out.push(new);
        } else {
            out.push(b);
        }
        k = k + 1usize;
    }
    (out, inner)
}

// Free type-variable names and brand labels of `ty` (over-approximating nominal names as
// variables, which only makes renaming more eager).
fn free_names(ty: Type) -> Set[Text] {
    let out: Set[Text] = Set::new();
    free_names_in(ty, Set::new(), out);
    out
}

fn free_names_in(ty: Type, bound: Set[Text], out: Set[Text]) {
    match ty {
        Type::Named(name, args) => {
            if args.is_empty() && !bound.has(name) {
                out.add(name);
            }
            var i = 0usize;
            while i < args.len() {
                free_names_in(args.get(i), bound, out);
                i = i + 1usize;
            }
        },
        Type::Skolem(label) => {
            if !bound.has(label) {
                out.add(label);
            }
        },
        Type::Exists(binders, body) => free_names_in(body.get(), with_names(bound, binders), out),
        Type::Foreach(f) => {
            free_names_in(f.source.get(), bound, out);
            free_names_in(f.body.get(), with_names(bound, foreach_binders(f)), out);
        },
        Type::Fn(f) => {
            let inner = with_names(bound, param_names(f.quantified));
            free_names_in(f.ret.get(), inner, out);
            var i = 0usize;
            while i < f.params.len() {
                free_names_in(f.params.get(i), inner, out);
                i = i + 1usize;
            }
        },
        _ => {
            let parts = children(ty);
            var i = 0usize;
            while i < parts.len() {
                free_names_in(parts.get(i), bound, out);
                i = i + 1usize;
            }
        },
    }
}

// Some brand label occurs in `ty`, free or bound. Unlike `free_brands`, this allocates nothing.
fn mentions_brand(ty: Type) -> bool {
    match ty {
        Type::Skolem(_label) => true,
        Type::Named(_name, args) => any_mentions_brand(args),
        Type::Tuple(elems) => any_mentions_brand(elems),
        Type::Struct(fields) => members_mention_brand(fields),
        Type::Enum(variants) => members_mention_brand(variants),
        Type::Array(elem, _length) => mentions_brand(elem.get()),
        Type::Ptr(inner) => mentions_brand(inner.get()),
        Type::Brand(brand) => mentions_brand(brand.get()),
        Type::Exists(_binders, body) => mentions_brand(body.get()),
        Type::Foreach(f) => mentions_brand(f.source.get()) || mentions_brand(f.body.get()),
        Type::Fn(f) => any_mentions_brand(f.params) || mentions_brand(f.ret.get()),
        _ => false,
    }
}

fn any_mentions_brand(types: Seq[Type]) -> bool {
    var i = 0usize;
    while i < types.len() {
        if mentions_brand(types.get(i)) {
            return true;
        }
        i = i + 1usize;
    }
    false
}

fn members_mention_brand(members: Seq[Member]) -> bool {
    var i = 0usize;
    while i < members.len() {
        if mentions_brand(members.get(i).type) {
            return true;
        }
        i = i + 1usize;
    }
    false
}

fn free_brands(ty: Type) -> Set[Text] {
    if !mentions_brand(ty) {
        return Set::new();
    }
    let found: Set[Text] = Set::new();
    skolems(ty, found);
    let free = free_names(ty).items();
    let out: Set[Text] = Set::new();
    var i = 0usize;
    while i < free.len() {
        if found.has(free.get(i)) {
            out.add(free.get(i));
        }
        i = i + 1usize;
    }
    out
}

fn skolems(part: Type, found: Set[Text]) {
    let unit = match part {
        Type::Skolem(label) => found.add(label),
        _ => (),
    };
    let parts = children(part);
    var i = 0usize;
    while i < parts.len() {
        skolems(parts.get(i), found);
        i = i + 1usize;
    }
}

fn children(ty: Type) -> Seq[Type] {
    match ty {
        Type::Ptr(inner) => Seq::one(inner.get()),
        Type::Brand(brand) => Seq::one(brand.get()),
        Type::Array(elem, _length) => Seq::one(elem.get()),
        Type::Tuple(elems) => elems,
        Type::Struct(fields) => member_types(fields),
        Type::Enum(variants) => member_types(variants),
        Type::Named(_name, args) => args,
        Type::Exists(_binders, body) => Seq::one(body.get()),
        Type::Foreach(f) => Seq::two(f.source.get(), f.body.get()),
        Type::Fn(f) => {
            let out = f.params.copy();
            out.push(f.ret.get());
            out
        },
        _ => Seq::new(),
    }
}

fn member_types(members: Seq[Member]) -> Seq[Type] {
    let out: Seq[Type] = Seq::new();
    var i = 0usize;
    while i < members.len() {
        out.push(members.get(i).type);
        i = i + 1usize;
    }
    out
}

// Free names reachable by matching without crossing a type binder.
fn extractable_names(ty: Type) -> Set[Text] {
    let out: Set[Text] = Set::new();
    extractable_in(ty, out);
    out
}

fn extractable_in(ty: Type, out: Set[Text]) {
    match ty {
        Type::Exists(_binders, _body) => (),
        Type::Foreach(f) => extractable_in(f.source.get(), out),
        Type::Fn(f) => {
            if f.quantified.is_empty() {
                let parts = children(ty);
                var i = 0usize;
                while i < parts.len() {
                    extractable_in(parts.get(i), out);
                    i = i + 1usize;
                }
            }
        },
        Type::Named(name, args) => {
            if args.is_empty() {
                out.add(name);
            } else {
                var i = 0usize;
                while i < args.len() {
                    extractable_in(args.get(i), out);
                    i = i + 1usize;
                }
            }
        },
        Type::Skolem(label) => out.add(label),
        _ => {
            let parts = children(ty);
            var i = 0usize;
            while i < parts.len() {
                extractable_in(parts.get(i), out);
                i = i + 1usize;
            }
        },
    }
}

// `ty` and every type inside it, parents first.
fn walk(ty: Type) -> Seq[Type] {
    let out: Seq[Type] = Seq::new();
    walk_into(ty, out);
    out
}

fn walk_into(ty: Type, out: Seq[Type]) {
    out.push(ty);
    let parts = children(ty);
    var i = 0usize;
    while i < parts.len() {
        walk_into(parts.get(i), out);
        i = i + 1usize;
    }
}

// ---------------------------------------------------------------- equality --

// The names bound on each side of an equality, each to a mark shared by the binder it pairs
// with. Each side has its own scope: a name on the left may also occur on the right.
exposed struct Alpha {
    left: Map[Text, u64],
    right: Map[Text, u64],
    marks: Cell[u64],
}

fn alpha() -> Alpha {
    Alpha.{ left: Map::new(), right: Map::new(), marks: Cell::new(0u64) }
}

// `left.get(x, x) == right.get(y, y)`: two bound names with the same mark, or the same free name.
fn same_name(env: Alpha, x: Text, y: Text) -> bool {
    match env.left.get(x) {
        Option::Some(m) => match env.right.get(y) {
            Option::Some(n) => m == n,
            Option::None => false,
        },
        Option::None => match env.right.get(y) {
            Option::Some(_n) => false,
            Option::None => x.eq(y),
        },
    }
}

fn bind(env: Alpha, left: Seq[Text], right: Seq[Text]) -> Alpha {
    let a = env.left.copy();
    let b = env.right.copy();
    var i = 0usize;
    while i < left.len() && i < right.len() {
        let mark = env.marks.get() + 1u64;
        env.marks.set(mark);
        a.set(left.get(i), mark);
        b.set(right.get(i), mark);
        i = i + 1usize;
    }
    Alpha.{ left: a, right: b, marks: env.marks }
}

// Nominal/structural equality modulo renaming of bound names.
fn equal(a: Type, b: Type) -> bool {
    equal_in(a, b, alpha())
}

fn equal_all(xs: Seq[Type], ys: Seq[Type], env: Alpha) -> bool {
    var ok = xs.len() == ys.len();
    var i = 0usize;
    while ok && i < xs.len() {
        ok = equal_in(xs.get(i), ys.get(i), env);
        i = i + 1usize;
    }
    ok
}

fn equal_members(xs: Seq[Member], ys: Seq[Member], env: Alpha) -> bool {
    var ok = xs.len() == ys.len();
    var i = 0usize;
    while ok && i < xs.len() {
        ok = xs.get(i).name.eq(ys.get(i).name) && equal_in(xs.get(i).type, ys.get(i).type, env);
        i = i + 1usize;
    }
    ok
}

fn equal_in(a: Type, b: Type, env: Alpha) -> bool {
    if type_tag(a) != type_tag(b) {
        return false;
    }
    match a {
        Type::Skolem(x) => match b {
            Type::Skolem(y) => same_name(env, x, y),
            _ => false,
        },
        Type::Named(x, xs) => match b {
            Type::Named(y, ys) => {
                if xs.is_empty() && ys.is_empty() && (env.left.has(x) || env.right.has(y)) {
                    same_name(env, x, y)
                } else {
                    x.eq(y) && equal_all(xs, ys, env)
                }
            },
            _ => false,
        },
        Type::Exists(xs, p) => match b {
            Type::Exists(ys, q) => xs.len() == ys.len() && equal_in(p.get(), q.get(), bind(env, xs, ys)),
            _ => false,
        },
        Type::Foreach(x) => match b {
            Type::Foreach(y) => {
                let xb = foreach_binders(x);
                let yb = foreach_binders(y);
                x.indirect == y.indirect && equal_in(x.source.get(), y.source.get(), env) && xb.len() == yb.len()
                    && equal_in(x.body.get(), y.body.get(), bind(env, xb, yb))
            },
            _ => false,
        },
        Type::Fn(x) => match b {
            Type::Fn(y) => {
                if x.is_unsafe != y.is_unsafe || !x.places.same(y.places) || x.params.len() != y.params.len()
                    || x.quantified.len() != y.quantified.len() || !same_kinds(x.quantified, y.quantified) {
                    return false;
                }
                let inner = bind(env, param_names(x.quantified), param_names(y.quantified));
                equal_in(x.ret.get(), y.ret.get(), inner) && equal_all(x.params, y.params, inner)
            },
            _ => false,
        },
        Type::Struct(xs) => match b {
            Type::Struct(ys) => equal_members(xs, ys, env),
            _ => false,
        },
        Type::Enum(xs) => match b {
            Type::Enum(ys) => equal_members(xs, ys, env),
            _ => false,
        },
        Type::Array(x, n) => match b {
            Type::Array(y, m) => n == m && equal_in(x.get(), y.get(), env),
            _ => false,
        },
        Type::Tuple(xs) => match b {
            Type::Tuple(ys) => equal_all(xs, ys, env),
            _ => false,
        },
        Type::Ptr(_x) => equal_in(children(a).get(0usize), children(b).get(0usize), env),
        Type::Brand(_x) => equal_in(children(a).get(0usize), children(b).get(0usize), env),
        _ => C::same(a, b),
    }
}

// The parameters have the same kinds, in order.
fn same_kinds(a: Seq[Param], b: Seq[Param]) -> bool {
    var ok = a.len() == b.len();
    var i = 0usize;
    while ok && i < a.len() {
        ok = C::same_kind(a.get(i).kind, b.get(i).kind);
        i = i + 1usize;
    }
    ok
}

// A value of type `a` may go where `b` is expected.
fn fits(a: Type, b: Type) -> bool {
    match a {
        Type::Never => true,
        _ => equal(a, b),
    }
}

// --------------------------------------------------------- foreach rows --

// One component of a foreach source: its label, item type, and retained bindings.
exposed struct Row {
    label: Text,
    item: Type,
    extra: Map[Text, Type],
}

// A foreach source's outer skeleton (a structural type, or none for a leaf) and its rows.
exposed struct Rows {
    skeleton: Option[Type],
    rows: Seq[Row],
}

// ------------------------------------------------------------------ Types --

// Declaration-aware queries over one program.
exposed struct Types {
    program: Program,
    // (type, its parameters' kinds sorted by name) -> whether it is Copy
    copy_cache: Map[(Type, Seq[(Text, u32)]), bool],
    counter: Fresh,
}

fn name_before(a: (Text, u32), b: (Text, u32)) -> bool {
    let (x, _k) = a;
    let (y, _l) = b;
    x.compare(y) < 0
}

impl Types {
    fn new(program: Program, counter: Fresh) -> Types {
        Types.{ program, copy_cache: Map::new(), counter }
    }

    fn decl(self, name: Text) -> TypeDecl {
        match self.program.types.get(name) {
            Option::Some(decl) => decl,
            Option::None => kurs_error(Out::new().put("unknown type ").add(name).done(), no_pos()),
        }
    }

    // `ty` has no bytes of its own: unit-like products, empty arrays, brand witnesses, Never. A
    // type parameter is answered when it is instantiated.
    fn zero_size(self, ty: Type) -> bool {
        let unit = match ty {
            Type::Brand(_b) => {
                return true;
            },
            Type::Never => {
                return true;
            },
            Type::Named(name, args) => {
                if args.is_empty() && !self.program.types.has(name) {
                    return false;
                }
            },
            _ => (),
        };
        match self.shape(ty, Option::None) {
            Type::Tuple(elems) => {
                var all = true;
                var i = 0usize;
                while all && i < elems.len() {
                    all = self.zero_size(elems.get(i));
                    i = i + 1usize;
                }
                all
            },
            Type::Struct(fields) => {
                var all = true;
                var i = 0usize;
                while all && i < fields.len() {
                    all = self.zero_size(fields.get(i).type);
                    i = i + 1usize;
                }
                all
            },
            Type::Array(elem, length) => length == 0u64 || self.zero_size(elem.get()),
            Type::Exists(_binders, body) => self.zero_size(body.get()),
            _ => false,
        }
    }

    // One nominal step: the declaration's body at its arguments.
    //
    // With `home` given, the declaration must expose its shape there.
    fn unfold(self, ty: Type, home: Option[ModuleId]) -> Type {
        let (name, args) = match ty {
            Type::Named(name, args) => (name, args),
            _ => fail(text("internal error: unfold of a type that is not nominal")),
        };
        let decl = self.decl(name);
        if args.len() != decl.params.len() {
            kurs_error(Out::new().add(name).put(" takes ").usize(decl.params.len()).put(" type arguments").done(), no_pos());
        }
        if !self.is_exposed(decl, home) {
            kurs_error(Out::new().put("the shape of ").add(name).put(" is not exposed here").done(), no_pos());
        }
        let sub: Map[Text, Type] = Map::new();
        var i = 0usize;
        while i < decl.params.len() {
            sub.set(decl.params.get(i).name, args.get(i));
            i = i + 1usize;
        }
        subst(decl.body, sub, self.counter)
    }

    fn is_exposed(self, decl: TypeDecl, home: Option[ModuleId]) -> bool {
        match decl.exposure {
            Option::None => true,
            Option::Some(exposure) => match home {
                Option::None => true,
                Option::Some(m) => match exposure.mode {
                    ExposureMode::Owner => Key::key_same(m, exposure.home),
                    ExposureMode::Within => m.within(exposure.home),
                },
            },
        }
    }

    // Exact assumed authority, or a concrete traversable outer shape.
    //
    // Authority is not recursive field exposure. A derived foreach source cannot borrow an
    // assumption about its underlying source; it needs its own exact assumption or a concretely
    // visible shape.
    fn exposure_available(self, source: Type, home: Option[ModuleId], kinds: Map[Text, Kind], premises: Seq[Premise]) -> bool {
        var i = 0usize;
        while i < premises.len() {
            let p = premises.get(i);
            if p.trait_name.is("builtin::Exposed") && p.args.len() == 1usize && equal(p.args.get(0usize), source) {
                return true;
            }
            i = i + 1usize;
        }
        self.concrete_exposure(source, home, kinds)
    }

    fn concrete_exposure(self, source: Type, home: Option[ModuleId], kinds: Map[Text, Kind]) -> bool {
        match self.visible_shape(source, home, kinds) {
            Option::None => false,
            Option::Some(shape) => match shape {
                Type::Ptr(inner) => {
                    // An indirect traversal requires an explicit outer pointer.
                    match source {
                        Type::Ptr(_s) => match self.visible_shape(inner.get(), home, kinds) {
                            Option::None => false,
                            Option::Some(t) => match t {
                                Type::Enum(_v) => false,
                                _ => true,
                            },
                        },
                        _ => false,
                    }
                },
                _ => true,
            },
        }
    }

    // Reveal only the outer shape, without treating abstract types as leaves.
    fn visible_shape(self, ty: Type, home: Option[ModuleId], kinds: Map[Text, Kind]) -> Option[Type] {
        var ty = ty;
        while true {
            match ty {
                Type::Named(name, _args) => {
                    if kinds.has(name) {
                        return Option::None;
                    }
                    let decl = self.decl(name);
                    if decl.exposure.is_some() && (home.is_none() || !self.is_exposed(decl, home)) {
                        return Option::None;
                    }
                    ty = self.unfold(ty, home);
                },
                Type::Foreach(f) => {
                    if !self.concrete_exposure(f.source.get(), home, kinds) {
                        return Option::None;
                    }
                    ty = self.expand(f, home);
                },
                _ => {
                    return Option::Some.(ty);
                },
            }
        }
        Option::None
    }

    // The outer structural type of `ty` (Named unfolded, foreach expanded).
    fn shape(self, ty: Type, home: Option[ModuleId]) -> Type {
        var ty = ty;
        while true {
            match ty {
                Type::Named(_name, _args) => {
                    ty = self.unfold(ty, home);
                },
                Type::Foreach(f) => {
                    ty = self.expand(f, home);
                },
                _ => {
                    return ty;
                },
            }
        }
        ty
    }

    fn is_copy(self, ty: Type, kinds: Map[Text, Kind]) -> bool {
        match ty {
            Type::Prim(_n) => true,
            Type::Ptr(_i) => true,
            Type::Brand(_b) => true,
            Type::Fn(_f) => true,
            Type::Never => true,
            Type::Ignored => true,
            Type::Named(name, args) => {
                if args.is_empty() && kinds.has(name) {
                    return C::same_kind(kinds.at(name), Kind::Copy);
                }
                if self.decl(name).linear {
                    return false;
                }
                // Whether `T` is Copy changes the answer for `Node[T]`.
                let key = (ty, sorted_kinds(kinds));
                if !self.copy_cache.has(key) {
                    // An active nominal Copy query cannot justify itself. A valid recursive type
                    // reaches a pointer, function, or zero-length array before demanding the
                    // same query.
                    self.copy_cache.set(key, false);
                    let answer = self.is_copy(self.unfold(ty, Option::None), kinds);
                    self.copy_cache.set(key, answer);
                }
                self.copy_cache.at(key)
            },
            Type::Array(elem, length) => length == 0u64 || self.is_copy(elem.get(), kinds),
            Type::Exists(_binders, body) => self.is_copy(body.get(), kinds),
            Type::Foreach(f) => {
                let body = f.body.get();
                let binders: Set[Text] = with_names(Set::new(), foreach_binders(f));
                !overlap(binders, free_names(body)) && self.is_copy(body, kinds)
            },
            _ => {
                let parts = children(ty);
                var all = true;
                var i = 0usize;
                while all && i < parts.len() {
                    all = self.is_copy(parts.get(i), kinds);
                    i = i + 1usize;
                }
                all
            },
        }
    }

    // The component types of a product (struct, tuple or array).
    fn fields(self, ty: Type, home: Option[ModuleId]) -> Seq[Type] {
        match self.shape(ty, home) {
            Type::Struct(fields) => member_types(fields),
            Type::Tuple(elems) => elems,
            Type::Array(elem, length) => {
                let out: Seq[Type] = Seq::new();
                var i = 0u64;
                while i < length {
                    out.push(elem.get());
                    i = i + 1u64;
                }
                out
            },
            _ => kurs_error(Out::new().add(show(ty)).put(" is not a product").done(), no_pos()),
        }
    }

    fn variants(self, ty: Type, home: Option[ModuleId]) -> Seq[Member] {
        match self.shape(ty, home) {
            Type::Enum(variants) => variants,
            _ => kurs_error(Out::new().add(show(ty)).put(" is not a sum").done(), no_pos()),
        }
    }

    // One-level traversal of a foreach source: its outer skeleton (a structural type, or none for
    // a leaf) and one (label, item type, retained bindings) row per component, in order. With
    // `schema`, an array contributes one element type even when its runtime length is zero.
    fn rows(self, source: Type, home: Option[ModuleId], schema: bool) -> Rows {
        let unit = match source {
            Type::Foreach(f) => {
                let inner = self.rows(f.source.get(), home, schema);
                let mapped: Seq[Row] = Seq::new();
                var i = 0usize;
                while i < inner.rows.len() {
                    let row = inner.rows.get(i);
                    let bound = self.bind(f, row.item, row.extra);
                    mapped.push(Row.{ label: row.label, item: subst(f.body.get(), bound, self.counter), extra: bound });
                    i = i + 1usize;
                }
                return Rows.{ skeleton: inner.skeleton, rows: mapped };
            },
            _ => (),
        };
        var s = self.shape(source, home);
        var pointer = false;
        let unit = match s {
            Type::Ptr(inner) => {
                s = self.shape(inner.get(), home);
                pointer = true;
                match s {
                    Type::Enum(_v) => kurs_error(text("a pointer source cannot be a sum"), no_pos()),
                    _ => (),
                }
            },
            _ => (),
        };
        let rows: Seq[Row] = Seq::new();
        match s {
            Type::Struct(fields) => {
                var i = 0usize;
                while i < fields.len() {
                    rows.push(Row.{ label: fields.get(i).name, item: wrap(fields.get(i).type, pointer), extra: Map::new() });
                    i = i + 1usize;
                }
                Rows.{ skeleton: Option::Some.(s), rows }
            },
            Type::Tuple(elems) => {
                var i = 0usize;
                while i < elems.len() {
                    rows.push(Row.{ label: Out::new().usize(i).done(), item: wrap(elems.get(i), pointer), extra: Map::new() });
                    i = i + 1usize;
                }
                Rows.{ skeleton: Option::Some.(s), rows }
            },
            Type::Array(elem, length) => {
                let count = if schema { 1u64 } else { length };
                var i = 0u64;
                while i < count {
                    rows.push(Row.{ label: Out::new().u64(i).done(), item: wrap(elem.get(), pointer), extra: Map::new() });
                    i = i + 1u64;
                }
                Rows.{ skeleton: Option::Some.(s), rows }
            },
            Type::Enum(variants) => {
                var i = 0usize;
                while i < variants.len() {
                    rows.push(Row.{ label: variants.get(i).name, item: variants.get(i).type, extra: Map::new() });
                    i = i + 1usize;
                }
                Rows.{ skeleton: Option::Some.(s), rows }
            },
            _ => {
                rows.push(Row.{ label: text("0"), item: source, extra: Map::new() });
                Rows.{ skeleton: Option::None, rows }
            },
        }
    }

    // The substitution under which `ty`'s body maps one row.
    fn bind(self, ty: ForeachType, item: Type, extra: Map[Text, Type]) -> Map[Text, Type] {
        let out: Map[Text, Type] = Map::new();
        var i = 0usize;
        while i < ty.retained.len() {
            let name = ty.retained.get(i);
            let unit = match extra.get(name) {
                Option::Some(t) => out.set(name, t),
                Option::None => (),
            };
            i = i + 1usize;
        }
        if ty.indirect {
            match item {
                Type::Ptr(inner) => out.set(ty.binder, inner.get()),
                _ => kurs_error(text("a pointer pattern needs pointer components"), no_pos()),
            }
        } else {
            out.set(ty.binder, item);
        }
        out
    }

    // Prove *F matches without assuming the shape of abstract components.
    //
    // Source exposure is a separate obligation. An explicit pointer gives pointer components even
    // when its authorized pointee shape is abstract.
    fn pattern_available(self, ty: ForeachType, home: Option[ModuleId], kinds: Map[Text, Kind]) -> bool {
        if !ty.indirect {
            return true;
        }
        let unit = match ty.source.get() {
            Type::Foreach(source) => {
                return is_ptr(source.body.get());
            },
            Type::Ptr(_inner) => {
                return true;
            },
            _ => (),
        };
        if self.visible_shape(ty.source.get(), home, kinds).is_none() {
            return false;
        }
        let rows = self.rows(ty.source.get(), home, true).rows;
        var all = true;
        var i = 0usize;
        while all && i < rows.len() {
            all = is_ptr(rows.get(i).item);
            i = i + 1usize;
        }
        all
    }

    // The structural type a foreach transform denotes.
    fn expand(self, ty: ForeachType, home: Option[ModuleId]) -> Type {
        let found = self.rows(ty.source.get(), home, true);
        let mapped: Seq[Member] = Seq::new();
        var i = 0usize;
        while i < found.rows.len() {
            let row = found.rows.get(i);
            mapped.push(Member.{ name: row.label, type: subst(ty.body.get(), self.bind(ty, row.item, row.extra), self.counter) });
            i = i + 1usize;
        }
        match found.skeleton {
            Option::Some(skeleton) => match skeleton {
                Type::Struct(_f) => Type::Struct.(mapped),
                Type::Enum(_v) => Type::Enum.(mapped),
                Type::Array(_e, length) => Type::Array.(Cell::new(mapped.get(0usize).type), length),
                _ => Type::Tuple.(member_types(mapped)),
            },
            Option::None => Type::Tuple.(member_types(mapped)),
        }
    }
}

fn wrap(t: Type, pointer: bool) -> Type {
    if pointer { C::ptr(t) } else { t }
}

fn is_ptr(t: Type) -> bool {
    match t {
        Type::Ptr(_inner) => true,
        _ => false,
    }
}

// The kinds as a map key: (name, kind) pairs sorted by name.
fn sorted_kinds(kinds: Map[Text, Kind]) -> Seq[(Text, u32)] {
    let out: Seq[(Text, u32)] = Seq::new();
    let names = kinds.keys();
    var i = 0usize;
    while i < names.len() {
        out.push((names.get(i), C::kind_index(kinds.at(names.get(i)))));
        i = i + 1usize;
    }
    out.sort(name_before);
    out
}

// ------------------------------------------------------------------- show --

fn show_all(out: Out, ts: Seq[Type]) -> Out {
    var i = 0usize;
    while i < ts.len() {
        if i > 0usize {
            let unit = out.put(" ");
        }
        let unit = out.add(show(ts.get(i)));
        i = i + 1usize;
    }
    out
}

fn show_members(out: Out, ms: Seq[Member]) -> Out {
    var i = 0usize;
    while i < ms.len() {
        if i > 0usize {
            let unit = out.put(" ");
        }
        let unit = out.put("(").add(ms.get(i).name).put(" ").add(show(ms.get(i).type)).put(")");
        i = i + 1usize;
    }
    out
}

fn show(ty: Type) -> Text {
    match ty {
        Type::Prim(name) => name,
        Type::Never => text("!"),
        Type::Named(name, args) => {
            if args.is_empty() {
                name
            } else {
                show_all(Out::new().put("(").add(name).put(" "), args).put(")").done()
            }
        },
        Type::Skolem(label) => Out::new().put("$").add(label).done(),
        Type::Brand(brand) => Out::new().put("(builtin::Brand ").add(show(brand.get())).put(")").done(),
        Type::Ptr(inner) => Out::new().put("(builtin::Pointer ").add(show(inner.get())).put(")").done(),
        Type::Tuple(elems) => replace_all(show_all(Out::new().put("(tuple "), elems).put(")").done(), text(" )"), text(")")),
        Type::Array(elem, length) => Out::new().put("(array ").add(show(elem.get())).put(" ").u64(length).put(")").done(),
        Type::Struct(fields) => show_members(Out::new().put("(struct "), fields).put(")").done(),
        Type::Enum(variants) => show_members(Out::new().put("(enum "), variants).put(")").done(),
        Type::Exists(binders, body) => {
            let out = Out::new().put("(exists (");
            var i = 0usize;
            while i < binders.len() {
                if i > 0usize {
                    let unit = out.put(" ");
                }
                let unit = out.put("$").add(binders.get(i));
                i = i + 1usize;
            }
            out.put(") ").add(show(body.get())).put(")").done()
        },
        Type::Foreach(f) => {
            let out = Out::new().put("(foreach (");
            if f.indirect {
                let unit = out.put("(builtin::Pointer ").add(f.binder).put(")");
            } else {
                let unit = out.add(f.binder);
            }
            let unit = out.put(" ").add(show(f.source.get())).put(") ").add(show(f.body.get()));
            let inferred = match f.source.get() {
                Type::Foreach(source) => foreach_binders(source),
                _ => Seq::new(),
            };
            if !f.retained.same(inferred) {
                let unit = out.put(" (retain ");
                var i = 0usize;
                while i < f.retained.len() {
                    if i > 0usize {
                        let unit = out.put(" ");
                    }
                    let unit = out.add(f.retained.get(i));
                    i = i + 1usize;
                }
                let unit = out.put(")");
            }
            out.put(")").done()
        },
        Type::Fn(f) => {
            let out = Out::new().put("(builtin::Fn ");
            if f.is_unsafe {
                let unit = out.put("(unsafe) ");
            }
            show_all(out.put("("), f.params).put(") ").add(show(f.ret.get())).put(")").done()
        },
        _ => text("_"),
    }
}
