// Type inference for function bodies, by constraint solving.
//
// Walking a body assigns types, using fresh metavariables for unknowns. Unification solves equalities
// immediately. Field selection, method lookup and trait selection can need information learned later:
// `wait` stores a readiness condition (`Ready`), an action (`Action`) and a diagnostic position.
// `later` waits for a type's head.
//
// Adding a waiter or unifying types calls `solve`, which scans waiting actions until none is ready.
// Each ready action is removed before it runs. Actions may unify types or add waiters; `solving`
// prevents nested solver loops, so the outer loop picks up the resulting work.
//
// Once ready work is exhausted, `run_defaults` gives still-unknown `pack` types their payload-derived
// types and resumes solving. Defaults run at function finalization, or earlier when `shape` needs a
// known type head. Integer literals have no default: their types must be determined by context or a
// suffix. `finish` drains ready work and defaults, rejects remaining waiters and undetermined numeric
// literals, then replaces solved metavariables in the recorded types and call annotations.
//
// Results are kept in `Results`, by syntax node id, for lowering: each expression's, pattern's and
// variant case's type, what each call calls (`Callee`), local binding ids, captures and the rest.

use package::support::base::{Cell, Map, Out, Seq, Set, Text, text};
use package::types::coherence::check_coherence;
use package::kurs::core::{ForeachType, Kind, Member, Meta, MetaKind, ModuleId, Param, Premise, Program, Type, TypeDecl};
use package::kurs::core as C;
use package::resolve::resolver::{Decl, NameRef, Named, Owner, Resolver, Target, repr};
use package::sigs::signatures::{ConstValue, InstanceSig, Sig, Signatures, const_type, new_scope};
use package::syntax::ast as S;
use package::syntax::ast::{Expr, Pattern, Pos, Statement, no_pos};
use package::types::termination::check_instance_termination;
use package::types::ops::{Fresh, Types, equal, foreach_binders, free_brands, free_names, show, subst};
use package::types::unify::{instantiate, match_head, prune, unify, zonk};
use std::option::{Option, Result};
use std::slice::Slice;

// ------------------------------------------------------- what gets recorded --

// A method call's receiver: the expression, and whether it is lent.
exposed struct Receiver {
    value: Expr,
    lend: bool,
}

exposed struct FnCall {
    sig: Sig,
    sub: Map[Text, Type],
    receiver: Option[Receiver],
}

impl FnCall {
    // The called symbol: an extern's own name, else the signature's.
    fn call_name(self) -> Text {
        match self.sig.decl {
            Option::Some(d) => match d.node {
                Named::Extern(x) => x.name,
                _ => self.sig.name,
            },
            Option::None => self.sig.name,
        }
    }

    // In signature order; Ignored retains a function value's brand binder.
    fn targs(self) -> Seq[Type] {
        let out: Seq[Type] = Seq::new();
        var i = 0usize;
        while i < self.sig.params.len() {
            out.push(self.sub.get_or(self.sig.params.get(i).name, Type::Ignored));
            i = i + 1usize;
        }
        out
    }
}

exposed struct TraitCall {
    trait_name: Text,
    method: Text,
    targs: Seq[Type],
    receiver: Option[Receiver],
}

// What a call calls.
exposed enum Callee {
    Fn(FnCall),
    Trait(TraitCall),
    // a function value, with its brand instantiation
    Value(Map[Text, Type]),
    Closure,
    Variant(Text),
    Tuple,
    Builtin(Text),
    Alloca(Type),
    // a pointer method, and its receiver
    Pointer(Text, Expr),
    FStringWrite(S::FStr),
}

// One captured binding, in first-use order.
exposed struct Capture {
    name: Text,
    binder: u32,
}

// What inference found, by syntax node id.
exposed struct Results {
    // expressions, patterns and variant cases (a case's is its payload type)
    types: Map[u32, Type],
    // the binding a local path uses, or a var, const, for, foreach item or pattern binds
    binders: Map[u32, u32],
    // constant paths and local consts
    folded: Map[u32, ConstValue],
    // paths and calls
    calls: Map[u32, Callee],
    // sizeof
    targets: Map[u32, Type],
    // struct literals: shorthand fields' binding ids, and the spread's
    field_ids: Map[u32, Map[Text, u32]],
    spread_ids: Map[u32, u32],
    // variant cases: payload binding ids, none for each `_`
    case_binders: Map[u32, Seq[Option[u32]]],
    // matches: whether the scrutinee lends a place
    lent: Map[u32, bool],
    // functions and closures
    param_ids: Map[u32, Seq[u32]],
    // closures and foreach bodies
    captures: Map[u32, Seq[Capture]],
    // packs
    witnesses: Map[u32, Seq[Type]],
    // `?`: option or result
    try_kinds: Map[u32, Text],
    // `let exists`: the opened brands' labels
    opened: Map[u32, Seq[Text]],
    // for loops: the `next` result type, and the Iterator call
    options: Map[u32, Type],
    next_calls: Map[u32, TraitCall],
    // struct patterns with `..rest`
    rest_ids: Map[u32, u32],
}

fn new_results() -> Results {
    Results.{
        types: Map::new(), binders: Map::new(), folded: Map::new(), calls: Map::new(), targets: Map::new(),
        field_ids: Map::new(), spread_ids: Map::new(), case_binders: Map::new(), lent: Map::new(),
        param_ids: Map::new(), captures: Map::new(), witnesses: Map::new(), try_kinds: Map::new(),
        opened: Map::new(), options: Map::new(), next_calls: Map::new(), rest_ids: Map::new(),
    }
}

// ------------------------------------------------------------- the scopes --

// The fields a `..rest` pattern left over: known once the type matched against is.
exposed struct Bundle {
    types: Map[Text, Type],
    filled: Cell[bool],
}

exposed struct Local {
    type: Type,
    // a var, or an `&` parameter
    mutable: bool,
    // a `..rest` bundle
    rest: Option[Bundle],
    // how many closures deep it was bound
    depth: usize,
    id: u32,
}

// A lexical scope: the names bound in it, and the brands a `let exists` opened in it.
exposed struct Level {
    names: Map[Text, Local],
    // source spelling -> unique witness
    brands: Map[Text, Text],
    // includes witnesses whose spelling was shadowed
    opened: Set[Text],
}

fn new_level() -> Level {
    Level.{ names: Map::new(), brands: Map::new(), opened: Set::new() }
}

// A closure or foreach body being walked: the outer locals it captures, in first-use order.
exposed struct Frame {
    locals: Seq[(Text, Local)],
}

fn new_frame() -> Frame {
    Frame.{ locals: Seq::new() }
}

// ------------------------------------------------------------- the solver --

// When a waiting action can run: a type's head is known; the first `n` types mention no unknown;
// a bundle is filled; two types' heads are known.
exposed enum Ready {
    Head(Type),
    Ground(Seq[Type], usize),
    Filled(Bundle),
    Both(Type, Type),
}

exposed struct Elements {
    array: bool,
    ty: Type,
    types: Seq[Type],
}

exposed struct Fields {
    ty: Type,
    metas: Map[Text, Type],
    bundle: Bundle,
}

exposed struct Spread {
    spread: Text,
    fields: Map[Text, Type],
    given: Set[Text],
    bundle: Bundle,
}

exposed struct PackWait {
    result: Type,
    value: Type,
    labels: Seq[Text],
    pos: Pos,
}

exposed struct TryWait {
    id: u32,
    operand: Type,
    returned: Type,
    result: Type,
}

// `owner.name` (a field) or `owner.N` (an index).
exposed struct Component {
    field: Option[Text],
    index: usize,
    owner: Type,
    result: Type,
}

exposed struct CallWait {
    call: S::Call,
    callee: Type,
    got: Seq[Option[(Type, bool)]],
    result: Type,
}

exposed struct MethodWait {
    call: S::Call,
    receiver: Type,
    name: Text,
    actual: Receiver,
    got: Seq[Option[(Type, bool)]],
    result: Type,
}

exposed struct PointerWait {
    name: Text,
    pointer: Type,
    operands: Seq[Type],
    out: Type,
}

// What a waiter does once it is ready.
exposed enum Action {
    Copy(Type),
    Discharge(Text, Seq[Type], usize),
    Elements(Elements),
    Fields(Fields),
    // op, operand, unary
    Primitive(Text, Type, bool),
    // result, element
    Fill(Type, Type),
    Spread(Spread),
    VisibleShape(Type),
    Integer(Type),
    Pack(PackWait),
    Try(TryWait),
    Component(Component),
    CallValue(CallWait),
    Method(MethodWait),
    EnumOperand(Type),
    Pointer(PointerWait),
}

exposed struct Waiter {
    ready: Ready,
    action: Action,
    pos: Pos,
}

// A type pattern of an operator rule: `t` is shared by the rule.
exposed enum Pat {
    Bool,
    Unit,
    T,
    PtrT,
}

// A method found by name.
exposed enum Lookup {
    Pointer,
    Method(Sig),
    Trait(C::Trait, Seq[Type]),
}

// ---------------------------------------------------------------- helpers --

fn is_never(t: Type) -> bool {
    match prune(t) {
        Type::Never => true,
        _ => false,
    }
}

fn is_unsolved(t: Type) -> bool {
    match prune(t) {
        Type::Meta(_m) => true,
        _ => false,
    }
}

fn all_settled(ts: Seq[Type]) -> bool {
    var i = 0usize;
    while i < ts.len() {
        if !settled(ts.get(i)) {
            return false;
        }
        i = i + 1usize;
    }
    true
}

fn members_settled(ms: Seq[Member]) -> bool {
    var i = 0usize;
    while i < ms.len() {
        if !settled(ms.get(i).type) {
            return false;
        }
        i = i + 1usize;
    }
    true
}

// `ty` mentions no unsolved metavariable (`unify::ground`, without building the zonked type).
fn settled(ty: Type) -> bool {
    match prune(ty) {
        Type::Meta(_m) => false,
        Type::Ptr(inner) => settled(inner.get()),
        Type::Brand(inner) => settled(inner.get()),
        Type::Array(elem, _n) => settled(elem.get()),
        Type::Tuple(elems) => all_settled(elems),
        Type::Named(_name, args) => all_settled(args),
        Type::Struct(fields) => members_settled(fields),
        Type::Enum(variants) => members_settled(variants),
        Type::Exists(_b, body) => settled(body.get()),
        Type::Foreach(f) => settled(f.source.get()) && settled(f.body.get()),
        Type::Fn(f) => all_settled(f.params) && settled(f.ret.get()),
        _ => true,
    }
}

fn meta_of(kind: Kind) -> Type {
    match kind {
        Kind::Brand => Type::Meta.(Meta::new(MetaKind::Brand)),
        _ => Type::Meta.(Meta::new(MetaKind::Type)),
    }
}

fn new_meta() -> Type {
    Type::Meta.(Meta::new(MetaKind::Type))
}

fn is_brand(kind: Kind) -> bool {
    match kind {
        Kind::Brand => true,
        _ => false,
    }
}

fn is_copy_kind(kind: Kind) -> bool {
    match kind {
        Kind::Copy => true,
        _ => false,
    }
}

fn text_before(a: Text, b: Text) -> bool {
    a.compare(b) < 0
}

fn has_args(path: S::Path) -> bool {
    var i = 0usize;
    while i < path.segments.len() {
        if !path.segments.get(i).args.is_empty() {
            return true;
        }
        i = i + 1usize;
    }
    false
}

fn joined_names(names: Seq[Text]) -> Text {
    let out = Out::new();
    var i = 0usize;
    while i < names.len() {
        if i > 0usize {
            let unit = out.put("::");
        }
        let unit = out.add(names.get(i));
        i = i + 1usize;
    }
    out.done()
}

fn is_pointer_method(name: Text) -> bool {
    name.is("load") || name.is("load_volatile") || name.is("store") || name.is("store_volatile") || name.is("atomic_load")
        || name.is("atomic_store") || name.is("compare_exchange") || name.is("atomic_swap") || name.is("fetch_add")
        || name.is("fetch_sub") || name.is("fetch_and") || name.is("fetch_or") || name.is("fetch_xor")
}

// A pointer operation's parameter types, `T` for the pointee and `O` for a memory ordering.
fn pointer_params(name: Text) -> Text {
    if name.is("load") || name.is("load_volatile") {
        text("")
    } else if name.is("store") || name.is("store_volatile") {
        text("T")
    } else if name.is("atomic_load") {
        text("O")
    } else if name.is("compare_exchange") {
        text("TTOO")
    } else {
        text("TO")
    }
}

// Its result: `T`, `U` for `()`, or `B` for `(T, bool)`.
fn pointer_result(name: Text) -> u8 {
    if name.is("store") || name.is("store_volatile") || name.is("atomic_store") {
        b'U'
    } else if name.is("compare_exchange") {
        b'B'
    } else {
        b'T'
    }
}

// A builtin's number of value arguments, or none for an unknown builtin.
fn builtin_arity(name: Text) -> Option[usize] {
    if name.is("fresh") || name.is("static_brand") || name.is("alloca") {
        Option::Some.(0usize)
    } else if name.is("enum_variant") || name.is("fence") || name.is("load_volatile") {
        Option::Some.(1usize)
    } else if name.is("store_volatile") {
        Option::Some.(2usize)
    } else {
        Option::None
    }
}

fn is_comparison(op: Text) -> bool {
    op.is("==") || op.is("!=") || op.is("<") || op.is("<=") || op.is(">") || op.is(">=")
}

fn has_place(places: Seq[usize], k: usize) -> bool {
    places.has(k)
}

// ------------------------------------------------------------- inference --

exposed struct Infer {
    r: Resolver,
    sigs: Signatures,
    types: Types,
    decl_of: Map[Text, Decl],
    // trait -> its number of input parameters
    inputs: Map[Text, usize],
    instances: Map[Text, Seq[InstanceSig]],
    // module -> the ids of the traits visible in it
    visible: Map[ModuleId, Set[u32]],
    // source binding identities, and the numbers of generated names
    ids: Cell[u32],
    counter: Fresh,
    out: Results,
    // inference-only flags: bare function names bound without an annotation, calls whose receiver
    // `&` lends
    generic: Set[u32],
    lend_marked: Set[u32],
}

impl Infer {
    fn new(r: Resolver, sigs: Signatures, counter: Fresh) -> Infer {
        let headers: Seq[(Premise, Seq[Premise], Pos)] = Seq::new();
        let ranges: Seq[(Premise, Seq[Param], Pos)] = Seq::new();
        var i = 0usize;
        while i < sigs.instances.len() {
            let (inst, _item, _home) = sigs.instances.get(i);
            let head = Premise.{ trait_name: inst.trait_name, args: inst.head };
            headers.push((head, inst.premises, inst.pos));
            ranges.push((head, inst.params, inst.pos));
            i = i + 1usize;
        }
        check_instance_termination(headers);
        check_coherence(ranges, counter);
        let program = Program.{ types: sigs.types, funs: Map::new(), externs: Map::new(), datas: Map::new(), traits: sigs.traits, instances: Map::new() };
        let inf = Infer.{
            r, sigs, types: Types::new(program, counter), decl_of: Map::new(), inputs: Map::new(), instances: Map::new(),
            visible: Map::new(), ids: Cell::new(0u32), counter, out: new_results(), generic: Set::new(), lend_marked: Set::new(),
        };
        let scopes = r.scopes.values();
        i = 0usize;
        while i < scopes.len() {
            let decls = scopes.get(i).decls.values();
            var k = 0usize;
            while k < decls.len() {
                let decl = decls.get(k);
                if decl.kind.is("struct") || decl.kind.is("enum") || decl.kind.is("tuple") || decl.kind.is("trait") {
                    inf.decl_of.set(sigs.name(decl), decl);
                }
                let unit = match decl.node {
                    Named::Trait(t) => if decl.kind.is("trait") {
                        inf.inputs.set(sigs.name(decl), match t.quantifier {
                            Option::Some(f) => f.params.len(),
                            Option::None => 1usize,
                        });
                    },
                    _ => (),
                };
                k = k + 1usize;
            }
            i = i + 1usize;
        }
        i = 0usize;
        while i < sigs.instances.len() {
            let (inst, _item, _home) = sigs.instances.get(i);
            let unit = match inf.instances.get(inst.trait_name) {
                Option::Some(list) => list.push(inst),
                Option::None => inf.instances.set(inst.trait_name, Seq::one(inst)),
            };
            i = i + 1usize;
        }
        inf
    }

    fn next_id(self) -> u32 {
        let n = self.ids.get();
        self.ids.set(n + 1u32);
        n
    }

    fn run(self) {
        let sigs = self.sigs.sigs.values();
        var i = 0usize;
        while i < sigs.len() {
            let sig = sigs.get(i);
            let unit = match sig.decl {
                Option::Some(decl) => match decl.node {
                    Named::Fn(node) => if node.body.is_some() {
                        self.r.locate(decl.home, node.pos);
                        self.function(sig, node, decl.home, Option::None);
                        self.r.unlocate();
                    },
                    _ => (),
                },
                Option::None => (),
            };
            i = i + 1usize;
        }
        i = 0usize;
        while i < self.sigs.instances.len() {
            let (inst, item, home) = self.sigs.instances.get(i);
            var k = 0usize;
            while k < inst.methods.len() {
                let node = item.methods.get(k);
                self.r.locate(home, node.pos);
                self.function(inst.methods.get(k), node, home, Option::Some.(inst));
                self.r.unlocate();
                k = k + 1usize;
            }
            i = i + 1usize;
        }
    }

    fn function(self, sig: Sig, node: S::Fn, home: ModuleId, inst: Option[InstanceSig]) {
        let kinds: Map[Text, Kind] = Map::new();
        var i = 0usize;
        while i < sig.params.len() {
            kinds.set(sig.params.get(i).name, sig.params.get(i).kind);
            i = i + 1usize;
        }
        let assumptions = sig.premises.copy();
        let unit = match inst {
            Option::Some(x) => assumptions.push(Premise.{ trait_name: x.trait_name, args: x.head }),
            Option::None => (),
        };
        let level = new_level();
        let b = Body.{
            inf: self, home, sig, kinds, assumptions, waiting: Seq::new(), defaults: Seq::new(), recorded: Seq::new(),
            literals: Seq::new(), brand_checks: Seq::new(), solving: Cell::new(false), returns: Seq::one(sig.ret),
            scopes: Seq::one(level), frames: Seq::one(new_frame()), allowed: Cell::new(Option::None),
        };
        let ids: Seq[u32] = Seq::new();
        i = 0usize;
        while i < sig.pnames.len() {
            let local = Local.{ type: sig.ptypes.get(i), mutable: has_place(sig.places, i), rest: Option::None, depth: 0usize, id: self.next_id() };
            level.names.set(sig.pnames.get(i), local);
            ids.push(local.id);
            i = i + 1usize;
        }
        self.out.param_ids.set(node.id, ids);
        let body = match node.body {
            Option::Some(block) => block,
            Option::None => return,
        };
        let unit = b.check(Expr::Block.(body), Option::Some.(sig.ret));
        b.finish();
    }

    // The traits a name in `home`'s scope resolves to: declared, imported by name or glob, or
    // re-exported. A glob's names are those its source module declares, imports or exports, and every
    // trait's own name.
    fn visible_traits(self, home: ModuleId) -> Set[u32] {
        let unit = match self.visible.get(home) {
            Option::Some(found) => return found,
            Option::None => (),
        };
        let scope = self.r.scopes.at(home);
        let names: Seq[Text] = scope.decls.keys();
        names.append(scope.imports.keys());
        let decls = self.decl_of.values();
        var i = 0usize;
        while i < decls.len() {
            if decls.get(i).kind.is("trait") {
                names.push(decls.get(i).name);
            }
            i = i + 1usize;
        }
        i = 0usize;
        while i < scope.globs.len() {
            let unit = match self.r.lookup(home, scope.globs.get(i), no_pos()) {
                Result::Ok(t) => match t {
                    Target::Module(m) => match self.r.scopes.get(m) {
                        Option::Some(other) => {
                            names.append(other.decls.keys());
                            names.append(other.imports.keys());
                            names.append(other.exports.items());
                        },
                        Option::None => (),
                    },
                    _ => (),
                },
                Result::Err(_e) => (),
            };
            i = i + 1usize;
        }
        let found: Set[u32] = Set::new();
        let tried: Set[Text] = Set::new();
        i = 0usize;
        while i < names.len() {
            let name = names.get(i);
            if !tried.has(name) {
                tried.add(name);
                let unit = match self.r.lookup(home, Seq::one(name), no_pos()) {
                    Result::Ok(t) => match t {
                        Target::Decl(d) => if d.kind.is("trait") {
                            found.add(d.id);
                        },
                        _ => (),
                    },
                    Result::Err(_e) => (),
                };
            }
            i = i + 1usize;
        }
        self.visible.set(home, found);
        found
    }

    // A blanket impl's method is found from a package that is the impl's or depends on it directly,
    // when every trait bounding the impl's type parameter is visible there (and it has one).
    // `package` is `target` or depends on it, directly or through other packages.
    fn depends_on(self, package: usize, target: usize) -> bool {
        let seen: Set[usize] = Set::new();
        let pending: Seq[usize] = Seq::one(package);
        while pending.len() > 0usize {
            let p = pending.pop();
            if p == target {
                return true;
            }
            if !seen.has(p) {
                seen.add(p);
                pending.append(self.r.packages.get(p).deps.values());
            }
        }
        false
    }

    fn blanket_visible(self, method: Decl, home: ModuleId, visible: Set[u32]) -> bool {
        if !self.depends_on(home.package, method.home.package) {
            return false;
        }
        let impl_block = match method.impl_block {
            Option::Some(b) => b,
            Option::None => return false,
        };
        let param = match impl_block.type {
            S::Type::Name(n) => n.path.get(0usize),
            _ => return false,
        };
        let premises = match impl_block.quantifier {
            Option::Some(f) => f.premises,
            Option::None => return false,
        };
        var bounds = 0usize;
        var i = 0usize;
        while i < premises.len() {
            let args = premises.get(i).args;
            let bounding = if args.args.is_empty() {
                false
            } else {
                match args.args.get(0usize) {
                    S::Type::Name(n) => n.path.len() == 1usize && n.path.get(0usize).eq(param),
                    _ => false,
                }
            };
            if bounding {
                let unit = match self.r.refs.get(args.id) {
                    Option::Some(r) => match r {
                        NameRef::Decl(d) => {
                            if !visible.has(d.id) {
                                return false;
                            }
                            bounds = bounds + 1usize;
                        },
                        _ => (),
                    },
                    Option::None => (),
                };
            }
            i = i + 1usize;
        }
        bounds > 0usize
    }
}

// One function body being inferred.
exposed struct Body {
    inf: Infer,
    home: ModuleId,
    sig: Sig,
    kinds: Map[Text, Kind],
    assumptions: Seq[Premise],
    waiting: Seq[Waiter],
    defaults: Seq[PackWait],
    recorded: Seq[u32],
    literals: Seq[Meta],
    brand_checks: Seq[(Type, Set[Text], Pos)],
    solving: Cell[bool],
    returns: Seq[Type],
    scopes: Seq[Level],
    frames: Seq[Frame],
    // the brands a type recorded here may mention, until a scope opens or closes some
    allowed: Cell[Option[Set[Text]]],
}

impl Body {
    fn fail(self, message: Text, pos: Pos) -> ! {
        self.inf.r.fail(message, pos)
    }

    fn fails(self, message: Slice[u8, 'static], pos: Pos) -> ! {
        self.inf.r.fail(text(message), pos)
    }

    fn results(self) -> Results {
        self.inf.out
    }

    fn type_of(self, id: u32) -> Type {
        self.inf.out.types.at(id)
    }

    // Finish pending inference, report unresolved requirements, and normalize annotations for lowering.
    fn finish(self) {
        self.solve();
        self.run_defaults();
        if !self.waiting.is_empty() {
            self.fails("a type here is not known yet; annotate it", self.waiting.get(0usize).pos);
        }
        var i = 0usize;
        while i < self.literals.len() {
            let m = self.literals.get(i);
            if is_unsolved(Type::Meta.(m)) {
                let what = match m.kind() {
                    MetaKind::Float => "floating",
                    _ => "integer",
                };
                self.fail(Out::new().put("a ").put(what).put(" literal's type is not determined; write a suffix").done(), m.pos());
            }
            i = i + 1usize;
        }
        i = 0usize;
        while i < self.brand_checks.len() {
            let (ty, allowed, pos) = self.brand_checks.get(i);
            let brands = free_brands(zonk(ty)).items();
            var least: Option[Text] = Option::None;
            var k = 0usize;
            while k < brands.len() {
                let b = brands.get(k);
                if !allowed.has(b) {
                    least = match least {
                        Option::Some(l) => if b.compare(l) < 0 { Option::Some.(b) } else { Option::Some.(l) },
                        Option::None => Option::Some.(b),
                    };
                }
                k = k + 1usize;
            }
            let unit = match least {
                Option::Some(b) => self.fail(Out::new().put("brand ").add(b).put(" escapes its lexical scope").done(), pos),
                Option::None => (),
            };
            i = i + 1usize;
        }
        let out = self.results();
        i = 0usize;
        while i < self.recorded.len() {
            let id = self.recorded.get(i);
            out.types.set(id, zonk(out.types.at(id)));
            let unit = match out.options.get(id) {
                Option::Some(t) => {
                    out.options.set(id, zonk(t));
                    zonk_all(out.next_calls.at(id).targs);
                },
                Option::None => (),
            };
            let unit = match out.calls.get(id) {
                Option::Some(call) => match call {
                    Callee::Fn(f) => zonk_map(f.sub),
                    Callee::Value(sub) => zonk_map(sub),
                    Callee::Trait(t) => zonk_all(t.targs),
                    Callee::Alloca(t) => out.calls.set(id, Callee::Alloca.(zonk(t))),
                    _ => (),
                },
                Option::None => (),
            };
            i = i + 1usize;
        }
    }

    // ---- the solver
    // Run `action` once `ready` holds.
    fn wait(self, ready: Ready, action: Action, pos: Pos) {
        self.waiting.push(Waiter.{ ready, action, pos });
        self.solve();
    }

    // Run `action` once the head of the type `ty` is known.
    fn later(self, ty: Type, action: Action, pos: Pos) {
        self.wait(Ready::Head.(ty), action, pos);
    }

    fn ready(self, r: Ready) -> bool {
        match r {
            Ready::Head(t) => !is_unsolved(t),
            Ready::Ground(ts, n) => {
                var i = 0usize;
                while i < n && i < ts.len() {
                    if !settled(ts.get(i)) {
                        return false;
                    }
                    i = i + 1usize;
                }
                true
            },
            Ready::Filled(b) => b.filled.get(),
            Ready::Both(a, b) => !is_unsolved(a) && !is_unsolved(b),
        }
    }

    // Drain ready actions; a nested call leaves its work to the active solver loop. Each pass runs
    // the waiters present when it began, in order; the others are kept in place, in order, followed
    // by the ones added during the pass.
    fn solve(self) {
        if self.solving.get() {
            return;
        }
        self.solving.set(true);
        var progress = true;
        while progress {
            progress = false;
            let n = self.waiting.len();
            var kept = 0usize;
            var i = 0usize;
            while i < n {
                let item = self.waiting.get(i);
                if self.ready(item.ready) {
                    self.act(item.action, item.pos);
                    progress = true;
                } else {
                    self.waiting.set(kept, item);
                    kept = kept + 1usize;
                }
                i = i + 1usize;
            }
            var j = n;
            while j < self.waiting.len() {
                self.waiting.set(kept, self.waiting.get(j));
                kept = kept + 1usize;
                j = j + 1usize;
            }
            self.waiting.truncate(kept);
        }
        self.solving.set(false);
    }

    // What is still unknown when nothing else can run takes its default.
    fn run_defaults(self) {
        while !self.defaults.is_empty() {
            let wait = self.defaults.remove(0usize);
            if is_unsolved(wait.result) {
                self.pack_default(wait);
                self.solve();
            }
        }
    }

    fn act(self, action: Action, pos: Pos) {
        match action {
            Action::Copy(ty) => if !self.inf.types.is_copy(zonk(ty), self.kinds) {
                self.fails("type argument must satisfy Copy", pos);
            },
            Action::Discharge(trait_name, args, n) => self.discharge(trait_name, args, n, pos),
            Action::Elements(e) => self.elements(e, pos),
            Action::Fields(f) => self.fields_known(f, pos),
            Action::Primitive(op, operand, unary) => self.primitive(op, operand, unary, pos),
            Action::Fill(result, elem) => {
                match self.shape(result, pos) {
                    Type::Array(want, _n) => self.unify_at(elem, want.get(), pos),
                    _ => self.fails("an array literal with `..` needs its length from the expected type", pos),
                }
            },
            Action::Spread(s) => {
                let names = s.fields.keys();
                var i = 0usize;
                while i < names.len() {
                    let name = names.get(i);
                    if !s.given.has(name) {
                        let have = match s.bundle.types.get(name) {
                            Option::Some(t) => t,
                            Option::None => self.fail(Out::new().put("..").add(s.spread).put(" has no field ").add(name).done(), pos),
                        };
                        self.unify_at(have, s.fields.at(name), pos);
                    }
                    i = i + 1usize;
                }
            },
            Action::VisibleShape(ty) => self.require_visible_shape(ty, pos),
            Action::Integer(ty) => {
                let integer = match self.shape(ty, pos) {
                    Type::Prim(name) => C::is_integer(name),
                    _ => false,
                };
                if !integer {
                    self.fails("value patterns need an integer scrutinee", pos);
                }
            },
            Action::Pack(p) => {
                let want = self.shape(p.result, pos);
                let (binders, body) = match want {
                    Type::Exists(binders, body) => (binders, body.get()),
                    _ => self.fails("pack does not match the type it is used at", pos),
                };
                if binders.len() != p.labels.len() {
                    self.fails("pack does not match the type it is used at", pos);
                }
                let sub: Map[Text, Type] = Map::new();
                var i = 0usize;
                while i < binders.len() {
                    sub.set(binders.get(i), Type::Skolem.(p.labels.get(i)));
                    i = i + 1usize;
                }
                self.unify_at(p.value, subst(body, sub, self.inf.counter), pos);
            },
            Action::Try(t) => {
                let found = self.resolve_try(t, pos);
                self.unify_at(t.result, found, no_pos());
            },
            Action::Component(c) => self.component(c, pos),
            Action::CallValue(c) => self.call_known(c, pos),
            Action::Method(m) => {
                let found = self.resolve_method(m.call, m.receiver, m.name, m.actual, m.got);
                self.unify_at(m.result, found, pos);
            },
            Action::EnumOperand(operand) => {
                self.require_visible_shape(operand, pos);
                match self.shape(operand, pos) {
                    Type::Enum(_v) => (),
                    _ => self.fails("enum_variant requires an enum operand", pos),
                }
            },
            Action::Pointer(p) => self.pointer_known(p, pos),
        }
    }

    fn unify_at(self, a: Type, b: Type, pos: Pos) {
        if !unify(a, b, false, self.inf.counter) {
            self.fail(Out::new().put("type mismatch: ").add(show(zonk(a))).put(" and ").add(show(zonk(b))).done(), pos);
        }
        self.solve();
    }

    fn coerce(self, actual: Type, expected: Option[Type], pos: Pos) {
        let unit = match expected {
            Option::Some(want) => if !is_never(actual) {
                self.unify_at(actual, want, pos);
            },
            Option::None => (),
        };
    }

    fn join(self, a: Type, b: Type, pos: Pos) -> Type {
        if is_never(a) {
            return b;
        }
        if !is_never(b) {
            self.unify_at(a, b, pos);
        }
        a
    }

    // The structure of `ty`, needed now: a type still unknown takes its defaults, else it is an error.
    fn shape(self, ty: Type, pos: Pos) -> Type {
        if is_unsolved(ty) {
            self.solve();
            self.run_defaults();
        }
        let ty = zonk(ty);
        match ty {
            Type::Meta(_m) => self.fails("the type here is not known yet; annotate it", pos),
            Type::Named(name, _args) => if self.inf.types.program.types.has(name) {
                self.inf.types.shape(ty, Option::None)
            } else {
                ty
            },
            Type::Foreach(_f) => self.inf.types.shape(ty, Option::None),
            _ => ty,
        }
    }

    // ---- premises
    // Check nominal authority at shape-using source operations, not type uses.
    fn require_visible_shape(self, ty: Type, pos: Pos) {
        let unit = match prune(ty) {
            Type::Named(name, _args) => match self.inf.types.program.types.get(name) {
                Option::Some(decl) => if !self.inf.types.is_exposed(decl, Option::Some.(self.home)) {
                    self.fail(Out::new().put("the shape of ").add(name).put(" is not exposed here").done(), pos);
                },
                Option::None => (),
            },
            _ => (),
        };
    }

    fn require_copy(self, ty: Type, pos: Pos) {
        self.wait(Ready::Ground.(Seq::one(ty), 1usize), Action::Copy.(ty), pos);
    }

    fn require_parameter_kinds(self, params: Seq[Param], sub: Map[Text, Type], pos: Pos) {
        var i = 0usize;
        while i < params.len() {
            let p = params.get(i);
            if is_copy_kind(p.kind) {
                self.require_copy(sub.at(p.name), pos);
            }
            i = i + 1usize;
        }
    }

    // Discharge a premise once its input arguments are known.
    fn require(self, trait_name: Text, args: Seq[Type], pos: Pos) {
        let n = self.inf.inputs.get_or(trait_name, args.len());
        self.wait(Ready::Ground.(args, n), Action::Discharge.(trait_name, args, n), pos);
    }

    // An assumption or a unique matching instance solves the output arguments.
    fn discharge(self, trait_name: Text, args: Seq[Type], n: usize, pos: Pos) {
        if trait_name.is("builtin::Exposed") {
            if args.len() != 1usize || !self.inf.types.exposure_available(zonk(args.get(0usize)), Option::Some.(self.home), self.kinds, self.assumptions) {
                self.fails("Exposed requires an exact premise or an authorized traversable shape", pos);
            }
            return;
        }
        let count = if n < args.len() { n } else { args.len() };
        let inputs: Seq[Type] = Seq::new();
        var i = 0usize;
        while i < count {
            inputs.push(zonk(args.get(i)));
            i = i + 1usize;
        }
        i = 0usize;
        while i < self.assumptions.len() {
            let p = self.assumptions.get(i);
            if p.trait_name.eq(trait_name) && p.args.len() == args.len() {
                var matches = true;
                var k = 0usize;
                while matches && k < count {
                    matches = equal(zonk(p.args.get(k)), inputs.get(k));
                    k = k + 1usize;
                }
                if matches {
                    k = count;
                    while k < args.len() {
                        self.unify_at(p.args.get(k), args.get(k), pos);
                        k = k + 1usize;
                    }
                    return;
                }
            }
            i = i + 1usize;
        }
        let found: Seq[(InstanceSig, Map[Text, Type])] = Seq::new();
        let candidates = self.inf.instances.get_or(trait_name, Seq::new());
        i = 0usize;
        while i < candidates.len() {
            let inst = candidates.get(i);
            let head_count = if count < inst.head.len() { count } else { inst.head.len() };
            let unit = match match_head(inst.params, inst.head.slice(0usize, head_count), inputs, false, self.inf.counter) {
                Option::Some(sub) => if self.copy_ok(inst, sub) {
                    found.push((inst, sub));
                },
                Option::None => (),
            };
            i = i + 1usize;
        }
        if found.len() != 1usize {
            let shown = Out::new().put(if found.is_empty() { "no" } else { "several" }).put(" instance of ").add(trait_name).put("[");
            var k = 0usize;
            while k < args.len() {
                if k > 0usize {
                    let unit = shown.put(", ");
                }
                let unit = shown.add(show(zonk(args.get(k))));
                k = k + 1usize;
            }
            self.fail(shown.put("]").done(), pos);
        }
        let (inst, sub) = found.get(0usize);
        i = 0usize;
        while i < inst.params.len() {
            let p = inst.params.get(i);
            if !sub.has(p.name) {
                sub.set(p.name, meta_of(p.kind));
            }
            i = i + 1usize;
        }
        i = 0usize;
        while i < inst.head.len() && i < args.len() {
            self.unify_at(subst(inst.head.get(i), sub, self.inf.counter), args.get(i), pos);
            i = i + 1usize;
        }
        i = 0usize;
        while i < inst.premises.len() {
            let premise = inst.premises.get(i);
            self.require(premise.trait_name, self.subst_all(premise.args, sub), pos);
            i = i + 1usize;
        }
    }

    fn copy_ok(self, inst: InstanceSig, sub: Map[Text, Type]) -> bool {
        var i = 0usize;
        while i < inst.params.len() {
            let p = inst.params.get(i);
            if is_copy_kind(p.kind) {
                let unit = match sub.get(p.name) {
                    Option::Some(t) => if !self.inf.types.is_copy(t, self.kinds) {
                        return false;
                    },
                    Option::None => (),
                };
            }
            i = i + 1usize;
        }
        true
    }

    fn subst_all(self, ts: Seq[Type], sub: Map[Text, Type]) -> Seq[Type] {
        let out: Seq[Type] = Seq::new();
        var i = 0usize;
        while i < ts.len() {
            out.push(subst(ts.get(i), sub, self.inf.counter));
            i = i + 1usize;
        }
        out
    }

    // ---- scopes
    fn record(self, id: u32, pos: Pos, ty: Type) -> Type {
        self.inf.out.types.set(id, ty);
        self.check_brand_scope(ty, pos);
        self.recorded.push(id);
        ty
    }

    fn library(self, name: Slice[u8, 'static]) -> Text {
        self.inf.sigs.name(self.inf.sigs.library(self.home, text(name)))
    }

    fn lookup(self, name: Text) -> Option[Local] {
        var i = self.scopes.len();
        while i > 0usize {
            i = i - 1usize;
            let unit = match self.scopes.get(i).names.get(name) {
                Option::Some(local) => {
                    // every closure it is used inside captures it
                    var f = local.depth + 1usize;
                    while f < self.frames.len() {
                        let frame = self.frames.get(f);
                        var seen = false;
                        var k = 0usize;
                        while !seen && k < frame.locals.len() {
                            let (_n, l) = frame.locals.get(k);
                            seen = l.id == local.id;
                            k = k + 1usize;
                        }
                        if !seen {
                            frame.locals.push((name, local));
                        }
                        f = f + 1usize;
                    }
                    return Option::Some.(local);
                },
                Option::None => (),
            };
        }
        Option::None
    }

    fn bind(self, name: Text, ty: Type, mutable: bool, rest: Option[Bundle]) -> Local {
        self.check_brand_scope(ty, no_pos());
        let local = Local.{ type: ty, mutable, rest, depth: self.frames.len() - 1usize, id: self.inf.next_id() };
        self.scopes.last().names.set(name, local);
        local
    }

    fn brand_sub(self) -> Map[Text, Type] {
        let out: Map[Text, Type] = Map::new();
        var i = 0usize;
        while i < self.scopes.len() {
            let level = self.scopes.get(i);
            let names = level.brands.keys();
            var k = 0usize;
            while k < names.len() {
                out.set(names.get(k), Type::Skolem.(level.brands.at(names.get(k))));
                k = k + 1usize;
            }
            i = i + 1usize;
        }
        out
    }

    fn leave(self) {
        let level = self.scopes.pop();
        if level.opened.len() != 0usize {
            self.allowed.set(Option::None);
        }
    }

    // Checked after solving: an outer metavariable may acquire a local brand later.
    fn check_brand_scope(self, ty: Type, pos: Pos) {
        let unit = match self.allowed.get() {
            Option::Some(allowed) => {
                self.brand_checks.push((ty, allowed, pos));
                return;
            },
            Option::None => (),
        };
        let allowed: Set[Text] = Set::new();
        var i = 0usize;
        while i < self.sig.params.len() {
            if is_brand(self.sig.params.get(i).kind) {
                allowed.add(self.sig.params.get(i).name);
            }
            i = i + 1usize;
        }
        allowed.add(text("static"));
        i = 0usize;
        while i < self.scopes.len() {
            let opened = self.scopes.get(i).opened.items();
            var k = 0usize;
            while k < opened.len() {
                allowed.add(opened.get(k));
                k = k + 1usize;
            }
            i = i + 1usize;
        }
        self.allowed.set(Option::Some.(allowed));
        self.brand_checks.push((ty, allowed, pos));
    }

    fn core_type(self, type_expr: S::Type) -> Type {
        let scope = new_scope();
        var i = 0usize;
        while i < self.sig.params.len() {
            let p = self.sig.params.get(i);
            if is_brand(p.kind) {
                scope.brands.add(p.name);
            } else {
                scope.kinds.set(p.name, p.kind);
            }
            i = i + 1usize;
        }
        let sub = self.brand_sub();
        let names = sub.keys();
        i = 0usize;
        while i < names.len() {
            scope.brands.add(names.get(i));
            i = i + 1usize;
        }
        subst(self.inf.sigs.got(self.inf.sigs.type(type_expr, scope)), sub, self.inf.counter)
    }

    fn opt_type(self, t: Option[S::Type]) -> Option[Type] {
        match t {
            Option::Some(x) => Option::Some.(self.core_type(x)),
            Option::None => Option::None,
        }
    }

    // ---- statements
    fn block(self, b: S::Block) -> Type {
        self.scopes.push(new_level());
        var diverges = false;
        var i = 0usize;
        while i < b.stmts.len() {
            if self.stmt(b.stmts.get(i)) {
                diverges = true;
            }
            i = i + 1usize;
        }
        let ty = match b.tail {
            Option::Some(tail) => self.expr(tail.get()),
            Option::None => if diverges { Type::Never } else { C::unit() },
        };
        self.leave();
        self.record(b.id, b.pos, ty)
    }

    // Type one statement; true when it cannot complete normally.
    fn stmt(self, s: Statement) -> bool {
        match s {
            Statement::Let(l) => {
                if !l.brands.is_empty() {
                    return self.let_exists(l);
                }
                let want = self.opt_type(l.type);
                self.generic(l.value, want);
                let got = self.check(l.value, want);
                self.pattern(l.pattern, match want {
                    Option::Some(t) => t,
                    Option::None => got,
                }, l.pos, false);
                is_never(got)
            },
            Statement::Var(v) => {
                let want = self.opt_type(v.type);
                self.generic(v.value, want);
                let got = self.check(v.value, want);
                let local = self.bind(v.name, match want {
                    Option::Some(t) => t,
                    Option::None => got,
                }, true, Option::None);
                self.results().binders.set(v.id, local.id);
                false
            },
            Statement::Const(c) => {
                let value = self.inf.sigs.got(self.inf.sigs.typed(c.name, c.value, self.core_type(c.type), self.home));
                self.results().folded.set(c.id, value);
                let ty = match const_type(value) {
                    Option::Some(t) => t,
                    Option::None => self.fails("internal error: an untyped local constant", c.pos),
                };
                self.results().binders.set(c.id, self.bind(c.name, ty, false, Option::None).id);
                false
            },
            Statement::Assign(a) => {
                let target = self.place_type(a.target, true);
                let unit = self.check(a.value, Option::Some.(target));
                false
            },
            Statement::Expr(n) => is_never(self.expr(n.value)),
        }
    }

    // A bare function name bound with no annotation keeps its quantified brands.
    fn generic(self, value: Expr, want: Option[Type]) {
        if want.is_none() {
            let unit = match value {
                Expr::Path(p) => self.inf.generic.add(p.id),
                _ => (),
            };
        }
    }

    fn let_exists(self, l: S::Let) -> bool {
        let package = self.shape(self.expr(l.value), l.pos);
        let opened = match package {
            Type::Exists(binders, body) => if binders.len() == l.brands.len() { Option::Some.((binders, body.get())) } else { Option::None },
            _ => Option::None,
        };
        let (binders, body) = match opened {
            Option::Some(pair) => pair,
            Option::None => self.fail(Out::new().put("let exists opens ").usize(l.brands.len()).put(" brands of ").add(show(zonk(package))).done(), l.pos),
        };
        let names: Seq[Text] = Seq::new();
        let distinct: Set[Text] = Set::new();
        var i = 0usize;
        while i < l.brands.len() {
            let name = l.brands.get(i).from(1usize);
            names.push(name);
            distinct.add(name);
            i = i + 1usize;
        }
        if distinct.len() != names.len() {
            self.fails("an existential opening repeats a brand name", l.pos);
        }
        let labels: Seq[Text] = Seq::new();
        let level = self.scopes.last();
        let sub: Map[Text, Type] = Map::new();
        i = 0usize;
        while i < names.len() {
            let label = Out::new().add(names.get(i)).put("#open").u64(self.inf.next_id() as u64).done();
            labels.push(label);
            level.brands.set(names.get(i), label);
            level.opened.add(label);
            self.allowed.set(Option::None);
            sub.set(binders.get(i), Type::Skolem.(label));
            i = i + 1usize;
        }
        self.results().opened.set(l.id, labels);
        let payload = subst(body, sub, self.inf.counter);
        let unit = match l.type {
            Option::Some(t) => self.unify_at(payload, self.core_type(t), l.pos),
            Option::None => (),
        };
        self.pattern(l.pattern, payload, l.pos, false);
        false
    }

    fn pattern(self, p: Pattern, ty: Type, pos: Pos, mutable: bool) {
        let id = S::pattern_id(p);
        self.results().types.set(id, ty);
        self.recorded.push(id);
        match p {
            Pattern::Bind(n) => self.results().binders.set(n.id, self.bind(n.value, ty, mutable, Option::None).id),
            Pattern::Wild(_id) => (),
            Pattern::Tuple(n) => self.elements_pattern(false, n.value, ty, pos, mutable),
            Pattern::Array(n) => self.elements_pattern(true, n.value, ty, pos, mutable),
            Pattern::Struct(ps) => {
                // the names are bound now, their types related when known
                let metas: Map[Text, Type] = Map::new();
                var i = 0usize;
                while i < ps.fields.len() {
                    metas.set(ps.fields.get(i).name, new_meta());
                    i = i + 1usize;
                }
                let bundle = Bundle.{ types: Map::new(), filled: Cell::new(false) };
                self.later(ty, Action::Fields.(Fields.{ ty, metas, bundle }), pos);
                i = 0usize;
                while i < ps.fields.len() {
                    let f = ps.fields.get(i);
                    self.pattern(f.pattern, metas.at(f.name), pos, mutable);
                    i = i + 1usize;
                }
                let unit = match ps.rest {
                    Option::Some(rest) => self.results().rest_ids.set(ps.id, self.bind(rest, C::unit(), false, Option::Some.(bundle)).id),
                    Option::None => (),
                };
            },
        }
    }

    fn elements_pattern(self, array: bool, elems: Seq[Pattern], ty: Type, pos: Pos, mutable: bool) {
        let types: Seq[Type] = Seq::new();
        var i = 0usize;
        while i < elems.len() {
            types.push(new_meta());
            i = i + 1usize;
        }
        self.later(ty, Action::Elements.(Elements.{ array, ty, types }), pos);
        i = 0usize;
        while i < elems.len() {
            self.pattern(elems.get(i), types.get(i), pos, mutable);
            i = i + 1usize;
        }
    }

    fn elements(self, e: Elements, pos: Pos) {
        self.require_visible_shape(e.ty, pos);
        let s = self.shape(e.ty, pos);
        let actual: Seq[Type] = Seq::new();
        let fits = if e.array {
            match s {
                Type::Array(elem, length) => if length == e.types.len() as u64 {
                    var i = 0usize;
                    while i < e.types.len() {
                        actual.push(elem.get());
                        i = i + 1usize;
                    }
                    true
                } else {
                    false
                },
                _ => false,
            }
        } else {
            match s {
                Type::Tuple(elems) => if elems.len() == e.types.len() {
                    actual.append(elems);
                    true
                } else {
                    false
                },
                _ => false,
            }
        };
        if !fits {
            self.fail(Out::new().put("pattern does not match ").add(show(zonk(e.ty))).done(), pos);
        }
        var i = 0usize;
        while i < actual.len() {
            self.unify_at(e.types.get(i), actual.get(i), pos);
            i = i + 1usize;
        }
    }

    fn fields_known(self, f: Fields, pos: Pos) {
        self.require_visible_shape(f.ty, pos);
        let fields = match self.shape(f.ty, pos) {
            Type::Struct(fields) => fields,
            _ => self.fail(Out::new().put("a struct pattern needs a struct, not ").add(show(zonk(f.ty))).done(), pos),
        };
        let by_name: Map[Text, Type] = Map::new();
        var i = 0usize;
        while i < fields.len() {
            by_name.set(fields.get(i).name, fields.get(i).type);
            i = i + 1usize;
        }
        let names = f.metas.keys();
        i = 0usize;
        while i < names.len() {
            let name = names.get(i);
            let have = match by_name.get(name) {
                Option::Some(t) => t,
                Option::None => self.fail(Out::new().put("no field ").add(name).done(), pos),
            };
            self.unify_at(f.metas.at(name), have, pos);
            i = i + 1usize;
        }
        i = 0usize;
        while i < fields.len() {
            if !f.metas.has(fields.get(i).name) {
                f.bundle.types.set(fields.get(i).name, fields.get(i).type);
            }
            i = i + 1usize;
        }
        f.bundle.filled.set(true);
    }

    // ---- expressions
    fn check(self, e: Expr, expected: Option[Type]) -> Type {
        let ty = self.expr(e);
        self.coerce(ty, expected, S::expr_pos(e));
        ty
    }

    fn expr(self, e: Expr) -> Type {
        let ty = self.infer_expr(e);
        self.record(S::expr_id(e), S::expr_pos(e), ty)
    }

    fn infer_expr(self, e: Expr) -> Type {
        match e {
            Expr::While(w) => self.apply(Seq::two((w.cond.get(), Pat::Bool), (Expr::Block.(w.body), Pat::Unit)), Pat::Unit, w.pos),
            Expr::If(n) => match n.other {
                Option::None => self.apply(Seq::two((n.cond.get(), Pat::Bool), (Expr::Block.(n.then), Pat::Unit)), Pat::Unit, n.pos),
                Option::Some(other) => {
                    let parts = Seq::two((n.cond.get(), Pat::Bool), (Expr::Block.(n.then), Pat::T));
                    parts.push((other.get(), Pat::T));
                    self.apply(parts, Pat::T, n.pos)
                },
            },
            Expr::Binop(b) => {
                if b.op.is("&&") || b.op.is("||") {
                    return self.apply(Seq::two((b.left.get(), Pat::Bool), (b.right.get(), Pat::Bool)), Pat::Bool, b.pos);
                }
                let result = self.apply(Seq::two((b.left.get(), Pat::T), (b.right.get(), Pat::T)), if is_comparison(b.op) { Pat::Bool } else { Pat::T }, b.pos);
                let left = self.type_of(S::expr_id(b.left.get()));
                let operand = if is_never(left) { self.type_of(S::expr_id(b.right.get())) } else { left };
                self.require_primitive(b.op, operand, b.pos, false);
                result
            },
            Expr::Unary(u) => if u.op.is("&") {
                self.expr_unary(u)
            } else {
                let result = self.apply(Seq::one((u.operand.get(), if u.op.is("*") { Pat::PtrT } else { Pat::T })), Pat::T, u.pos);
                if u.op.is("-") || u.op.is("!") {
                    self.require_primitive(u.op, self.type_of(S::expr_id(u.operand.get())), u.pos, true);
                }
                result
            },
            Expr::UnsafeStore(s) => self.apply(Seq::two((s.pointer.get(), Pat::PtrT), (s.value.get(), Pat::T)), Pat::Unit, s.pos),
            Expr::Lit(l) => self.expr_lit(l),
            Expr::FStr(f) => self.expr_fstring(f),
            Expr::Path(p) => self.expr_path(p),
            Expr::Tuple(n) => {
                let elems: Seq[Type] = Seq::new();
                var i = 0usize;
                while i < n.value.len() {
                    elems.push(self.expr(n.value.get(i)));
                    i = i + 1usize;
                }
                Type::Tuple.(elems)
            },
            Expr::Array(a) => self.expr_array(a),
            Expr::Sizeof(n) => {
                self.results().targets.set(n.id, self.core_type(n.value));
                C::usize_type()
            },
            Expr::StructLit(s) => self.expr_struct_lit(s),
            Expr::Block(b) => self.block(b),
            Expr::For(f) => self.expr_for(f),
            Expr::Return(n) => {
                let unit = match n.value {
                    Option::Some(v) => {
                        let unit = self.check(v.get(), Option::Some.(self.returns.last()));
                    },
                    Option::None => self.coerce(C::unit(), Option::Some.(self.returns.last()), n.pos),
                };
                Type::Never
            },
            Expr::Match(m) => self.expr_match(m),
            Expr::Closure(c) => self.expr_closure(c),
            Expr::Pack(p) => self.expr_pack(p),
            Expr::Foreach(f) => self.expr_foreach(f),
            Expr::Cast(c) => {
                let unit = self.expr(c.value.get());
                self.core_type(c.type)
            },
            Expr::Field(f) => self.projection(f.value.get(), Option::Some.(f.name), 0usize, f.id, f.pos, false),
            Expr::Index(x) => self.projection(x.value.get(), Option::None, x.index, x.id, x.pos, false),
            Expr::Try(n) => {
                let operand = self.expr(n.value.get());
                let returned = self.returns.last();
                let result = new_meta();
                self.wait(Ready::Both.(operand, returned), Action::Try.(TryWait.{ id: n.id, operand, returned, result }), n.pos);
                result
            },
            Expr::Call(c) => self.expr_call(c),
        }
    }

    // Primitive applicability waits for inference, without unfolding nominal types.
    fn require_primitive(self, op: Text, operand: Type, pos: Pos, unary: bool) {
        if is_never(operand) {
            // No operand value reaches this operation.
            return;
        }
        self.later(operand, Action::Primitive.(op, operand, unary), pos);
    }

    fn primitive(self, op: Text, operand: Type, unary: bool, pos: Pos) {
        let ty = zonk(operand);
        let (prim, integer, numeric, boolean) = match ty {
            Type::Prim(name) => (true, C::is_integer(name), C::is_integer(name) || C::is_float(name), name.is("bool")),
            _ => (false, false, false, false),
        };
        let pointer = match ty {
            Type::Ptr(_i) => true,
            _ => false,
        };
        let valid = if unary {
            if op.is("-") { numeric } else { integer || boolean }
        } else if op.is("==") || op.is("!=") {
            prim || pointer
        } else if op.is("%") || op.is("&") || op.is("|") || op.is("^") || op.is("<<") || op.is(">>") {
            integer
        } else {
            numeric
        };
        if !valid {
            self.fail(Out::new().put("operator ").add(op).put(" is not defined for ").add(show(ty)).done(), pos);
        }
    }

    fn pat_type(self, p: Pat, t: Cell[Option[Type]]) -> Type {
        match p {
            Pat::Bool => C::bool_type(),
            Pat::Unit => C::unit(),
            Pat::T => match t.get() {
                Option::Some(v) => v,
                Option::None => {
                    let v = new_meta();
                    t.set(Option::Some.(v));
                    v
                },
            },
            Pat::PtrT => C::ptr(self.pat_type(Pat::T, t)),
        }
    }

    // Each premise pairs an expression with a type pattern; `t` is shared by the rule.
    fn apply(self, premises: Seq[(Expr, Pat)], result: Pat, pos: Pos) -> Type {
        let t: Cell[Option[Type]] = Cell::new(Option::None);
        var i = 0usize;
        while i < premises.len() {
            let (child, p) = premises.get(i);
            let got = self.expr(child);
            // a child that diverges fits anywhere
            if !is_never(got) {
                self.unify_at(got, self.pat_type(p, t), pos);
            }
            i = i + 1usize;
        }
        match result {
            Pat::T => match t.get() {
                Option::Some(v) => v,
                Option::None => Type::Never,
            },
            _ => self.pat_type(result, t),
        }
    }

    fn literal(self, kind: MetaKind, pos: Pos) -> Type {
        let m = Meta::new(kind);
        m.set_pos(pos);
        self.literals.push(m);
        Type::Meta.(m)
    }

    fn expr_lit(self, l: S::Lit) -> Type {
        match l.kind {
            S::LitKind::Int => match l.suffix {
                Option::Some(suffix) => Type::Prim.(suffix),
                Option::None => self.literal(MetaKind::Int, l.pos),
            },
            S::LitKind::Float => match l.suffix {
                Option::Some(suffix) => Type::Prim.(suffix),
                Option::None => self.literal(MetaKind::Float, l.pos),
            },
            S::LitKind::Bool => C::bool_type(),
            S::LitKind::Str => C::named(self.library("Slice"), Seq::two(C::prim("u8"), Type::Skolem.(text("static")))),
        }
    }

    fn expr_fstring(self, f: S::FStr) -> Type {
        var i = 0usize;
        while i < f.parts.len() {
            let unit = match f.parts.get(i) {
                S::Piece::Expr(part) => {
                    let operand = match part {
                        Expr::Unary(u) => if u.op.is("&") { u.operand.get() } else { part },
                        _ => part,
                    };
                    let unit = self.expr(operand);
                },
                S::Piece::Text(_t) => (),
            };
            i = i + 1usize;
        }
        C::named(self.library("Buffer"), Seq::new())
    }

    fn expr_path(self, p: S::Path) -> Type {
        let r = self.inf.r.refs.get(p.id);
        let unit = match r {
            Option::Some(r) => match r {
                NameRef::Local(name) => {
                    if has_args(p) {
                        self.fails("explicit type arguments on local values are not supported; specialize the named function before binding", p.pos);
                    }
                    let local = match self.lookup(name) {
                        Option::Some(l) => l,
                        Option::None => self.fail(Out::new().put("unknown local ").add(name).done(), p.pos),
                    };
                    if local.rest.is_some() {
                        self.fail(Out::new().add(name).put(" is a ..rest bundle, not a value").done(), p.pos);
                    }
                    self.results().binders.set(p.id, local.id);
                    return local.type;
                },
                NameRef::Decl(decl) => {
                    if decl.kind.is("const") {
                        if has_args(p) {
                            self.fails("constant paths take no type arguments", p.pos);
                        }
                        let value = self.inf.sigs.got(self.inf.sigs.const_decl(decl));
                        self.results().folded.set(p.id, value);
                        let ty = match const_type(value) {
                            Option::Some(t) => t,
                            Option::None => self.fails("internal error: an untyped constant", p.pos),
                        };
                        return ty;
                    }
                    if decl.kind.is("fn") || decl.kind.is("method") || decl.kind.is("extern") {
                        return self.function_value(p, self.inf.sigs.sigs.at(decl.id));
                    }
                },
                NameRef::Variant(enum_decl, name) => return self.variant(p, enum_decl, name, Option::None),
                _ => (),
            },
            Option::None => (),
        };
        self.fail(Out::new().add(joined_names(p.names())).put(" is not a value").done(), p.pos)
    }

    // A named function keeps its declared parameter modes and result type. Bare names bound by let
    // retain unconstrained brand quantifiers; other parameters are instantiated at the occurrence.
    fn function_value(self, p: S::Path, sig: Sig) -> Type {
        let retain = self.inf.generic.has(p.id) && !has_args(p);
        let kept: Seq[Param] = Seq::new();
        let fresh: Seq[Param] = Seq::new();
        var i = 0usize;
        while i < sig.params.len() {
            let param = sig.params.get(i);
            var keep = retain && is_brand(param.kind);
            var k = 0usize;
            while keep && k < sig.premises.len() {
                let args = sig.premises.get(k).args;
                var a = 0usize;
                while keep && a < args.len() {
                    keep = !free_names(zonk(args.get(a))).has(param.name);
                    a = a + 1usize;
                }
                k = k + 1usize;
            }
            if keep {
                kept.push(param);
            } else {
                fresh.push(param);
            }
            i = i + 1usize;
        }
        let sub = instantiate(fresh);
        self.explicit_args(p, sig, sub);
        self.results().calls.set(p.id, Callee::Fn.(FnCall.{ sig, sub, receiver: Option::None }));
        self.require_signature(sig, sub, p.pos);
        C::fn_type(self.subst_all(sig.ptypes, sub), subst(sig.ret, sub, self.inf.counter), kept, sig.is_unsafe, sig.places)
    }

    // Type arguments written on a callee path: on its last segment, the function's own; on the type
    // segment of `Type[A]::f`, its impl's.
    fn explicit_args(self, path: S::Path, sig: Sig, sub: Map[Text, Type]) {
        let segments = path.segments;
        let count = segments.len();
        let impl_block = match sig.decl {
            Option::Some(d) => if d.kind.is("method") { d.impl_block } else { Option::None },
            Option::None => Option::None,
        };
        let own = segments.get(count - 1usize).args;
        var index = 0usize;
        while index + 1usize < count {
            if !segments.get(index).args.is_empty() && !(index + 2usize == count && impl_block.is_some()) {
                self.fails("function type arguments cannot appear on a namespace", path.pos);
            }
            index = index + 1usize;
        }
        let impl_params = match impl_block {
            Option::Some(b) => match b.quantifier {
                Option::Some(f) => f.params.len() + f.determined.len(),
                Option::None => 0usize,
            },
            Option::None => 0usize,
        };
        if !own.is_empty() {
            let explicit: Seq[Param] = Seq::new();
            var i = 0usize;
            while i < sig.params.len() {
                if !sig.params.get(i).name.starts_with(text("Env#")) {
                    explicit.push(sig.params.get(i));
                }
                i = i + 1usize;
            }
            let split = if impl_params < explicit.len() { impl_params } else { explicit.len() };
            let mine = explicit.from(split);
            let outer = explicit.slice(0usize, split);
            let params = if mine.len() == own.len() {
                mine
            } else if outer.len() + mine.len() == own.len() {
                explicit
            } else if outer.len() == own.len() {
                outer
            } else {
                self.fail(Out::new().add(segments.get(count - 1usize).name).put(" takes ").usize(mine.len()).put(" type arguments").done(), path.pos)
            };
            i = 0usize;
            while i < params.len() {
                let a = own.get(i);
                let skipped = match a {
                    S::Type::Ignored => true,
                    S::Type::Brand(b) => b.is("'_"),
                    _ => false,
                };
                if !skipped && sub.has(params.get(i).name) {
                    self.unify_at(sub.at(params.get(i).name), self.core_type(a), path.pos);
                }
                i = i + 1usize;
            }
        }
        if count >= 2usize && !segments.get(count - 2usize).args.is_empty() {
            let unit = match impl_block {
                Option::Some(b) => {
                    let (_params, _premises, scope) = self.inf.sigs.quantifier(b.quantifier, new_scope());
                    let target = self.inf.sigs.got(self.inf.sigs.type(b.type, scope));
                    let (name, args) = match target {
                        Type::Named(name, args) => (name, args),
                        _ => self.fails("type arguments on a method path need a named impl target", path.pos),
                    };
                    let names = path.names();
                    let same = match self.inf.r.need(self.home, names.slice(0usize, names.len() - 1usize), path.pos) {
                        Target::Decl(owner) => self.inf.sigs.name(owner).eq(name),
                        _ => false,
                    };
                    if !same {
                        self.fails("method type arguments belong on the impl type, not a namespace", path.pos);
                    }
                    let written = segments.get(count - 2usize).args;
                    if written.len() != args.len() {
                        self.fail(Out::new().put("the impl type qualifier takes ").usize(args.len()).put(" type arguments").done(), path.pos);
                    }
                    let given: Seq[Type] = Seq::new();
                    var i = 0usize;
                    while i < written.len() {
                        given.push(self.core_type(written.get(i)));
                        i = i + 1usize;
                    }
                    self.unify_at(subst(target, sub, self.inf.counter), C::named(name, given), path.pos);
                },
                Option::None => (),
            };
        }
    }

    // Arguments belong on the declaration name, before a variant or method if present.
    fn path_arguments(self, path: S::Path, declaration: Decl, member: bool) -> Seq[S::Type] {
        let count = path.segments.len();
        let drop = if member { 2usize } else { 1usize };
        let owner = if count >= drop { Option::Some.(count - drop) } else { Option::None };
        var i = 0usize;
        while i < count {
            let at_owner = match owner {
                Option::Some(o) => o == i,
                Option::None => false,
            };
            if !path.segments.get(i).args.is_empty() && !at_owner {
                self.fail(Out::new().put("type arguments belong on ").add(declaration.name).put(", not a namespace or member").done(), path.pos);
            }
            i = i + 1usize;
        }
        let written = match owner {
            Option::Some(o) => path.segments.get(o).args,
            Option::None => Seq::new(),
        };
        if member && !written.is_empty() {
            let names = path.names();
            let same = match self.inf.r.need(self.home, names.slice(0usize, names.len() - 1usize), path.pos) {
                Target::Decl(d) => d.id == declaration.id,
                _ => false,
            };
            if !same {
                self.fail(Out::new().put("type arguments belong on ").add(declaration.name).put(", not a namespace").done(), path.pos);
            }
        }
        written
    }

    // The type a struct, tuple or enum is built at: its parameters instantiated, and any written ones
    // applied.
    fn construct(self, pos: Pos, decl: Decl, written: Seq[S::Type]) -> (TypeDecl, Map[Text, Type], Type) {
        let td = self.inf.sigs.types.at(self.inf.sigs.name(decl));
        self.require_visible_shape(C::named(td.name, Seq::new()), pos);
        if written.len() > td.params.len() {
            self.fail(Out::new().add(td.name).put(" accepts at most ").usize(td.params.len()).put(" type arguments, got ").usize(written.len()).done(), pos);
        }
        let sub = instantiate(td.params);
        var i = 0usize;
        while i < written.len() {
            self.unify_at(sub.at(td.params.get(i).name), self.core_type(written.get(i)), pos);
            i = i + 1usize;
        }
        self.require_parameter_kinds(td.params, sub, pos);
        let args: Seq[Type] = Seq::new();
        i = 0usize;
        while i < td.params.len() {
            args.push(sub.at(td.params.get(i).name));
            i = i + 1usize;
        }
        (td, sub, C::named(td.name, args))
    }

    fn payload_of(self, td: TypeDecl, name: Text, sub: Map[Text, Type]) -> Type {
        let variants = match td.body {
            Type::Enum(variants) => variants,
            _ => self.fails("internal error: a variant of a type that is not an enum", no_pos()),
        };
        var i = 0usize;
        while i < variants.len() {
            if variants.get(i).name.eq(name) {
                return subst(variants.get(i).type, sub, self.inf.counter);
            }
            i = i + 1usize;
        }
        self.fails("internal error: an unknown variant", no_pos())
    }

    fn variant(self, path: S::Path, enum_decl: Decl, name: Text, payload_args: Option[Seq[Expr]]) -> Type {
        let (td, sub, result) = self.construct(path.pos, enum_decl, self.path_arguments(path, enum_decl, true));
        let payload = self.payload_of(td, name, sub);
        self.results().calls.set(path.id, Callee::Variant.(name));
        let unit = match payload_args {
            Option::None => if !C::same(payload, C::unit()) {
                self.fail(Out::new().put("variant ").add(name).put(" carries a payload").done(), path.pos);
            },
            Option::Some(args) => if args.len() == 1usize {
                let unit = self.check(args.get(0usize), Option::Some.(payload));
            } else {
                let elems = match payload {
                    Type::Tuple(elems) => if elems.len() == args.len() { Option::Some.(elems) } else { Option::None },
                    _ => Option::None,
                };
                match elems {
                    Option::Some(types) => {
                        var i = 0usize;
                        while i < args.len() {
                            let unit = self.check(args.get(i), Option::Some.(types.get(i)));
                            i = i + 1usize;
                        }
                    },
                    Option::None => self.fail(Out::new().put("variant ").add(name).put(" takes one payload").done(), path.pos),
                }
            },
        };
        result
    }

    fn expr_array(self, a: S::ArrayLit) -> Type {
        let elem = new_meta();
        var i = 0usize;
        while i < a.elems.len() {
            let unit = self.check(a.elems.get(i), Option::Some.(elem));
            i = i + 1usize;
        }
        if !a.fill {
            return Type::Array.(Cell::new(elem), a.elems.len() as u64);
        }
        // `[x, ..]` gets its length from the type it is used at
        let result = new_meta();
        self.later(result, Action::Fill.(result, elem), a.pos);
        result
    }

    fn expr_struct_lit(self, s: S::StructLit) -> Type {
        let decl = match self.inf.r.refs.get(s.path.id) {
            Option::Some(r) => match r {
                NameRef::Decl(d) => d,
                _ => self.fails("internal error: a struct literal of something other than a struct", s.pos),
            },
            Option::None => self.fails("internal error: an unresolved struct literal", s.pos),
        };
        let (td, sub, result) = self.construct(s.pos, decl, self.path_arguments(s.path, decl, false));
        let members = match td.body {
            Type::Struct(members) => members,
            _ => self.fails("internal error: a struct literal of something other than a struct", s.pos),
        };
        let fields: Map[Text, Type] = Map::new();
        var i = 0usize;
        while i < members.len() {
            fields.set(members.get(i).name, subst(members.get(i).type, sub, self.inf.counter));
            i = i + 1usize;
        }
        let given: Set[Text] = Set::new();
        let field_ids: Map[Text, u32] = Map::new();
        self.results().field_ids.set(s.id, field_ids);
        i = 0usize;
        while i < s.fields.len() {
            let f = s.fields.get(i);
            if !fields.has(f.name) || given.has(f.name) {
                self.fail(Out::new().put("field ").add(f.name).put(" is unknown or given twice").done(), s.pos);
            }
            given.add(f.name);
            let unit = match f.value {
                Option::Some(v) => {
                    let unit = self.check(v, Option::Some.(fields.at(f.name)));
                },
                Option::None => {
                    let local = match self.lookup(f.name) {
                        Option::Some(l) => l,
                        Option::None => self.fail(Out::new().put("unknown local ").add(f.name).done(), s.pos),
                    };
                    field_ids.set(f.name, local.id);
                    self.unify_at(local.type, fields.at(f.name), s.pos);
                },
            };
            i = i + 1usize;
        }
        let unit = match s.spread {
            Option::Some(spread) => {
                let bundle = match self.lookup(spread) {
                    Option::Some(rest) => match rest.rest {
                        Option::Some(b) => {
                            self.results().spread_ids.set(s.id, rest.id);
                            b
                        },
                        Option::None => self.fail(Out::new().add(spread).put(" is not a ..rest bundle").done(), s.pos),
                    },
                    Option::None => self.fail(Out::new().add(spread).put(" is not a ..rest bundle").done(), s.pos),
                };
                self.wait(Ready::Filled.(bundle), Action::Spread.(Spread.{ spread, fields, given, bundle }), s.pos);
            },
            Option::None => if given.len() != fields.len() {
                let missing: Seq[Text] = Seq::new();
                let names = fields.keys();
                i = 0usize;
                while i < names.len() {
                    if !given.has(names.get(i)) {
                        missing.push(names.get(i));
                    }
                    i = i + 1usize;
                }
                missing.sort(text_before);
                let out = Out::new().put("missing fields [");
                i = 0usize;
                while i < missing.len() {
                    if i > 0usize {
                        let unit = out.put(", ");
                    }
                    let unit = out.add(repr(missing.get(i)));
                    i = i + 1usize;
                }
                self.fail(out.put("]").done(), s.pos);
            },
        };
        result
    }

    fn expr_for(self, f: S::For) -> Type {
        let target = match f.iterator.get() {
            Expr::Unary(u) => if u.op.is("&") { Option::Some.(u.operand.get()) } else { Option::None },
            _ => Option::None,
        };
        let operand = match target {
            Option::Some(t) => t,
            Option::None => self.fails("a for loop lends its iterator: `for x in &it`", f.pos),
        };
        let it = self.place_type(operand, false);
        let item = new_meta();
        let next = TraitCall.{ trait_name: self.library("Iterator"), method: text("next"), targs: Seq::two(it, item), receiver: Option::None };
        self.results().next_calls.set(f.id, next);
        self.require(next.trait_name, next.targs, f.pos);
        let option = C::named(self.library("Option"), Seq::one(item));
        self.results().options.set(f.id, option);
        self.require_visible_shape(option, f.pos);
        self.scopes.push(new_level());
        self.results().binders.set(f.id, self.bind(f.name, item, false, Option::None).id);
        let unit = self.check(Expr::Block.(f.body), Option::Some.(C::unit()));
        self.leave();
        C::unit()
    }

    fn expr_match(self, m: S::Match) -> Type {
        let scrutinee = m.scrutinee.get();
        let place = match scrutinee {
            Expr::Unary(u) => if u.op.is("&") && self.is_place(u.operand.get()) { Option::Some.(u.operand.get()) } else { Option::None },
            _ => Option::None,
        };
        let lent = place.is_some();
        self.results().lent.set(m.id, lent);
        let ty = match place {
            Option::Some(p) => self.place_type(p, false),
            Option::None => self.expr(scrutinee),
        };
        self.later(ty, Action::VisibleShape.(ty), m.pos);
        var result: Option[Type] = Option::None;
        var i = 0usize;
        while i < m.arms.len() {
            let arm = m.arms.get(i);
            self.scopes.push(new_level());
            var k = 0usize;
            while k < arm.cases.len() {
                self.case(arm.cases.get(k), ty, lent, arm.cases.len() == 1usize, m.pos);
                k = k + 1usize;
            }
            let arm_ty = self.expr(arm.body);
            self.leave();
            result = Option::Some.(match result {
                Option::None => arm_ty,
                Option::Some(r) => self.join(r, arm_ty, arm.pos),
            });
            i = i + 1usize;
        }
        match result {
            Option::Some(r) => r,
            Option::None => Type::Never,
        }
    }

    fn case(self, c: S::Case, ty: Type, lent: bool, alone: bool, pos: Pos) {
        let unit = match c.kind {
            S::CaseKind::Wild => return,
            S::CaseKind::Value => {
                self.later(ty, Action::Integer.(ty), pos);
                return;
            },
            S::CaseKind::Variant => (),
        };
        let path = match c.path {
            Option::Some(p) => p,
            Option::None => self.fails("internal error: a variant case without a path", pos),
        };
        let (enum_decl, name) = match self.inf.r.refs.get(path.id) {
            Option::Some(r) => match r {
                NameRef::Variant(d, name) => (d, name),
                _ => self.fails("internal error: a variant case that names no variant", pos),
            },
            Option::None => self.fails("internal error: an unresolved variant case", pos),
        };
        let (td, sub, scrutinee) = self.construct(path.pos, enum_decl, self.path_arguments(path, enum_decl, true));
        self.unify_at(scrutinee, ty, pos);
        let payload = self.payload_of(td, name, sub);
        self.results().types.set(c.id, payload);
        self.recorded.push(c.id);
        let ids: Seq[Option[u32]] = Seq::new();
        self.results().case_binders.set(c.id, ids);
        let binders = match c.binders {
            Option::Some(b) => b,
            Option::None => return,
        };
        if !alone {
            self.fails("a grouped arm binds no payload", pos);
        }
        let types = if binders.len() == 1usize {
            Seq::one(payload)
        } else {
            match payload {
                Type::Tuple(elems) => if elems.len() == binders.len() {
                    elems
                } else {
                    self.fail(Out::new().put("variant ").add(name).put(" does not carry ").usize(binders.len()).put(" values").done(), pos)
                },
                _ => self.fail(Out::new().put("variant ").add(name).put(" does not carry ").usize(binders.len()).put(" values").done(), pos),
            }
        };
        var i = 0usize;
        while i < binders.len() {
            let b = binders.get(i);
            ids.push(if b.is("_") { Option::None } else { Option::Some.(self.bind(b, types.get(i), lent, Option::None).id) });
            i = i + 1usize;
        }
    }

    fn captures(self, frame: Frame) -> Seq[Capture] {
        let out: Seq[Capture] = Seq::new();
        var i = 0usize;
        while i < frame.locals.len() {
            let (name, local) = frame.locals.get(i);
            out.push(Capture.{ name, binder: local.id });
            i = i + 1usize;
        }
        out
    }

    fn expr_closure(self, c: S::Closure) -> Type {
        let params: Seq[Type] = Seq::new();
        let places: Seq[usize] = Seq::new();
        var i = 0usize;
        while i < c.params.len() {
            params.push(match c.params.get(i).type {
                Option::Some(t) => self.core_type(t),
                Option::None => new_meta(),
            });
            if c.params.get(i).lend {
                places.push(i + 1usize);
            }
            i = i + 1usize;
        }
        let ret = match c.ret {
            Option::Some(t) => self.core_type(t),
            Option::None => new_meta(),
        };
        let frame = new_frame();
        self.frames.push(frame);
        self.scopes.push(new_level());
        let ids: Seq[u32] = Seq::new();
        i = 0usize;
        while i < c.params.len() {
            let p = c.params.get(i);
            ids.push(self.bind(p.name, params.get(i), p.lend, Option::None).id);
            i = i + 1usize;
        }
        self.results().param_ids.set(c.id, ids);
        self.returns.push(ret);
        let unit = self.check(c.body.get(), Option::Some.(ret));
        let unit = self.returns.pop();
        self.leave();
        let unit = self.frames.pop();
        self.results().captures.set(c.id, self.captures(frame));
        let env_types: Seq[Type] = Seq::new();
        i = 0usize;
        while i < frame.locals.len() {
            let (_n, l) = frame.locals.get(i);
            env_types.push(l.type);
            i = i + 1usize;
        }
        let env = Type::Tuple.(env_types);
        let code_params = Seq::one(env);
        code_params.append(params);
        let code = C::fn_type(code_params, ret, Seq::new(), false, places);
        Type::Struct.(Seq::two(Member.{ name: text("env"), type: env }, Member.{ name: text("code"), type: code }))
    }

    fn expr_pack(self, p: S::Pack) -> Type {
        let sub = self.brand_sub();
        let witnesses: Seq[Type] = Seq::new();
        let labels: Seq[Text] = Seq::new();
        var i = 0usize;
        while i < p.brands.len() {
            let name = p.brands.get(i).from(1usize);
            var known = name.is("static") || sub.has(name);
            var k = 0usize;
            while !known && k < self.sig.params.len() {
                known = is_brand(self.sig.params.get(k).kind) && self.sig.params.get(k).name.eq(name);
                k = k + 1usize;
            }
            if !known {
                self.fail(Out::new().put("pack brand ").add(name).put(" is not in scope").done(), p.pos);
            }
            i = i + 1usize;
        }
        i = 0usize;
        while i < p.brands.len() {
            let name = p.brands.get(i).from(1usize);
            let witness = sub.get_or(name, Type::Skolem.(name));
            witnesses.push(witness);
            labels.push(match witness {
                Type::Skolem(label) => label,
                _ => name,
            });
            i = i + 1usize;
        }
        self.results().witnesses.set(p.id, witnesses);
        let value = self.expr(p.value.get());
        let result = new_meta();
        let wait = PackWait.{ result, value, labels, pos: p.pos };
        // the type it is used at says which brands are hidden
        self.later(result, Action::Pack.(wait), p.pos);
        self.defaults.push(wait);
        result
    }

    // Otherwise a pack's type is the payload's, with the brands abstracted.
    fn pack_default(self, p: PackWait) {
        let binders: Seq[Text] = Seq::new();
        let sub: Map[Text, Type] = Map::new();
        var i = 0usize;
        while i < p.labels.len() {
            let binder = Out::new().put("p").usize(i).done();
            binders.push(binder);
            sub.set(p.labels.get(i), Type::Skolem.(binder));
            i = i + 1usize;
        }
        self.unify_at(p.result, Type::Exists.(binders, Cell::new(subst(zonk(p.value), sub, self.inf.counter))), no_pos());
    }

    fn expr_foreach(self, f: S::Foreach) -> Type {
        var source = zonk(self.expr(f.source.get()));
        if is_unsolved(source) {
            source = self.shape(source, f.pos);
        }
        self.require(text("builtin::Exposed"), Seq::one(source), f.pos);
        let binder = match f.binder {
            Option::Some(b) => b,
            Option::None => Out::new().put("#F").u64(self.inf.next_id() as u64).done(),
        };
        self.kinds.set(binder, Kind::Any);
        let (indirect, item) = match source {
            Type::Foreach(s) => {
                let names = foreach_binders(s);
                var i = 0usize;
                while i < names.len() {
                    self.kinds.set(names.get(i), Kind::Any);
                    i = i + 1usize;
                }
                (false, s.body.get())
            },
            _ => {
                let indirect = match self.shape(source, f.pos) {
                    Type::Ptr(_p) => true,
                    _ => false,
                };
                let named = C::named(binder, Seq::new());
                (indirect, if indirect { C::ptr(named) } else { named })
            },
        };
        let frame = new_frame();
        self.frames.push(frame);
        self.scopes.push(new_level());
        self.results().binders.set(f.id, self.bind(f.name, item, false, Option::None).id);
        let body = zonk(self.expr(Expr::Block.(f.body)));
        self.leave();
        let unit = self.frames.pop();
        self.results().captures.set(f.id, self.captures(frame));
        C::foreach_type(binder, indirect, source, body)
    }

    // The other operators have rules; `&` lends the receiver of a call.
    fn expr_unary(self, u: S::Unary) -> Type {
        let first = match self.first_call(u.operand.get()) {
            Option::Some(c) => c,
            Option::None => self.fails("& lends a place only as a call argument, a receiver, or a match scrutinee", u.pos),
        };
        self.inf.lend_marked.add(first.id);
        self.expr(u.operand.get())
    }

    // The type behind a pointer.
    fn pointee(self, pointer: Type, pos: Pos) -> Type {
        let target = new_meta();
        self.unify_at(pointer, C::ptr(target), pos);
        target
    }

    // The innermost method call of a postfix chain: the one `&` lends the receiver of.
    fn first_call(self, e: Expr) -> Option[S::Call] {
        var e = e;
        while true {
            e = match e {
                Expr::Call(c) => match c.callee.get() {
                    Expr::Field(f) => if self.is_place(f.value.get()) {
                        return Option::Some.(c);
                    } else {
                        f.value.get()
                    },
                    _ => return Option::None,
                },
                Expr::Field(f) => f.value.get(),
                Expr::Index(x) => x.value.get(),
                Expr::Try(n) => n.value.get(),
                _ => return Option::None,
            };
        }
        Option::None
    }

    // `x?` unwraps success or returns failure from the same Option/Result family.
    fn resolve_try(self, t: TryWait, pos: Pos) -> Type {
        let operand = zonk(t.operand);
        let returned = zonk(t.returned);
        let family = self.family(operand);
        let (name, args) = match operand {
            Type::Named(name, args) => (name, args),
            _ => (text(""), Seq::new()),
        };
        let (other_name, other_args) = match returned {
            Type::Named(name, args) => (name, args),
            _ => (text(""), Seq::new()),
        };
        let fits = !family.is_empty() && self.family(returned).eq(family) && name.eq(other_name);
        if !fits {
            self.fails("? needs the operand and the function result to be the same direct Option/Result type", pos);
        }
        self.require_visible_shape(operand, pos);
        self.require_visible_shape(returned, pos);
        let result = family.is("result");
        let ok = text(if result { "Ok" } else { "Some" });
        let error = text(if result { "Err" } else { "None" });
        let td = self.inf.types.program.types.at(name);
        self.unify_at(self.variant_type(td, args, error), self.variant_type(td, other_args, error), pos);
        self.results().try_kinds.set(t.id, family);
        self.variant_type(td, args, ok)
    }

    fn variant_type(self, td: TypeDecl, args: Seq[Type], name: Text) -> Type {
        let sub: Map[Text, Type] = Map::new();
        var i = 0usize;
        while i < td.params.len() && i < args.len() {
            sub.set(td.params.get(i).name, args.get(i));
            i = i + 1usize;
        }
        self.payload_of(td, name, sub)
    }

    // `option`, `result`, or empty for any other type.
    fn family(self, ty: Type) -> Text {
        let name = match ty {
            Type::Named(name, _args) => name,
            _ => return text(""),
        };
        let variants = match self.inf.types.program.types.get(name) {
            Option::Some(td) => match td.body {
                Type::Enum(variants) => variants,
                _ => return text(""),
            },
            Option::None => return text(""),
        };
        let names: Set[Text] = Set::new();
        var i = 0usize;
        while i < variants.len() {
            names.add(variants.get(i).name);
            i = i + 1usize;
        }
        if names.len() == 2usize && names.has(text("Ok")) && names.has(text("Err")) {
            text("result")
        } else if names.len() == 2usize && names.has(text("Some")) && names.has(text("None")) {
            text("option")
        } else {
            text("")
        }
    }

    // ---- places
    // The type of a place expression: a local, or fields and tuple elements of one.
    fn place_type(self, e: Expr, assign: bool) -> Type {
        let unit = match e {
            Expr::Path(p) => {
                let local_name = match self.inf.r.refs.get(p.id) {
                    Option::Some(r) => match r {
                        NameRef::Local(name) => Option::Some.(name),
                        _ => Option::None,
                    },
                    Option::None => Option::None,
                };
                let unit = match local_name {
                    Option::Some(name) => {
                        let local = match self.lookup(name) {
                            Option::Some(l) => l,
                            Option::None => self.fail(Out::new().put("unknown local ").add(name).done(), p.pos),
                        };
                        if assign && !local.mutable {
                            self.fail(Out::new().add(name).put(" is not a var").done(), p.pos);
                        }
                        self.results().binders.set(p.id, local.id);
                        return self.record(p.id, p.pos, local.type);
                    },
                    Option::None => (),
                };
            },
            Expr::Field(f) => return self.projection(f.value.get(), Option::Some.(f.name), 0usize, f.id, f.pos, assign),
            Expr::Index(x) => return self.projection(x.value.get(), Option::None, x.index, x.id, x.pos, assign),
            _ => (),
        };
        if assign {
            self.fails("not an assignable place", S::expr_pos(e));
        }
        self.expr(e)
    }

    // The type of `owner.name` or `owner.N`; an owner that is a place is typed as one, so that an
    // assignment is checked down to its root local.
    fn projection(self, value: Expr, field: Option[Text], index: usize, id: u32, pos: Pos, assign: bool) -> Type {
        let owner = if self.is_place(value) { self.place_type(value, assign) } else { self.expr(value) };
        let result = new_meta();
        self.later(owner, Action::Component.(Component.{ field, index, owner, result }), pos);
        self.record(id, pos, result)
    }

    fn component(self, c: Component, pos: Pos) {
        self.require_visible_shape(c.owner, pos);
        let s = self.shape(c.owner, pos);
        let unit = match c.field {
            Option::Some(name) => match s {
                Type::Struct(fields) => {
                    var i = 0usize;
                    while i < fields.len() {
                        if fields.get(i).name.eq(name) {
                            self.unify_at(c.result, fields.get(i).type, pos);
                            return;
                        }
                        i = i + 1usize;
                    }
                },
                _ => (),
            },
            Option::None => match s {
                Type::Tuple(elems) => if c.index < elems.len() {
                    self.unify_at(c.result, elems.get(c.index), pos);
                    return;
                },
                _ => (),
            },
        };
        let what = match c.field {
            Option::Some(name) => name,
            Option::None => Out::new().usize(c.index).done(),
        };
        self.fail(Out::new().add(show(zonk(c.owner))).put(" has no component ").add(what).done(), pos)
    }

    fn is_place(self, e: Expr) -> bool {
        match e {
            Expr::Path(p) => match self.inf.r.refs.get(p.id) {
                Option::Some(r) => match r {
                    NameRef::Local(_n) => true,
                    _ => false,
                },
                Option::None => false,
            },
            Expr::Field(f) => self.is_place(f.value.get()),
            Expr::Index(x) => self.is_place(x.value.get()),
            _ => false,
        }
    }

    // ---- calls
    fn expr_call(self, c: S::Call) -> Type {
        let callee = c.callee.get();
        let lent_receiver = self.inf.lend_marked.has(c.id);
        let unit = match callee {
            Expr::Field(f) => return self.method_call(c, f, lent_receiver),
            _ => (),
        };
        if lent_receiver {
            self.fails("& before a call lends its receiver: `&x.method()`", c.pos);
        }
        let path = match callee {
            Expr::Path(p) => p,
            _ => return self.call_value(c),
        };
        let r = match self.inf.r.refs.get(path.id) {
            Option::Some(r) => r,
            Option::None => return self.call_value(c),
        };
        match r {
            NameRef::Variant(enum_decl, name) => {
                let ty = self.variant(path, enum_decl, name, Option::Some.(c.args));
                self.results().calls.set(c.id, self.results().calls.at(path.id));
                self.record(path.id, path.pos, ty)
            },
            NameRef::Decl(decl) => if decl.kind.is("fn") || decl.kind.is("method") || decl.kind.is("extern") {
                let sig = self.inf.sigs.sigs.at(decl.id);
                let sub = instantiate(sig.params);
                self.explicit_args(path, sig, sub);
                let call = FnCall.{ sig, sub, receiver: Option::None };
                self.results().calls.set(c.id, Callee::Fn.(call));
                self.call_sig(c, call, self.operands(c.args))
            } else if decl.kind.is("tuple") {
                let (td, sub, result) = self.construct(c.pos, decl, self.path_arguments(path, decl, false));
                let elems = match td.body {
                    Type::Tuple(elems) => elems,
                    _ => self.fails("internal error: a tuple declaration that is not a tuple", c.pos),
                };
                if c.args.len() != elems.len() {
                    self.fail(Out::new().add(td.name).put(" has ").usize(elems.len()).put(" elements").done(), c.pos);
                }
                var i = 0usize;
                while i < elems.len() {
                    let unit = self.check(c.args.get(i), Option::Some.(subst(elems.get(i), sub, self.inf.counter)));
                    i = i + 1usize;
                }
                self.results().calls.set(c.id, Callee::Tuple);
                self.record(path.id, path.pos, result)
            } else {
                self.call_value(c)
            },
            NameRef::TraitMethod(trait_decl, method) => self.trait_call(c, path, trait_decl, method),
            NameRef::Builtin(name) => self.builtin(c, path, name),
            NameRef::Assoc(param, name) => self.assoc_call(c, path, param, name),
            _ => self.call_value(c),
        }
    }

    // A call of a value: a closure `{env, code}`, or a function pointer.
    fn call_value(self, c: S::Call) -> Type {
        let callee = self.expr(c.callee.get());
        let got = self.operands(c.args);
        let result = new_meta();
        self.later(callee, Action::CallValue.(CallWait.{ call: c, callee, got, result }), c.pos);
        result
    }

    fn call_known(self, w: CallWait, pos: Pos) {
        let s = self.shape(w.callee, pos);
        let ptypes: Seq[Type] = Seq::new();
        let places: Seq[usize] = Seq::new();
        let closure_fields = match s {
            Type::Struct(fields) => {
                var has_code = false;
                var i = 0usize;
                while i < fields.len() {
                    if fields.get(i).name.is("code") {
                        has_code = true;
                    }
                    i = i + 1usize;
                }
                if has_code { Option::Some.(fields) } else { Option::None }
            },
            _ => Option::None,
        };
        let ret = match closure_fields {
            Option::Some(fields) => {
                self.require_visible_shape(w.callee, pos);
                if fields.len() != 2usize || !fields.get(0usize).name.is("env") || !fields.get(1usize).name.is("code") {
                    self.fails("a closure must have exactly env and code fields, in that order", pos);
                }
                let env = fields.get(0usize).type;
                let code = match self.shape(fields.get(1usize).type, pos) {
                    Type::Fn(f) => f,
                    _ => self.fails("a closure code field must have a function type", pos),
                };
                if !code.quantified.is_empty() {
                    self.fails("a closure code field must have a monomorphic function type", pos);
                }
                if code.params.is_empty() || code.places.has(0usize) {
                    self.fails("a closure code function must take its environment by value first", pos);
                }
                self.unify_at(env, code.params.get(0usize), pos);
                self.results().calls.set(w.call.id, Callee::Closure);
                ptypes.append(code.params.from(1usize));
                var i = 0usize;
                while i < code.places.len() {
                    places.push(code.places.get(i) - 1usize);
                    i = i + 1usize;
                }
                code.ret.get()
            },
            Option::None => match s {
                Type::Fn(f) => {
                    let sub = instantiate(f.quantified);
                    self.results().calls.set(w.call.id, Callee::Value.(sub));
                    ptypes.append(self.subst_all(f.params, sub));
                    places.append(f.places);
                    subst(f.ret.get(), sub, self.inf.counter)
                },
                _ => self.fail(Out::new().add(show(zonk(w.callee))).put(" is not callable").done(), pos),
            },
        };
        self.bind_operands(w.call, w.got, ptypes, places);
        self.unify_at(w.result, ret, pos);
    }

    // Type each argument now: its type, and whether it lends a place. Holding it to its parameter waits
    // for the callee.
    fn operands(self, args: Seq[Expr]) -> Seq[Option[(Type, bool)]] {
        let out: Seq[Option[(Type, bool)]] = Seq::new();
        var i = 0usize;
        while i < args.len() {
            out.push(Option::Some.(self.operand(args.get(i))));
            i = i + 1usize;
        }
        out
    }

    fn operand(self, arg: Expr) -> (Type, bool) {
        let unit = match arg {
            Expr::Unary(u) => {
                let inner = u.operand.get();
                if u.op.is("unsafe") {
                    let unit = match inner {
                        Expr::Unary(lend) => if lend.op.is("&") {
                            let call = match lend.operand.get() {
                                Expr::Call(_c) => true,
                                _ => false,
                            };
                            if !call {
                                let (ty, lends) = self.operand(inner);
                                return (self.record(u.id, u.pos, ty), lends);
                            }
                        },
                        _ => (),
                    };
                } else if u.op.is("&") {
                    let unit = match inner {
                        // `&*p`: a raw pointer's target
                        Expr::Unary(deref) => if deref.op.is("*") {
                            let target = self.pointee(self.expr(deref.operand.get()), u.pos);
                            return (self.record(u.id, u.pos, target), true);
                        },
                        _ => (),
                    };
                    if self.is_place(inner) {
                        return (self.record(u.id, u.pos, self.place_type(inner, false)), true);
                    }
                }
            },
            _ => (),
        };
        (self.expr(arg), false)
    }

    // Hold the operands to the parameters: the count, the `&` modes, the types. A method's receiver
    // is none.
    fn bind_operands(self, c: S::Call, got: Seq[Option[(Type, bool)]], ptypes: Seq[Type], places: Seq[usize]) {
        if got.len() != ptypes.len() {
            self.fail(Out::new().put("expected ").usize(ptypes.len()).put(" arguments, got ").usize(got.len()).done(), c.pos);
        }
        var k = 0usize;
        while k < got.len() {
            let unit = match got.get(k) {
                Option::Some(operand) => {
                    let (ty, lends) = operand;
                    if places.has(k) != lends {
                        self.fails("an & parameter takes `&place`, and only an & parameter does", c.pos);
                    }
                    self.unify_at(ty, ptypes.get(k), c.pos);
                },
                Option::None => (),
            };
            k = k + 1usize;
        }
    }

    fn require_signature(self, sig: Sig, sub: Map[Text, Type], pos: Pos) {
        self.require_parameter_kinds(sig.params, sub, pos);
        var i = 0usize;
        while i < sig.premises.len() {
            let premise = sig.premises.get(i);
            self.require(premise.trait_name, self.subst_all(premise.args, sub), pos);
            i = i + 1usize;
        }
    }

    fn call_sig(self, c: S::Call, call: FnCall, got: Seq[Option[(Type, bool)]]) -> Type {
        self.require_signature(call.sig, call.sub, c.pos);
        self.bind_operands(c, got, self.subst_all(call.sig.ptypes, call.sub), call.sig.places);
        subst(call.sig.ret, call.sub, self.inf.counter)
    }

    fn trait_call(self, c: S::Call, path: S::Path, trait_decl: Decl, method: Text) -> Type {
        let tr = self.inf.sigs.traits.at(self.inf.sigs.name(trait_decl));
        let written = self.path_arguments(path, trait_decl, true);
        if written.len() > tr.params.len() {
            self.fail(Out::new().add(tr.name).put(" accepts at most ").usize(tr.params.len()).put(" type arguments, got ").usize(written.len()).done(), c.pos);
        }
        let targs: Seq[Type] = Seq::new();
        var i = 0usize;
        while i < tr.param_kinds.len() {
            targs.push(meta_of(tr.param_kinds.get(i)));
            i = i + 1usize;
        }
        i = 0usize;
        while i < written.len() {
            let unit = match written.get(i) {
                S::Type::Ignored => (),
                _ => self.unify_at(targs.get(i), self.core_type(written.get(i)), c.pos),
            };
            i = i + 1usize;
        }
        self.trait_method(c, tr, method, targs, self.operands(c.args), Option::None)
    }

    fn method_of(self, tr: C::Trait, method: Text) -> C::Method {
        var i = 0usize;
        while i < tr.methods.len() {
            if tr.methods.get(i).name.eq(method) {
                return tr.methods.get(i);
            }
            i = i + 1usize;
        }
        self.fails("internal error: an unknown trait method", no_pos())
    }

    fn trait_method(self, c: S::Call, tr: C::Trait, method: Text, targs: Seq[Type], got: Seq[Option[(Type, bool)]],
                    receiver: Option[Receiver]) -> Type {
        let m = self.method_of(tr, method);
        let sub: Map[Text, Type] = Map::new();
        var i = 0usize;
        while i < tr.params.len() && i < targs.len() {
            sub.set(tr.params.get(i), targs.get(i));
            i = i + 1usize;
        }
        i = 0usize;
        while i < tr.param_kinds.len() && i < targs.len() {
            if is_copy_kind(tr.param_kinds.get(i)) {
                self.require_copy(targs.get(i), c.pos);
            }
            i = i + 1usize;
        }
        let args = targs.copy();
        self.results().calls.set(c.id, Callee::Trait.(TraitCall.{ trait_name: tr.name, method, targs: args, receiver }));
        self.require(tr.name, args, c.pos);
        self.bind_operands(c, got, self.subst_all(m.ptypes, sub), m.places);
        subst(m.ret, sub, self.inf.counter)
    }

    // `T::name(args)` for a type parameter `T`: the one bound of `T` with that method.
    fn assoc_call(self, c: S::Call, path: S::Path, param: Text, name: Text) -> Type {
        if has_args(path) {
            self.fails("an associated parameter call takes its type arguments from its trait premise", c.pos);
        }
        let found: Seq[Premise] = Seq::new();
        var i = 0usize;
        while i < self.assumptions.len() {
            let p = self.assumptions.get(i);
            let unit = match self.inf.sigs.traits.get(p.trait_name) {
                Option::Some(tr) => {
                    var has = false;
                    var k = 0usize;
                    while k < tr.methods.len() {
                        if tr.methods.get(k).name.eq(name) {
                            has = true;
                        }
                        k = k + 1usize;
                    }
                    if has && !p.args.is_empty() && C::same(p.args.get(0usize), C::named(param, Seq::new())) {
                        found.push(p);
                    }
                },
                Option::None => (),
            };
            i = i + 1usize;
        }
        if found.len() != 1usize {
            self.fail(Out::new().add(param).put("::").add(name).put(" needs exactly one bound of ").add(param).put(" with that method").done(), c.pos);
        }
        let p = found.get(0usize);
        self.trait_method(c, self.inf.sigs.traits.at(p.trait_name), name, p.args.copy(), self.operands(c.args), Option::None)
    }

    fn builtin(self, c: S::Call, path: S::Path, name: Text) -> Type {
        let arity = match builtin_arity(name) {
            Option::Some(n) => n,
            Option::None => self.fail(Out::new().put("unknown builtin ").add(name).done(), c.pos),
        };
        if c.args.len() != arity {
            if name.is("fence") {
                self.fails("fence takes one ordering argument", c.pos);
            }
            self.fail(Out::new().add(name).put(" takes ").usize(arity).put(" value arguments").done(), c.pos);
        }
        let count = path.segments.len();
        let targs = path.segments.get(count - 1usize).args;
        var i = 0usize;
        while i + 1usize < count {
            if !path.segments.get(i).args.is_empty() {
                self.fails("builtin namespace does not take type arguments", c.pos);
            }
            i = i + 1usize;
        }
        let expected = if name.is("alloca") { 1usize } else { 0usize };
        if targs.len() != expected {
            self.fail(Out::new().add(name).put(" takes ").usize(expected).put(" type arguments").done(), c.pos);
        }
        self.results().calls.set(c.id, Callee::Builtin.(name));
        if name.is("fresh") {
            Type::Exists.(Seq::one(text("x")), Cell::new(Type::Brand.(Cell::new(Type::Skolem.(text("x"))))))
        } else if name.is("static_brand") {
            Type::Brand.(Cell::new(Type::Skolem.(text("static"))))
        } else if name.is("enum_variant") {
            let arg = c.args.get(0usize);
            let arg_pos = S::expr_pos(arg);
            let lent = match arg {
                Expr::Unary(u) => if u.op.is("&") { Option::Some.(u) } else { Option::None },
                _ => Option::None,
            };
            let operand = match lent {
                Option::Some(u) => {
                    if !self.is_place(u.operand.get()) {
                        self.fails("enum_variant(&place) requires a place", arg_pos);
                    }
                    self.record(u.id, u.pos, self.place_type(u.operand.get(), false))
                },
                Option::None => self.expr(arg),
            };
            if !is_never(operand) {
                self.later(operand, Action::EnumOperand.(operand), arg_pos);
            }
            if lent.is_some() { C::u32_type() } else { Type::Tuple.(Seq::two(operand, C::u32_type())) }
        } else if name.is("alloca") {
            let target = self.core_type(targs.get(0usize));
            self.results().calls.set(c.id, Callee::Alloca.(target));
            C::ptr(target)
        } else if name.is("fence") {
            let unit = self.check(c.args.get(0usize), Option::Some.(C::named(self.library("Ordering"), Seq::new())));
            C::unit()
        } else {
            let pointer = self.expr(c.args.get(0usize));
            let rest: Seq[Type] = Seq::new();
            i = 1usize;
            while i < c.args.len() {
                rest.push(self.expr(c.args.get(i)));
                i = i + 1usize;
            }
            self.pointer_op(c, name, pointer, rest)
        }
    }

    fn method_call(self, c: S::Call, callee: S::Field, lent_receiver: bool) -> Type {
        let receiver = callee.value.get();
        let name = callee.name;
        let unit = match receiver {
            Expr::FStr(f) => if name.is("write") {
                let unit = self.expr(receiver);
                self.results().calls.set(c.id, Callee::FStringWrite.(f));
                if c.args.len() != 1usize {
                    self.fails("write takes the writer", c.pos);
                }
                let out = self.expr(c.args.get(0usize));
                self.require(self.library("Writable"), Seq::one(out), c.pos);
                return out;
            },
            _ => (),
        };
        if lent_receiver && !self.is_place(receiver) {
            self.fails("& lends a local or a field of one", c.pos);
        }
        let receiver_ty = if lent_receiver { self.place_type(receiver, false) } else { self.expr(receiver) };
        let actual = Receiver.{ value: receiver, lend: lent_receiver };
        let got: Seq[Option[(Type, bool)]] = Seq::one(Option::None);
        got.append(self.operands(c.args));
        let result = new_meta();
        self.later(receiver_ty, Action::Method.(MethodWait.{ call: c, receiver: receiver_ty, name, actual, got, result }), c.pos);
        result
    }

    // The method `name` of the receiver's type: its signature instantiated, and its result type.
    fn resolve_method(self, c: S::Call, receiver_ty: Type, name: Text, receiver: Receiver, got: Seq[Option[(Type, bool)]]) -> Type {
        match self.find_method(receiver_ty, name, c.pos) {
            Lookup::Pointer => {
                self.results().calls.set(c.id, Callee::Pointer.(name, receiver.value));
                let operand_types: Seq[Type] = Seq::new();
                var i = 1usize;
                while i < got.len() {
                    let unit = match got.get(i) {
                        Option::Some(operand) => {
                            let (ty, _lends) = operand;
                            operand_types.push(ty);
                        },
                        Option::None => (),
                    };
                    i = i + 1usize;
                }
                self.pointer_op(c, name, receiver_ty, operand_types)
            },
            Lookup::Trait(tr, targs) => {
                let m = self.method_of(tr, name);
                self.receiver_mode(name, m.places, receiver, c.pos);
                self.trait_method(c, tr, name, targs, got, Option::Some.(receiver))
            },
            Lookup::Method(sig) => {
                if sig.ptypes.is_empty() {
                    self.fail(Out::new().add(name).put(" takes no receiver").done(), c.pos);
                }
                self.receiver_mode(name, sig.places, receiver, c.pos);
                let sub = instantiate(sig.params);
                self.unify_at(subst(sig.ptypes.get(0usize), sub, self.inf.counter), receiver_ty, c.pos);
                let call = FnCall.{ sig, sub, receiver: Option::Some.(receiver) };
                self.results().calls.set(c.id, Callee::Fn.(call));
                self.call_sig(c, call, got)
            },
        }
    }

    fn receiver_mode(self, name: Text, places: Seq[usize], receiver: Receiver, pos: Pos) {
        let lends = places.has(0usize);
        if lends != receiver.lend {
            self.fail(Out::new().add(name).put(" takes its receiver ").put(if lends { "by &" } else { "by value" }).done(), pos);
        }
    }

    // Method lookup by name: the receiver type's own method, else the one trait (of a single input) or
    // blanket impl method of that name visible here. A name that several of them share is written
    // `Trait::name(x)`.
    fn find_method(self, receiver_ty: Type, name: Text, pos: Pos) -> Lookup {
        let t = zonk(receiver_ty);
        let owner = match t {
            Type::Ptr(_i) => {
                if is_pointer_method(name) {
                    return Lookup::Pointer;
                }
                Option::None
            },
            Type::Named(n, _args) => match self.inf.decl_of.get(n) {
                Option::Some(d) => Option::Some.(Owner::Decl.(d)),
                Option::None => Option::None,
            },
            Type::Prim(n) => Option::Some.(Owner::Prim.(n)),
            _ => Option::None,
        };
        let candidates: Seq[Lookup] = Seq::new();
        let unit = match owner {
            Option::Some(o) => {
                let own = self.inf.r.attached.get_or((o, name), Seq::new());
                var i = 0usize;
                while i < own.len() {
                    if own.get(i).kind.is("method") {
                        candidates.push(Lookup::Method.(self.inf.sigs.sigs.at(own.get(i).id)));
                    }
                    i = i + 1usize;
                }
            },
            Option::None => (),
        };
        if candidates.is_empty() {
            let visible = self.inf.visible_traits(self.home);
            let traits = self.inf.sigs.traits.values();
            var i = 0usize;
            while i < traits.len() {
                let tr = traits.get(i);
                let single = self.inf.inputs.get_or(tr.name, 0usize) == 1usize;
                let seen = match self.inf.decl_of.get(tr.name) {
                    Option::Some(d) => visible.has(d.id),
                    Option::None => false,
                };
                var has = false;
                var k = 0usize;
                while k < tr.methods.len() {
                    if tr.methods.get(k).name.eq(name) {
                        has = true;
                    }
                    k = k + 1usize;
                }
                if single && seen && has {
                    let targs = Seq::one(t);
                    k = 1usize;
                    while k < tr.param_kinds.len() {
                        targs.push(meta_of(tr.param_kinds.get(k)));
                        k = k + 1usize;
                    }
                    candidates.push(Lookup::Trait.(tr, targs));
                }
                i = i + 1usize;
            }
            let blanket = self.inf.r.attached.get_or((Owner::Blanket, name), Seq::new());
            i = 0usize;
            while i < blanket.len() {
                let d = blanket.get(i);
                if d.kind.is("method") && self.inf.blanket_visible(d, self.home, visible) {
                    candidates.push(Lookup::Method.(self.inf.sigs.sigs.at(d.id)));
                }
                i = i + 1usize;
            }
        }
        if candidates.len() != 1usize {
            self.fail(Out::new().add(show(t)).put(" has ").put(if candidates.is_empty() { "no" } else { "several" }).put(" method ").add(name).done(), pos);
        }
        candidates.get(0usize)
    }

    // A pointer operation: its operands held to their types, once the pointee is known.
    fn pointer_op(self, c: S::Call, name: Text, pointer: Type, operands: Seq[Type]) -> Type {
        let params = pointer_params(name);
        if operands.len() != params.len {
            self.fail(Out::new().add(name).put(" takes ").usize(params.len).put(" arguments").done(), c.pos);
        }
        let out = new_meta();
        self.later(pointer, Action::Pointer.(PointerWait.{ name, pointer, operands, out }), c.pos);
        out
    }

    fn pointer_known(self, w: PointerWait, pos: Pos) {
        let inner = match self.shape(w.pointer, pos) {
            Type::Ptr(inner) => inner.get(),
            _ => self.fail(Out::new().add(w.name).put(" needs a pointer").done(), pos),
        };
        let params = pointer_params(w.name);
        var i = 0usize;
        while i < w.operands.len() {
            let want = if params.byte(i) == b'T' { inner } else { C::named(self.library("Ordering"), Seq::new()) };
            self.unify_at(w.operands.get(i), want, pos);
            i = i + 1usize;
        }
        let result = pointer_result(w.name);
        let ret = if result == b'T' {
            inner
        } else if result == b'U' {
            C::unit()
        } else {
            Type::Tuple.(Seq::two(inner, C::bool_type()))
        };
        self.unify_at(w.out, ret, pos);
    }
}

fn zonk_all(ts: Seq[Type]) {
    var i = 0usize;
    while i < ts.len() {
        ts.set(i, zonk(ts.get(i)));
        i = i + 1usize;
    }
}

fn zonk_map(sub: Map[Text, Type]) {
    let names = sub.keys();
    var i = 0usize;
    while i < names.len() {
        sub.set(names.get(i), zonk(sub.at(names.get(i))));
        i = i + 1usize;
    }
}

// Infer every function body of the program.
fn infer(r: Resolver, sigs: Signatures, counter: Fresh) -> Infer {
    let inf = Infer::new(r, sigs, counter);
    inf.run();
    inf
}
