// Type inference for function bodies, by constraint solving.
//
// Walking a body assigns types, using fresh metavariables for unknowns. Unification solves equalities
// immediately. Field selection, method lookup and trait selection can need information learned later:
// `wait` stores a readiness condition (`Ready`), an action (`Action`) and a diagnostic position.
// `later` waits for a type's head.
//
// Adding a waiter or unifying types calls `solve`, which scans waiting actions until none is ready.
// Each ready action is removed before it runs. Actions may unify types or add waiters; `solving`
// prevents nested solver loops, so the outer loop picks up the resulting work.
//
// Once ready work is exhausted, `run_defaults` gives still-unknown `pack` types their payload-derived
// types and resumes solving. Defaults run at function finalization, or earlier when `shape` needs a
// known type head. Integer literals have no default: their types must be determined by context or a
// suffix. `finish` drains ready work and defaults, rejects remaining waiters and undetermined numeric
// literals, then replaces solved metavariables in the recorded types and call annotations.
//
// Results are kept in `Results`, by syntax node id, for lowering: each expression's, pattern's and
// variant case's type, what each call calls (`Callee`), local binding ids, captures and the rest.

use package::support::base::{counted, fail_static};
use std::collections::list::List;
use std::collections::arena_vec::ArenaVec;
use std::collections::arena_map::{ArenaMap, ArenaSet};
use std::mem::Ref;
use std::str::Str;
use std::arena::{Domain!, ref_in, seed};
use std::buffer::Buffer!;
use std::fmt::Writer;
use package::types::coherence::check_coherence;
use package::kurs::core::{ForeachType, Kind, Member, Meta, MetaKind, ModuleId, Param, Premise, Program, Type, TypeDecl};
use package::kurs::core as C;
use package::resolve::resolver::{Decl, NameRef, Named, Owner, Resolver, Target, listed};
use package::sigs::signatures::{ConstValue, InstanceSig, Sig, Signatures, const_type, new_scope};
use package::syntax::ast as S;
use package::syntax::ast::{Expr, Pattern, Pos, Statement, no_pos};
use package::types::termination::check_instance_termination;
use package::types::ops::{FOREACH_OF_FOREACH, POINTER_TO_SUM, Fresh, Surface, Types, brand_differences, brand_name, equal, free_brands, free_names, made_from, mapped_component, subst, surface};
use package::types::unify::{ground, instantiate, match_head, prune, unify, zonk};
use std::collections::hashmap::OwnedMap!;
use std::collections::vec::OwnedVec!;
use std::option::{Option, Result};

// ------------------------------------------------------- what gets recorded --

// A method call's receiver: the expression, and whether it is lent.
forall 'k.
exposed struct Receiver {
    value: Expr['k],
    lend: bool,
}

forall 'k.
exposed struct FnCall {
    sig: Sig['k],
    sub: ArenaMap[Str['k], Type['k], 'k],
    receiver: Option[Receiver['k]],
}

forall 'k.
impl FnCall['k] {
    // The called symbol: an extern's own name, else the signature's.
    fn call_name(self) -> Str['k] {
        match self.sig.decl {
            Some(d) => match d.node {
                Extern(x) => x.name,
                _ => self.sig.name,
            },
            None => self.sig.name,
        }
    }

    // In signature order.
    fn targs(self, &cx: Domain!['k]) -> ArenaVec[Type['k], 'k] {
        let out: ArenaVec[Type['k], 'k] = ArenaVec::new(&cx);
        var i = 0usize;
        while i < self.sig.params.len(&cx) {
            out.push(&cx, self.sub.at(&cx, self.sig.params.at(&cx, i).name));
            i = i + 1usize;
        }
        out
    }
}

forall 'k.
exposed struct TraitCall {
    trait_name: Str['k],
    method: Str['k],
    targs: ArenaVec[Type['k], 'k],
    receiver: Option[Receiver['k]],
}

// What a call calls.
forall 'k.
exposed enum Callee {
    Fn(FnCall['k]),
    Trait(TraitCall['k]),
    // a function value
    Value,
    Closure,
    Variant(Str['k]),
    Tuple,
    Builtin(Str['k]),
    // a builtin of one type argument, `alloca[T]()` or `sizeof[T]()`
    TypedBuiltin(Str['k], Type['k]),
    // a pointer method, and its receiver
    Pointer(Str['k], Expr['k]),
    // an f-string written into a writer, and the place `.write(&cx, out)` lends, if any
    FStringWrite(S::FStr['k], Option[Expr['k]]),
}

// One captured binding, in first-use order.
forall 'k.
exposed struct Capture {
    name: Str['k],
    binder: u32,
}

// What inference found, by syntax node id.
forall 'k.
exposed struct Results {
    // expressions, patterns and variant cases (a case's is its payload type)
    types: ArenaMap[u32, Type['k], 'k],
    // the binding a local path uses, or a var, const, for, foreach item or pattern binds
    binders: ArenaMap[u32, u32, 'k],
    // constant paths and local consts
    folded: ArenaMap[u32, ConstValue['k], 'k],
    // paths and calls
    calls: ArenaMap[u32, Callee['k], 'k],
    // struct literals: shorthand fields' binding ids, and the spread's
    field_ids: ArenaMap[u32, ArenaMap[Str['k], u32, 'k], 'k],
    spread_ids: ArenaMap[u32, u32, 'k],
    // variant cases: payload binding ids, none for each `_`
    case_binders: ArenaMap[u32, ArenaVec[Option[u32], 'k], 'k],
    // variant cases: the variant, written bare or as a path
    case_labels: ArenaMap[u32, Str['k], 'k],
    // matches: whether the scrutinee lends a place
    lent: ArenaMap[u32, bool, 'k],
    // functions and closures
    param_ids: ArenaMap[u32, ArenaVec[u32, 'k], 'k],
    // closures and foreach bodies
    captures: ArenaMap[u32, ArenaVec[Capture['k], 'k], 'k],
    // packs
    witnesses: ArenaMap[u32, ArenaVec[Type['k], 'k], 'k],
    // `?`: option or result
    try_kinds: ArenaMap[u32, Str['k], 'k],
    // `let exists`: the opened brands' labels
    opened: ArenaMap[u32, ArenaVec[Str['k], 'k], 'k],
    // for loops: the `next` result type, and the Iterator call
    options: ArenaMap[u32, Type['k], 'k],
    next_calls: ArenaMap[u32, TraitCall['k], 'k],
    // struct patterns with `..rest`
    rest_ids: ArenaMap[u32, u32, 'k],
    // f-strings: the `{x}` parts of type `Str['static]`, written as text is
    static_parts: ArenaSet[u32, 'k],
}

forall 'k.
fn new_results(&cx: Domain!['k]) -> Results['k] {
    Results.{
        types: ArenaMap::new(&cx), binders: ArenaMap::new(&cx), folded: ArenaMap::new(&cx), calls: ArenaMap::new(&cx),
        field_ids: ArenaMap::new(&cx), spread_ids: ArenaMap::new(&cx), case_binders: ArenaMap::new(&cx), case_labels: ArenaMap::new(&cx), lent: ArenaMap::new(&cx),
        param_ids: ArenaMap::new(&cx), captures: ArenaMap::new(&cx), witnesses: ArenaMap::new(&cx), try_kinds: ArenaMap::new(&cx),
        opened: ArenaMap::new(&cx), options: ArenaMap::new(&cx), next_calls: ArenaMap::new(&cx), rest_ids: ArenaMap::new(&cx),
        static_parts: ArenaSet::new(&cx),
    }
}

// ------------------------------------------------------------- the scopes --

// The fields a `..rest` pattern left over: known once the type matched against is.
forall 'k.
exposed struct Bundle {
    types: ArenaMap[Str['k], Type['k], 'k],
    filled: Ref[bool, 'k],
}

forall 'k.
exposed struct Local {
    ty: Type['k],
    // a var, or an `&` parameter
    mutable: bool,
    // a `..rest` bundle
    rest: Option[Bundle['k]],
    // how many closures deep it was bound
    depth: usize,
    id: u32,
}

// A lexical scope: the names bound in it, and the brands a `let exists` opened in it.
forall 'k.
exposed struct Level {
    names: ArenaMap[Str['k], Local['k], 'k],
    // source spelling -> unique witness
    brands: ArenaMap[Str['k], Str['k], 'k],
}

forall 'k.
fn new_level(&cx: Domain!['k]) -> Level['k] {
    Level.{ names: ArenaMap::new(&cx), brands: ArenaMap::new(&cx) }
}

// A closure or foreach body being walked: the outer locals it captures, in first-use order.
forall 'k.
exposed struct Frame {
    // (name, local, first use)
    locals: ArenaVec[(Str['k], Local['k], Pos), 'k],
}

forall 'k.
fn new_frame(&cx: Domain!['k]) -> Frame['k] {
    Frame.{ locals: ArenaVec::new(&cx) }
}

// ------------------------------------------------------------- the solver --

// When a waiting action can run: a type's head is known; the first `n` types mention no unknown;
// a bundle is filled; two types' heads are known.
forall 'k.
exposed enum Ready {
    Head(Type['k]),
    Ground(ArenaVec[Type['k], 'k], usize),
    Filled(Bundle['k]),
    Both(Type['k], Type['k]),
}

forall 'k.
exposed struct Elements {
    array: bool,
    ty: Type['k],
    types: ArenaVec[Type['k], 'k],
}

forall 'k.
exposed struct Fields {
    ty: Type['k],
    metas: ArenaMap[Str['k], Type['k], 'k],
    bundle: Bundle['k],
}

forall 'k.
exposed struct Spread {
    spread: Str['k],
    fields: ArenaMap[Str['k], Type['k], 'k],
    given: ArenaSet[Str['k], 'k],
    bundle: Bundle['k],
}

forall 'k.
exposed struct PackWait {
    result: Type['k],
    value: Type['k],
    labels: ArenaVec[Str['k], 'k],
    pos: Pos,
}

forall 'k.
exposed struct TryWait {
    id: u32,
    operand: Type['k],
    returned: Type['k],
    result: Type['k],
}

// `owner.name` (a field) or `owner.N` (an index).
forall 'k.
exposed struct Component {
    field: Option[Str['k]],
    index: usize,
    owner: Type['k],
    result: Type['k],
}

forall 'k.
exposed struct CallWait {
    call: S::Call['k],
    callee: Type['k],
    got: ArenaVec[Option[(Type['k], bool)], 'k],
    result: Type['k],
}

forall 'k.
exposed struct MethodWait {
    call: S::Call['k],
    receiver: Type['k],
    name: Str['k],
    actual: Receiver['k],
    got: ArenaVec[Option[(Type['k], bool)], 'k],
    result: Type['k],
}

// An f-string's `{x}`: its id, its type, and the writer it is written into.
forall 'k.
exposed struct PlaceholderWait {
    id: u32,
    value: Type['k],
    writer: Type['k],
}

forall 'k.
exposed struct PointerWait {
    name: Str['k],
    pointer: Type['k],
    operands: ArenaVec[Type['k], 'k],
    out: Type['k],
}

// What a waiter does once it is ready.
forall 'k.
exposed enum Action {
    Copy(Type['k]),
    Discharge(Str['k], ArenaVec[Type['k], 'k], usize),
    Elements(Elements['k]),
    Fields(Fields['k]),
    // op, operand, unary
    Primitive(Str['k], Type['k], bool),
    // result, element
    Fill(Type['k], Type['k]),
    Spread(Spread['k]),
    VisibleShape(Type['k]),
    Integer(Type['k]),
    Pack(PackWait['k]),
    Try(TryWait['k]),
    Component(Component['k]),
    CallValue(CallWait['k]),
    Method(MethodWait['k]),
    EnumOperand(Type['k]),
    Pointer(PointerWait['k]),
    Placeholder(PlaceholderWait['k]),
}

forall 'k.
exposed struct Waiter {
    ready: Ready['k],
    action: Action['k],
    pos: Pos,
}

// A type pattern of an operator rule: `t` is shared by the rule.
exposed enum Pat {
    Bool,
    Unit,
    T,
    PtrT,
}

// A method found by name.
forall 'k.
exposed enum Lookup {
    Pointer,
    Method(Sig['k]),
    Trait(C::Trait['k], ArenaVec[Type['k], 'k]),
}

// ---------------------------------------------------------------- helpers --

forall 'k.
fn is_never(&cx: Domain!['k], t: Type['k]) -> bool {
    match prune(&cx, t) {
        Never => true,
        _ => false,
    }
}

// The last segment of a path.
forall 'k.
fn last_name(&cx: Domain!['k], p: S::Path['k]) -> Str['k] {
    p.segments.at(&cx, p.segments.len(&cx) - 1usize).name
}

forall 'k.
fn is_unsolved(&cx: Domain!['k], t: Type['k]) -> bool {
    match prune(&cx, t) {
        Meta(_m) => true,
        _ => false,
    }
}

forall 'k.
fn all_settled(&cx: Domain!['k], ts: ArenaVec[Type['k], 'k]) -> bool {
    var i = 0usize;
    while i < ts.len(&cx) {
        if !settled(&cx, ts.at(&cx, i)) {
            return false;
        }
        i = i + 1usize;
    }
    true
}

forall 'k.
fn members_settled(&cx: Domain!['k], ms: ArenaVec[Member['k], 'k]) -> bool {
    var i = 0usize;
    while i < ms.len(&cx) {
        if !settled(&cx, ms.at(&cx, i).ty) {
            return false;
        }
        i = i + 1usize;
    }
    true
}

// `ty` mentions no unsolved metavariable (`unify::ground`, without building the zonked type).
forall 'k.
fn settled(&cx: Domain!['k], ty: Type['k]) -> bool {
    match prune(&cx, ty) {
        Meta(_m) => false,
        Ptr(inner) => settled(&cx, inner.copy(&cx)),
        NonNull(inner) => settled(&cx, inner.copy(&cx)),
        Brand(inner) => settled(&cx, inner.copy(&cx)),
        Array(elem, _n) => settled(&cx, elem.copy(&cx)),
        Tuple(elems) => all_settled(&cx, elems),
        Named(_name, args) => all_settled(&cx, args),
        Struct(fields) => members_settled(&cx, fields),
        Enum(variants) => members_settled(&cx, variants),
        Exists(_b, body) => settled(&cx, body.copy(&cx)),
        Foreach(f) => settled(&cx, f.source.copy(&cx)) && settled(&cx, f.body.copy(&cx)),
        Fn(f) => all_settled(&cx, f.params) && settled(&cx, f.ret.copy(&cx)),
        _ => true,
    }
}

forall 'k.
fn meta_of(&cx: Domain!['k], kind: Kind) -> Type['k] {
    match kind {
        Brand => Type::Meta.(Meta::new(&cx, MetaKind::Brand)),
        _ => Type::Meta.(Meta::new(&cx, MetaKind::Type)),
    }
}

forall 'k.
fn new_meta(&cx: Domain!['k]) -> Type['k] {
    Type::Meta.(Meta::new(&cx, MetaKind::Type))
}

fn is_brand(kind: Kind) -> bool {
    match kind {
        Brand => true,
        _ => false,
    }
}

fn is_copy_kind(kind: Kind) -> bool {
    match kind {
        Copy => true,
        _ => false,
    }
}

forall 'k.
fn has_args(&cx: Domain!['k], path: S::Path['k]) -> bool {
    var i = 0usize;
    while i < path.segments.len(&cx) {
        if !path.segments.at(&cx, i).args.is_empty(&cx) {
            return true;
        }
        i = i + 1usize;
    }
    false
}

forall 'k.
fn is_pointer_method(&cx: Domain!['k], name: Str['k]) -> bool {
    name.is(&cx, "load") || name.is(&cx, "load_volatile") || name.is(&cx, "store") || name.is(&cx, "store_volatile") || name.is(&cx, "atomic_load")
        || name.is(&cx, "atomic_store") || name.is(&cx, "compare_exchange") || name.is(&cx, "atomic_swap") || name.is(&cx, "fetch_add")
        || name.is(&cx, "fetch_sub") || name.is(&cx, "fetch_and") || name.is(&cx, "fetch_or") || name.is(&cx, "fetch_xor")
}

// A pointer operation's parameter types, `T` for the pointee and `O` for a memory ordering.
forall 'k.
fn pointer_params(&cx: Domain!['k], name: Str['k]) -> Str['k] {
    if name.is(&cx, "load") || name.is(&cx, "load_volatile") {
        Str::from_static(&cx, "")
    } else if name.is(&cx, "store") || name.is(&cx, "store_volatile") {
        Str::from_static(&cx, "T")
    } else if name.is(&cx, "atomic_load") {
        Str::from_static(&cx, "O")
    } else if name.is(&cx, "compare_exchange") {
        Str::from_static(&cx, "TTOO")
    } else {
        Str::from_static(&cx, "TO")
    }
}

// Its result: `T`, `U` for `()`, or `B` for `(T, bool)`.
forall 'k.
fn pointer_result(&cx: Domain!['k], name: Str['k]) -> u8 {
    if name.is(&cx, "store") || name.is(&cx, "store_volatile") || name.is(&cx, "atomic_store") {
        b'U'
    } else if name.is(&cx, "compare_exchange") {
        b'B'
    } else {
        b'T'
    }
}

// A builtin's number of value arguments, or none for an unknown builtin.
forall 'k.
fn builtin_arity(&cx: Domain!['k], name: Str['k]) -> Option[usize] {
    if name.is(&cx, "fresh") || name.is(&cx, "static_brand") || name.is(&cx, "sizeof") || name.is(&cx, "alloca") || name.is(&cx, "trap") {
        Option::Some.(0usize)
    } else if name.is(&cx, "enum_variant") || name.is(&cx, "fence") || name.is(&cx, "load_volatile") {
        Option::Some.(1usize)
    } else if name.is(&cx, "store_volatile") {
        Option::Some.(2usize)
    } else {
        Option::None
    }
}

forall 'k.
fn is_comparison(&cx: Domain!['k], op: Str['k]) -> bool {
    op.is(&cx, "==") || op.is(&cx, "!=") || op.is(&cx, "<") || op.is(&cx, "<=") || op.is(&cx, ">") || op.is(&cx, ">=")
}

forall 'k.
fn has_place(&cx: Domain!['k], places: ArenaVec[usize, 'k], k: usize) -> bool {
    places.contains(&cx, k)
}

// ------------------------------------------------------------- inference --

forall 'k.
exposed struct Infer {
    r: Resolver['k],
    sigs: Signatures['k],
    types: Types['k],
    decl_of: ArenaMap[Str['k], Decl['k], 'k],
    // trait -> its number of input parameters
    inputs: ArenaMap[Str['k], usize, 'k],
    instances: ArenaMap[Str['k], ArenaVec[InstanceSig['k], 'k], 'k],
    // module -> the ids of the traits visible in it
    visible: ArenaMap[ModuleId['k], ArenaSet[u32, 'k], 'k],
    // source binding identities, and the numbers of generated names
    ids: Ref[u32, 'k],
    counter: Fresh['k],
    out: Results['k],
    // inference-only flags: calls whose receiver `&` lends
    lend_marked: ArenaSet[u32, 'k],
    // an opened brand's label -> where its `let exists` is
    origins: ArenaMap[Str['k], Pos, 'k],
}

forall 'k.
impl Infer['k] {
    fn new(&cx: Domain!['k], r: Resolver['k], sigs: Signatures['k], counter: Fresh['k]) -> Infer['k] {
        let headers: ArenaVec[(Premise['k], ArenaVec[Premise['k], 'k], Pos), 'k] = ArenaVec::new(&cx);
        let ranges: ArenaVec[(Premise['k], ArenaVec[Param['k], 'k], Pos), 'k] = ArenaVec::new(&cx);
        let files: ArenaVec[Str['k], 'k] = ArenaVec::new(&cx);
        var i = 0usize;
        while i < sigs.instances.len(&cx) {
            let (inst, _item, home) = sigs.instances.at(&cx, i);
            let head = Premise.{ trait_name: inst.trait_name, args: inst.head };
            headers.push(&cx, (head, inst.premises, inst.pos));
            ranges.push(&cx, (head, inst.params, inst.pos));
            files.push(&cx, r.file(&cx, home));
            i = i + 1usize;
        }
        check_instance_termination(&cx, headers, files, true);
        check_coherence(&cx, ranges, counter, files, true);
        let program = Program.{ types: sigs.types, funs: ArenaMap::new(&cx), externs: ArenaMap::new(&cx), datas: ArenaMap::new(&cx), traits: sigs.traits, instances: ArenaMap::new(&cx) };
        let inf = Infer.{
            r, sigs, types: Types::new(&cx, program, counter), decl_of: ArenaMap::new(&cx), inputs: ArenaMap::new(&cx), instances: ArenaMap::new(&cx),
            visible: ArenaMap::new(&cx), ids: ref_in(&cx, 0u32), counter, out: new_results(&cx), lend_marked: ArenaSet::new(&cx),
            origins: ArenaMap::new(&cx),
        };
        let scopes = r.scopes.values(&cx);
        i = 0usize;
        while i < scopes.len(&cx) {
            let decls = scopes.at(&cx, i).decls.values(&cx);
            var k = 0usize;
            while k < decls.len(&cx) {
                let decl = decls.at(&cx, k);
                if decl.kind.is(&cx, "struct") || decl.kind.is(&cx, "enum") || decl.kind.is(&cx, "tuple") || decl.kind.is(&cx, "trait") {
                    inf.decl_of.insert(&cx, sigs.name(&cx, decl), decl);
                }
                let unit = match decl.node {
                    Trait(t) => if decl.kind.is(&cx, "trait") {
                        inf.inputs.insert(&cx, sigs.name(&cx, decl), match t.quantifier {
                            Some(f) => f.params.len(&cx),
                            None => 1usize,
                        });
                    },
                    _ => (),
                };
                k = k + 1usize;
            }
            i = i + 1usize;
        }
        i = 0usize;
        while i < sigs.instances.len(&cx) {
            let (inst, _item, _home) = sigs.instances.at(&cx, i);
            let unit = match inf.instances.get(&cx, inst.trait_name) {
                Some(list) => list.push(&cx, inst),
                None => { inf.instances.insert(&cx, inst.trait_name, ArenaVec::one(&cx, inst)); },
            };
            i = i + 1usize;
        }
        inf
    }

    fn next_id(self, &cx: Domain!['k]) -> u32 {
        let n = self.ids.copy(&cx);
        self.ids.set(&cx, n + 1u32);
        n
    }

    fn run(self, &cx: Domain!['k]) {
        let sigs = self.sigs.sigs.values(&cx);
        var i = 0usize;
        while i < sigs.len(&cx) {
            let sig = sigs.at(&cx, i);
            let unit = match sig.decl {
                Some(decl) => match decl.node {
                    Fn(node) => if node.body.is_some() {
                        self.r.locate(&cx, decl.home, node.pos);
                        self.function(&cx, sig, node, decl.home, Option::None);
                        self.r.unlocate(&cx);
                    },
                    _ => (),
                },
                None => (),
            };
            i = i + 1usize;
        }
        i = 0usize;
        while i < self.sigs.instances.len(&cx) {
            let (inst, item, home) = self.sigs.instances.at(&cx, i);
            var k = 0usize;
            while k < inst.methods.len(&cx) {
                let node = item.methods.at(&cx, k);
                self.r.locate(&cx, home, node.pos);
                self.function(&cx, inst.methods.at(&cx, k), node, home, Option::Some.(inst));
                self.r.unlocate(&cx);
                k = k + 1usize;
            }
            i = i + 1usize;
        }
    }

    fn function(self, &cx: Domain!['k], sig: Sig['k], node: S::Fn['k], home: ModuleId['k], inst: Option[InstanceSig['k]]) {
        let kinds: ArenaMap[Str['k], Kind, 'k] = ArenaMap::new(&cx);
        var i = 0usize;
        while i < sig.params.len(&cx) {
            kinds.insert(&cx, sig.params.at(&cx, i).name, sig.params.at(&cx, i).kind);
            i = i + 1usize;
        }
        let assumptions = sig.premises.clone(&cx);
        let unit = match inst {
            Some(x) => assumptions.push(&cx, Premise.{ trait_name: x.trait_name, args: x.head }),
            None => (),
        };
        let level = new_level(&cx);
        let b = Body.{
            inf: self, home, sig, kinds, assumptions, waiting: ArenaVec::new(&cx), defaults: ArenaVec::new(&cx), recorded: ArenaVec::new(&cx),
            literals: ArenaVec::new(&cx), brand_checks: ArenaVec::new(&cx), foreaches: ArenaMap::new(&cx), open_binders: ref_in(&cx, List::empty()),
            binder_checks: ArenaVec::new(&cx), capture_checks: ArenaVec::new(&cx), instantiations: ArenaVec::new(&cx), unwritten: ArenaVec::new(&cx), solving: ref_in(&cx, false), returns: ArenaVec::one(&cx, sig.ret),
            scopes: ref_in(&cx, List::empty().cons(&cx, level)), frames: ArenaVec::one(&cx, new_frame(&cx)), allowed: ref_in(&cx, Option::None),
            fstring_lent: ref_in(&cx, Option::None),
        };
        let ids: ArenaVec[u32, 'k] = ArenaVec::new(&cx);
        i = 0usize;
        while i < sig.pnames.len(&cx) {
            let local = Local.{ ty: sig.ptypes.at(&cx, i), mutable: has_place(&cx, sig.places, i), rest: Option::None, depth: 0usize, id: self.next_id(&cx) };
            level.names.insert(&cx, sig.pnames.at(&cx, i), local);
            ids.push(&cx, local.id);
            i = i + 1usize;
        }
        self.out.param_ids.insert(&cx, node.id, ids);
        let body = match node.body {
            Some(block) => block,
            None => return,
        };
        let unit = b.check(&cx, Expr::Block.(body), Option::Some.(sig.ret));
        b.finish(&cx);
    }

    // The traits a name in `home`'s scope resolves to: declared, imported by name or glob, or
    // re-exported. A glob's names are those its source module declares, imports or exports, and every
    // trait's own name.
    fn visible_traits(self, &cx: Domain!['k], home: ModuleId['k]) -> ArenaSet[u32, 'k] {
        let unit = match self.visible.get(&cx, home) {
            Some(found) => return found,
            None => (),
        };
        let scope = self.r.scopes.at(&cx, home);
        let names: ArenaVec[Str['k], 'k] = scope.decls.keys(&cx);
        names.append(&cx, scope.imports.keys(&cx));
        let decls = self.decl_of.values(&cx);
        var i = 0usize;
        while i < decls.len(&cx) {
            if decls.at(&cx, i).kind.is(&cx, "trait") {
                names.push(&cx, decls.at(&cx, i).name);
            }
            i = i + 1usize;
        }
        i = 0usize;
        while i < scope.globs.len(&cx) {
            let unit = match self.r.lookup(&cx, home, scope.globs.at(&cx, i), no_pos()) {
                Ok(t) => match t {
                    Module(m) => match self.r.scopes.get(&cx, m) {
                        Some(other) => {
                            names.append(&cx, other.decls.keys(&cx));
                            names.append(&cx, other.imports.keys(&cx));
                            names.append(&cx, other.exports.keys(&cx));
                        },
                        None => (),
                    },
                    _ => (),
                },
                Err(_e) => (),
            };
            i = i + 1usize;
        }
        let found: ArenaSet[u32, 'k] = ArenaSet::new(&cx);
        let tried: ArenaSet[Str['k], 'k] = ArenaSet::new(&cx);
        i = 0usize;
        while i < names.len(&cx) {
            let name = names.at(&cx, i);
            if !tried.contains(&cx, name) {
                tried.insert(&cx, name);
                let unit = match self.r.lookup(&cx, home, ArenaVec::one(&cx, name), no_pos()) {
                    Ok(t) => match t {
                        Decl(d) => if d.kind.is(&cx, "trait") {
                            found.insert(&cx, d.id);
                        },
                        _ => (),
                    },
                    Err(_e) => (),
                };
            }
            i = i + 1usize;
        }
        self.visible.insert(&cx, home, found);
        found
    }

    // A blanket impl's method is found from a package that is the impl's or depends on it directly,
    // when every trait bounding the impl's type parameter is visible there (and it has one).
    // `package` is `target` or depends on it, directly or through other packages.
    fn depends_on(self, &cx: Domain!['k], package: usize, target: usize) -> bool {
        // The walk's worklist and the packages it has seen are its own, freed when it ends.
        var seen = OwnedMap!::new[usize, bool](seed(&cx));
        var pending = OwnedVec!::new[usize]();
        &pending.push(package);
        var found = false;
        var going = true;
        while going {
            match &pending.pop() {
                Some(p) => {
                    if p == target {
                        found = true;
                        going = false;
                    } else {
                        match &seen.insert(p, true) {
                            None => {
                                let deps = self.r.packages.at(&cx, p).deps;
                                var i = 0usize;
                                while i < deps.positions(&cx) {
                                    match deps.key_at(&cx, i) {
                                        Some(name) => {
                                            &pending.push(deps.at(&cx, name));
                                        },
                                        None => (),
                                    };
                                    i = i + 1usize;
                                }
                            },
                            Some(old) => (),
                        };
                    }
                },
                None => {
                    going = false;
                },
            };
        }
        pending.destroy();
        seen.destroy();
        found
    }

    // A blanket impl's method is found from a package that is the impl's or depends on it, directly
    // or through other packages, when every trait bounding the impl's type parameter is visible there
    // (and it has one).
    fn blanket_visible(self, &cx: Domain!['k], method: Decl['k], home: ModuleId['k], visible: ArenaSet[u32, 'k]) -> bool {
        let bounds = self.blanket_bounds(&cx, method, home);
        var i = 0usize;
        while i < bounds.len(&cx) {
            if !visible.contains(&cx, bounds.at(&cx, i).id) {
                return false;
            }
            i = i + 1usize;
        }
        !bounds.is_empty(&cx)
    }

    // The traits bounding the type parameter of a blanket impl's method, none when `home`'s package is
    // not the impl's and does not depend on it.
    fn blanket_bounds(self, &cx: Domain!['k], method: Decl['k], home: ModuleId['k]) -> ArenaVec[Decl['k], 'k] {
        let bounds: ArenaVec[Decl['k], 'k] = ArenaVec::new(&cx);
        if !self.depends_on(&cx, home.package, method.home.package) {
            return bounds;
        }
        let impl_block = match method.impl_block {
            Some(b) => b,
            None => return bounds,
        };
        let param = match impl_block.ty {
            Name(n) => n.path.at(&cx, 0usize),
            _ => return bounds,
        };
        let premises = match impl_block.quantifier {
            Some(f) => f.premises,
            None => return bounds,
        };
        var i = 0usize;
        while i < premises.len(&cx) {
            let args = premises.at(&cx, i).args;
            let bounding = if args.args.is_empty(&cx) {
                false
            } else {
                match args.args.at(&cx, 0usize) {
                    Name(n) => n.path.len(&cx) == 1usize && n.path.at(&cx, 0usize).eq(&cx, param),
                    _ => false,
                }
            };
            if bounding {
                let unit = match self.r.refs.get(&cx, args.id) {
                    Some(r) => match r {
                        Decl(d) => bounds.push(&cx, d),
                        _ => (),
                    },
                    None => (),
                };
            }
            i = i + 1usize;
        }
        bounds
    }
}

// One function body being inferred.
forall 'k.
exposed struct Body {
    inf: Infer['k],
    home: ModuleId['k],
    sig: Sig['k],
    kinds: ArenaMap[Str['k], Kind, 'k],
    assumptions: ArenaVec[Premise['k], 'k],
    waiting: ArenaVec[Waiter['k], 'k],
    defaults: ArenaVec[PackWait['k], 'k],
    recorded: ArenaVec[u32, 'k],
    literals: ArenaVec[Meta['k], 'k],
    brand_checks: ArenaVec[(Type['k], ArenaSet[Str['k], 'k], Pos), 'k],
    // the binder of each `foreach`, with its item's name and where it is
    foreaches: ArenaMap[Str['k], (Str['k], Pos), 'k],
    // the binders whose `foreach` bodies are open
    open_binders: Ref[List[Str['k], 'k], 'k],
    // each local's type, with the binders open where it was bound
    binder_checks: ArenaVec[(Type['k], List[Str['k], 'k]), 'k],
    // each local a foreach body captures: its name, its type and where it is first used there
    capture_checks: ArenaVec[(Str['k], Type['k], Pos), 'k],
    // each instantiation of a generic declaration: its parameters, their metavariables, the name it
    // is used by, and where
    instantiations: ArenaVec[(ArenaVec[Param['k], 'k], ArenaMap[Str['k], Type['k], 'k], Str['k], Pos), 'k],
    // each type no source writes that the body must determine: the type, what it is, and where
    unwritten: ArenaVec[(Type['k], Str['k], Pos), 'k],
    solving: Ref[bool, 'k],
    returns: ArenaVec[Type['k], 'k],
    // the scopes open, innermost first
    scopes: Ref[List[Level['k], 'k], 'k],
    frames: ArenaVec[Frame['k], 'k],
    // the brands a type recorded here may mention, until a scope opens or closes some
    allowed: Ref[Option[ArenaSet[Str['k], 'k]], 'k],
    // the id of the local whose place `f"...".write(&cx, out)` lends while its `{x}` are inferred
    fstring_lent: Ref[Option[u32], 'k],
}

forall 'k.
impl Body['k] {
    fn fail(self, &cx: Domain!['k], message: Str['k], pos: Pos) -> ! {
        self.inf.r.fail(&cx, message, pos)
    }

    fn fails(self, &cx: Domain!['k], message: Str['static], pos: Pos) -> ! {
        self.inf.r.fail(&cx, Str::from_static(&cx, message), pos)
    }

    fn results(self) -> Results['k] {
        self.inf.out
    }

    fn type_of(self, &cx: Domain!['k], id: u32) -> Type['k] {
        self.inf.out.types.at(&cx, id)
    }

    // Finish pending inference, report unresolved requirements, and normalize annotations for lowering.
    fn finish(self, &cx: Domain!['k]) {
        self.solve(&cx);
        self.run_defaults(&cx);
        if !self.waiting.is_empty(&cx) {
            self.fails(&cx, "a type here is not known yet; annotate it", self.waiting.at(&cx, 0usize).pos);
        }
        var i = 0usize;
        while i < self.literals.len(&cx) {
            let m = self.literals.at(&cx, i);
            if is_unsolved(&cx, Type::Meta.(m)) {
                let what = match m.kind(&cx) {
                    Float => "a float",
                    _ => "an integer",
                };
                self.fail(&cx, Buffer!::new().put(what).put(" literal's type is not determined; write a suffix").save(&cx), m.pos(&cx));
            }
            i = i + 1usize;
        }
        i = 0usize;
        while i < self.brand_checks.len(&cx) {
            let (ty, allowed, pos) = self.brand_checks.at(&cx, i);
            let brands = free_brands(&cx, zonk(&cx, ty)).keys(&cx);
            var least: Option[Str['k]] = Option::None;
            var k = 0usize;
            while k < brands.len(&cx) {
                let b = brands.at(&cx, k);
                if !allowed.contains(&cx, b) {
                    least = match least {
                        Some(l) => if b.cmp(&cx, l).is_lt() { Option::Some.(b) } else { Option::Some.(l) },
                        None => Option::Some.(b),
                    };
                }
                k = k + 1usize;
            }
            let unit = match least {
                Some(b) => self.fail(&cx, Buffer!::new().put("brand ").write(&cx, self.shown(&cx, Type::Skolem.(b))).put(" escapes its lexical scope").save(&cx), pos),
                None => (),
            };
            i = i + 1usize;
        }
        i = 0usize;
        while i < self.binder_checks.len(&cx) && !self.foreaches.is_empty(&cx) {
            let (ty, open_binders) = self.binder_checks.at(&cx, i);
            let names = free_names(&cx, zonk(&cx, ty)).keys(&cx);
            var least: Option[Str['k]] = Option::None;
            var k = 0usize;
            while k < names.len(&cx) {
                let b = names.at(&cx, k);
                if self.foreaches.contains(&cx, b) && !open_binders.any(&cx, |&cx, open: Str['k]| open.eq(&cx, b)) {
                    least = match least {
                        Some(l) => if b.cmp(&cx, l).is_lt() { Option::Some.(b) } else { Option::Some.(l) },
                        None => Option::Some.(b),
                    };
                }
                k = k + 1usize;
            }
            let unit = match least {
                Some(b) => {
                    let (item, pos) = self.foreaches.at(&cx, b);
                    self.fail(&cx, f"the type of foreach item {item} escapes its lexical scope".write(&cx, Buffer!::new()).save(&cx), pos)
                },
                None => (),
            };
            i = i + 1usize;
        }
        i = 0usize;
        while i < self.unwritten.len(&cx) {
            let (ty, what, pos) = self.unwritten.at(&cx, i);
            if !ground(&cx, ty) {
                self.fail(&cx, Buffer!::new().put("cannot infer the ").write(&cx, what).save(&cx), pos);
            }
            i = i + 1usize;
        }
        i = 0usize;
        while i < self.instantiations.len(&cx) {
            let (params, sub, owner, pos) = self.instantiations.at(&cx, i);
            var k = 0usize;
            while k < params.len(&cx) {
                let p = params.at(&cx, k);
                if !ground(&cx, sub.at(&cx, p.name)) {
                    let argument = if is_brand(p.kind) { brand_name(&cx, p.name) } else { surface(&cx, ArenaVec::new(&cx), ArenaVec::new(&cx), ArenaMap::new(&cx)).name(&cx, p.name) };
                    self.fail(&cx, f"cannot infer the type argument {argument} of {owner}".write(&cx, Buffer!::new()).save(&cx), pos);
                }
                k = k + 1usize;
            }
            i = i + 1usize;
        }
        i = 0usize;
        while i < self.capture_checks.len(&cx) {
            let (name, ty, pos) = self.capture_checks.at(&cx, i);
            if !self.inf.types.is_copy(&cx, zonk(&cx, ty), self.kinds) {
                self.fail(&cx, Buffer!::new().write(&cx, name).put(" is captured by a foreach body, which runs once for each component: a capture must be Copy").save(&cx), pos);
            }
            i = i + 1usize;
        }
        let out = self.results();
        i = 0usize;
        while i < self.recorded.len(&cx) {
            let id = self.recorded.at(&cx, i);
            out.types.insert(&cx, id, zonk(&cx, out.types.at(&cx, id)));
            let unit = match out.options.get(&cx, id) {
                Some(t) => {
                    out.options.insert(&cx, id, zonk(&cx, t));
                    zonk_all(&cx, out.next_calls.at(&cx, id).targs);
                },
                None => (),
            };
            let unit = match out.calls.get(&cx, id) {
                Some(call) => match call {
                    Fn(f) => zonk_map(&cx, f.sub),
                    Trait(t) => zonk_all(&cx, t.targs),
                    TypedBuiltin(name, t) => { out.calls.insert(&cx, id, Callee::TypedBuiltin.(name, zonk(&cx, t))); },
                    _ => (),
                },
                None => (),
            };
            i = i + 1usize;
        }
    }

    // ---- the solver
    // Run `action` once `ready` holds.
    fn wait(self, &cx: Domain!['k], ready: Ready['k], action: Action['k], pos: Pos) {
        self.waiting.push(&cx, Waiter.{ ready, action, pos });
        self.solve(&cx);
    }

    // Run `action` once the head of the type `ty` is known.
    fn later(self, &cx: Domain!['k], ty: Type['k], action: Action['k], pos: Pos) {
        self.wait(&cx, Ready::Head.(ty), action, pos);
    }

    fn ready(self, &cx: Domain!['k], r: Ready['k]) -> bool {
        match r {
            Head(t) => !is_unsolved(&cx, t),
            Ground(ts, n) => {
                var i = 0usize;
                while i < n && i < ts.len(&cx) {
                    if !settled(&cx, ts.at(&cx, i)) {
                        return false;
                    }
                    i = i + 1usize;
                }
                true
            },
            Filled(b) => b.filled.copy(&cx),
            Both(a, b) => !is_unsolved(&cx, a) && !is_unsolved(&cx, b),
        }
    }

    // Drain ready actions; a nested call leaves its work to the active solver loop. Each pass runs
    // the waiters present when it began, in order; the others are kept in place, in order, followed
    // by the ones added during the pass.
    fn solve(self, &cx: Domain!['k]) {
        if self.solving.copy(&cx) {
            return;
        }
        self.solving.set(&cx, true);
        var progress = true;
        while progress {
            progress = false;
            let n = self.waiting.len(&cx);
            var kept = 0usize;
            var i = 0usize;
            while i < n {
                let item = self.waiting.at(&cx, i);
                if self.ready(&cx, item.ready) {
                    self.act(&cx, item.action, item.pos);
                    progress = true;
                } else {
                    self.waiting.set(&cx, kept, item);
                    kept = kept + 1usize;
                }
                i = i + 1usize;
            }
            var j = n;
            while j < self.waiting.len(&cx) {
                self.waiting.set(&cx, kept, self.waiting.at(&cx, j));
                kept = kept + 1usize;
                j = j + 1usize;
            }
            self.waiting.truncate(&cx, kept);
        }
        self.solving.set(&cx, false);
    }

    // What is still unknown when nothing else can run takes its default.
    fn run_defaults(self, &cx: Domain!['k]) {
        while !self.defaults.is_empty(&cx) {
            let wait = self.defaults.remove(&cx, 0usize);
            if is_unsolved(&cx, wait.result) {
                self.pack_default(&cx, wait);
                self.solve(&cx);
            }
        }
    }

    fn act(self, &cx: Domain!['k], action: Action['k], pos: Pos) {
        match action {
            Copy(ty) => if !self.inf.types.is_copy(&cx, zonk(&cx, ty), self.kinds) {
                self.fails(&cx, "type argument must satisfy Copy", pos);
            },
            Discharge(trait_name, args, n) => self.discharge(&cx, trait_name, args, n, pos),
            Placeholder(p) => if equal(&cx, zonk(&cx, p.value), self.static_str(&cx)) {
                self.results().static_parts.insert(&cx, p.id);
            } else {
                self.require(&cx, self.library(&cx, "Format"), ArenaVec::two(&cx, p.value, p.writer), pos);
            },
            Elements(e) => self.elements(&cx, e, pos),
            Fields(f) => self.fields_known(&cx, f, pos),
            Primitive(op, operand, unary) => self.primitive(&cx, op, operand, unary, pos),
            Fill(result, elem) => {
                match self.shape(&cx, result, pos) {
                    Array(want, _n) => self.unify_at(&cx, elem, want.copy(&cx), pos),
                    _ => self.fails(&cx, "an array literal with `..` needs its length from the expected type", pos),
                }
            },
            Spread(s) => {
                let names = s.fields.keys(&cx);
                var i = 0usize;
                while i < names.len(&cx) {
                    let name = names.at(&cx, i);
                    if !s.given.contains(&cx, name) {
                        let have = match s.bundle.types.get(&cx, name) {
                            Some(t) => t,
                            None => self.fail(&cx, f"..{s.spread} has no field {name}".write(&cx, Buffer!::new()).save(&cx), pos),
                        };
                        self.unify_at(&cx, have, s.fields.at(&cx, name), pos);
                    }
                    i = i + 1usize;
                }
            },
            VisibleShape(ty) => self.require_visible_shape(&cx, ty, pos),
            Integer(ty) => {
                let integer = match self.shape(&cx, ty, pos) {
                    Prim(name) => C::is_integer(&cx, name),
                    _ => false,
                };
                if !integer {
                    self.fails(&cx, "value patterns need an integer scrutinee", pos);
                }
            },
            Pack(p) => {
                let want = self.shape(&cx, p.result, pos);
                let (binders, body) = match want {
                    Exists(binders, body) => (binders, body.copy(&cx)),
                    _ => self.fails(&cx, "pack does not match the type it is used at", pos),
                };
                if binders.len(&cx) != p.labels.len(&cx) {
                    self.fails(&cx, "pack does not match the type it is used at", pos);
                }
                let sub: ArenaMap[Str['k], Type['k], 'k] = ArenaMap::new(&cx);
                var i = 0usize;
                while i < binders.len(&cx) {
                    sub.insert(&cx, binders.at(&cx, i), Type::Skolem.(p.labels.at(&cx, i)));
                    i = i + 1usize;
                }
                self.unify_at(&cx, p.value, subst(&cx, body, sub, self.inf.counter), pos);
            },
            Try(t) => {
                let found = self.resolve_try(&cx, t, pos);
                self.unify_at(&cx, t.result, found, no_pos());
            },
            Component(c) => self.component(&cx, c, pos),
            CallValue(c) => self.call_known(&cx, c, pos),
            Method(m) => {
                let found = self.resolve_method(&cx, m.call, m.receiver, m.name, m.actual, m.got);
                self.unify_at(&cx, m.result, found, pos);
            },
            EnumOperand(operand) => {
                self.require_visible_shape(&cx, operand, pos);
                match self.shape(&cx, operand, pos) {
                    Enum(_v) => (),
                    _ => self.fails(&cx, "enum_variant requires an enum operand", pos),
                }
            },
            Pointer(p) => self.pointer_known(&cx, p, pos),
        }
    }

    // A fresh metavariable for each of `params`, the parameters of `owner` used at `pos`; each must be
    // solved by the end of the body.
    fn instantiate_at(self, &cx: Domain!['k], params: ArenaVec[Param['k], 'k], owner: Str['k], pos: Pos) -> ArenaMap[Str['k], Type['k], 'k] {
        let sub = instantiate(&cx, params);
        self.instantiations.push(&cx, (params, sub, owner, pos));
        sub
    }

    fn unify_at(self, &cx: Domain!['k], a: Type['k], b: Type['k], pos: Pos) {
        if !unify(&cx, a, b, false, self.inf.counter) {
            self.fail(&cx, self.mismatch(&cx, zonk(&cx, a), zonk(&cx, b)), pos);
        }
        self.solve(&cx);
    }

    // Why `a` and `b` failed to unify. Unification is symmetric and its callers pass the two sides
    // in no fixed order, so the message names neither as the expected one. Types that differ only
    // in brands are a brand mismatch, which says where a `let exists` opened each brand that
    // differs.
    fn mismatch(self, &cx: Domain!['k], a: Type['k], b: Type['k]) -> Str['k] {
        let origins = self.inf.origins;
        let spelling = surface(&cx, ArenaVec::two(&cx, a, b), ArenaVec::new(&cx), origins);
        let brands = match brand_differences(&cx, a, b) {
            Some(found) => found,
            None => ArenaVec::new(&cx),
        };
        var out = Buffer!::new().put(if brands.is_empty(&cx) { "type mismatch: " } else { "brand mismatch: " })
            .write(&cx, spelling.show(&cx, a)).put(" and ").write(&cx, spelling.show(&cx, b));
        var listed = 0usize;
        var i = 0usize;
        while i < brands.len(&cx) {
            let label = brands.at(&cx, i);
            let unit = match origins.get(&cx, label) {
                Some(at) => if !spelling.qualified.contains(&cx, label) {
                    out = out.put(if listed == 0usize { "; " } else { ", " }).write(&cx, spelling.brand(&cx, label))
                        .put(if listed == 0usize { " was opened at " } else { " at " }).put(at.line).put(":").put(at.col);
                    listed = listed + 1usize;
                },
                None => (),
            };
            i = i + 1usize;
        }
        out.save(&cx)
    }

    // `ty` as a message writes it.
    fn shown(self, &cx: Domain!['k], ty: Type['k]) -> Str['k] {
        surface(&cx, ArenaVec::one(&cx, ty), ArenaVec::new(&cx), self.inf.origins).show(&cx, ty)
    }

    fn coerce(self, &cx: Domain!['k], actual: Type['k], expected: Option[Type['k]], pos: Pos) {
        let unit = match expected {
            Some(want) => if !is_never(&cx, actual) {
                self.unify_at(&cx, actual, want, pos);
            },
            None => (),
        };
    }

    fn join(self, &cx: Domain!['k], a: Type['k], b: Type['k], pos: Pos) -> Type['k] {
        if is_never(&cx, a) {
            return b;
        }
        if !is_never(&cx, b) {
            self.unify_at(&cx, a, b, pos);
        }
        a
    }

    // The structure of `ty`, needed now: a type still unknown takes its defaults, else it is an error.
    fn shape(self, &cx: Domain!['k], ty: Type['k], pos: Pos) -> Type['k] {
        if is_unsolved(&cx, ty) {
            self.solve(&cx);
            self.run_defaults(&cx);
        }
        let ty = zonk(&cx, ty);
        match ty {
            Meta(_m) => self.fails(&cx, "the type here is not known yet; annotate it", pos),
            Named(name, _args) => if self.inf.types.program.types.contains(&cx, name) {
                self.inf.types.shape(&cx, ty, Option::None)
            } else {
                ty
            },
            // A foreach whose rows a type parameter decides has no shape here, as the parameter has none.
            Foreach(f) => if self.inf.types.rows_fixed(&cx, f.source.copy(&cx), f.indirect, self.kinds) {
                self.inf.types.shape(&cx, ty, Option::None)
            } else {
                ty
            },
            _ => ty,
        }
    }

    // ---- premises
    // Check nominal authority at shape-using source operations, not type uses.
    fn require_visible_shape(self, &cx: Domain!['k], ty: Type['k], pos: Pos) {
        let unit = match prune(&cx, ty) {
            Named(name, _args) => match self.inf.types.program.types.get(&cx, name) {
                Some(decl) => if !self.inf.types.is_exposed(&cx, decl, Option::Some.(self.home)) {
                    self.fail(&cx, f"the shape of {name} is not exposed here".write(&cx, Buffer!::new()).save(&cx), pos);
                },
                None => (),
            },
            _ => (),
        };
    }

    fn require_copy(self, &cx: Domain!['k], ty: Type['k], pos: Pos) {
        self.wait(&cx, Ready::Ground.(ArenaVec::one(&cx, ty), 1usize), Action::Copy.(ty), pos);
    }

    fn require_parameter_kinds(self, &cx: Domain!['k], params: ArenaVec[Param['k], 'k], sub: ArenaMap[Str['k], Type['k], 'k], pos: Pos) {
        var i = 0usize;
        while i < params.len(&cx) {
            let p = params.at(&cx, i);
            if is_copy_kind(p.kind) {
                self.require_copy(&cx, sub.at(&cx, p.name), pos);
            }
            i = i + 1usize;
        }
    }

    // Discharge a premise once its input arguments are known.
    fn require(self, &cx: Domain!['k], trait_name: Str['k], args: ArenaVec[Type['k], 'k], pos: Pos) {
        let n = self.inf.inputs.get_or(&cx, trait_name, args.len(&cx));
        self.wait(&cx, Ready::Ground.(args, n), Action::Discharge.(trait_name, args, n), pos);
    }

    // An assumption or a unique matching instance solves the output arguments.
    fn discharge(self, &cx: Domain!['k], trait_name: Str['k], args: ArenaVec[Type['k], 'k], n: usize, pos: Pos) {
        if trait_name.is(&cx, "Exposed") {
            let source = zonk(&cx, args.at(&cx, 0usize));
            if !self.inf.types.exposure_available(&cx, source, Option::Some.(self.home), self.kinds, self.assumptions) {
                // Neither a foreach type nor a pointer to a sum is exposed by its shape.
                let unit = match source {
                    Foreach(_f) => self.fails(&cx, FOREACH_OF_FOREACH, pos),
                    _ => (),
                };
                if self.inf.types.points_to_sum(&cx, source, self.kinds) {
                    self.fails(&cx, POINTER_TO_SUM, pos);
                }
                let shown = self.shown(&cx, source);
                self.fail(&cx, f"the shape of {shown} is not visible here: write `where Exposed[{shown}]`, or expose its declaration to this module".write(&cx, Buffer!::new()).save(&cx), pos);
            }
            return;
        }
        if trait_name.is(&cx, "Sized") {
            if !self.inf.types.sized_available(&cx, zonk(&cx, args.at(&cx, 0usize)), self.assumptions) {
                self.fails(&cx, "Sized requires an exact premise or a part whose size is not zero whatever the type parameters are", pos);
            }
            return;
        }
        let count = if n < args.len(&cx) { n } else { args.len(&cx) };
        let inputs: ArenaVec[Type['k], 'k] = ArenaVec::new(&cx);
        var i = 0usize;
        while i < count {
            inputs.push(&cx, zonk(&cx, args.at(&cx, i)));
            i = i + 1usize;
        }
        i = 0usize;
        while i < self.assumptions.len(&cx) {
            let p = self.assumptions.at(&cx, i);
            if p.trait_name.eq(&cx, trait_name) && p.args.len(&cx) == args.len(&cx) {
                var matches = true;
                var k = 0usize;
                while matches && k < count {
                    matches = equal(&cx, zonk(&cx, p.args.at(&cx, k)), inputs.at(&cx, k));
                    k = k + 1usize;
                }
                if matches {
                    k = count;
                    while k < args.len(&cx) {
                        self.unify_at(&cx, p.args.at(&cx, k), args.at(&cx, k), pos);
                        k = k + 1usize;
                    }
                    return;
                }
            }
            i = i + 1usize;
        }
        let found: ArenaVec[(InstanceSig['k], ArenaMap[Str['k], Type['k], 'k]), 'k] = ArenaVec::new(&cx);
        let candidates = self.inf.instances.get_or(&cx, trait_name, ArenaVec::new(&cx));
        i = 0usize;
        while i < candidates.len(&cx) {
            let inst = candidates.at(&cx, i);
            let head_count = if count < inst.head.len(&cx) { count } else { inst.head.len(&cx) };
            let unit = match match_head(&cx, inst.params, inst.head.slice(&cx, 0usize, head_count), inputs, false, self.inf.counter) {
                Some(sub) => if self.copy_ok(&cx, inst, sub) {
                    found.push(&cx, (inst, sub));
                },
                None => (),
            };
            i = i + 1usize;
        }
        if found.len(&cx) != 1usize {
            let concrete: ArenaVec[Type['k], 'k] = ArenaVec::new(&cx);
            var k = 0usize;
            while k < args.len(&cx) {
                concrete.push(&cx, zonk(&cx, args.at(&cx, k)));
                k = k + 1usize;
            }
            let spelling = surface(&cx, concrete, ArenaVec::one(&cx, trait_name), self.inf.origins);
            var shown = Buffer!::new().put(if found.is_empty(&cx) { "no instance" } else { "several instances" }).put(" of ")
                .write(&cx, spelling.name(&cx, trait_name)).put("[");
            k = 0usize;
            while k < concrete.len(&cx) {
                if k > 0usize {
                    shown = shown.put(", ");
                }
                shown = shown.write(&cx, spelling.show(&cx, concrete.at(&cx, k)));
                k = k + 1usize;
            }
            self.fail(&cx, shown.put("]").save(&cx), pos);
        }
        let (inst, sub) = found.at(&cx, 0usize);
        i = 0usize;
        while i < inst.params.len(&cx) {
            let p = inst.params.at(&cx, i);
            if !sub.contains(&cx, p.name) {
                sub.insert(&cx, p.name, meta_of(&cx, p.kind));
            }
            i = i + 1usize;
        }
        i = 0usize;
        while i < inst.head.len(&cx) && i < args.len(&cx) {
            self.unify_at(&cx, subst(&cx, inst.head.at(&cx, i), sub, self.inf.counter), args.at(&cx, i), pos);
            i = i + 1usize;
        }
        i = 0usize;
        while i < inst.premises.len(&cx) {
            let premise = inst.premises.at(&cx, i);
            self.require(&cx, premise.trait_name, self.subst_all(&cx, premise.args, sub), pos);
            i = i + 1usize;
        }
    }

    fn copy_ok(self, &cx: Domain!['k], inst: InstanceSig['k], sub: ArenaMap[Str['k], Type['k], 'k]) -> bool {
        var i = 0usize;
        while i < inst.params.len(&cx) {
            let p = inst.params.at(&cx, i);
            if is_copy_kind(p.kind) {
                let unit = match sub.get(&cx, p.name) {
                    Some(t) => if !self.inf.types.is_copy(&cx, t, self.kinds) {
                        return false;
                    },
                    None => (),
                };
            }
            i = i + 1usize;
        }
        true
    }

    fn subst_all(self, &cx: Domain!['k], ts: ArenaVec[Type['k], 'k], sub: ArenaMap[Str['k], Type['k], 'k]) -> ArenaVec[Type['k], 'k] {
        let out: ArenaVec[Type['k], 'k] = ArenaVec::new(&cx);
        var i = 0usize;
        while i < ts.len(&cx) {
            out.push(&cx, subst(&cx, ts.at(&cx, i), sub, self.inf.counter));
            i = i + 1usize;
        }
        out
    }

    // ---- scopes
    fn record(self, &cx: Domain!['k], id: u32, pos: Pos, ty: Type['k]) -> Type['k] {
        self.inf.out.types.insert(&cx, id, ty);
        self.check_brand_scope(&cx, ty, pos);
        self.recorded.push(&cx, id);
        ty
    }

    fn library(self, &cx: Domain!['k], name: Str['static]) -> Str['k] {
        self.inf.sigs.name(&cx, self.inf.sigs.library(&cx, self.home, Str::from_static(&cx, name)))
    }

    // The local `name`, used at `pos`.
    fn lookup(self, &cx: Domain!['k], name: Str['k], pos: Pos) -> Option[Local['k]] {
        let found = self.scopes.copy(&cx).find_map(&cx, |&cx, level: Level['k]| level.names.get(&cx, name));
        match found {
            Some(local) => {
                match self.fstring_lent.copy(&cx) {
                    Some(id) => if id == local.id {
                        self.fail(&cx, Buffer!::new().write(&cx, name).put(" is lent to this f-string; it cannot be used inside it").save(&cx), pos);
                    },
                    None => (),
                }
                // every closure it is used inside captures it
                var f = local.depth + 1usize;
                while f < self.frames.len(&cx) {
                    let frame = self.frames.at(&cx, f);
                    if !frame.locals.any(&cx, |&cx, seen: (Str['k], Local['k], Pos)| seen.1.id == local.id) {
                        frame.locals.push(&cx, (name, local, pos));
                    }
                    f = f + 1usize;
                }
                Option::Some.(local)
            },
            None => Option::None,
        }
    }

    fn bind(self, &cx: Domain!['k], name: Str['k], ty: Type['k], mutable: bool, rest: Option[Bundle['k]]) -> Local['k] {
        self.check_brand_scope(&cx, ty, no_pos());
        self.binder_checks.push(&cx, (ty, self.open_binders.copy(&cx)));
        let local = Local.{ ty: ty, mutable, rest, depth: self.frames.len(&cx) - 1usize, id: self.inf.next_id(&cx) };
        self.level(&cx).names.insert(&cx, name, local);
        local
    }

    // The scopes open, outermost first.
    fn outward(self, &cx: Domain!['k]) -> List[Level['k], 'k] {
        self.scopes.copy(&cx).reverse(&cx, List::empty())
    }

    fn brand_sub(self, &cx: Domain!['k]) -> ArenaMap[Str['k], Type['k], 'k] {
        let out: ArenaMap[Str['k], Type['k], 'k] = ArenaMap::new(&cx);
        self.outward(&cx).each(&cx, |&cx, level: Level['k]| level.brands.each(&cx, |&cx, spelling: Str['k], witness: Str['k]| {
            out.insert(&cx, spelling, Type::Skolem.(witness));
        }));
        out
    }

    // Opens a scope inside the innermost one.
    fn enter(self, &cx: Domain!['k]) {
        self.scopes.set(&cx, self.scopes.copy(&cx).cons(&cx, new_level(&cx)));
    }

    // The innermost scope.
    fn level(self, &cx: Domain!['k]) -> Level['k] {
        match self.scopes.copy(&cx).first(&cx) {
            Some(level) => level,
            None => fail_static("internal error: no scope is open"),
        }
    }

    fn leave(self, &cx: Domain!['k]) {
        let level = self.level(&cx);
        self.scopes.set(&cx, self.scopes.copy(&cx).tail(&cx));
        if level.brands.len(&cx) != 0usize {
            self.allowed.set(&cx, Option::None);
        }
    }

    // Checked after solving: an outer metavariable may acquire a local brand later.
    fn check_brand_scope(self, &cx: Domain!['k], ty: Type['k], pos: Pos) {
        let unit = match self.allowed.copy(&cx) {
            Some(allowed) => {
                self.brand_checks.push(&cx, (ty, allowed, pos));
                return;
            },
            None => (),
        };
        let allowed: ArenaSet[Str['k], 'k] = ArenaSet::new(&cx);
        var i = 0usize;
        while i < self.sig.params.len(&cx) {
            if is_brand(self.sig.params.at(&cx, i).kind) {
                allowed.insert(&cx, self.sig.params.at(&cx, i).name);
            }
            i = i + 1usize;
        }
        allowed.insert(&cx, Str::from_static(&cx, "static"));
        self.outward(&cx).each(&cx, |&cx, level: Level['k]| level.brands.each(&cx, |&cx, spelling: Str['k], witness: Str['k]| {
            allowed.insert(&cx, witness);
        }));
        self.allowed.set(&cx, Option::Some.(allowed));
        self.brand_checks.push(&cx, (ty, allowed, pos));
    }

    fn core_type(self, &cx: Domain!['k], type_expr: S::Type['k]) -> Type['k] {
        let scope = new_scope(&cx);
        var i = 0usize;
        while i < self.sig.params.len(&cx) {
            let p = self.sig.params.at(&cx, i);
            if is_brand(p.kind) {
                scope.brands.insert(&cx, p.name);
            } else {
                scope.kinds.insert(&cx, p.name, p.kind);
            }
            i = i + 1usize;
        }
        let brands = self.brand_sub(&cx);
        let names = brands.keys(&cx);
        i = 0usize;
        while i < names.len(&cx) {
            scope.brands.insert(&cx, names.at(&cx, i));
            i = i + 1usize;
        }
        // a foreach binder as written names the binder of its own `foreach`
        let sub: ArenaMap[Str['k], Type['k], 'k] = ArenaMap::new(&cx);
        self.open_binders.copy(&cx).each(&cx, |&cx, b: Str['k]| {
            if !made_from(&cx, b).is_empty() {
                sub.insert(&cx, made_from(&cx, b), C::named(b, ArenaVec::new(&cx)));
            }
        });
        i = 0usize;
        while i < names.len(&cx) {
            sub.insert(&cx, names.at(&cx, i), brands.at(&cx, names.at(&cx, i)));
            i = i + 1usize;
        }
        subst(&cx, self.inf.sigs.got(&cx, self.inf.sigs.ty(&cx, type_expr, scope)), sub, self.inf.counter)
    }

    fn opt_type(self, &cx: Domain!['k], t: Option[S::Type['k]]) -> Option[Type['k]] {
        match t {
            Some(x) => Option::Some.(self.core_type(&cx, x)),
            None => Option::None,
        }
    }

    // ---- statements
    fn block(self, &cx: Domain!['k], b: S::Block['k]) -> Type['k] {
        self.enter(&cx);
        var diverges = false;
        var i = 0usize;
        while i < b.stmts.len(&cx) {
            if self.stmt(&cx, b.stmts.at(&cx, i)) {
                diverges = true;
            }
            i = i + 1usize;
        }
        let ty = match b.tail {
            Some(tail) => self.expr(&cx, tail.copy(&cx)),
            None => if diverges { Type::Never } else { C::unit(&cx) },
        };
        self.leave(&cx);
        self.record(&cx, b.id, b.pos, ty)
    }

    // Type one statement; true when it cannot complete normally.
    fn stmt(self, &cx: Domain!['k], s: Statement['k]) -> bool {
        match s {
            Let(l) => {
                if !l.brands.is_empty(&cx) {
                    return self.let_exists(&cx, l);
                }
                let want = self.opt_type(&cx, l.ty);
                let got = self.check(&cx, l.value, want);
                self.pattern(&cx, l.pattern, match want {
                    Some(t) => t,
                    None => got,
                }, l.pos, l.mutable);
                is_never(&cx, got)
            },
            Const(c) => {
                let value = self.inf.sigs.got(&cx, self.inf.sigs.typed(&cx, c.name, c.value, self.core_type(&cx, c.ty), self.home));
                self.results().folded.insert(&cx, c.id, value);
                let ty = match const_type(&cx, value) {
                    Some(t) => t,
                    None => self.fails(&cx, "internal error: an untyped local constant", c.pos),
                };
                self.results().binders.insert(&cx, c.id, self.bind(&cx, c.name, ty, false, Option::None).id);
                false
            },
            Assign(a) => {
                let target = self.place_type(&cx, a.target, true, false);
                let unit = self.check(&cx, a.value, Option::Some.(target));
                false
            },
            Expr(n) => is_never(&cx, self.expr(&cx, n.value)),
        }
    }


    fn let_exists(self, &cx: Domain!['k], l: S::Let['k]) -> bool {
        let package = self.shape(&cx, self.expr(&cx, l.value), l.pos);
        let form = if l.mutable { "var exists" } else { "let exists" };
        let opened = match package {
            Exists(binders, body) => if binders.len(&cx) == l.brands.len(&cx) { Option::Some.((binders, body.copy(&cx))) } else { Option::None },
            _ => Option::None,
        };
        let (binders, body) = match opened {
            Some(pair) => pair,
            None => self.fail(&cx, Buffer!::new().put(form).put(" opens ").write(&cx, counted(&cx, l.brands.len(&cx), "brand")).put(" of ").write(&cx, self.shown(&cx, zonk(&cx, package))).save(&cx), l.pos),
        };
        let names: ArenaVec[Str['k], 'k] = ArenaVec::new(&cx);
        let distinct: ArenaSet[Str['k], 'k] = ArenaSet::new(&cx);
        var i = 0usize;
        while i < l.brands.len(&cx) {
            let name = l.brands.at(&cx, i).skip(1usize);
            names.push(&cx, name);
            distinct.insert(&cx, name);
            i = i + 1usize;
        }
        if distinct.len(&cx) != names.len(&cx) {
            self.fails(&cx, "an existential opening repeats a brand name", l.pos);
        }
        let opened_before = self.brand_sub(&cx);
        i = 0usize;
        while i < names.len(&cx) {
            let name = names.at(&cx, i);
            if name.is(&cx, "static") || opened_before.contains(&cx, name) || self.sig.params.any(&cx, |&cx, p: Param['k]| is_brand(p.kind) && p.name.eq(&cx, name)) {
                self.fail(&cx, f"{form} '{name} reuses a brand already in scope".write(&cx, Buffer!::new()).save(&cx), l.pos);
            }
            i = i + 1usize;
        }
        let labels: ArenaVec[Str['k], 'k] = ArenaVec::new(&cx);
        let level = self.level(&cx);
        let sub: ArenaMap[Str['k], Type['k], 'k] = ArenaMap::new(&cx);
        i = 0usize;
        while i < names.len(&cx) {
            let label = Buffer!::new().write(&cx, names.at(&cx, i)).put("#open").put(self.inf.next_id(&cx)).save(&cx);
            labels.push(&cx, label);
            level.brands.insert(&cx, names.at(&cx, i), label);
            if l.pos.line != 0u32 {
                self.inf.origins.insert(&cx, label, l.pos);
            }
            self.allowed.set(&cx, Option::None);
            sub.insert(&cx, binders.at(&cx, i), Type::Skolem.(label));
            i = i + 1usize;
        }
        self.results().opened.insert(&cx, l.id, labels);
        let payload = subst(&cx, body, sub, self.inf.counter);
        let unit = match l.ty {
            Some(t) => self.unify_at(&cx, payload, self.core_type(&cx, t), l.pos),
            None => (),
        };
        self.pattern(&cx, l.pattern, payload, l.pos, l.mutable);
        false
    }

    fn pattern(self, &cx: Domain!['k], p: Pattern['k], ty: Type['k], pos: Pos, mutable: bool) {
        let id = S::pattern_id(p);
        self.results().types.insert(&cx, id, ty);
        self.recorded.push(&cx, id);
        match p {
            Bind(n) => { self.results().binders.insert(&cx, n.id, self.bind(&cx, n.value, ty, mutable, Option::None).id); },
            Wild(_id) => (),
            Tuple(n) => self.elements_pattern(&cx, false, n.value, ty, pos, mutable),
            Array(n) => self.elements_pattern(&cx, true, n.value, ty, pos, mutable),
            Struct(ps) => {
                // the names are bound now, their types related when known
                let metas: ArenaMap[Str['k], Type['k], 'k] = ArenaMap::new(&cx);
                var i = 0usize;
                while i < ps.fields.len(&cx) {
                    metas.insert(&cx, ps.fields.at(&cx, i).name, new_meta(&cx));
                    i = i + 1usize;
                }
                let bundle = Bundle.{ types: ArenaMap::new(&cx), filled: ref_in(&cx, false) };
                self.later(&cx, ty, Action::Fields.(Fields.{ ty, metas, bundle }), pos);
                i = 0usize;
                while i < ps.fields.len(&cx) {
                    let f = ps.fields.at(&cx, i);
                    self.pattern(&cx, f.pattern, metas.at(&cx, f.name), pos, mutable);
                    i = i + 1usize;
                }
                let unit = match ps.rest {
                    Some(rest) => { self.results().rest_ids.insert(&cx, ps.id, self.bind(&cx, rest, C::unit(&cx), false, Option::Some.(bundle)).id); },
                    None => (),
                };
            },
        }
    }

    fn elements_pattern(self, &cx: Domain!['k], array: bool, elems: ArenaVec[Pattern['k], 'k], ty: Type['k], pos: Pos, mutable: bool) {
        let types: ArenaVec[Type['k], 'k] = ArenaVec::new(&cx);
        var i = 0usize;
        while i < elems.len(&cx) {
            types.push(&cx, new_meta(&cx));
            i = i + 1usize;
        }
        self.later(&cx, ty, Action::Elements.(Elements.{ array, ty, types }), pos);
        i = 0usize;
        while i < elems.len(&cx) {
            self.pattern(&cx, elems.at(&cx, i), types.at(&cx, i), pos, mutable);
            i = i + 1usize;
        }
    }

    fn elements(self, &cx: Domain!['k], e: Elements['k], pos: Pos) {
        self.require_visible_shape(&cx, e.ty, pos);
        let s = self.shape(&cx, e.ty, pos);
        let actual: ArenaVec[Type['k], 'k] = ArenaVec::new(&cx);
        let fits = if e.array {
            match s {
                Array(elem, length) => if length == e.types.len(&cx) as u64 {
                    var i = 0usize;
                    while i < e.types.len(&cx) {
                        actual.push(&cx, elem.copy(&cx));
                        i = i + 1usize;
                    }
                    true
                } else {
                    false
                },
                _ => false,
            }
        } else {
            match s {
                Tuple(elems) => if elems.len(&cx) == e.types.len(&cx) {
                    actual.append(&cx, elems);
                    true
                } else {
                    false
                },
                _ => false,
            }
        };
        if !fits {
            self.fail(&cx, Buffer!::new().put("pattern does not match ").write(&cx, self.shown(&cx, zonk(&cx, e.ty))).save(&cx), pos);
        }
        var i = 0usize;
        while i < actual.len(&cx) {
            self.unify_at(&cx, e.types.at(&cx, i), actual.at(&cx, i), pos);
            i = i + 1usize;
        }
    }

    fn fields_known(self, &cx: Domain!['k], f: Fields['k], pos: Pos) {
        self.require_visible_shape(&cx, f.ty, pos);
        let fields = match self.shape(&cx, f.ty, pos) {
            Struct(fields) => fields,
            _ => self.fail(&cx, Buffer!::new().put("a struct pattern needs a struct, not ").write(&cx, self.shown(&cx, zonk(&cx, f.ty))).save(&cx), pos),
        };
        let by_name: ArenaMap[Str['k], Type['k], 'k] = ArenaMap::new(&cx);
        var i = 0usize;
        while i < fields.len(&cx) {
            by_name.insert(&cx, fields.at(&cx, i).name, fields.at(&cx, i).ty);
            i = i + 1usize;
        }
        let names = f.metas.keys(&cx);
        i = 0usize;
        while i < names.len(&cx) {
            let name = names.at(&cx, i);
            let have = match by_name.get(&cx, name) {
                Some(t) => t,
                None => self.fail(&cx, Buffer!::new().put("no field ").write(&cx, name).save(&cx), pos),
            };
            self.unify_at(&cx, f.metas.at(&cx, name), have, pos);
            i = i + 1usize;
        }
        i = 0usize;
        while i < fields.len(&cx) {
            if !f.metas.contains(&cx, fields.at(&cx, i).name) {
                f.bundle.types.insert(&cx, fields.at(&cx, i).name, fields.at(&cx, i).ty);
            }
            i = i + 1usize;
        }
        f.bundle.filled.set(&cx, true);
    }

    // ---- expressions
    fn check(self, &cx: Domain!['k], e: Expr['k], expected: Option[Type['k]]) -> Type['k] {
        let ty = self.expr(&cx, e);
        self.coerce(&cx, ty, expected, S::expr_pos(e));
        ty
    }

    fn expr(self, &cx: Domain!['k], e: Expr['k]) -> Type['k] {
        let ty = self.infer_expr(&cx, e);
        self.record(&cx, S::expr_id(e), S::expr_pos(e), ty)
    }

    fn infer_expr(self, &cx: Domain!['k], e: Expr['k]) -> Type['k] {
        match e {
            While(w) => self.apply(&cx, ArenaVec::two(&cx, (w.cond.copy(&cx), Pat::Bool), (Expr::Block.(w.body), Pat::Unit)), Pat::Unit, w.pos),
            If(n) => match n.other {
                None => {
                    let unit = self.apply(&cx, ArenaVec::one(&cx, (n.cond.copy(&cx), Pat::Bool)), Pat::Unit, n.pos);
                    let then = self.expr(&cx, Expr::Block.(n.then));
                    if !is_never(&cx, then) && !unify(&cx, then, unit, false, self.inf.counter) {
                        self.fail(&cx, Buffer!::new().put("an `if` without `else` has type (), but its block has type ").write(&cx, self.shown(&cx, zonk(&cx, then))).save(&cx), n.pos);
                    }
                    self.solve(&cx);
                    unit
                },
                Some(other) => {
                    let parts = ArenaVec::two(&cx, (n.cond.copy(&cx), Pat::Bool), (Expr::Block.(n.then), Pat::T));
                    parts.push(&cx, (other.copy(&cx), Pat::T));
                    self.apply(&cx, parts, Pat::T, n.pos)
                },
            },
            Binop(b) => self.expr_binop(&cx, b),
            Unary(u) => if u.op.is(&cx, "&") {
                self.expr_unary(&cx, u)
            } else {
                let result = self.apply(&cx, ArenaVec::one(&cx, (u.operand.copy(&cx), if u.op.is(&cx, "*") { Pat::PtrT } else { Pat::T })), Pat::T, u.pos);
                if u.op.is(&cx, "-") || u.op.is(&cx, "!") {
                    self.require_primitive(&cx, u.op, self.type_of(&cx, S::expr_id(u.operand.copy(&cx))), u.pos, true);
                }
                result
            },
            UnsafeStore(s) => self.apply(&cx, ArenaVec::two(&cx, (s.pointer.copy(&cx), Pat::PtrT), (s.value.copy(&cx), Pat::T)), Pat::Unit, s.pos),
            Lit(l) => self.expr_lit(&cx, l),
            FStr(f) => self.expr_fstring(&cx, f, C::named(self.library(&cx, "Buffer!"), ArenaVec::new(&cx))),
            Path(p) => self.expr_path(&cx, p),
            Tuple(n) => {
                let elems: ArenaVec[Type['k], 'k] = ArenaVec::new(&cx);
                var i = 0usize;
                while i < n.value.len(&cx) {
                    elems.push(&cx, self.expr(&cx, n.value.at(&cx, i)));
                    i = i + 1usize;
                }
                Type::Tuple.(elems)
            },
            Array(a) => self.expr_array(&cx, a),
            StructLit(s) => self.expr_struct_lit(&cx, s),
            Block(b) => self.block(&cx, b),
            For(f) => self.expr_for(&cx, f),
            Return(n) => {
                let unit = match n.value {
                    Some(v) => {
                        let unit = self.check(&cx, v.copy(&cx), Option::Some.(self.returns.at(&cx, self.returns.len(&cx) - 1usize)));
                    },
                    None => self.coerce(&cx, C::unit(&cx), Option::Some.(self.returns.at(&cx, self.returns.len(&cx) - 1usize)), n.pos),
                };
                Type::Never
            },
            Match(m) => self.expr_match(&cx, m),
            Closure(c) => self.expr_closure(&cx, c),
            Pack(p) => self.expr_pack(&cx, p),
            Foreach(f) => self.expr_foreach(&cx, f),
            Cast(c) => {
                let unit = self.expr(&cx, c.value.copy(&cx));
                self.core_type(&cx, c.ty)
            },
            Field(f) => self.projection(&cx, f.value.copy(&cx), Option::Some.(f.name), 0usize, f.id, f.pos, false, false),
            Index(x) => self.projection(&cx, x.value.copy(&cx), Option::None, x.index, x.id, x.pos, false, false),
            Try(n) => {
                let operand = self.expr(&cx, n.value.copy(&cx));
                let returned = self.returns.at(&cx, self.returns.len(&cx) - 1usize);
                let result = new_meta(&cx);
                self.wait(&cx, Ready::Both.(operand, returned), Action::Try.(TryWait.{ id: n.id, operand, returned, result }), n.pos);
                result
            },
            Call(c) => self.expr_call(&cx, c),
        }
    }

    // Primitive applicability waits for inference, without unfolding nominal types.
    fn require_primitive(self, &cx: Domain!['k], op: Str['k], operand: Type['k], pos: Pos, unary: bool) {
        if is_never(&cx, operand) {
            // No operand value reaches this operation.
            return;
        }
        self.later(&cx, operand, Action::Primitive.(op, operand, unary), pos);
    }

    fn primitive(self, &cx: Domain!['k], op: Str['k], operand: Type['k], unary: bool, pos: Pos) {
        let ty = zonk(&cx, operand);
        let (prim, integer, numeric, boolean) = match ty {
            Prim(name) => (true, C::is_integer(&cx, name), C::is_integer(&cx, name) || C::is_float(&cx, name), name.is(&cx, "bool")),
            _ => (false, false, false, false),
        };
        let pointer = match ty {
            Ptr(_i) => true,
            NonNull(_i) => true,
            _ => false,
        };
        let valid = if unary {
            if op.is(&cx, "-") { numeric } else { integer || boolean }
        } else if op.is(&cx, "==") || op.is(&cx, "!=") {
            prim || pointer
        } else if op.is(&cx, "%") || op.is(&cx, "&") || op.is(&cx, "|") || op.is(&cx, "^") || op.is(&cx, "<<") || op.is(&cx, ">>") {
            integer
        } else {
            numeric
        };
        if !valid {
            self.fail(&cx, Buffer!::new().put("operator ").write(&cx, op).put(" is not defined for ").write(&cx, self.shown(&cx, ty)).save(&cx), pos);
        }
    }

    fn pat_type(self, &cx: Domain!['k], p: Pat, t: Ref[Option[Type['k]], 'k]) -> Type['k] {
        match p {
            Bool => C::bool_type(&cx),
            Unit => C::unit(&cx),
            T => match t.copy(&cx) {
                Some(v) => v,
                None => {
                    let v = new_meta(&cx);
                    t.set(&cx, Option::Some.(v));
                    v
                },
            },
            PtrT => C::ptr(&cx, self.pat_type(&cx, Pat::T, t)),
        }
    }

    // A chain `a + b - c ...` nests to the left; its links are inferred by a loop, innermost first,
    // rather than by recursion.
    fn expr_binop(self, &cx: Domain!['k], b: S::Binop['k]) -> Type['k] {
        let chain: ArenaVec[S::Binop['k], 'k] = ArenaVec::one(&cx, b);
        var going = true;
        while going {
            going = match chain.at(&cx, chain.len(&cx) - 1usize).left.copy(&cx) {
                Binop(l) => {
                    chain.push(&cx, l);
                    true
                },
                _ => false,
            };
        }
        var left = self.expr(&cx, chain.at(&cx, chain.len(&cx) - 1usize).left.copy(&cx));
        var depth = chain.len(&cx) - 1usize;
        while depth > 0usize {
            let link = chain.at(&cx, depth);
            left = self.record(&cx, link.id, link.pos, self.binop(&cx, link, left));
            depth = depth - 1usize;
        }
        self.binop(&cx, b, left)
    }

    // `b`, whose left operand has the type `left` already.
    fn binop(self, &cx: Domain!['k], b: S::Binop['k], left: Type['k]) -> Type['k] {
        if b.op.is(&cx, "&&") || b.op.is(&cx, "||") {
            return self.apply_after(&cx, ArenaVec::two(&cx, (b.left.copy(&cx), Pat::Bool), (b.right.copy(&cx), Pat::Bool)), Pat::Bool, b.pos, Option::Some.(left));
        }
        let result = self.apply_after(&cx, ArenaVec::two(&cx, (b.left.copy(&cx), Pat::T), (b.right.copy(&cx), Pat::T)), if is_comparison(&cx, b.op) { Pat::Bool } else { Pat::T }, b.pos, Option::Some.(left));
        let operand = if is_never(&cx, left) { self.type_of(&cx, S::expr_id(b.right.copy(&cx))) } else { left };
        self.require_primitive(&cx, b.op, operand, b.pos, false);
        result
    }

    // Each premise pairs an expression with a type pattern; `t` is shared by the rule.
    fn apply(self, &cx: Domain!['k], premises: ArenaVec[(Expr['k], Pat), 'k], result: Pat, pos: Pos) -> Type['k] {
        self.apply_after(&cx, premises, result, pos, Option::None)
    }

    // `apply`, where `first`, if given, is the first premise's type, inferred already.
    fn apply_after(self, &cx: Domain!['k], premises: ArenaVec[(Expr['k], Pat), 'k], result: Pat, pos: Pos, first: Option[Type['k]]) -> Type['k] {
        let t: Ref[Option[Type['k]], 'k] = ref_in(&cx, Option::None);
        var i = 0usize;
        while i < premises.len(&cx) {
            let (child, p) = premises.at(&cx, i);
            let got = match first {
                Some(f) => if i == 0usize { f } else { self.expr(&cx, child) },
                None => self.expr(&cx, child),
            };
            // a child that diverges fits anywhere
            if !is_never(&cx, got) {
                self.unify_at(&cx, got, self.pat_type(&cx, p, t), pos);
            }
            i = i + 1usize;
        }
        match result {
            T => match t.copy(&cx) {
                Some(v) => v,
                None => Type::Never,
            },
            _ => self.pat_type(&cx, result, t),
        }
    }

    fn literal(self, &cx: Domain!['k], kind: MetaKind, pos: Pos) -> Type['k] {
        let m = Meta::new(&cx, kind);
        m.set_pos(&cx, pos);
        self.literals.push(&cx, m);
        Type::Meta.(m)
    }

    fn expr_lit(self, &cx: Domain!['k], l: S::Lit['k]) -> Type['k] {
        match l.kind {
            Int => match l.suffix {
                Some(suffix) => Type::Prim.(suffix),
                None => self.literal(&cx, MetaKind::Int, l.pos),
            },
            Float => match l.suffix {
                Some(suffix) => Type::Prim.(suffix),
                None => self.literal(&cx, MetaKind::Float, l.pos),
            },
            Bool => C::bool_type(&cx),
            Str => self.static_str(&cx),
        }
    }

    /// `Str['static]`, the type of a string literal.
    fn static_str(self, &cx: Domain!['k]) -> Type['k] {
        C::named(self.library(&cx, "Str"), ArenaVec::one(&cx, Type::Skolem.(Str::from_static(&cx, "static"))))
    }

    /// Each `{x}` of the f-string needs `Format[X, W]`, for `W` the `writer` it is written into, but
    /// one of type `Str['static]`, which is written as the text around it is, by `write_static`.
    fn expr_fstring(self, &cx: Domain!['k], f: S::FStr['k], writer: Type['k]) -> Type['k] {
        var i = 0usize;
        while i < f.parts.len(&cx) {
            let unit = match f.parts.at(&cx, i) {
                Expr(part) => {
                    let (lent, operand) = match part {
                        Unary(u) => if u.op.is(&cx, "&") { (true, u.operand.copy(&cx)) } else { (false, part) },
                        _ => (false, part),
                    };
                    let value = if lent && self.is_place(&cx, operand) { self.place_type(&cx, operand, false, true) } else { self.expr(&cx, operand) };
                    let wait = PlaceholderWait.{ id: S::expr_id(part), value, writer };
                    self.wait(&cx, Ready::Ground.(ArenaVec::one(&cx, value), 1usize), Action::Placeholder.(wait), S::expr_pos(part));
                },
                Text(_t) => (),
            };
            i = i + 1usize;
        }
        C::named(self.library(&cx, "Buffer!"), ArenaVec::new(&cx))
    }

    // `f"...".write(&cx, out)`: the f-string is written into `ReadingWriter![W, C]`, which wraps
    // `out: W` with the capability `C` moved out of the place `cx` and put back after, so each `{x}`
    // may read through it. No `{x}` mentions `cx`'s local while it is lent.
    fn fstring_reading(self, &cx: Domain!['k], c: S::Call['k], f: S::FStr['k]) -> Type['k] {
        let lent = c.args.at(&cx, 0usize);
        let place = match lent {
            Unary(u) => if u.op.is(&cx, "&") && self.is_place(&cx, u.operand.copy(&cx)) {
                u.operand.copy(&cx)
            } else {
                self.fails(&cx, "write lends its context first: .write(&cx, out)", S::expr_pos(lent))
            },
            _ => self.fails(&cx, "write lends its context first: .write(&cx, out)", S::expr_pos(lent)),
        };
        let out = self.expr(&cx, c.args.at(&cx, 1usize));
        self.require(&cx, self.library(&cx, "Writer"), ArenaVec::one(&cx, out), c.pos);
        let context = self.place_type(&cx, place, false, true);
        var root = place;
        var going = true;
        while going {
            root = match root {
                Field(x) => x.value.copy(&cx),
                Index(x) => x.value.copy(&cx),
                _ => {
                    going = false;
                    root
                },
            };
        }
        let local = match root {
            Path(p) => match self.inf.r.refs.get(&cx, p.id) {
                Some(r) => match r {
                    Local(name) => self.lookup(&cx, name, p.pos),
                    _ => Option::None,
                },
                None => Option::None,
            },
            _ => Option::None,
        };
        let lent_id = match local {
            Some(l) => l.id,
            None => fail_static("internal error: a lent place with no local at its root"),
        };
        let writer = C::named(self.library(&cx, "ReadingWriter!"), ArenaVec::two(&cx, out, context));
        let outer = self.fstring_lent.copy(&cx);
        self.fstring_lent.set(&cx, Option::Some.(lent_id));
        let unit = self.record(&cx, f.id, f.pos, self.expr_fstring(&cx, f, writer));
        self.fstring_lent.set(&cx, outer);
        self.results().calls.insert(&cx, c.id, Callee::FStringWrite.(f, Option::Some.(place)));
        out
    }

    fn expr_path(self, &cx: Domain!['k], p: S::Path['k]) -> Type['k] {
        let r = self.inf.r.refs.get(&cx, p.id);
        let unit = match r {
            Some(r) => match r {
                Local(name) => {
                    if has_args(&cx, p) {
                        self.fails(&cx, "explicit type arguments on local values are not supported; specialize the named function before binding", p.pos);
                    }
                    let local = match self.lookup(&cx, name, p.pos) {
                        Some(l) => l,
                        None => self.fail(&cx, Buffer!::new().put("unknown local ").write(&cx, name).save(&cx), p.pos),
                    };
                    if local.rest.is_some() {
                        self.fail(&cx, Buffer!::new().write(&cx, name).put(" is a ..rest bundle, not a value").save(&cx), p.pos);
                    }
                    self.results().binders.insert(&cx, p.id, local.id);
                    return local.ty;
                },
                Decl(decl) => {
                    if decl.kind.is(&cx, "const") {
                        if has_args(&cx, p) {
                            self.fails(&cx, "constant paths take no type arguments", p.pos);
                        }
                        let value = self.inf.sigs.got(&cx, self.inf.sigs.const_decl(&cx, decl));
                        self.results().folded.insert(&cx, p.id, value);
                        let ty = match const_type(&cx, value) {
                            Some(t) => t,
                            None => self.fails(&cx, "internal error: an untyped constant", p.pos),
                        };
                        return ty;
                    }
                    if decl.kind.is(&cx, "fn") || decl.kind.is(&cx, "method") || decl.kind.is(&cx, "extern") {
                        return self.function_value(&cx, p, self.inf.sigs.sigs.at(&cx, decl.id));
                    }
                },
                Variant(enum_decl, name) => return self.variant(&cx, p, enum_decl, name, Option::None),
                _ => (),
            },
            None => (),
        };
        self.fail(&cx, Buffer!::new().write(&cx, p.names(&cx).join(&cx, "::")).put(" is not a value").save(&cx), p.pos)
    }

    // A named function keeps its declared parameter modes and result type. A function value quantifies
    // nothing: every parameter, brands included, is instantiated at the occurrence, written or inferred
    // from how the value is used.
    fn function_value(self, &cx: Domain!['k], p: S::Path['k], sig: Sig['k]) -> Type['k] {
        let sub = self.instantiate_at(&cx, sig.params, last_name(&cx, p), p.pos);
        self.explicit_args(&cx, p, sig, sub);
        self.results().calls.insert(&cx, p.id, Callee::Fn.(FnCall.{ sig, sub, receiver: Option::None }));
        self.require_signature(&cx, sig, sub, p.pos);
        C::fn_type(&cx, self.subst_all(&cx, sig.ptypes, sub), subst(&cx, sig.ret, sub, self.inf.counter), sig.is_unsafe, sig.places)
    }

    // Type arguments written on a callee path: on its last segment, the function's own; on the type
    // segment of `Type[A]::f`, its impl's.
    fn explicit_args(self, &cx: Domain!['k], path: S::Path['k], sig: Sig['k], sub: ArenaMap[Str['k], Type['k], 'k]) {
        let segments = path.segments;
        let count = segments.len(&cx);
        let impl_block = match sig.decl {
            Some(d) => if d.kind.is(&cx, "method") { d.impl_block } else { Option::None },
            None => Option::None,
        };
        let own = segments.at(&cx, count - 1usize).args;
        var index = 0usize;
        while index + 1usize < count {
            if !segments.at(&cx, index).args.is_empty(&cx) && !(index + 2usize == count && impl_block.is_some()) {
                self.fails(&cx, "function type arguments cannot appear on a namespace", path.pos);
            }
            index = index + 1usize;
        }
        let impl_params = match impl_block {
            Some(b) => match b.quantifier {
                Some(f) => f.params.len(&cx) + f.determined.len(&cx),
                None => 0usize,
            },
            None => 0usize,
        };
        if !own.is_empty(&cx) {
            let explicit: ArenaVec[Param['k], 'k] = ArenaVec::new(&cx);
            var i = 0usize;
            while i < sig.params.len(&cx) {
                if !sig.params.at(&cx, i).name.starts_with(&cx, Str::from_static(&cx, "Env#")) {
                    explicit.push(&cx, sig.params.at(&cx, i));
                }
                i = i + 1usize;
            }
            let split = if impl_params < explicit.len(&cx) { impl_params } else { explicit.len(&cx) };
            let mine = explicit.skip(&cx, split);
            let outer = explicit.slice(&cx, 0usize, split);
            let params = if mine.len(&cx) == own.len(&cx) {
                mine
            } else if outer.len(&cx) + mine.len(&cx) == own.len(&cx) {
                explicit
            } else if outer.len(&cx) == own.len(&cx) {
                outer
            } else {
                self.fail(&cx, Buffer!::new().write(&cx, segments.at(&cx, count - 1usize).name).put(" takes ").write(&cx, counted(&cx, mine.len(&cx), "type argument")).save(&cx), path.pos)
            };
            i = 0usize;
            while i < params.len(&cx) {
                let a = own.at(&cx, i);
                let skipped = match a {
                    Ignored(_at) => true,
                    Brand(b) => b.is(&cx, "'_"),
                    _ => false,
                };
                if !skipped && sub.contains(&cx, params.at(&cx, i).name) {
                    self.unify_at(&cx, sub.at(&cx, params.at(&cx, i).name), self.core_type(&cx, a), path.pos);
                }
                i = i + 1usize;
            }
        }
        if count >= 2usize && !segments.at(&cx, count - 2usize).args.is_empty(&cx) {
            let unit = match impl_block {
                Some(b) => {
                    let (_params, _premises, scope) = self.inf.sigs.got(&cx, self.inf.sigs.quantifier(&cx, b.quantifier, new_scope(&cx)));
                    let target = self.inf.sigs.got(&cx, self.inf.sigs.ty(&cx, b.ty, scope));
                    let (name, args) = match target {
                        Named(name, args) => (name, args),
                        _ => self.fails(&cx, "type arguments on a method path need a named impl target", path.pos),
                    };
                    let names = path.names(&cx);
                    let same = match self.inf.r.need(&cx, self.home, names.slice(&cx, 0usize, names.len(&cx) - 1usize), path.pos) {
                        Decl(owner) => self.inf.sigs.name(&cx, owner).eq(&cx, name),
                        _ => false,
                    };
                    if !same {
                        self.fails(&cx, "method type arguments belong on the impl type, not a namespace", path.pos);
                    }
                    let written = segments.at(&cx, count - 2usize).args;
                    if written.len(&cx) != args.len(&cx) {
                        self.fail(&cx, Buffer!::new().put("the impl type qualifier takes ").write(&cx, counted(&cx, args.len(&cx), "type argument")).save(&cx), path.pos);
                    }
                    let given: ArenaVec[Type['k], 'k] = ArenaVec::new(&cx);
                    var i = 0usize;
                    while i < written.len(&cx) {
                        given.push(&cx, self.core_type(&cx, written.at(&cx, i)));
                        i = i + 1usize;
                    }
                    self.unify_at(&cx, subst(&cx, target, sub, self.inf.counter), C::named(name, given), path.pos);
                },
                None => (),
            };
        }
    }

    // Arguments belong on the declaration name, before a variant or method if present.
    fn path_arguments(self, &cx: Domain!['k], path: S::Path['k], declaration: Decl['k], member: bool) -> ArenaVec[S::Type['k], 'k] {
        let count = path.segments.len(&cx);
        let drop = if member { 2usize } else { 1usize };
        let owner = if count >= drop { Option::Some.(count - drop) } else { Option::None };
        var i = 0usize;
        while i < count {
            let at_owner = match owner {
                Some(o) => o == i,
                None => false,
            };
            if !path.segments.at(&cx, i).args.is_empty(&cx) && !at_owner {
                self.fail(&cx, f"type arguments belong on {declaration.name}, not a namespace or member".write(&cx, Buffer!::new()).save(&cx), path.pos);
            }
            i = i + 1usize;
        }
        let written = match owner {
            Some(o) => path.segments.at(&cx, o).args,
            None => ArenaVec::new(&cx),
        };
        if member && !written.is_empty(&cx) {
            let names = path.names(&cx);
            let same = match self.inf.r.need(&cx, self.home, names.slice(&cx, 0usize, names.len(&cx) - 1usize), path.pos) {
                Decl(d) => d.id == declaration.id,
                _ => false,
            };
            if !same {
                self.fail(&cx, f"type arguments belong on {declaration.name}, not a namespace".write(&cx, Buffer!::new()).save(&cx), path.pos);
            }
        }
        written
    }

    // The type a struct, tuple or enum is built at: its parameters instantiated, and any written ones
    // applied.
    fn construct(self, &cx: Domain!['k], pos: Pos, decl: Decl['k], written: ArenaVec[S::Type['k], 'k]) -> (TypeDecl['k], ArenaMap[Str['k], Type['k], 'k], Type['k]) {
        let td = self.inf.sigs.types.at(&cx, self.inf.sigs.name(&cx, decl));
        self.require_visible_shape(&cx, C::named(td.name, ArenaVec::new(&cx)), pos);
        if written.len(&cx) > td.params.len(&cx) {
            self.fail(&cx, Buffer!::new().write(&cx, td.name).put(" accepts at most ").write(&cx, counted(&cx, td.params.len(&cx), "type argument")).put(", got ").put(written.len(&cx)).save(&cx), pos);
        }
        let sub = self.instantiate_at(&cx, td.params, surface(&cx, ArenaVec::new(&cx), ArenaVec::one(&cx, td.name), ArenaMap::new(&cx)).name(&cx, td.name), pos);
        var i = 0usize;
        while i < written.len(&cx) {
            self.unify_at(&cx, sub.at(&cx, td.params.at(&cx, i).name), self.core_type(&cx, written.at(&cx, i)), pos);
            i = i + 1usize;
        }
        self.require_parameter_kinds(&cx, td.params, sub, pos);
        let args: ArenaVec[Type['k], 'k] = ArenaVec::new(&cx);
        i = 0usize;
        while i < td.params.len(&cx) {
            args.push(&cx, sub.at(&cx, td.params.at(&cx, i).name));
            i = i + 1usize;
        }
        (td, sub, C::named(td.name, args))
    }

    // The payload of the variant `name` of the sum `ty` is, once `ty` is known: the type is needed at
    // `pos`, the match, and the label is at `at`, the case.
    fn label_payload(self, &cx: Domain!['k], ty: Type['k], name: Str['k], pos: Pos, at: Pos) -> Type['k] {
        let unit = match self.shape(&cx, ty, pos) {
            Enum(variants) => {
                var i = 0usize;
                while i < variants.len(&cx) {
                    if variants.at(&cx, i).name.eq(&cx, name) {
                        return variants.at(&cx, i).ty;
                    }
                    i = i + 1usize;
                }
            },
            _ => (),
        };
        self.fail(&cx, Buffer!::new().write(&cx, self.shown(&cx, zonk(&cx, ty))).put(" has no variant ").write(&cx, name).save(&cx), at)
    }

    fn payload_of(self, &cx: Domain!['k], td: TypeDecl['k], name: Str['k], sub: ArenaMap[Str['k], Type['k], 'k]) -> Type['k] {
        let variants = match td.body {
            Enum(variants) => variants,
            _ => self.fails(&cx, "internal error: a variant of a type that is not an enum", no_pos()),
        };
        var i = 0usize;
        while i < variants.len(&cx) {
            if variants.at(&cx, i).name.eq(&cx, name) {
                return subst(&cx, variants.at(&cx, i).ty, sub, self.inf.counter);
            }
            i = i + 1usize;
        }
        self.fails(&cx, "internal error: an unknown variant", no_pos())
    }

    fn variant(self, &cx: Domain!['k], path: S::Path['k], enum_decl: Decl['k], name: Str['k], payload_args: Option[ArenaVec[Expr['k], 'k]]) -> Type['k] {
        let (td, sub, result) = self.construct(&cx, path.pos, enum_decl, self.path_arguments(&cx, path, enum_decl, true));
        let payload = self.payload_of(&cx, td, name, sub);
        self.results().calls.insert(&cx, path.id, Callee::Variant.(name));
        let unit = match payload_args {
            None => if !C::same(&cx, payload, C::unit(&cx)) {
                self.fail(&cx, f"variant {name} carries a payload".write(&cx, Buffer!::new()).save(&cx), path.pos);
            },
            Some(args) => if args.len(&cx) == 1usize {
                let unit = self.check(&cx, args.at(&cx, 0usize), Option::Some.(payload));
            } else {
                let elems = match payload {
                    Tuple(elems) => if elems.len(&cx) == args.len(&cx) { Option::Some.(elems) } else { Option::None },
                    _ => Option::None,
                };
                match elems {
                    Some(types) => {
                        var i = 0usize;
                        while i < args.len(&cx) {
                            let unit = self.check(&cx, args.at(&cx, i), Option::Some.(types.at(&cx, i)));
                            i = i + 1usize;
                        }
                    },
                    None => self.fail(&cx, f"variant {name} takes one payload".write(&cx, Buffer!::new()).save(&cx), path.pos),
                }
            },
        };
        result
    }

    fn expr_array(self, &cx: Domain!['k], a: S::ArrayLit['k]) -> Type['k] {
        if a.elems.is_empty(&cx) {
            self.fails(&cx, "an array has at least one element", a.pos);
        }
        let elem = new_meta(&cx);
        var i = 0usize;
        while i < a.elems.len(&cx) {
            let unit = self.check(&cx, a.elems.at(&cx, i), Option::Some.(elem));
            i = i + 1usize;
        }
        if !a.fill {
            return Type::Array.(ref_in(&cx, elem), a.elems.len(&cx) as u64);
        }
        // `[x, ..]` gets its length from the type it is used at
        let result = new_meta(&cx);
        self.later(&cx, result, Action::Fill.(result, elem), a.pos);
        result
    }

    fn expr_struct_lit(self, &cx: Domain!['k], s: S::StructLit['k]) -> Type['k] {
        let decl = match self.inf.r.refs.get(&cx, s.path.id) {
            Some(r) => match r {
                Decl(d) => d,
                _ => self.fails(&cx, "internal error: a struct literal of something other than a struct", s.pos),
            },
            None => self.fails(&cx, "internal error: an unresolved struct literal", s.pos),
        };
        let (td, sub, result) = self.construct(&cx, s.pos, decl, self.path_arguments(&cx, s.path, decl, false));
        let members = match td.body {
            Struct(members) => members,
            _ => self.fails(&cx, "internal error: a struct literal of something other than a struct", s.pos),
        };
        let fields: ArenaMap[Str['k], Type['k], 'k] = ArenaMap::new(&cx);
        var i = 0usize;
        while i < members.len(&cx) {
            fields.insert(&cx, members.at(&cx, i).name, subst(&cx, members.at(&cx, i).ty, sub, self.inf.counter));
            i = i + 1usize;
        }
        let given: ArenaSet[Str['k], 'k] = ArenaSet::new(&cx);
        let field_ids: ArenaMap[Str['k], u32, 'k] = ArenaMap::new(&cx);
        self.results().field_ids.insert(&cx, s.id, field_ids);
        i = 0usize;
        while i < s.fields.len(&cx) {
            let f = s.fields.at(&cx, i);
            if !fields.contains(&cx, f.name) || given.contains(&cx, f.name) {
                self.fail(&cx, f"field {f.name} is unknown or given twice".write(&cx, Buffer!::new()).save(&cx), s.pos);
            }
            given.insert(&cx, f.name);
            let unit = match f.value {
                Some(v) => {
                    let unit = self.check(&cx, v, Option::Some.(fields.at(&cx, f.name)));
                },
                None => {
                    let local = match self.lookup(&cx, f.name, s.pos) {
                        Some(l) => l,
                        None => self.fail(&cx, Buffer!::new().put("unknown local ").write(&cx, f.name).save(&cx), s.pos),
                    };
                    field_ids.insert(&cx, f.name, local.id);
                    self.unify_at(&cx, local.ty, fields.at(&cx, f.name), s.pos);
                },
            };
            i = i + 1usize;
        }
        let unit = match s.spread {
            Some(spread) => {
                let bundle = match self.lookup(&cx, spread, s.pos) {
                    Some(rest) => match rest.rest {
                        Some(b) => {
                            self.results().spread_ids.insert(&cx, s.id, rest.id);
                            b
                        },
                        None => self.fail(&cx, Buffer!::new().write(&cx, spread).put(" is not a ..rest bundle").save(&cx), s.pos),
                    },
                    None => self.fail(&cx, Buffer!::new().write(&cx, spread).put(" is not a ..rest bundle").save(&cx), s.pos),
                };
                self.wait(&cx, Ready::Filled.(bundle), Action::Spread.(Spread.{ spread, fields, given, bundle }), s.pos);
            },
            None => if given.len(&cx) != fields.len(&cx) {
                let missing: ArenaVec[Str['k], 'k] = ArenaVec::new(&cx);
                let names = fields.keys(&cx);
                i = 0usize;
                while i < names.len(&cx) {
                    if !given.contains(&cx, names.at(&cx, i)) {
                        missing.push(&cx, names.at(&cx, i));
                    }
                    i = i + 1usize;
                }
                missing.sort_by(&cx, |&cx, a, b| a.cmp(&cx, b));
                self.fail(&cx, Buffer!::new().put(if missing.len(&cx) > 1usize { "missing fields " } else { "missing field " })
                    .write(&cx, listed(&cx, missing)).save(&cx), s.pos);
            },
        };
        result
    }

    fn expr_for(self, &cx: Domain!['k], f: S::For['k]) -> Type['k] {
        let target = match f.iterator.copy(&cx) {
            Unary(u) => if u.op.is(&cx, "&") { Option::Some.(u.operand.copy(&cx)) } else { Option::None },
            _ => Option::None,
        };
        let operand = match target {
            Some(t) => t,
            None => self.fails(&cx, "a for loop lends its iterator: `for x in &it`", f.pos),
        };
        let it = self.place_type(&cx, operand, false, true);
        let item = new_meta(&cx);
        let next = TraitCall.{ trait_name: self.library(&cx, "Iterator"), method: Str::from_static(&cx, "next"), targs: ArenaVec::two(&cx, it, item), receiver: Option::None };
        self.results().next_calls.insert(&cx, f.id, next);
        self.require(&cx, next.trait_name, next.targs, f.pos);
        let option = C::named(self.library(&cx, "Option"), ArenaVec::one(&cx, item));
        self.results().options.insert(&cx, f.id, option);
        self.require_visible_shape(&cx, option, f.pos);
        self.enter(&cx);
        self.results().binders.insert(&cx, f.id, self.bind(&cx, f.name, item, false, Option::None).id);
        let unit = self.check(&cx, Expr::Block.(f.body), Option::Some.(C::unit(&cx)));
        self.leave(&cx);
        C::unit(&cx)
    }

    fn expr_match(self, &cx: Domain!['k], m: S::Match['k]) -> Type['k] {
        let scrutinee = m.scrutinee.copy(&cx);
        let place = match scrutinee {
            Unary(u) => if u.op.is(&cx, "&") && self.is_place(&cx, u.operand.copy(&cx)) { Option::Some.(u.operand.copy(&cx)) } else { Option::None },
            _ => Option::None,
        };
        let lent = place.is_some();
        self.results().lent.insert(&cx, m.id, lent);
        let ty = match place {
            Some(p) => self.place_type(&cx, p, false, true),
            None => self.expr(&cx, scrutinee),
        };
        self.later(&cx, ty, Action::VisibleShape.(ty), m.pos);
        var result: Option[Type['k]] = Option::None;
        var i = 0usize;
        while i < m.arms.len(&cx) {
            let arm = m.arms.at(&cx, i);
            self.enter(&cx);
            var k = 0usize;
            while k < arm.cases.len(&cx) {
                self.case(&cx, arm.cases.at(&cx, k), ty, lent, arm.cases.len(&cx) == 1usize, m.pos);
                k = k + 1usize;
            }
            let arm_ty = self.expr(&cx, arm.body);
            self.leave(&cx);
            result = Option::Some.(match result {
                None => arm_ty,
                Some(r) => self.join(&cx, r, arm_ty, arm.pos),
            });
            i = i + 1usize;
        }
        match result {
            Some(r) => r,
            None => Type::Never,
        }
    }

    fn case(self, &cx: Domain!['k], c: S::Case['k], ty: Type['k], lent: bool, alone: bool, pos: Pos) {
        let unit = match c.kind {
            Wild => return,
            Value => {
                self.later(&cx, ty, Action::Integer.(ty), pos);
                return;
            },
            Variant => (),
        };
        let path = match c.path {
            Some(p) => p,
            None => self.fails(&cx, "internal error: a variant case without a path", pos),
        };
        let (name, payload) = match self.inf.r.refs.get(&cx, path.id) {
            Some(r) => match r {
                Variant(enum_decl, name) => {
                    let (td, sub, scrutinee) = self.construct(&cx, path.pos, enum_decl, self.path_arguments(&cx, path, enum_decl, true));
                    self.unify_at(&cx, scrutinee, ty, pos);
                    (name, self.payload_of(&cx, td, name, sub))
                },
                _ => self.fails(&cx, "internal error: a variant case that names no variant", pos),
            },
            // a bare label: a variant of the scrutinee's sum
            None => {
                let name = path.segments.at(&cx, 0usize).name;
                (name, self.label_payload(&cx, ty, name, pos, c.pos))
            },
        };
        self.results().types.insert(&cx, c.id, payload);
        self.results().case_labels.insert(&cx, c.id, name);
        self.recorded.push(&cx, c.id);
        let ids: ArenaVec[Option[u32], 'k] = ArenaVec::new(&cx);
        self.results().case_binders.insert(&cx, c.id, ids);
        let binders = match c.binders {
            Some(b) => b,
            None => return,
        };
        if !alone {
            self.fails(&cx, "a grouped arm binds no payload", pos);
        }
        let types = if binders.len(&cx) == 1usize {
            ArenaVec::one(&cx, payload)
        } else {
            match payload {
                Tuple(elems) => if elems.len(&cx) == binders.len(&cx) {
                    elems
                } else {
                    self.fail(&cx, Buffer!::new().put("variant ").write(&cx, name).put(" does not carry ").write(&cx, counted(&cx, binders.len(&cx), "value")).save(&cx), pos)
                },
                _ => self.fail(&cx, Buffer!::new().put("variant ").write(&cx, name).put(" does not carry ").write(&cx, counted(&cx, binders.len(&cx), "value")).save(&cx), pos),
            }
        };
        var i = 0usize;
        while i < binders.len(&cx) {
            let b = binders.at(&cx, i);
            ids.push(&cx, if b.is(&cx, "_") { Option::None } else { Option::Some.(self.bind(&cx, b, types.at(&cx, i), lent, Option::None).id) });
            i = i + 1usize;
        }
    }

    fn captures(self, &cx: Domain!['k], frame: Frame['k]) -> ArenaVec[Capture['k], 'k] {
        let out: ArenaVec[Capture['k], 'k] = ArenaVec::new(&cx);
        var i = 0usize;
        while i < frame.locals.len(&cx) {
            let (name, local, _at) = frame.locals.at(&cx, i);
            out.push(&cx, Capture.{ name, binder: local.id });
            i = i + 1usize;
        }
        out
    }

    fn expr_closure(self, &cx: Domain!['k], c: S::Closure['k]) -> Type['k] {
        let params: ArenaVec[Type['k], 'k] = ArenaVec::new(&cx);
        let places: ArenaVec[usize, 'k] = ArenaVec::new(&cx);
        var i = 0usize;
        while i < c.params.len(&cx) {
            params.push(&cx, match c.params.at(&cx, i).ty {
                Some(t) => self.core_type(&cx, t),
                None => {
                    let meta = new_meta(&cx);
                    self.unwritten.push(&cx, (meta, Buffer!::new().put("type of closure parameter ").write(&cx, c.params.at(&cx, i).name).save(&cx), c.pos));
                    meta
                },
            });
            if c.params.at(&cx, i).lend {
                places.push(&cx, i + 1usize);
            }
            i = i + 1usize;
        }
        let ret = match c.ret {
            Some(t) => self.core_type(&cx, t),
            None => {
                let meta = new_meta(&cx);
                self.unwritten.push(&cx, (meta, Str::from_static(&cx, "return type of the closure"), c.pos));
                meta
            },
        };
        let frame = new_frame(&cx);
        self.frames.push(&cx, frame);
        self.enter(&cx);
        let ids: ArenaVec[u32, 'k] = ArenaVec::new(&cx);
        i = 0usize;
        while i < c.params.len(&cx) {
            let p = c.params.at(&cx, i);
            ids.push(&cx, self.bind(&cx, p.name, params.at(&cx, i), p.lend, Option::None).id);
            i = i + 1usize;
        }
        self.results().param_ids.insert(&cx, c.id, ids);
        self.returns.push(&cx, ret);
        let unit = self.check(&cx, c.body.copy(&cx), Option::Some.(ret));
        let unit = self.returns.pop(&cx);
        self.leave(&cx);
        let unit = self.frames.pop(&cx);
        self.results().captures.insert(&cx, c.id, self.captures(&cx, frame));
        let env_types: ArenaVec[Type['k], 'k] = ArenaVec::new(&cx);
        i = 0usize;
        while i < frame.locals.len(&cx) {
            let (_n, l, _at) = frame.locals.at(&cx, i);
            env_types.push(&cx, l.ty);
            i = i + 1usize;
        }
        let env = Type::Tuple.(env_types);
        let code_params = ArenaVec::one(&cx, env);
        code_params.append(&cx, params);
        let code = C::fn_type(&cx, code_params, ret, false, places);
        Type::Struct.(ArenaVec::two(&cx, Member.{ name: Str::from_static(&cx, "env"), ty: env }, Member.{ name: Str::from_static(&cx, "code"), ty: code }))
    }

    fn expr_pack(self, &cx: Domain!['k], p: S::Pack['k]) -> Type['k] {
        let sub = self.brand_sub(&cx);
        let witnesses: ArenaVec[Type['k], 'k] = ArenaVec::new(&cx);
        let labels: ArenaVec[Str['k], 'k] = ArenaVec::new(&cx);
        var i = 0usize;
        while i < p.brands.len(&cx) {
            let name = p.brands.at(&cx, i).skip(1usize);
            var known = name.is(&cx, "static") || sub.contains(&cx, name);
            var k = 0usize;
            while !known && k < self.sig.params.len(&cx) {
                known = is_brand(self.sig.params.at(&cx, k).kind) && self.sig.params.at(&cx, k).name.eq(&cx, name);
                k = k + 1usize;
            }
            if !known {
                self.fail(&cx, f"pack brand {name} is not in scope".write(&cx, Buffer!::new()).save(&cx), p.pos);
            }
            i = i + 1usize;
        }
        i = 0usize;
        while i < p.brands.len(&cx) {
            let name = p.brands.at(&cx, i).skip(1usize);
            let witness = sub.get_or(&cx, name, Type::Skolem.(name));
            witnesses.push(&cx, witness);
            labels.push(&cx, match witness {
                Skolem(label) => label,
                _ => name,
            });
            i = i + 1usize;
        }
        self.results().witnesses.insert(&cx, p.id, witnesses);
        let value = self.expr(&cx, p.value.copy(&cx));
        let result = new_meta(&cx);
        let wait = PackWait.{ result, value, labels, pos: p.pos };
        // the type it is used at says which brands are hidden
        self.later(&cx, result, Action::Pack.(wait), p.pos);
        self.defaults.push(&cx, wait);
        result
    }

    // Otherwise a pack's type is the payload's, with the brands abstracted.
    fn pack_default(self, &cx: Domain!['k], p: PackWait['k]) {
        let binders: ArenaVec[Str['k], 'k] = ArenaVec::new(&cx);
        let sub: ArenaMap[Str['k], Type['k], 'k] = ArenaMap::new(&cx);
        var i = 0usize;
        while i < p.labels.len(&cx) {
            // Binders no source spells: a brand of the payload, even one solved later, is never captured.
            let binder = f"p{i}#".write(&cx, Buffer!::new()).save(&cx);
            binders.push(&cx, binder);
            sub.insert(&cx, p.labels.at(&cx, i), Type::Skolem.(binder));
            i = i + 1usize;
        }
        self.unify_at(&cx, p.result, Type::Exists.(binders, ref_in(&cx, subst(&cx, zonk(&cx, p.value), sub, self.inf.counter))), no_pos());
    }

    fn expr_foreach(self, &cx: Domain!['k], f: S::Foreach['k]) -> Type['k] {
        var operand = zonk(&cx, self.expr(&cx, f.source.copy(&cx)));
        if is_unsolved(&cx, operand) {
            operand = self.shape(&cx, operand, f.pos);
        }
        // A value of a foreach type is mapped (the map form): the result has its source, binder and
        // pattern, and each item is a component of the value. Anything else is the source itself.
        let mapped = match operand {
            Foreach(o) => Option::Some.(o),
            _ => Option::None,
        };
        let source = match mapped {
            Some(o) => o.source.copy(&cx),
            None => operand,
        };
        match source {
            Foreach(_s) => self.fails(&cx, FOREACH_OF_FOREACH, f.pos),
            _ => (),
        }
        if self.inf.types.points_to_sum(&cx, source, self.kinds) {
            self.fails(&cx, POINTER_TO_SUM, f.pos);
        }
        self.require(&cx, Str::from_static(&cx, "Exposed"), ArenaVec::one(&cx, source), f.pos);
        // Each `foreach` binds a binder of its own, named after the one written, as `F#F12` for `F`.
        let written = match f.binder {
            Some(b) => b,
            None => Str::from_static(&cx, ""),
        };
        if !written.is_empty() && (self.sig.params.any(&cx, |&cx, p: Param['k]| p.name.eq(&cx, written))
            || self.open_binders.copy(&cx).any(&cx, |&cx, b: Str['k]| made_from(&cx, b).eq(&cx, written))) {
            self.fail(&cx, f"foreach binder {written} shadows another type named {written}".write(&cx, Buffer!::new()).save(&cx), f.pos);
        }
        let binder = Buffer!::new().write(&cx, written).put("#F").put(self.inf.next_id(&cx)).save(&cx);
        self.foreaches.insert(&cx, binder, (f.name, f.pos));
        self.kinds.insert(&cx, binder, Kind::Any);
        let outer = self.open_binders.copy(&cx);
        let (indirect, item) = match mapped {
            Some(o) => (o.indirect, mapped_component(&cx, o, C::named(binder, ArenaVec::new(&cx)), self.inf.counter)),
            None => {
                let indirect = match self.shape(&cx, source, f.pos) {
                    Ptr(_p) => true,
                    _ => false,
                };
                let named = C::named(binder, ArenaVec::new(&cx));
                (indirect, if indirect { C::ptr(&cx, named) } else { named })
            },
        };
        self.open_binders.set(&cx, outer.cons(&cx, binder));
        let frame = new_frame(&cx);
        self.frames.push(&cx, frame);
        self.enter(&cx);
        self.results().binders.insert(&cx, f.id, self.bind(&cx, f.name, item, false, Option::None).id);
        let body = zonk(&cx, self.expr(&cx, Expr::Block.(f.body)));
        self.leave(&cx);
        let unit = self.frames.pop(&cx);
        self.open_binders.set(&cx, outer);
        self.results().captures.insert(&cx, f.id, self.captures(&cx, frame));
        // The body runs once for each component, so what it captures is used as many times.
        var i = 0usize;
        while i < frame.locals.len(&cx) {
            let (name, local, at) = frame.locals.at(&cx, i);
            self.capture_checks.push(&cx, (name, local.ty, at));
            i = i + 1usize;
        }
        C::foreach_type(&cx, binder, indirect, source, body)
    }

    // The other operators have rules; `&` lends the receiver of a call.
    fn expr_unary(self, &cx: Domain!['k], u: S::Unary['k]) -> Type['k] {
        let first = match self.first_call(&cx, u.operand.copy(&cx)) {
            Some(c) => c,
            None => self.fails(&cx, "& lends a place only as a call argument `f(&x)`, a receiver `&x.m()` or a match scrutinee `match &x`", u.pos),
        };
        self.inf.lend_marked.insert(&cx, first.id);
        self.expr(&cx, u.operand.copy(&cx))
    }

    // The type behind a pointer.
    fn pointee(self, &cx: Domain!['k], pointer: Type['k], pos: Pos) -> Type['k] {
        let target = new_meta(&cx);
        self.unify_at(&cx, pointer, C::ptr(&cx, target), pos);
        target
    }

    // The innermost method call of a postfix chain: the one `&` lends the receiver of.
    fn first_call(self, &cx: Domain!['k], e: Expr['k]) -> Option[S::Call['k]] {
        var e = e;
        while true {
            e = match e {
                Call(c) => match c.callee.copy(&cx) {
                    Field(f) => if self.is_place(&cx, f.value.copy(&cx)) {
                        return Option::Some.(c);
                    } else {
                        f.value.copy(&cx)
                    },
                    _ => return Option::None,
                },
                Field(f) => f.value.copy(&cx),
                Index(x) => x.value.copy(&cx),
                Try(n) => n.value.copy(&cx),
                _ => return Option::None,
            };
        }
        Option::None
    }

    // `x?` unwraps success or returns failure, from core's Option or Result.
    fn resolve_try(self, &cx: Domain!['k], t: TryWait['k], pos: Pos) -> Type['k] {
        let operand = zonk(&cx, t.operand);
        let returned = zonk(&cx, t.returned);
        let family = self.family(&cx, operand);
        let (name, args) = match operand {
            Named(name, args) => (name, args),
            _ => (Str::from_static(&cx, ""), ArenaVec::new(&cx)),
        };
        let (other_name, other_args) = match returned {
            Named(name, args) => (name, args),
            _ => (Str::from_static(&cx, ""), ArenaVec::new(&cx)),
        };
        let fits = !family.is_empty() && self.family(&cx, returned).eq(&cx, family) && name.eq(&cx, other_name);
        if !fits {
            self.fails(&cx, "? needs the operand and the function result to be the same Option or Result of core::option", pos);
        }
        let result = family.is(&cx, "result");
        let ok = Str::from_static(&cx, if result { "Ok" } else { "Some" });
        let error = Str::from_static(&cx, if result { "Err" } else { "None" });
        let td = self.inf.types.program.types.at(&cx, name);
        self.unify_at(&cx, self.variant_type(&cx, td, args, error), self.variant_type(&cx, td, other_args, error), pos);
        self.results().try_kinds.insert(&cx, t.id, family);
        self.variant_type(&cx, td, args, ok)
    }

    fn variant_type(self, &cx: Domain!['k], td: TypeDecl['k], args: ArenaVec[Type['k], 'k], name: Str['k]) -> Type['k] {
        let sub: ArenaMap[Str['k], Type['k], 'k] = ArenaMap::new(&cx);
        var i = 0usize;
        while i < td.params.len(&cx) && i < args.len(&cx) {
            sub.insert(&cx, td.params.at(&cx, i).name, args.at(&cx, i));
            i = i + 1usize;
        }
        self.payload_of(&cx, td, name, sub)
    }

    // `option` for core's Option and `result` for its Result, the types `?` takes apart; empty for any
    // other.
    fn family(self, &cx: Domain!['k], ty: Type['k]) -> Str['k] {
        match ty {
            Named(name, _args) => if name.is(&cx, "core::option::Option") {
                Str::from_static(&cx, "option")
            } else if name.is(&cx, "core::option::Result") {
                Str::from_static(&cx, "result")
            } else {
                Str::from_static(&cx, "")
            },
            _ => Str::from_static(&cx, ""),
        }
    }

    // ---- places
    // The type of a place expression: a local, or fields and tuple elements of one. A place that is
    // assigned or lent is rooted at a var, a place parameter or a binder of a lent match case, bound in
    // the function, closure or foreach body it is written in: such a body holds a copy of what it
    // captures.
    fn place_type(self, &cx: Domain!['k], e: Expr['k], assign: bool, lend: bool) -> Type['k] {
        let unit = match e {
            Path(p) => {
                let local_name = match self.inf.r.refs.get(&cx, p.id) {
                    Some(r) => match r {
                        Local(name) => Option::Some.(name),
                        _ => Option::None,
                    },
                    None => Option::None,
                };
                let unit = match local_name {
                    Some(name) => {
                        let local = match self.lookup(&cx, name, p.pos) {
                            Some(l) => l,
                            None => self.fail(&cx, Buffer!::new().put("unknown local ").write(&cx, name).save(&cx), p.pos),
                        };
                        if (assign || lend) && !local.mutable {
                            self.fail(&cx, Buffer!::new().write(&cx, name).put(if lend { " is not a var; a lent place must be a var" } else { " is not a var" }).save(&cx), p.pos);
                        }
                        if (assign || lend) && local.depth != self.frames.len(&cx) - 1usize {
                            self.fail(&cx, Buffer!::new().write(&cx, name).put(if lend { " is captured, and a body cannot lend what it captures; lend it outside, or give a closure a place parameter for it" } else { " is captured, and a body cannot assign what it captures; assign it outside, or give a closure a place parameter for it" }).save(&cx), p.pos);
                        }
                        self.results().binders.insert(&cx, p.id, local.id);
                        return self.record(&cx, p.id, p.pos, local.ty);
                    },
                    None => (),
                };
            },
            Field(f) => return self.projection(&cx, f.value.copy(&cx), Option::Some.(f.name), 0usize, f.id, f.pos, assign, lend),
            Index(x) => return self.projection(&cx, x.value.copy(&cx), Option::None, x.index, x.id, x.pos, assign, lend),
            _ => (),
        };
        if assign {
            self.fails(&cx, "not an assignable place", S::expr_pos(e));
        }
        self.expr(&cx, e)
    }

    // The type of `owner.name` or `owner.N`; an owner that is a place is typed as one, so that an
    // assignment is checked down to its root local.
    fn projection(self, &cx: Domain!['k], value: Expr['k], field: Option[Str['k]], index: usize, id: u32, pos: Pos, assign: bool, lend: bool) -> Type['k] {
        let owner = if self.is_place(&cx, value) { self.place_type(&cx, value, assign, lend) } else { self.expr(&cx, value) };
        let result = new_meta(&cx);
        self.later(&cx, owner, Action::Component.(Component.{ field, index, owner, result }), pos);
        self.record(&cx, id, pos, result)
    }

    fn component(self, &cx: Domain!['k], c: Component['k], pos: Pos) {
        self.require_visible_shape(&cx, c.owner, pos);
        let s = self.shape(&cx, c.owner, pos);
        let unit = match c.field {
            Some(name) => match s {
                Struct(fields) => {
                    var i = 0usize;
                    while i < fields.len(&cx) {
                        if fields.at(&cx, i).name.eq(&cx, name) {
                            self.unify_at(&cx, c.result, fields.at(&cx, i).ty, pos);
                            return;
                        }
                        i = i + 1usize;
                    }
                },
                _ => (),
            },
            None => match s {
                Tuple(elems) => if c.index < elems.len(&cx) {
                    self.unify_at(&cx, c.result, elems.at(&cx, c.index), pos);
                    return;
                },
                _ => (),
            },
        };
        let what = match c.field {
            Some(name) => name,
            None => Buffer!::new().put(c.index).save(&cx),
        };
        self.fail(&cx, Buffer!::new().write(&cx, self.shown(&cx, zonk(&cx, c.owner))).put(" has no component ").write(&cx, what).save(&cx), pos)
    }

    fn is_place(self, &cx: Domain!['k], e: Expr['k]) -> bool {
        match e {
            Path(p) => match self.inf.r.refs.get(&cx, p.id) {
                Some(r) => match r {
                    Local(_n) => true,
                    _ => false,
                },
                None => false,
            },
            Field(f) => self.is_place(&cx, f.value.copy(&cx)),
            Index(x) => self.is_place(&cx, x.value.copy(&cx)),
            _ => false,
        }
    }

    // ---- calls
    fn expr_call(self, &cx: Domain!['k], c: S::Call['k]) -> Type['k] {
        let callee = c.callee.copy(&cx);
        let lent_receiver = self.inf.lend_marked.contains(&cx, c.id);
        let unit = match callee {
            Field(f) => return self.method_call(&cx, c, f, lent_receiver),
            _ => (),
        };
        if lent_receiver {
            self.fails(&cx, "& before a call lends its receiver: `&x.method()`", c.pos);
        }
        let path = match callee {
            Path(p) => p,
            _ => return self.call_value(&cx, c),
        };
        let r = match self.inf.r.refs.get(&cx, path.id) {
            Some(r) => r,
            None => return self.call_value(&cx, c),
        };
        match r {
            Variant(enum_decl, name) => {
                let ty = self.variant(&cx, path, enum_decl, name, Option::Some.(c.args));
                self.results().calls.insert(&cx, c.id, self.results().calls.at(&cx, path.id));
                self.record(&cx, path.id, path.pos, ty)
            },
            Decl(decl) => if decl.kind.is(&cx, "fn") || decl.kind.is(&cx, "method") || decl.kind.is(&cx, "extern") {
                let sig = self.inf.sigs.sigs.at(&cx, decl.id);
                let sub = self.instantiate_at(&cx, sig.params, last_name(&cx, path), c.pos);
                self.explicit_args(&cx, path, sig, sub);
                let call = FnCall.{ sig, sub, receiver: Option::None };
                self.results().calls.insert(&cx, c.id, Callee::Fn.(call));
                self.call_sig(&cx, c, call, self.operands(&cx, c.args))
            } else if decl.kind.is(&cx, "tuple") {
                let (td, sub, result) = self.construct(&cx, c.pos, decl, self.path_arguments(&cx, path, decl, false));
                let elems = match td.body {
                    Tuple(elems) => elems,
                    _ => self.fails(&cx, "internal error: a tuple declaration that is not a tuple", c.pos),
                };
                if c.args.len(&cx) != elems.len(&cx) {
                    self.fail(&cx, Buffer!::new().write(&cx, td.name).put(" has ").write(&cx, counted(&cx, elems.len(&cx), "element")).save(&cx), c.pos);
                }
                var i = 0usize;
                while i < elems.len(&cx) {
                    let unit = self.check(&cx, c.args.at(&cx, i), Option::Some.(subst(&cx, elems.at(&cx, i), sub, self.inf.counter)));
                    i = i + 1usize;
                }
                self.results().calls.insert(&cx, c.id, Callee::Tuple);
                self.record(&cx, path.id, path.pos, result)
            } else {
                self.call_value(&cx, c)
            },
            TraitMethod(trait_decl, method) => self.trait_call(&cx, c, path, trait_decl, method),
            Builtin(name) => self.builtin(&cx, c, path, name),
            Assoc(param, name) => self.assoc_call(&cx, c, path, param, name),
            _ => self.call_value(&cx, c),
        }
    }

    // A call of a value: a closure `{env, code}`, or a function pointer.
    fn call_value(self, &cx: Domain!['k], c: S::Call['k]) -> Type['k] {
        let callee = self.expr(&cx, c.callee.copy(&cx));
        let got = self.operands(&cx, c.args);
        let result = new_meta(&cx);
        self.later(&cx, callee, Action::CallValue.(CallWait.{ call: c, callee, got, result }), c.pos);
        result
    }

    fn call_known(self, &cx: Domain!['k], w: CallWait['k], pos: Pos) {
        let s = self.shape(&cx, w.callee, pos);
        let ptypes: ArenaVec[Type['k], 'k] = ArenaVec::new(&cx);
        let places: ArenaVec[usize, 'k] = ArenaVec::new(&cx);
        let closure_fields = match s {
            Struct(fields) => {
                var has_code = false;
                var i = 0usize;
                while i < fields.len(&cx) {
                    if fields.at(&cx, i).name.is(&cx, "code") {
                        has_code = true;
                    }
                    i = i + 1usize;
                }
                if has_code { Option::Some.(fields) } else { Option::None }
            },
            _ => Option::None,
        };
        let ret = match closure_fields {
            Some(fields) => {
                self.require_visible_shape(&cx, w.callee, pos);
                if fields.len(&cx) != 2usize || !fields.at(&cx, 0usize).name.is(&cx, "env") || !fields.at(&cx, 1usize).name.is(&cx, "code") {
                    self.fails(&cx, "a closure must have exactly env and code fields, in that order", pos);
                }
                let env = fields.at(&cx, 0usize).ty;
                let code = match self.shape(&cx, fields.at(&cx, 1usize).ty, pos) {
                    Fn(f) => f,
                    _ => self.fails(&cx, "a closure code field must have a function type", pos),
                };
                if code.params.is_empty(&cx) || code.places.contains(&cx, 0usize) {
                    self.fails(&cx, "a closure code function must take its environment by value first", pos);
                }
                self.unify_at(&cx, env, code.params.at(&cx, 0usize), pos);
                self.results().calls.insert(&cx, w.call.id, Callee::Closure);
                ptypes.append(&cx, code.params.skip(&cx, 1usize));
                var i = 0usize;
                while i < code.places.len(&cx) {
                    places.push(&cx, code.places.at(&cx, i) - 1usize);
                    i = i + 1usize;
                }
                code.ret.copy(&cx)
            },
            None => match s {
                Fn(f) => {
                    self.results().calls.insert(&cx, w.call.id, Callee::Value);
                    ptypes.append(&cx, f.params);
                    places.append(&cx, f.places);
                    f.ret.copy(&cx)
                },
                _ => self.fail(&cx, Buffer!::new().write(&cx, self.shown(&cx, zonk(&cx, w.callee))).put(" is not callable").save(&cx), pos),
            },
        };
        self.bind_operands(&cx, w.call, w.got, ptypes, places);
        self.unify_at(&cx, w.result, ret, pos);
    }

    // Type each argument now: its type, and whether it lends a place. Holding it to its parameter waits
    // for the callee.
    fn operands(self, &cx: Domain!['k], args: ArenaVec[Expr['k], 'k]) -> ArenaVec[Option[(Type['k], bool)], 'k] {
        let out: ArenaVec[Option[(Type['k], bool)], 'k] = ArenaVec::new(&cx);
        var i = 0usize;
        while i < args.len(&cx) {
            out.push(&cx, Option::Some.(self.operand(&cx, args.at(&cx, i))));
            i = i + 1usize;
        }
        out
    }

    fn operand(self, &cx: Domain!['k], arg: Expr['k]) -> (Type['k], bool) {
        let unit = match arg {
            Unary(u) => {
                let inner = u.operand.copy(&cx);
                if u.op.is(&cx, "unsafe") {
                    let unit = match inner {
                        Unary(lend) => if lend.op.is(&cx, "&") {
                            let call = match lend.operand.copy(&cx) {
                                Call(_c) => true,
                                _ => false,
                            };
                            if !call {
                                let (ty, lends) = self.operand(&cx, inner);
                                return (self.record(&cx, u.id, u.pos, ty), lends);
                            }
                        },
                        _ => (),
                    };
                } else if u.op.is(&cx, "&") {
                    let unit = match inner {
                        // `&*p`: a raw pointer's target
                        Unary(deref) => if deref.op.is(&cx, "*") {
                            let target = self.pointee(&cx, self.expr(&cx, deref.operand.copy(&cx)), u.pos);
                            return (self.record(&cx, u.id, u.pos, target), true);
                        },
                        _ => (),
                    };
                    if self.is_place(&cx, inner) {
                        return (self.record(&cx, u.id, u.pos, self.place_type(&cx, inner, false, true)), true);
                    }
                }
            },
            _ => (),
        };
        (self.expr(&cx, arg), false)
    }

    // Hold the operands to the parameters: the count, the `&` modes, the types. A method's receiver
    // is none.
    fn bind_operands(self, &cx: Domain!['k], c: S::Call['k], got: ArenaVec[Option[(Type['k], bool)], 'k], ptypes: ArenaVec[Type['k], 'k], places: ArenaVec[usize, 'k]) {
        if got.len(&cx) != ptypes.len(&cx) {
            self.fail(&cx, Buffer!::new().put("expected ").write(&cx, counted(&cx, ptypes.len(&cx), "argument")).put(", got ").put(got.len(&cx)).save(&cx), c.pos);
        }
        var k = 0usize;
        while k < got.len(&cx) {
            let unit = match got.at(&cx, k) {
                Some(operand) => {
                    let (ty, lends) = operand;
                    if places.contains(&cx, k) != lends {
                        self.fails(&cx, "an & parameter takes `&place`, and only an & parameter does", c.pos);
                    }
                    self.unify_at(&cx, ty, ptypes.at(&cx, k), c.pos);
                },
                None => (),
            };
            k = k + 1usize;
        }
    }

    fn require_signature(self, &cx: Domain!['k], sig: Sig['k], sub: ArenaMap[Str['k], Type['k], 'k], pos: Pos) {
        self.require_parameter_kinds(&cx, sig.params, sub, pos);
        var i = 0usize;
        while i < sig.premises.len(&cx) {
            let premise = sig.premises.at(&cx, i);
            self.require(&cx, premise.trait_name, self.subst_all(&cx, premise.args, sub), pos);
            i = i + 1usize;
        }
    }

    fn call_sig(self, &cx: Domain!['k], c: S::Call['k], call: FnCall['k], got: ArenaVec[Option[(Type['k], bool)], 'k]) -> Type['k] {
        self.require_signature(&cx, call.sig, call.sub, c.pos);
        self.bind_operands(&cx, c, got, self.subst_all(&cx, call.sig.ptypes, call.sub), call.sig.places);
        subst(&cx, call.sig.ret, call.sub, self.inf.counter)
    }

    fn trait_call(self, &cx: Domain!['k], c: S::Call['k], path: S::Path['k], trait_decl: Decl['k], method: Str['k]) -> Type['k] {
        let tr = self.inf.sigs.traits.at(&cx, self.inf.sigs.name(&cx, trait_decl));
        let written = self.path_arguments(&cx, path, trait_decl, true);
        if written.len(&cx) > tr.params.len(&cx) {
            self.fail(&cx, Buffer!::new().write(&cx, tr.name).put(" accepts at most ").write(&cx, counted(&cx, tr.params.len(&cx), "type argument")).put(", got ").put(written.len(&cx)).save(&cx), c.pos);
        }
        let targs: ArenaVec[Type['k], 'k] = ArenaVec::new(&cx);
        var i = 0usize;
        while i < tr.param_kinds.len(&cx) {
            targs.push(&cx, meta_of(&cx, tr.param_kinds.at(&cx, i)));
            i = i + 1usize;
        }
        i = 0usize;
        while i < written.len(&cx) {
            let unit = match written.at(&cx, i) {
                Ignored(_at) => (),
                _ => self.unify_at(&cx, targs.at(&cx, i), self.core_type(&cx, written.at(&cx, i)), c.pos),
            };
            i = i + 1usize;
        }
        self.trait_method(&cx, c, tr, method, targs, self.operands(&cx, c.args), Option::None)
    }

    fn method_of(self, &cx: Domain!['k], tr: C::Trait['k], method: Str['k]) -> C::Method['k] {
        var i = 0usize;
        while i < tr.methods.len(&cx) {
            if tr.methods.at(&cx, i).name.eq(&cx, method) {
                return tr.methods.at(&cx, i);
            }
            i = i + 1usize;
        }
        self.fails(&cx, "internal error: an unknown trait method", no_pos())
    }

    fn trait_method(self, &cx: Domain!['k], c: S::Call['k], tr: C::Trait['k], method: Str['k], targs: ArenaVec[Type['k], 'k], got: ArenaVec[Option[(Type['k], bool)], 'k],
                    receiver: Option[Receiver['k]]) -> Type['k] {
        let m = self.method_of(&cx, tr, method);
        let sub: ArenaMap[Str['k], Type['k], 'k] = ArenaMap::new(&cx);
        var i = 0usize;
        while i < tr.params.len(&cx) && i < targs.len(&cx) {
            sub.insert(&cx, tr.params.at(&cx, i), targs.at(&cx, i));
            i = i + 1usize;
        }
        i = 0usize;
        while i < tr.param_kinds.len(&cx) && i < targs.len(&cx) {
            if is_copy_kind(tr.param_kinds.at(&cx, i)) {
                self.require_copy(&cx, targs.at(&cx, i), c.pos);
            }
            i = i + 1usize;
        }
        let args = targs.clone(&cx);
        self.results().calls.insert(&cx, c.id, Callee::Trait.(TraitCall.{ trait_name: tr.name, method, targs: args, receiver }));
        self.require(&cx, tr.name, args, c.pos);
        self.bind_operands(&cx, c, got, self.subst_all(&cx, m.ptypes, sub), m.places);
        subst(&cx, m.ret, sub, self.inf.counter)
    }

    // `T::name(args)` for a type parameter `T`: the one bound of `T` with that method.
    fn assoc_call(self, &cx: Domain!['k], c: S::Call['k], path: S::Path['k], param: Str['k], name: Str['k]) -> Type['k] {
        if has_args(&cx, path) {
            self.fails(&cx, "an associated parameter call takes its type arguments from its trait premise", c.pos);
        }
        let found: ArenaVec[Premise['k], 'k] = ArenaVec::new(&cx);
        var i = 0usize;
        while i < self.assumptions.len(&cx) {
            let p = self.assumptions.at(&cx, i);
            let unit = match self.inf.sigs.traits.get(&cx, p.trait_name) {
                Some(tr) => {
                    var has = false;
                    var k = 0usize;
                    while k < tr.methods.len(&cx) {
                        if tr.methods.at(&cx, k).name.eq(&cx, name) {
                            has = true;
                        }
                        k = k + 1usize;
                    }
                    if has && !p.args.is_empty(&cx) && C::same(&cx, p.args.at(&cx, 0usize), C::named(param, ArenaVec::new(&cx))) {
                        found.push(&cx, p);
                    }
                },
                None => (),
            };
            i = i + 1usize;
        }
        if found.len(&cx) != 1usize {
            self.fail(&cx, f"{param}::{name} needs exactly one bound of {param} with that method".write(&cx, Buffer!::new()).save(&cx), c.pos);
        }
        let p = found.at(&cx, 0usize);
        self.trait_method(&cx, c, self.inf.sigs.traits.at(&cx, p.trait_name), name, p.args.clone(&cx), self.operands(&cx, c.args), Option::None)
    }

    fn builtin(self, &cx: Domain!['k], c: S::Call['k], path: S::Path['k], name: Str['k]) -> Type['k] {
        let arity = match builtin_arity(&cx, name) {
            Some(n) => n,
            None => self.fail(&cx, Buffer!::new().put("unknown builtin ").write(&cx, name).save(&cx), c.pos),
        };
        if c.args.len(&cx) != arity {
            if name.is(&cx, "fence") {
                self.fails(&cx, "fence takes one ordering argument", c.pos);
            }
            self.fail(&cx, Buffer!::new().write(&cx, name).put(" takes ").write(&cx, counted(&cx, arity, "value argument")).save(&cx), c.pos);
        }
        let count = path.segments.len(&cx);
        let targs = path.segments.at(&cx, count - 1usize).args;
        var i = 0usize;
        while i + 1usize < count {
            if !path.segments.at(&cx, i).args.is_empty(&cx) {
                self.fail(&cx, f"type arguments belong on {name}, not a namespace".write(&cx, Buffer!::new()).save(&cx), c.pos);
            }
            i = i + 1usize;
        }
        let expected = if name.is(&cx, "alloca") || name.is(&cx, "sizeof") { 1usize } else { 0usize };
        if targs.len(&cx) != expected {
            self.fail(&cx, Buffer!::new().write(&cx, name).put(" takes ").write(&cx, counted(&cx, expected, "type argument")).save(&cx), c.pos);
        }
        self.results().calls.insert(&cx, c.id, Callee::Builtin.(name));
        if name.is(&cx, "fresh") {
            Type::Exists.(ArenaVec::one(&cx, Str::from_static(&cx, "x")), ref_in(&cx, Type::Brand.(ref_in(&cx, Type::Skolem.(Str::from_static(&cx, "x"))))))
        } else if name.is(&cx, "static_brand") {
            Type::Brand.(ref_in(&cx, Type::Skolem.(Str::from_static(&cx, "static"))))
        } else if name.is(&cx, "trap") {
            Type::Never
        } else if name.is(&cx, "enum_variant") {
            let arg = c.args.at(&cx, 0usize);
            let arg_pos = S::expr_pos(arg);
            let lent = match arg {
                Unary(u) => if u.op.is(&cx, "&") { Option::Some.(u) } else { Option::None },
                _ => Option::None,
            };
            let operand = match lent {
                Some(u) => {
                    if !self.is_place(&cx, u.operand.copy(&cx)) {
                        self.fails(&cx, "enum_variant(&place) requires a place", arg_pos);
                    }
                    self.record(&cx, u.id, u.pos, self.place_type(&cx, u.operand.copy(&cx), false, true))
                },
                None => self.expr(&cx, arg),
            };
            if !is_never(&cx, operand) {
                self.later(&cx, operand, Action::EnumOperand.(operand), arg_pos);
            }
            if lent.is_some() { C::u32_type(&cx) } else { Type::Tuple.(ArenaVec::two(&cx, operand, C::u32_type(&cx))) }
        } else if name.is(&cx, "sizeof") {
            let target = self.core_type(&cx, targs.at(&cx, 0usize));
            // The size of a foreach type needs its source's exposure, and of a pointer source that
            // mentions a parameter, as a traversal does.
            let sources = self.inf.types.size_sources(&cx, target);
            var i = 0usize;
            while i < sources.len(&cx) {
                self.require(&cx, Str::from_static(&cx, "Exposed"), ArenaVec::one(&cx, sources.at(&cx, i)), c.pos);
                i = i + 1usize;
            }
            self.results().calls.insert(&cx, c.id, Callee::TypedBuiltin.(name, target));
            C::usize_type(&cx)
        } else if name.is(&cx, "alloca") {
            let target = self.core_type(&cx, targs.at(&cx, 0usize));
            self.results().calls.insert(&cx, c.id, Callee::TypedBuiltin.(name, target));
            C::ptr(&cx, target)
        } else if name.is(&cx, "fence") {
            let unit = self.check(&cx, c.args.at(&cx, 0usize), Option::Some.(C::named(self.library(&cx, "Ordering"), ArenaVec::new(&cx))));
            C::unit(&cx)
        } else {
            let pointer = self.expr(&cx, c.args.at(&cx, 0usize));
            let rest: ArenaVec[Type['k], 'k] = ArenaVec::new(&cx);
            i = 1usize;
            while i < c.args.len(&cx) {
                rest.push(&cx, self.expr(&cx, c.args.at(&cx, i)));
                i = i + 1usize;
            }
            self.pointer_op(&cx, c, name, pointer, rest)
        }
    }

    fn method_call(self, &cx: Domain!['k], c: S::Call['k], callee: S::Field['k], lent_receiver: bool) -> Type['k] {
        let receiver = callee.value.copy(&cx);
        let name = callee.name;
        let unit = match receiver {
            FStr(f) => if name.is(&cx, "write") {
                if c.args.len(&cx) == 2usize {
                    return self.fstring_reading(&cx, c, f);
                }
                let writer = new_meta(&cx);
                let unit = self.record(&cx, f.id, f.pos, self.expr_fstring(&cx, f, writer));
                self.results().calls.insert(&cx, c.id, Callee::FStringWrite.(f, Option::None));
                if c.args.len(&cx) != 1usize {
                    self.fails(&cx, "write takes the writer, or a lent context and the writer", c.pos);
                }
                let out = self.expr(&cx, c.args.at(&cx, 0usize));
                self.unify_at(&cx, writer, out, c.pos);
                self.require(&cx, self.library(&cx, "Writer"), ArenaVec::one(&cx, out), c.pos);
                return out;
            },
            _ => (),
        };
        // `&` is a way to pass a place, never a value: `(&x).m()` and `(unsafe &*p).m()` lend nothing, while
        // `(&x.m()).n()` lends the receiver of `m`.
        let lend = match receiver {
            Unary(u) => if u.op.is(&cx, "unsafe") { u.operand.copy(&cx) } else { receiver },
            _ => receiver,
        };
        let unit = match lend {
            Unary(u) => if u.op.is(&cx, "&") && self.first_call(&cx, u.operand.copy(&cx)).is_none() {
                self.fails(&cx, "a lend in parentheses is no receiver: a local's or a field's is lent as `&x.m()`, and a raw pointer's target as an argument, `T::m(unsafe &*p)`", S::expr_pos(receiver));
            },
            _ => (),
        };
        if lent_receiver && !self.is_place(&cx, receiver) {
            self.fails(&cx, "& lends a local or a field of one", c.pos);
        }
        let receiver_ty = if lent_receiver { self.place_type(&cx, receiver, false, true) } else { self.expr(&cx, receiver) };
        let actual = Receiver.{ value: receiver, lend: lent_receiver };
        let got: ArenaVec[Option[(Type['k], bool)], 'k] = ArenaVec::one(&cx, Option::None);
        got.append(&cx, self.operands(&cx, c.args));
        let result = new_meta(&cx);
        self.later(&cx, receiver_ty, Action::Method.(MethodWait.{ call: c, receiver: receiver_ty, name, actual, got, result }), c.pos);
        result
    }

    // The method `name` of the receiver's type: its signature instantiated, and its result type.
    fn resolve_method(self, &cx: Domain!['k], c: S::Call['k], receiver_ty: Type['k], name: Str['k], receiver: Receiver['k], got: ArenaVec[Option[(Type['k], bool)], 'k]) -> Type['k] {
        match self.find_method(&cx, receiver_ty, name, c.pos) {
            Pointer => {
                self.results().calls.insert(&cx, c.id, Callee::Pointer.(name, receiver.value));
                let operand_types: ArenaVec[Type['k], 'k] = ArenaVec::new(&cx);
                var i = 1usize;
                while i < got.len(&cx) {
                    let unit = match got.at(&cx, i) {
                        Some(operand) => {
                            let (ty, _lends) = operand;
                            operand_types.push(&cx, ty);
                        },
                        None => (),
                    };
                    i = i + 1usize;
                }
                self.pointer_op(&cx, c, name, receiver_ty, operand_types)
            },
            Trait(tr, targs) => {
                let m = self.method_of(&cx, tr, name);
                self.receiver_mode(&cx, name, m.places, receiver, c.pos);
                self.trait_method(&cx, c, tr, name, targs, got, Option::Some.(receiver))
            },
            Method(sig) => {
                if sig.ptypes.is_empty(&cx) {
                    self.fail(&cx, Buffer!::new().write(&cx, name).put(" takes no receiver").save(&cx), c.pos);
                }
                self.receiver_mode(&cx, name, sig.places, receiver, c.pos);
                let sub = self.instantiate_at(&cx, sig.params, name, c.pos);
                self.unify_at(&cx, subst(&cx, sig.ptypes.at(&cx, 0usize), sub, self.inf.counter), receiver_ty, c.pos);
                let call = FnCall.{ sig, sub, receiver: Option::Some.(receiver) };
                self.results().calls.insert(&cx, c.id, Callee::Fn.(call));
                self.call_sig(&cx, c, call, got)
            },
        }
    }

    fn receiver_mode(self, &cx: Domain!['k], name: Str['k], places: ArenaVec[usize, 'k], receiver: Receiver['k], pos: Pos) {
        let lends = places.contains(&cx, 0usize);
        if lends != receiver.lend {
            self.fail(&cx, Buffer!::new().write(&cx, name).put(" takes its receiver ").put(if lends { "by &" } else { "by value" }).save(&cx), pos);
        }
    }

    // Method lookup by name: the receiver type's own method, else the one trait (of a single input) or
    // blanket impl method of that name visible here. A name that several of them share is written
    // `Trait::name(x)`.
    fn find_method(self, &cx: Domain!['k], receiver_ty: Type['k], name: Str['k], pos: Pos) -> Lookup['k] {
        let t = zonk(&cx, receiver_ty);
        let owner = match t {
            Ptr(_i) => {
                if is_pointer_method(&cx, name) {
                    return Lookup::Pointer;
                }
                Option::None
            },
            Named(n, _args) => match self.inf.decl_of.get(&cx, n) {
                Some(d) => Option::Some.(Owner::Decl.(d)),
                None => Option::None,
            },
            Prim(n) => Option::Some.(Owner::Prim.(n)),
            NonNull(_i) => Option::Some.(Owner::Prim.(Str::from_static(&cx, "NonNull"))),
            _ => Option::None,
        };
        let candidates: ArenaVec[Lookup['k], 'k] = ArenaVec::new(&cx);
        let unit = match owner {
            Some(o) => {
                let own = self.inf.r.attached.get_or(&cx, (o, name), ArenaVec::new(&cx));
                var i = 0usize;
                while i < own.len(&cx) {
                    if own.at(&cx, i).kind.is(&cx, "method") {
                        candidates.push(&cx, Lookup::Method.(self.inf.sigs.sigs.at(&cx, own.at(&cx, i).id)));
                    }
                    i = i + 1usize;
                }
            },
            None => (),
        };
        if candidates.is_empty(&cx) {
            let visible = self.inf.visible_traits(&cx, self.home);
            let traits = self.inf.sigs.traits.values(&cx);
            var i = 0usize;
            while i < traits.len(&cx) {
                let tr = traits.at(&cx, i);
                let single = self.inf.inputs.get_or(&cx, tr.name, 0usize) == 1usize;
                let seen = match self.inf.decl_of.get(&cx, tr.name) {
                    Some(d) => visible.contains(&cx, d.id),
                    None => false,
                };
                var has = false;
                var k = 0usize;
                while k < tr.methods.len(&cx) {
                    if tr.methods.at(&cx, k).name.eq(&cx, name) {
                        has = true;
                    }
                    k = k + 1usize;
                }
                if single && seen && has {
                    let targs = ArenaVec::one(&cx, t);
                    k = 1usize;
                    while k < tr.param_kinds.len(&cx) {
                        targs.push(&cx, meta_of(&cx, tr.param_kinds.at(&cx, k)));
                        k = k + 1usize;
                    }
                    candidates.push(&cx, Lookup::Trait.(tr, targs));
                }
                i = i + 1usize;
            }
            let blanket = self.inf.r.attached.get_or(&cx, (Owner::Blanket, name), ArenaVec::new(&cx));
            i = 0usize;
            while i < blanket.len(&cx) {
                let d = blanket.at(&cx, i);
                if d.kind.is(&cx, "method") && self.inf.blanket_visible(&cx, d, self.home, visible) {
                    candidates.push(&cx, Lookup::Method.(self.inf.sigs.sigs.at(&cx, d.id)));
                }
                i = i + 1usize;
            }
        }
        if candidates.len(&cx) > 1usize {
            self.fail(&cx, Buffer!::new().write(&cx, self.shown(&cx, t)).put(" has several methods named ").write(&cx, name).save(&cx), pos);
        }
        if candidates.is_empty(&cx) {
            self.fail(&cx, Buffer!::new().write(&cx, self.shown(&cx, t)).put(" has no method ").write(&cx, name).write(&cx, self.import_hint(&cx, name)).save(&cx), pos);
        }
        candidates.at(&cx, 0usize)
    }

    // For a method no visible trait provides: the traits not visible in the calling module that would
    // provide it, to import: a trait of one input with the method, or a trait bounding a blanket impl
    // that has it.
    fn import_hint(self, &cx: Domain!['k], name: Str['k]) -> Str['k] {
        let visible = self.inf.visible_traits(&cx, self.home);
        let hidden: ArenaSet[Str['k], 'k] = ArenaSet::new(&cx);
        let traits = self.inf.sigs.traits.values(&cx);
        var i = 0usize;
        while i < traits.len(&cx) {
            let tr = traits.at(&cx, i);
            var has = false;
            var k = 0usize;
            while k < tr.methods.len(&cx) {
                has = has || tr.methods.at(&cx, k).name.eq(&cx, name);
                k = k + 1usize;
            }
            let unit = match self.inf.decl_of.get(&cx, tr.name) {
                Some(d) => if has && self.inf.inputs.get_or(&cx, tr.name, 0usize) == 1usize && !visible.contains(&cx, d.id) {
                    hidden.insert(&cx, d.name);
                },
                None => (),
            };
            i = i + 1usize;
        }
        let blanket = self.inf.r.attached.get_or(&cx, (Owner::Blanket, name), ArenaVec::new(&cx));
        i = 0usize;
        while i < blanket.len(&cx) {
            let d = blanket.at(&cx, i);
            if d.kind.is(&cx, "method") {
                let bounds = self.inf.blanket_bounds(&cx, d, self.home);
                var k = 0usize;
                while k < bounds.len(&cx) {
                    let b = bounds.at(&cx, k);
                    if !visible.contains(&cx, b.id) {
                        hidden.insert(&cx, b.name);
                    }
                    k = k + 1usize;
                }
            }
            i = i + 1usize;
        }
        let names = hidden.keys(&cx);
        names.sort_by(&cx, |&cx, a, b| a.cmp(&cx, b));
        if names.is_empty(&cx) {
            Str::from_static(&cx, "")
        } else if names.len(&cx) == 1usize {
            Buffer!::new().put("; the trait ").write(&cx, names.at(&cx, 0usize)).put(" provides it, import it").save(&cx)
        } else {
            Buffer!::new().put("; the traits ").write(&cx, listed(&cx, names)).put(" provide it, import one").save(&cx)
        }
    }

    // A pointer operation: its operands held to their types, once the pointee is known.
    fn pointer_op(self, &cx: Domain!['k], c: S::Call['k], name: Str['k], pointer: Type['k], operands: ArenaVec[Type['k], 'k]) -> Type['k] {
        let params = pointer_params(&cx, name);
        if operands.len(&cx) != params.len() {
            self.fail(&cx, Buffer!::new().write(&cx, name).put(" takes ").write(&cx, counted(&cx, params.len(), "argument")).save(&cx), c.pos);
        }
        let out = new_meta(&cx);
        self.later(&cx, pointer, Action::Pointer.(PointerWait.{ name, pointer, operands, out }), c.pos);
        out
    }

    fn pointer_known(self, &cx: Domain!['k], w: PointerWait['k], pos: Pos) {
        let inner = match self.shape(&cx, w.pointer, pos) {
            Ptr(inner) => inner.copy(&cx),
            _ => self.fail(&cx, Buffer!::new().write(&cx, w.name).put(" needs a pointer").save(&cx), pos),
        };
        let params = pointer_params(&cx, w.name);
        var i = 0usize;
        while i < w.operands.len(&cx) {
            let want = if params.byte_or_zero(&cx, i) == b'T' { inner } else { C::named(self.library(&cx, "Ordering"), ArenaVec::new(&cx)) };
            self.unify_at(&cx, w.operands.at(&cx, i), want, pos);
            i = i + 1usize;
        }
        let result = pointer_result(&cx, w.name);
        let ret = if result == b'T' {
            inner
        } else if result == b'U' {
            C::unit(&cx)
        } else {
            Type::Tuple.(ArenaVec::two(&cx, inner, C::bool_type(&cx)))
        };
        self.unify_at(&cx, w.out, ret, pos);
    }
}

forall 'k.
fn zonk_all(&cx: Domain!['k], ts: ArenaVec[Type['k], 'k]) {
    var i = 0usize;
    while i < ts.len(&cx) {
        ts.set(&cx, i, zonk(&cx, ts.at(&cx, i)));
        i = i + 1usize;
    }
}

forall 'k.
fn zonk_map(&cx: Domain!['k], sub: ArenaMap[Str['k], Type['k], 'k]) {
    let names = sub.keys(&cx);
    var i = 0usize;
    while i < names.len(&cx) {
        sub.insert(&cx, names.at(&cx, i), zonk(&cx, sub.at(&cx, names.at(&cx, i))));
        i = i + 1usize;
    }
}

// Infer every function body of the program.
forall 'k.
fn infer(&cx: Domain!['k], r: Resolver['k], sigs: Signatures['k], counter: Fresh['k]) -> Infer['k] {
    let inf = Infer::new(&cx, r, sigs, counter);
    inf.run(&cx);
    inf
}
