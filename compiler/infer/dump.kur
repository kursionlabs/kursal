// A canonical text form of what inference found, for comparing `infer` with the reference: each
// function with a body, in the order inference visits them, and then each node of its body in
// syntax order, with its type and the annotations inference made on it. Types are written as KURS
// writes them; a metavariable left unsolved is written `?` (`$?` for a brand).

use std::collections::arena_vec::ArenaVec;
use std::raw::Span;
use std::arena::Domain!;
use std::buffer::Buffer!;
use package::kurs::core::{MetaKind, Type};
use package::infer::inference::{Callee, Capture, Infer, Receiver, TraitCall};
use package::kurs::serial::{form_text, write_atom, write_type};
use package::resolve::resolver::Named;
use package::sigs::dump::const_text;
use package::syntax::ast as S;
use package::syntax::ast::{Expr, Pattern, Pos, Statement};
use package::types::ops::map_children;
use package::types::unify::prune;
use std::option::Option;
use std::slice::Slice;

forall 'k.
fn filled(&cx: Domain!['k], ty: Type['k]) -> Type['k] {
    let t = prune(&cx, ty);
    match t {
        Meta(m) => match m.kind(&cx) {
            Brand => Type::Skolem.(Span::from_static(&cx, "?")),
            _ => Type::Named.(Span::from_static(&cx, "?"), ArenaVec::new(&cx)),
        },
        _ => map_children(&cx, t, |&cx, child: Type['k]| filled(&cx, child)),
    }
}

forall 'k.
fn type_text(&cx: Domain!['k], ty: Type['k]) -> Span['k] {
    write_type(&cx, filled(&cx, ty))
}

forall 'k.
fn types_text(&cx: Domain!['k], ts: ArenaVec[Type['k], 'k]) -> Span['k] {
    let parts: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
    var i = 0usize;
    while i < ts.len(&cx) {
        parts.push(&cx, type_text(&cx, ts.at(&cx, i)));
        i = i + 1usize;
    }
    form_text(&cx, parts)
}

forall 'k.
fn ids_text(&cx: Domain!['k], ids: ArenaVec[u32, 'k]) -> Span['k] {
    let parts: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
    var i = 0usize;
    while i < ids.len(&cx) {
        parts.push(&cx, Buffer!::new().push_u64(ids.at(&cx, i) as u64).save(&cx));
        i = i + 1usize;
    }
    form_text(&cx, parts)
}

forall 'k.
fn receiver_text(&cx: Domain!['k], r: Option[Receiver['k]]) -> Span['k] {
    match r {
        Some(x) => Span::from_static(&cx, if x.lend { " &recv" } else { " recv" }),
        None => Span::from_static(&cx, ""),
    }
}

forall 'k.
fn trait_text(&cx: Domain!['k], t: TraitCall['k]) -> Span['k] {
    Buffer!::new().push_static("(trait ").push_bytes(&cx, write_atom(&cx, t.trait_name)).push_static(" ").push_bytes(&cx, write_atom(&cx, t.method)).push_static(" ").push_bytes(&cx, types_text(&cx, t.targs))
        .push_bytes(&cx, receiver_text(&cx, t.receiver)).push_static(")").save(&cx)
}

forall 'k.
fn callee_text(&cx: Domain!['k], c: Callee['k]) -> Span['k] {
    match c {
        Fn(f) => Buffer!::new().push_static("(fn ").push_bytes(&cx, write_atom(&cx, f.call_name())).push_static(" ").push_bytes(&cx, write_atom(&cx, f.sig.name)).push_static(" ")
            .push_bytes(&cx, types_text(&cx, f.targs(&cx))).push_bytes(&cx, receiver_text(&cx, f.receiver)).push_static(")").save(&cx),
        Trait(t) => trait_text(&cx, t),
        Value => Span::from_static(&cx, "(value)"),
        Closure => Span::from_static(&cx, "(closure)"),
        Variant(name) => Buffer!::new().push_static("(variant ").push_bytes(&cx, write_atom(&cx, name)).push_static(")").save(&cx),
        Tuple => Span::from_static(&cx, "(tuple)"),
        Builtin(name) => Buffer!::new().push_static("(builtin ").push_bytes(&cx, write_atom(&cx, name)).push_static(")").save(&cx),
        TypedBuiltin(name, t) => Buffer!::new().push_static("(").push_bytes(&cx, write_atom(&cx, name)).push_static(" ").push_bytes(&cx, type_text(&cx, t)).push_static(")").save(&cx),
        Pointer(name, _receiver) => Buffer!::new().push_static("(pointer ").push_bytes(&cx, write_atom(&cx, name)).push_static(")").save(&cx),
        FStringWrite(_f) => Span::from_static(&cx, "(fwrite)"),
    }
}

forall 'k.
fn captures_text(&cx: Domain!['k], cs: ArenaVec[Capture['k], 'k]) -> Span['k] {
    let parts: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
    var i = 0usize;
    while i < cs.len(&cx) {
        parts.push(&cx, Buffer!::new().push_static("(").push_bytes(&cx, write_atom(&cx, cs.at(&cx, i).name)).push_static(" ").push_u64(cs.at(&cx, i).binder as u64).push_static(")").save(&cx));
        i = i + 1usize;
    }
    form_text(&cx, parts)
}

forall 'k.
fn pos_text(&cx: Domain!['k], p: Pos) -> Span['k] {
    if p.line == 0u32 {
        Span::from_static(&cx, "_")
    } else {
        Buffer!::new().push_u64(p.line as u64).push_static(":").push_u64(p.col as u64).save(&cx)
    }
}

forall 'k.
exposed struct Walk {
    inf: Infer['k],
}

forall 'k.
impl Walk['k] {
    // One node's line: its tag, position, type and annotations.
    fn line(self, &cx: Domain!['k], &out: Buffer!, tag: Slice[u8, 'static], id: u32, p: Option[Pos]) {
        let r = self.inf.out;
        out = out.push_static("  ").push_static(tag);
        out = match p {
            Some(at) => out.push_static(" ").push_bytes(&cx, pos_text(&cx, at)),
            None => out,
        };
        out = match r.types.get(&cx, id) {
            Some(t) => out.push_static(" ").push_bytes(&cx, type_text(&cx, t)),
            None => out.push_static(" -"),
        };
        out = match r.binders.get(&cx, id) {
            Some(b) => out.push_static(" binder ").push_u64(b as u64),
            None => out,
        };
        out = match r.folded.get(&cx, id) {
            Some(v) => out.push_static(" folded (").push_bytes(&cx, const_text(&cx, v)).push_static(")"),
            None => out,
        };
        out = match r.calls.get(&cx, id) {
            Some(c) => out.push_static(" call ").push_bytes(&cx, callee_text(&cx, c)),
            None => out,
        };
        out = match r.field_ids.get(&cx, id) {
            Some(fields) => {
                let names = fields.keys(&cx);
                let parts: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
                var i = 0usize;
                while i < names.len(&cx) {
                    parts.push(&cx, Buffer!::new().push_static("(").push_bytes(&cx, write_atom(&cx, names.at(&cx, i))).push_static(" ").push_u64(fields.at(&cx, names.at(&cx, i)) as u64).push_static(")").save(&cx));
                    i = i + 1usize;
                }
                out.push_static(" fields ").push_bytes(&cx, form_text(&cx, parts))
            },
            None => out,
        };
        out = match r.spread_ids.get(&cx, id) {
            Some(b) => out.push_static(" spread ").push_u64(b as u64),
            None => out,
        };
        out = match r.case_binders.get(&cx, id) {
            Some(ids) => {
                let parts: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
                var i = 0usize;
                while i < ids.len(&cx) {
                    parts.push(&cx, match ids.at(&cx, i) {
                        Some(b) => Buffer!::new().push_u64(b as u64).save(&cx),
                        None => Span::from_static(&cx, "_"),
                    });
                    i = i + 1usize;
                }
                out.push_static(" binders ").push_bytes(&cx, form_text(&cx, parts))
            },
            None => out,
        };
        out = match r.lent.get(&cx, id) {
            Some(b) => out.push_static(if b { " lent #t" } else { " lent #f" }),
            None => out,
        };
        out = match r.param_ids.get(&cx, id) {
            Some(ids) => out.push_static(" params ").push_bytes(&cx, ids_text(&cx, ids)),
            None => out,
        };
        out = match r.captures.get(&cx, id) {
            Some(cs) => out.push_static(" captures ").push_bytes(&cx, captures_text(&cx, cs)),
            None => out,
        };
        out = match r.witnesses.get(&cx, id) {
            Some(ts) => out.push_static(" witnesses ").push_bytes(&cx, types_text(&cx, ts)),
            None => out,
        };
        out = match r.try_kinds.get(&cx, id) {
            Some(k) => out.push_static(" kind ").push_bytes(&cx, k),
            None => out,
        };
        out = match r.opened.get(&cx, id) {
            Some(labels) => {
                let parts: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
                var i = 0usize;
                while i < labels.len(&cx) {
                    parts.push(&cx, write_atom(&cx, labels.at(&cx, i)));
                    i = i + 1usize;
                }
                out.push_static(" opened ").push_bytes(&cx, form_text(&cx, parts))
            },
            None => out,
        };
        out = match r.options.get(&cx, id) {
            Some(t) => out.push_static(" option ").push_bytes(&cx, type_text(&cx, t)),
            None => out,
        };
        out = match r.next_calls.get(&cx, id) {
            Some(t) => out.push_static(" next ").push_bytes(&cx, trait_text(&cx, t)),
            None => out,
        };
        out = match r.rest_ids.get(&cx, id) {
            Some(b) => out.push_static(" rest ").push_u64(b as u64),
            None => out,
        };
        out = out.push_static("\n");
    }

    fn exprs(self, &cx: Domain!['k], &out: Buffer!, es: ArenaVec[Expr['k], 'k]) {
        var i = 0usize;
        while i < es.len(&cx) {
            self.expr(&cx, &out, es.at(&cx, i));
            i = i + 1usize;
        }
    }

    fn block(self, &cx: Domain!['k], &out: Buffer!, b: S::Block['k]) {
        self.line(&cx, &out, "block", b.id, Option::Some.(b.pos));
        var i = 0usize;
        while i < b.stmts.len(&cx) {
            self.statement(&cx, &out, b.stmts.at(&cx, i));
            i = i + 1usize;
        }
        let unit = match b.tail {
            Some(t) => self.expr(&cx, &out, t.copy(&cx)),
            None => (),
        };
    }

    fn expr(self, &cx: Domain!['k], &out: Buffer!, e: Expr['k]) {
        let id = S::expr_id(e);
        let at = Option::Some.(S::expr_pos(e));
        match e {
            Lit(_l) => self.line(&cx, &out, "lit", id, at),
            FStr(f) => {
                self.line(&cx, &out, "fstr", id, at);
                var i = 0usize;
                while i < f.parts.len(&cx) {
                    let unit = match f.parts.at(&cx, i) {
                        Expr(x) => self.expr(&cx, &out, x),
                        Text(_t) => (),
                    };
                    i = i + 1usize;
                }
            },
            Path(_p) => self.line(&cx, &out, "path", id, at),
            Tuple(n) => {
                self.line(&cx, &out, "tuple", id, at);
                self.exprs(&cx, &out, n.value);
            },
            Array(a) => {
                self.line(&cx, &out, "array", id, at);
                self.exprs(&cx, &out, a.elems);
            },
            StructLit(s) => {
                self.line(&cx, &out, "struct", id, at);
                var i = 0usize;
                while i < s.fields.len(&cx) {
                    let unit = match s.fields.at(&cx, i).value {
                        Some(v) => self.expr(&cx, &out, v),
                        None => (),
                    };
                    i = i + 1usize;
                }
            },
            Block(b) => self.block(&cx, &out, b),
            If(n) => {
                self.line(&cx, &out, "if", id, at);
                self.expr(&cx, &out, n.cond.copy(&cx));
                self.block(&cx, &out, n.then);
                let unit = match n.other {
                    Some(o) => self.expr(&cx, &out, o.copy(&cx)),
                    None => (),
                };
            },
            Match(m) => {
                self.line(&cx, &out, "match", id, at);
                self.expr(&cx, &out, m.scrutinee.copy(&cx));
                var i = 0usize;
                while i < m.arms.len(&cx) {
                    let arm = m.arms.at(&cx, i);
                    var k = 0usize;
                    while k < arm.cases.len(&cx) {
                        let c = arm.cases.at(&cx, k);
                        self.line(&cx, &out, "case", c.id, Option::Some.(c.pos));
                        k = k + 1usize;
                    }
                    self.expr(&cx, &out, arm.body);
                    i = i + 1usize;
                }
            },
            Closure(c) => {
                self.line(&cx, &out, "closure", id, at);
                self.expr(&cx, &out, c.body.copy(&cx));
            },
            Return(n) => {
                self.line(&cx, &out, "return", id, at);
                let unit = match n.value {
                    Some(v) => self.expr(&cx, &out, v.copy(&cx)),
                    None => (),
                };
            },
            Pack(p) => {
                self.line(&cx, &out, "pack", id, at);
                self.expr(&cx, &out, p.value.copy(&cx));
            },
            Foreach(f) => {
                self.line(&cx, &out, "foreach", id, at);
                self.expr(&cx, &out, f.source.copy(&cx));
                self.block(&cx, &out, f.body);
            },
            Binop(b) => {
                self.line(&cx, &out, "binop", id, at);
                self.expr(&cx, &out, b.left.copy(&cx));
                self.expr(&cx, &out, b.right.copy(&cx));
            },
            Unary(u) => {
                self.line(&cx, &out, "unary", id, at);
                self.expr(&cx, &out, u.operand.copy(&cx));
            },
            Cast(c) => {
                self.line(&cx, &out, "cast", id, at);
                self.expr(&cx, &out, c.value.copy(&cx));
            },
            UnsafeStore(s) => {
                self.line(&cx, &out, "store", id, at);
                self.expr(&cx, &out, s.pointer.copy(&cx));
                self.expr(&cx, &out, s.value.copy(&cx));
            },
            Field(f) => {
                self.line(&cx, &out, "field", id, at);
                self.expr(&cx, &out, f.value.copy(&cx));
            },
            Index(x) => {
                self.line(&cx, &out, "index", id, at);
                self.expr(&cx, &out, x.value.copy(&cx));
            },
            Call(c) => {
                self.line(&cx, &out, "call", id, at);
                self.expr(&cx, &out, c.callee.copy(&cx));
                self.exprs(&cx, &out, c.args);
            },
            Try(n) => {
                self.line(&cx, &out, "try", id, at);
                self.expr(&cx, &out, n.value.copy(&cx));
            },
            While(w) => {
                self.line(&cx, &out, "while", id, at);
                self.expr(&cx, &out, w.cond.copy(&cx));
                self.block(&cx, &out, w.body);
            },
            For(f) => {
                self.line(&cx, &out, "for", id, at);
                self.expr(&cx, &out, f.iterator.copy(&cx));
                self.block(&cx, &out, f.body);
            },
        }
    }

    fn statement(self, &cx: Domain!['k], &out: Buffer!, s: Statement['k]) {
        match s {
            Let(l) => {
                self.line(&cx, &out, "let", l.id, Option::Some.(l.pos));
                self.pattern(&cx, &out, l.pattern);
                self.expr(&cx, &out, l.value);
            },
            Var(v) => {
                self.line(&cx, &out, "var", v.id, Option::Some.(v.pos));
                self.expr(&cx, &out, v.value);
            },
            Assign(a) => {
                out = out.push_static("  assign ").push_bytes(&cx, pos_text(&cx, a.pos)).push_static("\n");
                self.expr(&cx, &out, a.target);
                self.expr(&cx, &out, a.value);
            },
            Expr(n) => self.expr(&cx, &out, n.value),
            Const(c) => {
                self.line(&cx, &out, "const", c.id, Option::Some.(c.pos));
                self.expr(&cx, &out, c.value);
            },
        }
    }

    fn pattern(self, &cx: Domain!['k], &out: Buffer!, p: Pattern['k]) {
        let id = S::pattern_id(p);
        match p {
            Bind(_n) => self.line(&cx, &out, "pbind", id, Option::None),
            Wild(_id) => self.line(&cx, &out, "pwild", id, Option::None),
            Tuple(n) => {
                self.line(&cx, &out, "ptuple", id, Option::None);
                self.patterns(&cx, &out, n.value);
            },
            Array(n) => {
                self.line(&cx, &out, "parray", id, Option::None);
                self.patterns(&cx, &out, n.value);
            },
            Struct(ps) => {
                self.line(&cx, &out, "pstruct", id, Option::None);
                var i = 0usize;
                while i < ps.fields.len(&cx) {
                    self.pattern(&cx, &out, ps.fields.at(&cx, i).pattern);
                    i = i + 1usize;
                }
            },
        }
    }

    fn patterns(self, &cx: Domain!['k], &out: Buffer!, ps: ArenaVec[Pattern['k], 'k]) {
        var i = 0usize;
        while i < ps.len(&cx) {
            self.pattern(&cx, &out, ps.at(&cx, i));
            i = i + 1usize;
        }
    }

    fn function(self, &cx: Domain!['k], &out: Buffer!, name: Span['k], node: S::Fn['k]) {
        out = out.push_static("fn ").push_bytes(&cx, write_atom(&cx, name)).push_static(" ").push_bytes(&cx, pos_text(&cx, node.pos)).push_static(" params ")
            .push_bytes(&cx, ids_text(&cx, self.inf.out.param_ids.get_or(&cx, node.id, ArenaVec::new(&cx)))).push_static("\n");
        let unit = match node.body {
            Some(b) => self.block(&cx, &out, b),
            None => (),
        };
    }
}

forall 'k.
fn program(&cx: Domain!['k], inf: Infer['k]) -> Span['k] {
    let w = Walk.{ inf };
    var out = Buffer!::new();
    let sigs = inf.sigs.sigs.values(&cx);
    var i = 0usize;
    while i < sigs.len(&cx) {
        let sig = sigs.at(&cx, i);
        let unit = match sig.decl {
            Some(decl) => match decl.node {
                Fn(node) => if node.body.is_some() {
                    w.function(&cx, &out, sig.name, node);
                },
                _ => (),
            },
            None => (),
        };
        i = i + 1usize;
    }
    i = 0usize;
    while i < inf.sigs.instances.len(&cx) {
        let (inst, item, _home) = inf.sigs.instances.at(&cx, i);
        var k = 0usize;
        while k < inst.methods.len(&cx) {
            w.function(&cx, &out, Buffer!::new().push_bytes(&cx, inst.trait_name).push_static("::").push_bytes(&cx, item.methods.at(&cx, k).name).save(&cx), item.methods.at(&cx, k));
            k = k + 1usize;
        }
        i = i + 1usize;
    }
    out.save(&cx)
}
