// A canonical text form of what inference found, for comparing `infer` with the reference: each
// function with a body, in the order inference visits them, and then each node of its body in
// syntax order, with its type and the annotations inference made on it. Types are written as KURS
// writes them; a metavariable left unsolved is written `?` (`$?` for a brand).

use package::support::base::{Cx, Out, Seq, Text, text};
use package::kurs::core::{MetaKind, Type};
use package::infer::inference::{Callee, Capture, Infer, Receiver, TraitCall};
use package::kurs::serial::{form_text, write_atom, write_type};
use package::resolve::resolver::Named;
use package::sigs::dump::const_text;
use package::syntax::ast as S;
use package::syntax::ast::{Expr, Pattern, Pos, Statement};
use package::types::ops::map_children;
use package::types::unify::prune;
use std::option::Option;
use std::slice::Slice;

forall 'k.
fn filled(&cx: Cx!['k], ty: Type['k]) -> Type['k] {
    let t = prune(&cx, ty);
    match t {
        Type::Meta(m) => match m.kind(&cx) {
            MetaKind::Brand => Type::Skolem.(text(&cx, "?")),
            _ => Type::Named.(text(&cx, "?"), Seq::new(&cx)),
        },
        _ => map_children(&cx, t, |&cx, child: Type['k]| filled(&cx, child)),
    }
}

forall 'k.
fn type_text(&cx: Cx!['k], ty: Type['k]) -> Text['k] {
    write_type(&cx, filled(&cx, ty))
}

forall 'k.
fn types_text(&cx: Cx!['k], ts: Seq[Type['k], 'k]) -> Text['k] {
    let parts: Seq[Text['k], 'k] = Seq::new(&cx);
    var i = 0usize;
    while i < ts.len(&cx) {
        parts.push(&cx, type_text(&cx, ts.get(&cx, i)));
        i = i + 1usize;
    }
    form_text(&cx, parts)
}

forall 'k.
fn ids_text(&cx: Cx!['k], ids: Seq[u32, 'k]) -> Text['k] {
    let parts: Seq[Text['k], 'k] = Seq::new(&cx);
    var i = 0usize;
    while i < ids.len(&cx) {
        parts.push(&cx, Out::new(&cx).u64(&cx, ids.get(&cx, i) as u64).done(&cx));
        i = i + 1usize;
    }
    form_text(&cx, parts)
}

forall 'k.
fn receiver_text(&cx: Cx!['k], r: Option[Receiver['k]]) -> Text['k] {
    match r {
        Option::Some(x) => text(&cx, if x.lend { " &recv" } else { " recv" }),
        Option::None => text(&cx, ""),
    }
}

forall 'k.
fn trait_text(&cx: Cx!['k], t: TraitCall['k]) -> Text['k] {
    Out::new(&cx).put(&cx, "(trait ").add(&cx, write_atom(&cx, t.trait_name)).put(&cx, " ").add(&cx, write_atom(&cx, t.method)).put(&cx, " ").add(&cx, types_text(&cx, t.targs))
        .add(&cx, receiver_text(&cx, t.receiver)).put(&cx, ")").done(&cx)
}

forall 'k.
fn callee_text(&cx: Cx!['k], c: Callee['k]) -> Text['k] {
    match c {
        Callee::Fn(f) => Out::new(&cx).put(&cx, "(fn ").add(&cx, write_atom(&cx, f.call_name())).put(&cx, " ").add(&cx, write_atom(&cx, f.sig.name)).put(&cx, " ")
            .add(&cx, types_text(&cx, f.targs(&cx))).add(&cx, receiver_text(&cx, f.receiver)).put(&cx, ")").done(&cx),
        Callee::Trait(t) => trait_text(&cx, t),
        Callee::Value(sub) => Out::new(&cx).put(&cx, "(value ").add(&cx, types_text(&cx, sub.values(&cx))).put(&cx, ")").done(&cx),
        Callee::Closure => text(&cx, "(closure)"),
        Callee::Variant(name) => Out::new(&cx).put(&cx, "(variant ").add(&cx, write_atom(&cx, name)).put(&cx, ")").done(&cx),
        Callee::Tuple => text(&cx, "(tuple)"),
        Callee::Builtin(name) => Out::new(&cx).put(&cx, "(builtin ").add(&cx, write_atom(&cx, name)).put(&cx, ")").done(&cx),
        Callee::Alloca(t) => Out::new(&cx).put(&cx, "(alloca ").add(&cx, type_text(&cx, t)).put(&cx, ")").done(&cx),
        Callee::Pointer(name, _receiver) => Out::new(&cx).put(&cx, "(pointer ").add(&cx, write_atom(&cx, name)).put(&cx, ")").done(&cx),
        Callee::FStringWrite(_f) => text(&cx, "(fwrite)"),
    }
}

forall 'k.
fn captures_text(&cx: Cx!['k], cs: Seq[Capture['k], 'k]) -> Text['k] {
    let parts: Seq[Text['k], 'k] = Seq::new(&cx);
    var i = 0usize;
    while i < cs.len(&cx) {
        parts.push(&cx, Out::new(&cx).put(&cx, "(").add(&cx, write_atom(&cx, cs.get(&cx, i).name)).put(&cx, " ").u64(&cx, cs.get(&cx, i).binder as u64).put(&cx, ")").done(&cx));
        i = i + 1usize;
    }
    form_text(&cx, parts)
}

forall 'k.
fn pos_text(&cx: Cx!['k], p: Pos) -> Text['k] {
    if p.line == 0u32 {
        text(&cx, "_")
    } else {
        Out::new(&cx).u64(&cx, p.line as u64).put(&cx, ":").u64(&cx, p.col as u64).done(&cx)
    }
}

forall 'k.
exposed struct Walk {
    inf: Infer['k],
    out: Out['k],
}

forall 'k.
impl Walk['k] {
    // One node's line: its tag, position, type and annotations.
    fn line(self, &cx: Cx!['k], tag: Slice[u8, 'static], id: u32, p: Option[Pos]) {
        let r = self.inf.out;
        let out = self.out.put(&cx, "  ").put(&cx, tag);
        let unit = match p {
            Option::Some(at) => out.put(&cx, " ").add(&cx, pos_text(&cx, at)),
            Option::None => out,
        };
        let unit = match r.types.get(&cx, id) {
            Option::Some(t) => out.put(&cx, " ").add(&cx, type_text(&cx, t)),
            Option::None => out.put(&cx, " -"),
        };
        let unit = match r.binders.get(&cx, id) {
            Option::Some(b) => out.put(&cx, " binder ").u64(&cx, b as u64),
            Option::None => out,
        };
        let unit = match r.folded.get(&cx, id) {
            Option::Some(v) => out.put(&cx, " folded (").add(&cx, const_text(&cx, v)).put(&cx, ")"),
            Option::None => out,
        };
        let unit = match r.calls.get(&cx, id) {
            Option::Some(c) => out.put(&cx, " call ").add(&cx, callee_text(&cx, c)),
            Option::None => out,
        };
        let unit = match r.targets.get(&cx, id) {
            Option::Some(t) => out.put(&cx, " target ").add(&cx, type_text(&cx, t)),
            Option::None => out,
        };
        let unit = match r.field_ids.get(&cx, id) {
            Option::Some(fields) => {
                let names = fields.keys(&cx);
                let parts: Seq[Text['k], 'k] = Seq::new(&cx);
                var i = 0usize;
                while i < names.len(&cx) {
                    parts.push(&cx, Out::new(&cx).put(&cx, "(").add(&cx, write_atom(&cx, names.get(&cx, i))).put(&cx, " ").u64(&cx, fields.at(&cx, names.get(&cx, i)) as u64).put(&cx, ")").done(&cx));
                    i = i + 1usize;
                }
                out.put(&cx, " fields ").add(&cx, form_text(&cx, parts))
            },
            Option::None => out,
        };
        let unit = match r.spread_ids.get(&cx, id) {
            Option::Some(b) => out.put(&cx, " spread ").u64(&cx, b as u64),
            Option::None => out,
        };
        let unit = match r.case_binders.get(&cx, id) {
            Option::Some(ids) => {
                let parts: Seq[Text['k], 'k] = Seq::new(&cx);
                var i = 0usize;
                while i < ids.len(&cx) {
                    parts.push(&cx, match ids.get(&cx, i) {
                        Option::Some(b) => Out::new(&cx).u64(&cx, b as u64).done(&cx),
                        Option::None => text(&cx, "_"),
                    });
                    i = i + 1usize;
                }
                out.put(&cx, " binders ").add(&cx, form_text(&cx, parts))
            },
            Option::None => out,
        };
        let unit = match r.lent.get(&cx, id) {
            Option::Some(b) => out.put(&cx, if b { " lent #t" } else { " lent #f" }),
            Option::None => out,
        };
        let unit = match r.param_ids.get(&cx, id) {
            Option::Some(ids) => out.put(&cx, " params ").add(&cx, ids_text(&cx, ids)),
            Option::None => out,
        };
        let unit = match r.captures.get(&cx, id) {
            Option::Some(cs) => out.put(&cx, " captures ").add(&cx, captures_text(&cx, cs)),
            Option::None => out,
        };
        let unit = match r.witnesses.get(&cx, id) {
            Option::Some(ts) => out.put(&cx, " witnesses ").add(&cx, types_text(&cx, ts)),
            Option::None => out,
        };
        let unit = match r.try_kinds.get(&cx, id) {
            Option::Some(k) => out.put(&cx, " kind ").add(&cx, k),
            Option::None => out,
        };
        let unit = match r.opened.get(&cx, id) {
            Option::Some(labels) => {
                let parts: Seq[Text['k], 'k] = Seq::new(&cx);
                var i = 0usize;
                while i < labels.len(&cx) {
                    parts.push(&cx, write_atom(&cx, labels.get(&cx, i)));
                    i = i + 1usize;
                }
                out.put(&cx, " opened ").add(&cx, form_text(&cx, parts))
            },
            Option::None => out,
        };
        let unit = match r.options.get(&cx, id) {
            Option::Some(t) => out.put(&cx, " option ").add(&cx, type_text(&cx, t)),
            Option::None => out,
        };
        let unit = match r.next_calls.get(&cx, id) {
            Option::Some(t) => out.put(&cx, " next ").add(&cx, trait_text(&cx, t)),
            Option::None => out,
        };
        let unit = match r.rest_ids.get(&cx, id) {
            Option::Some(b) => out.put(&cx, " rest ").u64(&cx, b as u64),
            Option::None => out,
        };
        let unit = out.put(&cx, "\n");
    }

    fn exprs(self, &cx: Cx!['k], es: Seq[Expr['k], 'k]) {
        var i = 0usize;
        while i < es.len(&cx) {
            self.expr(&cx, es.get(&cx, i));
            i = i + 1usize;
        }
    }

    fn block(self, &cx: Cx!['k], b: S::Block['k]) {
        self.line(&cx, "block", b.id, Option::Some.(b.pos));
        var i = 0usize;
        while i < b.stmts.len(&cx) {
            self.statement(&cx, b.stmts.get(&cx, i));
            i = i + 1usize;
        }
        let unit = match b.tail {
            Option::Some(t) => self.expr(&cx, t.get(&cx)),
            Option::None => (),
        };
    }

    fn expr(self, &cx: Cx!['k], e: Expr['k]) {
        let id = S::expr_id(e);
        let at = Option::Some.(S::expr_pos(e));
        match e {
            Expr::Lit(_l) => self.line(&cx, "lit", id, at),
            Expr::FStr(f) => {
                self.line(&cx, "fstr", id, at);
                var i = 0usize;
                while i < f.parts.len(&cx) {
                    let unit = match f.parts.get(&cx, i) {
                        S::Piece::Expr(x) => self.expr(&cx, x),
                        S::Piece::Text(_t) => (),
                    };
                    i = i + 1usize;
                }
            },
            Expr::Path(_p) => self.line(&cx, "path", id, at),
            Expr::Tuple(n) => {
                self.line(&cx, "tuple", id, at);
                self.exprs(&cx, n.value);
            },
            Expr::Array(a) => {
                self.line(&cx, "array", id, at);
                self.exprs(&cx, a.elems);
            },
            Expr::Sizeof(_n) => self.line(&cx, "sizeof", id, at),
            Expr::StructLit(s) => {
                self.line(&cx, "struct", id, at);
                var i = 0usize;
                while i < s.fields.len(&cx) {
                    let unit = match s.fields.get(&cx, i).value {
                        Option::Some(v) => self.expr(&cx, v),
                        Option::None => (),
                    };
                    i = i + 1usize;
                }
            },
            Expr::Block(b) => self.block(&cx, b),
            Expr::If(n) => {
                self.line(&cx, "if", id, at);
                self.expr(&cx, n.cond.get(&cx));
                self.block(&cx, n.then);
                let unit = match n.other {
                    Option::Some(o) => self.expr(&cx, o.get(&cx)),
                    Option::None => (),
                };
            },
            Expr::Match(m) => {
                self.line(&cx, "match", id, at);
                self.expr(&cx, m.scrutinee.get(&cx));
                var i = 0usize;
                while i < m.arms.len(&cx) {
                    let arm = m.arms.get(&cx, i);
                    var k = 0usize;
                    while k < arm.cases.len(&cx) {
                        let c = arm.cases.get(&cx, k);
                        self.line(&cx, "case", c.id, Option::Some.(c.pos));
                        k = k + 1usize;
                    }
                    self.expr(&cx, arm.body);
                    i = i + 1usize;
                }
            },
            Expr::Closure(c) => {
                self.line(&cx, "closure", id, at);
                self.expr(&cx, c.body.get(&cx));
            },
            Expr::Return(n) => {
                self.line(&cx, "return", id, at);
                let unit = match n.value {
                    Option::Some(v) => self.expr(&cx, v.get(&cx)),
                    Option::None => (),
                };
            },
            Expr::Pack(p) => {
                self.line(&cx, "pack", id, at);
                self.expr(&cx, p.value.get(&cx));
            },
            Expr::Foreach(f) => {
                self.line(&cx, "foreach", id, at);
                self.expr(&cx, f.source.get(&cx));
                self.block(&cx, f.body);
            },
            Expr::Binop(b) => {
                self.line(&cx, "binop", id, at);
                self.expr(&cx, b.left.get(&cx));
                self.expr(&cx, b.right.get(&cx));
            },
            Expr::Unary(u) => {
                self.line(&cx, "unary", id, at);
                self.expr(&cx, u.operand.get(&cx));
            },
            Expr::Cast(c) => {
                self.line(&cx, "cast", id, at);
                self.expr(&cx, c.value.get(&cx));
            },
            Expr::UnsafeStore(s) => {
                self.line(&cx, "store", id, at);
                self.expr(&cx, s.pointer.get(&cx));
                self.expr(&cx, s.value.get(&cx));
            },
            Expr::Field(f) => {
                self.line(&cx, "field", id, at);
                self.expr(&cx, f.value.get(&cx));
            },
            Expr::Index(x) => {
                self.line(&cx, "index", id, at);
                self.expr(&cx, x.value.get(&cx));
            },
            Expr::Call(c) => {
                self.line(&cx, "call", id, at);
                self.expr(&cx, c.callee.get(&cx));
                self.exprs(&cx, c.args);
            },
            Expr::Try(n) => {
                self.line(&cx, "try", id, at);
                self.expr(&cx, n.value.get(&cx));
            },
            Expr::While(w) => {
                self.line(&cx, "while", id, at);
                self.expr(&cx, w.cond.get(&cx));
                self.block(&cx, w.body);
            },
            Expr::For(f) => {
                self.line(&cx, "for", id, at);
                self.expr(&cx, f.iterator.get(&cx));
                self.block(&cx, f.body);
            },
        }
    }

    fn statement(self, &cx: Cx!['k], s: Statement['k]) {
        match s {
            Statement::Let(l) => {
                self.line(&cx, "let", l.id, Option::Some.(l.pos));
                self.pattern(&cx, l.pattern);
                self.expr(&cx, l.value);
            },
            Statement::Var(v) => {
                self.line(&cx, "var", v.id, Option::Some.(v.pos));
                self.expr(&cx, v.value);
            },
            Statement::Assign(a) => {
                let unit = self.out.put(&cx, "  assign ").add(&cx, pos_text(&cx, a.pos)).put(&cx, "\n");
                self.expr(&cx, a.target);
                self.expr(&cx, a.value);
            },
            Statement::Expr(n) => self.expr(&cx, n.value),
            Statement::Const(c) => {
                self.line(&cx, "const", c.id, Option::Some.(c.pos));
                self.expr(&cx, c.value);
            },
        }
    }

    fn pattern(self, &cx: Cx!['k], p: Pattern['k]) {
        let id = S::pattern_id(p);
        match p {
            Pattern::Bind(_n) => self.line(&cx, "pbind", id, Option::None),
            Pattern::Wild(_id) => self.line(&cx, "pwild", id, Option::None),
            Pattern::Tuple(n) => {
                self.line(&cx, "ptuple", id, Option::None);
                self.patterns(&cx, n.value);
            },
            Pattern::Array(n) => {
                self.line(&cx, "parray", id, Option::None);
                self.patterns(&cx, n.value);
            },
            Pattern::Struct(ps) => {
                self.line(&cx, "pstruct", id, Option::None);
                var i = 0usize;
                while i < ps.fields.len(&cx) {
                    self.pattern(&cx, ps.fields.get(&cx, i).pattern);
                    i = i + 1usize;
                }
            },
        }
    }

    fn patterns(self, &cx: Cx!['k], ps: Seq[Pattern['k], 'k]) {
        var i = 0usize;
        while i < ps.len(&cx) {
            self.pattern(&cx, ps.get(&cx, i));
            i = i + 1usize;
        }
    }

    fn function(self, &cx: Cx!['k], name: Text['k], node: S::Fn['k]) {
        let unit = self.out.put(&cx, "fn ").add(&cx, write_atom(&cx, name)).put(&cx, " ").add(&cx, pos_text(&cx, node.pos)).put(&cx, " params ")
            .add(&cx, ids_text(&cx, self.inf.out.param_ids.get_or(&cx, node.id, Seq::new(&cx)))).put(&cx, "\n");
        let unit = match node.body {
            Option::Some(b) => self.block(&cx, b),
            Option::None => (),
        };
    }
}

forall 'k.
fn program(&cx: Cx!['k], inf: Infer['k]) -> Text['k] {
    let w = Walk.{ inf, out: Out::new(&cx) };
    let sigs = inf.sigs.sigs.values(&cx);
    var i = 0usize;
    while i < sigs.len(&cx) {
        let sig = sigs.get(&cx, i);
        let unit = match sig.decl {
            Option::Some(decl) => match decl.node {
                Named::Fn(node) => if node.body.is_some() {
                    w.function(&cx, sig.name, node);
                },
                _ => (),
            },
            Option::None => (),
        };
        i = i + 1usize;
    }
    i = 0usize;
    while i < inf.sigs.instances.len(&cx) {
        let (inst, item, _home) = inf.sigs.instances.get(&cx, i);
        var k = 0usize;
        while k < inst.methods.len(&cx) {
            w.function(&cx, Out::new(&cx).add(&cx, inst.trait_name).put(&cx, "::").add(&cx, item.methods.get(&cx, k).name).done(&cx), item.methods.get(&cx, k));
            k = k + 1usize;
        }
        i = i + 1usize;
    }
    w.out.done(&cx)
}
