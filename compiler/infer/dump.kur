// A canonical text form of what inference found, for comparing `infer` with the reference: each
// function with a body, in the order inference visits them, and then each node of its body in
// syntax order, with its type and the annotations inference made on it. Types are written as KURS
// writes them; a metavariable left unsolved is written `?` (`$?` for a brand).

use package::support::base::{Cx, Seq, Text, text, text_of};
use std::bytes::buffer::Buffer;
use package::kurs::core::{MetaKind, Type};
use package::infer::inference::{Callee, Capture, Infer, Receiver, TraitCall};
use package::kurs::serial::{form_text, write_atom, write_type};
use package::resolve::resolver::Named;
use package::sigs::dump::const_text;
use package::syntax::ast as S;
use package::syntax::ast::{Expr, Pattern, Pos, Statement};
use package::types::ops::map_children;
use package::types::unify::prune;
use std::option::Option;
use std::slice::Slice;

forall 'k.
fn filled(&cx: Cx!['k], ty: Type['k]) -> Type['k] {
    let t = prune(&cx, ty);
    match t {
        Type::Meta(m) => match m.kind(&cx) {
            MetaKind::Brand => Type::Skolem.(text(&cx, "?")),
            _ => Type::Named.(text(&cx, "?"), Seq::new(&cx)),
        },
        _ => map_children(&cx, t, |&cx, child: Type['k]| filled(&cx, child)),
    }
}

forall 'k.
fn type_text(&cx: Cx!['k], ty: Type['k]) -> Text['k] {
    write_type(&cx, filled(&cx, ty))
}

forall 'k.
fn types_text(&cx: Cx!['k], ts: Seq[Type['k], 'k]) -> Text['k] {
    let parts: Seq[Text['k], 'k] = Seq::new(&cx);
    var i = 0usize;
    while i < ts.len(&cx) {
        parts.push(&cx, type_text(&cx, ts.get(&cx, i)));
        i = i + 1usize;
    }
    form_text(&cx, parts)
}

forall 'k.
fn ids_text(&cx: Cx!['k], ids: Seq[u32, 'k]) -> Text['k] {
    let parts: Seq[Text['k], 'k] = Seq::new(&cx);
    var i = 0usize;
    while i < ids.len(&cx) {
        parts.push(&cx, text_of(&cx, Buffer::new().push_u64(ids.get(&cx, i) as u64)));
        i = i + 1usize;
    }
    form_text(&cx, parts)
}

forall 'k.
fn receiver_text(&cx: Cx!['k], r: Option[Receiver['k]]) -> Text['k] {
    match r {
        Option::Some(x) => text(&cx, if x.lend { " &recv" } else { " recv" }),
        Option::None => text(&cx, ""),
    }
}

forall 'k.
fn trait_text(&cx: Cx!['k], t: TraitCall['k]) -> Text['k] {
    text_of(&cx, Buffer::new().push_static("(trait ").push_bytes(&cx, write_atom(&cx, t.trait_name)).push_static(" ").push_bytes(&cx, write_atom(&cx, t.method)).push_static(" ").push_bytes(&cx, types_text(&cx, t.targs))
        .push_bytes(&cx, receiver_text(&cx, t.receiver)).push_static(")"))
}

forall 'k.
fn callee_text(&cx: Cx!['k], c: Callee['k]) -> Text['k] {
    match c {
        Callee::Fn(f) => text_of(&cx, Buffer::new().push_static("(fn ").push_bytes(&cx, write_atom(&cx, f.call_name())).push_static(" ").push_bytes(&cx, write_atom(&cx, f.sig.name)).push_static(" ")
            .push_bytes(&cx, types_text(&cx, f.targs(&cx))).push_bytes(&cx, receiver_text(&cx, f.receiver)).push_static(")")),
        Callee::Trait(t) => trait_text(&cx, t),
        Callee::Value(sub) => text_of(&cx, Buffer::new().push_static("(value ").push_bytes(&cx, types_text(&cx, sub.values(&cx))).push_static(")")),
        Callee::Closure => text(&cx, "(closure)"),
        Callee::Variant(name) => text_of(&cx, Buffer::new().push_static("(variant ").push_bytes(&cx, write_atom(&cx, name)).push_static(")")),
        Callee::Tuple => text(&cx, "(tuple)"),
        Callee::Builtin(name) => text_of(&cx, Buffer::new().push_static("(builtin ").push_bytes(&cx, write_atom(&cx, name)).push_static(")")),
        Callee::Alloca(t) => text_of(&cx, Buffer::new().push_static("(alloca ").push_bytes(&cx, type_text(&cx, t)).push_static(")")),
        Callee::Pointer(name, _receiver) => text_of(&cx, Buffer::new().push_static("(pointer ").push_bytes(&cx, write_atom(&cx, name)).push_static(")")),
        Callee::FStringWrite(_f) => text(&cx, "(fwrite)"),
    }
}

forall 'k.
fn captures_text(&cx: Cx!['k], cs: Seq[Capture['k], 'k]) -> Text['k] {
    let parts: Seq[Text['k], 'k] = Seq::new(&cx);
    var i = 0usize;
    while i < cs.len(&cx) {
        parts.push(&cx, text_of(&cx, Buffer::new().push_static("(").push_bytes(&cx, write_atom(&cx, cs.get(&cx, i).name)).push_static(" ").push_u64(cs.get(&cx, i).binder as u64).push_static(")")));
        i = i + 1usize;
    }
    form_text(&cx, parts)
}

forall 'k.
fn pos_text(&cx: Cx!['k], p: Pos) -> Text['k] {
    if p.line == 0u32 {
        text(&cx, "_")
    } else {
        text_of(&cx, Buffer::new().push_u64(p.line as u64).push_static(":").push_u64(p.col as u64))
    }
}

forall 'k.
exposed struct Walk {
    inf: Infer['k],
}

forall 'k.
impl Walk['k] {
    // One node's line: its tag, position, type and annotations.
    fn line(self, &cx: Cx!['k], &out: Buffer!, tag: Slice[u8, 'static], id: u32, p: Option[Pos]) {
        let r = self.inf.out;
        out = out.push_static("  ").push_static(tag);
        out = match p {
            Option::Some(at) => out.push_static(" ").push_bytes(&cx, pos_text(&cx, at)),
            Option::None => out,
        };
        out = match r.types.get(&cx, id) {
            Option::Some(t) => out.push_static(" ").push_bytes(&cx, type_text(&cx, t)),
            Option::None => out.push_static(" -"),
        };
        out = match r.binders.get(&cx, id) {
            Option::Some(b) => out.push_static(" binder ").push_u64(b as u64),
            Option::None => out,
        };
        out = match r.folded.get(&cx, id) {
            Option::Some(v) => out.push_static(" folded (").push_bytes(&cx, const_text(&cx, v)).push_static(")"),
            Option::None => out,
        };
        out = match r.calls.get(&cx, id) {
            Option::Some(c) => out.push_static(" call ").push_bytes(&cx, callee_text(&cx, c)),
            Option::None => out,
        };
        out = match r.targets.get(&cx, id) {
            Option::Some(t) => out.push_static(" target ").push_bytes(&cx, type_text(&cx, t)),
            Option::None => out,
        };
        out = match r.field_ids.get(&cx, id) {
            Option::Some(fields) => {
                let names = fields.keys(&cx);
                let parts: Seq[Text['k], 'k] = Seq::new(&cx);
                var i = 0usize;
                while i < names.len(&cx) {
                    parts.push(&cx, text_of(&cx, Buffer::new().push_static("(").push_bytes(&cx, write_atom(&cx, names.get(&cx, i))).push_static(" ").push_u64(fields.at(&cx, names.get(&cx, i)) as u64).push_static(")")));
                    i = i + 1usize;
                }
                out.push_static(" fields ").push_bytes(&cx, form_text(&cx, parts))
            },
            Option::None => out,
        };
        out = match r.spread_ids.get(&cx, id) {
            Option::Some(b) => out.push_static(" spread ").push_u64(b as u64),
            Option::None => out,
        };
        out = match r.case_binders.get(&cx, id) {
            Option::Some(ids) => {
                let parts: Seq[Text['k], 'k] = Seq::new(&cx);
                var i = 0usize;
                while i < ids.len(&cx) {
                    parts.push(&cx, match ids.get(&cx, i) {
                        Option::Some(b) => text_of(&cx, Buffer::new().push_u64(b as u64)),
                        Option::None => text(&cx, "_"),
                    });
                    i = i + 1usize;
                }
                out.push_static(" binders ").push_bytes(&cx, form_text(&cx, parts))
            },
            Option::None => out,
        };
        out = match r.lent.get(&cx, id) {
            Option::Some(b) => out.push_static(if b { " lent #t" } else { " lent #f" }),
            Option::None => out,
        };
        out = match r.param_ids.get(&cx, id) {
            Option::Some(ids) => out.push_static(" params ").push_bytes(&cx, ids_text(&cx, ids)),
            Option::None => out,
        };
        out = match r.captures.get(&cx, id) {
            Option::Some(cs) => out.push_static(" captures ").push_bytes(&cx, captures_text(&cx, cs)),
            Option::None => out,
        };
        out = match r.witnesses.get(&cx, id) {
            Option::Some(ts) => out.push_static(" witnesses ").push_bytes(&cx, types_text(&cx, ts)),
            Option::None => out,
        };
        out = match r.try_kinds.get(&cx, id) {
            Option::Some(k) => out.push_static(" kind ").push_bytes(&cx, k),
            Option::None => out,
        };
        out = match r.opened.get(&cx, id) {
            Option::Some(labels) => {
                let parts: Seq[Text['k], 'k] = Seq::new(&cx);
                var i = 0usize;
                while i < labels.len(&cx) {
                    parts.push(&cx, write_atom(&cx, labels.get(&cx, i)));
                    i = i + 1usize;
                }
                out.push_static(" opened ").push_bytes(&cx, form_text(&cx, parts))
            },
            Option::None => out,
        };
        out = match r.options.get(&cx, id) {
            Option::Some(t) => out.push_static(" option ").push_bytes(&cx, type_text(&cx, t)),
            Option::None => out,
        };
        out = match r.next_calls.get(&cx, id) {
            Option::Some(t) => out.push_static(" next ").push_bytes(&cx, trait_text(&cx, t)),
            Option::None => out,
        };
        out = match r.rest_ids.get(&cx, id) {
            Option::Some(b) => out.push_static(" rest ").push_u64(b as u64),
            Option::None => out,
        };
        out = out.push_static("\n");
    }

    fn exprs(self, &cx: Cx!['k], &out: Buffer!, es: Seq[Expr['k], 'k]) {
        var i = 0usize;
        while i < es.len(&cx) {
            self.expr(&cx, &out, es.get(&cx, i));
            i = i + 1usize;
        }
    }

    fn block(self, &cx: Cx!['k], &out: Buffer!, b: S::Block['k]) {
        self.line(&cx, &out, "block", b.id, Option::Some.(b.pos));
        var i = 0usize;
        while i < b.stmts.len(&cx) {
            self.statement(&cx, &out, b.stmts.get(&cx, i));
            i = i + 1usize;
        }
        let unit = match b.tail {
            Option::Some(t) => self.expr(&cx, &out, t.get(&cx)),
            Option::None => (),
        };
    }

    fn expr(self, &cx: Cx!['k], &out: Buffer!, e: Expr['k]) {
        let id = S::expr_id(e);
        let at = Option::Some.(S::expr_pos(e));
        match e {
            Expr::Lit(_l) => self.line(&cx, &out, "lit", id, at),
            Expr::FStr(f) => {
                self.line(&cx, &out, "fstr", id, at);
                var i = 0usize;
                while i < f.parts.len(&cx) {
                    let unit = match f.parts.get(&cx, i) {
                        S::Piece::Expr(x) => self.expr(&cx, &out, x),
                        S::Piece::Text(_t) => (),
                    };
                    i = i + 1usize;
                }
            },
            Expr::Path(_p) => self.line(&cx, &out, "path", id, at),
            Expr::Tuple(n) => {
                self.line(&cx, &out, "tuple", id, at);
                self.exprs(&cx, &out, n.value);
            },
            Expr::Array(a) => {
                self.line(&cx, &out, "array", id, at);
                self.exprs(&cx, &out, a.elems);
            },
            Expr::Sizeof(_n) => self.line(&cx, &out, "sizeof", id, at),
            Expr::StructLit(s) => {
                self.line(&cx, &out, "struct", id, at);
                var i = 0usize;
                while i < s.fields.len(&cx) {
                    let unit = match s.fields.get(&cx, i).value {
                        Option::Some(v) => self.expr(&cx, &out, v),
                        Option::None => (),
                    };
                    i = i + 1usize;
                }
            },
            Expr::Block(b) => self.block(&cx, &out, b),
            Expr::If(n) => {
                self.line(&cx, &out, "if", id, at);
                self.expr(&cx, &out, n.cond.get(&cx));
                self.block(&cx, &out, n.then);
                let unit = match n.other {
                    Option::Some(o) => self.expr(&cx, &out, o.get(&cx)),
                    Option::None => (),
                };
            },
            Expr::Match(m) => {
                self.line(&cx, &out, "match", id, at);
                self.expr(&cx, &out, m.scrutinee.get(&cx));
                var i = 0usize;
                while i < m.arms.len(&cx) {
                    let arm = m.arms.get(&cx, i);
                    var k = 0usize;
                    while k < arm.cases.len(&cx) {
                        let c = arm.cases.get(&cx, k);
                        self.line(&cx, &out, "case", c.id, Option::Some.(c.pos));
                        k = k + 1usize;
                    }
                    self.expr(&cx, &out, arm.body);
                    i = i + 1usize;
                }
            },
            Expr::Closure(c) => {
                self.line(&cx, &out, "closure", id, at);
                self.expr(&cx, &out, c.body.get(&cx));
            },
            Expr::Return(n) => {
                self.line(&cx, &out, "return", id, at);
                let unit = match n.value {
                    Option::Some(v) => self.expr(&cx, &out, v.get(&cx)),
                    Option::None => (),
                };
            },
            Expr::Pack(p) => {
                self.line(&cx, &out, "pack", id, at);
                self.expr(&cx, &out, p.value.get(&cx));
            },
            Expr::Foreach(f) => {
                self.line(&cx, &out, "foreach", id, at);
                self.expr(&cx, &out, f.source.get(&cx));
                self.block(&cx, &out, f.body);
            },
            Expr::Binop(b) => {
                self.line(&cx, &out, "binop", id, at);
                self.expr(&cx, &out, b.left.get(&cx));
                self.expr(&cx, &out, b.right.get(&cx));
            },
            Expr::Unary(u) => {
                self.line(&cx, &out, "unary", id, at);
                self.expr(&cx, &out, u.operand.get(&cx));
            },
            Expr::Cast(c) => {
                self.line(&cx, &out, "cast", id, at);
                self.expr(&cx, &out, c.value.get(&cx));
            },
            Expr::UnsafeStore(s) => {
                self.line(&cx, &out, "store", id, at);
                self.expr(&cx, &out, s.pointer.get(&cx));
                self.expr(&cx, &out, s.value.get(&cx));
            },
            Expr::Field(f) => {
                self.line(&cx, &out, "field", id, at);
                self.expr(&cx, &out, f.value.get(&cx));
            },
            Expr::Index(x) => {
                self.line(&cx, &out, "index", id, at);
                self.expr(&cx, &out, x.value.get(&cx));
            },
            Expr::Call(c) => {
                self.line(&cx, &out, "call", id, at);
                self.expr(&cx, &out, c.callee.get(&cx));
                self.exprs(&cx, &out, c.args);
            },
            Expr::Try(n) => {
                self.line(&cx, &out, "try", id, at);
                self.expr(&cx, &out, n.value.get(&cx));
            },
            Expr::While(w) => {
                self.line(&cx, &out, "while", id, at);
                self.expr(&cx, &out, w.cond.get(&cx));
                self.block(&cx, &out, w.body);
            },
            Expr::For(f) => {
                self.line(&cx, &out, "for", id, at);
                self.expr(&cx, &out, f.iterator.get(&cx));
                self.block(&cx, &out, f.body);
            },
        }
    }

    fn statement(self, &cx: Cx!['k], &out: Buffer!, s: Statement['k]) {
        match s {
            Statement::Let(l) => {
                self.line(&cx, &out, "let", l.id, Option::Some.(l.pos));
                self.pattern(&cx, &out, l.pattern);
                self.expr(&cx, &out, l.value);
            },
            Statement::Var(v) => {
                self.line(&cx, &out, "var", v.id, Option::Some.(v.pos));
                self.expr(&cx, &out, v.value);
            },
            Statement::Assign(a) => {
                out = out.push_static("  assign ").push_bytes(&cx, pos_text(&cx, a.pos)).push_static("\n");
                self.expr(&cx, &out, a.target);
                self.expr(&cx, &out, a.value);
            },
            Statement::Expr(n) => self.expr(&cx, &out, n.value),
            Statement::Const(c) => {
                self.line(&cx, &out, "const", c.id, Option::Some.(c.pos));
                self.expr(&cx, &out, c.value);
            },
        }
    }

    fn pattern(self, &cx: Cx!['k], &out: Buffer!, p: Pattern['k]) {
        let id = S::pattern_id(p);
        match p {
            Pattern::Bind(_n) => self.line(&cx, &out, "pbind", id, Option::None),
            Pattern::Wild(_id) => self.line(&cx, &out, "pwild", id, Option::None),
            Pattern::Tuple(n) => {
                self.line(&cx, &out, "ptuple", id, Option::None);
                self.patterns(&cx, &out, n.value);
            },
            Pattern::Array(n) => {
                self.line(&cx, &out, "parray", id, Option::None);
                self.patterns(&cx, &out, n.value);
            },
            Pattern::Struct(ps) => {
                self.line(&cx, &out, "pstruct", id, Option::None);
                var i = 0usize;
                while i < ps.fields.len(&cx) {
                    self.pattern(&cx, &out, ps.fields.get(&cx, i).pattern);
                    i = i + 1usize;
                }
            },
        }
    }

    fn patterns(self, &cx: Cx!['k], &out: Buffer!, ps: Seq[Pattern['k], 'k]) {
        var i = 0usize;
        while i < ps.len(&cx) {
            self.pattern(&cx, &out, ps.get(&cx, i));
            i = i + 1usize;
        }
    }

    fn function(self, &cx: Cx!['k], &out: Buffer!, name: Text['k], node: S::Fn['k]) {
        out = out.push_static("fn ").push_bytes(&cx, write_atom(&cx, name)).push_static(" ").push_bytes(&cx, pos_text(&cx, node.pos)).push_static(" params ")
            .push_bytes(&cx, ids_text(&cx, self.inf.out.param_ids.get_or(&cx, node.id, Seq::new(&cx)))).push_static("\n");
        let unit = match node.body {
            Option::Some(b) => self.block(&cx, &out, b),
            Option::None => (),
        };
    }
}

forall 'k.
fn program(&cx: Cx!['k], inf: Infer['k]) -> Text['k] {
    let w = Walk.{ inf };
    var out = Buffer::new();
    let sigs = inf.sigs.sigs.values(&cx);
    var i = 0usize;
    while i < sigs.len(&cx) {
        let sig = sigs.get(&cx, i);
        let unit = match sig.decl {
            Option::Some(decl) => match decl.node {
                Named::Fn(node) => if node.body.is_some() {
                    w.function(&cx, &out, sig.name, node);
                },
                _ => (),
            },
            Option::None => (),
        };
        i = i + 1usize;
    }
    i = 0usize;
    while i < inf.sigs.instances.len(&cx) {
        let (inst, item, _home) = inf.sigs.instances.get(&cx, i);
        var k = 0usize;
        while k < inst.methods.len(&cx) {
            w.function(&cx, &out, text_of(&cx, Buffer::new().push_bytes(&cx, inst.trait_name).push_static("::").push_bytes(&cx, item.methods.get(&cx, k).name)), item.methods.get(&cx, k));
            k = k + 1usize;
        }
        i = i + 1usize;
    }
    text_of(&cx, out)
}
