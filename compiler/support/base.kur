// What every phase of the compiler shares beyond the standard library: stopping with a message,
// and hashing keys of its own types.
//
// The compiler keeps its data in the standard library's arena structures, under one
// `std::alloc::arena::Domain!['k]` per group of phases: text is `std::raw::Span['k]`, sequences
// are `std::collections::arena_vec::ArenaVec`, maps and sets `std::collections::arena_map::ArenaMap`
// and `ArenaSet` (in insertion order), single mutable values `std::mem::Ref`, and scopes that are
// extended and then dropped `std::collections::list::List`. Every operation takes the domain by
// place, `&cx`.

use std::alloc::arena::Domain;
use std::hash::{HashIn, HashState};
use std::io::{print, write_span};
use std::process::exit;
use std::raw::Span;
use std::slice::Slice;

// Prints `message` and stops the compiler with status 1.
forall 'k.
fn fail(&cx: Domain!['k], message: Span['k]) -> ! {
    let written = write_span(2, &cx, message);
    print(2, "\n");
    exit(1)
}

fn fail_static(message: Slice[u8, 'static]) -> ! {
    print(2, message);
    print(2, "\n");
    exit(1)
}

fn stop(status: i32) -> ! {
    exit(status)
}

// Keys of the compiler's maps are hashed and compared by value through `HashIn[K, Domain!['k]]`:
// the standard library has the instances for integers, `bool`, tuples, spans and vecs of keys, and
// `kurs::core` adds `Type`, `Param`, `Premise` and `ModuleId`.

forall K, 'k where HashIn[K, Domain!['k]].
fn key_hash(&cx: Domain!['k], key: K) -> u64 {
    mix(HashIn[K, Domain!['k]]::hash_in(&cx, key, HashState::new()).finish())
}

forall K, 'k where HashIn[K, Domain!['k]].
fn key_same(&cx: Domain!['k], a: K, b: K) -> bool {
    HashIn[K, Domain!['k]]::eq_in(&cx, a, b)
}

fn mix(x: u64) -> u64 {
    let x = (x ^ (x >> 33u64)) * 18397679294719823053u64;
    let x = (x ^ (x >> 33u64)) * 14181476777654086739u64;
    x ^ (x >> 33u64)
}

fn combine(h: u64, x: u64) -> u64 {
    mix(h * 31u64 + x)
}
