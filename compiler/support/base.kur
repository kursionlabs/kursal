// What every phase of the compiler shares beyond the standard library: stopping with a message, and
// writing its output.
//
// The compiler keeps its data in the standard library's arena structures, under one
// `std::alloc::arena::Domain!['k]` per group of phases: text is `std::raw::Span['k]`, sequences
// are `std::collections::arena_vec::ArenaVec`, maps and sets `std::collections::arena_map::ArenaMap`
// and `ArenaSet` (in insertion order), single mutable values `std::mem::Ref`, and scopes that are
// extended and then dropped `std::collections::list::List`. Every operation takes the domain by
// place, `&cx`.

use std::alloc::arena::Domain!;
use std::bytes::buffer::Buffer!;
use std::io::{print_buffer, print_span, eprint, eprint_span};
use std::option::Result;
use std::process::exit;
use std::raw::Span;
use std::slice::Slice;
use std::option::Option;
use std::fs::read_to_arena;
use std::env::variable;
use std::parse::parse_usize;

// Add one source line under a file:line:column error. The first line stays intact for tools
// that navigate by location. Reading the source is best effort: missing files keep the message.
forall 'k.
fn one_source(&cx: Domain!['k], message: Span['k]) -> Span['k] {
    let file_end = match message.find_byte(&cx, b':', 0usize) {
        Option::Some(n) => n,
        Option::None => return message,
    };
    let line_end = match message.find_byte(&cx, b':', file_end + 1usize) {
        Option::Some(n) => n,
        Option::None => return message,
    };
    let col_end = match message.find_byte(&cx, b':', line_end + 1usize) {
        Option::Some(n) => n,
        Option::None => return message,
    };
    let line = match parse_usize(&cx, message.slice(file_end + 1usize, line_end)) {
        Option::Some(n) => n,
        Option::None => return message,
    };
    let col = match parse_usize(&cx, message.slice(line_end + 1usize, col_end)) {
        Option::Some(n) => n,
        Option::None => return message,
    };
    if line == 0usize || col == 0usize { return message; }
    let source = match read_to_arena(&cx, message.slice(0usize, file_end)) {
        Result::Ok(s) => s,
        Result::Err(e) => return message,
    };
    var start = 0usize;
    var current = 1usize;
    while current < line && start < source.len() {
        let end = match source.find_byte(&cx, b'\n', start) {
            Option::Some(n) => n,
            Option::None => return message,
        };
        start = end + 1usize;
        current = current + 1usize;
    }
    if current != line { return message; }
    let end = match source.find_byte(&cx, b'\n', start) {
        Option::Some(n) => n,
        Option::None => source.len(),
    };
    let line_text = source.slice(start, end);
    var marker = Buffer!::new().push_static("\n  ").push_usize(line).push_static(" | ").push_bytes(&cx, line_text)
        .push_static("\n  ");
    var digits = line;
    while digits > 0usize {
        marker = marker.push_static(" ");
        digits = digits / 10usize;
    }
    marker = marker.push_static(" | ");
    var i = start;
    var column = 1usize;
    while i < end && column < col {
        let b = source.byte_or_zero(&cx, i);
        if (b & 192u8) != 128u8 {
            marker = marker.push_byte(if b == b'\t' { b'\t' } else { b' ' });
            column = column + 1usize;
        }
        i = i + 1usize;
    }
    marker = marker.push_static("^");
    Buffer!::new().push_bytes(&cx, message).push_buffer(marker).save(&cx)
}

forall 'k.
fn with_source(&cx: Domain!['k], message: Span['k]) -> Span['k] {
    match variable(&cx, Span::from_static(&cx, "KURSAL_DIAGNOSTICS")) {
        Option::Some(value) => if value.save(&cx).is(&cx, "short") { return message; },
        Option::None => (),
    }
    var out = Buffer!::new();
    var start = 0usize;
    while start < message.len() {
        let end = match message.find_byte(&cx, b'\n', start) {
            Option::Some(n) => n,
            Option::None => message.len(),
        };
        out = out.push_bytes(&cx, one_source(&cx, message.slice(start, end)));
        if end < message.len() { out = out.push_static("\n"); }
        start = end + 1usize;
    }
    out.save(&cx)
}

// Prints `message` and stops the compiler with status 1.
forall 'k.
fn fail(&cx: Domain!['k], message: Span['k]) -> ! {
    let written = eprint_span(&cx, with_source(&cx, message));
    eprint("\n");
    exit(1)
}

fn fail_static(message: Slice[u8, 'static]) -> ! {
    eprint(message);
    eprint("\n");
    exit(1)
}

fn stop(status: i32) -> ! {
    exit(status)
}

// Writes `text` to standard output. The output is what the command produces, so a write that fails
// (a full disk, a closed pipe) stops the compiler with status 1 rather than look like success.
forall 'k.
fn emit(&cx: Domain!['k], text: Span['k]) {
    match print_span(&cx, text) {
        Result::Ok(nothing) => (),
        Result::Err(error) => fail_static("cannot write the output"),
    }
}

// `emit` for text in a buffer, which it frees.
fn emit_buffer(text: Buffer!) {
    match print_buffer(text) {
        Result::Ok(nothing) => (),
        Result::Err(error) => fail_static("cannot write the output"),
    }
}
