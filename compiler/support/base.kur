// The compiler's storage: text, growable sequences, hash maps, sets and cells, all kept in one
// arena of the standard library.
//
// A `Cx!['k]` holds the arena and the one capability for its domain, `'k`. Everything here is a
// `Copy` view branded `'k`: a `Text['k]` is a span of bytes in the arena (or of a literal), and a
// `Seq`, `Map`, `Set` or `Cell` names a header in the arena, so a change made through one copy is
// seen through all of them, as with Python's lists and dicts. Every operation that reads or
// writes takes the context by place, `&cx`, and presents its capability; one that may allocate
// also hands the arena to the standard library. Elements are `Copy` values, read and written
// whole; nothing hands out a reference into storage, and nothing is freed until the arena is.

use std::alloc::arena::{Arena, copy_span};
use std::cap::Exclusive;
use std::cmp::Order;
use std::collections::arena_vec::ArenaVec;
use std::hash::{HashIn, HashState};
use std::io::{print, write_span};
use std::mem::Ref;
use std::option::Option;
use std::process::exit;
use std::raw::{Span, span_byte_or_zero, span_bytes_eq, span_bytes_eq_lit, span_bytes_hash};
use std::slice::{Slice, bytes_cmp_within, find_bytes};

// ---------------------------------------------------------------- context --

// The arena that holds a phase's data, and the capability every read and write of it presents.
forall 'k.
exposed struct Cx! {
    tag: Exclusive!['k],
    arena: Arena!['k],
}

impl Cx {
    // A fresh, empty arena under a brand of its own.
    fn new() -> exists 'k. Cx!['k] {
        let exists 'k. (tag, arena) = Arena::new();
        pack 'k. Cx.{ tag, arena }
    }
}

forall 'k.
impl Cx['k] {
    // Frees everything in the arena; no view of it can be read after.
    fn destroy(self) {
        let { tag, arena } = self;
        arena.destroy(tag);
    }
}

// One value in the arena: the way a recursive type refers to itself, and a mutable attribute.
// `set` replaces it for every copy of the cell.
forall T, 'k.
exposed struct Cell {
    at: Ref[T, 'k],
}

forall T, 'k where Copy[T].
impl Cell[T, 'k] {
    fn new(&cx: Cx!['k], value: T) -> Cell[T, 'k] {
        Cell.{ at: &cx.arena.alloc(&cx.tag, value) }
    }

    fn get(self, &cx: Cx!['k]) -> T {
        self.at.copy(&cx.tag)
    }

    fn set(self, &cx: Cx!['k], value: T) {
        let old = self.at.replace(&cx.tag, value);
    }

    // The cell's identity: equal for copies of one cell, different for different cells.
    fn address(self) -> usize {
        self.at.address()
    }
}

// --------------------------------------------------------------- failure --

// Prints `message` and stops the compiler with status 1.
forall 'k.
fn fail(&cx: Cx!['k], message: Text['k]) -> ! {
    message.print(&cx, 2);
    print(2, "\n");
    exit(1)
}

fn fail_static(message: Slice[u8, 'static]) -> ! {
    print(2, message);
    print(2, "\n");
    exit(1)
}

fn stop(status: i32) -> ! {
    exit(status)
}

// ------------------------------------------------------------------- text --

// Bytes that never change: a view of a literal, of a file, or of text the compiler built.
forall 'k.
exposed struct Text {
    bytes: Span['k],
}

forall 'k.
fn text(&cx: Cx!['k], literal: Slice[u8, 'static]) -> Text['k] {
    Text.{ bytes: Span::from_static(&cx.tag, literal) }
}

// `t`, copied from the arena of `from` into that of `to`.
forall 'a, 'b.
fn copy_text(&from: Cx!['a], &to: Cx!['b], t: Text['a]) -> Text['b] {
    Text.{ bytes: copy_span(&to.arena, &from.tag, t.bytes) }
}

forall 'k.
fn empty_text(&cx: Cx!['k]) -> Text['k] {
    text(&cx, "")
}

forall 'k.
impl Text['k] {
    fn len(self) -> usize {
        self.bytes.len()
    }

    fn is_empty(self) -> bool {
        self.bytes.len() == 0usize
    }

    // Byte `i`, or zero past the end.
    fn byte(self, &cx: Cx!['k], i: usize) -> u8 {
        span_byte_or_zero(&cx.tag, self.bytes, i)
    }

    // Bytes `start` to `end`, clamped to the text.
    fn slice(self, start: usize, end: usize) -> Text['k] {
        let end = if end > self.len() { self.len() } else { end };
        let start = if start > end { end } else { start };
        Text.{ bytes: self.bytes.skip(start).take(end - start) }
    }

    fn from(self, start: usize) -> Text['k] {
        self.slice(start, self.len())
    }

    fn eq(self, &cx: Cx!['k], other: Text['k]) -> bool {
        span_bytes_eq(&cx.tag, self.bytes, other.bytes)
    }

    fn is(self, &cx: Cx!['k], literal: Slice[u8, 'static]) -> bool {
        span_bytes_eq_lit(&cx.tag, self.bytes, literal)
    }

    // Byte order, as Python orders `str`s of ASCII: negative, zero or positive.
    fn compare(self, &cx: Cx!['k], other: Text['k]) -> i32 {
        match bytes_cmp_within(&cx.tag, self.bytes, other.bytes) {
            Order::Less => -1,
            Order::Equal => 0,
            Order::Greater => 1,
        }
    }

    fn starts_with(self, &cx: Cx!['k], prefix: Text['k]) -> bool {
        prefix.len() <= self.len() && self.slice(0usize, prefix.len()).eq(&cx, prefix)
    }

    fn ends_with(self, &cx: Cx!['k], suffix: Text['k]) -> bool {
        suffix.len() <= self.len() && self.from(self.len() - suffix.len()).eq(&cx, suffix)
    }

    // The first index at or after `start` of `needle`, if any.
    fn find(self, &cx: Cx!['k], needle: Text['k], start: usize) -> Option[usize] {
        find_bytes(&cx.tag, self.bytes, start, needle.bytes)
    }

    fn contains(self, &cx: Cx!['k], needle: Text['k]) -> bool {
        self.find(&cx, needle, 0usize).is_some()
    }

    // The last index of `byte`, if any.
    fn rfind_byte(self, &cx: Cx!['k], byte: u8) -> Option[usize] {
        var i = self.len();
        var found = Option::None;
        while found.is_none() && i > 0usize {
            i = i - 1usize;
            if self.byte(&cx, i) == byte {
                found = Option::Some.(i);
            }
        }
        found
    }

    fn hash(self, &cx: Cx!['k]) -> u64 {
        span_bytes_hash(&cx.tag, self.bytes)
    }

    fn concat(self, &cx: Cx!['k], other: Text['k]) -> Text['k] {
        Out::new(&cx).add(&cx, self).add(&cx, other).done(&cx)
    }

    // The pieces between occurrences of `separator`.
    fn split(self, &cx: Cx!['k], separator: Text['k]) -> Seq[Text['k], 'k] {
        let pieces: Seq[Text['k], 'k] = Seq::new(&cx);
        var start = 0usize;
        var going = true;
        while going {
            let unit = match self.find(&cx, separator, start) {
                Option::Some(at) => {
                    pieces.push(&cx, self.slice(start, at));
                    start = at + separator.len();
                },
                Option::None => {
                    pieces.push(&cx, self.from(start));
                    going = false;
                },
            };
        }
        pieces
    }

    // The decimal value of the text's digits, if it is all digits.
    fn to_usize(self, &cx: Cx!['k]) -> Option[usize] {
        var n = 0usize;
        var ok = self.len() > 0usize;
        var i = 0usize;
        while ok && i < self.len() {
            let b = self.byte(&cx, i);
            if b >= b'0' && b <= b'9' {
                n = n * 10usize + ((b - b'0') as usize);
            } else {
                ok = false;
            }
            i = i + 1usize;
        }
        if ok { Option::Some.(n) } else { Option::None }
    }

    fn print(self, &cx: Cx!['k], fd: i32) {
        let written = write_span(fd, &cx.tag, self.bytes);
    }
}

// Text being built. `done` returns what was written; the builder may go on growing after it.
forall 'k.
exposed struct Out {
    bytes: ArenaVec[u8, 'k],
}

forall 'k.
impl Out['k] {
    fn new(&cx: Cx!['k]) -> Out['k] {
        Out.{ bytes: ArenaVec::new(&cx.tag, &cx.arena) }
    }

    fn byte(self, &cx: Cx!['k], b: u8) -> Out['k] {
        self.bytes.push(&cx.tag, &cx.arena, b);
        self
    }

    fn add(self, &cx: Cx!['k], t: Text['k]) -> Out['k] {
        self.bytes.push_span(&cx.tag, &cx.arena, t.bytes);
        self
    }

    fn put(self, &cx: Cx!['k], literal: Slice[u8, 'static]) -> Out['k] {
        self.bytes.push_static(&cx.tag, &cx.arena, literal);
        self
    }

    fn u64(self, &cx: Cx!['k], n: u64) -> Out['k] {
        if n >= 10u64 {
            let unit = self.u64(&cx, n / 10u64);
        }
        self.byte(&cx, b'0' + ((n % 10u64) as u8))
    }

    fn usize(self, &cx: Cx!['k], n: usize) -> Out['k] {
        self.u64(&cx, n as u64)
    }

    fn i64(self, &cx: Cx!['k], n: i64) -> Out['k] {
        if n < 0i64 {
            // The magnitude of the most negative value is one past the largest positive one.
            self.byte(&cx, b'-').u64(&cx, ((0i64 - (n + 1i64)) as u64) + 1u64)
        } else {
            self.u64(&cx, n as u64)
        }
    }

    fn len(self, &cx: Cx!['k]) -> usize {
        self.bytes.len(&cx.tag)
    }

    fn done(self, &cx: Cx!['k]) -> Text['k] {
        Text.{ bytes: self.bytes.span(&cx.tag, &cx.arena) }
    }
}

// --------------------------------------------------------------- sequences --

forall T, 'k.
exposed struct Seq {
    items: ArenaVec[T, 'k],
}

forall T, 'k where Copy[T].
impl Seq[T, 'k] {
    fn new(&cx: Cx!['k]) -> Seq[T, 'k] {
        Seq.{ items: ArenaVec::new(&cx.tag, &cx.arena) }
    }

    fn one(&cx: Cx!['k], value: T) -> Seq[T, 'k] {
        let s: Seq[T, 'k] = Seq::new(&cx);
        s.push(&cx, value);
        s
    }

    fn two(&cx: Cx!['k], a: T, b: T) -> Seq[T, 'k] {
        let s: Seq[T, 'k] = Seq::new(&cx);
        s.push(&cx, a);
        s.push(&cx, b);
        s
    }

    fn len(self, &cx: Cx!['k]) -> usize {
        self.items.len(&cx.tag)
    }

    fn is_empty(self, &cx: Cx!['k]) -> bool {
        self.items.is_empty(&cx.tag)
    }

    // The sequence's identity: equal for copies of one sequence, different for different ones.
    fn address(self) -> usize {
        self.items.address()
    }

    fn push(self, &cx: Cx!['k], value: T) {
        self.items.push(&cx.tag, &cx.arena, value);
    }

    fn get(self, &cx: Cx!['k], i: usize) -> T {
        match self.items.get_ref(&cx.tag, i) {
            Option::Some(at) => at.copy(&cx.tag),
            Option::None => fail_static("internal error: sequence index out of range"),
        }
    }

    fn set(self, &cx: Cx!['k], i: usize, value: T) {
        match self.items.set(&cx.tag, i, value) {
            Option::Some(old) => (),
            Option::None => fail_static("internal error: sequence index out of range"),
        }
    }

    fn last(self, &cx: Cx!['k]) -> T {
        match self.items.last(&cx.tag) {
            Option::Some(value) => value,
            Option::None => fail_static("internal error: sequence index out of range"),
        }
    }

    fn pop(self, &cx: Cx!['k]) -> T {
        match self.items.pop(&cx.tag) {
            Option::Some(value) => value,
            Option::None => fail_static("internal error: pop from an empty sequence"),
        }
    }

    // Keeps the first `len` values.
    fn truncate(self, &cx: Cx!['k], len: usize) {
        self.items.truncate(&cx.tag, len);
    }

    fn clear(self, &cx: Cx!['k]) {
        self.items.clear(&cx.tag);
    }

    fn append(self, &cx: Cx!['k], other: Seq[T, 'k]) {
        self.items.append(&cx.tag, &cx.arena, other.items);
    }

    // A new sequence holding the same values.
    fn copy(self, &cx: Cx!['k]) -> Seq[T, 'k] {
        Seq.{ items: self.items.clone(&cx.tag, &cx.arena) }
    }

    // Values `start` to `end`, as a new sequence.
    fn slice(self, &cx: Cx!['k], start: usize, end: usize) -> Seq[T, 'k] {
        let s: Seq[T, 'k] = Seq::new(&cx);
        let n = self.len(&cx);
        var i = start;
        while i < end && i < n {
            s.push(&cx, self.get(&cx, i));
            i = i + 1usize;
        }
        s
    }

    fn from(self, &cx: Cx!['k], start: usize) -> Seq[T, 'k] {
        self.slice(&cx, start, self.len(&cx))
    }

    fn insert(self, &cx: Cx!['k], at: usize, value: T) {
        self.push(&cx, value);
        var i = self.len(&cx) - 1usize;
        while i > at {
            self.set(&cx, i, self.get(&cx, i - 1usize));
            i = i - 1usize;
        }
        self.set(&cx, at, value);
    }

    fn remove(self, &cx: Cx!['k], at: usize) -> T {
        let value = self.get(&cx, at);
        var i = at;
        while i + 1usize < self.len(&cx) {
            self.set(&cx, i, self.get(&cx, i + 1usize));
            i = i + 1usize;
        }
        let unit = self.pop(&cx);
        value
    }

    fn reverse(self, &cx: Cx!['k]) {
        var i = 0usize;
        var j = self.len(&cx);
        while i + 1usize < j {
            j = j - 1usize;
            let a = self.get(&cx, i);
            self.set(&cx, i, self.get(&cx, j));
            self.set(&cx, j, a);
            i = i + 1usize;
        }
    }

    // Sorts in place by `before`, keeping equal values in their order (insertion sort).
    fn sort(self, &cx: Cx!['k], before: fn(&_: Cx!['k], T, T) -> bool) {
        var i = 1usize;
        while i < self.len(&cx) {
            let value = self.get(&cx, i);
            var j = i;
            while j > 0usize && before(&cx, value, self.get(&cx, j - 1usize)) {
                self.set(&cx, j, self.get(&cx, j - 1usize));
                j = j - 1usize;
            }
            self.set(&cx, j, value);
            i = i + 1usize;
        }
    }
}

forall T, 'k where Copy[T], HashIn[T, Cx!['k]].
impl Seq[T, 'k] {
    fn index_of(self, &cx: Cx!['k], value: T) -> Option[usize] {
        var i = 0usize;
        var found = Option::None;
        while found.is_none() && i < self.len(&cx) {
            if key_same(&cx, self.get(&cx, i), value) {
                found = Option::Some.(i);
            }
            i = i + 1usize;
        }
        found
    }

    fn has(self, &cx: Cx!['k], value: T) -> bool {
        self.index_of(&cx, value).is_some()
    }

    fn same(self, &cx: Cx!['k], other: Seq[T, 'k]) -> bool {
        var equal = self.len(&cx) == other.len(&cx);
        var i = 0usize;
        while equal && i < self.len(&cx) {
            equal = key_same(&cx, self.get(&cx, i), other.get(&cx, i));
            i = i + 1usize;
        }
        equal
    }
}

// ------------------------------------------------------------- hash maps --

// Keys of maps are hashed and compared by value through `HashIn[K, Cx!['k]]`: the standard
// library has the instances for integers, `bool` and tuples of keys, this module those for `Text`
// and `Seq`s of keys, and `kurs::core` adds `Type`, `Param`, `Premise` and `ModuleId`.

forall K, 'k where HashIn[K, Cx!['k]].
fn key_hash(&cx: Cx!['k], key: K) -> u64 {
    mix(HashIn[K, Cx!['k]]::hash_in(&cx, key, HashState::new()).finish())
}

forall K, 'k where HashIn[K, Cx!['k]].
fn key_same(&cx: Cx!['k], a: K, b: K) -> bool {
    HashIn[K, Cx!['k]]::eq_in(&cx, a, b)
}

forall 'k.
instance HashIn[Text['k], Cx!['k]] {
    fn hash_in(&cx: Cx!['k], key: Text['k], state: HashState) -> HashState {
        let h = key.hash(&cx);
        state.write_u64(h)
    }

    fn eq_in(&cx: Cx!['k], a: Text['k], b: Text['k]) -> bool {
        let equal = a.eq(&cx, b);
        equal
    }
}

forall T, 'k where Copy[T], HashIn[T, Cx!['k]].
instance HashIn[Seq[T, 'k], Cx!['k]] {
    fn hash_in(&cx: Cx!['k], key: Seq[T, 'k], state: HashState) -> HashState {
        var h = 7u64;
        var i = 0usize;
        while i < key.len(&cx) {
            h = combine(h, key_hash(&cx, key.get(&cx, i)));
            i = i + 1usize;
        }
        state.write_u64(h)
    }

    fn eq_in(&cx: Cx!['k], a: Seq[T, 'k], b: Seq[T, 'k]) -> bool {
        let equal = a.same(&cx, b);
        equal
    }
}

fn mix(x: u64) -> u64 {
    let x = (x ^ (x >> 33u64)) * 18397679294719823053u64;
    let x = (x ^ (x >> 33u64)) * 14181476777654086739u64;
    x ^ (x >> 33u64)
}

fn combine(h: u64, x: u64) -> u64 {
    mix(h * 31u64 + x)
}

// A hash map that remembers the order its keys were first inserted, as Python's dict does:
// `keys` lists them in that order, and removing a key keeps the order of the rest.
forall K, V, 'k.
exposed struct Map {
    state: Ref[MapState[K, V, 'k], 'k],
}

forall K, V, 'k.
exposed struct MapState {
    // Indices into `entries`, plus one; zero for an empty slot. A power of two long; none until
    // the first key.
    slots: Option[Slice[usize, 'k]],
    // Every key ever inserted, in insertion order; a removed one stays, marked dead.
    entries: ArenaVec[Entry[K, V], 'k],
    count: usize,
}

forall K, V.
exposed struct Entry {
    key: K,
    value: V,
    live: bool,
}

forall K, V, 'k where Copy[K], Copy[V], HashIn[K, Cx!['k]].
impl Map[K, V, 'k] {
    fn new(&cx: Cx!['k]) -> Map[K, V, 'k] {
        let state = MapState.{ slots: Option::None, entries: ArenaVec::new(&cx.tag, &cx.arena), count: 0usize };
        Map.{ state: &cx.arena.alloc(&cx.tag, state) }
    }

    fn len(self, &cx: Cx!['k]) -> usize {
        self.state.copy(&cx.tag).count
    }

    fn is_empty(self, &cx: Cx!['k]) -> bool {
        self.len(&cx) == 0usize
    }

    // The map's identity: equal for copies of one map, different for different maps.
    fn address(self) -> usize {
        self.state.address()
    }

    // The slot holding `key`, or the empty slot where it would go, and what that slot holds.
    fn slot(self, &cx: Cx!['k], slots: Slice[usize, 'k], entries: ArenaVec[Entry[K, V], 'k], key: K) -> (usize, usize) {
        let mask = slots.len() - 1usize;
        var i = (key_hash(&cx, key) as usize) & mask;
        var entry = slot_at(&cx, slots, i);
        while entry != 0usize && !key_same(&cx, item(&cx, entries, entry - 1usize).key, key) {
            i = (i + 1usize) & mask;
            entry = slot_at(&cx, slots, i);
        }
        (i, entry)
    }

    // The position of a live key.
    fn index(self, &cx: Cx!['k], key: K) -> Option[usize] {
        let h = self.state.copy(&cx.tag);
        let slots = match h.slots {
            Option::Some(s) => s,
            Option::None => return Option::None,
        };
        let (slot, entry) = self.slot(&cx, slots, h.entries, key);
        if entry == 0usize || !item(&cx, h.entries, entry - 1usize).live {
            Option::None
        } else {
            Option::Some.(entry - 1usize)
        }
    }

    fn has(self, &cx: Cx!['k], key: K) -> bool {
        self.index(&cx, key).is_some()
    }

    fn get(self, &cx: Cx!['k], key: K) -> Option[V] {
        match self.index(&cx, key) {
            Option::Some(i) => Option::Some.(item(&cx, self.state.copy(&cx.tag).entries, i).value),
            Option::None => Option::None,
        }
    }

    // The value of a key that must be present.
    fn at(self, &cx: Cx!['k], key: K) -> V {
        match self.get(&cx, key) {
            Option::Some(v) => v,
            Option::None => fail_static("internal error: missing map key"),
        }
    }

    fn get_or(self, &cx: Cx!['k], key: K, default: V) -> V {
        match self.get(&cx, key) {
            Option::Some(v) => v,
            Option::None => default,
        }
    }

    fn set(self, &cx: Cx!['k], key: K, value: V) {
        let h = self.state.copy(&cx.tag);
        let slots = match h.slots {
            Option::Some(s) => s,
            Option::None => {
                let fresh = &cx.arena.alloc_slice(&cx.tag, 8usize, 0usize);
                let previous = self.state.replace(&cx.tag, MapState.{ slots: Option::Some.(fresh), entries: h.entries, count: h.count });
                fresh
            },
        };
        let (slot, entry) = self.slot(&cx, slots, h.entries, key);
        if entry != 0usize && item(&cx, h.entries, entry - 1usize).live {
            let old = h.entries.set(&cx.tag, entry - 1usize, Entry.{ key, value, live: true });
            return;
        }
        // A new key, or a removed one coming back at the end of the order.
        set_slot(&cx, slots, slot, h.entries.len(&cx.tag) + 1usize);
        h.entries.push(&cx.tag, &cx.arena, Entry.{ key, value, live: true });
        let previous = self.state.replace(&cx.tag, MapState.{ slots: Option::Some.(slots), entries: h.entries, count: h.count + 1usize });
        if entry == 0usize && h.entries.len(&cx.tag) * 2usize > slots.len() {
            self.grow(&cx, slots.len() * 2usize);
        }
    }

    fn remove(self, &cx: Cx!['k], key: K) {
        match self.index(&cx, key) {
            Option::Some(i) => {
                let h = self.state.copy(&cx.tag);
                let e = item(&cx, h.entries, i);
                let old = h.entries.set(&cx.tag, i, Entry.{ key: e.key, value: e.value, live: false });
                let previous = self.state.replace(&cx.tag, MapState.{ slots: h.slots, entries: h.entries, count: h.count - 1usize });
            },
            Option::None => (),
        }
    }

    // `slot_count` slots, every key placed again.
    fn grow(self, &cx: Cx!['k], slot_count: usize) {
        let h = self.state.copy(&cx.tag);
        let slots = &cx.arena.alloc_slice(&cx.tag, slot_count, 0usize);
        let previous = self.state.replace(&cx.tag, MapState.{ slots: Option::Some.(slots), entries: h.entries, count: h.count });
        var k = 0usize;
        while k < h.entries.len(&cx.tag) {
            let (slot, entry) = self.slot(&cx, slots, h.entries, item(&cx, h.entries, k).key);
            set_slot(&cx, slots, slot, k + 1usize);
            k = k + 1usize;
        }
    }

    // The number of positions `entry` reads: one per key ever inserted, in insertion order. Reading
    // positions `0..positions()` visits the keys as `keys` lists them, without copying them;
    // removing a key meanwhile only empties its position.
    fn positions(self, &cx: Cx!['k]) -> usize {
        self.state.copy(&cx.tag).entries.len(&cx.tag)
    }

    // The key at a position, unless it was removed.
    fn entry(self, &cx: Cx!['k], i: usize) -> Option[K] {
        let e = item(&cx, self.state.copy(&cx.tag).entries, i);
        if e.live { Option::Some.(e.key) } else { Option::None }
    }

    // The keys, in insertion order.
    fn keys(self, &cx: Cx!['k]) -> Seq[K, 'k] {
        let entries = self.state.copy(&cx.tag).entries;
        let out: Seq[K, 'k] = Seq::new(&cx);
        var i = 0usize;
        while i < entries.len(&cx.tag) {
            let e = item(&cx, entries, i);
            if e.live {
                out.push(&cx, e.key);
            }
            i = i + 1usize;
        }
        out
    }

    // The values, in their keys' insertion order.
    fn values(self, &cx: Cx!['k]) -> Seq[V, 'k] {
        let entries = self.state.copy(&cx.tag).entries;
        let out: Seq[V, 'k] = Seq::new(&cx);
        var i = 0usize;
        while i < entries.len(&cx.tag) {
            let e = item(&cx, entries, i);
            if e.live {
                out.push(&cx, e.value);
            }
            i = i + 1usize;
        }
        out
    }

    // The same entries in a map of their own, with only the live keys.
    fn copy(self, &cx: Cx!['k]) -> Map[K, V, 'k] {
        let h = self.state.copy(&cx.tag);
        let m: Map[K, V, 'k] = Map::new(&cx);
        if h.count == 0usize {
            return m;
        }
        var slot_count = 8usize;
        while h.count * 2usize > slot_count {
            slot_count = slot_count * 2usize;
        }
        m.grow(&cx, slot_count);
        var i = 0usize;
        while i < h.entries.len(&cx.tag) {
            let e = item(&cx, h.entries, i);
            if e.live {
                m.set(&cx, e.key, e.value);
            }
            i = i + 1usize;
        }
        m
    }
}

// Element `i` of an arena vec, which must be in range.
forall T, 'k where Copy[T].
fn item(&cx: Cx!['k], items: ArenaVec[T, 'k], i: usize) -> T {
    match items.get_ref(&cx.tag, i) {
        Option::Some(at) => at.copy(&cx.tag),
        Option::None => fail_static("internal error: sequence index out of range"),
    }
}

forall 'k.
fn slot_at(&cx: Cx!['k], slots: Slice[usize, 'k], i: usize) -> usize {
    match slots.get_ref(&cx.tag, i) {
        Option::Some(at) => at.copy(&cx.tag),
        Option::None => fail_static("internal error: map slot out of range"),
    }
}

forall 'k.
fn set_slot(&cx: Cx!['k], slots: Slice[usize, 'k], i: usize, value: usize) {
    match slots.get_ref(&cx.tag, i) {
        Option::Some(at) => {
            let old = at.replace(&cx.tag, value);
        },
        Option::None => fail_static("internal error: map slot out of range"),
    }
}

// A set, in insertion order.
forall K, 'k.
exposed struct Set {
    map: Map[K, bool, 'k],
}

forall K, 'k where Copy[K], HashIn[K, Cx!['k]].
impl Set[K, 'k] {
    fn new(&cx: Cx!['k]) -> Set[K, 'k] {
        Set.{ map: Map::new(&cx) }
    }

    fn add(self, &cx: Cx!['k], key: K) {
        self.map.set(&cx, key, true);
    }

    fn has(self, &cx: Cx!['k], key: K) -> bool {
        self.map.has(&cx, key)
    }

    fn remove(self, &cx: Cx!['k], key: K) {
        self.map.remove(&cx, key);
    }

    fn len(self, &cx: Cx!['k]) -> usize {
        self.map.len(&cx)
    }

    fn items(self, &cx: Cx!['k]) -> Seq[K, 'k] {
        self.map.keys(&cx)
    }

    // As for `Map`: positions `0..positions()` hold the items, or none where one was removed.
    fn positions(self, &cx: Cx!['k]) -> usize {
        self.map.positions(&cx)
    }

    fn entry(self, &cx: Cx!['k], i: usize) -> Option[K] {
        self.map.entry(&cx, i)
    }

    fn copy(self, &cx: Cx!['k]) -> Set[K, 'k] {
        Set.{ map: self.map.copy(&cx) }
    }
}
