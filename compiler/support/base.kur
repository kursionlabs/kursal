// What every phase of the compiler shares beyond the standard library: stopping with a message.
//
// The compiler keeps its data in the standard library's arena structures, under one
// `std::alloc::arena::Domain!['k]` per group of phases: text is `std::raw::Span['k]`, sequences
// are `std::collections::arena_vec::ArenaVec`, maps and sets `std::collections::arena_map::ArenaMap`
// and `ArenaSet` (in insertion order), single mutable values `std::mem::Ref`, and scopes that are
// extended and then dropped `std::collections::list::List`. Every operation takes the domain by
// place, `&cx`.

use std::alloc::arena::Domain;
use std::io::{print, write_span};
use std::process::exit;
use std::raw::Span;
use std::slice::Slice;

// Prints `message` and stops the compiler with status 1.
forall 'k.
fn fail(&cx: Domain!['k], message: Span['k]) -> ! {
    let written = write_span(2, &cx, message);
    print(2, "\n");
    exit(1)
}

fn fail_static(message: Slice[u8, 'static]) -> ! {
    print(2, message);
    print(2, "\n");
    exit(1)
}

fn stop(status: i32) -> ! {
    exit(status)
}
