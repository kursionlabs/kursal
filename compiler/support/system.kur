// The compiler's view of the operating system, on the standard library: arguments, files,
// directories, processes and the environment. Paths are read as spans of the context's arena,
// and what comes back is copied into it.

use std::collections::arena_vec::ArenaVec;
use std::raw::Span;
use std::alloc::arena::Domain;
use std::bytes::buffer::Buffer;
use std::option::{Option, Result};
use std::env::variable;
use std::fs::{canonicalize, path_exists as exists_at, read_dir, read_to_arena, write as write_file};
use std::process::{Args, Command, Exit};

// The arguments the program was started with, after its own name.
forall 'k.
fn arguments(&cx: Domain!['k], args: Args) -> ArenaVec[Span['k], 'k] {
    let out: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
    var i = 1usize;
    while i < args.len() {
        match args.bytes(i) {
            Option::Some(arg) => out.push(&cx, Span::from_static(&cx, arg)),
            Option::None => (),
        }
        i = i + 1usize;
    }
    out
}

// The contents of the file at `path`, if it can be read.
forall 'k.
fn read(&cx: Domain!['k], path: Span['k]) -> Option[Span['k]] {
    read_to_arena(&cx, path).ok()
}

// The absolute path with no symbolic links that `path` names, if it exists.
forall 'k.
fn real_path(&cx: Domain!['k], path: Span['k]) -> Option[Span['k]] {
    match canonicalize(&cx, path) {
        Result::Ok(r) => Option::Some.(r.save(&cx)),
        Result::Err(code) => Option::None,
    }
}

// Whether `path` names an existing file or directory.
forall 'k.
fn path_exists(&cx: Domain!['k], path: Span['k]) -> bool {
    exists_at(&cx, path)
}

forall 'k.
fn environment(&cx: Domain!['k], name: Span['k]) -> Option[Span['k]] {
    match variable(&cx, name) {
        Option::Some(r) => Option::Some.(r.save(&cx)),
        Option::None => Option::None,
    }
}

// The entries of a directory, other than `.` and `..`, with whether each is a directory.
forall 'k.
fn list_directory(&cx: Domain!['k], path: Span['k]) -> ArenaVec[(Span['k], bool), 'k] {
    let out: ArenaVec[(Span['k], bool), 'k] = ArenaVec::new(&cx);
    match read_dir(&cx, path) {
        Result::Ok(directory) => {
            var directory = directory;
            var going = true;
            while going {
                match &directory.next() {
                    Result::Ok(next) => match next {
                        Option::Some(entry) => {
                            let { name, is_directory } = entry;
                            out.push(&cx, (name.save(&cx), is_directory));
                        },
                        Option::None => {
                            going = false;
                        },
                    },
                    Result::Err(code) => {
                        going = false;
                    },
                }
            }
            let closed = directory.close();
        },
        Result::Err(code) => (),
    }
    out
}

// Writes `contents` to the file at `path`, replacing it, and frees it; whether that succeeded.
forall 'k.
fn write(&cx: Domain!['k], path: Span['k], contents: Buffer!) -> bool {
    write_file(&cx, path, contents).is_ok()
}

// A command for `run`: `argv[0]` run with the rest, copied out of the arena so that it outlives
// it.
forall 'k.
fn command_line(&cx: Domain!['k], argv: ArenaVec[Span['k], 'k]) -> Command! {
    var command = Command::new(&cx, argv.at(&cx, 0usize));
    var i = 1usize;
    while i < argv.len(&cx) {
        command = command.arg(&cx, argv.at(&cx, i));
        i = i + 1usize;
    }
    command
}

// Runs a command and waits for it; whether it exited with status 0.
fn run(command: Command!) -> bool {
    match command.run() {
        Result::Ok(exit) => match exit {
            Exit::Code(code) => code == 0i32,
            Exit::Signal(number) => false,
        },
        Result::Err(code) => false,
    }
}
