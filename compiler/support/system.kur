// The compiler's view of the operating system, on the standard library and its `libc` adapters:
// arguments, files, directories, processes and the environment. Paths and command lines are
// handed over as `Buffer!` copies, freed once the call returns, and what comes back is copied
// into the context's arena.

use package::support::base::{Cx, Seq, Text, text_of};
use std::bytes::buffer::Buffer;
use std::option::{Option, Result};
use libc::fs::{canonicalize, create, environment_variable, open_directory, open_read};
use libc::process::{Exit, arguments as process_arguments, run as run_command};

// The bytes of `t`.
forall 'k.
fn buffer(&cx: Cx!['k], t: Text['k]) -> Buffer! {
    Buffer::new().push_bytes(&cx, t)
}


// The arguments the program was started with, after its own name.
forall 'k.
fn arguments(&cx: Cx!['k]) -> Seq[Text['k], 'k] {
    let out: Seq[Text['k], 'k] = Seq::new(&cx);
    match process_arguments() {
        Result::Ok(line) => {
            // The program's name, then each argument, each followed by a NUL.
            let all = text_of(&cx, line);
            var start = 0usize;
            var i = 0usize;
            while i < all.len() {
                if all.byte(&cx, i) == 0u8 {
                    out.push(&cx, all.slice(start, i));
                    start = i + 1usize;
                }
                i = i + 1usize;
            }
        },
        Result::Err(code) => (),
    }
    if out.is_empty(&cx) {
        out
    } else {
        out.from(&cx, 1usize)
    }
}

// The contents of the file at `path`, if it can be read.
forall 'k.
fn read(&cx: Cx!['k], path: Text['k]) -> Option[Text['k]] {
    var name = buffer(&cx, path);
    let opened = open_read(&name);
    name.destroy();
    match opened {
        Result::Ok(file) => {
            var file = file;
            let contents = &file.read_to_buffer();
            let closed = file.close();
            match contents {
                Result::Ok(b) => Option::Some.(text_of(&cx, b)),
                Result::Err(code) => Option::None,
            }
        },
        Result::Err(code) => Option::None,
    }
}

// The absolute path with no symbolic links that `path` names, if it exists.
forall 'k.
fn real_path(&cx: Cx!['k], path: Text['k]) -> Option[Text['k]] {
    var b = buffer(&cx, path);
    let result = canonicalize(&b);
    b.destroy();
    match result {
        Result::Ok(r) => Option::Some.(text_of(&cx, r)),
        Result::Err(code) => Option::None,
    }
}

// Whether `path` names an existing file or directory.
forall 'k.
fn path_exists(&cx: Cx!['k], path: Text['k]) -> bool {
    real_path(&cx, path).is_some()
}

forall 'k.
fn environment(&cx: Cx!['k], name: Text['k]) -> Option[Text['k]] {
    var b = buffer(&cx, name);
    let result = environment_variable(&b);
    b.destroy();
    match result {
        Option::Some(r) => Option::Some.(text_of(&cx, r)),
        Option::None => Option::None,
    }
}

// The entries of a directory, other than `.` and `..`, with whether each is a directory.
forall 'k.
fn list_directory(&cx: Cx!['k], path: Text['k]) -> Seq[(Text['k], bool), 'k] {
    let out: Seq[(Text['k], bool), 'k] = Seq::new(&cx);
    var b = buffer(&cx, path);
    let opened = open_directory(&b);
    b.destroy();
    match opened {
        Result::Ok(stream) => {
            var stream = stream;
            var going = true;
            while going {
                let unit = match &stream.next_entry() {
                    Result::Ok(next) => match next {
                        Option::Some(entry) => {
                            let { name, is_directory } = entry;
                            let n = text_of(&cx, name);
                            if !n.is(&cx, ".") && !n.is(&cx, "..") {
                                out.push(&cx, (n, is_directory));
                            }
                        },
                        Option::None => {
                            going = false;
                        },
                    },
                    Result::Err(code) => {
                        going = false;
                    },
                };
            }
            let closed = stream.close();
        },
        Result::Err(code) => (),
    }
    out
}

// Writes `contents` to the file at `path`, replacing it, and frees it; whether that succeeded.
forall 'k.
fn write(&cx: Cx!['k], path: Text['k], contents: Buffer!) -> bool {
    var name = buffer(&cx, path);
    let created = create(&name);
    name.destroy();
    match created {
        Result::Ok(file) => {
            var file = file;
            let written = &file.write_buffer(contents);
            let closed = file.close();
            written.is_ok() && closed.is_ok()
        },
        Result::Err(code) => {
            contents.destroy();
            false
        },
    }
}

// A command line for `run`: each of `argv` followed by a NUL, in a buffer of its own, so that it
// outlives the arena.
forall 'k.
fn command_line(&cx: Cx!['k], argv: Seq[Text['k], 'k]) -> Buffer! {
    var line = Buffer::new();
    var i = 0usize;
    while i < argv.len(&cx) {
        line = line.push_bytes(&cx, argv.get(&cx, i)).push_byte(0u8);
        i = i + 1usize;
    }
    line
}

// Runs the program a command line names, found on the PATH, with its arguments, and waits for it;
// whether it exited with status 0. The command line is freed.
fn run(line: Buffer!) -> bool {
    var line = line;
    let result = run_command(&line);
    line.destroy();
    match result {
        Result::Ok(exit) => match exit {
            Exit::Code(code) => code == 0i32,
            Exit::Signal(number) => false,
        },
        Result::Err(code) => false,
    }
}
