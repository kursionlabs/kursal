// What the documentation site shows, and where: the modules each package exposes, its own and the
// ones it re-exports; each module's source; every type's methods, wherever they are defined; every
// instance and what its head mentions; and the URL of each documented declaration.
use package::doc::text::{Link, encode, lit, relative};
use package::resolve::resolver::{Decl, ModuleId, NameRef, Resolver, Target, is_prim};
use package::syntax::ast as S;
use std::arena::Domain!;
use std::buffer::Buffer!;
use std::fmt::Writer;
use std::cmp::Order;
use std::collections::arena_map::ArenaMap;
use std::collections::arena_vec::ArenaVec;
use std::fs::read_to_arena;
use std::option::{Option, Result};
use std::str::Str;

// A module page: the module `actual` as package `package` exposes it, at `path` under the
// package's name. A module re-exported by another package has a location in each.
forall 'k.
exposed struct Loc {
    package: usize,
    path: ArenaVec[Str['k], 'k],
    actual: ModuleId['k],
    // `/std/cmp/`
    url: Str['k],
    // `std::cmp`
    title: Str['k],
}

// A module's source file: its text, the offset of each line, and its path from its package's
// directory.
forall 'k.
exposed struct Source {
    text: Str['k],
    lines: ArenaVec[usize, 'k],
    file: Str['k],
}

// A function or constant of an `impl`, and the module of the impl.
forall 'k.
exposed struct Member {
    home: ModuleId['k],
    member: S::Member['k],
}

// An instance: where it is, its head as written (`Ord[u8, u8]`), its anchor (`instance.` and its
// head, spelled without spaces, encoded), the trait it is of, and the types its head mentions.
forall 'k.
exposed struct Inst {
    home: ModuleId['k],
    decl: S::InstanceDecl['k],
    head: Str['k],
    anchor: Str['k],
    trait_decl: Option[Decl['k]],
    types: ArenaVec[u32, 'k],
    prims: ArenaVec[Str['k], 'k],
}

// A type or trait named in a declaration's source, where its path starts.
forall 'k.
exposed struct Mention {
    pos: S::Pos,
    path: ArenaVec[Str['k], 'k],
    decl: Decl['k],
}

forall 'k.
exposed struct Gen {
    r: Resolver['k],
    locs: ArenaVec[Loc['k], 'k],
    // module -> its locations, by index into `locs`
    by_actual: ArenaMap[ModuleId['k], ArenaVec[usize, 'k], 'k],
    sources: ArenaMap[ModuleId['k], Source['k], 'k],
    // type declaration id -> the members of its impls, in every package
    methods: ArenaMap[u32, ArenaVec[Member['k], 'k], 'k],
    instances: ArenaVec[Inst['k], 'k],
}

forall 'k.
fn module_url(&cx: Domain!['k], r: Resolver['k], package: usize, path: ArenaVec[Str['k], 'k]) -> Str['k] {
    var out = Buffer!::new().put("/").write(&cx, r.packages.at(&cx, package).name.copy(&cx)).put("/");
    var i = 0usize;
    while i < path.len(&cx) {
        out = out.write(&cx, path.at(&cx, i)).put("/");
        i = i + 1usize;
    }
    out.save(&cx)
}

forall 'k.
fn module_title(&cx: Domain!['k], r: Resolver['k], package: usize, path: ArenaVec[Str['k], 'k]) -> Str['k] {
    let name = r.packages.at(&cx, package).name.copy(&cx);
    if path.is_empty(&cx) { name }
    else { Buffer!::new().write(&cx, name).put("::").write(&cx, path.join(&cx, "::")).save(&cx) }
}

// Package `package` exposes `actual` at `path`, and through it every module it exports, unless that
// module is one `chain` already passed through.
forall 'k.
fn walk(&cx: Domain!['k], g: Gen['k], package: usize, path: ArenaVec[Str['k], 'k], actual: ModuleId['k], chain: ArenaVec[ModuleId['k], 'k]) {
    let index = g.locs.len(&cx);
    g.locs.push(&cx, Loc.{ package, path, actual, url: module_url(&cx, g.r, package, path), title: module_title(&cx, g.r, package, path) });
    match g.by_actual.get(&cx, actual) {
        Some(found) => found.push(&cx, index),
        None => { let unit = g.by_actual.insert(&cx, actual, ArenaVec::one(&cx, index)); },
    }
    let scope = match g.r.scopes.get(&cx, actual) {
        Some(s) => s,
        None => return,
    };
    let exports = scope.exports.keys(&cx);
    var e = 0usize;
    while e < exports.len(&cx) {
        let name = exports.at(&cx, e);
        match g.r.lookup(&cx, actual, ArenaVec::one(&cx, name), S::Pos.{ line: 0u32, col: 0u32 }) {
            Ok(found) => match found {
                Module(m) => if !chain.contains(&cx, m) {
                    let deeper = path.clone(&cx);
                    deeper.push(&cx, name);
                    let longer = chain.clone(&cx);
                    longer.push(&cx, m);
                    walk(&cx, g, package, deeper, m, longer);
                },
                _ => (),
            },
            Err(_) => (),
        }
        e = e + 1usize;
    }
}

forall 'k.
fn read_source(&cx: Domain!['k], r: Resolver['k], home: ModuleId['k]) -> Source['k] {
    let package = r.packages.at(&cx, home.package);
    let file = package.files.at(&cx, home);
    let text = match read_to_arena(&cx, file) {
        Ok(bytes) => bytes,
        Err(_) => package::support::base::fail(&cx, Buffer!::new().put("cannot read ").write(&cx, file).save(&cx)),
    };
    let lines: ArenaVec[usize, 'k] = ArenaVec::one(&cx, 0usize);
    var at = 0usize;
    var going = true;
    while going {
        match text.find_byte(&cx, b'\n', at) {
            Some(n) => {
                lines.push(&cx, n + 1usize);
                at = n + 1usize;
            },
            None => { going = false; },
        }
    }
    let relative = if file.starts_with(&cx, package.root) && file.len() > package.root.len() + 1usize {
        file.slice(package.root.len() + 1usize, file.len())
    } else { file };
    Source.{ text, lines, file: relative }
}

forall 'k.
fn source(&cx: Domain!['k], g: Gen['k], home: ModuleId['k]) -> Source['k] {
    match g.sources.get(&cx, home) {
        Some(found) => found,
        None => {
            let made = read_source(&cx, g.r, home);
            let unit = g.sources.insert(&cx, home, made);
            made
        },
    }
}

// The offset of the first byte of a line, numbered from 1; the end of the text past its last line.
forall 'k.
fn line_start(&cx: Domain!['k], src: Source['k], line: u32) -> usize {
    if line == 0u32 { return 0usize; }
    match src.lines.get(&cx, (line - 1u32) as usize) {
        Some(at) => at,
        None => src.text.len(),
    }
}

// A line without its newline and surrounding whitespace.
forall 'k.
fn line_text(&cx: Domain!['k], src: Source['k], line: u32) -> Str['k] {
    let start = line_start(&cx, src, line);
    let end = line_start(&cx, src, line + 1u32);
    src.text.slice(start, end).trim(&cx)
}

forall 'k.
fn offset(&cx: Domain!['k], src: Source['k], pos: S::Pos) -> usize {
    line_start(&cx, src, pos.line) + (pos.col as usize) - 1usize
}

forall 'k.
fn named(&cx: Domain!['k], r: Resolver['k], id: u32) -> Option[NameRef['k]] {
    r.refs.get(&cx, id)
}

// What an impl gives methods: the name reference of its target.
forall 'k.
fn impl_owner(&cx: Domain!['k], r: Resolver['k], block: S::Impl['k]) -> Option[NameRef['k]] {
    let t = match block.ty {
        Name(t) => t,
        _ => return Option::None,
    };
    match named(&cx, r, t.id) {
        // an impl written through a type alias gives methods to the type it stands for
        Some(found) => match found {
            Decl(d) => if d.kind.is(&cx, "alias") {
                match r.aliased(&cx, d, t.pos) {
                    Some(owner) => match owner {
                        Decl(e) => Option::Some.(NameRef::Decl.(e)),
                        Prim(name) => Option::Some.(if is_prim(&cx, name) { NameRef::Prim.(name) } else { NameRef::Builtin.(name) }),
                        Blanket => Option::None,
                    },
                    None => Option::None,
                }
            } else {
                Option::Some.(found)
            },
            _ => Option::Some.(found),
        },
        None => Option::None,
    }
}

// What an instance's head mentions: the declarations and the primitive and builtin types it names.
forall 'k.
fn head_mentions(&cx: Domain!['k], r: Resolver['k], t: S::Type['k], types: ArenaVec[u32, 'k], prims: ArenaVec[Str['k], 'k]) {
    match t {
        Name(n) => {
            match named(&cx, r, n.id) {
                Some(found) => match found {
                    Decl(d) => if !types.contains(&cx, d.id) { types.push(&cx, d.id); },
                    Prim(name) => if !prims.contains(&cx, name) { prims.push(&cx, name); },
                    Builtin(name) => if !prims.contains(&cx, name) { prims.push(&cx, name); },
                    _ => (),
                },
                None => (),
            }
            var i = 0usize;
            while i < n.args.len(&cx) {
                head_mentions(&cx, r, n.args.at(&cx, i), types, prims);
                i = i + 1usize;
            }
        },
        Ptr(inner) => head_mentions(&cx, r, inner.copy(&cx), types, prims),
        Tuple(elems) => {
            var i = 0usize;
            while i < elems.len(&cx) {
                head_mentions(&cx, r, elems.at(&cx, i), types, prims);
                i = i + 1usize;
            }
        },
        Array(elem, _) => head_mentions(&cx, r, elem.copy(&cx), types, prims),
        _ => (),
    }
}

forall 'k.
fn canonical_list(&cx: Domain!['k], out: Buffer!, ts: ArenaVec[S::Type['k], 'k]) -> Buffer! {
    var out = out;
    var i = 0usize;
    while i < ts.len(&cx) {
        if i > 0usize { out = out.put(","); }
        out = canonical(&cx, out, ts.at(&cx, i));
        i = i + 1usize;
    }
    out
}

forall 'k.
fn canonical_slots(&cx: Domain!['k], out: Buffer!, slots: ArenaVec[S::Slot['k], 'k]) -> Buffer! {
    var out = out.put("(");
    var i = 0usize;
    while i < slots.len(&cx) {
        if i > 0usize { out = out.put(","); }
        if slots.at(&cx, i).lend { out = out.put("&"); }
        out = canonical(&cx, out, slots.at(&cx, i).ty);
        i = i + 1usize;
    }
    out.put(")->")
}

// A type as written, without spaces: `Ord[u8,u8]`, `Iterator[I->T]`.
forall 'k.
fn canonical(&cx: Domain!['k], out: Buffer!, t: S::Type['k]) -> Buffer! {
    match t {
        Name(n) => {
            var out = out.write(&cx, n.path.join(&cx, "::"));
            if !n.args.is_empty(&cx) {
                out = out.put("[");
                let free = n.args.len(&cx) - n.determined;
                var i = 0usize;
                while i < n.args.len(&cx) {
                    if i == free && n.determined > 0usize { out = out.put("->"); }
                    else if i > 0usize { out = out.put(","); }
                    out = canonical(&cx, out, n.args.at(&cx, i));
                    i = i + 1usize;
                }
                out = out.put("]");
            }
            out
        },
        Ptr(inner) => canonical(&cx, out.put("*"), inner.copy(&cx)),
        Never => out.put("!"),
        Tuple(elems) => canonical_list(&cx, out.put("("), elems).put(")"),
        Array(elem, length) => {
            let size = match length.copy(&cx) {
                Lit(l) => l.text,
                _ => lit(&cx, "_"),
            };
            canonical(&cx, out.put("["), elem.copy(&cx)).put(";").write(&cx, size).put("]")
        },
        Fn(f) => canonical(&cx, canonical_slots(&cx, out.put(if f.is_unsafe { "unsafe fn" } else { "fn" }), f.params), f.ret.copy(&cx)),
        Closure(c) => {
            var out = out.put("closure");
            match c.env {
                Some(env) => { out = canonical(&cx, out.put("["), env.copy(&cx)).put("]"); },
                None => (),
            }
            canonical(&cx, canonical_slots(&cx, out, c.params), c.ret.copy(&cx))
        },
        Exists(brands, _at, body) => canonical(&cx, out.put("exists ").write(&cx, brands.join(&cx, ",")).put("."), body.copy(&cx)),
        Foreach(f) => {
            let out = out.put(if f.indirect { "foreach *" } else { "foreach " }).write(&cx, f.binder).put(" of ");
            canonical(&cx, canonical(&cx, out, f.source.copy(&cx)).put("=>"), f.body.copy(&cx))
        },
        Brand(name) => out.write(&cx, name),
        Ignored(_at) => out.put("_"),
    }
}

// What an instance is of, as its source spells it: `Ord[u8, u8]` for `instance Ord[u8, u8] {`.
forall 'k.
fn instance_head(&cx: Domain!['k], src: Source['k], pos: S::Pos) -> Str['k] {
    let text = line_text(&cx, src, pos.line);
    let start = match text.find(&cx, lit(&cx, "instance "), 0usize) {
        Some(n) => n + 9usize,
        None => 0usize,
    };
    let end = match text.find_byte(&cx, b'{', start) {
        Some(n) => n,
        None => text.len(),
    };
    text.slice(start, end).trim(&cx)
}

forall 'k.
fn build(&cx: Domain!['k], r: Resolver['k]) -> Gen['k] {
    let g = Gen.{ r, locs: ArenaVec::new(&cx), by_actual: ArenaMap::new(&cx), sources: ArenaMap::new(&cx),
        methods: ArenaMap::new(&cx), instances: ArenaVec::new(&cx) };
    var p = 0usize;
    while p < r.packages.len(&cx) {
        let root = ModuleId::root(&cx, p);
        if r.scopes.contains(&cx, root) { walk(&cx, g, p, ArenaVec::new(&cx), root, ArenaVec::one(&cx, root)); }
        p = p + 1usize;
    }
    let homes = r.scopes.keys(&cx);
    var h = 0usize;
    while h < homes.len(&cx) {
        let home = homes.at(&cx, h);
        let items = r.scopes.at(&cx, home).items;
        var i = 0usize;
        while i < items.len(&cx) {
            match items.at(&cx, i) {
                Impl(block) => match impl_owner(&cx, r, block) {
                    Some(owner) => match owner {
                        Decl(d) => {
                            let list = match g.methods.get(&cx, d.id) {
                                Some(found) => found,
                                None => {
                                    let made: ArenaVec[Member['k], 'k] = ArenaVec::new(&cx);
                                    let unit = g.methods.insert(&cx, d.id, made);
                                    made
                                },
                            };
                            var m = 0usize;
                            while m < block.items.len(&cx) {
                                list.push(&cx, Member.{ home, member: block.items.at(&cx, m) });
                                m = m + 1usize;
                            }
                        },
                        _ => (),
                    },
                    None => (),
                },
                _ => (),
            }
            i = i + 1usize;
        }
        h = h + 1usize;
    }
    var n = 0usize;
    while n < r.instances.len(&cx) {
        let (home, decl) = r.instances.at(&cx, n);
        let types: ArenaVec[u32, 'k] = ArenaVec::new(&cx);
        let prims: ArenaVec[Str['k], 'k] = ArenaVec::new(&cx);
        var trait_decl = Option::None;
        match decl.ty {
            Name(t) => {
                match named(&cx, r, t.id) {
                    Some(found) => match found {
                        Decl(d) => { trait_decl = Option::Some.(d); },
                        _ => (),
                    },
                    None => (),
                }
                var a = 0usize;
                while a < t.args.len(&cx) {
                    head_mentions(&cx, r, t.args.at(&cx, a), types, prims);
                    a = a + 1usize;
                }
            },
            _ => (),
        }
        let anchor = encode(&cx, Buffer!::new().put("instance."), canonical(&cx, Buffer!::new(), decl.ty).save(&cx)).save(&cx);
        g.instances.push(&cx, Inst.{ home, decl, head: instance_head(&cx, source(&cx, g, home), decl.pos), anchor, trait_decl, types, prims });
        n = n + 1usize;
    }
    g
}

// The location of module `actual` that pages of package `view` link to: the shortest path `view`
// exposes it at, else the shortest its own package does, else any.
forall 'k.
fn loc_of(&cx: Domain!['k], g: Gen['k], view: usize, actual: ModuleId['k]) -> Option[Loc['k]] {
    let found = match g.by_actual.get(&cx, actual) {
        Some(list) => list,
        None => return Option::None,
    };
    match best(&cx, g, found, view) {
        Some(l) => Option::Some.(l),
        None => match best(&cx, g, found, actual.package) {
            Some(l) => Option::Some.(l),
            None => Option::Some.(g.locs.at(&cx, found.at(&cx, 0usize))),
        },
    }
}

forall 'k.
fn best(&cx: Domain!['k], g: Gen['k], found: ArenaVec[usize, 'k], view: usize) -> Option[Loc['k]] {
    var chosen = Option::None;
    var i = 0usize;
    while i < found.len(&cx) {
        let l = g.locs.at(&cx, found.at(&cx, i));
        if l.package == view {
            chosen = match chosen {
                None => Option::Some.(l),
                Some(c) => if shorter(&cx, l, c) { Option::Some.(l) } else { Option::Some.(c) },
            };
        }
        i = i + 1usize;
    }
    chosen
}

forall 'k.
fn shorter(&cx: Domain!['k], a: Loc['k], b: Loc['k]) -> bool {
    let n = a.path.len(&cx);
    let m = b.path.len(&cx);
    if n != m { return n < m; }
    match a.url.cmp(&cx, b.url) {
        Less => true,
        _ => false,
    }
}

// The kind of declaration a type or trait page documents, as its file name starts: `struct`,
// `enum`, `tuple`, `type` (a type alias) or `trait`; empty for any other declaration.
forall 'k.
fn page_kind(&cx: Domain!['k], d: Decl['k]) -> Str['k] {
    if d.kind.is(&cx, "struct") || d.kind.is(&cx, "enum") || d.kind.is(&cx, "tuple") || d.kind.is(&cx, "trait") { d.kind }
    else if d.kind.is(&cx, "alias") { lit(&cx, "type") }
    else { lit(&cx, "") }
}

// The page of a type or trait under a module location: `/std/io/struct.File~.html`.
forall 'k.
fn item_url(&cx: Domain!['k], l: Loc['k], kind: Str['k], name: Str['k]) -> Str['k] {
    encode(&cx, Buffer!::new().write(&cx, l.url).write(&cx, kind).put("."), name).put(".html").save(&cx)
}

// The page of type or trait `d` that pages of package `view` link to, if it has one.
forall 'k.
fn decl_url(&cx: Domain!['k], g: Gen['k], view: usize, d: Decl['k]) -> Option[Str['k]] {
    let kind = page_kind(&cx, d);
    if kind.is_empty() { return Option::None; }
    match loc_of(&cx, g, view, d.home) {
        Some(l) => Option::Some.(item_url(&cx, l, kind, d.name)),
        None => Option::None,
    }
}

forall 'k.
fn mention_type(&cx: Domain!['k], g: Gen['k], out: ArenaVec[Mention['k], 'k], t: S::Type['k]) {
    match t {
        Name(n) => {
            match named(&cx, g.r, n.id) {
                Some(found) => match found {
                    Decl(d) => out.push(&cx, Mention.{ pos: n.pos, path: n.path, decl: d }),
                    _ => (),
                },
                None => (),
            }
            mention_types(&cx, g, out, n.args);
        },
        Ptr(inner) => mention_type(&cx, g, out, inner.copy(&cx)),
        Tuple(elems) => mention_types(&cx, g, out, elems),
        Array(elem, _) => mention_type(&cx, g, out, elem.copy(&cx)),
        Fn(f) => {
            mention_slots(&cx, g, out, f.params);
            mention_type(&cx, g, out, f.ret.copy(&cx));
        },
        Closure(c) => {
            match c.env {
                Some(env) => mention_type(&cx, g, out, env.copy(&cx)),
                None => (),
            }
            mention_slots(&cx, g, out, c.params);
            mention_type(&cx, g, out, c.ret.copy(&cx));
        },
        Exists(_, _, body) => mention_type(&cx, g, out, body.copy(&cx)),
        Foreach(f) => {
            mention_type(&cx, g, out, f.source.copy(&cx));
            mention_type(&cx, g, out, f.body.copy(&cx));
        },
        _ => (),
    }
}

forall 'k.
fn mention_types(&cx: Domain!['k], g: Gen['k], out: ArenaVec[Mention['k], 'k], ts: ArenaVec[S::Type['k], 'k]) {
    var i = 0usize;
    while i < ts.len(&cx) {
        mention_type(&cx, g, out, ts.at(&cx, i));
        i = i + 1usize;
    }
}

forall 'k.
fn mention_slots(&cx: Domain!['k], g: Gen['k], out: ArenaVec[Mention['k], 'k], slots: ArenaVec[S::Slot['k], 'k]) {
    var i = 0usize;
    while i < slots.len(&cx) {
        mention_type(&cx, g, out, slots.at(&cx, i).ty);
        i = i + 1usize;
    }
}

// The traits of a quantifier's premises, and the types in their arguments.
forall 'k.
fn mention_forall(&cx: Domain!['k], g: Gen['k], out: ArenaVec[Mention['k], 'k], q: Option[S::Forall['k]]) {
    match q {
        Some(f) => {
            var i = 0usize;
            while i < f.premises.len(&cx) {
                let premise = f.premises.at(&cx, i);
                match named(&cx, g.r, premise.args.id) {
                    Some(found) => match found {
                        Decl(d) => out.push(&cx, Mention.{ pos: premise.pos, path: premise.trait_path, decl: d }),
                        _ => (),
                    },
                    None => (),
                }
                mention_types(&cx, g, out, premise.args.args);
                i = i + 1usize;
            }
        },
        None => (),
    }
}

forall 'k.
fn mention_fn(&cx: Domain!['k], g: Gen['k], out: ArenaVec[Mention['k], 'k], f: S::Fn['k]) {
    mention_forall(&cx, g, out, f.quantifier);
    var i = 0usize;
    while i < f.params.len(&cx) {
        match f.params.at(&cx, i).ty {
            Some(t) => mention_type(&cx, g, out, t),
            None => (),
        }
        i = i + 1usize;
    }
    match f.ret {
        Some(t) => mention_type(&cx, g, out, t),
        None => (),
    }
}

// The types and traits the shown part of an item names: its premises and the types of its
// fields, variants, parameters and result; an instance's head; a trait's methods.
forall 'k.
fn mentions(&cx: Domain!['k], g: Gen['k], it: S::Item['k]) -> ArenaVec[Mention['k], 'k] {
    let out: ArenaVec[Mention['k], 'k] = ArenaVec::new(&cx);
    match it {
        Struct(d) => {
            mention_forall(&cx, g, out, d.quantifier);
            var i = 0usize;
            while i < d.fields.len(&cx) {
                mention_type(&cx, g, out, d.fields.at(&cx, i).ty);
                i = i + 1usize;
            }
        },
        Tuple(d) => {
            mention_forall(&cx, g, out, d.quantifier);
            mention_types(&cx, g, out, d.elems);
        },
        Alias(d) => {
            mention_forall(&cx, g, out, d.quantifier);
            mention_type(&cx, g, out, d.body);
        },
        Enum(d) => {
            mention_forall(&cx, g, out, d.quantifier);
            var i = 0usize;
            while i < d.variants.len(&cx) {
                mention_types(&cx, g, out, d.variants.at(&cx, i).payload);
                i = i + 1usize;
            }
        },
        Trait(d) => {
            mention_forall(&cx, g, out, d.quantifier);
            var i = 0usize;
            while i < d.methods.len(&cx) {
                mention_fn(&cx, g, out, d.methods.at(&cx, i));
                i = i + 1usize;
            }
        },
        Fn(f) => mention_fn(&cx, g, out, f),
        Const(c) => mention_type(&cx, g, out, c.ty),
        Instance(d) => {
            mention_forall(&cx, g, out, d.quantifier);
            match d.ty {
                Name(t) => {
                    match named(&cx, g.r, t.id) {
                        Some(found) => match found {
                            Decl(trait_decl) => out.push(&cx, Mention.{ pos: t.pos, path: t.path, decl: trait_decl }),
                            _ => (),
                        },
                        None => (),
                    }
                    mention_types(&cx, g, out, t.args);
                },
                _ => (),
            }
        },
        _ => (),
    }
    out
}

// The mentions within `src.text[start..end]` as links from the page at `page`, for pages of package
// `view`; a mention whose text is not its path as written without spaces, or whose declaration has
// no page, is left out.
forall 'k.
fn links(&cx: Domain!['k], g: Gen['k], view: usize, page: Str['k], src: Source['k], found: ArenaVec[Mention['k], 'k], start: usize, end: usize) -> ArenaVec[Link['k], 'k] {
    let out: ArenaVec[Link['k], 'k] = ArenaVec::new(&cx);
    var i = 0usize;
    while i < found.len(&cx) {
        let m = found.at(&cx, i);
        let at = offset(&cx, src, m.pos);
        let spelled = m.path.join(&cx, "::");
        if at >= start && at + spelled.len() <= end && src.text.slice(at, at + spelled.len()).eq(&cx, spelled) {
            match decl_url(&cx, g, view, m.decl) {
                Some(url) => out.push(&cx, Link.{ start: at, end: at + spelled.len(), url: relative(&cx, page, url), kind: page_kind(&cx, m.decl) }),
                None => (),
            }
        }
        i = i + 1usize;
    }
    out.sort_by(&cx, |&cx, a, b| if a.start < b.start { Order::Less } else if a.start > b.start { Order::Greater } else { Order::Equal });
    out
}
