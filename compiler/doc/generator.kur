        .push_static(".kind-extern::before { color: var(--extern-ink); background: var(--extern-bg); }\n")
        .push_static("main pre { max-width: 100%; overflow-x: auto; padding: 1rem 1.2rem; border-radius: .6rem; background: var(--code-bg); color: var(--code-ink); line-height: 1.5; }\n")
        .push_static(".tok-keyword { color: #ff93b4; font-weight: 700; }.tok-type { color: #89dceb; }.tok-string { color: #b4e29b; }.tok-number { color: #f8cf8c; }.tok-comment { color: #aeb4bf; font-style: italic; }\n")
        .push_static("main code { font-family: var(--code-font); }\n")
        .push_static("main :not(pre) > code { padding: .1rem .3rem; border-radius: .25rem; background: var(--inline-bg); font-size: .9em; }\n")
        .push_static("@media (max-width: 760px) { .layout { display: block; padding: 1rem .8rem 3rem; } .sidebar { position: static; max-height: 12rem; margin-bottom: 1rem; } main { padding: 1rem 1.1rem 2rem; } .header-kicker { display: none; } }\n"));
    var index = Buffer!::new().push_static("+++\nlayout = \"index.html\"\ntitle = \"Packages\"\n+++\n# Package documentation\n\nGenerated from Kursal source. Select a package:\n\n");
    var p = 0usize;
    while p < r.packages.len(&cx) {
        let package = r.packages.at(&cx, p);
        let name = package.name.copy(&cx);
        directory(&cx, path(&cx, source, name));
        index = index.push_static("- [").push_bytes(&cx, name).push_static("](/").push_bytes(&cx, name).push_static("/)\n");
        let modules = package.files.keys(&cx);
        var i = 0usize;
        while i < modules.len(&cx) {
            let home = modules.at(&cx, i);
            if public_module(&cx, r, home) { page(&cx, r, home, output); }
            i = i + 1usize;
        }
        p = p + 1usize;
    }
    save(&cx, path(&cx, source, lit(&cx, "index.md")), index);
