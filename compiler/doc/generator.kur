        .push_static(".nav-modules { --nav-color: var(--nav-modules); }\n.nav-types { --nav-color: var(--nav-types); }\n.nav-implementations { --nav-color: var(--nav-implementations); }\n")
        .push_static(".nav-traits { --nav-color: var(--nav-traits); }\n.nav-functions { --nav-color: var(--nav-functions); }\n.nav-constants { --nav-color: var(--nav-constants); }\n.nav-externs { --nav-color: var(--nav-externs); }\n")
        .push_static(".nav-section h2 { color: var(--nav-color); font-size: .74rem; letter-spacing: .1em; text-transform: uppercase; margin: 0 0 .35rem; }\n.nav-section a { color: var(--nav-color); }\n")
        .push_static(".nav-list, .type-members { list-style: none; margin: 0; padding: 0; }\n.nav-list li { margin: .08rem 0; }\n")
        .push_static(".nav-list a { display: block; padding: .27rem .45rem; border-radius: .35rem; text-decoration: none; font: .84rem/1.5 var(--code-font); }\n")
        .push_static(".nav-list a:hover { background: var(--hover); }\n")
        .push_static(".type-group summary { cursor: pointer; padding: .27rem .45rem; border-radius: .35rem; color: var(--nav-color); font: 650 .84rem/1.5 var(--code-font); }\n")
        .push_static(".type-group summary:hover { background: var(--hover); }\n.type-members { margin: .1rem 0 .3rem .65rem; padding-left: .5rem; border-left: 2px solid var(--line); }\n")
