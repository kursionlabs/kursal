    save(&cx, path(&cx, includes, lit(&cx, "index.html")), Buffer!::new()
        .push_static("+++\nlayout = \"page.html\"\n+++\n<main class=\"landing\">{{ content | safe }}</main>\n"));
    save(&cx, path(&cx, assets, lit(&cx, "theme.js")), Buffer!::new()
        .push_static("(() => {\n  const root = document.documentElement;\n  const toggle = document.querySelector('.theme-toggle');\n  const system = window.matchMedia('(prefers-color-scheme: dark)');\n  const current = () => root.getAttribute('data-theme') || (system.matches ? 'dark' : 'light');\n  const label = () => { const next = current() === 'dark' ? 'light' : 'dark'; const text = 'Switch to ' + next + ' mode'; toggle.dataset.next = next; toggle.setAttribute('aria-label', text); toggle.title = text; };\n  toggle.addEventListener('click', () => { const next = current() === 'dark' ? 'light' : 'dark'; root.setAttribute('data-theme', next); try { localStorage.setItem('kursal-doc-theme', next); } catch (e) {} label(); });\n  if (system.addEventListener) system.addEventListener('change', label);\n  label();\n})();\n"));
    let dark_colors = Buffer!::new()
        .push_static("--bg:#15131a;--surface:#29232d;--ink:#fff9f7;--muted:#d4c4ce;--line:#695463;")
        .push_static("--accent:#ff8a98;--accent-hover:#ffc0c8;--header:#3c202d;--header-border:#ff687d;")
        .push_static("--brand-mark:#ff8794;--brand-ink:#32151d;--header-soft:#f3cbd3;--hover:#473340;")
        .push_static("--code-bg:#111116;--code-ink:#f7f6fa;--inline-bg:#403441;")
        .push_static("--landing-bg:#302633;--landing-border:#705367;--landing-hover:#433248;")
        .push_static("--struct-ink:#10242d;--struct-bg:#62d9f7;--enum-ink:#251037;--enum-bg:#caa6ff;")
        .push_static("--trait-ink:#332016;--trait-bg:#ffc17d;--fn-ink:#34161d;--fn-bg:#ff8794;")
        .push_static("--method-ink:#1b2b13;--method-bg:#a6e67c;--const-ink:#342809;--const-bg:#ffe36c;")
        .push_static("--extern-ink:#1e282e;--extern-bg:#c8d6df;")
        .push_static("--nav-modules:#ff8794;--nav-types:#62d9f7;--nav-implementations:#a6e67c;--nav-traits:#ffc17d;")
        .push_static("--nav-functions:#ff8794;--nav-constants:#ffe36c;--nav-externs:#c8d6df;color-scheme:dark;").save(&cx);
    save(&cx, path(&cx, assets, lit(&cx, "site.css")), Buffer!::new()
        .push_static(":root { color-scheme: light; --bg:#f7f6f7;--surface:#ffffff;--ink:#29262b;--muted:#625c64;--line:#ded8df;")
        .push_static("--accent:#9b2f45;--accent-hover:#702238;--header:#3f222e;--header-border:#d54d67;")
        .push_static("--brand-mark:#f17b8d;--brand-ink:#35141e;--header-soft:#f3d6df;--hover:#f5edf1;")
        .push_static("--code-bg:#28232c;--code-ink:#faf7fb;--inline-bg:#f2eef2;")
        .push_static("--landing-bg:#fcfafb;--landing-border:#e5dfe5;--landing-hover:#f4eef3;")
        .push_static("--struct-ink:#0c4d62;--struct-bg:#bdefff;--enum-ink:#4d287a;--enum-bg:#ead4ff;")
        .push_static("--trait-ink:#763708;--trait-bg:#ffe2bd;--fn-ink:#872237;--fn-bg:#ffccd2;")
        .push_static("--method-ink:#2f5e20;--method-bg:#d9f6c6;--const-ink:#6c5200;--const-bg:#ffedaa;")
        .push_static("--extern-ink:#40515b;--extern-bg:#e2ebf0;")
        .push_static("--nav-modules:#9b2f45;--nav-types:#0c6a84;--nav-implementations:#3e7a2a;--nav-traits:#8f4b10;")
        .push_static("--nav-functions:#9b2f45;--nav-constants:#866000;--nav-externs:#4b626e;")
        .push_static("--code-font:ui-monospace,SFMono-Regular,Consolas,monospace; }\n")
        .push_static("@media (prefers-color-scheme: dark) { :root:not([data-theme=\"light\"]) {").push_bytes(&cx, dark_colors).push_static("} }\n")
        .push_static(":root[data-theme=\"dark\"] {").push_bytes(&cx, dark_colors).push_static("}\n")
        .push_static("* { box-sizing: border-box; }\nhtml { scroll-behavior: smooth; }\n")
        .push_static("body { margin: 0; color: var(--ink); background: var(--bg); font: 16px/1.65 system-ui, sans-serif; }\n")
        .push_static("a { color: var(--accent); text-underline-offset: .18em; }\na:hover { color: var(--accent-hover); }\n")
        .push_static(".masthead { background: var(--header); color: #fff1ee; border-bottom: 3px solid var(--header-border); }\n")
        .push_static(".masthead-inner { max-width: 1240px; margin: auto; padding: .9rem 1.25rem; display: flex; justify-content: space-between; align-items: center; gap: 1rem; }\n")
        .push_static(".brand { display: inline-flex; align-items: center; gap: .5rem; color: #fff1ee; font-size: 1.2rem; font-weight: 750; text-decoration: none; }\n")
        .push_static(".brand-mark { display: inline-grid; place-items: center; width: 2rem; height: 2rem; border-radius: .55rem; background: var(--brand-mark); color: var(--brand-ink); font-weight: 850; }\n")
        .push_static(".brand-sub { color: var(--header-soft); font-weight: 500; }\n.header-kicker { color: var(--header-soft); font-size: .85rem; letter-spacing: .04em; text-transform: uppercase; }\n")
        .push_static(".header-actions { display: flex; align-items: center; gap: 1rem; }\n.theme-toggle { display: grid; place-items: center; width: 2.35rem; height: 2.35rem; border: 1px solid #a88c94; border-radius: .4rem; background: transparent; color: #f5ecef; cursor: pointer; }\n")
        .push_static(".theme-toggle:hover { background: #ffffff18; }\n.theme-icon { display: none; width: 1.15rem; height: 1.15rem; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }\n")
        .push_static(".theme-toggle[data-next=\"dark\"] .icon-moon, .theme-toggle[data-next=\"light\"] .icon-sun { display: block; }\n:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }\n.theme-toggle:focus-visible { outline-color: #fff1ee; }\n")
        .push_static(".layout { display: grid; grid-template-columns: 230px minmax(0, 1fr); gap: 1.5rem; max-width: 1240px; margin: 0 auto; padding: 1.75rem 1.25rem 4rem; align-items: start; }\n")
