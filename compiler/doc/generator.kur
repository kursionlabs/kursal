        .push_static("<section class=\"nav-section nav-modules\"><h2>Modules</h2><ul class=\"nav-list\">{% for child in collections.pages | children_of: page.url %}<li><a href=\"{{ child.url | url }}\">{{ child.nav_title }}</a></li>{% endfor %}</ul></section>\n")
