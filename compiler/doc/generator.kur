        .push_static("main { min-width: 0; max-width: 100%; overflow-wrap: anywhere; background: var(--surface); border: 1px solid var(--line); border-radius: .65rem; padding: 1.3rem 2rem 3rem; }\n")
        .push_static("main.landing { max-width: 880px; margin: 2rem auto; }\nmain h1 { font-size: clamp(1.9rem, 4vw, 2.6rem); line-height: 1.18; letter-spacing: -.035em; margin: .35rem 0 1rem; }\n")
        .push_static(".layout main h1 { font-family: var(--code-font); font-size: clamp(1.65rem, 3vw, 2.2rem); letter-spacing: -.045em; }\n")
        .push_static("main h1::after { content: ''; display: block; width: 3.5rem; height: 4px; margin-top: .8rem; border-radius: 1rem; background: var(--header-border); }\n")
        .push_static(".landing ul { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: .75rem; list-style: none; padding: 0; margin-top: 1.5rem; }\n")
