// Generate a Krayon input tree from the resolver's parsed modules. This lives in the compiler so
// the published documentation follows the same package and module rules as a build.
use package::resolve::resolver::{ModuleId, Owner, Named, Resolver, Target};
use package::syntax::ast as S;
use std::alloc::arena::Domain!;
use std::bytes::buffer::Buffer!;
use std::collections::arena_vec::ArenaVec;
use std::fs::{mkdir, path_exists, read_to_arena, write};
use std::option::{Option, Result};
use std::raw::Span;

forall 'k.
fn lit(&cx: Domain!['k], value: std::slice::Slice[u8, 'static]) -> Span['k] {
    Span::from_static(&cx, value)
}

forall 'k.
fn path(&cx: Domain!['k], base: Span['k], name: Span['k]) -> Span['k] {
    Buffer!::new().push_bytes(&cx, base).push_static("/").push_bytes(&cx, name).save(&cx)
}

forall 'k.
fn url(&cx: Domain!['k], r: Resolver['k], home: ModuleId['k]) -> Span['k] {
    var out = Buffer!::new().push_static("/").push_bytes(&cx, r.packages.at(&cx, home.package).name.copy(&cx)).push_static("/");
    var i = 0usize;
    while i < home.path.len(&cx) {
        out = out.push_bytes(&cx, home.path.at(&cx, i)).push_static("/");
        i = i + 1usize;
    }
    out.save(&cx)
}

forall 'k.
fn require(&cx: Domain!['k], result: Result[(), std::io::Error], message: Span['k]) {
    match result {
        Result::Ok(_) => (),
        Result::Err(_) => package::support::base::fail(&cx, message),
    }
}

forall 'k.
fn save(&cx: Domain!['k], file: Span['k], body: Buffer!) {
    require(&cx, write(&cx, file, body), Buffer!::new().push_static("cannot write ").push_bytes(&cx, file).save(&cx));
}

forall 'k.
fn directory(&cx: Domain!['k], file: Span['k]) {
    let present = match path_exists(&cx, file) {
        Result::Ok(found) => found,
        Result::Err(_) => package::support::base::fail(&cx, Buffer!::new().push_static("cannot inspect ").push_bytes(&cx, file).save(&cx)),
    };
    if !present { require(&cx, mkdir(&cx, file), Buffer!::new().push_static("cannot create ").push_bytes(&cx, file).save(&cx)); }
}

// Offset of the first byte on a numbered source line. AST positions are one-based.
forall 'k.
fn line_start(&cx: Domain!['k], source: Span['k], line: u32) -> usize {
    var at = 0usize;
    var current = 1u32;
    while current < line && at < source.len() {
        at = match source.find_byte(&cx, b'\n', at) {
            Option::Some(n) => n + 1usize,
            Option::None => source.len(),
        };
        current = current + 1u32;
    }
    at
}

forall 'k.
fn declaration_line(&cx: Domain!['k], source: Span['k], line: u32) -> u32 {
    if line <= 1u32 { return line; }
    let first = line_start(&cx, source, line - 1u32);
    let end = line_start(&cx, source, line) - 1usize;
    var trimmed = first;
    while trimmed < end && (source.byte_or_zero(&cx, trimmed) == b' ' || source.byte_or_zero(&cx, trimmed) == b'\t') {
        trimmed = trimmed + 1usize;
    }
    let previous = source.slice(trimmed, end);
    if previous.starts_with(&cx, lit(&cx, "forall ")) { line - 1u32 } else { line }
}

forall 'k.
fn module_prose(&cx: Domain!['k], source: Span['k]) -> Buffer! {
    var at = 0usize;
    var out = Buffer!::new();
    while at + 2usize < source.len() && source.byte_or_zero(&cx, at) == b'/' && source.byte_or_zero(&cx, at + 1usize) == b'/' && source.byte_or_zero(&cx, at + 2usize) == b'!' {
        let end = match source.find_byte(&cx, b'\n', at) { Option::Some(n) => n, Option::None => source.len() };
        var content = at + 3usize;
        if content < end && source.byte_or_zero(&cx, content) == b' ' { content = content + 1usize; }
        out = out.push_bytes(&cx, source.slice(content, end)).push_static("\n");
        at = end + 1usize;
    }
    if at > 0usize { out.push_static("\n") } else { out }
}

// Consecutive /// lines immediately before a declaration are its prose. Ordinary implementation
// comments are intentionally not published.
forall 'k.
fn prose(&cx: Domain!['k], source: Span['k], line: u32) -> Buffer! {
    var start = line_start(&cx, source, line);
    let lines: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
    var collecting = true;
    while start > 0usize && collecting {
        let end = start - 1usize;
        var previous = end;
        while previous > 0usize && source.byte_or_zero(&cx, previous - 1usize) != b'\n' {
            previous = previous - 1usize;
        }
        var content = previous;
        while content < end && (source.byte_or_zero(&cx, content) == b' ' || source.byte_or_zero(&cx, content) == b'\t') {
            content = content + 1usize;
        }
        if content + 2usize >= end || source.byte_or_zero(&cx, content) != b'/' || source.byte_or_zero(&cx, content + 1usize) != b'/' || source.byte_or_zero(&cx, content + 2usize) != b'/' {
            collecting = false;
        } else {
            content = content + 3usize;
            if content < end && source.byte_or_zero(&cx, content) == b' ' { content = content + 1usize; }
            lines.push(&cx, source.slice(content, end));
            start = previous;
        }
    }
    var out = Buffer!::new();
    var i = lines.len(&cx);
    while i > 0usize {
        i = i - 1usize;
        out = out.push_bytes(&cx, lines.at(&cx, i)).push_static("\n");
    }
    if !lines.is_empty(&cx) { out = out.push_static("\n"); }
    out
}

// The source spelling of a declaration, stopping before a function body. Aggregate definitions
// are kept whole only when their representation is exposed.
forall 'k.
fn signature(&cx: Domain!['k], source: Span['k], line: u32, aggregate: bool, is_exposed: bool) -> Span['k] {
    var start = line_start(&cx, source, line);
    while start < source.len() && (source.byte_or_zero(&cx, start) == b' ' || source.byte_or_zero(&cx, start) == b'\t') {
        start = start + 1usize;
    }
    var at = start;
    while at < source.len() {
        let byte = source.byte_or_zero(&cx, at);
        if byte == b';' { return source.slice(start, at + 1usize); }
        if byte == b'{' {
            if aggregate && is_exposed {
                var depth = 1usize;
                at = at + 1usize;
                while at < source.len() && depth > 0usize {
                    let next = source.byte_or_zero(&cx, at);
                    if next == b'{' { depth = depth + 1usize; }
                    if next == b'}' { depth = depth - 1usize; }
                    at = at + 1usize;
                }
                return source.slice(start, at);
            }
            return source.slice(start, at + 1usize);
        }
        at = at + 1usize;
    }
    source.slice(start, at)
}

forall 'k.
fn entry(&cx: Domain!['k], out: Buffer!, source: Span['k], name: Span['k], kind: Span['k], id: u32, pos: S::Pos, aggregate: bool, is_exposed: bool) -> Buffer! {
    let first = declaration_line(&cx, source, pos.line);
    var out = out.push_static("### ").push_bytes(&cx, name).push_static(" {#item-").push_usize(id as usize)
        .push_static(" .item-heading .kind-").push_bytes(&cx, kind).push_static("}\n\n");
    out = out.push_buffer(prose(&cx, source, first));
    let sig = signature(&cx, source, first, aggregate, is_exposed);
    out = out.push_static("```kursal\n").push_bytes(&cx, sig);
    if aggregate && !is_exposed { out = out.push_static(" ... }"); }
    if !aggregate && !sig.ends_with(&cx, Span::from_static(&cx, ";")) {
        // A function or method signature ends before its body.
        out = out.push_static(" ... }");
    }
    out.push_static("\n```\n\n")
}

forall 'k.
fn other_methods(&cx: Domain!['k], r: Resolver['k], home: ModuleId['k], name: Span['k], out: Buffer!) -> Buffer! {
    let scope = r.scopes.at(&cx, home);
    let owner = match scope.decls.get(&cx, name) {
        Option::Some(d) => d,
        Option::None => return out,
    };
    let keys = r.attached.keys(&cx);
    var out = out;
    var k = 0usize;
    while k < keys.len(&cx) {
        let (target, member) = keys.at(&cx, k);
        let matches = match target {
            Owner::Decl(d) => d.id == owner.id,
            _ => false,
        };
        if matches {
            let methods = r.attached.at(&cx, (target, member));
            var m = 0usize;
            while m < methods.len(&cx) {
                let decl = methods.at(&cx, m);
                if decl.home.package == home.package && !decl.home.path.join(&cx, "::").eq(&cx, home.path.join(&cx, "::")) {
                    let file = r.packages.at(&cx, decl.home.package).files.at(&cx, decl.home);
                    let package = r.packages.at(&cx, decl.home.package);
                    let relative = if file.starts_with(&cx, package.root) && file.len() > package.root.len() + 1usize {
                        file.slice(package.root.len() + 1usize, file.len())
                    } else { file };
                    let method_source = match read_to_arena(&cx, file) {
                        Result::Ok(bytes) => bytes,
                        Result::Err(_) => package::support::base::fail(&cx, lit(&cx, "cannot read method source")),
                    };
                    out = match decl.node {
                        Named::Fn(f) => entry(&cx, out, method_source, decl.name, lit(&cx, "method"), f.id, f.pos, false, false),
                        Named::Const(c) => entry(&cx, out, method_source, decl.name, lit(&cx, "const"), c.id, c.pos, false, false),
                        _ => out,
                    };
                    out = out.push_static("Defined in `").push_bytes(&cx, relative).push_static("`.\n\n");
                }
                m = m + 1usize;
            }
        }
        k = k + 1usize;
    }
    out
}

forall 'k.
fn item(&cx: Domain!['k], r: Resolver['k], home: ModuleId['k], out: Buffer!, source: Span['k], it: S::Item['k]) -> Buffer! {
    match it {
        S::Item::Struct(d) => other_methods(&cx, r, home, d.name, entry(&cx, out, source, d.name, lit(&cx, "struct"), d.id, d.pos, true, d.exposure.is_some())),
        S::Item::Tuple(d) => other_methods(&cx, r, home, d.name, entry(&cx, out, source, d.name, lit(&cx, "tuple"), d.id, d.pos, false, false)),
        S::Item::Enum(d) => other_methods(&cx, r, home, d.name, entry(&cx, out, source, d.name, lit(&cx, "enum"), d.id, d.pos, true, d.exposure.is_some())),
        S::Item::Trait(d) => entry(&cx, out, source, d.name, lit(&cx, "trait"), d.id, d.pos, true, true),
        S::Item::Fn(d) => entry(&cx, out, source, d.name, lit(&cx, "fn"), d.id, d.pos, false, false),
        S::Item::Extern(d) => entry(&cx, out, source, d.name, lit(&cx, "extern"), d.id, d.pos, false, false),
        S::Item::Const(d) => entry(&cx, out, source, d.name, lit(&cx, "const"), d.id, d.pos, false, false),
        S::Item::Impl(d) => {
            var out = out;
            let owner = match d.type {
                S::Type::Name(t) => t.path.join(&cx, "::"),
                _ => lit(&cx, "impl"),
            };
            var i = 0usize;
            while i < d.items.len(&cx) {
                out = match d.items.at(&cx, i) {
                    S::Member::Fn(m) => entry(&cx, out, source, Buffer!::new().push_bytes(&cx, owner).push_static("::").push_bytes(&cx, m.name).save(&cx), lit(&cx, "method"), m.id, m.pos, false, false),
                    S::Member::Const(m) => entry(&cx, out, source, Buffer!::new().push_bytes(&cx, owner).push_static("::").push_bytes(&cx, m.name).save(&cx), lit(&cx, "const"), m.id, m.pos, false, false),
                };
                i = i + 1usize;
            }
            out
        },
        _ => out,
    }
}

forall 'k.
fn public_module(&cx: Domain!['k], r: Resolver['k], home: ModuleId['k]) -> bool {
    var i = 0usize;
    while i < home.path.len(&cx) {
        let parent = ModuleId.{ package: home.package, path: home.path.slice(&cx, 0usize, i) };
        match r.scopes.get(&cx, parent) {
            Option::Some(scope) => if !scope.exports.contains(&cx, home.path.at(&cx, i)) { return false; },
            Option::None => return false,
        }
        i = i + 1usize;
    }
    true
}

forall 'k.
fn nav_record(&cx: Domain!['k], out: Buffer!, name: Span['k], section: std::slice::Slice[u8, 'static], id: u32) -> Buffer! {
    out.push_static("[[nav_items]]\nname = \"").push_bytes(&cx, name)
        .push_static("\"\nsection = \"").push_static(section)
        .push_static("\"\nurl = \"#item-").push_usize(id as usize).push_static("\"\n")
}

forall 'k.
fn nav_type(&cx: Domain!['k], r: Resolver['k], home: ModuleId['k], out: Buffer!, name: Span['k], id: u32) -> Buffer! {
    var out = nav_record(&cx, out, name, "Types", id);
    let scope = r.scopes.at(&cx, home);
    let owner = match scope.decls.get(&cx, name) {
        Option::Some(d) => d,
        Option::None => return out,
    };
    let keys = r.attached.keys(&cx);
    var k = 0usize;
    while k < keys.len(&cx) {
        let (target, member) = keys.at(&cx, k);
        let matches = match target { Owner::Decl(d) => d.id == owner.id, _ => false };
        if matches {
            let methods = r.attached.at(&cx, (target, member));
            var m = 0usize;
            while m < methods.len(&cx) {
                let decl = methods.at(&cx, m);
                if decl.home.package == home.package {
                    let label = Buffer!::new().push_bytes(&cx, name).push_static("::").push_bytes(&cx, member).save(&cx);
                    out = match decl.node {
                        Named::Fn(f) => nav_record(&cx, out, label, "Types", f.id),
                        Named::Const(c) => nav_record(&cx, out, label, "Types", c.id),
                        _ => out,
                    };
                }
                m = m + 1usize;
            }
        }
        k = k + 1usize;
    }
    out
}

forall 'k.
fn nav_records(&cx: Domain!['k], r: Resolver['k], home: ModuleId['k]) -> Buffer! {
    let scope = r.scopes.at(&cx, home);
    var out = Buffer!::new();
    var count = 0usize;
    var j = 0usize;
    while j < scope.items.len(&cx) {
        match scope.items.at(&cx, j) {
            S::Item::Struct(d) => { out = nav_type(&cx, r, home, out, d.name, d.id); count = count + 1usize; },
            S::Item::Tuple(d) => { out = nav_type(&cx, r, home, out, d.name, d.id); count = count + 1usize; },
            S::Item::Enum(d) => { out = nav_type(&cx, r, home, out, d.name, d.id); count = count + 1usize; },
            S::Item::Trait(d) => { out = nav_record(&cx, out, d.name, "Traits", d.id); count = count + 1usize; },
            S::Item::Fn(d) => { out = nav_record(&cx, out, d.name, "Functions", d.id); count = count + 1usize; },
            S::Item::Const(d) => { out = nav_record(&cx, out, d.name, "Constants", d.id); count = count + 1usize; },
            S::Item::Extern(d) => { out = nav_record(&cx, out, d.name, "Externs", d.id); count = count + 1usize; },
            S::Item::Impl(d) => {
                let owner = match d.type {
                    S::Type::Name(t) => t.path.at(&cx, t.path.len(&cx) - 1usize),
                    _ => lit(&cx, "impl"),
                };
                if !scope.decls.contains(&cx, owner) {
                    var m = 0usize;
                    while m < d.items.len(&cx) {
                        out = match d.items.at(&cx, m) {
                            S::Member::Fn(f) => nav_record(&cx, out, Buffer!::new().push_bytes(&cx, owner).push_static("::").push_bytes(&cx, f.name).save(&cx), "Implementations", f.id),
                            S::Member::Const(c) => nav_record(&cx, out, Buffer!::new().push_bytes(&cx, owner).push_static("::").push_bytes(&cx, c.name).save(&cx), "Implementations", c.id),
                        };
                        count = count + 1usize;
                        m = m + 1usize;
                    }
                }
            },
            _ => (),
        }
        j = j + 1usize;
    }
    if count == 0usize { out = out.push_static("nav_items = []\n"); }
    out
}

forall 'k.
fn page_parents(&cx: Domain!['k], r: Resolver['k], home: ModuleId['k], parent: Span['k]) -> Buffer! {
    var out = Buffer!::new().push_static("parents = [\"").push_bytes(&cx, parent).push_static("\"");
    var p = 0usize;
    while p < r.packages.len(&cx) {
        let package = r.packages.at(&cx, p);
        let modules = package.files.keys(&cx);
        var i = 0usize;
        while i < modules.len(&cx) {
            let source = modules.at(&cx, i);
            if public_module(&cx, r, source) {
                let scope = r.scopes.at(&cx, source);
                let exports = scope.exports.keys(&cx);
                var e = 0usize;
                while e < exports.len(&cx) {
                    let target = r.lookup(&cx, source, ArenaVec::one(&cx, exports.at(&cx, e)), S::Pos.{ line: 0u32, col: 0u32 });
                    match target {
                        Result::Ok(found) => match found {
                            Target::Module(m) => if url(&cx, r, m).eq(&cx, url(&cx, r, home)) {
                                let source_url = url(&cx, r, source);
                                if !source_url.eq(&cx, parent) { out = out.push_static(", \"").push_bytes(&cx, source_url).push_static("\""); }
                            },
                            _ => (),
                        },
                        Result::Err(_) => (),
                    }
                    e = e + 1usize;
                }
            }
            i = i + 1usize;
        }
        p = p + 1usize;
    }
    out.push_static("]\n")
}

forall 'k.
fn page(&cx: Domain!['k], r: Resolver['k], home: ModuleId['k], root: Span['k]) {
    let package = r.packages.at(&cx, home.package);
    let module_name = if home.path.is_empty(&cx) { package.name.copy(&cx) }
        else { Buffer!::new().push_bytes(&cx, package.name.copy(&cx)).push_static("::").push_bytes(&cx, home.path.join(&cx, "::")).save(&cx) };
    let file = package.files.at(&cx, home);
    let source = match read_to_arena(&cx, file) {
        Result::Ok(bytes) => bytes,
        Result::Err(_) => package::support::base::fail(&cx, Buffer!::new().push_static("cannot read ").push_bytes(&cx, file).save(&cx)),
    };
    var folder = path(&cx, path(&cx, root, lit(&cx, "src")), package.name.copy(&cx));
    var i = 0usize;
    while i < home.path.len(&cx) {
        folder = path(&cx, folder, home.path.at(&cx, i));
        directory(&cx, folder);
        i = i + 1usize;
    }
    let parent = if home.path.is_empty(&cx) { lit(&cx, "/") }
        else { url(&cx, r, ModuleId.{ package: home.package, path: home.path.slice(&cx, 0usize, home.path.len(&cx) - 1usize) }) };
    let short_name = if home.path.is_empty(&cx) { package.name.copy(&cx) }
        else { home.path.at(&cx, home.path.len(&cx) - 1usize) };
    var out = Buffer!::new().push_static("+++\nlayout = \"module.html\"\ntitle = \"").push_bytes(&cx, module_name)
        .push_static("\"\nnav_title = \"").push_bytes(&cx, short_name)
        .push_static("\"\nparent = \"").push_bytes(&cx, parent).push_static("\"\n")
        .push_buffer(page_parents(&cx, r, home, parent)).push_buffer(nav_records(&cx, r, home))
        .push_static("+++\n# ").push_bytes(&cx, module_name).push_static("\n\n");
    out = out.push_buffer(module_prose(&cx, source));
    let relative = if file.starts_with(&cx, package.root) && file.len() > package.root.len() + 1usize {
        file.slice(package.root.len() + 1usize, file.len())
    } else { file };
    out = out.push_static("Source: `").push_bytes(&cx, relative).push_static("`\n\n");
    let scope = r.scopes.at(&cx, home);
    let exports = scope.exports.keys(&cx);
    if !exports.is_empty(&cx) {
        out = out.push_static("## Re-exports\n\n");
        var e = 0usize;
        while e < exports.len(&cx) {
            let name = exports.at(&cx, e);
            let target = r.lookup(&cx, home, ArenaVec::one(&cx, name), S::Pos.{ line: 0u32, col: 0u32 });
            out = match target {
                Result::Ok(found) => match found {
                    Target::Module(m) => out.push_static("- [`").push_bytes(&cx, name).push_static("`](").push_bytes(&cx, url(&cx, r, m)).push_static(")\n"),
                    Target::Decl(d) => out.push_static("- [`").push_bytes(&cx, name).push_static("`](").push_bytes(&cx, url(&cx, r, d.home)).push_static(")\n"),
                    _ => out.push_static("- `").push_bytes(&cx, name).push_static("`\n"),
                },
                Result::Err(_) => out.push_static("- `").push_bytes(&cx, name).push_static("`\n"),
            };
            e = e + 1usize;
        }
        out = out.push_static("\n");
    }
    out = out.push_static("## Declarations\n\n");
    var j = 0usize;
    while j < scope.items.len(&cx) {
        out = item(&cx, r, home, out, source, scope.items.at(&cx, j));
        j = j + 1usize;
    }
    save(&cx, path(&cx, folder, lit(&cx, "index.md")), out);
}

forall 'k.
fn generate(&cx: Domain!['k], r: Resolver['k], output: Span['k]) {
    let present = match path_exists(&cx, output) {
        Result::Ok(found) => found,
        Result::Err(_) => package::support::base::fail(&cx, lit(&cx, "cannot inspect documentation output")),
    };
    if present { package::support::base::fail(&cx, lit(&cx, "documentation output already exists; choose a new -o path")); }
    directory(&cx, output);
    let source = path(&cx, output, lit(&cx, "src"));
    directory(&cx, source);
    let includes = path(&cx, source, lit(&cx, "_includes"));
    directory(&cx, includes);
    let assets = path(&cx, source, lit(&cx, "assets"));
    directory(&cx, assets);
    save(&cx, path(&cx, output, lit(&cx, "krayon.toml")), Buffer!::new().push_static("input = \"src\"\noutput = \"dist\"\nlayouts = \"_includes\"\nassets = \"assets\"\nbase_path = \"\"\n"));
    save(&cx, path(&cx, includes, lit(&cx, "page.html")), Buffer!::new()
        .push_static("<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>{{ page.title }} · Kursal Docs</title>\n<script>try{var theme=localStorage.getItem('kursal-doc-theme');if(theme==='light'||theme==='dark')document.documentElement.setAttribute('data-theme',theme)}catch(e){}</script>\n<link rel=\"stylesheet\" href=\"{{ \"/assets/site.css\" | url }}\">\n<script defer src=\"{{ \"/assets/theme.js\" | url }}\"></script>\n</head>\n<body>\n<header class=\"masthead\"><div class=\"masthead-inner\"><a class=\"brand\" href=\"{{ \"/\" | url }}\"><span class=\"brand-mark\">K</span> Kursal <span class=\"brand-sub\">Docs</span></a><div class=\"header-actions\"><span class=\"header-kicker\">API Reference</span><button class=\"theme-toggle\" type=\"button\" data-next=\"dark\" aria-label=\"Switch to dark mode\" title=\"Switch to dark mode\"><svg class=\"theme-icon icon-moon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M20.5 14.1A8.7 8.7 0 0 1 9.9 3.5 8.8 8.8 0 1 0 20.5 14.1Z\"/></svg><svg class=\"theme-icon icon-sun\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"4\"/><path d=\"M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42\"/></svg></button></div></div></header>\n{{ content | safe }}\n</body>\n</html>\n"));
