        .push_static(".landing li a:hover { background: var(--landing-hover); }\n")
        .push_static("main h2 { font-size: 1.35rem; margin: 2rem 0 1rem; padding-top: 1.1rem; border-top: 1px solid var(--line); }\n")
        .push_static(".item-heading { display: flex; align-items: baseline; flex-wrap: wrap; gap: .65rem; margin: 1.6rem 0 .55rem; font-size: 1.12rem; line-height: 1.4; }\n")
        .push_static(".item-heading { font-family: var(--code-font); }\n")
        .push_static(".item-heading::before { display: inline-block; border-radius: .3rem; padding: .12rem .5rem; margin-right: .65rem; font: 800 .69rem/1.5 system-ui, sans-serif; letter-spacing: .045em; text-transform: uppercase; white-space: nowrap; }\n")
        .push_static(".kind-struct::before { content: 'struct'; }.kind-tuple::before { content: 'tuple'; }.kind-enum::before { content: 'enum'; }.kind-trait::before { content: 'trait'; }.kind-fn::before { content: 'fn'; }.kind-method::before { content: 'method'; }.kind-const::before { content: 'const'; }.kind-extern::before { content: 'extern'; }\n")
        .push_static(".kind-struct::before, .kind-tuple::before { color: var(--struct-ink); background: var(--struct-bg); }.kind-enum::before { color: var(--enum-ink); background: var(--enum-bg); }\n")
        .push_static(".kind-trait::before { color: var(--trait-ink); background: var(--trait-bg); }.kind-fn::before { color: var(--fn-ink); background: var(--fn-bg); }\n")
