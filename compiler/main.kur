// The command line: `kursalc parse FILE...` prints each file's syntax tree; `kursalc resolve PATH`
// resolves the package at PATH (a directory, its kur.toml, or one .kur file) and prints what every
// name names; `kursalc selftest-types CASE...` runs the type modules on small cases (see `selftest`).
// `kursalc kurs FILE` reads serialized KURS and prints it as `kurs::write_program` writes it.
// `kursalc sigs PATH` resolves the package at PATH, builds its signatures and prints them (see
// `sigdump`). `kursalc infer PATH` also infers every function body and prints what it found (see
// `inferdump`).
// `kursalc check FILE` reads serialized KURS and checks it, printing nothing when it is sound;
// `kursalc c FILE [--entry NAME]` also prints its C, entered from C's `main` through the function
// NAME; `kursalc readable FILE` prints it as readable KURS.

use package::base::{Cell, Out, Seq, Text, fail, stop, text};
use package::cgen::emit_c;
use package::check::check_program;
use package::dump;
use package::infer::infer;
use package::inferdump;
use package::kurs;
use package::parser::parse;
use package::readable::emit_kurs;
use package::resolve::resolve;
use package::resolved;
use package::selftest::selftest_types;
use package::sigdump;
use package::sigs::signatures;
use package::system::{arguments, read};
use package::types::Fresh;
use std::option::Option;

fn main(argc: i32, argv: *(*u8)) -> i32 {
    let args = arguments(argc, argv);
    if args.is_empty() {
        fail(text("usage: kursalc parse FILE... | kursalc resolve PATH | kursalc sigs PATH | kursalc infer PATH | kursalc kurs FILE | kursalc check FILE | kursalc c FILE [--entry NAME] | kursalc readable FILE"));
    }
    let command = args.get(0usize);
    if command.is("parse") {
        let ids = Cell::new(0u32);
        var i = 1usize;
        while i < args.len() {
            let file = args.get(i);
            let source = match read(file) {
                Option::Some(s) => s,
                Option::None => fail(Out::new().put("cannot read ").add(file).done()),
            };
            Out::new().put("== ").add(file).put("\n").done().print(1);
            dump::items(parse(source, file, ids)).print(1);
            i = i + 1usize;
        }
        0
    } else if command.is("selftest-types") {
        selftest_types(args.from(1usize));
        0
    } else if command.is("resolve") && args.len() == 2usize {
        resolved::program(resolve(args.get(1usize))).print(1);
        0
    } else if command.is("sigs") && args.len() == 2usize {
        sigdump::program(signatures(resolve(args.get(1usize)), Fresh::new())).print(1);
        0
    } else if command.is("infer") && args.len() == 2usize {
        let counter = Fresh::new();
        let r = resolve(args.get(1usize));
        inferdump::program(infer(r, signatures(r, counter), counter)).print(1);
        0
    } else if command.is("kurs") && args.len() == 2usize {
        let file = args.get(1usize);
        let source = match read(file) {
            Option::Some(s) => s,
            Option::None => fail(Out::new().put("cannot read ").add(file).done()),
        };
        kurs::write_program(kurs::parse_program(source)).print(1);
        0
    } else if command.is("check") && args.len() == 2usize {
        let unit = check_program(kurs::parse_program(read_file(args.get(1usize))), Fresh::new());
        0
    } else if command.is("c") {
        var file: Option[Text] = Option::None;
        var entry: Option[Text] = Option::None;
        var i = 1usize;
        while i < args.len() {
            if args.get(i).is("--entry") && i + 1usize < args.len() {
                entry = Option::Some.(args.get(i + 1usize));
                i = i + 2usize;
            } else if file.is_none() {
                file = Option::Some.(args.get(i));
                i = i + 1usize;
            } else {
                fail(text("usage: kursalc c FILE [--entry NAME]"));
            }
        }
        let path = match file {
            Option::Some(f) => f,
            Option::None => fail(text("usage: kursalc c FILE [--entry NAME]")),
        };
        let counter = Fresh::new();
        let program = kurs::parse_program(read_file(path));
        emit_c(program, check_program(program, counter), entry, counter).print(1);
        0
    } else if command.is("readable") && args.len() == 2usize {
        emit_kurs(kurs::parse_program(read_file(args.get(1usize))), Fresh::new()).print(1);
        0
    } else {
        fail(Out::new().put("unknown command ").add(command).done())
    }
}

fn read_file(file: Text) -> Text {
    match read(file) {
        Option::Some(s) => s,
        Option::None => fail(Out::new().put("cannot read ").add(file).done()),
    }
}
