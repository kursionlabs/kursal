// The command line: `kursal parse FILE...` prints each file's syntax tree; `kursal resolve PATH`
// resolves the package at PATH (a directory, its kur.toml, or one .kur file) and prints what every
// name names; `kursal selftest-types CASE...` runs the type modules on small cases (see `types::selftest`).
// `kursal kurs FILE` reads serialized KURS and prints it as `kurs::serial::write_program` writes it.
// `kursal sigs PATH` resolves the package at PATH, builds its signatures and prints them (see
// `sigs::dump`). `kursal infer PATH` also infers every function body and prints what it found (see
// `infer::dump`).
// `kursal check FILE` reads serialized KURS and checks it, printing nothing when it is sound;
// `kursal c FILE [--entry NAME]` also prints its C, entered from C's `main` through the function
// NAME; `kursal readable FILE` prints it as readable KURS.
// `kursal lower PATH` lowers the package at PATH to core and prints it as KURS. `kursal build PATH
// [-o OUTPUT] [--times]` runs the whole pipeline: it lowers and checks the package and makes its C,
// entered through the package's entry (every root function's C for a library); with OUTPUT, it
// writes OUTPUT.c and compiles it with the standard library's C helpers into OUTPUT, else it prints
// the C. With --times it prints the time each stage takes, as `tools/build.py --times` does.
//
// Each group of phases keeps what it builds in an arena of its own: the front end (the command
// line, parsing, resolving, signatures, inference and lowering, or reading KURS), the core
// (checking) and the back end (C). A group hands the next one only what it needs, copied into the
// next arena: the core program, the counter of fresh names, and for the back end the types the
// checker recorded; then its own arena is destroyed. Each arena is opened once, here in `main`, so
// the code of every phase is made once, for the brand of the group it runs in. A command that
// fails stops the process from inside, leaving its arenas to the operating system.

use package::support::base::{Cell, Cx, Map, Out, Seq, Text, fail, text};
use package::backend::cgen::emit_c;
use package::check::checker::{FunKey, check_program, copy_typed};
use package::syntax::dump as syntax_dump;
use package::infer::inference::infer;
use package::infer::dump as infer_dump;
use package::kurs::core::{Program, Type};
use package::kurs::serial::{parse_program, write_program};
use package::lower::lowering::lower;
use package::syntax::parser::parse;
use package::kurs::readable::emit_kurs;
use package::kurs::transfer::{copy_option_text, copy_program};
use package::resolve::resolver::{lib_dir, resolve};
use package::resolve::dump as resolve_dump;
use package::types::selftest::selftest_types;
use package::sigs::dump as sigs_dump;
use package::sigs::signatures::signatures;
use package::support::system::{arguments, command_line, read, run, write};
use package::types::ops::{Fresh, carry_fresh};
use std::bytes::buffer::Buffer;
use std::io::print_buffer;
use std::option::Option;
use std::slice::Slice;
use std::time::Instant;

// What the core and the back end are asked to do.
exposed enum Goal {
    // `kursal check FILE`
    Check,
    // `kursal c FILE [--entry NAME]`
    C,
    // `kursal build PATH [-o OUTPUT] [--times]`
    Build,
}

// What one group of phases hands the next: the core program and the rest of the request.
forall 'k.
exposed struct Handoff {
    goal: Goal,
    program: Program['k],
    counter: Fresh['k],
    // the function C's `main` enters through
    entry: Option[Text['k]],
    // `build`'s OUTPUT
    output: Option[Text['k]],
    times: bool,
    // when the current stage started
    started: Instant,
}

// `handoff` copied from the arena of `from` into that of `to`.
forall 'a, 'b.
fn carry(&from: Cx!['a], &to: Cx!['b], handoff: Handoff['a]) -> Handoff['b] {
    Handoff.{ goal: handoff.goal, program: copy_program(&from, &to, handoff.program), counter: carry_fresh(&from, &to, handoff.counter),
        entry: copy_option_text(&from, &to, handoff.entry), output: copy_option_text(&from, &to, handoff.output), times: handoff.times,
        started: handoff.started }
}

fn main() -> i32 {
    let exists 'f. front = Cx::new();
    var front = front;
    let handoff = match front_end(&front) {
        Option::Some(h) => h,
        Option::None => {
            front.destroy();
            return 0;
        },
    };
    let exists 'c. core = Cx::new();
    var core = core;
    let checked = carry(&front, &core, handoff);
    front.destroy();
    let checker = check_program(&core, checked.program, checked.counter);
    let started = stage(checked.times, "check", checked.started);
    let unit = match checked.goal {
        Goal::Check => {
            core.destroy();
            return 0;
        },
        _ => (),
    };
    let exists 'b. back = Cx::new();
    var back = back;
    let emitted = carry(&core, &back, Handoff.{ goal: checked.goal, program: checked.program, counter: checked.counter, entry: checked.entry,
        output: checked.output, times: checked.times, started });
    let typed = copy_typed(&core, &back, checker.typed);
    core.destroy();
    back_end(back, emitted, typed)
}

// The front end of every command, in the arena of `cx`: a command that only the front end does is
// done, and gives nothing; `check`, `c` and `build` give what the core needs.
forall 'k.
fn front_end(&cx: Cx!['k]) -> Option[Handoff['k]] {
    let args = arguments(&cx);
    if args.is_empty(&cx) {
        fail(&cx, text(&cx, "usage: kursal parse FILE... | kursal resolve PATH | kursal sigs PATH | kursal infer PATH | kursal kurs FILE | kursal check FILE | kursal c FILE [--entry NAME] | kursal readable FILE | kursal lower PATH | kursal build PATH [-o OUTPUT] [--times]"));
    }
    let command = args.get(&cx, 0usize);
    if command.is(&cx, "parse") {
        let ids = Cell::new(&cx, 0u32);
        var i = 1usize;
        while i < args.len(&cx) {
            let file = args.get(&cx, i);
            let source = match read(&cx, file) {
                Option::Some(s) => s,
                Option::None => fail(&cx, Out::new(&cx).put(&cx, "cannot read ").add(&cx, file).done(&cx)),
            };
            Out::new(&cx).put(&cx, "== ").add(&cx, file).put(&cx, "\n").done(&cx).print(&cx, 1);
            syntax_dump::items(&cx, parse(&cx, source, file, ids)).print(&cx, 1);
            i = i + 1usize;
        }
        Option::None
    } else if command.is(&cx, "selftest-types") {
        selftest_types(&cx, args.from(&cx, 1usize));
        Option::None
    } else if command.is(&cx, "resolve") && args.len(&cx) == 2usize {
        resolve_dump::program(&cx, resolve(&cx, args.get(&cx, 1usize))).print(&cx, 1);
        Option::None
    } else if command.is(&cx, "sigs") && args.len(&cx) == 2usize {
        sigs_dump::program(&cx, signatures(&cx, resolve(&cx, args.get(&cx, 1usize)), Fresh::new(&cx))).print(&cx, 1);
        Option::None
    } else if command.is(&cx, "infer") && args.len(&cx) == 2usize {
        let counter = Fresh::new(&cx);
        let r = resolve(&cx, args.get(&cx, 1usize));
        infer_dump::program(&cx, infer(&cx, r, signatures(&cx, r, counter), counter)).print(&cx, 1);
        Option::None
    } else if command.is(&cx, "kurs") && args.len(&cx) == 2usize {
        write_program(&cx, parse_program(&cx, read_file(&cx, args.get(&cx, 1usize)))).print(&cx, 1);
        Option::None
    } else if command.is(&cx, "check") && args.len(&cx) == 2usize {
        Option::Some.(Handoff.{ goal: Goal::Check, program: parse_program(&cx, read_file(&cx, args.get(&cx, 1usize))), counter: Fresh::new(&cx),
            entry: Option::None, output: Option::None, times: false, started: Instant::now() })
    } else if command.is(&cx, "c") {
        var file: Option[Text['k]] = Option::None;
        var entry: Option[Text['k]] = Option::None;
        var i = 1usize;
        while i < args.len(&cx) {
            if args.get(&cx, i).is(&cx, "--entry") && i + 1usize < args.len(&cx) {
                entry = Option::Some.(args.get(&cx, i + 1usize));
                i = i + 2usize;
            } else if file.is_none() {
                file = Option::Some.(args.get(&cx, i));
                i = i + 1usize;
            } else {
                fail(&cx, text(&cx, "usage: kursal c FILE [--entry NAME]"));
            }
        }
        let path = match file {
            Option::Some(f) => f,
            Option::None => fail(&cx, text(&cx, "usage: kursal c FILE [--entry NAME]")),
        };
        Option::Some.(Handoff.{ goal: Goal::C, program: parse_program(&cx, read_file(&cx, path)), counter: Fresh::new(&cx),
            entry, output: Option::None, times: false, started: Instant::now() })
    } else if command.is(&cx, "lower") && args.len(&cx) == 2usize {
        let counter = Fresh::new(&cx);
        let r = resolve(&cx, args.get(&cx, 1usize));
        write_program(&cx, lower(&cx, r, signatures(&cx, r, counter), counter)).print(&cx, 1);
        Option::None
    } else if command.is(&cx, "build") {
        Option::Some.(build(&cx, args.from(&cx, 1usize)))
    } else if command.is(&cx, "readable") && args.len(&cx) == 2usize {
        emit_kurs(&cx, parse_program(&cx, read_file(&cx, args.get(&cx, 1usize))), Fresh::new(&cx)).print(&cx, 1);
        Option::None
    } else {
        fail(&cx, Out::new(&cx).put(&cx, "unknown command ").add(&cx, command).done(&cx))
    }
}

forall 'k.
fn read_file(&cx: Cx!['k], file: Text['k]) -> Text['k] {
    match read(&cx, file) {
        Option::Some(s) => s,
        Option::None => fail(&cx, Out::new(&cx).put(&cx, "cannot read ").add(&cx, file).done(&cx)),
    }
}

// The time since `started` as `NAME: 1.5s` on stderr, when `times`; the time now.
fn stage(times: bool, name: Slice[u8, 'static], started: Instant) -> Instant {
    let now = Instant::now();
    if times {
        let ms = started.millis_until(now);
        print_buffer(2i32, Buffer::new().push_static(name).push_static(": ").push_usize((ms / 1000u64) as usize).push_static(".")
            .push_usize((ms % 1000u64 / 100u64) as usize).push_static("s\n"));
    }
    now
}

// The front end of `kursal build PATH [-o OUTPUT] [--times]`: the package resolved, its
// signatures built, and its bodies inferred and lowered.
forall 'k.
fn build(&cx: Cx!['k], args: Seq[Text['k], 'k]) -> Handoff['k] {
    var path: Option[Text['k]] = Option::None;
    var output: Option[Text['k]] = Option::None;
    var times = false;
    var i = 0usize;
    while i < args.len(&cx) {
        if args.get(&cx, i).is(&cx, "--times") {
            times = true;
            i = i + 1usize;
        } else if args.get(&cx, i).is(&cx, "-o") && i + 1usize < args.len(&cx) && output.is_none() {
            output = Option::Some.(args.get(&cx, i + 1usize));
            i = i + 2usize;
        } else if path.is_none() {
            path = Option::Some.(args.get(&cx, i));
            i = i + 1usize;
        } else {
            fail(&cx, text(&cx, "usage: kursal build PATH [-o OUTPUT] [--times]"));
        }
    }
    let package = match path {
        Option::Some(p) => p,
        Option::None => fail(&cx, text(&cx, "usage: kursal build PATH [-o OUTPUT] [--times]")),
    };
    var started = Instant::now();
    let counter = Fresh::new(&cx);
    let r = resolve(&cx, package);
    let sigs = signatures(&cx, r, counter);
    started = stage(times, "signatures", started);
    let program = lower(&cx, r, sigs, counter);
    started = stage(times, "lower", started);
    let entry = match r.packages.get(&cx, 0usize).entry_decl.get(&cx) {
        Option::Some(decl) => Option::Some.(sigs.name(&cx, decl)),
        Option::None => Option::None,
    };
    Handoff.{ goal: Goal::Build, program, counter, entry, output, times, started }
}

// The back end, in the arena `cx`, which it destroys: the C of `handoff`'s program, printed or,
// for `build` with OUTPUT, written to OUTPUT.c and compiled into OUTPUT with the standard
// library's C helpers. The command's exit status.
forall 'k.
fn back_end(cx: Cx!['k], handoff: Handoff['k], typed: Map[FunKey['k], Map[(Text['k], Text['k]), Type['k], 'k], 'k]) -> i32 {
    var cx = cx;
    let c_text = emit_c(&cx, handoff.program, typed, handoff.entry, handoff.counter);
    let started = stage(handoff.times, "C", handoff.started);
    let out = match handoff.output {
        Option::Some(o) => o,
        Option::None => {
            c_text.print(&cx, 1);
            cx.destroy();
            return 0;
        },
    };
    let c_file = Out::new(&cx).add(&cx, out).put(&cx, ".c").done(&cx);
    if !write(&cx, c_file, c_text) {
        fail(&cx, Out::new(&cx).put(&cx, "cannot write ").add(&cx, c_file).done(&cx));
    }
    let lib = lib_dir(&cx);
    let command: Seq[Text['k], 'k] = Seq::new(&cx);
    command.push(&cx, text(&cx, "cc"));
    command.push(&cx, text(&cx, "-O2"));
    command.push(&cx, text(&cx, "-w"));
    command.push(&cx, text(&cx, "-fno-builtin"));
    command.push(&cx, c_file);
    command.push(&cx, Out::new(&cx).add(&cx, lib).put(&cx, "/libc/fs.c").done(&cx));
    command.push(&cx, Out::new(&cx).add(&cx, lib).put(&cx, "/libc/thread.c").done(&cx));
    command.push(&cx, text(&cx, "-lpthread"));
    command.push(&cx, text(&cx, "-o"));
    command.push(&cx, out);
    // Only the command line outlives the arena while `cc` runs.
    let line = command_line(&cx, command);
    cx.destroy();
    let built = run(line);
    let finished = stage(handoff.times, "cc", started);
    if built { 0i32 } else { 1i32 }
}
