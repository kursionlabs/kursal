// The command line: `kursal parse FILE...` prints each file's syntax tree; `kursal resolve PATH`
// resolves the package at PATH (a directory, its kur.toml, or one .kur file) and prints what every
// name names; `kursal selftest-types CASE...` runs the type modules on small cases (see `types::selftest`).
// `kursal kurs FILE` reads serialized KURS and prints it as `kurs::serial::write_program` writes it.
// `kursal sigs PATH` resolves the package at PATH, builds its signatures and prints them (see
// `sigs::dump`). `kursal infer PATH` also infers every function body and prints what it found (see
// `infer::dump`).
// `kursal check FILE` reads serialized KURS and checks it, printing nothing when it is sound;
// `kursal c FILE [--entry NAME]` also prints its C, entered from C's `main` through the function
// NAME; `kursal readable FILE` prints it as readable KURS.
// `kursal lower PATH` lowers the package at PATH to core and prints it as KURS. `kursal build PATH
// [-o OUTPUT] [--emit-c] [--single-c] [--times]` runs the whole pipeline. It compiles an executable
// to OUTPUT (default a.out), or prints generated C with --emit-c. With --times it prints timings
// for each stage, including the copies and arena releases between them. With Clang or GCC, the C is
// split into a file per module in OUTPUT.build, compiled in parallel, `$KURSAL_JOBS` files at once
// or else one per processor, and linked with link-time optimization; --single-c writes it as one
// file, OUTPUT.c, compiled whole, which builds slower and runs a little faster.
// `kursal doc PATH -o SITE` writes a Krayon documentation site from resolved source.
//
// Each group of phases keeps what it builds in an arena of its own: the front end (the command
// line, parsing, resolving, signatures, inference and lowering, or reading KURS), the core
// (checking) and the back end (C). A group hands the next one only what it needs, copied into the
// next arena: the core program, the counter of fresh names, and for the back end the types the
// checker recorded; then its own arena is destroyed. Each arena is opened once, here in `main`, so
// the code of every phase is made once, for the brand of the group it runs in. A command that
// fails stops the process from inside, leaving its arenas to the operating system.

use package::support::base::{emit, emit_buffer, fail};
use std::collections::arena_vec::ArenaVec;
use std::collections::arena_map::{ArenaMap, ArenaSet};
use std::mem::Ref;
use std::raw::Span;
use std::alloc::arena::Domain!;
use package::backend::cgen::{CText!, emit_c};
use package::check::checker::{FunKey, check_program, copy_typed};
use package::syntax::dump as syntax_dump;
use package::infer::inference::infer;
use package::infer::dump as infer_dump;
use package::kurs::core::{Program, Type};
use package::kurs::serial::{parse_program, write_program};
use package::lower::lowering::{lower, lower_inferred};
use package::syntax::parser::parse;
use package::kurs::readable::emit_kurs;
use package::kurs::transfer::{copy_option_text, copy_program, copy_texts};
use package::resolve::resolver::{lib_dir, resolve};
use package::doc::generator::generate;
use package::resolve::dump as resolve_dump;
use package::types::selftest::selftest_types;
use package::sigs::dump as sigs_dump;
use package::sigs::signatures::signatures;
use std::env::variable;
use std::fs::{mkdir, read_dir, read_to_arena, remove, write};
use package::types::ops::{Fresh, carry_fresh};
use std::bytes::buffer::Buffer!;
use std::io::eprint_buffer;
use std::option::{Option, Result};
use std::process::{Args, Child!, Command!, Exit, Polled!, available_parallelism};
use std::collections::vec::{OwnedVec!, Popped!};
use std::cmp::Order;
use std::io::Error;
use std::slice::Slice;
use std::time::{Duration, Instant, sleep};
use std::parse::parse_usize;

// What the core and the back end are asked to do.
exposed enum Goal {
    // `kursal check FILE`
    Check,
    // `kursal c FILE [--entry NAME]`
    C,
    // `kursal build PATH [-o OUTPUT] [--emit-c] [--single-c] [--times]`
    Build,
}

// What one group of phases hands the next: the core program and the rest of the request.
forall 'k.
exposed struct Handoff {
    goal: Goal,
    program: Program['k],
    counter: Fresh['k],
    // the function C's `main` enters through
    entry: Option[Span['k]],
    // `build`'s OUTPUT
    output: Option[Span['k]],
    link_flags: ArenaVec[Span['k], 'k],
    c_sources: ArenaVec[Span['k], 'k],
    // `build --single-c`
    single_c: bool,
    times: bool,
    // when the current stage started
    started: Instant,
}

// `handoff` copied from the arena of `from` into that of `to`.
forall 'a, 'b.
fn carry(&from: Domain!['a], &to: Domain!['b], handoff: Handoff['a]) -> Handoff['b] {
    Handoff.{ goal: handoff.goal, program: copy_program(&from, &to, handoff.program), counter: carry_fresh(&from, &to, handoff.counter),
        entry: copy_option_text(&from, &to, handoff.entry), output: copy_option_text(&from, &to, handoff.output),
        link_flags: copy_texts(&from, &to, handoff.link_flags), c_sources: copy_texts(&from, &to, handoff.c_sources), single_c: handoff.single_c,
        times: handoff.times, started: handoff.started }
}

fn main(args: Args) -> i32 {
    let exists 'f. front = Domain!::new();
    var front = front;
    let handoff = match front_end(&front, args) {
        Option::Some(h) => h,
        Option::None => {
            front.destroy();
            return 0;
        },
    };
    let exists 'c. core = Domain!::new();
    var core = core;
    let times = handoff.times;
    var started = handoff.started;
    let checked = carry(&front, &core, handoff);
    started = stage(times, "front copy", started);
    front.destroy();
    started = stage(times, "front free", started);
    let checker = check_program(&core, checked.program, checked.counter);
    started = stage(times, "check", started);
    let unit = match checked.goal {
        Goal::Check => {
            core.destroy();
            return 0;
        },
        _ => (),
    };
    let exists 'b. back = Domain!::new();
    var back = back;
    let emitted = carry(&core, &back, Handoff.{ goal: checked.goal, program: checked.program, counter: checked.counter, entry: checked.entry,
        output: checked.output, link_flags: checked.link_flags, c_sources: checked.c_sources, single_c: checked.single_c, times: checked.times, started });
    started = stage(times, "back copy", started);
    let typed = copy_typed(&core, &back, checker.typed);
    started = stage(times, "typed copy", started);
    core.destroy();
    started = stage(times, "core free", started);
    back_end(back, emitted, typed, started)
}

// The front end of every command, in the arena of `cx`: a command that only the front end does is
// done, and gives nothing; `check`, `c` and `build` give what the core needs.
forall 'k.
fn front_end(&cx: Domain!['k], process_args: Args) -> Option[Handoff['k]] {
    // The arguments after the program's own name, viewed where C's `main` received them.
    let args: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
    var a = 1usize;
    while a < process_args.len() {
        match process_args.bytes(a) {
            Option::Some(arg) => args.push(&cx, Span::from_static(&cx, arg)),
            Option::None => (),
        }
        a = a + 1usize;
    }
    if args.is_empty(&cx) {
        emit_buffer(Buffer!::new().push_static("Kursal compiler\n\nUse: kursal build PATH [-o OUTPUT] [--emit-c] [--times]\n     kursal COMMAND --help\n\nRun kursal --help for commands.\n"));
        return Option::None;
    }
    let command = args.at(&cx, 0usize);
    if command.is(&cx, "--help") || command.is(&cx, "-h") || command.is(&cx, "help") {
        emit_buffer(Buffer!::new().push_static("Kursal compiler\n\nUsage: kursal COMMAND [ARGS]\n\nCommands:\n  build PATH [-o OUTPUT] [--emit-c] [--single-c] [--times]  Build an executable (a.out by default)\n  doc PATH -o SITE    Generate a Krayon documentation site\n  parse FILE...       Print syntax trees\n  resolve PATH        Print name resolution\n  sigs PATH           Print signatures\n  infer PATH          Print inferred types\n  lower PATH          Print lowered KURS\n  kurs FILE           Read and print KURS\n  check FILE          Check KURS\n  c FILE [--entry NAME]  Generate C from KURS\n  readable FILE       Print readable KURS\n\nUse kursal COMMAND --help for command details.\n"));
        return Option::None;
    }
    if command.is(&cx, "--version") || command.is(&cx, "-V") {
        emit_buffer(Buffer!::new().push_static("kursal 0.1.0\n"));
        return Option::None;
    }
    if args.len(&cx) == 2usize && (args.at(&cx, 1usize).is(&cx, "--help") || args.at(&cx, 1usize).is(&cx, "-h")) {
        if command.is(&cx, "build") {
            emit_buffer(Buffer!::new().push_static("Usage: kursal build PATH [-o OUTPUT] [--emit-c] [--single-c] [--times]\n\nBuild an executable at OUTPUT (default: a.out). --emit-c prints generated C instead.\nPATH is a package directory, kur.toml, or a .kur file. --times prints stage timings to stderr.\nWith Clang or GCC the C goes to OUTPUT.build, a file per module, compiled in parallel and\nlinked with link-time optimization; --single-c compiles it as one file, OUTPUT.c.\n"));
        } else if command.is(&cx, "doc") {
            emit_buffer(Buffer!::new().push_static("Usage: kursal doc PATH -o SITE\n\nGenerate a Krayon site for the public modules of PATH. SITE must not exist. Then run `krayon build SITE`.\n"));
        } else if command.is(&cx, "c") {
            emit_buffer(Buffer!::new().push_static("Usage: kursal c FILE [--entry NAME]\n\nGenerate C from serialized KURS.\n"));
        } else if command.is(&cx, "parse") {
            emit_buffer(Buffer!::new().push_static("Usage: kursal parse FILE...\n\nPrint the syntax tree of each source file.\n"));
        } else if command.is(&cx, "resolve") {
            emit_buffer(Buffer!::new().push_static("Usage: kursal resolve PATH\n\nPrint what each name in a package resolves to.\n"));
        } else if command.is(&cx, "sigs") {
            emit_buffer(Buffer!::new().push_static("Usage: kursal sigs PATH\n\nPrint package signatures.\n"));
        } else if command.is(&cx, "infer") {
            emit_buffer(Buffer!::new().push_static("Usage: kursal infer PATH\n\nPrint inferred function bodies.\n"));
        } else if command.is(&cx, "lower") {
            emit_buffer(Buffer!::new().push_static("Usage: kursal lower PATH\n\nPrint a package as serialized KURS.\n"));
        } else if command.is(&cx, "kurs") {
            emit_buffer(Buffer!::new().push_static("Usage: kursal kurs FILE\n\nRead and print serialized KURS.\n"));
        } else if command.is(&cx, "check") {
            emit_buffer(Buffer!::new().push_static("Usage: kursal check FILE\n\nCheck serialized KURS.\n"));
        } else if command.is(&cx, "readable") {
            emit_buffer(Buffer!::new().push_static("Usage: kursal readable FILE\n\nPrint readable KURS.\n"));
        } else {
            fail(&cx, Buffer!::new().push_static("unknown command ").push_bytes(&cx, command).save(&cx));
        }
        return Option::None;
    }
    if command.is(&cx, "parse") {
        let ids = Ref::new(&cx, 0u32);
        var i = 1usize;
        while i < args.len(&cx) {
            let file = args.at(&cx, i);
            let source = read_file(&cx, file);
            emit_buffer(Buffer!::new().push_static("== ").push_bytes(&cx, file).push_static("\n"));
            emit(&cx, syntax_dump::items(&cx, parse(&cx, source, file, ids)));
            i = i + 1usize;
        }
        Option::None
    } else if command.is(&cx, "selftest-types") {
        selftest_types(&cx, args.skip(&cx, 1usize));
        Option::None
    } else if command.is(&cx, "resolve") && args.len(&cx) == 2usize {
        emit(&cx, resolve_dump::program(&cx, resolve(&cx, args.at(&cx, 1usize))));
        Option::None
    } else if command.is(&cx, "sigs") && args.len(&cx) == 2usize {
        emit(&cx, sigs_dump::program(&cx, signatures(&cx, resolve(&cx, args.at(&cx, 1usize)), Fresh::new(&cx))));
        Option::None
    } else if command.is(&cx, "infer") && args.len(&cx) == 2usize {
        let counter = Fresh::new(&cx);
        let r = resolve(&cx, args.at(&cx, 1usize));
        emit(&cx, infer_dump::program(&cx, infer(&cx, r, signatures(&cx, r, counter), counter)));
        Option::None
    } else if command.is(&cx, "kurs") && args.len(&cx) == 2usize {
        emit(&cx, write_program(&cx, parse_program(&cx, read_file(&cx, args.at(&cx, 1usize)))));
        Option::None
    } else if command.is(&cx, "check") && args.len(&cx) == 2usize {
        Option::Some.(Handoff.{ goal: Goal::Check, program: parse_program(&cx, read_file(&cx, args.at(&cx, 1usize))), counter: Fresh::new(&cx),
            entry: Option::None, output: Option::None, link_flags: ArenaVec::new(&cx), c_sources: ArenaVec::new(&cx), single_c: true, times: false, started: Instant::now() })
    } else if command.is(&cx, "c") {
        var file: Option[Span['k]] = Option::None;
        var entry: Option[Span['k]] = Option::None;
        var i = 1usize;
        while i < args.len(&cx) {
            if args.at(&cx, i).is(&cx, "--entry") && i + 1usize < args.len(&cx) {
                entry = Option::Some.(args.at(&cx, i + 1usize));
                i = i + 2usize;
            } else if file.is_none() {
                file = Option::Some.(args.at(&cx, i));
                i = i + 1usize;
            } else {
                fail(&cx, Span::from_static(&cx, "usage: kursal c FILE [--entry NAME]"));
            }
        }
        let path = match file {
            Option::Some(f) => f,
            Option::None => fail(&cx, Span::from_static(&cx, "usage: kursal c FILE [--entry NAME]")),
        };
        Option::Some.(Handoff.{ goal: Goal::C, program: parse_program(&cx, read_file(&cx, path)), counter: Fresh::new(&cx),
            entry, output: Option::None, link_flags: ArenaVec::new(&cx), c_sources: ArenaVec::new(&cx), single_c: true, times: false, started: Instant::now() })
    } else if command.is(&cx, "lower") && args.len(&cx) == 2usize {
        let counter = Fresh::new(&cx);
        let r = resolve(&cx, args.at(&cx, 1usize));
        emit(&cx, write_program(&cx, lower(&cx, r, signatures(&cx, r, counter), counter)));
        Option::None
    } else if command.is(&cx, "doc") {
        if args.len(&cx) != 4usize || !args.at(&cx, 2usize).is(&cx, "-o") {
            fail(&cx, Span::from_static(&cx, "usage: kursal doc PATH -o SITE"));
        }
        generate(&cx, resolve(&cx, args.at(&cx, 1usize)), args.at(&cx, 3usize));
        Option::None
    } else if command.is(&cx, "build") {
        Option::Some.(build(&cx, args.skip(&cx, 1usize)))
    } else if command.is(&cx, "readable") && args.len(&cx) == 2usize {
        emit(&cx, emit_kurs(&cx, parse_program(&cx, read_file(&cx, args.at(&cx, 1usize))), Fresh::new(&cx)));
        Option::None
    } else {
        fail(&cx, Buffer!::new().push_static("unknown command ").push_bytes(&cx, command).save(&cx))
    }
}

forall 'k.
fn read_file(&cx: Domain!['k], file: Span['k]) -> Span['k] {
    match read_to_arena(&cx, file) {
        Result::Ok(s) => s,
        Result::Err(e) => fail(&cx, Buffer!::new().push_static("cannot read ").push_bytes(&cx, file).save(&cx)),
    }
}

// The time since `started` as `NAME: 1500ms` on stderr, when `times`. Restart the clock
// after printing so logging one stage is not charged to the next.
fn stage(times: bool, name: Slice[u8, 'static], started: Instant) -> Instant {
    let now = Instant::now();
    if times {
        let ms = started.millis_until(now);
        eprint_buffer(Buffer!::new().push_static(name).push_static(": ").push_usize(ms as usize).push_static("ms\n"));
        Instant::now()
    } else {
        now
    }
}

// The front end of `kursal build PATH [-o OUTPUT] [--emit-c] [--single-c] [--times]`: the package resolved, its
// signatures built, and its bodies inferred and lowered.
forall 'k.
fn build(&cx: Domain!['k], args: ArenaVec[Span['k], 'k]) -> Handoff['k] {
    var path: Option[Span['k]] = Option::None;
    var output: Option[Span['k]] = Option::None;
    var times = false;
    var emit_c_only = false;
    var single_c = false;
    var i = 0usize;
    while i < args.len(&cx) {
        if args.at(&cx, i).is(&cx, "--times") {
            times = true;
            i = i + 1usize;
        } else if args.at(&cx, i).is(&cx, "--emit-c") {
            emit_c_only = true;
            i = i + 1usize;
        } else if args.at(&cx, i).is(&cx, "--single-c") {
            single_c = true;
            i = i + 1usize;
        } else if args.at(&cx, i).is(&cx, "-o") && i + 1usize < args.len(&cx) && output.is_none() {
            output = Option::Some.(args.at(&cx, i + 1usize));
            i = i + 2usize;
        } else if path.is_none() {
            path = Option::Some.(args.at(&cx, i));
            i = i + 1usize;
        } else {
            fail(&cx, Span::from_static(&cx, "usage: kursal build PATH [-o OUTPUT] [--emit-c] [--single-c] [--times]"));
        }
    }
    let package = match path {
        Option::Some(p) => p,
        Option::None => fail(&cx, Span::from_static(&cx, "usage: kursal build PATH [-o OUTPUT] [--emit-c] [--single-c] [--times]")),
    };
    if emit_c_only && !output.is_none() {
        fail(&cx, Span::from_static(&cx, "--emit-c and -o cannot be used together"));
    }
    var started = Instant::now();
    let counter = Fresh::new(&cx);
    let r = resolve(&cx, package);
    started = stage(times, "resolve", started);
    let sigs = signatures(&cx, r, counter);
    started = stage(times, "signatures", started);
    let inferred = infer(&cx, r, sigs, counter);
    started = stage(times, "infer", started);
    let program = lower_inferred(&cx, r, sigs, inferred.out, counter);
    started = stage(times, "lower", started);
    let entry = match r.packages.at(&cx, 0usize).entry_decl.copy(&cx) {
        Option::Some(decl) => Option::Some.(sigs.name(&cx, decl)),
        Option::None => Option::None,
    };
    if !emit_c_only && entry.is_none() {
        fail(&cx, Span::from_static(&cx, "this package has no executable entry; use --emit-c to print its C"));
    }
    let destination = if emit_c_only { Option::None } else {
        match output {
            Option::Some(o) => Option::Some.(o),
            Option::None => Option::Some.(Span::from_static(&cx, "a.out")),
        }
    };
    let link_flags: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
    let c_sources: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
    var p = 0usize;
    while p < r.packages.len(&cx) {
        let package = r.packages.at(&cx, p);
        let flags = package.link_flags;
        var f = 0usize;
        while f < flags.len(&cx) {
            link_flags.push(&cx, flags.at(&cx, f));
            f = f + 1usize;
        }
        let sources = package.c_sources;
        f = 0usize;
        while f < sources.len(&cx) {
            c_sources.push(&cx, sources.at(&cx, f));
            f = f + 1usize;
        }
        p = p + 1usize;
    }
    Handoff.{ goal: Goal::Build, program, counter, entry, output: destination, link_flags, c_sources, single_c: single_c || emit_c_only, times, started }
}

// The back end, in the arena `cx`, which it destroys: the C of `handoff`'s program, printed or, for
// `build` with OUTPUT, compiled into OUTPUT with the standard library's C helpers: written to
// OUTPUT.c and compiled whole for `--single-c` or a C compiler other than Clang and GCC, else
// written to OUTPUT.build as a file per module, which are compiled in parallel and linked with
// link-time optimization. The command's exit status: 1 when the C compiler cannot be started, exits
// with another status than 0 or is killed, which is reported on stderr.
forall 'k.
fn back_end(cx: Domain!['k], handoff: Handoff['k], typed: ArenaMap[FunKey['k], ArenaMap[(Span['k], Span['k]), Type['k], 'k], 'k], started: Instant) -> i32 {
    var cx = cx;
    var started = started;
    // The C compiler of the reference's `kursal.cc`: `$KURSAL_CC`, else Clang, at -O3.
    let compiler = match variable(&cx, Span::from_static(&cx, "KURSAL_CC")) {
        Option::Some(name) => name.save(&cx),
        Option::None => Span::from_static(&cx, ""),
    };
    let compiler = if compiler.is_empty() { Span::from_static(&cx, "clang") } else { compiler };
    let lto = if handoff.single_c { Option::None } else { link_time_optimization(&cx, compiler) };
    let text = emit_c(&cx, handoff.program, typed, handoff.entry, handoff.counter, handoff.times, lto.is_some());
    started = stage(handoff.times, "C", started);
    let out = match handoff.output {
        Option::Some(o) => o,
        Option::None => {
            match text {
                CText!::One(c) => emit_buffer(c),
                CText!::Split(files) => fail(&cx, Span::from_static(&cx, "internal error: split C to print")),
            };
            started = stage(handoff.times, "write C", started);
            cx.destroy();
            let finished = stage(handoff.times, "back free", started);
            return 0;
        },
    };
    let lib = lib_dir(&cx);
    // `$KURSAL_JOBS` C compilers at once, else one per processor
    let jobs = match variable(&cx, Span::from_static(&cx, "KURSAL_JOBS")) {
        Option::Some(text) => match parse_usize(&cx, text.save(&cx)) {
            Option::Some(n) => if n > 0usize { n } else { available_parallelism() },
            Option::None => available_parallelism(),
        },
        Option::None => available_parallelism(),
    };
    // Only the command lines, copied into the `Command!`s, and the compiler's name, for a failure,
    // outlive the arena while the C compiler runs.
    let (compiles, link) = match text {
        CText!::One(c) => {
            let c_file = Buffer!::new().push_bytes(&cx, out).push_static(".c").save(&cx);
            if write(&cx, c_file, c).is_err() {
                fail(&cx, Buffer!::new().push_static("cannot write ").push_bytes(&cx, c_file).save(&cx));
            }
            (OwnedVec!::new[Command!](), linked(&cx, c_command(&cx, compiler, Option::None).arg(&cx, c_file), handoff, lib, out))
        },
        CText!::Split(files) => {
            let dir = Buffer!::new().push_bytes(&cx, out).push_static(".build").save(&cx);
            match mkdir(&cx, dir) {
                Result::Ok(made) => (),
                // an earlier build's directory, kept: only the files written below are compiled
                Result::Err(e) => if e.errno != 17i32 {
                    fail(&cx, Buffer!::new().push_static("cannot make the directory ").push_bytes(&cx, dir).save(&cx));
                },
            };
            forget_stale(&cx, dir, files);
            // the C files, smallest first, so the largest are taken first from the end
            let sized: ArenaVec[(usize, Span['k]), 'k] = ArenaVec::new(&cx);
            var f = 0usize;
            while f < files.len(&cx) {
                let (name, body) = files.at(&cx, f);
                let path = Buffer!::new().push_bytes(&cx, dir).push_static("/").push_bytes(&cx, name).save(&cx);
                if write(&cx, path, Buffer!::new().push_bytes(&cx, body)).is_err() {
                    fail(&cx, Buffer!::new().push_static("cannot write ").push_bytes(&cx, path).save(&cx));
                }
                if name.ends_with(&cx, Span::from_static(&cx, ".c")) {
                    sized.push(&cx, (body.len(), path));
                }
                f = f + 1usize;
            }
            sized.sort_by(&cx, |&cx, a, b| {
                let (x, _p) = a;
                let (y, _q) = b;
                if x < y { Order::Less } else if x > y { Order::Greater } else { Order::Equal }
            });
            var compiles = OwnedVec!::new[Command!]();
            var link = c_command(&cx, compiler, lto);
            var c = 0usize;
            while c < sized.len(&cx) {
                let (_size, path) = sized.at(&cx, c);
                let object = Buffer!::new().push_bytes(&cx, path.take(path.len() - 2usize)).push_static(".o").save(&cx);
                compiles = compiles.push(c_command(&cx, compiler, lto).arg(&cx, Span::from_static(&cx, "-c")).arg(&cx, path).arg(&cx, Span::from_static(&cx, "-o")).arg(&cx, object));
                link = link.arg(&cx, object);
                c = c + 1usize;
            }
            (compiles, linked(&cx, link, handoff, lib, out))
        },
    };
    var cc = Buffer!::new().push_bytes(&cx, compiler);
    started = stage(handoff.times, "cc setup", started);
    cx.destroy();
    started = stage(handoff.times, "back free", started);
    let compiled = run_all(compiles, jobs, &cc);
    started = stage(handoff.times, "cc compile", started);
    let failure = match compiled {
        Option::Some(message) => {
            link.destroy();
            Option::Some.(message)
        },
        Option::None => failure(&cc, link.run()),
    };
    cc.destroy();
    let finished = stage(handoff.times, "cc", started);
    match failure {
        Option::None => 0i32,
        Option::Some(message) => {
            let printed = eprint_buffer(message.push_static("\n"));
            1i32
        },
    }
}

// Removes from `dir` the C, header and object files of an earlier build that `files` does not
// write again, so the directory holds this build's files only.
forall 'k.
fn forget_stale(&cx: Domain!['k], dir: Span['k], files: ArenaVec[(Span['k], Span['k]), 'k]) {
    let kept: ArenaSet[Span['k], 'k] = ArenaSet::new(&cx);
    var f = 0usize;
    while f < files.len(&cx) {
        let (name, _text) = files.at(&cx, f);
        kept.insert(&cx, name);
        if name.ends_with(&cx, Span::from_static(&cx, ".c")) {
            kept.insert(&cx, Buffer!::new().push_bytes(&cx, name.take(name.len() - 2usize)).push_static(".o").save(&cx));
        }
        f = f + 1usize;
    }
    let stale: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
    match read_dir(&cx, dir) {
        Result::Ok(directory) => {
            var directory = directory;
            var going = true;
            while going {
                match &directory.next() {
                    Result::Ok(next) => match next {
                        Option::Some(entry) => {
                            let { name, is_directory } = entry;
                            let name = name.save(&cx);
                            let generated = name.ends_with(&cx, Span::from_static(&cx, ".c")) || name.ends_with(&cx, Span::from_static(&cx, ".h"))
                                || name.ends_with(&cx, Span::from_static(&cx, ".o"));
                            if !is_directory && generated && !kept.contains(&cx, name) {
                                stale.push(&cx, name);
                            }
                        },
                        Option::None => {
                            going = false;
                        },
                    },
                    Result::Err(e) => {
                        going = false;
                    },
                };
            }
            let closed = directory.close();
        },
        Result::Err(e) => (),
    };
    var s = 0usize;
    while s < stale.len(&cx) {
        let removed = remove(&cx, Buffer!::new().push_bytes(&cx, dir).push_static("/").push_bytes(&cx, stale.at(&cx, s)).save(&cx));
        s = s + 1usize;
    }
}

// The link-time optimization flag of the C compiler `compiler`, by its name: ThinLTO for Clang, GCC's
// own for GCC; none for another, whose C is then compiled as one file.
forall 'k.
fn link_time_optimization(&cx: Domain!['k], compiler: Span['k]) -> Option[Slice[u8, 'static]] {
    var start = 0usize;
    var more = true;
    while more {
        more = match compiler.find_byte(&cx, b'/', start) {
            Option::Some(slash) => {
                start = slash + 1usize;
                true
            },
            Option::None => false,
        };
    }
    let name = compiler.skip(start);
    if name.contains(&cx, Span::from_static(&cx, "clang")) {
        Option::Some.("-flto=thin")
    } else if name.contains(&cx, Span::from_static(&cx, "gcc")) {
        Option::Some.("-flto=auto")
    } else {
        Option::None
    }
}

// The C compiler `compiler` with the flags of every compile and link: those of the reference's
// `kursal.cc`, and `lto`.
forall 'k.
fn c_command(&cx: Domain!['k], compiler: Span['k], lto: Option[Slice[u8, 'static]]) -> Command! {
    let command = Command!::new(&cx, compiler).arg(&cx, Span::from_static(&cx, "-O3")).arg(&cx, Span::from_static(&cx, "-w"))
        .arg(&cx, Span::from_static(&cx, "-fno-builtin"));
    match lto {
        Option::Some(flag) => command.arg(&cx, Span::from_static(&cx, flag)),
        Option::None => command,
    }
}

// `command` linking into `out`, with the standard library's C helpers, the packages' C sources and
// link flags, and threads.
forall 'k.
fn linked(&cx: Domain!['k], command: Command!, handoff: Handoff['k], lib: Span['k], out: Span['k]) -> Command! {
    var command = command.arg(&cx, Buffer!::new().push_bytes(&cx, lib).push_static("/libc/fs.c").save(&cx))
        .arg(&cx, Buffer!::new().push_bytes(&cx, lib).push_static("/libc/thread.c").save(&cx));
    var f = 0usize;
    while f < handoff.c_sources.len(&cx) {
        command = command.arg(&cx, handoff.c_sources.at(&cx, f));
        f = f + 1usize;
    }
    f = 0usize;
    while f < handoff.link_flags.len(&cx) {
        command = command.arg(&cx, handoff.link_flags.at(&cx, f));
        f = f + 1usize;
    }
    command.arg(&cx, Span::from_static(&cx, "-lpthread")).arg(&cx, Span::from_static(&cx, "-o")).arg(&cx, out)
}

// Runs `commands`, at most `jobs` at once, from the last; once one fails, starts no more and waits
// for those running. The first failure, as `failure` words it for the C compiler `cc`.
fn run_all(commands: OwnedVec![Command!], jobs: usize, &cc: Buffer!) -> Option[Buffer!] {
    var pending = commands;
    var running = OwnedVec!::new[Child!]();
    var first = Buffer!::new();
    var failed = false;
    var going = true;
    while going {
        var starting = !failed;
        while starting && &running.len() < jobs {
            match &pending.pop() {
                Popped!::Item(command) => {
                    match failure(&cc, spawned(command, &running)) {
                        Option::None => (),
                        Option::Some(message) => {
                            first.destroy();
                            first = message;
                            failed = true;
                            starting = false;
                        },
                    };
                },
                Popped!::Empty => {
                    starting = false;
                },
            };
        }
        // Each running child polled once; those still running kept.
        var still = OwnedVec!::new[Child!]();
        var polling = true;
        while polling {
            match &running.pop() {
                Popped!::Item(child) => {
                    match child.try_wait() {
                        Result::Ok(polled) => match polled {
                            Polled!::Running(child) => {
                                still = still.push(child);
                            },
                            Polled!::Ended(exit) => {
                                if !failed {
                                    match failure(&cc, Result::Ok.(exit)) {
                                        Option::None => (),
                                        Option::Some(message) => {
                                            first.destroy();
                                            first = message;
                                            failed = true;
                                        },
                                    };
                                }
                            },
                        },
                        Result::Err(e) => if !failed {
                            first.destroy();
                            first = Buffer!::new().push_static("cannot wait for the C compiler (error ").push_i64(e.errno as i64).push_static(")");
                            failed = true;
                        },
                    };
                },
                Popped!::Empty => {
                    polling = false;
                },
            };
        }
        running.destroy(forget_child);
        running = still;
        going = &running.len() > 0usize || !failed && &pending.len() > 0usize;
        if going {
            sleep(Duration::from_millis(2u64));
        }
    }
    running.destroy(forget_child);
    pending.destroy(forget_command);
    if failed {
        Option::Some.(first)
    } else {
        first.destroy();
        Option::None
    }
}

// The outcome of `spawn`ing `command`: the child added to `running`, or the error.
fn spawned(command: Command!, &running: OwnedVec![Child!]) -> Result[Exit, Error] {
    match command.spawn() {
        Result::Ok(child) => {
            running = running.push(child);
            Result::Ok.(Exit::Code.(0i32))
        },
        Result::Err(e) => Result::Err.(e),
    }
}

// What went wrong running the C compiler `cc`, as `tools/build.py` reports it (its own diagnostics
// are already on stderr), or `None` when it exited with status 0.
fn failure(&cc: Buffer!, ran: Result[Exit, Error]) -> Option[Buffer!] {
    let (lead, middle, number, end) = match ran {
        Result::Ok(exit) => match exit {
            Exit::Code(code) => {
                if code == 0i32 {
                    return Option::None;
                }
                ("the C compiler ", " exited with status ", code as i64, "")
            },
            Exit::Signal(signal) => ("the C compiler ", " was killed by signal ", signal as i64, ""),
        },
        Result::Err(e) => ("cannot run the C compiler ", " (error ", e.errno as i64, ")"),
    };
    let name = &cc.clone();
    Option::Some.(Buffer!::new().push_static(lead).push_buffer(name).push_static(middle).push_i64(number).push_static(end))
}

// Frees an empty vector's slots: no child or command is left in one this file frees.
fn forget_child(child: Child!) {
    let ended = child.wait();
}

fn forget_command(command: Command!) {
    command.destroy();
}
