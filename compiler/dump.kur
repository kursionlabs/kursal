// A canonical text form of the parsed AST, for comparing this parser with the reference parser.
//
// A node prints as `(Class field ...)`, with the class names and field order of the reference's
// `syntax.py` dataclasses: a sequence as `[...]`, text as a quoted string with `\xHH` for any byte
// outside printable ASCII, nothing as `_`, a boolean as `#t` or `#f`, a position as `line:col`.

use package::base::{Out, Seq, Text, text};
use package::syntax as S;
use package::syntax::{Expr, Pattern, Statement, Type};
use std::option::Option;

fn str(out: Out, t: Text) -> Out {
    let unit = out.byte(b'"');
    var i = 0usize;
    while i < t.len {
        let b = t.byte(i);
        if b == b'"' || b == b'\\' {
            let unit = out.byte(b'\\').byte(b);
        } else if b >= 32u8 && b < 127u8 {
            let unit = out.byte(b);
        } else {
            let digits = text("0123456789abcdef");
            let unit = out.put("\\x").byte(digits.byte((b / 16u8) as usize)).byte(digits.byte((b % 16u8) as usize));
        }
        i = i + 1usize;
    }
    out.byte(b'"')
}

fn flag(out: Out, b: bool) -> Out {
    out.put(if b { " #t" } else { " #f" })
}

fn pos(out: Out, p: S::Pos) -> Out {
    if p.line == 0u32 {
        out.put(" _")
    } else {
        out.put(" ").u64(p.line as u64).put(":").u64(p.col as u64)
    }
}

fn texts(out: Out, ts: Seq[Text]) -> Out {
    let unit = out.put(" [");
    var i = 0usize;
    while i < ts.len() {
        if i > 0usize {
            let unit = out.put(" ");
        }
        let unit = str(out, ts.get(i));
        i = i + 1usize;
    }
    out.put("]")
}

fn opt_text(out: Out, t: Option[Text]) -> Out {
    match t {
        Option::Some(v) => str(out.put(" "), v),
        Option::None => out.put(" _"),
    }
}

fn opt_path(out: Out, t: Option[Seq[Text]]) -> Out {
    match t {
        Option::Some(v) => texts(out, v),
        Option::None => out.put(" _"),
    }
}

fn types(out: Out, ts: Seq[Type]) -> Out {
    let unit = out.put(" [");
    var i = 0usize;
    while i < ts.len() {
        let unit = type(out.put(if i > 0usize { " " } else { "" }), ts.get(i));
        i = i + 1usize;
    }
    out.put("]")
}

fn opt_type(out: Out, t: Option[Type]) -> Out {
    match t {
        Option::Some(v) => type(out.put(" "), v),
        Option::None => out.put(" _"),
    }
}

fn slots(out: Out, ss: Seq[S::Slot]) -> Out {
    let unit = out.put(" [");
    var i = 0usize;
    while i < ss.len() {
        let s = ss.get(i);
        let unit = type(flag(out.put(if i > 0usize { " [" } else { "[" }), s.lend).put(" "), s.type).put("]");
        i = i + 1usize;
    }
    out.put("]")
}

fn type(out: Out, t: Type) -> Out {
    match t {
        Type::Name(n) => types(texts(out.put("(TName"), n.path).put(if n.linear { " #t" } else { " #f" }), n.args).put(" ").usize(n.determined).put(")"),
        Type::Ptr(inner) => type(out.put("(TPtr "), inner.get()).put(")"),
        Type::Never => out.put("(TNever)"),
        Type::Tuple(elems) => types(out.put("(TTuple"), elems).put(")"),
        Type::Array(elem, length) => expr(type(out.put("(TArray "), elem.get()).put(" "), length.get()).put(")"),
        Type::Fn(f) => flag(type(slots(out.put("(TFn"), f.params).put(" "), f.ret.get()), f.is_unsafe).put(")"),
        Type::Closure(c) => {
            let unit = match c.env {
                Option::Some(env) => type(out.put("(TClosure "), env.get()),
                Option::None => out.put("(TClosure _"),
            };
            type(slots(out, c.params).put(" "), c.ret.get()).put(")")
        },
        Type::Exists(brands, body) => type(texts(out.put("(TExists"), brands).put(" "), body.get()).put(")"),
        Type::Foreach(f) => type(type(flag(str(out.put("(TForeach "), f.binder), f.indirect).put(" "), f.source.get()).put(" "), f.body.get()).put(")"),
        Type::Forall(params, body) => type(texts(out.put("(TForall"), params).put(" "), body.get()).put(")"),
        Type::Brand(label) => str(out.put("(TBrand "), label).put(")"),
        Type::Ignored => out.put("(TIgnored)"),
    }
}

fn exprs(out: Out, es: Seq[Expr]) -> Out {
    let unit = out.put(" [");
    var i = 0usize;
    while i < es.len() {
        let unit = expr(out.put(if i > 0usize { " " } else { "" }), es.get(i));
        i = i + 1usize;
    }
    out.put("]")
}

fn opt_expr(out: Out, e: Option[Expr]) -> Out {
    match e {
        Option::Some(v) => expr(out.put(" "), v),
        Option::None => out.put(" _"),
    }
}

fn lit(out: Out, l: S::Lit) -> Out {
    let unit = match l.kind {
        S::LitKind::Int => {
            let unit = out.put("(Lit \"int\" ");
            let unit = if l.negative && l.int != 0u64 { out.put("-") } else { out };
            out.u64(l.int)
        },
        S::LitKind::Float => str(out.put("(Lit \"float\" "), l.text),
        S::LitKind::Str => str(out.put("(Lit \"str\" "), l.text),
        S::LitKind::Bool => out.put(if l.int == 1u64 { "(Lit \"bool\" #t" } else { "(Lit \"bool\" #f" }),
    };
    pos(opt_text(out, l.suffix), l.pos).put(")")
}

fn path(out: Out, p: S::Path) -> Out {
    let unit = out.put("(Path [");
    var i = 0usize;
    while i < p.segments.len() {
        let s = p.segments.get(i);
        let unit = types(flag(str(out.put(if i > 0usize { " [" } else { "[" }), s.name), s.linear), s.args).put("]");
        i = i + 1usize;
    }
    pos(out.put("]"), p.pos).put(")")
}

fn block(out: Out, b: S::Block) -> Out {
    let unit = out.put("(Block [");
    var i = 0usize;
    while i < b.stmts.len() {
        let unit = statement(out.put(if i > 0usize { " " } else { "" }), b.stmts.get(i));
        i = i + 1usize;
    }
    let unit = out.put("]");
    let unit = match b.tail {
        Option::Some(t) => expr(out.put(" "), t.get()),
        Option::None => out.put(" _"),
    };
    pos(out, b.pos).put(")")
}

fn case(out: Out, c: S::Case) -> Out {
    let unit = match c.kind {
        S::CaseKind::Variant => out.put("(Case \"variant\""),
        S::CaseKind::Wild => out.put("(Case \"wild\""),
        S::CaseKind::Value => out.put("(Case \"value\""),
    };
    let unit = match c.path {
        Option::Some(p) => path(out.put(" "), p),
        Option::None => out.put(" _"),
    };
    let unit = opt_path(out, c.binders);
    let unit = match c.low {
        Option::Some(l) => lit(out.put(" "), l),
        Option::None => out.put(" _"),
    };
    let unit = match c.high {
        Option::Some(l) => lit(out.put(" "), l),
        Option::None => out.put(" _"),
    };
    pos(out, c.pos).put(")")
}

fn expr(out: Out, e: Expr) -> Out {
    match e {
        Expr::Lit(l) => lit(out, l),
        Expr::FStr(f) => {
            let unit = out.put("(FStr [");
            var i = 0usize;
            while i < f.parts.len() {
                let unit = out.put(if i > 0usize { " " } else { "" });
                let unit = match f.parts.get(i) {
                    S::Piece::Text(t) => str(out, t),
                    S::Piece::Expr(x) => expr(out, x),
                };
                i = i + 1usize;
            }
            pos(out.put("]"), f.pos).put(")")
        },
        Expr::Path(p) => path(out, p),
        Expr::Tuple(n) => pos(exprs(out.put("(Tuple"), n.value), n.pos).put(")"),
        Expr::Array(a) => pos(flag(exprs(out.put("(Array"), a.elems), a.fill), a.pos).put(")"),
        Expr::Sizeof(n) => pos(type(out.put("(Sizeof "), n.value), n.pos).put(")"),
        Expr::StructLit(s) => {
            let unit = path(out.put("(StructLit "), s.path).put(" [");
            var i = 0usize;
            while i < s.fields.len() {
                let f = s.fields.get(i);
                let unit = opt_expr(str(out.put(if i > 0usize { " [" } else { "[" }), f.name), f.value).put("]");
                i = i + 1usize;
            }
            pos(opt_text(out.put("]"), s.spread), s.pos).put(")")
        },
        Expr::Block(b) => block(out, b),
        Expr::If(n) => {
            let unit = block(expr(out.put("(If "), n.cond.get()).put(" "), n.then);
            let unit = match n.other {
                Option::Some(o) => expr(out.put(" "), o.get()),
                Option::None => out.put(" _"),
            };
            pos(out, n.pos).put(")")
        },
        Expr::Match(m) => {
            let unit = expr(out.put("(Match "), m.scrutinee.get()).put(" [");
            var i = 0usize;
            while i < m.arms.len() {
                let arm = m.arms.get(i);
                let unit = out.put(if i > 0usize { " (Arm [" } else { "(Arm [" });
                var k = 0usize;
                while k < arm.cases.len() {
                    let unit = case(out.put(if k > 0usize { " " } else { "" }), arm.cases.get(k));
                    k = k + 1usize;
                }
                let unit = pos(expr(out.put("] "), arm.body), arm.pos).put(")");
                i = i + 1usize;
            }
            pos(out.put("]"), m.pos).put(")")
        },
        Expr::Closure(c) => {
            let unit = out.put("(Closure [");
            var i = 0usize;
            while i < c.params.len() {
                let p = c.params.get(i);
                let unit = opt_type(str(flag(out.put(if i > 0usize { " [" } else { "[" }), p.lend).put(" "), p.name), p.type).put("]");
                i = i + 1usize;
            }
            pos(expr(opt_type(out.put("]"), c.ret).put(" "), c.body.get()), c.pos).put(")")
        },
        Expr::Return(n) => {
            let unit = out.put("(Return");
            let unit = match n.value {
                Option::Some(v) => expr(out.put(" "), v.get()),
                Option::None => out.put(" _"),
            };
            pos(out, n.pos).put(")")
        },
        Expr::Pack(p) => pos(expr(texts(out.put("(Pack"), p.brands).put(" "), p.value.get()), p.pos).put(")"),
        Expr::Foreach(f) => pos(block(expr(opt_text(str(out.put("(Foreach "), f.name), f.binder).put(" "), f.source.get()).put(" "), f.body), f.pos).put(")"),
        Expr::Binop(b) => pos(expr(expr(str(out.put("(Binop "), b.op).put(" "), b.left.get()).put(" "), b.right.get()), b.pos).put(")"),
        Expr::Unary(u) => pos(expr(str(out.put("(Unary "), u.op).put(" "), u.operand.get()), u.pos).put(")"),
        Expr::Cast(c) => pos(type(expr(out.put("(Cast "), c.value.get()).put(" "), c.type), c.pos).put(")"),
        Expr::UnsafeStore(s) => pos(expr(expr(out.put("(UnsafeStore "), s.pointer.get()).put(" "), s.value.get()), s.pos).put(")"),
        Expr::Field(f) => pos(str(expr(out.put("(Field "), f.value.get()).put(" "), f.name), f.pos).put(")"),
        Expr::Index(x) => pos(expr(out.put("(Index "), x.value.get()).put(" ").usize(x.index), x.pos).put(")"),
        Expr::Call(c) => pos(exprs(expr(out.put("(Call "), c.callee.get()), c.args), c.pos).put(")"),
        Expr::Try(n) => pos(expr(out.put("(Try "), n.value.get()), n.pos).put(")"),
        Expr::While(w) => pos(block(expr(out.put("(While "), w.cond.get()).put(" "), w.body), w.pos).put(")"),
        Expr::For(f) => pos(block(expr(str(out.put("(For "), f.name).put(" "), f.iterator.get()).put(" "), f.body), f.pos).put(")"),
    }
}

fn pattern(out: Out, p: Pattern) -> Out {
    match p {
        Pattern::Bind(n) => str(out.put("(PBind "), n.value).put(")"),
        Pattern::Wild(id) => out.put("(PWild)"),
        Pattern::Tuple(n) => patterns(out.put("(PTuple"), n.value).put(")"),
        Pattern::Array(n) => patterns(out.put("(PArray"), n.value).put(")"),
        Pattern::Struct(s) => {
            let unit = out.put("(PStruct [");
            var i = 0usize;
            while i < s.fields.len() {
                let f = s.fields.get(i);
                let unit = pattern(str(out.put(if i > 0usize { " [" } else { "[" }), f.name).put(" "), f.pattern).put("]");
                i = i + 1usize;
            }
            opt_text(out.put("]"), s.rest).put(")")
        },
    }
}

fn patterns(out: Out, ps: Seq[Pattern]) -> Out {
    let unit = out.put(" [");
    var i = 0usize;
    while i < ps.len() {
        let unit = pattern(out.put(if i > 0usize { " " } else { "" }), ps.get(i));
        i = i + 1usize;
    }
    out.put("]")
}

fn statement(out: Out, s: Statement) -> Out {
    match s {
        Statement::Let(l) => pos(texts(expr(opt_type(pattern(out.put("(Let "), l.pattern), l.type).put(" "), l.value), l.brands), l.pos).put(")"),
        Statement::Var(v) => pos(expr(opt_type(str(out.put("(Var "), v.name), v.type).put(" "), v.value), v.pos).put(")"),
        Statement::Assign(a) => pos(expr(expr(out.put("(Assign "), a.target).put(" "), a.value), a.pos).put(")"),
        Statement::Expr(n) => pos(expr(out.put("(ExprStmt "), n.value), n.pos).put(")"),
        Statement::Const(c) => const_decl(out, c),
    }
}

fn type_args(out: Out, a: S::TypeArgs) -> Out {
    types(out.put("(TypeArgs"), a.args).put(" ").usize(a.determined).put(")")
}

fn quantifier(out: Out, q: Option[S::Forall]) -> Out {
    match q {
        Option::Some(f) => {
            let unit = texts(texts(out.put(" (Forall"), f.params), f.determined).put(" [");
            var i = 0usize;
            while i < f.premises.len() {
                let p = f.premises.get(i);
                let unit = type_args(texts(out.put(if i > 0usize { " [" } else { "[" }), p.trait_path).put(" "), p.args).put("]");
                i = i + 1usize;
            }
            out.put("])")
        },
        Option::None => out.put(" _"),
    }
}

fn params(out: Out, ps: Seq[S::Param]) -> Out {
    let unit = out.put(" [");
    var i = 0usize;
    while i < ps.len() {
        let p = ps.get(i);
        let unit = flag(opt_type(str(out.put(if i > 0usize { " (Param " } else { "(Param " }), p.name), p.type), p.lend).put(")");
        i = i + 1usize;
    }
    out.put("]")
}

fn exposure(out: Out, e: Option[S::Exposed]) -> Out {
    match e {
        Option::Some(x) => opt_path(out.put(" (Exposed"), x.scope).put(")"),
        Option::None => out.put(" _"),
    }
}

fn use_tree(out: Out, t: S::UseTree) -> Out {
    let unit = flag(texts(out.put("["), t.path), t.star).put(" [");
    var i = 0usize;
    while i < t.children.len() {
        let unit = use_tree(out.put(if i > 0usize { " " } else { "" }), t.children.get(i));
        i = i + 1usize;
    }
    opt_text(out.put("]"), t.alias).put("]")
}

fn function(out: Out, f: S::Fn) -> Out {
    let unit = opt_type(params(str(out.put("(Fn "), f.name), f.params), f.ret);
    let unit = match f.body {
        Option::Some(b) => block(out.put(" "), b),
        Option::None => out.put(" _"),
    };
    pos(quantifier(flag(out, f.is_unsafe), f.quantifier), f.pos).put(")")
}

fn const_decl(out: Out, c: S::Const) -> Out {
    pos(quantifier(expr(type(str(out.put("(Const "), c.name).put(" "), c.type).put(" "), c.value), c.quantifier), c.pos).put(")")
}

fn item(out: Out, it: S::Item) -> Out {
    match it {
        S::Item::Use(u) => pos(flag(use_tree(out.put("(Use "), u.tree), u.is_export), u.pos).put(")"),
        S::Item::Module(m) => pos(texts(out.put("(Module"), m.value), m.pos).put(")"),
        S::Item::Struct(s) => {
            let unit = flag(str(out.put("(Struct "), s.name), s.linear).put(" [");
            var i = 0usize;
            while i < s.fields.len() {
                let f = s.fields.get(i);
                let unit = type(str(out.put(if i > 0usize { " [" } else { "[" }), f.name).put(" "), f.type).put("]");
                i = i + 1usize;
            }
            pos(quantifier(exposure(out.put("]"), s.exposure), s.quantifier), s.pos).put(")")
        },
        S::Item::Tuple(t) => pos(quantifier(exposure(types(flag(str(out.put("(TupleDecl "), t.name), t.linear), t.elems), t.exposure), t.quantifier), t.pos).put(")"),
        S::Item::Enum(e) => {
            let unit = flag(str(out.put("(EnumDecl "), e.name), e.linear).put(" [");
            var i = 0usize;
            while i < e.variants.len() {
                let v = e.variants.get(i);
                let unit = types(str(out.put(if i > 0usize { " [" } else { "[" }), v.name), v.payload).put("]");
                i = i + 1usize;
            }
            pos(quantifier(exposure(out.put("]"), e.exposure), e.quantifier), e.pos).put(")")
        },
        S::Item::Fn(f) => function(out, f),
        S::Item::Extern(x) => pos(opt_type(params(str(str(out.put("(Extern "), x.abi).put(" "), x.name), x.params), x.ret), x.pos).put(")"),
        S::Item::Const(c) => const_decl(out, c),
        S::Item::Impl(m) => {
            let unit = type(out.put("(Impl "), m.type).put(" [");
            var i = 0usize;
            while i < m.items.len() {
                let unit = out.put(if i > 0usize { " " } else { "" });
                let unit = match m.items.get(i) {
                    S::Member::Fn(f) => function(out, f),
                    S::Member::Const(c) => const_decl(out, c),
                };
                i = i + 1usize;
            }
            pos(quantifier(out.put("]"), m.quantifier), m.pos).put(")")
        },
        S::Item::Trait(t) => pos(quantifier(functions(str(out.put("(TraitDecl "), t.name), t.methods), t.quantifier), t.pos).put(")"),
        S::Item::Instance(n) => pos(quantifier(flag(functions(type(out.put("(InstanceDecl "), n.type), n.methods), n.is_unsafe), n.quantifier), n.pos).put(")"),
    }
}

fn functions(out: Out, fs: Seq[S::Fn]) -> Out {
    let unit = out.put(" [");
    var i = 0usize;
    while i < fs.len() {
        let unit = function(out.put(if i > 0usize { " " } else { "" }), fs.get(i));
        i = i + 1usize;
    }
    out.put("]")
}

// One line per item.
fn items(items: Seq[S::Item]) -> Text {
    let out = Out::new();
    var i = 0usize;
    while i < items.len() {
        let unit = item(out, items.get(i)).put("\n");
        i = i + 1usize;
    }
    out.done()
}
